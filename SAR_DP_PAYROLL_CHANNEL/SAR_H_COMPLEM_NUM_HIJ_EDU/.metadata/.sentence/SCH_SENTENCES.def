# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_COMPLEM_NUM_HIJ_EDU | 1 | 0 | 1 |  | 80 |  |  | #I = $ ID_ORGANIZATION And #I = ? And #I = ? And #I <= ? And #I >= ? And #I = '32' And #I >= 50 And #I = '103' |  | SELECT DISTINCT @STD_ID_HR = #MAX(A.STD_ID_HR), @STD_OR_HR_PERIOD = #MAX(A.STD_OR_HR_PERIOD), @SAR_ID_ENTIDAD = #MAX(A.SAR_ID_ENTIDAD), @SAR_PORC_INFO_XML = A.SAR_PORC_INFO_XML, @SAR_ID_PARENTESCO = #MAX(A.SAR_ID_PARENTESCO), @SAR_CUIL_FAM = A.SAR_CUIL_FAM FROM &SAR_H_COMPLEM A WHERE (( A.ID_ORGANIZATION = $ID_ORGANIZATION And A.STD_ID_HR = @SAR_ID_HR And A.STD_OR_HR_PERIOD = @SAR_OR_HR_PERIOD And A.SAR_DT_START <= @SAR_FEC_FIN_PAGA And A.SAR_DT_END >= @SAR_FEC_INI_PAGA And A.SAR_ID_ENTIDAD = '32' And A.SAR_PORC_INFO_XML >= 50 And A.SAR_ID_PARENTESCO = '103')) GROUP BY A.SAR_CUIL_FAM, A.SAR_PORC_INFO_XML ORDER BY A.SAR_PORC_INFO_XML ASC 
