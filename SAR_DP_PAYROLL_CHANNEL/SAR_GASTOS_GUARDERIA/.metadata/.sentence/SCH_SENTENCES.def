# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GASTOS_GUARDERIA | 1 | 0 | 1 |  | 80 |  |  | #I = $ ID_ORGANIZATION And #I = ? And #I >= ? And #I <= ? |  | SELECT DISTINCT @STD_ID_FAMILY_PERSON = A.STD_ID_FAMILY_PERSON, @SAR_IMPORTE = #SUM(A.SAR_IMPORTE), @ID_CURRENCY = #MAX(A.ID_CURRENCY), @CUR_DATE = #MAX(A.CUR_DATE), @EX_TYPE = #MAX(A.EX_TYPE), @STD_DT_BIRTH = #MAX(C.STD_DT_BIRTH) FROM &SAR_GASTOS_GUARDERIA A, STD_PERSON C, STD_FAMILY B WHERE B.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND B.STD_ID_FAMILY_PERSON = C.STD_ID_PERSON(+) AND A.STD_ID_FAMILY_PERSON = B.STD_ID_FAMILY_PERSON(+) AND A.STD_ID_HR = B.STD_ID_HR(+) AND (A.ID_ORGANIZATION = $ID_ORGANIZATION And A.STD_ID_HR = @SAR_ID_HR And A.SAR_FECHA_GASTO >= @SAR_FEC_INI And A.SAR_FECHA_GASTO <= @SAR_FEC_FIN) GROUP BY A.STD_ID_FAMILY_PERSON ORDER BY A.STD_ID_FAMILY_PERSON ASC
