# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SWP_NODES_AC_CALC | 0 | 0 |  |  | 10 |  |  | #I = ? |  | SELECT @ID_NODE_AC_READ = A.ID_NODE_AC_READ, @ID_NODE_AC_CALC = A.ID_NODE_AC_CALC, @ID_T3_PAYROLL = A.ID_T3_PAYROLL, @BACK_MONTH = A.BACK_MONTH, @FORWARD_MONTH = A.FORWARD_MONTH, @PAY_FRECUENCY = A.PAY_FRECUENCY, @PAY_TYPE = A.PAY_TYPE, @REV_BEHAVIOUR = A.REV_BEHAVIOUR, @SEARCH_TYPE = A.SEARCH_TYPE, @SEL_PAYS = A.SEL_PAYS, @START_POINT = A.START_POINT, @TOT_OPERATION = A.TOT_OPERATION FROM &SWP_NODES_AC_CALC A, SCH_T3_INHERIT B WHERE A.ID_NODE_AC_CALC_T3 = B.ID_T3_BASE AND (B.ID_T3 = @SCO_ID_ACTUAL_CHANNEL)
