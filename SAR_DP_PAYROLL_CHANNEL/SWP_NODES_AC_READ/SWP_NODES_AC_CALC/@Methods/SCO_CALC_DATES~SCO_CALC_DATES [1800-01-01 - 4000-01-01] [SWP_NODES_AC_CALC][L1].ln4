SelPays = SEL_PAYS

DtAllocation = GETVALUE(SWP_NODES_AC_READ.ID_NODE_DATES,"SCO_DT_ALLOCATION",-1)
DtPayment=GETVALUE(SWP_NODES_AC_READ.ID_NODE_DATES,"SCO_DT_PAYMENT",-1)

SetSliceMode(M4_FALSE)
SetValue(ID_NODE_AC_CALC,"SCO_DT_ALLOCATION",-1,DtAllocation)
SetValue(ID_NODE_AC_CALC,"SCO_DT_PAYMENT",-1,DtPayment)
SetSliceMode(SCO_PAYS_TO_CALC.SCO_SLICE_MODE)

SearchType = SEARCH_TYPE
StartPoint = START_POINT
BackMonth = BACK_MONTH
ForwardMonth = FORWARD_MONTH

FirstYear = 0
FirstMonth = 0
FirstDay = 0

X = 0
Mnaux = 0
If SelPays = 2 Then
	Return(1)
Else
	If SelPays = 3 Then
		If SearchType = 1 Then
			DtStart = DtAllocation
			DtEnd = DtAllocation
		Else
			DtStart = DtPayment
			DtEnd =  DtPayment
		EndIf
	Else
		If SelPays = 1 Then
			If StartPoint = "DYN" Then   'Dynamically calculated Source
				Return(2)
			EndIf

			If SearchType = 1 Then
				DtSearch = DtAllocation
			Else
				DtSearch = DtPayment
			EndIf
			x = DateToNumbers(DtSearch,FirstYear,FirstMonth,FirstDay)
			MaxNumMonth = (FirstYear * 12) + FirstMonth

			If StartPoint = "B" Then
				FirstMonth = ToInt((FirstMonth-1)/2)*2+1
			EndIf
			If StartPoint = "T" Then
				FirstMonth = ToInt((FirstMonth-1)/3)*3+1
			EndIf
			If StartPoint = "C" Then
				FirstMonth = ToInt((FirstMonth-1)/4)*4+1
			EndIf
			If StartPoint = "S" Then
				FirstMonth = ToInt((FirstMonth-1)/6)*6+1
			EndIf
			If StartPoint = "A" Then
				FirstMonth = 1
			EndIf

			If Mid(StartPoint,0,1) = "N" Then
				FirstMonth = ToInt(Mid(StartPoint,1,2))
			EndIf

			If Mid(StartPoint,0,1) = "B" Then
				mnaux = ToInt(Mid(StartPoint,1,2))
				If mnaux >= FirstMonth Then
					FirstYear = FirstYear - 1
				EndIf
				FirstMonth = mnaux
			EndIf

			TotalMonth = (FirstYear * 12) + FirstMonth - BackMonth
			FirstYear = ToInt((TotalMonth - 1)/12)
			FirstMonth = TotalMonth - (FirstYear * 12)

			TotalMonth = (FirstYear * 12) + FirstMonth + ForwardMonth -1
			'incluida
			DtStart = NumbersToDate(FirstYear,FirstMonth)
			If TotalMonth >= MaxNumMonth Then
				TotalMonth = MaxNumMonth
				DtEnd=DtSearch-1
			Else
				LastYear = ToInt((TotalMonth - 1)/12)
				LastMonth = TotalMonth - (LastYear * 12)

				LastDay = DxDaysOfMonth(LastMonth, LastYear)
				'DtStart = NumbersToDate(FirstYear,FirstMonth)
				DtEnd = NumbersToDate(LastYear,LastMonth,LastDay)
			endif
		EndIf
	EndIf
EndIf


SetSliceMode(M4_FALSE)
SetValue(ID_NODE_AC_CALC,"SCO_DT_START",-1,DtStart)
SetValue(ID_NODE_AC_CALC,"SCO_DT_END",-1,DtEnd)
SetSliceMode(SCO_PAYS_TO_CALC.SCO_SLICE_MODE)

SCO_DT_START = DtStart
SCO_DT_END = DtEnd

Return(0)
