'
'Busco el precio del sueldo que tiene el empleado a la fecha recibida por argumento.
'Leo dicho precio desde el tramo correspondiente al concepto 1002 si está cargado a nivel
'de period, sino loleo del tramo correspondiente al concepto 10002 (nivel de rol)
'La fórmula del precio se calcula según el concepto recibido por parámetro
'
SALARIO = 0
SUELDO_PERIOD = SAR_HRPERIOD_CALC.SAR_P_SUELDO
IF SUELDO_PERIOD > 0 THEN
    NUM_TRAMOS_SUELDO_PERIOD = SAR_HRPERIOD_CALC.SAR_P_SUELDO..SysSliceNumber
    FOR I = 0 TO NUM_TRAMOS_SUELDO_PERIOD - 1
        INICIO_TRAMO = SAR_HRPERIOD_CALC.SAR_P_SUELDO[I]..SysStartDate
        FIN_TRAMO = SAR_HRPERIOD_CALC.SAR_P_SUELDO[I]..SysEndDate
        IF ARG_FECHA >= INICIO_TRAMO AND ARG_FECHA <= FIN_TRAMO THEN
            IF ARG_CONCEPTO = "#4108" OR ARG_CONCEPTO = "#4110" OR ARG_CONCEPTO = "#4120" THEN
                //valor=(#4040 + SAR_ACM_6_MESES_EXTR.SAR_ACM_ANT_PROM)/#400
                SALARIO = (SAR_HRPERIOD_CALC.SAR_P_SUELDO[I]/30)
            ELSEIF ARG_CONCEPTO = "#4060" OR ARG_CONCEPTO = "#4070" OR ARG_CONCEPTO = "#4080" OR ARG_CONCEPTO = "#4090" OR ARG_CONCEPTO = "#4100" THEN
                //valor=(#4040 + SAR_ACM_6_MESES_EXTR.SAR_ACM_ANT_PROM)/25
                SALARIO = (SAR_HRPERIOD_CALC.SAR_P_SUELDO[I] / 25)
            ELSEIF ARG_CONCEPTO = "#4463" THEN
                SALARIO = (SAR_HRPERIOD_CALC.SAR_P_SUELDO[I]/30)
            ENDIF
        ENDIF
    NEXT
ELSE
    SUELDO_ROL = SAR_HRROLE_CALC.SAR_P_SAL_BASE
    IF SUELDO_ROL > 0 THEN
        NUM_TRAMOS_SUELDO_ROLE = SAR_HRROLE_CALC.SAR_P_SAL_BASE..SysSliceNumber
        FOR I = 0 TO NUM_TRAMOS_SUELDO_ROLE - 1
            INICIO_TRAMO = SAR_HRROLE_CALC.SAR_P_SAL_BASE[I]..SysStartDate
            FIN_TRAMO = SAR_HRROLE_CALC.SAR_P_SAL_BASE[I]..SysEndDate
            IF ARG_FECHA >= INICIO_TRAMO AND ARG_FECHA <= FIN_TRAMO THEN
                IF ARG_CONCEPTO = "#4108" OR ARG_CONCEPTO = "#4110" OR ARG_CONCEPTO = "#4120" THEN
                    //valor=(#4040 + SAR_ACM_6_MESES_EXTR.SAR_ACM_ANT_PROM)/#400
                    SALARIO = (SAR_HRROLE_CALC.SAR_P_SAL_BASE[I] / 30)
                ELSEIF ARG_CONCEPTO = "#4060" OR ARG_CONCEPTO = "#4070" OR ARG_CONCEPTO = "#4080" OR ARG_CONCEPTO = "#4090" OR ARG_CONCEPTO = "#4100" THEN
                    //valor=(#4040 + SAR_ACM_6_MESES_EXTR.SAR_ACM_ANT_PROM)/25
                    SALARIO = (SAR_HRROLE_CALC.SAR_P_SAL_BASE[I] / 25)
                ELSEIF ARG_CONCEPTO = "#4463" THEN
                    SALARIO = (SAR_HRROLE_CALC.SAR_P_SAL_BASE[I] / 30)
                ENDIF
            ENDIF
        NEXT
    ENDIF
ENDIF
Return(SALARIO)

