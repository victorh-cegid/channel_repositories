# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_OTROS_ACCID | 0 | 0 | 1 |  | 80 |  |  | #I >= ? And #I <= ? |  | SELECT @STD_ID_HR = A.STD_ID_HR, @ID_ORGANIZATION = A.ID_ORGANIZATION, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @SAR_ID_ORDINAL = A.SAR_ID_ORDINAL, @SAR_DT_START = A.SAR_DT_START FROM &SAR_H_RECAIDAS A WHERE (A.SAR_DT_START >= @SAR_DT_PAY_START_ANT And A.SAR_DT_START <= @SAR_DT_ALLOC_END) ORDER BY A.ID_ORGANIZATION ASC
