# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_ACCID_ACT | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @SAR_ID_ORDINAL = A.SAR_ID_ORDINAL, @SAR_PRECIO_DIARIO = A.SAR_PRECIO_DIARIO, @SAR_ID_CURRENCY = A.SAR_ID_CURRENCY, @SAR_CUR_DATE = A.SAR_CUR_DATE, @SAR_EX_TYPE = A.SAR_EX_TYPE, @SAR_DT_START = C.SAR_DT_START, @SAR_DT_END = C.SAR_DT_END, @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_DT_ACC = A.SCO_DT_ACC FROM &SAR_X_ACCIDENTE A, SAR_H_RECAIDAS C WHERE C.ID_ORGANIZATION(+) = A.ID_ORGANIZATION AND C.SAR_ID_ORDINAL(+) = A.SAR_ID_ORDINAL AND C.STD_ID_HR(+) = A.STD_ID_HR AND C.STD_OR_HR_PERIOD(+) = A.STD_OR_HR_PERIOD AND (C.SAR_DT_START <= @SAR_DT_ALLOC_END And ( C.SAR_DT_END >= @SAR_DT_ALLOC_START Or C.SAR_DT_END IS NULL ))
