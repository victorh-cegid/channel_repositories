# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_HR_PERIOD | 0 | 0 | 1 |  | 80 |  |  |  |  | SELECT @SAR_ID_SIT_REVISTA = A.SAR_ID_SIT_REVISTA, @SAR_CODIGO = A.SAR_CODIGO, @STD_DT_BIRTH = D.STD_DT_BIRTH, @SAR_CERTIF_ORIG = A.SAR_CERTIF_ORIG, @SPO_EXT_TELEF = A.SPO_EXT_TELEF, @SPO_ID_EST_SALARIO = A.SPO_ID_EST_SALARIO, @SSP_FEC_ANTIGUEDAD = A.SSP_FEC_ANTIGUEDAD, @SSP_FEC_EXTRAS = A.SSP_FEC_EXTRAS, @SAR_FEC_ANTIG_INDEM = A.SAR_FEC_ANTIG_INDEM FROM &STD_HR_PERIOD A, STD_PERSON D WHERE A.STD_ID_HR = D.STD_ID_PERSON(+) ORDER BY A.STD_ID_HR ASC, A.STD_OR_HR_PERIOD ASC
