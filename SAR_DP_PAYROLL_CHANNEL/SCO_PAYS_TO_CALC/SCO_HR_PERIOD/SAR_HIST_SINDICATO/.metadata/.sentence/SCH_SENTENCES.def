# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_HIST_SINDICATO | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @DT_START = A.DT_START, @DT_END = A.DT_END, @SAR_ID_SINDICATO = A.SAR_ID_SINDICATO, @SAR_NRO_AFILIADO = A.SAR_NRO_AFILIADO, @ID_ORGANIZATION = A.ID_ORGANIZATION FROM &SAR_H_SINDICATO A WHERE (A.DT_START <= @SAR_FECHA_FILTRO And ( A.DT_END >= @SAR_FECHA_FILTRO Or A.DT_END IS NULL ))
