DestroyBlock()
PAR_ID_EMPRESA = ARG_EMPRESA
PAR_DMD_COMPONENT = ARG_CONCEPTO
PAR_FECHA_IG = ARG_FECHA_IG
ind = ARG_IND_IG

'---------------------------------------------------------------------------
'Modificación ante la circular 1/2011 de al AFIP respecto a la RES 3008.
'---------------------------------------------------------------------------
anio_ig = DxYear(PAR_FECHA_IG)

IF ind = 0 THEN
    IF anio_ig = 2010 AND SAR_HRPERIOD_CALC.#SAR_TP_IMPUT = "99" THEN
        PAR_FECHA_IG = DxDate(31,12,2009)
    ENDIF
ENDIF
'---------------------------------------------------------------------------

Load_blk()
If Count() > 0 Then
    Begin()
    Return (SCO_VALUE)
Endif

Return(0)
