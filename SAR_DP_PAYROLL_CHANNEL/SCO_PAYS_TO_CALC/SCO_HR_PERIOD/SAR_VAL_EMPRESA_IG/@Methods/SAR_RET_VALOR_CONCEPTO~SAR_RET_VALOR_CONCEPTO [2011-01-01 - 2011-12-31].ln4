DestroyBlock()
PAR_ID_EMPRESA = ARG_EMPRESA
PAR_DMD_COMPONENT = ARG_CONCEPTO
PAR_FECHA_IG = ARG_FECHA_IG
ind = ARG_IND_IG
fec_baja = SAR_HR_PERIOD.STD_DT_END

'---------------------------------------------------------------------------
'Modificacion ante la circular para las bajas del a?o 2011.
'---------------------------------------------------------------------------
anio_ig = DxYear(PAR_FECHA_IG)

IF ind = 0 THEN
    IF fec_baja >= todate("01-01-2011") and fec_baja <= todate("31-12-2011") THEN
        PAR_FECHA_IG = DxDate(31,12,2009)
    ENDIF
ENDIF
'---------------------------------------------------------------------------

Load_blk()
If Count() > 0 Then
    Begin()
    Return (SCO_VALUE)
Endif

Return(0)
