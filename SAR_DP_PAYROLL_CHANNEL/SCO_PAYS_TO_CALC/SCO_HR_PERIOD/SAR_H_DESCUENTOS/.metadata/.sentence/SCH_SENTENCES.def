SAR_H_DESCUENTOS | 0 | 0 | 1 |  | 80 |  |  | ( #I <= ? And #I >= ? And #I = ? And #I <= ? And #I >= ? ) |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @STD_DT_END = D.STD_DT_END, @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @SAR_OR_DESCUENTO = A.SAR_OR_DESCUENTO, @SAR_DT_START = A.SAR_DT_START, @SAR_DT_END = A.SAR_DT_END, @SAR_ID_DESCUENTO = A.SAR_ID_DESCUENTO, @SAR_PRIORIDAD_DESC = A.SAR_PRIORIDAD_DESC, @SAR_PORCENTAJE = C.SAR_PORCENTAJE, @SAR_VALOR_FIJO = C.SAR_VALOR_FIJO, @ID_CURRENCY = C.ID_CURRENCY, @CUR_DATE = C.CUR_DATE, @EX_TYPE = C.EX_TYPE, @SAR_FACTOR = C.SAR_FACTOR, @SAR_ID_DMD_COMPONENT = C.SAR_ID_DMD_COMPONENT, @SCO_ID_PAY_TYPE = B.SCO_ID_PAY_TYPE, @SAR_ID_NODE = C.SAR_ID_NODE FROM &SAR_H_DESCUENTOS A, SAR_TIPOS_PAGA_DESC B, SAR_BASE_DESC C, STD_HR_PERIOD D WHERE B.ID_ORGANIZATION(+) = A.ID_ORGANIZATION AND B.SAR_OR_DESCUENTO(+) = A.SAR_OR_DESCUENTO AND B.STD_ID_HR(+) = A.STD_ID_HR AND B.STD_OR_HR_PERIOD(+) = A.STD_OR_HR_PERIOD AND C.ID_ORGANIZATION(+) = B.ID_ORGANIZATION AND C.SAR_OR_DESCUENTO(+) = B.SAR_OR_DESCUENTO AND C.SCO_ID_PAY_TYPE(+) = B.SCO_ID_PAY_TYPE AND C.STD_ID_HR(+) = B.STD_ID_HR AND C.STD_OR_HR_PERIOD(+) = B.STD_OR_HR_PERIOD AND A.ID_ORGANIZATION = D.ID_ORGANIZATION(+) AND A.STD_ID_HR = D.STD_ID_HR(+) AND A.STD_OR_HR_PERIOD = D.STD_OR_HR_PERIOD(+) AND (( A.SAR_DT_START <= @SAR_DT_PAY_END And A.SAR_DT_END >= @SAR_DT_PAY_START And B.SCO_ID_PAY_TYPE = @SCO_PAY_TYPE_ALLOC And C.SAR_DT_START <= @SAR_FECHA_FILTRO And C.SAR_DT_END >= @SAR_FECHA_FILTRO ))
