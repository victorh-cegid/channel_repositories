curr=getcurrent()
Numreg=Count()              

If  Numreg>0 then
	for i=0 to Numreg-1
		moveto(i)

		If SCO_PROCESS_CURR<>ID_CURRENCY then
		
                If SCO_PROCESS_CURR = "EUR" Then
                    SCO_EURO_ROUND()            
                Else 	
                    CUREXCHANGERECORDROUNDED(SCO_PROCESS_CURR,0)
                EndIf
                
		Endif
	next
Endif

moveto(curr)

RETURN(0)
