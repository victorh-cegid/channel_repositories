# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_PERSON_CALC | 0 | 0 | 1 |  | 80 |  |  |  |  | SELECT @SSP_FEC_ANTIGUEDAD = C.SSP_FEC_ANTIGUEDAD, @STD_SS_NUMBER = A.STD_SS_NUMBER FROM &STD_PERSON A, STD_HR_PERIOD C, STD_HR B WHERE B.ID_ORGANIZATION(+) = A.ID_ORGANIZATION AND B.STD_ID_HR(+) = A.STD_ID_PERSON AND C.ID_ORGANIZATION(+) = B.ID_ORGANIZATION AND C.STD_ID_HR(+) = B.STD_ID_HR
