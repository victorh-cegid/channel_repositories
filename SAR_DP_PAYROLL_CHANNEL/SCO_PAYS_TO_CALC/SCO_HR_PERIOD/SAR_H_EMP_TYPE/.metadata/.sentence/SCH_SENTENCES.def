# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_EMP_TYPE | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @SAR_ID_COD_COND = A.SAR_ID_COD_COND FROM &SCO_H_EMPLOYEE_TYPE A WHERE (A.SCO_DT_START <= @SAR_P_FECHA And A.SCO_DT_END >= @SAR_P_FECHA)
