'Procesamos el alta del empleado en caso de serlo:
     '      Buscamos todos los conceptos candidatos:
     '                   1- Los que están siendo cargados en la paga o tengan valor acumulado por si existe paga extra tendrán una ocurrencia.
     '                   2- El resto no tendrán ocurrencias. 
     '      y para ellos cargamos en SAR_HABITUALES una fila nueva. 
     '      Esto lo hace el metodo SAR_ALTAS_HABITUALES.

If(SAR_HABITUALES.Count() = 0)Then 'Vemos que el empleado no tenga conceptos en SAR_HABITUALES (Caso de liquidar de nuevo el mes del alta)
    M4SAR_X_CAND_HAB.LOAD_BLK() 
    M4SAR_X_CAND_HAB.Begin() 
    CantRegCandHab = M4SAR_X_CAND_HAB.Count() - 1
    ContRegCandHab = 0    
    While(ContRegCandHab <= CantRegCandHab) 
        M4SAR_X_CAND_HAB.MoveTo(ContRegCandHab)
        SAR_HABITUALES.AddRegister()
        SAR_HABITUALES.ID_ORGANIZATION      = M4SAR_X_CAND_HAB.ID_ORGANIZATION    
        'SAR_HABITUALES.STD_ID_HR            = SAR_HR_PERIO.STD_ID_HR    
        'SAR_HABITUALES.STD_OR_HR_PERIOD     = SAR_HR_PERIOD.STD_OR_HR_PERIOD    
        SAR_HABITUALES.STD_ID_HR            = GetValue("SAR_HR_PERIOD", "STD_ID_HR",-1)    
        SAR_HABITUALES.STD_OR_HR_PERIOD     = GetValue("SAR_HR_PERIOD", "STD_OR_HR_PERIOD",-1)
        SAR_HABITUALES.SAR_ID_DMD_COMPONENT = M4SAR_X_CAND_HAB.SAR_ID_DMD_COMPONENT 
        SAR_HABITUALES.SAR_ID_SYNONYM       = M4SAR_X_CAND_HAB.SAR_ID_SYNONYM                                      
        SAR_HABITUALES.SAR_ID_DMD           = M4SAR_X_CAND_HAB.SAR_ID_DMD   
        SAR_HABITUALES.SAR_ID_NODE          = M4SAR_X_CAND_HAB.SAR_ID_NODE   
        'SAR_HABITUALES.SAR_CONCEPTO_NUEVO   = M4SAR_X_CAND_HAB.SAR_CONCEPTO_NUEVO
        SAR_HABITUALES.SAR_DT_VIGENCIA      = ARG_FEC_VIG   
        SAR_HABITUALES.SAR_DT_VIGEN_IMPUT   = ARG_FEC_VIG
        VAL_CON_PAGA = GetValue("SCO_HRPERIOD_CALC",M4SAR_X_CAND_HAB.SAR_ID_DMD_COMPONENT,-1)  'Tomamos el valor del concepto en la paga actual.
        SAR_HABITUALES.SAR_CANT_DE_OCURR    = 0 'Pero se debe actualizar las OCURR en la normal.
        SAR_HABITUALES.SAR_PROCESADO        = 0
        If(VAL_CON_PAGA > 0)Then
            SAR_HABITUALES.SAR_DT_PAGA_NORMAL   = ARG_FEC_IMP
            SAR_HABITUALES.SAR_CANT_DE_OCURR    = 1 'Pero se debe actualizar las OCURR en la normal.
            SAR_HABITUALES.SAR_PROCESADO        = 1                        
        EndIf
        ContRegCandHab = ContRegCandHab + 1           
     Wend
EndIf
Return(0)
