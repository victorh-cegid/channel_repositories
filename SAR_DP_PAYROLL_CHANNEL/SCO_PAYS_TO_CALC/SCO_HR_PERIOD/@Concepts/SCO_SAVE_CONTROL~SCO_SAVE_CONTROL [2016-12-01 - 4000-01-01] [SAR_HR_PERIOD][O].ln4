AUX = 0
if (SCO_AUX_AC_HRPERIOD_1.SCO_TOT_DEDUCTIONS<>0 OR SCO_AUX_AC_HRPERIOD_1.SCO_TOT_EARNINGS<>0 OR SAR_PAYS_TO_CALC.SCO_REVISION=0)   Then
    AUX=1
endif

'Modificación para el ajuste de horas extras ya devengadas al RG3976
'Se inicia la regla a 01/12/2016 para tener en cuenta empleados diferidos 
If (SAR_HRPERIOD_CALC.SAR_IND_ADJ_EXTRAS_RG3976 = 1) Then
    AUX = 1
EndIf

'Control ajuste deducciones 12ava parte SAC
If SCO_AUX_AC_HRPERIOD_1.SAR_JUB_SAC_MES<>0 Or SCO_AUX_AC_HRPERIOD_1.SAR_LEY_19032_SAC_MES <> 0 Or SCO_AUX_AC_HRPERIOD_1.SAR_OBRA_SOCIAL_SAC_MES <> 0 Or SCO_AUX_AC_HRPERIOD_1.SAR_C_SINDICAL_SAC_MES <> 0 Then AUX = 1

'Control contribuciones 27430
If SCO_AUX_AC_HRPERIOD_1.SAR_REMUN_IMPO_CNT<>0 Or SCO_AUX_AC_HRPERIOD_1.SAR_BASE_CO_ART_CNT<>0 Or SCO_AUX_AC_HRPERIOD_1.SAR_SAC_IMPO_CNT <> 0 Or SCO_AUX_AC_HRPERIOD_1.SAR_VAC_IMPO_CNT<>0 Then AUX = 1

'Control cambio de base en retro
If SCO_AUX_AC_HRPERIOD_1.SAR_IND_IMPUESTO_RETRO > 0 Then
    baseOrig = SCO_AC_HR_PERIOD_REV_1.SAR_BASE_IMPUESTO
    baseAct = SCO_AUX_AC_HRPERIOD_1.SAR_BASE_IMPUESTO
    baseDif = baseAct - baseOrig
    If baseDif <> 0 Then AUX = 1

    DedTramoUnoOrig = SCO_AC_HR_PERIOD_REV_1.SAR_DED_IG_27617_4TA
    DedTramoUnoAct = SCO_AUX_AC_HRPERIOD_1.SAR_DED_IG_27617_4TA
    DedTramoUnoDif = DedTramoUnoAct - DedTramoUnoOrig
    If DedTramoUnoDif <> 0 Then AUX = 1

    DedTramoDosOrig = SCO_AC_HR_PERIOD_REV_1.SAR_DED_IG_27617_T2_4TA
    DedTramoDosAct = SCO_AUX_AC_HRPERIOD_1.SAR_DED_IG_27617_T2_4TA
    DedTramoDosDif = DedTramoDosAct - DedTramoDosOrig
    If DedTramoDosDif <> 0 Then AUX = 1    
EndIf

'Control bonos/fallos de caja/similar naturaleza otros empleadores
If SCO_AUX_AC_HRPERIOD_1.SAR_IMP_BONOS_OE_MES<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_IMP_FCAJAS_OE_MES<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_IMP_SIMILAR_NAT_OE_MES<>0 Then AUX = 1

'Conceptos de ajuste impuesto para DEI:
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_BONO<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_CUOSIN<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_DIF_SAC<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_FCAJA<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_JUB<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_LEY<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_O_DED<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_OSOC<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_REM_IMP<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_SAC_MES<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_SEG_SEP<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_SEG_VIDA<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_SIMILAR_NAT<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_PROR_CON_AP<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_PROR_SIN_AP<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_BASE_PRORRAT<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_BASE_REM_PRORR<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_BASE_REM_PROR_OS<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_AJIG_BASE_REM_PROR_SIND<>0 Then AUX = 1

'Beneficio agosto 2023
If SCO_AUX_AC_HRPERIOD_1.SAR_AGO23_BENEF_TOTAL<>0 Then AUX = 1

'Beneficio DEC. 473/23
If SCO_AUX_AC_HRPERIOD_1.SAR_SEP23_BENEF_TOTAL<>0 Then AUX = 1

'En paga especial reliq. septiembre, se fuerza el grabado en acumulado.
If SCO_DT_ALLOCATION = DxDate(30,9,2023) Then AUX = 1

'Beneficio ley de bases 2024
If SCO_AUX_AC_HRPERIOD_1.SAR_LBASE_BENEFICIO<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_LBASE_BEN_NEG<>0 Then AUX = 1
If SCO_AUX_AC_HRPERIOD_1.SAR_TOT_REM_IMP<>0 Then AUX = 1

if SAR_FREC_CONTROL = 1 then
    AUX=0
ENDIF
Return(AUX)
