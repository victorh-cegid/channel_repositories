'Este metodo filtra por fechas los periodos que esten de alta durante el periodo de la paga
'Ademas permite la carga en este nodo de los periodos que tengan definidos pagos despues de la baja (siempre que no sea
'una paga retroactiva) y los periodos para los que hay que calcular la baja retroactiva

SCO_FILTER_DATES_PAL_PARAM = ToString(SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC,0) + "|" + ToString(SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC,0) + "|" + ToString(SCO_PAYS_TO_CALC.SCO_DT_PAYMENT,0) + "|" + ToString(SCO_PAYS_TO_CALC.SCO_DT_ALLOCATION,0) + "|" + ToString(SCO_PAYS_TO_CALC.SCO_PAY_FREQ_PAYM,0) + "|" + ToString(SCO_PAYS_TO_CALC.SCO_DT_ALLOCATION,0) + "|" + ToString(SCO_PAYS_TO_CALC.SCO_DT_PAYMENT,0) + "|" + SCO_PAYS_TO_CALC.SCO_PAY_FREQ_ALLOC + "|" + ToString(SCO_PAYS_TO_CALC.SCO_DT_PAYMENT,0) + "|" + SCO_PAYS_TO_CALC.SCO_PAY_FREQ_PAYM

filter = "FROM &STD_HR_PERIOD A WHERE EXISTS (SELECT 1 FROM &STD_HR_PERIOD B WHERE B.ID_ORGANIZATION=A.ID_ORGANIZATION AND B.STD_ID_HR=A.STD_ID_HR AND B.STD_OR_HR_PERIOD=A.STD_OR_HR_PERIOD AND B.STD_DT_END >= ?(4,0,0) AND B.STD_DT_START <= ?(4,0,0) UNION SELECT 1 FROM &SCO_PAL C WHERE C.ID_ORGANIZATION=A.ID_ORGANIZATION AND C.SCO_ID_HR=A.STD_ID_HR AND C.SCO_OR_HR_PERIOD=A.STD_OR_HR_PERIOD AND C.SCO_DT_PAYMENT = ?(4,0,0) AND C.SCO_DT_PAYMENT = ?(4,0,0) AND C.SCO_ID_PAY_FREQUENCY = ?(2,3,0) UNION SELECT 1 FROM &SCO_RETRO_TERMINATION D WHERE D.ID_ORGANIZATION=A.ID_ORGANIZATION AND D.SCO_ID_HR=A.STD_ID_HR AND D.SCO_OR_HR_PERIOD=A.STD_OR_HR_PERIOD AND D.SCO_DT_ALLOCATION = ?(4,0,0) AND D.SCO_DT_ALLOCATION <> ?(4,0,0) AND D.SCO_PAY_FREQ_ALLOC = ?(2,3,0) AND ( D.SCO_DT_PAYMENT IS NULL OR (D.SCO_DT_PAYMENT = ?(4,0,0) AND D.SCO_PAY_FREQ_PAYM = ?(2,3,0)) ) )"

Return(filter)
