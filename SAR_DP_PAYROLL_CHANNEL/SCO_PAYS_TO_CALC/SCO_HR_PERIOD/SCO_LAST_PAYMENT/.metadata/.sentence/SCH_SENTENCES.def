# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SCO_LAST_PAYMENT | 0 | 0 |  |  | 10 |  |  | #I = '01' And #I = '1' |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_DT_PAYMENT = A.SCO_DT_PAYMENT, @ID_CURRENCY_PRIM = A.ID_CURRENCY_PRIM, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @EX_TYPE = A.EX_TYPE, @DT_EXCHANGE = A.DT_EXCHANGE, @SCO_PAY_FREQ_PAYM = A.SCO_PAY_FREQ_PAYM, @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_AMT_PAYM_PRIM = A.SCO_AMT_PAYM_PRIM FROM &SCO_PAYMENT A, SCO_PAY_TRANSMIS C WHERE A.ID_ORGANIZATION = C.ID_ORGANIZATION AND A.SCO_ID_PAY_TRANSMI = C.SCO_ID_PAY_TRANSMI AND (A.SCO_ID_ORIGIN_TYPE = '01' And C.SCO_CONFIRMATION = '1')
