//Solo se graba el historico si se ha chequeado en el lanzador que se graben los pagos y si no ha dado error el calculo
If SCO_HT_PAYS.SCO_GEN_PAYMENTS <> 1 or SCO_HR_PERIOD.SCO_ERROR = 1 Then
    return(0)
EndIf

//Si existen historias que empiecen en esta paga o posteriores, las borramos

SCO_SQL_H_SAL = "DELETE SCO_H_SAL_DATA A WHERE A.SCO_ID_HR=@SCO_ID_HR AND A.SCO_OR_HR_PERIOD=@SCO_OR_HR_PERIOD AND A.ID_ORGANIZATION = @ID_ORGANIZATION AND A.SCO_DT_START >= @SCO_DT_ALLOC_START"
SCO_SQL_H_SAL(0,1)

Insert_Blk() 

return(0)
