# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SCO_H_SAL_DATA | 0 | 0 | 1 |  | 10 |  |  | #I < ? And #I >= ( ? - 1 ) |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_ID_HR = A.SCO_ID_HR, @SCO_BNFT_LEG_ENT = A.SCO_BNFT_LEG_ENT, @SCO_BNFT_LEG_PER = A.SCO_BNFT_LEG_PER, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @SCO_FIX_SALARY = A.SCO_FIX_SALARY, @ID_CURRENCY = A.ID_CURRENCY, @SCO_DT_EXCHANGE = A.SCO_DT_EXCHANGE, @EX_TYPE = A.EX_TYPE, @SCO_VAR_SALARY = A.SCO_VAR_SALARY, @SCO_FIX_SALARY_PER = A.SCO_FIX_SALARY_PER, @SCO_VAR_SALARY_PER = A.SCO_VAR_SALARY_PER, @SCO_COT_EMP = A.SCO_COT_EMP FROM &SCO_H_SAL_DATA A WHERE (A.SCO_DT_START < @SCO_DT_ALLOC_START And A.SCO_DT_END >= ( @SCO_DT_ALLOC_START - 1 ))
