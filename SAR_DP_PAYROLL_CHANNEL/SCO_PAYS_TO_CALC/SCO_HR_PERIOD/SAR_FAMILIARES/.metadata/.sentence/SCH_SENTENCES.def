# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_FAMILIARES | 1 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) And #I = $ ID_ORGANIZATION |  | SELECT DISTINCT @STD_ID_HR = A.STD_ID_HR, @SSP_ID_MINUSVALIA = A.SSP_ID_MINUSVALIA, @STD_OR_DEP_NB = A.STD_OR_DEP_NB, @STD_DT_START = A.STD_DT_START, @STD_DT_END = A.STD_DT_END, @STD_ID_DEP_TYPE = A.STD_ID_DEP_TYPE, @STD_ID_FAMILY_PERSON = A.STD_ID_FAMILY_PERSON, @ID_ORGANIZATION = A.ID_ORGANIZATION, @STD_DT_BIRTH = C.STD_DT_BIRTH, @STD_ID_ACT_DEP_TYPE = E.STD_ID_ACT_DEP_TYPE FROM &STD_FAMILY A, STD_PERSON C, STD_LU_DEP_TYPE D, STD_LU_ACT_DEP_TYPE E WHERE A.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND A.STD_ID_FAMILY_PERSON = C.STD_ID_PERSON(+) AND A.ID_ORGANIZATION = D.ID_ORGANIZATION(+) AND A.STD_ID_DEP_TYPE = D.STD_ID_DEP_TYPE(+) AND D.ID_ORGANIZATION = E.ID_ORGANIZATION(+) AND D.STD_ID_ACT_DEP_TYPE = E.STD_ID_ACT_DEP_TYPE(+) AND (A.STD_DT_START <= @SAR_DT_ALLOC_END And ( A.STD_DT_END >= @SAR_DT_ALLOC_START Or A.STD_DT_END IS NULL ) And D.ID_ORGANIZATION = $ID_ORGANIZATION)
