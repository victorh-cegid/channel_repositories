# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_FAM_A_CARGO | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) And ( #I <= ? ) And ( #I >= ? ) |  | SELECT @SAR_ID_TIPO_ASIG = A.SAR_ID_TIPO_ASIG, @STD_ID_HR = B.STD_ID_HR, @STD_DT_START = B.STD_DT_START, @STD_DT_END = B.STD_DT_END, @STD_OR_DEP_NB = B.STD_OR_DEP_NB, @STD_ID_FAMILY_PERSON = B.STD_ID_FAMILY_PERSON, @STD_ID_DEP_TYPE = B.STD_ID_DEP_TYPE, @SAR_ID_OCUPACION = A.SAR_ID_OCUPACION, @SAR_DT_PRES_CERT = A.SAR_DT_PRES_CERT, @SAR_DT_ALTA_FAM_CARGO = A.SAR_DT_ALTA_FAM_CARGO, @SAR_DT_INICIO_EMBAR = A.SAR_DT_INICIO_EMBAR, @SAR_DT_BAJA_FAM_CARGO = A.SAR_DT_BAJA_FAM_CARGO, @SAR_DT_DEC_JUR = A.SAR_DT_DEC_JUR, @DT_START = A.DT_START, @DT_END = A.DT_END FROM &SAR_FAMILY_LEGAL A, STD_FAMILY B WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.STD_ID_HR = B.STD_ID_HR(+) AND A.STD_OR_DEP_NB = B.STD_OR_DEP_NB(+) AND (B.STD_DT_START <= @SAR_DT_ALLOC_END And ( B.STD_DT_END >= @SAR_DT_ALLOC_START Or B.STD_DT_END IS NULL ) And ( A.DT_START <= @SAR_FECHA_FILTRO ) And ( A.DT_END >= @SAR_FECHA_FILTRO ))
