'Calcula la cantidad real de días trabajados en el período que se encuentra entre
'el inicio y fin de cada tramo (el inicio y fin de tramo viene como argumento)

If SAR_TP_IMPUT = "2" then Return(0)

dias_paga = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC - SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC + 1

IF dias_paga = 0 THEN
    Return(0)
ENDIF

FECHA_FIN_TRAMO = ARG_FIN_TRAMO
FECHA_INICIO_TRAMO = ARG_INICIO_TRAMO

IF SAR_TIPO_SALARIO = "001" THEN
    IF DXDAY(ARG_INICIO_TRAMO) > 30 THEN
        FECHA_INICIO_TRAMO = FECHA_INICIO_TRAMO - 1
    ENDIF
          
    IF DXDAY(ARG_FIN_TRAMO) > 30 THEN
        DIA = "30"
        MES = DXMONTH(ARG_FIN_TRAMO)
        IF MES < 10 THEN
            MES = "0" + TOSTRING(MES,0)
        ELSE
            MES = TOSTRING(MES,0)
        ENDIF
        ANIO = TOSTRING(DXYEAR(ARG_FIN_TRAMO),0)
        STR_FECHA = ANIO + "-" + MES + "-" + DIA
        FECHA_FIN_TRAMO = TODATE(STR_FECHA)
    ENDIF
    
    IF DXMONTH(ARG_FIN_TRAMO) = 2 THEN
        IF DXDAY(ARG_FIN_TRAMO) = 28 THEN
           FECHA_FIN_TRAMO = FECHA_FIN_TRAMO + 2
        ELSEIF DXDAY(ARG_FIN_TRAMO) = 29 THEN
            FECHA_FIN_TRAMO = FECHA_FIN_TRAMO + 1
        ENDIF
    ENDIF
    
    IF (dias_paga > 30) OR (dias_paga > 27 AND DXMONTH(SCO_DT_ALLOCATION) = 2)THEN
        dias_paga = 30
    ENDIF

ENDIF

dias_tramo = (FECHA_FIN_TRAMO - FECHA_INICIO_TRAMO) + 1

IF SAR_TIPO_SALARIO = "001" or SAR_TIPO_SALARIO = "002" THEN
    IF SAR_TP_IMPUT = "4" AND (dias_paga < 15 AND DXMONTH(SCO_DT_ALLOCATION) = 2)THEN
        dias_tramo = 15
    ELSEIF SAR_TP_IMPUT = "3" or (SAR_TP_IMPUT = "4" AND DXMONTH(SCO_DT_ALLOCATION)<>2) THEN
        IF dias_tramo > 15 THEN
            dias_tramo = 15
        ENDIF
    ELSE
        IF dias_tramo > 30 THEN
            dias_tramo = 30
        ENDIF
    ENDIF
ENDIF    

IF SAR_DIAS_ANT_ALTA() > 0 OR SAR_DIAS_POST_BAJA() > 0 THEN ' esta de baja o de alta en el mes
    'Ejecuto los conceptos por si no han tomado valor
    SAR_FECHA_ALTA()
    SAR_FECHA_BAJA()
    IF SAR_TIPO_SALARIO = "001"  THEN
        dias = dias_tramo
        IF SAR_FECHA_ALTA > ARG_INICIO_TRAMO THEN
            dias = FECHA_FIN_TRAMO - SAR_FECHA_ALTA + 1
            IF dias < 0 THEN
                dias = 0
            ENDIF
        ELSEIF SAR_FECHA_BAJA < ARG_FIN_TRAMO THEN
            dias = SAR_FECHA_BAJA - ARG_INICIO_TRAMO + 1
            IF dias < 0 THEN
                dias = 0
            ENDIF
        ENDIF
    ELSEIF SAR_TIPO_SALARIO = "002" THEN    'tipo salario diario
        IF SAR_CANT_DIAS_TRABAJADOS = 0 THEN
            dias = dias_tramo
            IF SAR_FECHA_ALTA > ARG_INICIO_TRAMO THEN
                dias = ARG_FIN_TRAMO - SAR_FECHA_ALTA + 1
                IF dias < 0 THEN
                    dias = 0
                ENDIF
            ELSEIF SAR_FECHA_BAJA < ARG_FIN_TRAMO THEN
                dias = SAR_FECHA_BAJA - ARG_INICIO_TRAMO + 1
                IF dias < 0 THEN
                    dias = 0
                ENDIF
            ENDIF
        ELSE
            fechaini = max(SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC,SAR_FECHA_ALTA)
            fechafin = min(SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC,SAR_FECHA_BAJA)
            dias_paga = fechafin - fechaini + 1
            dias = ROUND((dias_tramo * SAR_CANT_DIAS_TRABAJADOS) / dias_paga,2)
        ENDIF
    ELSEIF SAR_TIPO_SALARIO = "003" THEN    'tipo salario horario
        IF SAR_CANT_HS_TRABAJADAS > 0 THEN ' si hay número de horas efectivamente trabajadas
            fechaini = max(SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC,SAR_FECHA_ALTA)
            fechafin = min(SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC,SAR_FECHA_BAJA)
            dias_paga = fechafin - fechaini + 1
            dias = ROUND((dias_tramo * SAR_CANT_HS_TRABAJADAS) / dias_paga,2)
        ELSE
            IF SCO_NUM_HOURS_THEO > 0 THEN
                inicio = ARG_INICIO_TRAMO
                fin = ARG_FIN_TRAMO
                dias = SAR_CALC_HORAS_TEORICAS (inicio,fin)
            ELSE
                dias = 0
            ENDIF
        ENDIF
    ENDIF
ELSE
    IF SAR_TIPO_SALARIO = "001"  THEN
        dias = dias_tramo
    ELSEIF SAR_TIPO_SALARIO = "002" THEN    'tipo salario diario
        IF SAR_CANT_DIAS_TRABAJADOS = 0 THEN
            dias = dias_tramo
        ELSE
            dias = ROUND((dias_tramo * SAR_CANT_DIAS_TRABAJADOS) / dias_paga,2)
        ENDIF
    ELSEIF SAR_TIPO_SALARIO = "003" THEN 'tipo salario horario
        IF SAR_CANT_HS_TRABAJADAS > 0 THEN
            dias = ROUND((dias_tramo * SAR_CANT_HS_TRABAJADAS) / dias_paga,2)
        ELSE
            IF SCO_NUM_HOURS_THEO > 0 THEN
                inicio = ARG_INICIO_TRAMO
                fin = ARG_FIN_TRAMO
                dias = SAR_CALC_HORAS_TEORICAS (inicio,fin)
            ELSE
                dias = 0
            ENDIF
        ENDIF
    ENDIF
ENDIF

'Aqui solo van los días que no se deben pagar, o los días que se pagan en un 
'concepto aparte como maternidad, accidente y art.
'Se creo el concepto 42000 el cual cuenta los días u hs. de ausencia en cada tramo
SAR_DIAS_MATERN()
SAR_LIC_ONCO_DIAS()

descuento_dias = 0
descuento_dias = descuento_dias + SAR_CALC_AUS_POR_TRAMO(ARG_INICIO_TRAMO,ARG_FIN_TRAMO,"DIA",dias) 
descuento_dias = descuento_dias + SAR_DIAS_EXCEDENCIA
descuento_dias = descuento_dias + SAR_DIAS_MATERN
descuento_dias = descuento_dias + SAR_LIC_ONCO_DIAS
descuento_dias = descuento_dias + SAR_U_DIAS_FERIADOS 'Se agregan las uniddes por Feriados, para descontarlos de las unidades trabajadas y abonar el feriado aparte del salario.
descuento_dias = descuento_dias + SAR_AUS_DIAS_DTO_ALTA 'Días que descuentan de alta que provienen de ausentismos paramétricos.


IF SAR_TIPO_SALARIO = "003" Then 'Salario horario
    IF SAR_CANT_HS_TRABAJADAS <= 0 THEN 'no tiene horas reales trabajadas informadas
        dias = dias - descuento_dias
    ENDIF
ELSE        
    dias = dias - descuento_dias
ENDIF

IF SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "1" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "3" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "4" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "99" THEN
    Return(MAX(dias,0))
ELSE
    Return(30)
ENDIF
