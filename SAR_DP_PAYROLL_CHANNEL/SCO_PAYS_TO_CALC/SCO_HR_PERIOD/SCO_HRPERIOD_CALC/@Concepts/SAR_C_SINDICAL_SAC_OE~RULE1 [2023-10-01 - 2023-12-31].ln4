'Dependencias
a = SAR_CALC_SAC_27617

If SAR_TP_IMPUT = "88" Then
    Return(0)
EndIf

indReliq = SAR_IND_PAGA_RELIQ
If indReliq = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then indReliq = 0

'En baja o reliquidacion retornamos la diferencia entre el descuento del pago y el que se ha ido descontando mes a mes
If indReliq = 1 OR SAR_ES_BAJA = 1 Or SAR_IND_AJU_SAC_OE = 1 Then
    tot_desc_sac_pago = (SAR_SAC_1_GRAV_ACM_OE + SAR_SAC_2_GRAV_ACM_OE) * SAR_PORC_C_SIND_VOL_OE / 100
    tot_desc_sac_mes = SAR_ACM_IG_ANIO_COMPLETO[0].SAR_C_SINDICAL_SAC_OE
    valor = tot_desc_sac_pago - tot_desc_sac_mes
    Return (valor)
EndIf

base = SAR_B_PLUR_SAC_MES

valor = base * SAR_PORC_C_SIND_VOL_OE / 100

Return(valor)
