'Es el componente porcentual de la cuota mensual para la ART
'Segun el decreto 290/2000 se calcula sobre una Remuneracion Imponible de 60 MOPRES

IF SAR_IND_REM9_SIN_TOPE = 1 THEN 'Calculo sin tope
    base=Max(SAR_TOT_SAC_COTIZ,0)
ELSE
    base=SAR_SAC_IMPO
ENDIF

valor=base*SAR_PORC_PAT_ART/100
IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF
RETURN(valor)
