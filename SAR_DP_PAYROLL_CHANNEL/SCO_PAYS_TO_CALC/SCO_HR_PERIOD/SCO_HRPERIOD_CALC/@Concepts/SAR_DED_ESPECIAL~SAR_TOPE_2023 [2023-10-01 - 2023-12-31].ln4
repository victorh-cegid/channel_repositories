If DxYear(SAR_FEC_IMPUT_IG) > 2023 Then Return(SAR_DED_ESPECIAL)

'Controla que no se supere el importe anual
valor = SAR_DED_ESPECIAL

importeSep = SAR_ACM_SEP23_DED_REV[0].SAR_IG_DED_ESP
importeCompleto = SAR_IMP23_DESP_COMPL

If valor + importeSep > importeCompleto Then valor = importeCompleto - importeSep

Return Round(valor,SAR_NUM_DEC)
