If SCO_NET_OUTBALANCE() = 0 Then return(1)      

SetSliceMode(M4_FALSE)
iError = SCO_ERROR
SetSliceMode(SAR_PAYS_TO_CALC.SCO_SLICE_MODE)

If SCO_AGREED_NET..SysSliceNumber > 1 and iError <> 1 then
'El neto acordado no puede tener tramos, el valor debe ser unico a lo largo de la paga
'Con el iError <> 1 controlamos que el setlog solo se muestre una vez
    Setlog(-1,1,101,66,SCO_OR_HR_PERIOD,SCO_ID_HR)
    SetSliceMode(M4_FALSE)
    SCO_ERROR = 1
    SetSliceMode(SAR_PAYS_TO_CALC.SCO_SLICE_MODE)
    return(-1)
Endif

NumMaxCalcTime= 4
InitSign = 0
InitGap= 0
EndGap= 0
NumCalCurrent= 0
NewGross= 0
InitGross= 0
EndGross= 0
TempVar= 0
FoundIt	= 0
Ret= 0

InitGap = SCO_NET_OUTBALANCE()
InitGross = SCO_AGREED_GROSS


NumCalCurrent = 1
If InitGap < 0 then 
	InitSign = -1
Else
	InitSign = 1
Endif

While NumCalCurrent <= NumMaxCalcTime And ((InitSign * SCO_NET_OUTBALANCE()) > 0)
	NewGross = SCO_AGREED_GROSS - (Power(2,NumCalCurrent) * Abs(InitGap) * InitSign)
	SCO_AGREED_GROSS = round(NewGross,0)
	SAR_HR_PERIOD.SCO_RESET_LEVEL_4()

      'ARG: Objetos que no son de grupo 4 que asignan prioridades a conceptos de grupo 4
      SAR_IND_SAC_792()
      'ARG Fin
      
	SAR_HR_PERIOD.SCO_EXE_LEVEL_4()
	NumCalCurrent = NumCalCurrent	+1
Wend

If (InitSign * SCO_NET_OUTBALANCE) < 0 Then
	EndGross = SCO_AGREED_GROSS
	EndGap = SCO_NET_OUTBALANCE
	If InitGross > EndGross Then
		TempVar = InitGross
		InitGross = EndGross
		EndGross = TempVar
		TempVar = InitGap
		InitGap = EndGap
		EndGap = TempVar
	Endif
	NumCalCurrent = 1
	FoundIt = 0
	While ((NumCalCurrent <= NumMaxCalcTime) AND (FoundIt = 0 ))
		TempVar = EndGross - (((EndGross - InitGross) * EndGap) / (EndGap-InitGap))
		SCO_AGREED_GROSS=round(Tempvar,0)
		SAR_HR_PERIOD.SCO_RESET_LEVEL_4()

            'ARG: Objetos que no son de grupo 4 que asignan prioridades a conceptos de grupo 4
            SAR_IND_SAC_792()
            'ARG Fin

		SAR_HR_PERIOD.SCO_EXE_LEVEL_4()
		If SCO_NET_OUTBALANCE <> 0 Then
			If (InitSign * SCO_NET_OUTBALANCE) > 0 Then
				InitGross = SCO_AGREED_GROSS
				InitGap = SCO_NET_OUTBALANCE
			Else
				EndGross = SCO_AGREED_GROSS
				EndGap = SCO_NET_OUTBALANCE
			Endif
			NumCalCurrent = NumCalCurrent + 1
		Else
			FoundIt = 1
		EndIf
	Wend

EndIf

If SCO_NET_OUTBALANCE() = 0 Then
	Ret = 1 
	SCO_ERROR_ADJ = 0
Else
	Ret = 0
	SCO_ERROR_ADJ = 1
Endif

Return(Ret)
