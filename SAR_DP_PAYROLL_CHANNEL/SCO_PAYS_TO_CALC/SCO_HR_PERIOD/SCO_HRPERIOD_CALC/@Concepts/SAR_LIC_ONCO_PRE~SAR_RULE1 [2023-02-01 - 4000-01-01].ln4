'Busco el primer dia de licencia por oncopediatria si posee alguna
I           = 0
fec_ini_abs = PLUS_INF
ultimoreg   = SAR_REAL_TIME_PERIOD.COUNT() - 1

WHILE I <= ultimoreg 
    SAR_REAL_TIME_PERIOD.MOVETO(I)
    motivoabs = FORMAT(SAR_REAL_TIME_PERIOD.SCO_ID_INCIDENCE, 0)
    
    IF motivoabs = "51" THEN
        fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
        I           = ultimoreg
    ENDIF
    
    I = I + 1
WEND

'Ahora calculo el promedio de los 3 meses anteriores
'Calculo la fecha de inicio de los tres meses anteriores y la inicio del mes actual

IF fec_ini_abs <> PLUS_INF THEN
    FECHA_BASE      = fec_ini_abs
    FECHA_DIA_ANT   = FECHA_BASE - 1
    MES_ACTUAL      = DXMONTH(FECHA_BASE)
    MES_ANT_3       = DxMonth(DateAdd(FECHA_BASE,-3, M4_MONTH))
    
    IF MES_ANT_3 < 10 THEN
        MES_ANT_3 = "0" + TOSTRING(MES_ANT_3,0)
    ELSE
        MES_ANT_3 = TOSTRING(MES_ANT_3,0)
    ENDIF
    
    IF MES_ACTUAL < 10 THEN
        MES_ACTUAL = "0" + TOSTRING(MES_ACTUAL,0)
    ELSE
        MES_ACTUAL = TOSTRING(MES_ACTUAL,0)
    ENDIF
    
    FECHA_ACT       = TOSTRING(DxYear(FECHA_BASE),0) + "-" + MES_ACTUAL + "-01"
    FECHA_INICIO    = ToDate(FECHA_ACT)
    FECHA_3_ANT     = TOSTRING(DxYear(DateAdd(FECHA_BASE, -3, M4_MONTH)), 0) + "-" + MES_ANT_3 + "-01"
    FECHA_ANT_3     = ToDate(FECHA_3_ANT)
    FECHA_ANT_2     = DateAdd(FECHA_ANT_3, 1, M4_MONTH)
    FECHA_ANT_1     = DateAdd(FECHA_ANT_3, 2, M4_MONTH)
    
    'Inicializo valores de cada uno de los meses anteriores
    valor_1 = 0
    valor_2 = 0
    valor_3 = 0
    max = 0
    valor = 0
    
    'Recorro el acumulado del empleado y contabilizo los valores de cada mes anterior
    SCO_AC_HR_PERIOD_READ_1.BEGIN()
    ULTIMO_REG_AC = SCO_AC_HR_PERIOD_READ_1.COUNT() - 1
    
    FOR I = 0 TO ULTIMO_REG_AC
        SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
        
        IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_1 AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= DateAdd(FECHA_INICIO,-1,M4_DAY) THEN
            valor_1 = valor_1 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_PROMEDIOS
        ELSEIF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_2 AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= DateAdd(FECHA_ANT_1,-1,M4_DAY) THEN
            valor_2 = valor_2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_PROMEDIOS
        ELSEIF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_3 AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= DateAdd(FECHA_ANT_2,-1,M4_DAY) THEN
            valor_3 = valor_3 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_PROMEDIOS
        ENDIF
    NEXT

    'Sumo todos los promedios de los tres meses anteriores a la fecha de imputacion
    valor_total = valor_1 + valor_2 + valor_3

    'Calculo el promedio total.
    'Verifico si tiene mas de 3 meses de antiguedad, sino calculo el promedio con los meses trabajados
    If(SAR_HR_PERIOD.STD_ID_HRP_START_REASON <> "005") Then
        dias_trabajados = fec_ini_abs - SAR_HR_PERIOD.STD_DT_START
    Else
        dias_trabajados = fec_ini_abs - SAR_FECHA_ALTA_PER_ANT
    EndIf  

    'Transformo el precio en dias
    IF dias_trabajados > 90 THEN
        valor = valor_total / 90
    ELSE
        If dias_trabajados <> 0 Then 
            valor = valor_total / dias_trabajados
        Else
            valor = valor_total
        EndIf
    ENDIF

    'Si el tipo de salario es horario transformo el precio diario a horario 
    IF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "003" THEN
        IF SAR_HS_DIARIAS_PROM = 0 THEN
            Setlog (-1,80,4,205,SCO_ID_HR)
            SCO_ERROR =1
        ELSE
            If SAR_HRPERIOD_CALC.SAR_HS_DIARIAS_PROM <> 0 Then valor = valor / SAR_HRPERIOD_CALC.SAR_HS_DIARIAS_PROM
        ENDIF    
    ENDIF

    IF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "001" THEN
        IF SAR_HRPERIOD_CALC.SAR_DIAS_NORM_SUELD <> 0 THEN
            SALARIO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA / SAR_HRPERIOD_CALC.SAR_DIAS_NORM_SUELD
        ELSE
            SALARIO = 0
        ENDIF
    ELSE
        SALARIO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA
    ENDIF
    
    valor = valor + SALARIO
ELSE
    valor = 0    
ENDIF

Return(valor)
