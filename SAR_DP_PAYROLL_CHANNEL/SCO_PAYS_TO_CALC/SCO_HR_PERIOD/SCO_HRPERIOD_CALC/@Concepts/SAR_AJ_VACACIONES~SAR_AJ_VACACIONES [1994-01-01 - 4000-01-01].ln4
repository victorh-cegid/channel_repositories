IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR SAR_TP_IMPUT = "77" THEN Return(0)

aux     = SAR_CARGA_AUSENTISM
aux     = SAR_IMPORTE_LICENCIAS
aux     = SAR_PRE_VACACIONES

diasvac = SAR_DIAS_VACACIONES

precioAnt  = SAR_ACM_AJU_VAC[0].SAR_PRE_VACACIONES
diasAnt = SAR_ACM_AJU_VAC[0].SAR_UN_VACACIONES
importeAnt = SAR_ACM_AJU_VAC[0].SAR_VACACIONES
unActual = SAR_UN_VACACIONES

'Si mes anterior no hay pago de vacaciones no hay nada que ajustar
If diasAnt = 0 Or precioAnt = 0 Or importeAnt = 0 Or unActual <> 0 Then Return(0)

'Si no hay vacaciones que comiencen en el mes, o no hay aumento de precio, no hay nada que ajustar
If SAR_VACACIONES.COUNT() = 0 Or precioAnt >= SAR_PRE_VACACIONES Then Return(0)

primerreg = 0
ultimoreg = SAR_VACACIONES.COUNT() - 1
    
FOR I = primerreg TO ultimoreg
    SAR_VACACIONES.MOVETO(I)
    fechafin    = SAR_VACACIONES.SCO_DT_END
    fechainicio = SAR_VACACIONES.SCO_DT_START
    IF fechafin > SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC THEN
        fechafin = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC
    ENDIF
    'diasvacmes = diasvacmes + (fechafin - fechainicio +1)
NEXT

fecha_ini_tram = GetRunningStartDate()

'Si la subida salarial es posterior al comienzo de las vacaciones, no se realiza ajuste.
If fecha_ini_tram > fechainicio Then Return (0)

'diasajustar = diasvac - diasvacmes

diasajustar = diasAnt

If diasajustar = 0 Then Return(0) 

valor = (SAR_PRE_VACACIONES - precioAnt) * diasajustar

Return(valor)
