'La primer linea calcula la base imponible para Obra Social segun la RG 953/01 de la AFIP
'La segunda linea le pasa como parametro dicho valor a un nodo que devuelve el % asociado 
'al tipo de obra social.
'La ultima realiza el calculo

base = SAR_REMUN_IMPO + SAR_BASE_COTIZ_ART + SAR_SAC_IMPO + SAR_VAC_IMPO 

baseos = SAR_OBRA_SOCIAL + SAR_ADIC_OB_SOCIAL + SAR_LEY_23660_PAT + SAR_PAT_23660_ART
basesac = SAR_OBRA_SOCIAL_SAC + SAR_OB_SOC_ADIC_SAC + SAR_SAC_23660_PAT
basevac = SAR_OB_SOC_ADIC_VAC + SAR_OBRA_SOCIAL_VAC + SAR_VAC_23660_PAT


IF SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC <= ToDate("2002-03-21") THEN
  tipo = "2"
ELSE
  tipo = SAR_ID_TIPO_OS 
ENDIF


porc = SAR_ANSSAL.SAR_RETORNA_VALOR(base,tipo,ID_CURRENCY)


valor = (baseos+basesac+ basevac)* porc / 100
RETURN(valor)
