ajuste = 0

If SAR_D612_IND = 1 Then
    tope = Percentage(SAR_D612_PORC_TOPE,SAR_D612_BASE_TOPE_MES)

    cuotSindPaga = SAR_D612_TOT_CUOTAS_SIND
    cuotSindPrev = SAR_MES_COTIZ_SIND[0].SAR_D612_TOT_CUOTAS_SIND
    cuotSindTot = cuotSindPaga + cuotSindPrev

    ajuste = tope - cuotSindTot
EndIf

'En este punto en ajuste tenemos el ajuste completo del mes, hay que considerar lo que ya llevamos ajustado en el mismo mes
ajustePrev = SAR_MES_COTIZ_SIND[0].SAR_D612_AJUSTE_SIND
ajuste = ajuste - ajustePrev

Return Round(ajuste,SAR_NUM_DEC)
