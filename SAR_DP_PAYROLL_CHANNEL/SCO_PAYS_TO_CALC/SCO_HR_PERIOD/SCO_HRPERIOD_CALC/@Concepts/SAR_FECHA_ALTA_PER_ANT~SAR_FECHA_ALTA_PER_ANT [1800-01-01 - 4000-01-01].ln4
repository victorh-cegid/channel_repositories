'Obtiene la fecha de alta de un periodo con ordinal inmediatamente anterior al actual

Ordinal_Anterior = ToString(SCO_HR_PERIOD.STD_OR_HR_PERIOD - 1, 0)

'Ahora obtenemos la fecha del alta anterior
SCO_AUX_HR_PERIOD.DESTROYBLOCK()
SCO_AUX_HR_PERIOD.SENTENCIA =  "SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @STD_DT_START = A.STD_DT_START FROM &STD_HR_PERIOD A Where(A.STD_ID_HR= '"+ SCO_HR_PERIOD.STD_ID_HR + "' And A.STD_OR_HR_PERIOD = " + Ordinal_Anterior + " )  "  
SCO_AUX_HR_PERIOD.LOAD_BLK()
If(SCO_AUX_HR_PERIOD.Count() > 0)Then
   SCO_AUX_HR_PERIOD.MoveTo(0)  
   Fecha_Alta_Anterior = SCO_AUX_HR_PERIOD.STD_DT_START 
Else   
   Fecha_Alta_Anterior = nullvalue()
EndIf

Return(Fecha_Alta_Anterior)
