IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
    tope = SAR_TOPE_COTIZ_CNT - SAR_BASE_CO_ART_CNT
ELSE
     SAR_ACM_ACT_CONTRIB.BEGIN()
    'Resto al tope lo acumulado en el mes
    tope = SAR_TOPE_COTIZ_CNT - SAR_BASE_CO_ART_CNT - SAR_ACM_ACT_CONTRIB.SAR_REMUN_IMPO_CNT
ENDIF
IF SAR_DIAS_NORM_COTIZ = 0 THEN
    base = 0
ELSE
    base = tope / SAR_DIAS_NORM_COTIZ
ENDIF

tope = base * (SAR_DIAS_NORM_COTIZ - SAR_DIAS_VACACIONES)
real = SAR_TOT_DEV_COTIZ
base = Max(real,0)
base = Min(tope,base)

RETURN(base)
