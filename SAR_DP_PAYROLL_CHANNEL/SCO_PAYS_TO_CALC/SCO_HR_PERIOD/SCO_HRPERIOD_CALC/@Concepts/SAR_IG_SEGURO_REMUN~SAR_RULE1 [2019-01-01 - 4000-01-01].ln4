'---------------------------------------------------
    '                 Seguro de vida 
    '     (Res.Gral. AFIP 1261/2002 ANEXO III d)
    '---------------------------------------------------
importeacum = SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_M_SEG_VIDA
importemes = SAR_TOT_M_SEG_VIDA
importe_oe = SAR_SEG_ANT_EMP
importe_tot = importeacum + importemes + importe_oe
segjur = SAR_JUR_SEG_PART
importe_final = 0
If (SAR_IND_PAGA_RELIQ = 1 Or SAR_IND_DIC_DED_ANU = 1) Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017")  Then importe_final = Min(importe_tot + segjur,SAR_TOPE_SEG_VIDA)  'aplico tope seguro de vida
Return(importe_final)
