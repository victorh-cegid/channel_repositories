'No debe calcularse en paga de reliquidación
'If SAR_TP_IMPUT = "77" or SAR_TP_IMPUT = "88" or SAR_TP_IMPUT = "99" Then
If SAR_TP_IMPUT = "88" or SAR_TP_IMPUT = "99" Then
   Return(0) 
EndIf   

'No debe tomar el valor en Paga Extra
If (SAR_TP_IMPUT = "2" or (SAR_TP_IMPUT = "3" and SAR_ES_BAJA = 0)) Then
    Return(0)    
EndIf 

saldo = 0
SAR_ACM_DIC_SALDO.BEGIN()
SAR_ACM_DIAS_VAC_DISFR.BEGIN()

'Consideramos que la última paga del año puede ser una paga 77, debemos recuperar el saldo de dicha paga
If SAR_ACM_DIC_SAL_ESP_VAC[0].SAR_UN_VACACIONES > 0 And SAR_ACM_DIC_SAL_ESP_VAC[0].SCO_DT_EXCHANGE > SAR_ACM_DIC_SALDO[0].SCO_DT_EXCHANGE Then
    saldoAnt = SAR_ACM_DIC_SAL_ESP_VAC[0].SAR_SALDO_VACACION
Else
    saldoAnt = SAR_ACM_DIC_SALDO[0].SAR_SALDO_VACACION
EndIf

If SAR_TIPO_SALARIO = "003" and SAR_HS_DIARIAS_PROM > 0 then
    saldo = saldoAnt + SAR_DIAS_MES_VAC - ((SAR_ACM_DIAS_VAC_DISFR.SAR_UN_VACACIONES + SAR_UN_VACACIONES)/SAR_HS_DIARIAS_PROM) 
Elseif SAR_TIPO_SALARIO <> "003" or (SAR_TIPO_SALARIO = "003" and SCO_NUM_HOURS_THEO > 0) then
    saldo = saldoAnt + SAR_DIAS_MES_VAC - SAR_ACM_DIAS_VAC_DISFR.SAR_UN_VACACIONES - SAR_UN_VACACIONES     
Endif

RETURN(saldo)
