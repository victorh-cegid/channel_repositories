'Si arrastraba una base negativa - por ajuste a 0 por negativo - no aplica beneficio
If SCO_DT_PAYMENT <> SCO_DT_ALLOCATION Then
    If SCO_AC_HR_PERIOD_REV_1.SAR_AGO23_BASE_IMP <= 0 Then Return(0)
Endif

If SAR_TP_IMPUT = "88" Then return(0)
If (SCO_DT_PAYMENT = SCO_DT_ALLOCATION And SAR_SEP23_IND_AJ_NORM = 0) Or DxMonth(SCO_DT_ALLOCATION) <> 9 Or SAR_SEPT23_DIF_SAC = 0 Then Return(0)

If SAR_SEP23_IND_AJ_NORM = 0 Then
    impuesto_orig = SCO_AC_HR_PERIOD_REV_1.SAR_IMPUESTO
    impuesto_nuevo = SAR_AGO23_IMPUESTO
    beneficio = Max(impuesto_orig-impuesto_nuevo,0)
Else
    impuesto_orig = SAR_AGO23_IMPUESTO
    impuesto_nuevo = SAR_IMPUESTO
    beneficio = Max(impuesto_orig-impuesto_nuevo,0)
EndIf

Return Round(beneficio,SAR_NUM_DEC)
