'La primer línea calcula la base imponible para Obra Social según la RG 953/01 de la AFIP
'La segunda línea le pasa como parámetro dicho valor a un nodo que devuelve el % asociado 
'al tipo de obra social.
'La última realiza el cálculo

'base = #5817 + #5809 + #5827 + #5837 

'baseos = #6033 + #6032 + #6110 + #6117 + #6160
baseos =  #SAR_LEY_23660_PAT + #SAR_PAT_23660_ART + #SAR_ANSSAL_PAT
'basesac = #6034 + #6036 + #6115 + #6165
basesac = #SAR_SAC_23660_PAT + #SAR_ANSSAL_PAT_SAC
'basevac = #6037 + #6035 + #6116 + #6166
basevac = #SAR_VAC_23660_PAT + #SAR_ANSSAL_PAT_VAC


'IF SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC <= ToDate("2002-03-21") THEN
'  tipo = "2"
'ELSE
'  tipo = #220 
'ENDIF

'porc = SAR_ANSSAL.SAR_RETORNA_VALOR(base,tipo,ID_CURRENCY)
porc = #SAR_PORC_ANSSAL

valor = (baseos+basesac+ basevac)* porc / 100

RETURN(valor)
