IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR (SAR_TP_IMPUT = "3"  AND SAR_ES_BAJA = 0) THEN
    Return(0)
ENDIF

IF (SAR_ES_BAJA = 0) and (SAR_FECHA_BAJA < SCO_DT_ALLOCATION)  and (SAR_IMPUESTO_TOTAL = 0)Then    'condicion para Nomina despues de la baja
    RETURN(0)
ENDIF

'Inicializo variables 
v1 = SAR_IMPUESTO_TOTAL
v2 = 0
v3 = SAR_IMP_ANT_EMP
v4 = 0
v5 = 0

base=0
Tope=0
ig_total = 0
SAR_SALD_RET_G_ANT = 0

'Recorro acumulado de lectura para armar las TI de IG
SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()- 1

FOR I = 0 TO ULTIMO_REG 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
    ' Armo los datos para SAR_ACM_IMPUESTO
    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
        v2 = v2 + SCO_AC_HR_PERIOD_READ_1.SAR_ACM_IMPUESTO       
    ENDIF

   ' Armo los datos para SAR_REV_ACM_IMPUESTO2
    IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <> SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SAR_FEC_PAGO_IG = SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
        v5 = v5 + SCO_AC_HR_PERIOD_READ_1.SAR_IMPUESTO
    ENDIF

    'Armo los datos para REV_ACM_IMPUESTO
    IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_DT_ALLOCATION AND SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG < SAR_FEC_PAGO_IG THEN 
        v4 = v4 + SCO_AC_HR_PERIOD_READ_1.SAR_IMPUESTO
    ENDIF
NEXT

'-----------------------------------------------------------------------
IF ISNULL(v1) = TRUE THEN
    v1 = 0 
ENDIF
IF ISNULL(v2) = TRUE THEN
    v2 = 0 
ENDIF
IF ISNULL(v3) = TRUE THEN
    v3 = 0 
ENDIF
IF ISNULL(v4) = TRUE THEN
    v4 = 0 
ENDIF
IF ISNULL(v5) = TRUE THEN
    v5 = 0 
ENDIF

valor = v1 - (v2 + v3) + v4 - v5 - SAR_IMP_DEB_BAN

'---------------------------------------------------------------------------------------------

'---------------------------------------------------------------------------------------------
'Modificacion RG 2866/10
IF SCO_DT_ALLOCATION <> SCO_DT_PAYMENT THEN 
        IF SAR_ES_BAJA = 0 THEN
            IF SCO_DT_PAYMENT > Todate("2010-01-01") and SCO_DT_PAYMENT <= Todate("2010-12-31") then
                IF (VALOR - SCO_AC_HR_PERIOD_REV_1.SAR_IMPUESTO) < 0 Then
                    SAR_DEV_RET08_ST = valor
                    valor1 = Round(SCO_AC_HR_PERIOD_REV_1.SAR_IMPUESTO,2)
                    RETURN(valor1)
                ENDIF
            ENDIF
               valor2 = Round(SCO_AC_HR_PERIOD_REV_1.SAR_IMPUESTO,2)
               RETURN(valor2) 
        ENDIF
ENDIF
'----------------------------------------------------------------------------------------------


'Modificacion de acuerdo a RG 2437/08
base=SAR_TOTAL_DEVENGOS-SAR_TI_REM_26341_ST-SAR_AJUSTE_SAL_FAM-SAR_ASIGNAC_HIJOS-SAR_ASIG_HIJOS_INC-SAR_ASIG_PRENATAL-SAR_AYUDA_ESC_PRIM-SAR_AY_ESC_PRIM_INC-SAR_AS_REM_26341_ST

IF SAR_TP_IMPUT = "4" Then
    SAR_ACM_PAG_QUIN_1RA.begin()
    if SAR_ACM_PAG_QUIN_1RA.count() <> 0 Then
        base_1a_quincena = SAR_ACM_PAG_QUIN_1RA.SAR_TOTAL_DEVENGOS - SAR_ACM_PAG_QUIN_1RA.SAR_TI_REM_26341_ST - SAR_ACM_PAG_QUIN_1RA.SAR_AJUSTE_SAL_FAM
        base_1a_quincena = base_1a_quincena - SAR_ACM_PAG_QUIN_1RA.SAR_ASIGNAC_HIJOS - SAR_ACM_PAG_QUIN_1RA.SAR_ASIG_HIJOS_INC - SAR_ACM_PAG_QUIN_1RA.SAR_ASIG_PRENATAL
        base_1a_quincena = base_1a_quincena - SAR_ACM_PAG_QUIN_1RA.SAR_AYUDA_ESC_PRIM - SAR_ACM_PAG_QUIN_1RA.SAR_AY_ESC_PRIM_INC - SAR_ACM_PAG_QUIN_1RA.SAR_AS_REM_26341_ST
    else
        base_1a_quincena = 0
    endif
    base = base +  base_1a_quincena
Endif

Tope=base*SAR_PP_RET_GAN_ST/100

'Si es baja y su retencion excede el tope permitido generamos la diferencia
'Se agrega el Ind. Tope 35% segun RG 2507/2008
if SAR_ES_BAJA = 1 Then
  If SAR_IND_APLIC_TOPE_35 = 1 Then  
    if valor > tope then
       SAR_SALD_RET_GAN_ST = valor - tope
       return(tope)
    else
      return(valor)
    endif
  Else
    return(valor)
  EndIf  
endif
' Fin baja

'Si ha tenido diferencias del periodo fiscal anterior, incluimos en el tope
'Se agrega el Ind. Tope 35% segun RG 2507/2008

If SAR_IG_ANIO_ANT > 0 Then
    ig_total =  valor + SAR_IG_ANIO_ANT        ' ganancia total sumada la ganancia del mes + el resultado de la Reliq.

    If SAR_IND_APLIC_TOPE_35 = 1 Then
    
        If ig_total > tope Then      ' si la ganancia total a descontar es mayor al tope descontamos hasta el tope
        
            If SAR_IG_ANIO_ANT > tope Then
            
                SAR_SALD_RET_G_ANT = SAR_IG_ANIO_ANT - tope
                SAR_IG_ANIO_ANT= tope
 
                SAR_SALD_RET_GAN_ST = valor
                valor = 0
                Return(valor)
 
            Else
                SAR_SALD_RET_GAN_ST = ig_total - tope
                valor = tope - SAR_IG_ANIO_ANT
                Return(valor)
            Endif

         Endif
         IF ig_total <= tope then   ' si la ganancia total es menor al tope descontamos todo
              RETURN(valor)
         Endif
    Else
        RETURN(valor)           
    EndIf     
Endif                              
'Fin incluye reliquidacion final IG


if valor<=tope then
     return(valor)
else
     SAR_SALD_RET_GAN_ST = valor - tope 
     return(tope)
endif

RETURN(valor)
