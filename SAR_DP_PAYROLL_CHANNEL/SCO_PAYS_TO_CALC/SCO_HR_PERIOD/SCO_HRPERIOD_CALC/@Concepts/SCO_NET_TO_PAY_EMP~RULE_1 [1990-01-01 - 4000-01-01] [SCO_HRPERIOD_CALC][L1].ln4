nmNet=0

If SCO_PAYS_TO_CALC.SCO_REVISION=1 Then

	nmNet=SCO_DIF_HRPERIOD_CALC.SCO_NET..SysTotalSlices(TOTAL_SUM)
	If nmNet<0 Then
		SetLog(1,1,101,23,nmNet,SCO_ID_HR, SCO_OR_HR_PERIOD)
	EndIf

	Return(nmNet)
Else

	nmPaymentData= SCO_PAYROLL_PAYMENT_DATA.Count()

	If nmPaymentData>0 Then
		nmTotValue=0
		nmValue=0
		I=0
		SCO_PAYROLL_PAYMENT_DATA.Begin()
		While I< nmPaymentData and nmValue>=0
			SCO_PAYROLL_PAYMENT_DATA.MoveTo(I)
			If SCO_PAYROLL_PAYMENT_DATA.SCO_EMP_CHECK="0" AND SCO_PAYROLL_PAYMENT_DATA.SCO_DT_START <= SCO_PAYROLL_PAYMENT_DATA.SCO_DT_FILTER_PAYM_DATA AND SCO_PAYROLL_PAYMENT_DATA.SCO_DT_END >= SCO_PAYROLL_PAYMENT_DATA.SCO_DT_FILTER_PAYM_DATA Then
                  //Si el dato pago esta fuera de fechas, se anula su orden de pago
  
                        
				SCO_PAYROLL_PAYMENT_DATA.SCO_VALUE()
				nmValue=SCO_PAYROLL_PAYMENT_DATA.SCO_VALUE
				If nmValue>0 Then
	           	        nmTotValue=nmTotValue+nmValue
				EndIf
			EndIf
			I=I+1
		Wend
		If nmValue>=0 Then
                  'if there is something to pay to the beneficiaries other than the main one
			vnet=SCO_NET..SysTotalSlices(TOTAL_SUM)
                  
			nmNet=vnet-nmTotValue
                 
			If nmNet>=0 Then
				Return(nmNet)
                     
			Else
				Setlog(1,1,101,22,SCO_PAYROLL_PAYMENT_DATA.SCO_ID_HR,SCO_PAYROLL_PAYMENT_DATA.SCO_OR_HR_PERIOD,nmNet)
				Return(nmNet)
                 
			EndIf
		Else
                'nothing to pay to the beneficiaries other than the main one
			nmNet=-1
                  
			SetLog(1,1,101,25,SCO_PAYROLL_PAYMENT_DATA.SCO_ID_HR,SCO_PAYROLL_PAYMENT_DATA.SCO_OR_HR_PERIOD,nmValue)
			Return(nmNet)
		EndIf
	ELSE
            'there are no payment datas
        
		SetLog(-1,1,101,26,SCO_ID_HR, SCO_OR_HR_PERIOD)
            SCO_ERROR = 1
            RETURN(-1)
	EndIf
 
EndIf
