IF SCO_DT_PAYMENT <> SCO_DT_ALLOCATION AND SAR_FEC_PAGO_IG >= ToDate("2016-03-01") Then  Return(SCO_ID_LEG_ENT)

'--- Seteamos el valor de la sociedad segun el rango del empleado

// Cambio Legal Ganancias 2015 - Res.3770
If  SAR_RANGO_REM_IG_2015 = 1 or SAR_RANGO_REM_IG_2015 = 0 Then  Return(SCO_ID_LEG_ENT)

If  SAR_RANGO_REM_IG_2015 = 2 Then  Return("99")
If  SAR_RANGO_REM_IG_2015 = 3 Then  Return("98")

If  SAR_RANGO_REM_IG_2015 = 20 Then  Return("20")
If  SAR_RANGO_REM_IG_2015 = 21 Then  Return("21")
If  SAR_RANGO_REM_IG_2015 = 22 Then  Return("22")
If  SAR_RANGO_REM_IG_2015 = 23 Then  Return("23")
If  SAR_RANGO_REM_IG_2015 = 24 Then  Return("24")
If  SAR_RANGO_REM_IG_2015 = 25 Then  Return("25")

If  SAR_RANGO_REM_IG_2015 = 30 Then  Return("30")
If  SAR_RANGO_REM_IG_2015 = 31 Then  Return("31")
If  SAR_RANGO_REM_IG_2015 = 32 Then  Return("32")
If  SAR_RANGO_REM_IG_2015 = 33 Then  Return("33")
If  SAR_RANGO_REM_IG_2015 = 34 Then  Return("34")
If  SAR_RANGO_REM_IG_2015 = 35 Then  Return("35")
