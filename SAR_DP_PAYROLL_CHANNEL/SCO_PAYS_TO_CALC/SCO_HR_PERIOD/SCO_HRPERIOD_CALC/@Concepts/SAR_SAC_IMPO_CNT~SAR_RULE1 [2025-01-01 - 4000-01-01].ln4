'De acuerdo al articulo 3? el decreto 491/04 desde el 01/10/05 no hay topes para 
'el calculo de la base imponible de las contribuciones.

base = SAR_TOT_SAC_COTIZ

'Ley 27430
reduc_impo = 0
If SAR_DIAS_NORM_SUELD > 0 Then
    reduc_impo = SAR_REDUC_IMPO_SAC
    unid_base = SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2 + SAR_U_EGRESO_PAGA_1 + SAR_U_EGRESO_PAGA_2
    reduc_impo = reduc_impo * unid_base
EndIf
base = base - reduc_impo
base = max(base,0)
'Fin Ley 27430

'Se determina que en caso de retroactividad con el indicador SAR_LSD_IND_PAGO = 1 no se va a calcular detraccion, este concepto va a devolver el importe de la diferencia de su base, sin calcular detraccion por esa parte.
If SCO_DT_PAYMENT<>SCO_DT_ALLOCATION And SAR_LSD_IND_PAGO = 1 Then
    devengosNorm = SAR_TOT_SAC_COTIZ
    devengosOrigNorm = SCO_AC_HR_PERIOD_REV_1.SAR_TOT_SAC_COTIZ
    devengosNormDif = devengosNorm - devengosOrigNorm
    RemImpoOrig = SCO_AC_HR_PERIOD_REV_1.SAR_SAC_IMPO_CNT
    base = RemImpoOrig + devengosNormDif
EndIf

Return(base)
