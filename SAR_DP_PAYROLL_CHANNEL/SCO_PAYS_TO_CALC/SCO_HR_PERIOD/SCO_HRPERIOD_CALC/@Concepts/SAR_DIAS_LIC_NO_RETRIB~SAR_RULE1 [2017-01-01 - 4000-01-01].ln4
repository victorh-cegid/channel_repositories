'Inicializamos las variables
dias_lic_no_retrib = 0                                  'Contador de dias de Licencias no Retribuidas
fec_ini_paga  = SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC     'Fecha de inicio de la paga procesada
fec_fin_paga  = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC       'Fecha de fin de la paga procesada

'Recorro el nodo de incidencias para el mes procesado para determinar si la incidencia corresponde con una Licencia clasificada como retribuida o no.
For i = 0 To SAR_REAL_TIME_PERIOD.Count()- 1
    SAR_REAL_TIME_PERIOD.MoveTo(i)
    
    If SAR_REAL_TIME_PERIOD.SCO_CK_PAID = "0" Then 
        dias_lic_no_retrib = dias_lic_no_retrib + CommonTime(fec_ini_paga,fec_fin_paga,SAR_REAL_TIME_PERIOD.SCO_DT_START,SAR_REAL_TIME_PERIOD.SCO_DT_END)    
    EndIf
Next

Return(dias_lic_no_retrib)
