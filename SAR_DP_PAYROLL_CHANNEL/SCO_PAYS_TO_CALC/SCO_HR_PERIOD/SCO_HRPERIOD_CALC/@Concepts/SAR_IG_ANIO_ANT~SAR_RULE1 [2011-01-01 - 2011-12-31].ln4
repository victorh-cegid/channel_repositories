IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR (SAR_TP_IMPUT = "3"  AND SAR_ES_BAJA = 0) THEN
    Return(0)
ENDIF

SAR_ACM_IG_ANIO_ACT.BEGIN()
IF SAR_ACM_IG_ANIO_ACT.COUNT() > 0 THEN
    IF ISNULL(SAR_ACM_IG_ANIO_ACT.SAR_IG_ANIO_ANT)= FALSE THEN
        valor_act = SAR_ACM_IG_ANIO_ACT.SAR_IG_ANIO_ANT
    ELSE
        valor_act = 0
    ENDIF
ELSE
    valor_act = 0
ENDIF


IF  valor_act <> 0 THEN
    RETURN(0)
ENDIF

'Solo vamos a buscar la reliquidacion para la paga anual
'si estoy en una paga normal. No queremos que se calcule en retro
If SCO_DT_ALLOCATION = SCO_DT_PAYMENT Then
    SAR_ACM_IG_ANIO_ANT.BEGIN()
    IF SAR_ACM_IG_ANIO_ANT.COUNT() > 0 THEN
        IF ISNULL(SAR_ACM_IG_ANIO_ANT.SAR_IG_FINAL) = FALSE THEN
            valor = SAR_ACM_IG_ANIO_ANT.SAR_IG_FINAL
        ELSE
            valor = 0
        ENDIF
         

'--- En caso de ser la diferencia positiva (a favor de la AFIP) retorna 0(cero) y
'se acumula en el concepto v5301, para ser aplicado en la reliquidacion del a?o 2011.

        IF valor > 0 and SAR_ES_BAJA = 0 THEN
            valor = 0
        ENDIF
'----------------------------------------------------------------------------------------
       
    ELSE
        valor = 0
    ENDIF
Else
    valor = 0
Endif


Return(valor)
