IF SAR_TP_IMPUT = "88" or SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

edad = SAR_EDAD
base = SAR_REMUN_IMPO + SAR_BASE_COTIZ_ART
valor = 0
IF edad >= 18 THEN
    porc = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
    valor = base * porc / 100
ENDIF
IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF
Return(valor)
