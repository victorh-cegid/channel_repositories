/* No debe tomar valor en paga de reliq del impuesto */
If (SAR_TP_IMPUT = "99") Then Return(0)


SAR_SAC_PRORR_ANT.Begin()
If DxMonth(SAR_SAC_PRORR_ANT.SAR_FEC_PAGO_IG) = DxMonth(SAR_SAC_PRORR_ANT.SAR_FECHA_BASE) Then 
    If (SAR_TP_IMPUT = "2") Then
        Return(0)
    EndIf
Else
    If (SAR_TP_IMPUT = "1") Then
        Return(0)
    EndIf
Endif 


'Inicialización de las variables para acumulado de conceptos calculados de SAC:
VAR_SAR_PAGA_EXTRA_2     = 0
VAR_SAR_PAGA_EXTRA_AJ_2  = 0
VAR_SAR_JUBILACION_SAC   = 0
VAR_SAR_LEY_19032_SAC    = 0
VAR_SAR_OBRA_SOCIAL_SAC  = 0
VAR_SAR_ADIC_OB_SOCIAL   = 0
VAR_SAR_C_SINDIC_OBL_SAC = 0
VAR_SAR_C_SINDICAL_SAC   = 0
vNo_Retener              = 0
vValor                   = 0
SAC_NETO                 = 0
SAC_Neto_acum            = 0
SAC_Neto_actual          = 0


SAR_ACM_6_MES_SAC_CON_PAGA_EXT.Begin()
SAR_AJUSTE_PARA_SAC.Begin()
VAR_SAR_PAGA_EXTRA_2     = VAR_SAR_PAGA_EXTRA_2     + SAR_AJUSTE_PARA_SAC.SAR_PAGA_EXTRA_2..sysTotalSlices(M4_TOTAL_SUM) 
VAR_SAR_PAGA_EXTRA_AJ_2  = VAR_SAR_PAGA_EXTRA_AJ_2  + SAR_AJUSTE_PARA_SAC.SAR_PAGA_EXTRA_AJ_2..sysTotalSlices(M4_TOTAL_SUM) 
VAR_SAR_JUBILACION_SAC   = VAR_SAR_JUBILACION_SAC   + SAR_AJUSTE_PARA_SAC.SAR_JUBILACION_SAC..sysTotalSlices(M4_TOTAL_SUM)
VAR_SAR_LEY_19032_SAC    = VAR_SAR_LEY_19032_SAC    + SAR_AJUSTE_PARA_SAC.SAR_LEY_19032_SAC..sysTotalSlices(M4_TOTAL_SUM)
VAR_SAR_OBRA_SOCIAL_SAC  = VAR_SAR_OBRA_SOCIAL_SAC  + SAR_AJUSTE_PARA_SAC.SAR_OBRA_SOCIAL_SAC..sysTotalSlices(M4_TOTAL_SUM)
VAR_SAR_ADIC_OB_SOCIAL   = VAR_SAR_ADIC_OB_SOCIAL   + SAR_AJUSTE_PARA_SAC.SAR_ADIC_OB_SOCIAL..sysTotalSlices(M4_TOTAL_SUM)
VAR_SAR_C_SINDIC_OBL_SAC = VAR_SAR_C_SINDIC_OBL_SAC + SAR_AJUSTE_PARA_SAC.SAR_C_SINDIC_OBL_SAC..sysTotalSlices(M4_TOTAL_SUM)         
VAR_SAR_C_SINDICAL_SAC   = VAR_SAR_C_SINDICAL_SAC   + SAR_AJUSTE_PARA_SAC.SAR_C_SINDICAL_SAC..sysTotalSlices(M4_TOTAL_SUM)

vValor = vValor + SAR_AJUSTE_PARA_SAC.SAR_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM)
'vValor = vValor + SAR_AJUSTE_PARA_SAC.SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM)
vValor = vValor + SAR_AJUSTE_PARA_SAC.SAR_SAC_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM)

'Mejor total para SAC:
max_tot_p_sac = SAR_ACM_6_MES_SAC_CON_PAGA_EXT.SAR_TOTAL_P_SAC
If(max_tot_p_sac < SAR_TOTAL_P_SAC)Then
     max_tot_p_sac = SAR_TOTAL_P_SAC
EndIf
          
If max_tot_p_sac > 30000 Then
    vNo_Retener = 1
EndIf
            
'No se tendra en cuenta los sueldos superiores a $30.000
If (vNo_Retener = 0) Then
    vValor = SAR_SAC_NETO
    vValor = vValor + SAR_BRUTO_OE
    vValor = vValor + SAR_TOTAL_P_SAC
    vValor = vValor + SAR_SAC_BRUTO_OE
                
    If vValor > 30000 Then
        vNo_Retener = 1
    EndIf
EndIf
    
    
SAC_Neto_acum   = (VAR_SAR_PAGA_EXTRA_2 + VAR_SAR_PAGA_EXTRA_AJ_2) - (VAR_SAR_JUBILACION_SAC + VAR_SAR_LEY_19032_SAC + VAR_SAR_OBRA_SOCIAL_SAC + VAR_SAR_ADIC_OB_SOCIAL + VAR_SAR_C_SINDIC_OBL_SAC + VAR_SAR_C_SINDICAL_SAC )
SAC_Neto_actual = (SAR_PAGA_EXTRA_2 + SAR_EGRESO_PAGA_2 + SAR_PAGA_EXTRA_AJ_2) - (SAR_JUBILACION_SAC + SAR_LEY_19032_SAC + SAR_OBRA_SOCIAL_SAC + SAR_C_SINDICAL_SAC + SAR_OB_SOC_ADIC_SAC)

SAC_NETO = SAC_Neto_acum + SAC_Neto_actual
SAC_NETO = SAC_NETO + SAR_SAC_NETO_OE 'Sumamos el SAC Neto correspondiente a otros empleadores


'No se debe abonar si sueldo superior a 30.000 o si es negativo
If (vNo_Retener = 1) OR (SAC_NETO < 0) Then
    SAC_NETO = 0
EndIf
    

RETURN(SAC_NETO)
