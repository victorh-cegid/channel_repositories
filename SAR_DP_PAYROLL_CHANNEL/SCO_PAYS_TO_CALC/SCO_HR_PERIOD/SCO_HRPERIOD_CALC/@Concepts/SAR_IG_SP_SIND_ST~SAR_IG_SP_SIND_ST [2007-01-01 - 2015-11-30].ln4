'Por modificacion del empleado se agrego: SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017"
IF (SAR_MES_PAGO_IG=12 OR (SAR_ES_BAJA=1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017")) THEN RETURN(0)

dif = 0
aux = SAR_C_SINDICAL_SAC + SAR_C_SINDIC_OBL_SAC + SAR_IG_SIND_NH_ST

IF SAR_PAYS_TO_CALC.SCO_DT_ALLOCATION <> SAR_PAYS_TO_CALC.SCO_DT_PAYMENT THEN
   SAR_PAGA_ACTUAL_IMPUT.begin()
   IF SAR_PAGA_ACTUAL_IMPUT.count() <> 0 THEN
        dif = aux - (SAR_PAGA_ACTUAL_IMPUT.SAR_C_SINDICAL_SAC + SAR_PAGA_ACTUAL_IMPUT.SAR_C_SINDIC_OBL_SAC) - SAR_PAGA_ACTUAL_IMPUT.SAR_IG_SIND_NH_ST
   ELSE
        dif = aux
   ENDIF 

   IF dif > 0 THEN
      aux = SAR_PAGA_ACTUAL_IMPUT.SAR_C_SINDICAL_SAC + SAR_PAGA_ACTUAL_IMPUT.SAR_C_SINDIC_OBL_SAC + SAR_PAGA_ACTUAL_IMPUT.SAR_IG_SIND_NH_ST
   ENDIF

   SAR_ACM_ULT_MES.BEGIN()
   IF SAR_ACM_ULT_MES.COUNT() <> 0 THEN
        valor = aux - SAR_IG_CP_SIND_ST + SAR_ACM_ULT_MES.SAR_IG_SP_SIND_ST
   ELSE
        valor = aux - SAR_IG_CP_SIND_ST
   ENDIF
ELSE
    SAR_ACM_ULT_PAGO_IMPUT.BEGIN()
    IF SAR_ACM_ULT_PAGO_IMPUT.COUNT() <> 0 THEN
        valor = aux - SAR_IG_CP_SIND_ST + SAR_ACM_ULT_PAGO_IMPUT.SAR_IG_SP_SIND_ST+SAR_ACM_ULT_PAGO_IMPUT.SAR_IG_PR_AD_SI_ST
    ELSE
        valor = aux - SAR_IG_CP_SIND_ST
    ENDIF
ENDIF

IF ISNULL(valor)= TRUE THEN valor = 0
RETURN(valor)
