'Este concepto calcula el importe y precio de las licencias diarias y horarias
'
'Obtengo la fecha de inicio y fin de cada tramo

aux = SAR_CARGA_AUSENTISM
INICIO_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA..SysStartDate
FIN_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA..SysEndDate
'aux = SAR_MIN_PL_NOCTUR
fec_ini_paga = INICIO_TRAMO
fec_fin_paga = FIN_TRAMO

'
'Precios relacionados con las licencias
'
PRECIO_DIAS_ENF = 0
PRECIO_DIAS_MAT = 0
PRECIO_DIAS_LCONV = 0
PRECIO_DIAS_LSGS = 0
PRECIO_DIAS_HUELGA = 0
PRECIO_DIAS_VAC = 0
PRECIO_DIAS_LCAS = 0
PRECIO_DIAS_LNAC = 0
PRECIO_DIAS_LDEF = 0
PRECIO_DIAS_LEX = 0
PRECIO_DIAS_DSAN = 0
PRECIO_HS_AUSENCIA = 0
PRECIO_HS_50 = 0
PRECIO_HS_100 = 0
PRECIO_HS_150 = 0

PRECIO_DIAS_EXCED = 0
PRECIO_DIAS_SUS_DISCI = 0
PRECIO_DIAS_AUS_INJUST = 0

PRECIO_DIAS_RE_ACC = 0
PRECIO_DIAS_RE_ENF = 0
PRECIO_DIAS_RE_SIN = 0

PRECIO_PL_NOC_50 = 0
PRECIO_PL_NOC_100 = 0
PRECIO_FER_TRAB = 0

'
'Verificamos si el empleado posee ausentismos a nivel de Periodo y a nivel de Role
'Si posee a nivel de Rol, contamos las Hs de Ausencia y Extras
'
PRECIO = 0
UNIDAD = 0
REG_AUSENTISMOS = SAR_REAL_TIME_PERIOD.COUNT()
REG_HS_AUSENCIA = 0
SAR_HR_ROLE.BEGIN()
WHILE SAR_HR_ROLE.ISEOF() = FALSE
    IF SAR_REAL_TIME_PER_ROLE.COUNT() > 0 THEN
        REG_HS_AUSENCIA = REG_HS_AUSENCIA + 1
        SAR_REAL_TIME_PER_ROLE.BEGIN()
        WHILE SAR_REAL_TIME_PER_ROLE.ISEOF() = FALSE
            motivoabs = FORMAT(SAR_REAL_TIME_PER_ROLE.SCO_ID_INC_GROUP,0)
            fec_ini_abs = SAR_REAL_TIME_PER_ROLE.SCO_DT_START
            fec_fin_abs = SAR_REAL_TIME_PER_ROLE.SCO_DT_END
            'Si la fecha de inicio del ausentismo está comprendida entre el inicio y 
            'el fin del tramo calculo el precio a la fecha de fin de la incidencia
            IF (INICIO_TRAMO <= fec_ini_abs AND fec_ini_abs <= FIN_TRAMO) THEN
                IF fec_fin_abs > fec_fin_paga THEN
                    fec_fin_abs = fec_fin_paga
                ENDIF
                fec_abs = fec_fin_abs
                '
                'Para contar las Hs de ausencia consideramos el tipo de incidencia SCO_ID_INC_GROUP
                '
                '
                'Calculo el importe para el día de fin de la incidencia
                '
                IF motivoabs = "2" THEN
                    PRECIO_HS_AUSENCIA = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_abs,"#4463")
                ENDIF
                '
                'Para contar las Hs Extras consideramos el ID de incidencia SCO_ID_INCIDENCE
                '
                '
                'Calculo el importe para el día de fin de la incidencia
                '
                idabs = FORMAT(SAR_REAL_TIME_PER_ROLE.SCO_ID_INCIDENCE,0)

                IF idabs = "33" THEN
                    PRECIO_HS_50 = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_abs,"#4433") * 1.5
                ELSEIF idabs = "34" THEN
                    PRECIO_HS_100 = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_abs,"#4423") * 2
                ELSEIF idabs = "35" THEN
                    PRECIO_HS_150 = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_abs,"#4437") * 2.5
                ELSEIF idabs = "44" THEN
                    PRECIO_PL_NOC_50 = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_abs,"#4257") * 1.5
                ELSEIF idabs = "45" THEN
                    PRECIO_PL_NOC_100 = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_abs,"#4263") * 2
                ELSEIF idabs = "54" THEN
                    PRECIO_FER_TRAB = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_abs,"#4473") * 2
                ENDIF
              ENDIF
            SAR_REAL_TIME_PER_ROLE.GONEXT()
        WEND
    ENDIF
SAR_HR_ROLE.GONEXT()
WEND
IF REG_AUSENTISMOS = 0 THEN
    IF REG_HS_AUSENCIA = 0 THEN
        Return(0)
    ENDIF
ENDIF

'
'Ahora contabilizamos las ausencias diarias que se cargan a nivel de period
'
primerreg = 0
ultimoreg = SAR_REAL_TIME_PERIOD.COUNT() - 1
fec_ini_paga = SAR_REAL_TIME_PERIOD.SAR_DT_ALLOC_START
fec_fin_paga = SAR_REAL_TIME_PERIOD.SAR_DT_ALLOC_END
FOR  I = primerreg  TO  ultimoreg 
        SAR_REAL_TIME_PERIOD.MOVETO(I)
        motivoabs = FORMAT(SAR_REAL_TIME_PERIOD.SCO_ID_INCIDENCE,0)
        fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
        fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END

        'Si la fecha de inicio del ausentismo está comprendida en el tramo o
        'la fecha de fin del ausentismo está comprendida en el tramo obtenemos
        'los precios de las licencias 

        IF (INICIO_TRAMO <= fec_ini_abs AND fec_ini_abs <= FIN_TRAMO) OR (INICIO_TRAMO <= fec_fin_abs AND fec_ini_abs <= FIN_TRAMO) THEN
            
            'Si la fecha de inicio del ausentismo es menor a la fecha de inicio del tramo la reemplazamos
            IF fec_ini_abs < INICIO_TRAMO THEN
                fec_ini_abs = INICIO_TRAMO
            ENDIF    
           
            IF motivoabs = "1" THEN
                '
                'Calculo el precio de la enfermedad para esos días
                '
                PRECIO_DIAS_ENF = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4110")
           
            ELSEIF motivoabs = "2" THEN
                '
                'Calculo el precio de la suspensión disciplinaria para esos días
                '
                PRECIO_DIAS_SUS_DISCI = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4180")
  
            ELSEIF motivoabs = "3" THEN
                '
                'Calculo el precio de la maternidad para esos días
                '
                PRECIO_DIAS_MAT = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"NONE")
                   
            ELSEIF motivoabs = "4" THEN
                '
                'Calculo el precio para esos días
                '
                PRECIO_DIAS_LCONV = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4060")
            
            ELSEIF motivoabs = "6" THEN
                '
                'Calculo el precio de la excedencia para esos días
                '
                PRECIO_DIAS_EXCED = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4160")
        
            ELSEIF motivoabs = "7" THEN
                '
                'Calculo el precio de la ausencia injustificada para esos días
                '
                PRECIO_DIAS_AUS_INJUST = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4170")
            ELSEIF motivoabs = "8" THEN
                '
                'Calculo el precio de los dias de huelga para esos días
                '
                PRECIO_DIAS_HUELGA = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"NONE")
           
            ELSEIF motivoabs = "9" THEN
    
                'Si la fecha de inicio de las vacaciones está comprendida en el tramo o
                'la fecha de fin de las vacaciones está comprendida en el tramo obtenemos
                'el precio de las vacaciones 

                IF (INICIO_TRAMO <= fec_ini_abs AND fec_ini_abs <= FIN_TRAMO) OR (INICIO_TRAMO <= fec_fin_abs AND fec_ini_abs <= FIN_TRAMO) THEN
                    'Si la fecha de inicio del ausentismo es menor a la fecha de inicio del tramo la reemplazamos
                    IF fec_ini_abs < INICIO_TRAMO THEN
                        fec_ini_abs = INICIO_TRAMO
                    ENDIF    

                    '
                    'Calculo el precio de los dias de vacaciones para esos días
                    '
                    PRECIO_DIAS_VAC = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#3553")
                  
                ENDIF

            ELSEIF motivoabs = "10" THEN
                '
                'Calculo el precio de la licencia por casamiento para esos días
                '
                PRECIO_DIAS_LCAS = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4070")
           
            ELSEIF motivoabs = "11" THEN
                '
                'Calculo el precio de la licencia por nacimiemto para esos días
                '
                PRECIO_DIAS_LNAC = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4080")
                    
            ELSEIF motivoabs = "12" THEN
                '
                'Calculo el importe de la licencia por defunción para esos días
                '
                PRECIO_DIAS_LDEF = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4090")
                   
            ELSEIF motivoabs = "13" THEN
                '
                'Calculo el precio de la licencia por examen para esos días
                '
                PRECIO_DIAS_LEX = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4100")
                    
            ELSEIF motivoabs = "17" THEN
                '
                'Calculo el precio para hemodonación 
                '
                PRECIO_DIAS_DSAN = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4108")
                
            ELSEIF motivoabs = "30" THEN
                '
                'Calculo el precio para la Reserva de Puesto por Enfermedad
                '
                PRECIO_DIAS_RE_ENF = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4193")
                    
            ELSEIF motivoabs = "31" THEN
                '
                'Calculo el importe para la Reserva de Puesto por Accidente
                '
                PRECIO_DIAS_RE_ACC = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4190")
                
            ELSEIF motivoabs = "32" THEN
                '
                'Calculo el importe para la Reserva de Puesto por Actividad Sindical
                '
                PRECIO_DIAS_RE_SIN = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_abs,"#4195")
                    
            ENDIF
        ENDIF           
NEXT

'
'Asigno valor a los conceptos de tipo Precio e Importe
'

'
'Donación sangre y Enfermedad 
'
importe_aux = 0
IF SAR_DIA_DONAR_SANG > 0 THEN
    SAR_PRE_LIC_HEM = ROUND(PRECIO_DIAS_DSAN,SAR_NUM_DEC)
    SAR_DONAC_SANGRE = ROUND(PRECIO_DIAS_DSAN,SAR_NUM_DEC) * SAR_DIA_DONAR_SANG
ENDIF
IF SAR_DIAS_ENFERMEDAD > 0 THEN
    SAR_PRE_ENFER = Round(PRECIO_DIAS_ENF,SAR_NUM_DEC)
    SAR_ENFERMEDAD = Round(PRECIO_DIAS_ENF,SAR_NUM_DEC) * SAR_DIAS_ENFERMEDAD
ENDIF


'Excedencia
IF SAR_DIAS_EXCEDENCIA > 0 THEN
    SAR_PRE_EXCEDENCIA = Round(PRECIO_DIAS_EXCED,SAR_NUM_DEC) 
    importe_aux = PRECIO_DIAS_EXCED * SAR_DIAS_EXCEDENCIA * (-1)
    SAR_EXCEDENCIA= Round(importe_aux,SAR_NUM_DEC) 
ENDIF

'Ausencia Injustificada
IF SAR_DIAS_AUSENCIA > 0 THEN
    SAR_PRE_AUS_INJUST = Round(PRECIO_DIAS_AUS_INJUST,SAR_NUM_DEC)
    importe_aux = PRECIO_DIAS_AUS_INJUST * SAR_DIAS_AUSENCIA * (-1)
    SAR_AUS_INJUST = Round(importe_aux,SAR_NUM_DEC) 

    
ENDIF

'Suspencion Disciplinaria
IF SAR_DIAS_SUS_DISCI > 0 THEN
    SAR_PRE_SUS_DISCI = Round(PRECIO_DIAS_SUS_DISCI,SAR_NUM_DEC)
    importe_aux = PRECIO_DIAS_SUS_DISCI * SAR_DIAS_SUS_DISCI * (-1)
        SAR_SUS_DISCI = Round(importe_aux,SAR_NUM_DEC) 
ENDIF


'Reserva de Puesto por Accidente
IF SAR_R_PTO_ACC > 0 THEN
    SAR_PRE_R_PTO_ACC = Round(PRECIO_DIAS_RE_ACC,SAR_NUM_DEC)
    importe_aux = PRECIO_DIAS_RE_ACC * SAR_R_PTO_ACC * (-1)
    SAR_RES_PTO_ACC = Round(importe_aux,SAR_NUM_DEC)
ENDIF

'Reserva de Puesto por Enfermedad
IF SAR_R_PTO_ENF > 0 THEN
    SAR_PRE_R_PTO_ENF = Round(PRECIO_DIAS_RE_ENF,SAR_NUM_DEC)
    importe_aux = PRECIO_DIAS_RE_ENF * SAR_R_PTO_ENF * (-1)
    SAR_RES_PTO_ENF = Round(importe_aux,SAR_NUM_DEC)
ENDIF

'Reserva de Puesto por Act. Sindical
IF SAR_R_PTO_SIN > 0 THEN
    SAR_PRE_R_PTO_SIN = Round(PRECIO_DIAS_RE_SIN,SAR_NUM_DEC)
    importe_aux = PRECIO_DIAS_RE_SIN * SAR_R_PTO_SIN * (-1)
    SAR_RES_PTO_SIN = Round(importe_aux,SAR_NUM_DEC)
ENDIF


'
'Vacaciones
'
SAR_PRE_VACACIONES = ROUND(PRECIO_DIAS_VAC,SAR_NUM_DEC)

IF SAR_UN_VACACIONES > 0 THEN
    SAR_VACACIONES = ROUND(PRECIO_DIAS_VAC,SAR_NUM_DEC) * SAR_UN_VACACIONES
ENDIF 

'
'Lic. Gremial, Casamiento, Nacimiento, Defunción o Examen
'
IF SAR_DIAS_LIC_CONV > 0 THEN
    SAR_PRE_LICENCIAS = ROUND(PRECIO_DIAS_LCONV,SAR_NUM_DEC) 
    SAR_LIC_GREMIAL = ROUND(PRECIO_DIAS_LCONV,SAR_NUM_DEC) * SAR_DIAS_LIC_CONV
ENDIF
IF SAR_DIAS_CASAMIENTO > 0 THEN
    SAR_PRE_LICENCIAS_CAS = Round(PRECIO_DIAS_LCAS,SAR_NUM_DEC)
    SAR_CASAMIENTO =  Round(PRECIO_DIAS_LCAS,SAR_NUM_DEC) * SAR_DIAS_CASAMIENTO
ENDIF
IF SAR_DIAS_NACIMIENTO > 0 THEN
    SAR_PRE_LICENCIAS_NAC = ROUND(PRECIO_DIAS_LNAC,SAR_NUM_DEC)
    SAR_NACIMIENTO =  ROUND(PRECIO_DIAS_LNAC,SAR_NUM_DEC) * SAR_DIAS_NACIMIENTO
ENDIF
IF SAR_DIAS_DEFUNCION > 0 THEN
    SAR_PRE_LICENCIAS_DEF = ROUND(PRECIO_DIAS_LDEF,SAR_NUM_DEC) 
    SAR_DEFUNCION = ROUND(PRECIO_DIAS_LDEF,SAR_NUM_DEC) * SAR_DIAS_DEFUNCION
ENDIF
IF SAR_DIAS_EXAMEN > 0 THEN
    SAR_PRE_LICENCIAS_EX = ROUND(PRECIO_DIAS_LEX,SAR_NUM_DEC)
    SAR_EXAMEN = ROUND(PRECIO_DIAS_LEX,SAR_NUM_DEC) * SAR_DIAS_EXAMEN
ENDIF

'
'Hs de ausencia y Hs Extras
'
IF SAR_UNIDAD_HS_AUSENCIA > 0 THEN
    SAR_PRECIO_HS_AUSENCIA = Round(PRECIO_HS_AUSENCIA,SAR_NUM_DEC)
    'Es una ausencia, debe restar al total. 
    importe_aux = PRECIO_HS_AUSENCIA * (-1)
     SAR_HS_AUSENCIA = Round(importe_aux,SAR_NUM_DEC) * SAR_UNIDAD_HS_AUSENCIA
ENDIF
IF SAR_UN_HORAS_50 > 0 THEN
    SAR_PR_HORAS_50 = Round(PRECIO_HS_50,SAR_NUM_DEC)
    SAR_HORAS_50 = Round(SAR_PR_HORAS_50,SAR_NUM_DEC) * SAR_UN_HORAS_50
ENDIF
IF SAR_UN_HORAS_100 > 0 THEN
   SAR_PR_HORAS_100 = Round(PRECIO_HS_100,SAR_NUM_DEC)
   SAR_HORAS_100 = Round(SAR_PR_HORAS_100,SAR_NUM_DEC) * SAR_UN_HORAS_100
ENDIF
IF SAR_UN_HORAS_150 > 0 THEN
    SAR_PR_HORAS_150 = Round(PRECIO_HS_150, SAR_NUM_DEC)
    SAR_HORAS_150 = Round(SAR_PR_HORAS_150,SAR_NUM_DEC) * SAR_UN_HORAS_150
ENDIF
IF SAR_U_PL_NOCTUR_50 > 0 THEN
    SAR_PR_PL_NOCTUR_50 = Round((PRECIO_PL_NOC_50 + (PRECIO_PL_NOC_50 * (SAR_MIN_PL_NOCTUR/60))), SAR_NUM_DEC)
    SAR_PLUS_NOCTUR_50 = Round((SAR_PR_PL_NOCTUR_50*SAR_U_PL_NOCTUR_50),SAR_NUM_DEC) 
ENDIF
IF SAR_UN_PL_NOCTUR_100 > 0 THEN
    SAR_PR_PL_NOCTUR_100 = Round((PRECIO_PL_NOC_100 + (PRECIO_PL_NOC_100 * (SAR_MIN_PL_NOCTUR/60))), SAR_NUM_DEC)
    SAR_PL_NOCTUR_100 = Round((SAR_PR_PL_NOCTUR_100*SAR_UN_PL_NOCTUR_100),SAR_NUM_DEC)
ENDIF

IF SAR_UN_FER_TRAB > 0 THEN
    SAR_PR_FER_TRAB = Round(PRECIO_FER_TRAB, SAR_NUM_DEC)
    SAR_HORAS_FER_TRAB = SAR_PR_FER_TRAB * SAR_UN_FER_TRAB
ENDIF


'Estos quedan comentados porque no tienen asociado ningún concepto de tipo Importe
'
'IMPORTE_DIAS_RE_ENF
'IMPORTE_DIAS_RE_SIN
'IMPORTE_DIAS_LSGS
'IMPORTE_DIAS_AUSIN

'
'Si el tipo de paga es 88 o 99 asigno 0 a los importes

IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    SAR_ENFERMEDAD = 0
    SAR_LIC_GREMIAL = 0
    SAR_DEDUC_HUELGA = 0
    SAR_CASAMIENTO = 0
    SAR_NACIMIENTO = 0
    SAR_DEFUNCION = 0
    SAR_EXAMEN = 0
    SAR_DONAC_SANGRE = 0
    SAR_HS_AUSENCIA = 0
    SAR_HORAS_50 = 0
    SAR_HORAS_100 = 0
    SAR_HORAS_150 = 0
    SAR_SUS_DISCI = 0
    SAR_RES_PTO_ACC = 0
    SAR_RES_PTO_ENF = 0
    SAR_RES_PTO_SIN = 0
    SAR_PLUS_NOCTUR_50 = 0
    SAR_PL_NOCTUR_100 = 0    
    SAR_HORAS_FER_TRAB = 0 
    SAR_AUS_INJUST = 0       
ENDIF
Return(0)
