'Parametros supuestos:
'Evita sobreescrituras de SAR_CARGA_AUSENTISM y SAR_CALC_AUS_POR_TRAMO

argIncCliente = ARG_INC_CLIENTE
argIncClonar = ARG_INC_CLONAR

ARG_DIAS_INC = 0

' No se ejecuta en las pagas extras, salvo si en las Pagas Extras de Aguinaldo
If SAR_TP_IMPUT = "2" AND SAR_IND_AGUINALDO = 0 Then Return(0)

If SAR_TP_IMPUT = "99" Or SAR_TP_IMPUT = "77" Or SAR_TP_IMPUT = "88" Then Return(0)

horas = 0 		  'Inicializamos las horas
horas_teor_abs = 0  'Inicialización de las horas teóricas de cada registro

'Tramos
INICIO_TRAMO = SAR_TOT_P_COMP_EA_AUX..SysStartDate
FIN_TRAMO = SAR_TOT_P_COMP_EA_AUX..SysEndDate

'Cargamos el nodo de incidencias del periodo (ausentismos), en caso de que no esté ya cargado.
IF SAR_REAL_TIME_PERIOD.COUNT()= 0 THEN
    SAR_REAL_TIME_PERIOD.LOAD_BLK()
ENDIF

'Añadimos filtro RAM al nodo cargado para quedarnos exclusivamente con los registros de la incidencia
sFilter = "If SCO_ID_INCIDENCE = ARG_SCO_ID_INCIDENCE Then Return(M4_TRUE) Else Return(M4_FALSE)"
SAR_REAL_TIME_PERIOD.ADDFILTER(sFilter, M4_TRUE, "ARG_SCO_ID_INCIDENCE", argIncCliente)

'Si hay registros de la incidencia los recorremos para obtener las horas
SAR_REAL_TIME_PERIOD.BEGIN()
WHILE SAR_REAL_TIME_PERIOD.ISEOF() = FALSE
        	
    fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START 	' fecha de inicio del ausentismo
    fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END	' fecha de fin del ausentismo
    t_unid = SAR_REAL_TIME_PERIOD.SCO_ID_TIME_UNIT 	' tipo de unidades del ausentismo, Horas o Dias
    unid = SAR_REAL_TIME_PERIOD.SCO_UNITS 		' número de unidades del ausentismo
    
    IF commontime(INICIO_TRAMO,FIN_TRAMO,fec_ini_abs,fec_fin_abs) > 0 THEN		
        IF fec_fin_abs > FIN_TRAMO then
            fec_fin_abs = FIN_TRAMO
        ENDIF
        IF fec_ini_abs < INICIO_TRAMO then
            fec_ini_abs = INICIO_TRAMO
        ENDIF
      
        IF SCO_NUM_HOURS_THEO > 0 THEN 'tiene asignado un modelo teórico
            horas_teor_abs = SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs) 'las horas se calculan en función del tiempo teórico
		IF t_unid = "05" THEN 'Horas
		  horas = horas + Min(unid, horas_teor_abs) 'si las horas informadas superan el número de horas de tiempo teórico de la jornada, nos quedamos con las teóricas. 
		ELSE 'Dias
		  horas = horas + horas_teor_abs
		ENDIF
        ENDIF	
    ENDIF    
    SAR_REAL_TIME_PERIOD.GONEXT()
WEND

'Se elimina el filtro RAM aplicado al nodo
SAR_REAL_TIME_PERIOD.REMOVEFILTER()

ARG_DIAS_INC = horas

'Return las horas de Licencia por Convenio
Return(0)
