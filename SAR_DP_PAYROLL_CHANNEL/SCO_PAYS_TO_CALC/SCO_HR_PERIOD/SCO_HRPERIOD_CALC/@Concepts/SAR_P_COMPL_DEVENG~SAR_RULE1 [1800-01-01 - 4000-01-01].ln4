IF SCO_ID_TYPE_ADJUSTMENT <> "1" AND SCO_ID_TYPE_ADJUSTMENT <> "2" THEN 
    Return(0)
ENDIF

IF SAR_TIPO_SALARIO = "001" THEN
       valor = SCO_RTE_EAR_ADJ_THEO
ELSE
        IF SAR_DIAS_NORM_SUELD = 0 THEN
            valor = 0
        ELSE
            valor = SCO_RTE_EAR_ADJ_THEO/SAR_DIAS_NORM_SUELD
        ENDIF
ENDIF

valor = MAX(valor,0)

Return(valor)
