'No se calcula en reliquidación ni en paga de Anticipo de Vacaciones ni en la paga extra de vacaciones
If SAR_TP_IMPUT = "77" or SAR_TP_IMPUT = "88" or SAR_TP_IMPUT = "99" Then Return(0) 

' Se elimina Del calculo la paga extra que no sea de aguinaldo
If (SAR_TP_IMPUT = "2") AND SAR_IND_AGUINALDO = 0 Then Return(0)

' Se elimina Del calculo la paga extra de sac de junio 
If SAR_TP_IMPUT = "2" AND SAR_IND_AGUINALDO = 1 AND DxMonth(SCO_DT_PAYMENT) = 6 Then Return(0)

SAR_PAGA_ACTUAL_IMPUT.BEGIN()

IF (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) THEN
    mes = DxMonth(SAR_PAGA_ACTUAL_IMPUT.SAR_FECHA_PAGO_IG)
ELSE   
    mes = SAR_MES_PAGO_IG
ENDIF

dif             = 0
saldo           = 0
cuota_ant       = 0
base            = 0
cuota           = 0
meses_quedan    = 0

SAR_ACM_ULT_MES.BEGIN()
SAR_ACM_ULT_PAGO_IMPUT.BEGIN()

' No se debe tomar el valor de la cuota en Paga Extra de Diciembre de Aguinaldo. 
If (SAR_TP_IMPUT = "2" And DxMonth(SCO_DT_PAYMENT) = 12 And SAR_IND_AGUINALDO = 1) Then
    cuota_ant = 0
Else
    IF mes <> 1 THEN
        if SAR_TP_IMPUT = "4" OR SAR_TP_IMPUT = "3" Then
        
            saldo = SAR_ACM_ULT_PAGO_IMPUT.SAR_IG_SALDO_PRORRA
            cuota_ant = SAR_ACM_ULT_PAGO_IMPUT.SAR_IG_CUOT_PRORRA

            if cuota_ant = 0 Then
                saldo = SAR_ACM_ULT_MES.SAR_IG_SALDO_PRORRA
                cuota_ant = SAR_ACM_ULT_MES.SAR_IG_CUOT_PRORRA
            endif

            if cuota_ant <> 0 and SAR_TP_IMPUT = "3" Then
                cuota_ant = 0
            endif
            
            if cuota_ant <> 0 and SAR_TP_IMPUT = "4" Then
                cuota_ant = SAR_ACM_ULT_MES.SAR_IG_CUOT_PRORRA
            endif
            
        else 
            If SAR_TP_IMPUT = "1" Then               
                saldo = SAR_ACM_ULT_MES.SAR_IG_SALDO_PRORRA
                cuota_ant = SAR_ACM_ULT_MES.SAR_IG_CUOT_PRORRA
            Endif
        endif
    ENDIF
EndIf
  
IF saldo < cuota_ant THEN
    cuota_ant = saldo
ENDIF

'Por modificación del empleado se agregó: SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017"
IF ((SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") OR mes = 12)  THEN
    if SAR_TP_IMPUT = "4" Then        
        saldo = SAR_ACM_ULT_MES.SAR_IG_SALDO_PRORRA
        RETURN(SAR_TOT_PROR_SIN_AP + SAR_TOT_PROR_CON_AP + saldo)
    Else  
        If SAR_TP_IMPUT <> "3" Then
            RETURN(SAR_TOT_PROR_SIN_AP + SAR_TOT_PROR_CON_AP + saldo)
        Endif
    Endif
ENDIF

IF (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) THEN
    dif = SAR_TOT_PROR_SIN_AP + SAR_TOT_PROR_CON_AP - SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_SIN_AP - SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_CON_AP
    IF dif >= 0 THEN
        aux = SAR_PAGA_ACTUAL_IMPUT.SAR_IG_CUOT_PRORRA            
        SAR_IG_CUOT_AD = dif
        RETURN(aux)
    ELSE
        base = SAR_TOT_PROR_SIN_AP+SAR_TOT_PROR_CON_AP
    ENDIF
ELSE
    SAR_INCRE_PRORRATEOS.BEGIN()
    base = SAR_TOT_PROR_SIN_AP + SAR_TOT_PROR_CON_AP + SAR_INCRE_PRORRATEOS.SAR_IG_CUOT_AD
ENDIF

meses_quedan = 12 - mes + 1
cuota = base / meses_quedan 
cuota = Round(cuota, SAR_NUM_DEC)

IF saldo = 0 THEN
   RETURN(cuota)
ELSE
   RETURN(cuota + cuota_ant)
ENDIF
