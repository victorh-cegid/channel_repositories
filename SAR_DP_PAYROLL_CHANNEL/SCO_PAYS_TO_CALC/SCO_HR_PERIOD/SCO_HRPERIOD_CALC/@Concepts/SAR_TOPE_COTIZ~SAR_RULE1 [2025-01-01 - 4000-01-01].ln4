'Carga nodo acum cotiz
SAR_LSD_COTIZ.DESTROY()
SAR_LSD_COTIZ.SCO_DT_START = DxDate(1,1,DxYear(SCO_DT_ALLOCATION)-1)
SAR_LSD_COTIZ.SCO_DT_END = DxDate(31,12,DxYear(SCO_DT_ALLOCATION)+1)
SAR_LSD_COTIZ.LOAD_BLK()
'fin carga nodo acum

'Carga nodo acum cotiz SAC
If DxMonth(SAR_LSD_FECHA) < 7 Then
    SAR_LSD_SAC_MES_INI = 1
    SAR_LSD_SAC_MES_FIN = 6
Else
    SAR_LSD_SAC_MES_INI = 7
    SAR_LSD_SAC_MES_FIN = 12
EndIf
SAR_LSD_SAC_COTIZ.DESTROY()
SAR_LSD_SAC_COTIZ.SCO_DT_START = DxDate(1,1,DxYear(SCO_DT_ALLOCATION)-1)
SAR_LSD_SAC_COTIZ.SCO_DT_END = DxDate(31,12,DxYear(SCO_DT_ALLOCATION)+1)
SAR_LSD_SAC_COTIZ.LOAD_BLK()
'fin carga nodo acum

'Recupera el valor del tope en funcion de la fecha LSD
valor = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_TOPE_COTIZ",SAR_LSD_FECHA,0))
If valor = 0 Then valor = SAR_VALOR_AMPO * SAR_CANT_MOPRE_TOPE
RETURN(valor)
