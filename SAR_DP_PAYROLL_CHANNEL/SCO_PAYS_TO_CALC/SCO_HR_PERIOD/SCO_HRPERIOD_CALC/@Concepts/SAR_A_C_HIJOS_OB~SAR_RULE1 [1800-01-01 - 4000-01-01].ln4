'Segun el inciso a del articulo 9 de la ley 23660. 
'
IF SAR_FAMILIARES.COUNT() = 0 THEN
    Return(0)
ENDIF

contador = 0

primerreg = 0
ultimoreg = SAR_FAMILIARES.COUNT() - 1

FOR I = primerreg TO ultimoreg 
    SAR_FAMILIARES.MOVETO(I)
    
    primerreg1 = 0
    ultimoreg1 = SAR_FAM_A_CARGO.COUNT() - 1

    FOR J = primerreg1 TO ultimoreg1 
        SAR_FAM_A_CARGO.MOVETO(J)
        motivodesc = SAR_FAM_A_CARGO.SAR_ID_TIPO_ASIG 
        estud = SAR_FAM_A_CARGO.SAR_ID_OCUPACION 
    NEXT
            
           
    parent = SAR_FAMILIARES.STD_ID_ACT_DEP_TYPE
    fec_nac = SAR_FAMILIARES.STD_DT_BIRTH
    edad = DATEDIFF(fec_nac,SAR_FAMILIARES.SAR_DT_ALLOC_END,M4_YEAR)
    IF SAR_INCAPACIDAD_FAM.COUNT() > 0 THEN
        incap = "S"
    ELSE
        incap = "N"
    ENDIF

    IF motivodesc = "01" AND (parent = "2" OR (parent = "2" AND incap = "S") OR (parent = "2" AND edad < 21) OR (parent = "2" AND estud = "1" AND edad < 26)) THEN
        contador = contador +1
    ENDIF


NEXT

Return(contador)
