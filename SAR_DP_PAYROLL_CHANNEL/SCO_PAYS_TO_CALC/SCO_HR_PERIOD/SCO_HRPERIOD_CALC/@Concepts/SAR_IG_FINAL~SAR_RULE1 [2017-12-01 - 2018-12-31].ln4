'Antes de realizar cualquier cálculo se verifica que la empresa haga la retención correspondiente a ganancias:
If(SAR_IND_NO_RET_GAN = 1)Then 
    Return(0)
EndIf  

'Antes de realizar cualquier calculo del impuesto verificamos que la modificación se realizó a fin del mes
'de la paga para de esta forma dejar el calculo al nuevo período.
'If (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017")Then
If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" And SAR_FECHA_BAJA < DxDate("31","12",DxYear(SAR_FEC_IMPUT_IG)) Then
    Return(0)
EndIf


If SAR_TP_IMPUT <> "99" Then 
  Return(0)
EndIf 


'Inicializo variable

v1 = SAR_IMPUESTO_TOTAL
v2 = 0
dev = 0
v3 = SAR_IMP_ANT_EMP
v4 = SAR_IMP_DEB_BAN
v5 = SAR_IMP_OTROS_EMP
VALOR1 = 0

sar_acum_imp_ant_emp = 0
sar_acum_imp_oe      = 0


'-------------------------------------------------------------
'Recorro acumulado de lectura para armar las TI de IG
'-------------------------------------------------------------
SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()

I = ULTIMO_REG - 1 

WHILE I >= 0 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
       
    ' Armo los datos para SAR_ACM_IMPUESTO
    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG >= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN    
        v2                   = v2 + SCO_AC_HR_PERIOD_READ_1.SAR_IMPUESTO + SCO_AC_HR_PERIOD_READ_1.SAR_IG_FINAL
    ENDIF

    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG >= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION THEN    
        sar_acum_imp_ant_emp = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_ANT_EMP
        sar_acum_imp_oe      = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_OTROS_EMP
    ENDIF
    I = I - 1
Wend

valor = v1 - (v2 + v3 + v5) - v4

IF SAR_IND_APLIC_TOPE_35 = 1 THEN
    SAR_ACM_ULT_PAGO_IMPUT.BEGIN()
    IF SAR_ACM_ULT_PAGO_IMPUT.COUNT() > 0 THEN
        IF ISNULL(SAR_ACM_ULT_PAGO_IMPUT.SAR_SALD_RET_GAN_ST) = FALSE THEN
            ret_pediente = SAR_ACM_ULT_PAGO_IMPUT.SAR_SALD_RET_GAN_ST
            If valor <> ret_pediente Then
               ret_pediente = valor
            EndIf
            SAR_SALD_RET_GAN_ST = ret_pediente
            'Ante casos con indicativo de Tope del 35% activo, el valor topado se guarda en el c5320, 
            'debiendo el empleado responsabilizarse en la AFIP por ese valor no retenido.
            Return(0)
        ENDIF
    ENDIF
ENDIF

'Para evitar diferencias por decimales y cuadren reportes
If abs(valor) <= SAR_TOLERANCIA_DEC Then 
    valor = 0
    SetValuePriority(0,"SAR_HRPERIOD_CALC","SAR_IMP_RET_TOT",-1,SAR_IMPUESTO_TOTAL)
EndIf

Return(valor)
