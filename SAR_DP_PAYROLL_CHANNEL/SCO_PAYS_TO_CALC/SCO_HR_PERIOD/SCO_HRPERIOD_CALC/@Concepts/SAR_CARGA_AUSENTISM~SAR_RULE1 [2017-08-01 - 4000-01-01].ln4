' No se ejecuta en las pagas extras, salvo si en las Pagas Extras de Aguinaldo
If SAR_TP_IMPUT = "2" AND SAR_IND_AGUINALDO = 0 Then Return(0)

If SAR_TP_IMPUT = "99" Or SAR_TP_IMPUT = "77" Or SAR_TP_IMPUT = "88" Then Return(0)

'Obtengo la fecha de inicio y fin de cada tramo
INICIO_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysStartDate
FIN_TRAMO 	 = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysEndDate

'para que se ejecuten antes de hacer la asignacion y funcione en revision
aux = SAR_DIA_DONAR_SANG     'Donacion Sangre
aux = SAR_DIAS_EXAMEN        'Lic. Examen 
aux = SAR_DIAS_DEFUNCION     'Lic.Defuncion
aux = SAR_DIAS_NACIMIENTO    'Lic.Nacimiento
aux = SAR_DIAS_CASAMIENTO    'Lic.Casamiento
aux = SAR_DIAS_HUELGA        'Huelga
aux = SAR_DIAS_LIC_CONV      'Lic.Convenio
aux = SAR_LIC_S_GOC_SUELD    'Lic.sin Goce de Sueldo
aux = SAR_DIAS_SUS_DISCI     'Suspension
aux = SAR_DIAS_ENFERMEDAD    'Enfermedad
aux = SAR_DIAS_AUSENCIA      'Ausencia sin aviso
aux = SAR_R_PTO_ACC          'Reserva de Puesto por Accidente
aux = SAR_R_PTO_ENF          'Reserva de Puesto por Enfermedad
aux = SAR_R_PTO_SIN          'Reserva de Puesto por Actividad Sindical
'Bug(0310670) - No eliminar el codigo
'aux = SAR_UN_HORAS_150
aux = SAR_UNIDAD_HS_AUSENCIA
aux = SAR_UN_FER_TRAB
aux = SAR_DIAS_DEC792        'Compensacion decreto 792

'Cantidades de dias de licencias
dias_enf 		= 0	'dias de enfermedad
dias_acc 		= 0 'dias accidente
dias_lconv 		= 0 'dias de licencia convenio
dias_lsgs 		= 0 'dias de licencia sin goce de sueldo
dias_ausin 		= 0 'dias de ausencia injustificada
dia_huelga 		= 0 'dias de huelga
dias_lcas 		= 0 'dias licencia casamiento
dias_lnac 		= 0 'dias licencia nacimiento
dias_ldef 		= 0 'dias de licencia por defuncion
dias_lex 		= 0 'dias de licencia por examen
dias_dsan 		= 0 'dias donacion de sangre
dias_susp 		= 0 'dias suspension
dias_re_acc 	= 0 'dias de reserva de puesto por accidente
dias_re_enf 	= 0 'dias de reserva de puesto por enfermedad
dias_re_sin 	= 0 'dias de reserva de puesto por actividad sindical
'Bug(0310670) - No eliminar el codigo
'horas_150 = 0       'horas al 150%
horas_ausencia = 0  'horas ausencia
d_tomados = 0 
plus_noc_100 = 0    'plus nocturno 100%
horas_fer_trab = 0  'horas feriado trabajado
dias_dec792 = 0     'Compensacion decreto 792

'Fechas para topear
fec_fin_abs_enfer  = ToDate("1800-01-01")	'01 Enfermedad
fec_fin_abs_lsgs   = ToDate("1800-01-01")	'05 Lic. sin  Goce de Sueldo
fec_fin_abs_rpe    = ToDate("1800-01-01")	'30 Reserva de Puesto por Enfermedad
fec_fin_abs_rpa    = ToDate("1800-01-01")	'31 Reserva de Puesto por Accidente
fec_fin_abs_rpas   = ToDate("1800-01-01")	'32 Reserva de Puesto por Actividad Sindical
 
'Verificamos si el empleado posee ausentismos a nivel de Periodo y a nivel de Rol
'Si posee a nivel de Rol, contamos las Hs de ausencia y las Hs Extras
REG_AUSENTISMOS = SAR_REAL_TIME_PERIOD.COUNT()
REG_HS_AUSENCIA = 0
SAR_HR_ROLE.BEGIN()

WHILE SAR_HR_ROLE.ISEOF() = FALSE
    IF SAR_REAL_TIME_PER_ROLE.COUNT() > 0 THEN
        REG_HS_AUSENCIA = REG_HS_AUSENCIA + 1
        SAR_REAL_TIME_PER_ROLE.BEGIN()

        WHILE SAR_REAL_TIME_PER_ROLE.ISEOF() = FALSE
            'Para calcular las unidades de Horas Extras y ausencias se tiene en cuenta que la 
            'fecha de inicio del ausentismo este comprendida en el tramo que se esta procesando.
            IF INICIO_TRAMO <= SAR_REAL_TIME_PER_ROLE.SCO_DT_START AND SAR_REAL_TIME_PER_ROLE.SCO_DT_START <=  FIN_TRAMO THEN 
                motivoabs = FORMAT(SAR_REAL_TIME_PER_ROLE.SCO_ID_INC_GROUP,0)
                fec_abs = SAR_REAL_TIME_PER_ROLE.SCO_DT_END

                
                '
                'Para contar las Hs de ausencia consideramos el tipo de incidencia SCO_ID_INC_GROUP
                '
                IF motivoabs = "500" THEN
                    horas_ausencia = horas_ausencia + SAR_REAL_TIME_PER_ROLE.SCO_UNITS
                ENDIF
                '
                'Para contar las Hs Extras consideramos el ID de incidencia SCO_ID_INCIDENCE
                '
                idabs = FORMAT(SAR_REAL_TIME_PER_ROLE.SCO_ID_INCIDENCE,0)
                'Calculamos las unidades de las horas extras al 50%
                'Bug(0310670) - No eliminar el codigo
                'IF idabs = "35" THEN
                '   horas_150 = horas_150 + SAR_REAL_TIME_PER_ROLE.SCO_UNITS
                'Fin Bug(0310670)
                IF idabs = "54" THEN  
                'Calculamos las unidades de las horas de feriado trabajado
                   horas_fer_trab = horas_fer_trab + SAR_REAL_TIME_PER_ROLE.SCO_UNITS
                ENDIF
            ENDIF
            
            SAR_REAL_TIME_PER_ROLE.GONEXT()
        WEND
    ENDIF

    SAR_HR_ROLE.GONEXT()
WEND

''Se busca si existe un registro para esta paga en la tabla Vacaciones a Descontar. En caso que exista se elimina.
'IF REG_AUSENTISMOS = 0 THEN
'    SAR_VAC_DELETE.begin()
'
'    if SAR_VAC_DELETE.COUNT() > 0 Then
'        primerreg_vac = 0
'        ultimoreg_vac = SAR_VAC_DELETE.COUNT() - 1
'
'        FOR I = primerreg_vac  TO  ultimoreg_vac 
'             SAR_VAC_DELETE.MOVETO(I)
'             fec_pago_del = SAR_VAC_DELETE.SCO_DT_PAY
'
'             if fec_pago_del = SCO_DT_PAYMENT Then
'                'Se elimina el registro existente.
'                SAR_VAC_DELETE.Deleteregister()
'             endif
'        NEXT
'    endif
'ENDIF
'
'If REG_AUSENTISMOS = 0 And REG_HS_AUSENCIA = 0 Then Return(0)


'Ahora contabilizamos las ausencias diarias que se cargan a nivel de period
primerreg = 0
ultimoreg = SAR_REAL_TIME_PERIOD.COUNT() - 1

'Asigno las fechas de inicio y fin de tramo
fec_ini_paga = INICIO_TRAMO
fec_fin_paga = FIN_TRAMO

FOR I = primerreg  TO  ultimoreg 
    SAR_REAL_TIME_PERIOD.MOVETO(I)
    motivoabs 	= FORMAT(SAR_REAL_TIME_PERIOD.SCO_ID_INCIDENCE,0)
    fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
    fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END
    excedente = 0
	
    If DxMonth(FIN_TRAMO) = 2 THEN
	   IF fec_fin_abs >= FIN_TRAMO And DxDay(FIN_TRAMO) = 28 THEN
	       excedente = excedente + 2
	   ELSEIF fec_fin_abs >= FIN_TRAMO And DxDay(FIN_TRAMO) = 29 THEN
	       excedente = excedente + 1
	   Endif
    Endif

    'Contabilizo la cantidad de dias y si el tipo de salario es Horario, traspaso las unidades a horas
    IF motivoabs = "1" THEN
        dias_enf = dias_enf + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
        'Agregado por exceso de dias ---------------------------------- 
        If fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
            dias_enf = dias_enf -1                                 '  |
        Endif                                                      '  |
        'Fin agregado por exceso de dias-------------------------------

    ELSEIF motivoabs = "23" THEN
        dias_dec792 = dias_dec792 + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
        'Agregado por exceso de dias ---------------------------------- 
        If fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
            dias_dec792 = dias_dec792 -1                                 '  |
        Endif                                                      '  |
        'Fin agregado por exceso de dias-------------------------------
    ELSEIF motivoabs = "2" THEN
        dias_susp = dias_susp + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "4" THEN
        dias_lconv = dias_lconv + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "5" THEN
        dias_lsgs = dias_lsgs + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
        'Agregado por exceso de dias ---------------------------------- 
        If fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
            dias_lsgs = dias_lsgs -1                               '  |
        Endif                                                      '  |
        'Fin agregado por exceso de dias-------------------------------        
    ELSEIF motivoabs = "7" THEN
        dias_ausin = dias_ausin + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "8" THEN
        dia_huelga = dia_huelga + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "10" THEN
        dias_lcas = dias_lcas + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "11" THEN
        dias_lnac = dias_lnac + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "12" THEN
        dias_ldef = dias_ldef + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "13" THEN
        dias_lex = dias_lex + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "17" THEN
        dias_dsan = dias_dsan + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
    ELSEIF motivoabs = "30" THEN
        dias_re_enf = dias_re_enf + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente
        'Agregado por exceso de dias ---------------------------------- 
        If fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
            dias_re_enf = dias_re_enf -1                           '  |
        Endif                                                      '  |
        'Fin agregado por exceso de dias-------------------------------          
    ELSEIF motivoabs = "31" THEN
        dias_re_acc = dias_re_acc + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente
        'Agregado por exceso de dias ---------------------------------- 
        If fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
            dias_re_acc = dias_re_acc -1                           '  |
        Endif                                                      '  |
        'Fin agregado por exceso de dias-------------------------------          
    ELSEIF motivoabs = "32" THEN
        dias_re_sin = dias_re_sin + CommonTime(fec_ini_paga, fec_fin_paga, fec_ini_abs, fec_fin_abs) + excedente 
        'Agregado por exceso de dias ---------------------------------- 
        If fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
            dias_re_sin = dias_re_sin -1                           '  |
        Endif                                                      '  |
        'Fin agregado por exceso de dias-------------------------------            
    ENDIF           
NEXT
 
tipo_paga       = SAR_PAYS_TO_CALC.SCO_PAY_TYPE_PAYM
FECHA_FIN_TRAMO = FIN_TRAMO

IF DXDAY(FIN_TRAMO) > 30 THEN
    DIA = "30"
    MES = DXMONTH(FIN_TRAMO)
	
    IF MES < 10 THEN
        MES = "0" + TOSTRING(MES,0)
    ELSE
        MES = TOSTRING(MES,0)
    ENDIF
	
    ANIO = TOSTRING(DXYEAR(FIN_TRAMO),0)
    STR_FECHA = ANIO + "-" + MES + "-" + DIA
    FECHA_FIN_TRAMO = TODATE(STR_FECHA)
ENDIF

IF DXMONTH(FIN_TRAMO) = 2 THEN
    IF DXDAY(FIN_TRAMO) = 28 THEN
        FECHA_FIN_TRAMO = FECHA_FIN_TRAMO + 2
    ELSEIF DXDAY(FIN_TRAMO) = 29 THEN
        FECHA_FIN_TRAMO = FECHA_FIN_TRAMO + 1
    ENDIF
ENDIF

'Calculo los dias del tramo
dias_tramo = (FECHA_FIN_TRAMO - INICIO_TRAMO) + 1

'Calculo los dias del tramo real
dias_tramo_real = FIN_TRAMO - INICIO_TRAMO + 1

IF dias_lex > 0 THEN
    IF dias_lex = dias_tramo_real AND SAR_TIPO_SALARIO = "001" THEN
        dias_lex = Max(dias_lex, dias_tramo)        'para los mensuales en febrero
    ENDIF
	
    maxdias_lex = dias_tramo       
    dias_lex 	= Min(dias_lex, maxdias_lex)
    dias_lex 	= Max(dias_lex, 0)
ENDIF

IF dias_ldef > 0 THEN
    IF dias_ldef = dias_tramo_real AND tipo_paga = "1" THEN
        dias_ldef = Max(dias_ldef, dias_tramo)        'para los mensuales en febrero
    ENDIF
	
    maxdias_ldef = dias_tramo       
    dias_ldef 	= Min(dias_ldef, maxdias_ldef)
    dias_ldef 	= Max(dias_ldef, 0)
ENDIF

IF dias_lnac > 0 THEN
    IF dias_lnac = dias_tramo_real AND tipo_paga = "1" THEN
        dias_lnac = Max(dias_lnac, dias_tramo)        'para los mensuales en febrero
    ENDIF
    
    maxdias_lnac = dias_tramo     
    dias_lnac = Min(dias_lnac, maxdias_lnac)
    dias_lnac = Max(dias_lnac, 0)
ENDIF

IF dias_lcas > 0 THEN
    IF dias_lcas = dias_tramo_real AND tipo_paga = "1" THEN
        dias_lcas = Max(dias_lcas, dias_tramo)        'para los mensuales en febrero
    ENDIF

    maxdias_lcas = dias_tramo       
    dias_lcas = Min(dias_lcas, maxdias_lcas)
    dias_lcas = Max(dias_lcas, 0)
ENDIF

IF dias_enf > 0 THEN
    IF dias_enf = dias_tramo_real AND tipo_paga = "1" THEN
        dias_enf = max (dias_tramo,dias_enf)       'para los mensuales en febrero
    ENDIF

    maxdias_enf = dias_tramo  
    dias_enf = Min(dias_enf, maxdias_enf)
    dias_enf = Max(dias_enf, 0)
ENDIF

IF dias_dec792 > 0 THEN
    IF dias_dec792 = dias_tramo_real AND tipo_paga = "1" THEN
        dias_dec792 = max (dias_tramo,dias_dec792)       'para los mensuales en febrero
    ENDIF

    maxdias_dec792 = dias_tramo  
    dias_dec792 = Min(dias_dec792, maxdias_dec792)
    dias_dec792 = Max(dias_dec792, 0)
ENDIF

IF dias_acc > 0 THEN
    IF dias_acc = dias_tramo_real AND tipo_paga = "1" THEN
        dias_acc = Max(dias_acc, dias_tramo)        'para los mensuales en febrero
    ENDIF

    maxdias_acc = dias_tramo      
    dias_acc = Min(dias_acc, maxdias_acc)
    dias_acc = Max(dias_acc, 0)
ENDIF

IF dias_susp > 0 THEN
    IF  dias_susp = dias_tramo_real AND tipo_paga = "1" THEN
        dias_susp = Max(dias_susp, dias_tramo)        'para los mensuales en febrero
    ENDIF

    maxdias_susp = dias_tramo       
    dias_susp = Min(dias_susp, maxdias_susp)
    dias_susp = Max(dias_susp, 0)
ENDIF

IF dias_lsgs > 0 THEN
    IF dias_lsgs = dias_tramo_real AND tipo_paga = "1" THEN
        dias_lsgs = Max(dias_lsgs, dias_tramo)        'para los mensuales en febrero
    ENDIF

	maxdias_lsgs = dias_tramo       
    dias_lsgs = Min(dias_lsgs, maxdias_lsgs)
    dias_lsgs = Max(dias_lsgs, 0)
ENDIF

IF dias_ausin > 0 THEN
    IF  dias_ausin = dias_tramo_real AND tipo_paga = "1" THEN
        dias_ausin = Max(dias_ausin, dias_tramo)        'para los mensuales en febrero
    ENDIF

	maxdias_ausin = dias_tramo       
    dias_ausin = Min(dias_ausin, maxdias_ausin)
    dias_ausin = Max(dias_ausin, 0)
ENDIF

IF dia_huelga > 0 THEN
    IF  dia_huelga = dias_tramo_real AND tipo_paga = "1" THEN
        dia_huelga = Max(SAR_DIAS_HUELGA, dias_tramo)        'para los mensuales en febrero
    ENDIF

	maxdias_huelga = dias_tramo       
    dia_huelga = Min(dia_huelga, maxdias_huelga)
    dia_huelga = Max(dia_huelga, 0)
ENDIF

IF dias_dsan > 0 THEN
    IF dias_dsan = dias_tramo_real AND tipo_paga = "1" THEN
        dias_dsan = Max(dias_dsan, dias_tramo)        'para los mensuales en febrero
    ENDIF
    
    maxdias_dsan = dias_tramo       
    dias_dsan = Min(dias_dsan, maxdias_dsan)
    dias_dsan = Max(dias_dsan, 0)
ENDIF

IF dias_re_acc > 0 THEN
    IF  dias_re_acc = dias_tramo_real AND tipo_paga = "1" THEN
        dias_re_acc = Max(dias_re_acc, dias_tramo)        'para los mensuales en febrero
    ENDIF
    
    maxdias_re_acc = dias_tramo       
    dias_re_acc = Min(dias_re_acc, maxdias_re_acc)
    dias_re_acc = Max(dias_re_acc, 0)
ENDIF

IF dias_re_enf > 0 THEN
    IF dias_re_enf = dias_tramo_real AND tipo_paga = "1" THEN
        dias_re_enf = Max(dias_re_enf, dias_tramo)        'para los mensuales en febrero
    ENDIF

    maxdias_re_enf = dias_tramo       
    dias_re_enf = Min(dias_re_enf, maxdias_re_enf)
    dias_re_enf = Max(dias_re_enf, 0)
ENDIF

IF dias_re_sin > 0 THEN
    IF dias_re_sin = dias_tramo_real AND tipo_paga = "1" THEN
        dias_re_sin = Max(dias_re_sin, dias_tramo)        'para los mensuales en febrero
    ENDIF
  
    maxdias_re_sin = dias_tramo       
    dias_re_sin = Min(dias_re_sin, maxdias_re_sin)
    dias_re_sin = Max(dias_re_sin, 0)
ENDIF

'Asigno las cantidades obtenidas a los conceptos correspondientes
SAR_DIA_DONAR_SANG 	= dias_dsan
SAR_DIAS_EXAMEN 		= dias_lex
SAR_DIAS_DEFUNCION 	= dias_ldef
SAR_DIAS_NACIMIENTO 	= dias_lnac
SAR_DIAS_CASAMIENTO 	= dias_lcas
SAR_DIAS_HUELGA 		= dia_huelga
SAR_DIAS_LIC_CONV 	= dias_lconv
SAR_LIC_S_GOC_SUELD 	= dias_lsgs
SAR_R_PTO_ACC 		= dias_re_acc
SAR_R_PTO_ENF 		= dias_re_enf
SAR_R_PTO_SIN 		= dias_re_sin
SAR_DIAS_SUS_DISCI 	= dias_susp 
SAR_DIAS_ENFERMEDAD 	= dias_enf
SAR_DIAS_AUSENCIA 	= dias_ausin
'Bug(0310670) - No eliminar el codigo
'SAR_UN_HORAS_150 = horas_150
SAR_UNIDAD_HS_AUSENCIA = horas_ausencia
SAR_UN_FER_TRAB = horas_fer_trab
SAR_DIAS_DEC792 = dias_dec792

Return(0)
