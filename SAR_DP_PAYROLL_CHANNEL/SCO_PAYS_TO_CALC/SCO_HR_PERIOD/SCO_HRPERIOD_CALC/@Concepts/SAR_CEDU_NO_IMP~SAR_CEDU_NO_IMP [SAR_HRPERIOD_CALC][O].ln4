If SAR_CEDU_IND_IMPUESTO = 0 Or DxYear(SAR_FEC_IMPUT_IG)<2024 Then Return(0)

'Inicializo variables
indZonaPat          = SAR_IND_ZONA_PAT              'indicador zona patagonica
ano_pago_act        = DxYear(SAR_FEC_IMPUT_IG)      'A?o fecha calculo actual
mes_pago_act        = DxMonth(SAR_FEC_IMPUT_IG)     'Mes fecha calculo actual
dia_pago_act        = DaysOfMonth(SAR_FEC_IMPUT_IG) 'Dia fecha calculo actual

valorAnual = SAR_CEDU_SAL_MIN * 180
If indZonaPat = 1 Then valorAnual = valorAnual * 1.22

valorMensual = valorAnual/12

'Fecha inicio y fin, en enero un empleado no diferido seran 01/01/a?oIG y 31/01/a?oIG, un empleado diferido seran 01/01/a?oIG y 28/02/a?oIG
fec_mes_ini  = DxDate("01","01",ano_pago_act)                   'Fecha mes inicio a?o fiscal
fec_mes_fin  = DxDate(dia_pago_act,mes_pago_act,ano_pago_act)   'Fecha mes fin imput actual

meses = DateDiff (fec_mes_ini,fec_mes_fin+1,M4_MONTH)

'Si el empleado es baja y el indicador "Calcula ganancias a Diciembre" activo se calculara el importe anual
If SAR_ES_BAJA = 1 And SAR_IG_DICIEMBRE = 1 Then meses = 12

importe = valorMensual * meses

Return(Round(importe,SAR_NUM_DEC))
