'Importe SAC para reportes IG. Se resta importe de SAC imputado a años anteriores
If SAR_TP_IMPUT <> "99" And SAR_ES_BAJA = 0 And SAR_IND_AJUSTE_SAC = 0 Then Return(0) 
'para agregar dependencias:
a = SAR_CALC_SAC_27617
cuota_acum = SAR_ACM_IG_ANIO_IMPUT[0].SAR_SAC_1_GRAV_MES
cuota_act = SAR_SAC_1_GRAV_MES
cuota_anio_ant = SAR_SAC_1_ANIO_ANT

'Sólo 2023 corrección de ajustes de SAC1 realizadas posteriormente a octubre que han quedado en ambos periodos fiscales, se saca del periodo desde octubre
indReliq = SAR_IND_PAGA_RELIQ
If indReliq = 1 And DxYear(SAR_FEC_PAGO_IG) = 2023 And SCO_DT_ALLOCATION = SCO_DT_PAYMENT And DxMonth(SCO_DT_ALLOCATION) = 12 Then
    ajusteSobra = 0
    mes_ini_ig = DxDate(1,1,DxYear(SAR_FEC_IMPUT_IG))
    ult_dia_mes = DaysOfMonth (DxDate(1,DxMonth(SAR_FEC_IMPUT_IG)-1,DxYear(SAR_FEC_IMPUT_IG)))
    mes_fin_ig = DxDate(ult_dia_mes,DxMonth(SAR_FEC_IMPUT_IG)-1,DxYear(SAR_FEC_IMPUT_IG))
    ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
    For acum = 0 To ult_reg - 1
        If SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG >= mes_ini_ig And SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG <= mes_fin_ig And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT<>"88" And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT<>"99" And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION <> SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT And DxMonth(SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION) = 6 And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT>=DxDate(1,10,2023) And SCO_AC_HR_PERIOD_READ_1[acum].SAR_IND_D473_IMP_PER_ANT = 0 Then
            ajusteSobra = ajusteSobra + SCO_AC_HR_PERIOD_READ_1[acum].SAR_SAC_1_GRAV_MES
        EndIf
    Next
    cuota_acum = cuota_acum - ajusteSobra
EndIf
'Fin sólo 2023

Return Round(cuota_acum + cuota_act - cuota_anio_ant,SAR_NUM_DEC)
