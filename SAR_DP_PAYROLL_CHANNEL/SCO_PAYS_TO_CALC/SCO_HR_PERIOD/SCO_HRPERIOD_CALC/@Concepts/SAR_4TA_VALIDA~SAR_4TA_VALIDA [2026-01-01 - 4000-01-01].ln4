'Control de decimales
If importe - Round(importe,SAR_NUM_DEC) <> 0 Then resultado = resultado + "/" + idConcepto + " DEC"
hijos = importe
'Tope
tope = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_VAL_HIJO_IMP",DxDate(1,12,DxYear(SAR_FEC_PAGO_IG)),0))
tope = Round (tope * 12,SAR_NUM_DEC)
tope = (tope * SAR_NUM_HIJOS_100) + Round(tope * 0.5 * SAR_NUM_HIJOS_50,2)
If importe > tope Then resultado = resultado + "/" + idConcepto + " TOPE"

