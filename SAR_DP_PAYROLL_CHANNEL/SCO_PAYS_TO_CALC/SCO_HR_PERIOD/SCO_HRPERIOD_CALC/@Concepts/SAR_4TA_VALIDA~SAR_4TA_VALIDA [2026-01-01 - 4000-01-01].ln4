'Subtotal saldo determinado antes de Pagos a Cuenta #5682 - SAR_4TA_SUBTOT_SALDO
importe = SAR_4TA_SUBTOT_SALDO
idConcepto = "SAR_4TA_SUBTOT_SALDO"
'Control de negativos
'Nota: Se considera como saldado para no generar un falso error de validación, 
'aunque se expondra realmente saldado tras la paga que recoge el importe de la liquidación anual
'If importe + SAR_SALDO_4CATEG < 0 Then resultado = resultado + "/" + idConcepto + " NEG"
'Control de decimales
If importe - Round(importe,2) <> 0 Then resultado = resultado + "/" + idConcepto + " DEC"
'Validación
If importe <> SAR_IMPUESTO_TOTAL - SAR_IMP_RET_4CATEG Then resultado = resultado + "/" + idConcepto + " VAL1"

'SALDO DETERMINADO #5575 - SAR_SALDO_4CATEG
importe = SAR_SALDO_4CATEG
idConcepto = "SAR_SALDO_4CATEG"
'Control de decimales
