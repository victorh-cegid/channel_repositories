If importe <> SAR_4TA_SUBTOT_SALDO - SAR_IMPUESTO_AUTORET - SAR_4TA_TOT_PAGOS_CTA  Then resultado = resultado + "/" + idConcepto + " VAL1"

If resultado = " " Then resultado = "OK"

Return(resultado)
