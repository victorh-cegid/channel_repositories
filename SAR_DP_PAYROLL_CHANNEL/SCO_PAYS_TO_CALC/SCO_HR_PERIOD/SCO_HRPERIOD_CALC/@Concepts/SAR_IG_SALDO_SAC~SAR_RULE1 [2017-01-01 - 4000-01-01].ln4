'RG 3976. Se cierra esta norma a 31/12/2017. Se mantiene durante 2017 por si existiesen prorrateos 
'pendientes del SAC del año 2016.

IF SCO_DT_ALLOCATION <> SCO_DT_PAYMENT THEN
    mes = DxMonth(SAR_PAGA_ACTUAL_IMPUT[0].SAR_FECHA_PAGO_IG)
ELSE     
    mes = SAR_MES_PAGO_IG 
ENDIF 

If DxMonth(SCO_DT_PAYMENT) = 6 And (SAR_TP_IMPUT = "3" or SAR_TP_IMPUT = "4") AND (SAR_IND_AGUINALDO = 0 AND SAR_U_PAGA_AJ_EX_1 = 0) Then
   Return(0)
EndIf

'Por modificación del empleado se agregó: SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017"
IF ((mes = 12) OR (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") OR (SAR_TP_IMPUT = "3" AND SAR_IND_AGUINALDO = 0)) THEN
    RETURN(0)
ENDIF

'Modificación RG3976. En 2017 no se va a prorratear el SAC desde junio en este concepto, se hará en el concepto 5192 según la nueva definición legal.
base_mes_actual = 0


dif = 0
SAR_INCRE_PRORRATEOS.BEGIN()

If (SAR_TP_IMPUT = "4") AND (SAR_IND_AGUINALDO = 0 And SAR_U_PAGA_AJ_EX_1 = 0 and SAR_U_PAGA_AJ_EX_2 = 0)Then 
    aux = 0
Else      
    aux = base_mes_actual
EndIf      

valor = 0

IF SAR_PAGA_ACTUAL_IMPUT.COUNT() > 0 THEN
    SAR_PAGA_ACTUAL_IMPUT.BEGIN()
    IF ISNULL(SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_SAC) = FALSE THEN
        sar_tot_pror_sac_aux = SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_SAC
    ELSE
        sar_tot_pror_sac_aux = 0
    ENDIF
ELSE
    sar_tot_pror_sac_aux = 0
ENDIF
 
IF SAR_ACM_ULT_MES.COUNT() > 0 THEN
    SAR_ACM_ULT_MES.BEGIN()
    IF ISNULL(SAR_ACM_ULT_MES.SAR_IG_SALDO_SAC) = FALSE THEN
        sar_ig_saldo_sac_aux = SAR_ACM_ULT_MES.SAR_IG_SALDO_SAC
    ELSE 
        sar_ig_saldo_sac_aux = 0
    ENDIF
ELSE
    sar_ig_saldo_sac_aux = 0
ENDIF


If ((mes = 2 or mes = 8) And (DxMonth(SCO_DT_PAYMENT) <> DxMonth(SAR_FEC_PAGO_IG))) Then 
    IF SAR_SAC_PRORR_ANT.COUNT() > 0 THEN
        SAR_SAC_PRORR_ANT.BEGIN()        
        sar_ig_saldo_sac_aux = SAR_SAC_PRORR_ANT.SAR_IG_SALDO_SAC      
    else 
        sar_ig_saldo_sac_aux = 0
    EndIf
EndIf


IF SAR_INCRE_PRORRATEOS.COUNT() > 0 THEN
    SAR_INCRE_PRORRATEOS.BEGIN()
    IF ISNULL(SAR_INCRE_PRORRATEOS.SAR_IG_SAC_AD) = FALSE THEN
        sar_ig_sac_ad_aux = SAR_INCRE_PRORRATEOS.SAR_IG_SAC_AD
    ELSE
        sar_ig_sac_ad_aux = 0
    ENDIF
ELSE
    sar_ig_sac_ad_aux = 0
ENDIF

IF SCO_DT_ALLOCATION <> SCO_DT_PAYMENT THEN
    dif = SAR_TOT_PROR_SAC - sar_tot_pror_sac_aux
    IF dif > 0 THEN
        aux = sar_tot_pror_sac_aux
    ENDIF
    valor = aux - SAR_IG_CUOT_SAC + sar_ig_saldo_sac_aux 
    
    If valor < 0 Then Valor = 0
ELSE
    valor = aux - SAR_IG_CUOT_SAC + sar_ig_saldo_sac_aux + sar_ig_sac_ad_aux
    
    If valor < SAR_IG_CUOT_SAC And valor > 0 Then
        valor = SAR_IG_CUOT_SAC
    EndIf
ENDIF

RETURN(valor)
