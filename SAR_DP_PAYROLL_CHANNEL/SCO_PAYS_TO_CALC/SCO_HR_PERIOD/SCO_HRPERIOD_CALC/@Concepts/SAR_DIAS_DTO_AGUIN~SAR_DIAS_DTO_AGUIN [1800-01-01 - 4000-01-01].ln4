'
' Dias que no devenga paga de aguinaldo
'

aux = SAR_CARGA_AUSENTISM

valor= SAR_DIAS_HUELGA + SAR_LIC_S_GOC_SUELD + SAR_R_PTO_ACC + SAR_R_PTO_ENF + SAR_R_PTO_SIN + SAR_DIAS_EXCEDENCIA + SAR_DIAS_SUS_DISCI + SAR_DIAS_MATERN + SAR_LIC_ONCO_DIAS + SAR_DIAS_AUSENCIA ' Aqui sumar los dias que se deban descontar
valor= valor + SAR_DIAS_SUSP_ART_223BIS + SAR_DIAS_SUSP_RES_397 + SAR_DIAS_DEC792

Return(valor)
