'Dias de alta del mes (no de la paga) atendiendo a fecha alta y baja y al comportamiento STD definido en SAR_DIAS_ALTA
'Se usaran para calcular el tope imponible del mes proporcional por alta/baja
es_alta = 0
es_baja = 0
dias_tope = 30
ini_mes = DxDate("01",DxMonth(SCO_DT_ALLOCATION),DxYear(SCO_DT_ALLOCATION))
fin_mes = DxDate(DaysOfMonth(SCO_DT_ALLOCATION),DxMonth(SCO_DT_ALLOCATION),DxYear(SCO_DT_ALLOCATION))
If ini_mes < SAR_FECHA_ALTA And SAR_HR_PERIOD.STD_ID_HRP_START_REASON <> "005" Then es_alta = 1
If fin_mes > SAR_FECHA_BAJA And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then es_baja = 1
If es_alta = 1 Or es_baja = 1 Then
    diasNatAlta = commontime(ini_mes,fin_mes,SAR_FECHA_ALTA,SAR_FECHA_BAJA)
    diasNatNoAlta = Max(0,DaysOfMonth(SCO_DT_ALLOCATION) - diasNatAlta)
    If es_baja = 1 Then
        dias_tope = Min(30,diasNatAlta)
    ElseIf es_alta = 1 Then
    	If DxDay(SAR_FECHA_ALTA) = 31 Then
    		dias_tope = 1
    	Else
    		dias_tope = Max(30 - diasNatNoAlta,0)
    	EndIf
    EndIf
EndIf

'Vacaciones adelantadas se restan los dias DESCONTADOS de vacaciones del MES, no de la paga
diasVacDescTotMesLSD = 0
If SAR_LSD_IND_VAC_AD = 1 Then
    'Jornales se convierten las horas a dias usando SAR_HS_DIARIAS_PROM
    diasVacDesc = SAR_DIAS_VACACIONES
    diasVacDescOrig = 0
    If SCO_DT_PAYMENT <> SCO_DT_ALLOCATION Then diasVacDescOrig = SCO_AC_HR_PERIOD_REV_1.SAR_DIAS_VACACIONES
    diasVacDesc = diasVacDesc - diasVacDescOrig
    diasVacDescPrev = SAR_LSD_COTIZ[0].SAR_DIAS_VACACIONES
    diasVacDescTotMesLSD = diasVacDesc + diasVacDescPrev
    horas = 1
    If SAR_HS_DIARIAS_PROM > 0 AND SCO_PAY_FREQ_ALLOC = "003" Then horas = SAR_HS_DIARIAS_PROM
    diasVacDescTotMesLSD = diasVacDescTotMesLSD/horas
EndIf
'Fin vacaciones adelantadas

dias_tope = Max (dias_tope-diasVacDescTotMesLSD,0)
Return (dias_tope)
