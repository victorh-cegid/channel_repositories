If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then Return(0)
'Recorre la tabla detalle complementos y aplica un tope por cada concepto SAR_DESCRIPCION diferente que encuentre en el año fiscal.
importe = SAR_IMP_SIMILAR_NAT_OE
indGravado = SAR_OE_SINAT_TRIB
If importe = 0 Then return (0)

'Evalua si corresponde calcular parte exenta
indExento = 0
retrib = SAR_PROM_27617_BONOS

'En paga especial reliq. septiembre, se considera el promedio de la paga normal que origina la retroactividad
If SAR_IND_PAGA_RELIQ = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then retrib = SAR_PROM_BONOS_ULTIMO

vValor = SAR_DED_ESP_INC.SAR_RETORNA_VAL_TRAM(3,SAR_FEC_IMPUT_IG,ID_CURRENCY)
If vValor >= retrib Or indGravado = 2 Then indExento = 1
If indGravado = 1 Then indExento = 0

dif_meses = 0
imp_tot = 0
descripcion = ""
descripcionAnte = ""
gravadoTot = 0
exentoTot = 0
gravado = 0
exento = 0
conteo = 0

If SAR_ES_BAJA = 1 and SAR_IG_DICIEMBRE = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then
    mes_paga_efecti = 12
Else
    mes_paga_efecti = DxMonth(SAR_FEC_IMPUT_IG)
EndIf

'Paga especial de reliquidacion septiembre 2023, se leen complementos hasta septiembre (octubre diferidos), no hasta diciembre como en una reliquidacion de diciembre normal
indReliq = SAR_IND_PAGA_RELIQ
If indReliq = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then indReliq = 0

SAR_DET_COMPLEM_SIRADIG.DESTROYBLOCK()
SAR_DET_COMPLEM_SIRADIG.SAR_ID_HR = SCO_ID_HR
SAR_DET_COMPLEM_SIRADIG.SAR_OR_PERIOD = SCO_OR_HR_PERIOD
SAR_DET_COMPLEM_SIRADIG.SAR_YEAR = SAR_ANIO_IMPUT_IG
SAR_DET_COMPLEM_SIRADIG.SAR_DETAIL = "conSimNatDetalle"

numReg = SAR_DET_COMPLEM_SIRADIG.Count()

For i=0 To numReg-1
    
    If DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_START) <= mes_paga_efecti Then
        descripcion = SAR_DET_COMPLEM_SIRADIG[i].SAR_DESCRIPCION
        
        'Si encontramos un concepto diferente, consolida el exento/gravado del concepto anterior y reinicia el conteo para el nuevo concepto
        If descripcion <> descripcionAnte Then 
            imp_tot = 0
            gravadoTot = gravadoTot + gravado
            exentoTot = exentoTot + exento
            conteo = conteo + 1
        EndIf

        If (mes_paga_efecti <= DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_END))Then
            dif_meses = mes_paga_efecti - DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_START) + 1
            imp_tot = imp_tot + (SAR_DET_COMPLEM_SIRADIG[i].SAR_MONTO * dif_meses)
        Else
            dif_meses = DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_END) - DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_START) + 1 
            imp_tot   = imp_tot + (SAR_DET_COMPLEM_SIRADIG[i].SAR_MONTO * dif_meses)
        EndIf

        'Calcula exento/gravado del concepto en el que nos encontramos
        importe = imp_tot
        topeExento = Percentage(40,SAR_NO_IMP_27617)
       
        gravado = Max(importe - topeExento, 0)
        exento = importe - gravado
        
        descripcionAnte = descripcion
    EndIf
Next

'Al salir del bucle consolidamos el exento/gravado del ultimo concepto encontrado
gravadoTot = gravadoTot + gravado
exentoTot = exentoTot + exento

'Controla si no se informó detalle, pero si importe, entonces se va a contar como un sólo similar nat.
If numReg = 0 Then
    importe = SAR_IMP_SIMILAR_NAT_OE
    topeExento = Percentage(40,SAR_NO_IMP_27617)
    gravadoTot = Max(importe - topeExento, 0)
    exentoTot = importe - gravadoTot
    conteo = 1
EndIf

SAR_CANT_SIMILAR_NAT_OE = conteo

If indExento = 0 Then
    gravadoTot = Round(SAR_IMP_SIMILAR_NAT_OE,SAR_NUM_DEC)
    SAR_SIMILAR_NAT_GRAV_OE = gravadoTot
    Return (gravadoTot)
EndIf

gravadoTot = Round(gravadoTot,SAR_NUM_DEC)
exentoTot = Round (exentoTot,SAR_NUM_DEC)

SAR_SIMILAR_NAT_GRAV_OE = gravadoTot
SAR_SIMILAR_NAT_EXEN_OE = exentoTot

'Calcula aportes de la parte exenta para descontar del total aportes
porcJub = 0
porcLey = 0
If SAR_EDAD >= 18 Then 
    porcJub = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
    porcLey = SAR_PORC_LEY_19032 - (SAR_PORC_LEY_19032 * SAR_PP_AP_INSSJP/100)
EndIf
porcObSoc = SAR_PORC_OBR_SOCIAL -(SAR_PORC_OBR_SOCIAL * SAR_PP_AP_OB_SOC/100)
porcAdObSoc = SAR_PORC_ADIC_O_SOC - (SAR_PORC_ADIC_O_SOC * SAR_PP_AP_OB_SOC/100)
porcSind = SAR_PORC_C_SIND_VOL + SAR_PORC_C_SIND_OBL

apJubExen = Round(Percentage(porcJub,exentoTot),SAR_NUM_DEC)
apLeyExen = Round(Percentage(porcLey,exentoTot),SAR_NUM_DEC)
apAdObSocExen = Round(Percentage(porcAdObSoc,exentoTot) * SAR_FAM_CARGO_OS,SAR_NUM_DEC)
apObSocExen = Round(Percentage(porcObSoc,exentoTot)+apAdObSocExen,SAR_NUM_DEC)
apSindExen = Round(Percentage(porcSind,exentoTot),SAR_NUM_DEC)

SAR_OE_SINAT_JUB = apJubExen
SAR_OE_SINAT_LEY = apLeyExen
SAR_OE_SINAT_OSOC = apObSocExen
SAR_OE_SINAT_SIND = apSindExen

Return(gravadoTot)
