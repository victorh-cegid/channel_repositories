' Vigencia por Decreto 152/2015 (En relación a la aplicacion de deducción por SAC en brutos <= $30000)
' Calculo la fecha de inicio de los seis meses anteriores y la inicio del mes actual
    
FECHA_BASE    = SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC
FECHA_DIA_ANT = FECHA_BASE - 1
MES_ACTUAL    = DXMONTH(FECHA_BASE) 

'Armo los topes para los semestres
If MES_ACTUAL < 12 THEN
    FECHA_TOPE =  TOSTRING(DxYear(FECHA_BASE),0) + "-07" + "-01"
    FECHA_TOPE = ToDate (FECHA_TOPE)
ELSE
    FECHA_TOPE =  TOSTRING(DxYear(FECHA_BASE),0) + "-12" + "-01"
    FECHA_TOPE = ToDate (FECHA_TOPE)
ENDIF

MES_ANT_5 = DxMonth(DateAdd(FECHA_BASE,-5,M4_MONTH))
If MES_ANT_5 < 10 THEN
    MES_ANT_5 = "0" + TOSTRING(MES_ANT_5,0)
ELSE
    MES_ANT_5 = TOSTRING(MES_ANT_5,0)
ENDIF

IF MES_ACTUAL < 10 THEN
    MES_ACTUAL = "0" + TOSTRING(MES_ACTUAL,0)
ELSE
    MES_ACTUAL = TOSTRING(MES_ACTUAL,0)
ENDIF

FECHA_ACT       = TOSTRING(DxYear(FECHA_BASE),0) + "-" + MES_ACTUAL + "-01"
FECHA_INICIO    = ToDate(FECHA_ACT)
FECHA_5_ANT     = TOSTRING(DxYear(DateAdd(FECHA_BASE,-5,M4_MONTH)),0) + "-" + MES_ANT_5 + "-01"
FECHA_ANT_5     = ToDate(FECHA_5_ANT)
FECHA_ANT_4     = DateAdd(FECHA_ANT_5,1,M4_MONTH)
FECHA_ANT_3     = DateAdd(FECHA_ANT_5,2,M4_MONTH)
FECHA_ANT_2     = DateAdd(FECHA_ANT_5,3,M4_MONTH)
FECHA_ANT_1     = DateAdd(FECHA_ANT_5,4,M4_MONTH)
FECHA_ANT_RELIQ = DateAdd(FECHA_ANT_5,5,M4_MONTH)


'Inicializo valores de cada uno de los meses anteriores
valor_act           = SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM) + SAR_BRUTO_OE - SAR_SAC_BRUTO_OE
valor_1             = 0
valor_2             = 0
valor_3             = 0
valor_4             = 0
valor_5             = 0
valor_6             = 0
valor_R             = 0
valor_1_b           = 0
valor_2_b           = 0
valor_3_b           = 0
valor_4_b           = 0
valor_5_b           = 0
valor_R_b           = 0
valor_sac_neto_R    = 0
valor_ig_dec_142aux = 0
Deduccion_Normal    = 0
max                 = 0
    
' Recorro el acumulado del empleado y contabilizo los valores de cada mes anterior
    
    SCO_AC_HR_PERIOD_READ_1.BEGIN()
    ULTIMO_REG_AC = SCO_AC_HR_PERIOD_READ_1.COUNT() - 1

If SCO_AC_HR_PERIOD_READ_1.COUNT() > 0 Then
    FOR I = 0 TO ULTIMO_REG_AC
        SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
        IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_INICIO AND FECHA_INICIO >= FECHA_TOPE AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= FECHA_DIA_ANT THEN
            valor_act = valor_act + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM)

         ELSEIF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_1 AND FECHA_ANT_1 >= FECHA_TOPE AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= DateAdd(FECHA_INICIO,-1,M4_DAY) THEN
            valor_1_b = valor_1_b + SCO_AC_HR_PERIOD_READ_1.SAR_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM) - SCO_AC_HR_PERIOD_READ_1.SAR_SAC_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM)
            valor_1   = valor_1 + valor_1_b + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM) 

         ELSEIF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_2 AND FECHA_ANT_2 >= FECHA_TOPE AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= DateAdd(FECHA_ANT_1,-1,M4_DAY) THEN
            valor_2_b = valor_2_b + SCO_AC_HR_PERIOD_READ_1.SAR_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM) - SCO_AC_HR_PERIOD_READ_1.SAR_SAC_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM)
            valor_2   = valor_2 + valor_2_b + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM) 

         ELSEIF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_3 AND FECHA_ANT_3 >= FECHA_TOPE AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= DateAdd(FECHA_ANT_2,-1,M4_DAY) THEN
            valor_3_b = valor_3_b + SCO_AC_HR_PERIOD_READ_1.SAR_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM) - SCO_AC_HR_PERIOD_READ_1.SAR_SAC_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM)
            valor_3   = valor_3 + valor_3_b + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM)

         ELSEIF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_4 AND FECHA_ANT_4 >= FECHA_TOPE AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= DateAdd(FECHA_ANT_3,-1,M4_DAY) THEN
            valor_4_b = valor_4_b + SCO_AC_HR_PERIOD_READ_1.SAR_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM) - SCO_AC_HR_PERIOD_READ_1.SAR_SAC_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM)
            valor_4   = valor_4 + valor_4_b + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM)

         ELSEIF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_5 AND FECHA_ANT_5 >= FECHA_TOPE AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= DateAdd(FECHA_ANT_4,-1,M4_DAY) THEN
            valor_5_b = valor_5_b + SCO_AC_HR_PERIOD_READ_1.SAR_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM) - SCO_AC_HR_PERIOD_READ_1.SAR_SAC_BRUTO_OE..sysTotalSlices(M4_TOTAL_SUM)
            valor_5   = valor_5 + valor_5_b + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM)

         'Para la paga "99"  obtenemos SAR_SAC_NETO
         ELSEIF SAR_TP_IMPUT = "99" And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FECHA_ANT_RELIQ AND FECHA_ANT_RELIQ >= FECHA_TOPE  THEN
            'valor_sac_neto_R    = valor_sac_neto_R + SCO_AC_HR_PERIOD_READ_1.SAR_SAC_NETO_2015..sysTotalSlices(M4_TOTAL_SUM)            
            valor_ig_dec_142aux = valor_ig_dec_142aux + SCO_AC_HR_PERIOD_READ_1.SAR_IG_DEC142_AUX..sysTotalSlices(M4_TOTAL_SUM)            
         ENDIF
    NEXT


    
    /**** Calculo el mayor total de los seis meses anteriores a la fecha de imputación ****/
    IF valor_act > max THEN
        max = valor_act
    ENDIF
    IF valor_1 > max THEN
        max = valor_1
    ENDIF
    IF valor_2 > max THEN
        max = valor_2
    ENDIF
    IF valor_3 > max THEN
        max = valor_3
    ENDIF
    IF valor_4 > max THEN
        max = valor_4
    ENDIF
    IF valor_5 > max THEN
        max = valor_5
    ENDIF
    valor = max

EndIf

    
'Calculo normal del  concepto de Deducción especial + SAC según se aplique el Decreto 2015.
aux     = SAR_IND_CAMBIO_RANGO
ind     = SAR_IND_DED_IG_2010 
importe = 0

SAR_ACM_ULT_PAGO_IMPUT.Begin()
indic_cambio_rango = SAR_ACM_ULT_PAGO_IMPUT.SAR_IND_CAMBIO_RANGO
ano_pago_ant       = DxYear(SAR_ACM_ULT_PAGO_IMPUT.SAR_FEC_PAGO_IG)
ano_pago_act       = DxYear(SAR_FEC_PAGO_IG)

Rango_Actual  = -1
Rango_Previo  = -1
Zona_Actual   = -1
Zona_Mes      = -1
Zona_Mes_Paga = -1
ID_DMD        = "SAR_INDIC_REDUC_ZON_DES_1"

'se modifica el indicativo de cambio de rango, al cambiar el Año Fiscal.
If ano_pago_ant <> ano_pago_act Then
    indic_cambio_rango   = 0
    SAR_IND_CAMBIO_RANGO = 0
EndIf

RANGO = SAR_RANGO_REM_IG_2015 'Rango normal de la paga
MES_CAMBIO_PREVIO = -1  'Es el mes correspondiente a la zona anterior al cambio de existir. De no existir es -1.
                        'Se pasa como parametro por referencia al metodo SAR_HR_ROLE.SAR_OBTENER_CAMBIO_ZONA.            
                        
Existe_Cambio_zona = SAR_HR_ROLE.SAR_OBTENER_CAMBIO_ZONA(MES_CAMBIO_PREVIO, SCO_DT_ALLOCATION)

If (MES_CAMBIO_PREVIO <> -1) Then
    fecha_tope = SAR_FEC_PAGO_IG
    fecha_ini  = SAR_FEC_INI_IG
    MES        = DXMONTH(fecha_ini)
    IF MES < 10 then
        MES = "0" + TOSTRING(MES,0)
    else
        MES = TOSTRING(MES,0)
    endif
    FECHA = TOSTRING(DXYEAR(fecha_ini),0) + "/" + MES + "/" + "25"
    
    If SAR_IG_DICIEMBRE = 1 and SAR_ES_BAJA = 1 Then
        FEC = TOSTRING(DxYear(fecha_ini),0)
        FEC_PAG = TOSTRING(SAR_PAYS_TO_CALC.SAR_ANIO_PROCESO,0)
        If FEC <> FEC_PAG Then
            FECHA = FEC_PAG + "/" + MES + "/" + "25"
            fecha_ini = TODATE(FECHA)
            fecha_tope =  todate(FEC_PAG + "/" + "12" + "/" + "25")
        EndIf
    Endif
    
    ANIO_PAGA   = TOSTRING(DXYEAR(SCO_DT_ALLOCATION),0)
    FECHA_ENERO = DXDATE("01", "01", ANIO_PAGA)
    
    mini = DXMONTH(fecha_ini)
    ' Fecha para verificar el lugar de trabajo
    vFechaLU = DxDate("25",MES,DxYear(fecha_ini)) 
    
    Zona_Actual = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(SCO_DT_PAYMENT)
    Zona_Actual = ToString(ToDouble(Zona_Actual), 0)
    dias_mes    = DaysOfMonth(fecha_ini)
    DIA         = TOSTRING(dias_mes,0)
    FECHA_LUGAR = DxDate(DIA,MES,DxYear(fecha_ini)) 
    
    ' Cargo la Ti para verIficar si existe algun cambio de lugar de trabajo no informado a tiempo.
    SAR_LUGAR_TRABA_ZONA_DES.begin()
    IntCantRegLugTrab = SAR_LUGAR_TRABA_ZONA_DES.count()
    
    WHILE mini <= DxMonth(fecha_tope) 
        'Toma su valor por valores empresa
        ind       = SAR_IND_DED_IG_2010
        RANGO_792 = SAR_RANGO_REM_IG_2013
        RANGO     = SAR_RANGO_REM_IG_2015
        
        /******************* Verificamos si hay cambio de Rango **********************************/
        If IntCantRegLugTrab > 0 Then      
            vPos = SAR_LUGAR_TRABA_ZONA_DES.FindRegister("SCO_DT_START",FECHA_LUGAR,M4_SMALLER_OR_EQUAL,"SCO_DT_END",FECHA_LUGAR,M4_GREATER_OR_EQUAL)
            If vPos = -1 Then
                If FECHA_LUGAR < SAR_FECHA_ALTA Then
                    dias_mes_alta = DaysOfMonth(SAR_FECHA_ALTA)
                    DIAS_ALTA     = TOSTRING(dias_mes_alta,0)
                    FECHA_ALTA    = DxDate(DIAS_ALTA,DxMonth(SAR_FECHA_ALTA),DxYear(SAR_FECHA_ALTA))
                    vPos_Alta     = SAR_LUGAR_TRABA_ZONA_DES.FindRegister("SCO_DT_START",FECHA_ALTA,M4_SMALLER_OR_EQUAL,"SCO_DT_END",FECHA_ALTA,M4_GREATER_OR_EQUAL)
                                
                    If vPos_Alta <> -1 and SCO_AC_HR_PERIOD_READ_1.count() > 0 Then  
                        If(DxMonth(SCO_DT_PAYMENT) <> DxMonth(SAR_FEC_PAGO_IG))Then
                            If(mini = DxMonth(SAR_FEC_PAGO_IG))Then
                                Zona_Mes = Zona_Mes_Paga
                            Else
                                Zona_Mes = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(FECHA_ALTA)
                                Zona_Mes = ToString(ToDouble(Zona_Mes), 0)
                                Zona_Mes_Paga = Zona_Mes
                            EndIf 
                        Else     
                            Zona_Mes = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(FECHA_ALTA)                   
                            Zona_Mes = ToString(ToDouble(Zona_Mes), 0)
                        EndIf
                                    
                        If(Zona_Mes = "-1")Then
                            Zona_Mes = Zona_Actual
                        EndIf
                                    
                        If(Zona_Mes = Zona_Actual)Then
                            RANGO = SAR_RANGO_REM_IG_2015 'Rango Actual
                        Else
                            RANGO = SAR_RAN_REM_IG_2015_PRE 'Rango Previo
                        EndIf
                    Endif                                                                 
                Endif
            Endif
            
            If vPos <> -1 Then                  
                SAR_LUGAR_TRABA_ZONA_DES.MOVETO(vPos)
                vId_Lug_Trab = SAR_LUGAR_TRABA_ZONA_DES.SCO_ID_WORK_LOCATION
                vFec         = SAR_LUGAR_TRABA_ZONA_DES.SCO_DT_START       
                vPosVal      = SAR_WLOC_VALUES.FindRegister("SCO_ID_WORK_LOCATION", vId_Lug_Trab, M4_EQUAL, "ID_DMD_COMPONENT", ID_DMD, M4_EQUAL, "SCO_DT_START",vFec,M4_EQUAL)
                If vPosVal <> -1 Then
                    SAR_WLOC_VALUES.MOVETO(vPosVal)
                    vIND_DES = SAR_WLOC_VALUES.SCO_VALUE
                Else
                    vIND_DES = 0
                Endif
                   
                SCO_AC_HR_PERIOD_READ_1.Begin()   
                intCountRead = SCO_AC_HR_PERIOD_READ_1.Count()
                If intCountRead > 0 Then  
                    vFechaRead    = vFechaLU
                    vFechaIniPaga = DxDate("01",DxMonth(vFechaRead),Dxyear(vFechaRead))                                
                    vDiaFinPaga   = DaysOfMonth(vFechaRead)
                    vFechaFinPaga = DxDate(vDiaFinPaga,DxMonth(vFechaRead),Dxyear(vFechaRead))
                   
                    If(DxMonth(SCO_DT_PAYMENT) <> DxMonth(SAR_FEC_PAGO_IG))Then
                         If(mini = DxMonth(SAR_FEC_PAGO_IG))Then
                             Zona_Mes = Zona_Mes_Paga
                         Else
                             Zona_Mes = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(vFechaLU)
                             Zona_Mes = ToString(ToDouble(Zona_Mes), 0)
                             Zona_Mes_Paga = Zona_Mes
                         EndIf 
                    Else     
                        Zona_Mes = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(vFechaLU)                   
                        Zona_Mes = ToString(ToDouble(Zona_Mes), 0)
                    EndIf                                        

                    If(Zona_Mes = "-1")Then
                        Zona_Mes = Zona_Actual
                    EndIf

                    If(Zona_Mes = Zona_Actual)Then
                         RANGO = SAR_RANGO_REM_IG_2015 'Rango Actual
                    Else
                         RANGO = SAR_RAN_REM_IG_2015_PRE 'Rango Previo
                    EndIf

                Endif        
            EndIf     
            vFechaLU = DxDate(DxDay(vFechaLU),DxMonth(vFechaLU)+1,DxYear(vFechaLU))
        EndIf                    
                    
        R = TOSTRING(RANGO,0)
       'Calculo de la deducción especial según información recopilada del concepto v793 por Decreto 3770/2015.
        If(RANGO = 3)Then
            precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("98","SAR_DED_ESPECIAL",FECHA_ENERO,ind))
        ElseIf(RANGO = 2)Then
            precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("99","SAR_DED_ESPECIAL",FECHA_ENERO,ind))
        ElseIf(RANGO >= 20 and RANGO <= 25) OR (RANGO >= 30 and RANGO <= 35)Then    
            precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(R,"SAR_DED_ESPECIAL",FECHA_ENERO,ind))
        Else
            precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_DED_ESPECIAL",FECHA_ENERO,ind))
        EndIf
        
        Deduccion_Normal = Deduccion_Normal + precio
      mini    = mini + 1
        mini2   = mini
        
        IF mini < 10 then
            mini2 = "0" + TOSTRING(mini,0)
        else
            mini2 = TOSTRING(mini,0)
        endif
                    
        fecha       = TOSTRING(DXYEAR(fecha_ini),0) + "/" + mini2 + "/" + "25"
        fecha_ini   = TODATE(fecha)
        dias_mes    = DaysOfMonth(fecha_ini)
        DIA         = TOSTRING(dias_mes,0)
        FECHA_LUGAR = DxDate(DIA,mini2,DxYear(fecha_ini)) 
    WEND

Else
    R = TOSTRING(RANGO,0) 
    'Calculo de la ganancia no imponible según información recopilada del concepto v793 por Decreto 3770/2015.
    If (RANGO = 3)Then
        Deduccion_Normal = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("98","SAR_DED_ESPECIAL",SAR_FEC_PAGO_IG,ind))
    ElseIf (RANGO = 2)Then
        Deduccion_Normal = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("99","SAR_DED_ESPECIAL",SAR_FEC_PAGO_IG,ind))
    ElseIf (RANGO >= 20 and RANGO <= 25) OR (RANGO >= 30 and RANGO <= 35)Then    
        Deduccion_Normal = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(R,"SAR_DED_ESPECIAL",SAR_FEC_PAGO_IG,ind))
    Else
        Deduccion_Normal = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_DED_ESPECIAL",SAR_FEC_PAGO_IG,ind))
    EndIf    
 
EndIf

If isNull(Deduccion_Normal) = M4_TRUE Then
    Deduccion_Normal = 0
Endif


If (SAR_TP_IMPUT <> "99") Then
    If (valor <= 30000) Then
       If (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT And DxYear(SCO_DT_PAYMENT) <> 2015 ) Then
          Deduccion = TODOUBLE(Deduccion_Normal) 
       Else
          Deduccion = TODOUBLE(Deduccion_Normal) + SAR_SAC_NETO_2015
       EndIf   
    Else        
        Deduccion = TODOUBLE(Deduccion_Normal) 
        SAR_SAC_NETO_2015 = 0
    EndIf
EndIf


' Solo en la paga de reliquidación del impuesto a las ganancias, sumamos a la deducción especial
If (SAR_TP_IMPUT = "99") Then
    If SAR_RANGO_REM_IG_2013 = 1 Then
        Deduccion = TODOUBLE(Deduccion_Normal) + valor_ig_dec_142aux + valor_sac_neto_R        
    Else
        SAR_AJUSTE_PARA_SAC.Begin()
        valor_sac_neto_R2 = SAR_AJUSTE_PARA_SAC.SAR_SAC_NETO_2015
        Deduccion = TODOUBLE(Deduccion_Normal) + valor_sac_neto_R2
    EndIf
EndIf


RETURN(Deduccion)
