'Retorna el promedio acumulado en la paga normal que origina la retro (la paga normal debe estar acumulada previamente a realizar la retroactiva)
If SAR_IND_PAGA_RELIQ = 0 Or SCO_DT_ALLOCATION <> DxDate(30,9,2023) Then Return(0)

fec_ini = SCO_DT_PAYMENT
fec_fin = SCO_DT_PAYMENT            
SAR_ACM_DYN_DIF.DESTROYBLOCK()
SAR_ACM_DYN_DIF.SCO_DT_PAYMENT = fec_fin
SAR_ACM_DYN_DIF.SCO_DT_START = fec_ini
SAR_ACM_DYN_DIF.SCO_DT_END = fec_fin
SAR_ACM_DYN_DIF.Load_Blk()
promedio = SAR_ACM_DYN_DIF[0].SAR_PROM_27617_SAC2

'Si no encuentra valor en la paga normal (no se ha acumulado previamente), intenta recuperar el ultimo promedio del a?o fiscal.
If promedio <= 0 Then
    ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
    ultFecImput = DxDate(1,1,1800)
    For acum = 0 To ult_reg - 1
        If SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION >= DxDate(1,10,2023) And DxYear(SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG) = 2023 And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT<>"88" Then
            promAcm = SCO_AC_HR_PERIOD_READ_1[acum].SAR_PROM_27617_SAC2
            If promAcm > 0 And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION >= ultFecImput Then
                promedio = promAcm
                ultFecImput = SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION
            EndIf
        EndIf
    Next
EndIf

'Si el promedio sigue siendo 0, recupero el del mes de septiembre
If promedio <= 0 Then promedio = SAR_PROM_27617_SAC2

Return(promedio)
