'prueba
IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR SAR_TP_IMPUT = "77" THEN
    Return(0)
ENDIF
base = SAR_PRESTACION_ART + SAR_TOT_DEV_COTIZ

'D612 2026
If SAR_D612_IND = 1 Then base = base - SAR_D612_TOT_NO_HAB - SAR_D612_LIC_TOT

valor = SAR_PORC_C_SIND_VOL * base / 100

'Horas Extras RG3976
base_extras_trib = SAR_TOT_HS_EX_IG 
base_extras_exen = SAR_TOT_HS_EX_EX_IG
valor_trib = 0
valor_exen = 0
porc = SAR_PORC_C_SIND_VOL

valor_trib = base_extras_trib * porc / 100
valor_exen = base_extras_exen * porc / 100

SAR_C_SIND_VOL_HS_FINDE_TRIB = valor_trib
SAR_C_SIND_VOL_HS_FINDE_EXEN = valor_exen
'Fin Horas Extras RG3976

RETURN(valor)
