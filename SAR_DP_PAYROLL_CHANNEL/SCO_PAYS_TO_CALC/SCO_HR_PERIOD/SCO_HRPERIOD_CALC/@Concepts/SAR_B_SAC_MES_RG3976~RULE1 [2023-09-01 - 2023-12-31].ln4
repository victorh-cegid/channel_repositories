'Este concepto prorratea el importe del SAC tomándolo del total 3700-SAR_TOT_SAC_RG3976 para llevarlo en forma de provisión al impuesto de Ganancias.

'No se calcula en reliquidación ni en paga de Anticipo de Vacaciones.
'Si el empleado es baja no se calcula porque se sumará al impuesto el SAC realmente percibido

'Ley 27617        
indAjusteRetro = SAR_IND_IMPUESTO_RETRO
indAjusteRemun = SAR_IND_AJUSTE_REMUN_27617

topeExen = SAR_TOPE_DEI
If DxYear(SAR_FEC_IMPUT_IG)>2023 Then topeExen = SAR_TOPE_SAC

'DEC 473/2023, se considera el promedio del semestre por devengado
ajusteSep = SAR_SEP23_SAC_BRUTO_AJ
If DxMonth(SCO_DT_ALLOCATION) < 7 Then
    remun_prom = SAR_PROM_27617_SAC1
Else
    remun_prom = SAR_PROM_27617_SAC2
EndIf

'indAjusteRemun = 1 remuneración y promedio se miran por criterio percibido
If indAjusteRemun = 1 Then
    remun_mes = SAR_REM_27617_DEI_PERC
    fec_ded = SAR_FEC_IMPUT_IG
'indAjusteRemun = 0 remuneración y promedio se miran por criterio devengado (excepto jornalizados)
Else
    If SAR_TIPO_SALARIO = "003" Then
        remun_mes = SAR_TOT_REMUN_27617
        fec_ded = SAR_FEC_IMPUT_IG 'Se mantiene fecha IG por coherencia de cálculo en jornalizados, cambiar por SCO_DT_ALLOCATION si se considera que debe levantarse el dato por devengado
    Else
        remun_mes = SAR_REM_27617_DEI_DEV
        fec_ded = SCO_DT_ALLOCATION
        'Diferidos diciembre 2020 IG 2021 debe calcular deducción
        If indAjusteRetro = 2 And DxYear(SAR_FEC_IMPUT_IG) > DxYear(SCO_DT_ALLOCATION) Then fec_ded = SAR_FEC_IMPUT_IG
    EndIf
EndIf
retrib = Min(remun_mes,remun_prom)

vTramo = 0
If retrib <= topeExen Then vTramo = 1

'Impuesto cedular 2024 siempre calcula 12ava
If SAR_CEDU_IND_IMPUESTO = 1 Then vTramo = 0

haberes_paga = SAR_TOT_SAC_RG3976 'Total haberes de la paga actual.

If vTramo = 1 Then haberes_paga = 0

sac_mensual = haberes_paga / 12
sac_mensual = sac_mensual - ajusteSep

'Control retroactividad reliquidación anual 2023 no genere diferencias en el acumulado
If SCO_PAYS_TO_CALC.SCO_PAY_TYPE_PAYM = "99" And DxYear(SAR_FEC_PAGO_IG) = 2023 And DxYear(SCO_DT_ALLOCATION) = 2023 And DxMonth(SAR_FEC_PAGO_IG) = 12 Then
    sac_mensual = SAR_AC_SAC_REV[0].SAR_B_SAC_MES_RG3976
    Return(sac_mensual)
EndIf

If SAR_TP_IMPUT = "99" OR SAR_TP_IMPUT = "88" OR SAR_ES_BAJA = 1 Or SAR_IND_AJUSTE_SAC = 1 Then Return(0)

'Control retroactividad años anteriores: No genera diferencias en el acumulado, son para el siguiente año fiscal.
If DxYear(SAR_FEC_PAGO_IG)>DxYear(SAR_FEC_IMPUT_IG) Then sac_mensual = SAR_AC_SAC_REV[0].SAR_B_SAC_MES_RG3976

'Control retroactividad a 12avas de SAC1 desde pagas posteriores a junio --> no se calculan porque ya se han pagado y ajustado 12avas de SAC1.
If DxYear(SAR_FEC_IMPUT_IG) = 2024 Then
    fechaTope = DxDate(30,6,2024)
    If SCO_DT_ALLOCATION <> SCO_DT_PAYMENT And SCO_DT_ALLOCATION <= fechaTope And SCO_DT_PAYMENT > fechaTope Then sac_mensual = SCO_AC_HR_PERIOD_REV_1.SAR_B_SAC_MES_RG3976
EndIf

Return(sac_mensual)
