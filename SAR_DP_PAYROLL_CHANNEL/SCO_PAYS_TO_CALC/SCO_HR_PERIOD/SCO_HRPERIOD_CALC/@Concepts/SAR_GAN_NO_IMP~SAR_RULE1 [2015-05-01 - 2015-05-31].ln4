'--------------------------------------------------------
'----1: <= 15000 Empresa 001
'----2: >15000 y <= 25000 Empresa 99
'----0: > 2500 Empresa 001
'----3: > 15000 Empresa 98
'--------------------------------------------------------

'Cambio Ganancias Res.3770/2015
'--------------------------------------------------------------------------------------------------------------------------------
'El concepto v57 recibe la empresa con la que buscara la informacion en la tabla de valor empresa segun el rango correspondiente.
'--------------------------------------------------------------------------------------------------------------------------------
ind = SAR_IND_DED_IG_2010

aux = SAR_RANGO_REM_IG_2015


RETURN(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SAR_LEG_TABLA_IG,"SAR_GAN_NO_IMP",SAR_FEC_PAGO_IG,ind))
