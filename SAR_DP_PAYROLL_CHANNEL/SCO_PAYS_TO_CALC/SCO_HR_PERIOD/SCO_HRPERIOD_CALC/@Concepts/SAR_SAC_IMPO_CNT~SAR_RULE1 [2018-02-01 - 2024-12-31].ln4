'De acuerdo al artículo 3° el decreto 491/04 desde el 01/10/05 no hay topes para 
'el cálculo de la base imponible de las contribuciones.

base = SAR_TOT_SAC_COTIZ

'Ley 27430
reduc_impo = 0
If SAR_DIAS_NORM_SUELD > 0 Then
    reduc_impo = SAR_REDUC_IMPO_SAC
    unid_base = SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2 + SAR_U_EGRESO_PAGA_1 + SAR_U_EGRESO_PAGA_2
    reduc_impo = reduc_impo * unid_base
EndIf
base = base - reduc_impo
base = max(base,0)
'Fin Ley 27430

Return(base)
