edad = SAR_EDAD
base = SAR_REM_IMPO_JUB - SAR_BASE_PRORRAT - SAR_ACCIDENTE
valor = 0

IF edad >= 18 THEN
    porc = SAR_PORC_JUBILACION -  (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
    valor = base * porc / 100

    'Dec 792 compensacion exenta de aporte
    If SAR_IND_OP_DEC792 = 0 Then
        If SAR_TIPO_SALARIO = "003" Then
            descDec = Percentage(SAR_PORC_JUBILACION,SAR_IMP_DEC792_NRED)
            valor = Max(valor - descDec,0)
        Else
            tope_diario_jub = SAR_TOPE_JUBIL/SAR_DIAS_NORM_COTIZ
            tope_jub_dec792 = tope_diario_jub * (SAR_DIAS_DEC792+SAR_DIAS_MATERN+SAR_LIC_ONCO_DIAS) 'proporcionamos el tope de jubilación por los días de decreto 792    
            valor = valor - Percentage(SAR_PORC_JUBILACION,Min(SAR_IMP_DEC792_NRED,tope_jub_dec792))
        EndIf
    EndIf

ENDIF

RETURN(valor)
