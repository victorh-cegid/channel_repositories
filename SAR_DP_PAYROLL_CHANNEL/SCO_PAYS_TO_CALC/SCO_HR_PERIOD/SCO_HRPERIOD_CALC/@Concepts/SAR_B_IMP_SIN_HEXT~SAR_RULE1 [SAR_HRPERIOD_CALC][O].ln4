'Agregado RG3976/RG4003- tratamiento de Horas extras 
base = SAR_BASE_IMPUESTO

'Ley de bases, desde 2024 se toma la base de impuesto sin horas extra
If DxYear(SAR_FEC_IMPUT_IG) > 2023 Then Return base

tot_Hs_extras_trib = SAR_TOT_HS_EX_IG + SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_HS_EX_IG
tot_jub_trib = SAR_JUB_HS_FINDE_TRIB + SAR_ACM_IG_ANIO_IMPUT[0].SAR_JUB_HS_FINDE_TRIB
tot_ley_19032_trib = SAR_L19032_HS_FINDE_TRIB + SAR_ACM_IG_ANIO_IMPUT[0].SAR_L19032_HS_FINDE_TRIB
tot_ob_soc_trib = SAR_OBR_HS_FINDE_TRIB + SAR_AD_OBR_HS_FINDE_TRIB + SAR_ACM_IG_ANIO_IMPUT[0].SAR_OBR_HS_FINDE_TRIB + SAR_ACM_IG_ANIO_IMPUT[0].SAR_AD_OBR_HS_FINDE_TRIB
tot_cuo_sind_trib = SAR_C_SIND_OB_HS_FINDE_TRIB + SAR_C_SIND_VOL_HS_FINDE_TRIB + SAR_ACM_IG_ANIO_IMPUT[0].SAR_C_SIND_OB_HS_FINDE_TRIB + SAR_ACM_IG_ANIO_IMPUT[0].SAR_C_SIND_VOL_HS_FINDE_TRIB

Hs_extras_trib_netas = tot_Hs_extras_trib - ( tot_jub_trib + tot_ley_19032_trib + tot_ob_soc_trib +  tot_cuo_sind_trib)
ajustes_extras_trib_netas = SAR_AJUSTE_HS_TRIBUTABLES - SAR_AJ_DESC_LEY_HS_TRIB 'horas extra netas tributables que se han grabado por incidencia en los cptos de ajuste
base_sin_hs_extras = base - Hs_extras_trib_netas - ajustes_extras_trib_netas

'Impuesto cedular no descuenta horas extra
If SAR_CEDU_IND_IMPUESTO = 1 Then base_sin_hs_extras = base - tot_Hs_extras_trib - SAR_AJUSTE_HS_TRIBUTABLES

Return(base_sin_hs_extras)
