'Antes de realizar cualquier calculo se verifica que la empresa haga la retencion correspondiente a ganancias:
If (SAR_IND_NO_RET_GAN = 1) Then 
    Return(0)
EndIf 

'Antes de realizar cualquier calculo del impuesto verificamos que la modificacion se realizo a fin del mes
'de la paga para de esta forma dejar el calculo al nuevo periodo.
If (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017")Then
    dia_no_5010 = DXDAY(SAR_FECHA_BAJA)'Trabajamos con la fecha de baja pues SAR_ES_BAJA = 1
    mes_no_5010 = DXMONTH(SAR_FECHA_BAJA)
    If (mes_no_5010 = 1 Or mes_no_5010 = 3 Or mes_no_5010 = 5 Or mes_no_5010 = 7 Or mes_no_5010 = 8 Or mes_no_5010 = 10 Or mes_no_5010 = 12)Then 
        If(dia_no_5010 <> 31)Then 
            Return(0)
        EndIf  
    ElseIf (mes_no_5010 = 4 Or mes_no_5010 = 6 Or mes_no_5010 = 9 Or mes_no_5010 = 11 )Then 
        If(dia_no_5010 <> 30)Then 
            Return(0)
        EndIf   
    ElseIf (mes_no_5010 = 2)Then 
        If(dia_no_5010 < 28)Then 
            Return(0)
        EndIf   
    EndIf   
EndIf

IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

If(SAR_PAYS_TO_CALC.SAR_REVISION = 1 And (SAR_ES_BAJA = 0 Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017")))Then
     Valor = SCO_AC_HR_PERIOD_REV_1.SAR_IMPUESTO
     Return(Valor)
ElseIF (SAR_ES_BAJA = 0 Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017")) and (SAR_FECHA_BAJA < SCO_DT_ALLOCATION)  and (SAR_IMPUESTO_TOTAL = 0)Then    'condicion para Nomina despues de la baja
     RETURN(0)
EndIf  
  

'Inicializo variables 
sar_acum_imp_ant_emp = 0
sar_acum_imp_oe      = 0

v1       = SAR_IMPUESTO_TOTAL
v2       = 0
v3       = SAR_IMP_ANT_EMP
v4       = 0
v5       = 0
v6       = SAR_IMP_OTROS_EMP
base     = 0
Tope     = 0
ig_total = 0
SAR_SALD_RET_G_ANT    = 0
sal_ant  = 0
sal_ant_extra = 0

'valores acumulados del mes
vTotal_Dev       = 0
vBruto_OE        = 0
vREM_26341       = 0
vAJUSTE_SAL_FAM  = 0
vASIGNAC_HIJOS   = 0
vASIG_HIJOS_INC  = 0
vASIG_PRENATAL   = 0
vAYUDA_ESC_PRIM  = 0
vAY_ESC_PRIM_INC = 0
vAS_REM_26341_ST = 0
vTotal_ret_mes = 0

'Recorro acumulado de lectura para armar las TI de IG
SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()

I = ULTIMO_REG - 1
WHILE I >= 0 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
    ' Armo los datos para SAR_ACM_IMPUESTO
    
        'Decreto 1242/2013 - No se toma en cuenta la paga extra de la devolucion del impuesto.
        IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG >= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
            v2 = v2 + SCO_AC_HR_PERIOD_READ_1.SAR_ACM_IMPUESTO   
        ENDIF

        'Armo los datos para SAR_REV_ACM_IMPUESTO2
         IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <> SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SAR_FEC_PAGO_IG = SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
             v5 = v5 + SCO_AC_HR_PERIOD_READ_1.SAR_IMPUESTO             
         ENDIF
     
        'Armo los datos para REV_ACM_IMPUESTO
        IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_DT_ALLOCATION AND SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG < SAR_FEC_PAGO_IG THEN 
            v4 = v4 + SCO_AC_HR_PERIOD_READ_1.SAR_IMPUESTO                
        ENDIF
         
        IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG And SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION   THEN 
            sar_acum_imp_ant_emp = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_ANT_EMP
            sar_acum_imp_oe      = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_OTROS_EMP
        ENDIF
        
       
        Mes_ig   = TOSTRING(DXMONTH(SAR_FEC_PAGO_IG),0)
        Anio_ig   = TOSTRING(DXYEAR(SAR_FEC_PAGO_IG),0)
        fec_inicio_mes_paga_ig = DXDATE("01", Mes_ig, Anio_ig)                     

        IF fec_inicio_mes_paga_ig <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG >= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SCO_AC_HR_PERIOD_READ_1.SAR_TP_IMPUT <> "88" THEN 
            vTotal_Dev       = vTotal_Dev + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_DEVENGOS
            vBruto_OE        = vBruto_OE + SCO_AC_HR_PERIOD_READ_1.SAR_BRUTO_OE
            vREM_26341       = vREM_26341 + SCO_AC_HR_PERIOD_READ_1.SAR_TI_REM_26341_ST
            vAJUSTE_SAL_FAM  = vAJUSTE_SAL_FAM + SCO_AC_HR_PERIOD_READ_1.SAR_AJUSTE_SAL_FAM
            vASIGNAC_HIJOS   = vASIGNAC_HIJOS + SCO_AC_HR_PERIOD_READ_1.SAR_ASIGNAC_HIJOS
            vASIG_HIJOS_INC  = vASIG_HIJOS_INC + SCO_AC_HR_PERIOD_READ_1.SAR_ASIG_HIJOS_INC
            vASIG_PRENATAL   = vASIG_PRENATAL + SCO_AC_HR_PERIOD_READ_1.SAR_ASIG_PRENATAL
            vAYUDA_ESC_PRIM  = vAYUDA_ESC_PRIM + SCO_AC_HR_PERIOD_READ_1.SAR_AYUDA_ESC_PRIM
            vAY_ESC_PRIM_INC = vAY_ESC_PRIM_INC + SCO_AC_HR_PERIOD_READ_1.SAR_AY_ESC_PRIM_INC
            vAS_REM_26341_ST = vAS_REM_26341_ST + SCO_AC_HR_PERIOD_READ_1.SAR_AS_REM_26341_ST
            
            vTotal_ret_mes = vTotal_ret_mes + SCO_AC_HR_PERIOD_READ_1.SAR_ACM_IMPUESTO 
        ENDIF    
    
    I = I - 1
Wend
   
'REVISION:
If (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) Then
    v3 = sar_acum_imp_ant_emp
    v6 = sar_acum_imp_oe
Else
    v3 = v3 - sar_acum_imp_ant_emp
    v6 = v6 - sar_acum_imp_oe
EndIf

'-----------------------------------------------------------------------
IF ISNULL(v1) = TRUE THEN
    v1 = 0 
ENDIF
IF ISNULL(v2) = TRUE THEN
    v2 = 0 
ENDIF
IF ISNULL(v3) = TRUE THEN
    v3 = 0 
ENDIF
IF ISNULL(v4) = TRUE THEN
    v4 = 0 
ENDIF
IF ISNULL(v5) = TRUE THEN
    v5 = 0 
ENDIF

IF ISNULL(v6) = TRUE THEN
    v6 = 0 
ENDIF

valor_beneficio = SAR_BENEF_SAC_IG
val_paga_original = 0
'En caso de bajas retroactivas,se debe disminuir el valor del beneficio con el valor de la paga original,
'debido a que el valor del mismo fue alterado por este valor en su regla. 
'Este condicionamiento se debe a la configuracion del concepto c5440 en su comportamiento en retro.
'--------------------------------------------------------------------------------------------------------------------------------------- 
IF (SCO_DT_PAYMENT <> SCO_DT_ALLOCATION and SAR_ES_BAJA = 1) THEN
        SCO_AC_HR_PERIOD_READ_1.BEGIN()
    ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()- 1
    FOR I = 0 TO ULTIMO_REG 
       SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
       IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT = SCO_DT_ALLOCATION AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_DT_ALLOCATION THEN
              val_paga_original = SCO_AC_HR_PERIOD_READ_1.SAR_BENEF_SAC_IG
       ENDIF
    NEXT
valor_beneficio = valor_beneficio - val_paga_original
Endif
'--------------------------------------------------------------------------------------------------------------------------------------- 

'Se contabiliza el beneficio correspondiente a Devolucion IG SAC Ley 27.260, Art. 63
valor = v1 - (v2 + v3 + v6) + v4 - v5 - SAR_IMP_DEB_BAN - valor_beneficio
 
'--------------------------------------------------------------------------------------------------------

'Se agrega el valor del mes para el calculo del top del 35%, para casos con pagas extras.
vBase =  (vTotal_Dev + vBruto_OE) - vREM_26341 - vAJUSTE_SAL_FAM - vASIGNAC_HIJOS - vASIG_HIJOS_INC - vASIG_PRENATAL - vAYUDA_ESC_PRIM - vAY_ESC_PRIM_INC - vAS_REM_26341_ST
base = (SAR_TOTAL_DEVENGOS + SAR_BRUTO_OE) - SAR_TI_REM_26341_ST - SAR_AJUSTE_SAL_FAM - SAR_ASIGNAC_HIJOS - SAR_ASIG_HIJOS_INC - SAR_ASIG_PRENATAL - SAR_AYUDA_ESC_PRIM - SAR_AY_ESC_PRIM_INC - SAR_AS_REM_26341_ST

'Se agrega el valor del mes para el calculo del top del 35%, para casos con pagas extras.
Tope = (base + vBase) * SAR_PP_RET_GAN_ST/100

 
'Si es baja y su retencion excede el tope permitido generamos la diferencia
'Se agrega el Ind. Tope 35% segun RG 2507/2008
if (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Then
    If SAR_IND_APLIC_TOPE_35 = 1 Then 
    
        'control de tope del 35% del mes
        '--------------------------------------
        valor_imp_mes = valor + vTotal_ret_mes
        '-------------------------------------- 
        
        if valor_imp_mes > tope then
            ret_pediente = valor_imp_mes - tope 'saldo de retencion pendiente
             beneficio_sac = SAR_BENEF_SAC_IG
            
            if beneficio_sac <>0 Then            
                dif_retpend_benef = ret_pediente + beneficio_sac 'diferencia entre la retencion pendiente y el beneficio              
                'Se aplica el beneficio correspondiente a Devolucion IG SAC Ley 27.260 Art. 63, al saldo pendiente de retencion.     
                if dif_retpend_benef >= 0 then 'la retencion pendiente supera el beneficio
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG_P_TOPE", 0, beneficio_sac)
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG", 0, 0)
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_SALD_RET_GAN_ST", 0, dif_retpend_benef)
                else
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG", 0, dif_retpend_benef)
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_SALD_RET_GAN_ST", 0, 0)
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG_P_TOPE", 0, ret_pediente * (-1))
                endif
            Else
                SAR_SALD_RET_GAN_ST = ret_pediente
            Endif 
            tope = tope - vTotal_ret_mes
            return(ROUND(tope,2)) 
        else
            return(ROUND(valor,2))
        endif
    Else   
        return(ROUND(valor,2))
    EndIf  
EndIf
' Fin baja


'-----------------------------------------------------------------------------
'Segun lo dispuesto por la RG Afip 3831/16 se adiciona el prorrateo
'correspondiente al recalculo del impuesto, a raiz del cambio en los
'importes de las deducciones a valores de Enero 2016 - Dto.394/2016.
'Esto aplica para empleados con beneficio del dto.1242/2013 y que 
'se encontraban en el rango 1, exceptuados de la retencion.
'------------------------------------------------------------------------------
IF SAR_TP_IMPUT = "4" or SAR_TP_IMPUT = "3" or SAR_TIPO_SALARIO = "003" THEN
    SAR_ACM_PAG_QUIN_1RA.BEGIN()
    saldo_1q = 0
    saldo_2q = 0
    IF SAR_ACM_PAG_QUIN_1RA.COUNT() > 0 THEN
        saldo_1q = SAR_ACM_PAG_QUIN_1RA.SAR_SALDO_RET_RG3831
    ENDIF

    SAR_ACM_2QNA_MES_ANT.BEGIN()
    IF SAR_ACM_2QNA_MES_ANT.COUNT() > 0 THEN
        saldo_2q = SAR_ACM_2QNA_MES_ANT.SAR_SALDO_RET_RG3831
    ENDIF
ENDIF


/** **/
If SAR_TP_IMPUT = "2" Then
    SCO_AC_HR_PERIOD_READ_1.Begin()
    IntCount = SCO_AC_HR_PERIOD_READ_1.Count()
    
    If IntCount > 0 Then
        For I = 0 To IntCount -1
            SCO_AC_HR_PERIOD_READ_1.MoveTo(I)
            
            FechaIni  = Dxdate("01",DxMonth(SCO_DT_ALLOCATION),DxYear(SCO_DT_ALLOCATION)) 
            intFinMes = DaysOfMonth(SCO_DT_ALLOCATION)
            FechaFin  = Dxdate(intFinMes,DxMonth(SCO_DT_ALLOCATION),DxYear(SCO_DT_ALLOCATION))
            
            If FechaIni <= SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT And FechaFin >= SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT Then
                If SCO_AC_HR_PERIOD_READ_1.SAR_SALDO_RET_RG3831 > 0 And SCO_AC_HR_PERIOD_READ_1.SAR_TP_IMPUT <> "2" Then
                    sal_ant_extra = SCO_AC_HR_PERIOD_READ_1.SAR_SALDO_RET_RG3831
                EndIf
            EndIf                
        Next
    EndIf
EndIf

'Caso Rango 1
mes_pago = DxMonth(SCO_DT_ALLOCATION)
If (SAR_CUOTA_RET_RG3831 > 0 OR SAR_CUOTA_N_RET_RG3831 > 0) OR ( saldo_2q > 0 or saldo_1q > 0) Or (SAR_TP_IMPUT = "2") Then
    IF (valor < SAR_REC_BAS_IMP_RG3831) and SAR_REC_BAS_IMP_RG3831 > 0 Then
        valor = SAR_CUOTA_RET_RG3831
    ELSE
      IF SAR_TIPO_SALARIO = "001" Then
        IF (SAR_TP_IMPUT = "1") OR (sal_ant_extra > 0 and SAR_TP_IMPUT = "2")  then 
            valor = valor - (SAR_SALDO_RET_RG3831 + sal_ant_extra) + SAR_CUOTA_RET_RG3831   
            If valor < 0 Then
                valor = 0
            Endif            
            sal_ant   = SAR_SALDO_RET_RG3831
            cuota_pro = SAR_CUOTA_RET_RG3831           
            
            IF  sal_ant > 0 and SAR_REC_BAS_IMP_RG3831 = 0 Then
                sal = Round(sal_ant - cuota_pro,2)
                SAR_SALDO_RET_RG3831 = sal
            ENDIF
        EndIf    
      Else        
            IF mes_pago = 3 Then
                IF SAR_TP_IMPUT = "3" Then                
                   valor = valor - SAR_REC_BAS_IMP_RG3831 + SAR_CUOTA_RET_RG3831                    
                Elseif SAR_TP_IMPUT = "4" Then                                     
                    SAR_HT_PAYS.BEGIN()
                    sal_ant   = (SAR_SALDO_RET_RG3831 + sal_ant_extra) 
                    cuota_pro = SAR_CUOTA_RET_RG3831
                    valor     = valor - sal_ant + cuota_pro  
                    
                    If SAR_FEC_PAGO_IG > SAR_HT_PAYS.SCO_DT_END Then
                        sal = Round(sal_ant - cuota_pro,2)
                        SAR_SALDO_RET_RG3831 = sal
                    Else    
                        SAR_SALDO_RET_RG3831 = 0
                    Endif  
                EndIf
            Else 
                If  mes_pago >= 4 Then
                    IF SAR_TP_IMPUT = "3" or  SAR_TP_IMPUT = "2"  Then
                        sal_ant = saldo_2q
                        valor   = valor - sal_ant                        
                        SAR_SALDO_RET_RG3831 = 0

                    ElseIf SAR_TP_IMPUT = "4" Then
                        valor     = valor - (SAR_SALDO_RET_RG3831)  + SAR_CUOTA_RET_RG3831      
                        sal_ant   = SAR_SALDO_RET_RG3831                        
                        cuota_pro = SAR_CUOTA_RET_RG3831
                        
                        If sal_ant > 0 and SAR_REC_BAS_IMP_RG3831 = 0 Then
                            sal = Round(sal_ant - cuota_pro,2)
                            SAR_SALDO_RET_RG3831 = sal
                        EndIf
                    EndIf
                EndIf
            Endif
      EndIf
    EndIf
EndIf

'control de tope del 35% del mes
'--------------------------------------
valor_imp_mes = valor + vTotal_ret_mes
'--------------------------------------

if valor_imp_mes <= tope Then
     SAR_SALD_RET_GAN_ST=0
     return(ROUND(valor,2))
else 'Modificacion de acuerdo a Devolucion IG SAC Ley 27.260, Art. 63
    ret_pediente = valor_imp_mes - tope  'saldo de retencion pendiente
    beneficio_sac = SAR_BENEF_SAC_IG
    
    if beneficio_sac <> 0 Then
        dif_retpend_benef = ret_pediente + beneficio_sac 'diferencia entre la retencion pendiente y el beneficio
        'Se aplica el beneficio correspondiente a Devolucion IG SAC Ley 27.260 Art. 63, al saldo pendiente de retencion.    
        if dif_retpend_benef >= 0 then 'la retencion pendiente supera el beneficio
            SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG_P_TOPE", 0, beneficio_sac)
            SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG", 0, 0)
            SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_SALD_RET_GAN_ST", 0, dif_retpend_benef)
        else
        	SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG", 0, dif_retpend_benef)
            SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_SALD_RET_GAN_ST", 0, 0)
        	SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG_P_TOPE", 0, ret_pediente * (-1))
        endif
    Else
        SAR_SALD_RET_GAN_ST = ret_pediente
    Endif
    tope = tope - vTotal_ret_mes
    Return(ROUND(tope,2))
endif
  
Return(ROUND(valor,2))
