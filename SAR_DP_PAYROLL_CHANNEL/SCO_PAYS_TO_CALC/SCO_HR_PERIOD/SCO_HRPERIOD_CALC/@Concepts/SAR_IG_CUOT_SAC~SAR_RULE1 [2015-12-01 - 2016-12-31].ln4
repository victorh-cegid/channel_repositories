'No se calcula en reliquidacion ni en paga de Vacaciones/Anticipo:
If SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" or SAR_TP_IMPUT = "99" Then Return(0)

'No se ejecuta en la primera quincena
IF (SAR_TP_IMPUT = "3" AND SAR_ES_BAJA = 0 AND SAR_IND_AGUINALDO = 0) THEN RETURN (0)

IF (SAR_TP_IMPUT = "4" AND (SAR_IND_AGUINALDO = 0 AND SAR_U_PAGA_AJ_EX_1 = 0) AND DxMonth(SCO_DT_PAYMENT) = 6) THEN RETURN (0)

' No se ejecuta en las pagas extras, salvo si en las Pagas Extras de Aguinaldo
If (SAR_TP_IMPUT = "2") AND (SAR_IND_AGUINALDO = 0 And SAR_PAGA_AJ_EXTRA_SAC = 0) Then Return(0)  

SAR_PAGA_ACTUAL_IMPUT.BEGIN()

SAR_SAC_PRORR_ANT.BEGIN()
Diferida = 0

If (DxMonth(SAR_SAC_PRORR_ANT.SAR_FECHA_BASE) <> DxMonth(SAR_SAC_PRORR_ANT.SAR_FEC_PAGO_IG)) And (DxMonth(SCO_DT_PAYMENT) = DxMonth(SAR_FEC_PAGO_IG)) Then
   Diferida = 1
EndIf

IF (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) THEN
    mes = DxMonth(SAR_PAGA_ACTUAL_IMPUT.SAR_FECHA_PAGO_IG)
ELSE
    If (DxMonth(SCO_DT_PAYMENT) = 6 And (Diferida = 1)) Then
       mes = SAR_MES_PAGO_IG + 1
    Else
       mes = SAR_MES_PAGO_IG
    EndIf    
EndIf

dif = 0
saldo = 0
cuota_ant = 0
base = 0
cuota = 0
meses_quedan = 0
base_1q =0

' No se debe tomar el valor de la cuota en Paga Extra de Diciembre de Aguinaldo.
If (SAR_TP_IMPUT = "2" And (DxMonth(SCO_DT_PAYMENT) = 12 Or DxMonth(SCO_DT_PAYMENT) = 6) And (SAR_IND_AGUINALDO = 1 Or SAR_PAGA_AJ_EXTRA_SAC <> 0))Then
    cuota_ant = 0
Else
    IF (mes > 1 And (DxMonth(SCO_DT_PAYMENT) = DxMonth(SAR_FEC_PAGO_IG))) Or (mes >= 2 And (DxMonth(SCO_DT_PAYMENT) <> DxMonth(SAR_FEC_PAGO_IG))) THEN
        SAR_ACM_ULT_MES.BEGIN()
        saldo     = SAR_ACM_ULT_MES.SAR_IG_SALDO_SAC 
        cuota_ant = SAR_ACM_ULT_MES.SAR_IG_CUOT_SAC 
        sal_ajus  = SAR_ACM_ULT_MES.SAR_PAGA_EXTRA_AJ_1
    ENDIF

    'En pagas diferidas si existe ajuste este se debe prorratear en 12 cuotas iguales.
    If (((DxMonth(SCO_DT_PAYMENT) <> DxMonth(SAR_FEC_PAGO_IG)) And sal_ajus > 0) and mes = 12 )Then 
       cuota_ant = sal_ajus / 12
    ElseIF saldo < cuota_ant THEN
       cuota_ant = saldo
    ENDIF
EndIf

IF (SAR_ES_BAJA = 1) Then
    If(SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" ) Then
        dia_baja = DXDAY(SAR_FECHA_BAJA) 
        mes_baja = DXMONTH(SAR_FECHA_BAJA) 
        If mes_baja = 2 Then  
            If (dia_baja < 28 And DaysOfMonth(2) = 28) Then  
                Return(0)
            EndIf  
        Else  
            If (dia_baja < 29 And DaysOfMonth(2) = 29) Then  
                Return(0)
            EndIf  
        EndIf
        If mes_baja = 1 Or mes_baja = 3 Or mes_baja = 5 Or mes_baja = 7 Or mes_baja = 8 Or mes_baja = 10 Or mes_baja = 12 Then  
            If dia_baja < 31 Then  
                Return(0)
            EndIf  
        EndIf
        If mes_baja = 4 Or mes_baja = 6 Or mes_baja = 9 Or mes_baja = 11  Then  
            If dia_baja < 30 Then  
                Return(0)
            EndIf  
        EndIf
    EndIf
EndIf

'Por modificacion del empleado se agrego: SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017"
IF ((SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") OR mes = 12 ) THEN 
     RETURN(SAR_TOT_PROR_SAC + saldo)
ENDIF

IF SCO_DT_ALLOCATION <> SCO_DT_PAYMENT THEN
   dif = SAR_TOT_PROR_SAC - SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_SAC
   IF dif >= 0 THEN
      aux = SAR_PAGA_ACTUAL_IMPUT.SAR_IG_CUOT_SAC
      SAR_IG_SAC_AD = dif
      RETURN(aux)
   ELSE   
     base = SAR_TOT_PROR_SAC
   ENDIF
ELSE
    SAR_INCRE_PRORRATEOS.BEGIN()
    
    If (SAR_TP_IMPUT = "4") AND (SAR_IND_AGUINALDO = 0 And (SAR_U_PAGA_AJ_EX_1 = 0 AND SAR_U_PAGA_AJ_EX_2 = 0))Then 
        base_1q = SAR_ACM_PAG_QUIN_1RA.SAR_TOT_PROR_SAC
        base = base_1q + SAR_INCRE_PRORRATEOS.SAR_IG_SAC_AD 
    Else
        base = SAR_TOT_PROR_SAC + SAR_INCRE_PRORRATEOS.SAR_IG_SAC_AD
    EndIf 
ENDIF

'Prorrateo en pagas diferidas con ajuste.
IF base > 0 THEN
    IF (mes < 6 And (DxMonth(SCO_DT_PAYMENT) = DxMonth(SAR_FEC_PAGO_IG))) THEN
        Return(base)
    EndIf    
ENDIF

meses_quedan = 12 - mes + 1

IF meses_quedan > 0 THEN
    IF meses_quedan = 0 THEN
        cuota = 0
    ELSE
        cuota = base / meses_quedan 
    ENDIF
ELSE
    cuota = base
ENDIF

IF ISNULL(cuota) = TRUE THEN
    cuota = 0
ENDIF

IF saldo = 0 THEN
   RETURN(cuota)
ELSE
    IF ISNULL(cuota_ant) = TRUE THEN
        cuota_ant = 0
    ENDIF
    
    RETURN(cuota + cuota_ant)
ENDIF
