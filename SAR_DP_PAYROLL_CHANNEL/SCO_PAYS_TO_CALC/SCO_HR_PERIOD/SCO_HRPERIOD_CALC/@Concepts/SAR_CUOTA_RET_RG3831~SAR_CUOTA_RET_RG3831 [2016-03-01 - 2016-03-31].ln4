'Solo se debe calcular en paga normal.
IF SAR_TP_IMPUT = "2" OR SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN Return(0)
IF SAR_MES_PAGO_IG = 1  THEN Return(0)

'-------------------------------------------------------------------------------
'Se determina el valor de la cuota a prorratear de acuerdo a los meses 
'restantes, tomando como referncia el mes de la fecha de pago IG, ante
'la posibilidad de fechas de pagas diferidas.
'Se refleja en el concepto 5937 - SAR_CUOTA_RET_RG3831.
'-------------------------------------------------------------------------------
cuota = 0
cuota_ant = 0
cuota_no_desc = 0
cuota_no_desc_ant = 0
cuota_pr = 0
aus_n_rem = SAR_DIAS_DTO_AGUIN
nummes = SAR_MES_PAGO_IG


IF SAR_TP_IMPUT = "4" THEN 'Si el tipo de paga es segunda quincena, contabilizamos las ausencias no remuneradas de la primer quincena para tener las totales del mes
    SAR_ACM_PAG_QUIN_1RA.BEGIN()
    IF SAR_ACM_PAG_QUIN_1RA.COUNT() > 0 THEN
        cuota_ant = SAR_ACM_PAG_QUIN_1RA.SAR_CUOTA_RET_RG3831
        saldo = SAR_ACM_PAG_QUIN_1RA.SAR_SALDO_RET_RG3831        
    ENDIF
ENDIF


IF SAR_REC_BAS_IMP_RG3831 > 0 THEN
    meses_pro = (12 - nummes) + 1
    cuota_ant = Round(SAR_REC_BAS_IMP_RG3831 / meses_pro,2)
    saldo = SAR_REC_BAS_IMP_RG3831
ENDIF


IF SAR_TP_IMPUT = "4" THEN
    SAR_HT_PAYS.BEGIN()
    IF SAR_FEC_PAGO_IG = SAR_HT_PAYS.SCO_DT_END THEN
        Return(0)
    ENDIF
ENDIF

'-----------------------------------------------------------------------------
'En caso de baja del empleado antes de Diciembre se
'descuenta el saldo a ese mes.
'-----------------------------------------------------------------------------
IF SAR_ES_BAJA = 1 THEN
    cuota = saldo
Else
    IF (SAR_TP_IMPUT = "1" or SAR_TP_IMPUT = "4") and aus_n_rem >= 1 THEN 'si el total de ausencias no remuneradas en el mes es mayor o igual a 30 días 
        meses_pro = (12 - nummes) + 1
        cuota_ant = Round((saldo - cuota_no_desc_ant)/ meses_pro,2)
        cuota_no_desc = cuota_no_desc_ant + cuota_ant
        SAR_CUOTA_N_RET_RG3831 = cuota_no_desc
        Return(0)
    ENDIF
    
    IF cuota_no_desc_ant > 0 or cuota_no_desc > 0 THEN
        meses_pro = (12 - nummes) + 1
        cuota_ant = Round((saldo - cuota_no_desc_ant)/ meses_pro,2)
        cuota_ant = cuota_ant + cuota_no_desc_ant
    ENDIF

    IF cuota_ant > 0  THEN
        IF cuota_no_desc_ant > 0 THEN
            cuota = cuota_ant
        Else
            if DxMonth(SCO_DT_ALLOCATION) = 3 and SAR_TP_IMPUT = "3" then           
                cuota = cuota_ant        
            Else        
                meses_pro = (12 - nummes) + 1
                cuota_pr = Round((saldo)/ meses_pro,2)
                IF saldo <= cuota_pr THEN
                    cuota = saldo
                Else        
                    cuota = cuota_pr
                ENDIF
            Endif        
        endif
    ENDIF
Endif

Return(cuota)
