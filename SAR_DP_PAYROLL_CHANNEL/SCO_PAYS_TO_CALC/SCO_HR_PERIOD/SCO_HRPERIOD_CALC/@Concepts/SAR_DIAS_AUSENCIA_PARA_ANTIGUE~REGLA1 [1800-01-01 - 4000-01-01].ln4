/*
'Las incidencias a sumar son aquellas cuya caracteristica es INTERRUPCION
' A continuacion se listan:
    '2	Suspension:                               SAR_DIAS_SUS_DISCI     #480
    '5	Lic. sin Goce de Sueldo:                  SAR_LIC_S_GOS_SUELDO   #470
    '6	Excedencia:                               SAR_DIAS_EXCEDENCIA    #475
    '7	Ausencia Injustificada:                   SAR_DIAS_AUSENCIA      #540
    '8	Huelga:                                   SAR_DIAS_HUELGA        #460
    '31	Reserva de Puesto por Accidente:          SAR_R_PTO_ACC          #471
    '30	Reserva de Puesto por Enfermedad:         SAR_R_PTO_ENF          #472
    '32	Reserva de Puesto por Actividad Sindical: SAR_R_PTO_SIN          #473
    
*/    

aux = SAR_CARGA_AUSENTISM

SAR_ACM_AUS_EMPLE.Begin()
If(SAR_ACM_AUS_EMPLE.Count()> 0) Then
    dias_interrup = SAR_ACM_AUS_EMPLE.SAR_DIAS_AUSENCIA_PARA_ANTIGUE
    If(ISNULL(dias_interrup)=M4_TRUE)Then
      dias_interrup = 0
    EndIf
Else    
    dias_interrup = 0
EndIf
  
dias_interrup = dias_interrup + SAR_DIAS_SUS_DISCI + SAR_LIC_S_GOC_SUELD + SAR_DIAS_EXCEDENCIA + SAR_DIAS_AUSENCIA + SAR_DIAS_HUELGA + SAR_R_PTO_ACC + SAR_R_PTO_ENF + SAR_R_PTO_SIN
Return(dias_interrup)
