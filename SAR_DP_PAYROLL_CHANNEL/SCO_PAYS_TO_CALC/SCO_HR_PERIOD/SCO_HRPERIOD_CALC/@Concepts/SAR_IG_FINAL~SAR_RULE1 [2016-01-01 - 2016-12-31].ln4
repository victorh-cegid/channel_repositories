'Antes de realizar cualquier cálculo se verifica que la empresa haga la retención correspondiente a ganancias:
If(SAR_IND_NO_RET_GAN = 1)Then 
    Return(0)
EndIf  

'Antes de realizar cualquier calculo del impuesto verificamos que la modificación se realizó a fin del mes
'de la paga para de esta forma dejar el calculo al nuevo período.
If (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017")Then
    Return(0)
EndIf


If SAR_TP_IMPUT <> "99" Then 
  Return(0)
EndIf 


'Inicializo variable

v1 = SAR_IMPUESTO_TOTAL
v2 = 0
dev = 0
v3 = SAR_IMP_ANT_EMP
v4 = SAR_IMP_DEB_BAN
v5 = SAR_IMP_OTROS_EMP
V6 = 0

VALOR1 = 0

sar_acum_imp_ant_emp = 0
sar_acum_imp_oe      = 0


'-------------------------------------------------------------
'Recorro acumulado de lectura para armar las TI de IG
'-------------------------------------------------------------
SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()

I = ULTIMO_REG - 1 

WHILE I >= 0 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
       
    ' Armo los datos para SAR_ACM_IMPUESTO
    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG >= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN    
        v2 = v2 + SCO_AC_HR_PERIOD_READ_1.SAR_ACM_IMPUESTO
    ENDIF

    IF (SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG >= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG) and (dXmONTH(SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG) = 12 AND SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1") THEN 
        v6 = SCO_AC_HR_PERIOD_READ_1.SAR_SALDO_RET_RG3831
    ENDIF

    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG >= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION THEN    
        sar_acum_imp_ant_emp = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_ANT_EMP
        sar_acum_imp_oe = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_OTROS_EMP
    ENDIF
    I = I - 1
Wend

'REVISION:
If (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) Then
    v3 = sar_acum_imp_ant_emp
    v5 = sar_acum_imp_oe
Else
    v3 = v3 - sar_acum_imp_ant_emp
    v5 = v5 - sar_acum_imp_oe
EndIf

'Se contabiliza el beneficio correspondiente a Devolución IG SAC Ley 27.260, Art. 63
SAR_BENEF_SAC_IG()
valor = v1 - (v2 + v3 + v5) - v4 + v6 - SAR_BENEF_FINAL

IF SAR_IND_APLIC_TOPE_35 = 1 THEN
    SAR_ACM_ULT_PAGO_IMPUT.BEGIN()
    IF SAR_ACM_ULT_PAGO_IMPUT.COUNT() > 0 THEN
        IF ISNULL(SAR_ACM_ULT_PAGO_IMPUT.SAR_SALD_RET_GAN_ST) = FALSE THEN
            VALOR1 = SAR_ACM_ULT_PAGO_IMPUT.SAR_SALD_RET_GAN_ST
            ret_pediente = VALOR1  'saldo de retención pendiente
            
            If valor <> ret_pediente Then
               ret_pediente = valor
            EndIf
            
            beneficio_sac = SAR_BENEF_FINAL
            if beneficio_sac <> 0 Then 
                dif_retpend_benef = ret_pediente + beneficio_sac 'diferencia entre la retención pendiente y el beneficio
                'Se aplica el beneficio correspondiente a Devolución IG SAC Ley 27.260 Art. 63, al saldo pendiente de retención.
                if dif_retpend_benef >= 0 then 'la retención pendiente supera el beneficio
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG_P_TOPE", 0, beneficio_sac)
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_FINAL", 0, 0)
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_SAC_IG", 0, 0)
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_SALD_RET_GAN_ST", 0, dif_retpend_benef)
                else
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_BENEF_FINAL", 0, dif_retpend_benef)
                    SETVALUEPRIORITY(0,"SAR_HRPERIOD_CALC","SAR_SALD_RET_GAN_ST", 0, 0)
                endif
            Else   
                ' Se agrega condicion para evitar devoluciones o retenciones inferiores a 0,1.
                If abs(ret_pediente) < 0.1 Then ret_pediente = 0
                SAR_SALD_RET_GAN_ST = ret_pediente
            Endif            
        ENDIF
    ENDIF
    'Ante casos con indicativo de Tope del 35% activo, el valor topado se guarda en el c5320, 
    'debiendo el empleado responsabilizarse en la AFIP por ese valor no retenido.
    Return(0)
ENDIF

' Se agrega condicion para evitar devoluciones o retenciones inferiores a 0,1.
If abs(valor) < 0.1 Then valor = 0

Return(valor)
