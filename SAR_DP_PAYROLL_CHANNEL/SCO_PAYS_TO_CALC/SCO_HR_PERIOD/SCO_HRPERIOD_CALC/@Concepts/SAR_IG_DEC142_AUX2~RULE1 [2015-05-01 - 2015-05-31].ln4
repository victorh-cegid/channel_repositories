'Solo en pagas normales y relioquidación:
If(SAR_TP_IMPUT <> "1" And SAR_TP_IMPUT <> "99")Then
  Return(0)
EndIf

'Por Res 3770 para los empleados rango 1 no debe recalcularse nada.

IF SAR_RANGO_REM_IG_2015 = 1 Then Return(0)   

'Estos datos debieron calculares con las tablas anteriores al decreto es decir
'empresas derivadas del v792.  
base          = SAR_BASE_IMPUESTO

vCuota_fija   = 0
vPorcentaje   = 0
vValor        = 0
vBaseEspecial = 0
diferencia = 0

vCuota_fija = SAR_IMPUESTO.SAR_RETORNA_CUOTA_FIJA(base,SAR_FEC_PAGO_IG,ID_CURRENCY)
vPorcentaje = SAR_IMPUESTO.SAR_RETORNA_PORCENTAJE(base,SAR_FEC_PAGO_IG,ID_CURRENCY)
vValor      = SAR_IMPUESTO.SAR_RETORNA_VALOR(base,SAR_FEC_PAGO_IG,ID_CURRENCY)

' Se valida el valor del porcentaje para evitar que se haga una division por cero
If vPorcentaje > 0 Then
     vBaseEspecial = vCuota_fija + vPorcentaje * (base - vValor )/100
Else
    vBaseEspecial = 0
EndIf


'Se fuerzan los datos para calcularse con el v793 por DECRETO 3770 / 2015      
intAjuste   = SAR_IG_DEC142_AUX       
SAR_IG_DEC142_AUX       = 1

'Si ponemos v5930 = 1 activamos la orden para que el concepto v57 en su propia reejecución tome el valor 
'de nuevas tablas al reejecutarse cada uno de los siguientes conceptos:.
aux_14     = SAR_LEG_TABLA_IG()
aux_15     = SAR_RANGO_REM_IG_2015()
aux_1      = SAR_TOPE_SER_DOM()
aux_2      = SAR_TOPE_GAST_SEP()
aux_3      = SAR_TOPE_SEG_VIDA()
aux_4      = SAR_DED_ESPECIAL()
aux_5      = SAR_GAN_NO_IMP()
aux_6      = SAR_VAL_CONY_IMP()
aux_7      = SAR_VAL_HIJO_IMP()
aux_8      = SAR_VAL_OTRAS_IMP()
aux_9      = SAR_IMP_CONY_IG() 
aux_10     = SAR_IMP_HIJO_IG() 
aux_11     = SAR_IMP_O_CAR_IG()

/*ACLARACIÓN: Se realiza el ajuste con la variable interna "intajuste", dado que el v5930 se utiliza como variable de tipo indicador, y al ser númerico por error
suma 1 peso más al calculo de la variable v5041 cuando se re-ejecuta el v5002 */
SAR_IG_DEC142_AUX      = intAjuste
aux_13     = SAR_BASE_IMPUESTO()


vCuota_fija_1 = SAR_IMPUESTO.SAR_RETORNA_CUOTA_FIJA(aux_13,SAR_FEC_PAGO_IG,ID_CURRENCY)
vPorcentaje_1 = SAR_IMPUESTO.SAR_RETORNA_PORCENTAJE(aux_13,SAR_FEC_PAGO_IG,ID_CURRENCY)
vValor_1      = SAR_IMPUESTO.SAR_RETORNA_VALOR(aux_13,SAR_FEC_PAGO_IG,ID_CURRENCY)


' Se valida el valor del porcentaje para evitar que se haga una division por cero
If vPorcentaje_1 > 0 Then
     vBaseEspecial_1 = vCuota_fija_1 + vPorcentaje_1 * (aux_13 - vValor_1 )/100
Else
    vBaseEspecial_1 = 0
EndIf


'Se calcula la diferencia por Decreto 3770/2015      
diferencia = vBaseEspecial - vBaseEspecial_1

SAR_IMPUESTO_TOTAL = vBaseEspecial_1 

'---------------------------------------------------------------------------------------------------------------------------------------------

'---------------------------------------------------------------------
porc=SAR_PORC_IMP()
cuota_fija =SAR_CANT_FIJA_IMP()
desde = SAR_DESDE_IMP()
'---------------------------------------------------------------------


RETURN(diferencia)
