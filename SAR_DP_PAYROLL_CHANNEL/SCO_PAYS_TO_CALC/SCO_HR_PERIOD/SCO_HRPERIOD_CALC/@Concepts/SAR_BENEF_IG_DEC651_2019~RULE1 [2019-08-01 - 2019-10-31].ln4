/* ------------------------------------------------------------------------------ */
/* SOLO DEBE CALCULARSE CUANDO LA FECHA DE IMPUTACION DE IG ES 09/2019 o 10/2019  */
/* ------------------------------------------------------------------------------ */
MMImputIG = DxMonth(SAR_FEC_IMPUT_IG)
AAImputIG = DxYear (SAR_FEC_IMPUT_IG)

AAAjusteDec561 = 2019

If MMImputIG = 8 And AAImputIG = AAAjusteDec561 Then
    Return(0)
Else
    // Se aplica el beneficio en pagas normales para empleados mensuales y en la 1? quincena para los jornales salvo que este sea baja en la 2? quincena
    If ((SAR_TP_IMPUT = "1" And SAR_TIPO_SALARIO <> "003") Or (SAR_TP_IMPUT = "3" And SAR_TIPO_SALARIO = "003") Or (SAR_TP_IMPUT = "4" And SAR_ES_BAJA = 1)) Then
    
        If MMImputIG = 9 And AAImputIG = AAAjusteDec561 Then
        
            BenefDec561   = SAR_IG_DEC142_AUX2
            CuotaUnoBenef = BenefDec561 / 2
            
            If SAR_ES_BAJA = 1 Then CuotaUnoBenef = BenefDec561
            
            Return(CuotaUnoBenef)
            
        ElseIf MMImputIG = 10 And AAImputIG = AAAjusteDec561 Then
        
            BenefDec561 = SAR_IG_DEC142_AUX2
            
            If SAR_TP_IMPUT = "3" Then
                CuotaUnoBenef = Round(BenefDec561 / 2, SCO_CURR_DECIMALS)
                CuotaDosBenef = SAR_IG_DEC142_AUX2 - CuotaUnoBenef            
            Else
                CuotaUnoBenef = SAR_BENEF_IG_DEC651_2019
                CuotaDosBenef = SAR_IG_DEC142_AUX2 - CuotaUnoBenef
            EndIf
            
            Return(CuotaDosBenef)
        Else
            Return(0)    
        EndIf
    Else
        Return(0)
    EndIf
EndIf

Return(M4_SUCCESS)
