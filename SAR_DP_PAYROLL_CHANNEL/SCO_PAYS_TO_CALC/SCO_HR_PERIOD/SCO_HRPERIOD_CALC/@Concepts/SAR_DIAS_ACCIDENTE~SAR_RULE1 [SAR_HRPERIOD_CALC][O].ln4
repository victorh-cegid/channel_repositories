tope= SAR_TOPE_ACC_EMP 'el 510 se asigna por tabla de valor

IF (tope = 0) or (SAR_IND_ACCIDENTE = 0) THEN
    Return(0)
ENDIF

quedan = 10
totdemp = 0
totdart = 0
totdart_ag = 0
precio = 0
demp = 0
dart = 0
dart_ag = 0
impart = 0
impemp = 0
ordant = 0
graba_acum = SAR_PAYS_TO_CALC.SCO_SAVEYTD
aux = DxDate(06,11,2009)


IF graba_acum = 1 THEN 
    '************************* Inicio Delete en M4SAR_ACM_REC_ART *****************************
    If SAR_ACM_REC_ART.COUNT() > 0 THEN 
        primerreg = 0
        ultimoreg = SAR_ACM_REC_ART.COUNT() - 1
            FOR  M = primerreg TO ultimoreg          'DESDEM
                SAR_ACM_REC_ART.MOVETO(M)
                SAR_ACM_REC_ART.Deleteregister()
            NEXT
    Endif
    '************************* Fin Delete en M4SAR_ACM_REC_ART ********************************   
ENDIF         


primerreg = 0
ultimoreg = SAR_ACCID_ACT.COUNT() - 1

FOR  I = primerreg TO ultimoreg          'DESDEI
    SAR_ACCID_ACT.MOVETO(I)
    fec_acc = SAR_ACCID_ACT.SCO_DT_ACC    
    fec_ini = SAR_ACCID_ACT.SAR_DT_START
    fec_fin = SAR_ACCID_ACT.SAR_DT_END
    ordact = SAR_ACCID_ACT.SAR_ID_ORDINAL


    IF ordact <> ordant THEN
        cont = 0
        conth = 0
        total = 0
        totalhs = 0
        IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario Horario
            IF SCO_NUM_HOURS_THEO > 0 THEN
                contadorh = SAR_CALC_HORAS_TEORICAS(fec_ini,fec_fin)
            ELSE
                IF SAR_HS_DIARIAS_PROM = 0 THEN
                    Setlog (-1,80,4,205,SCO_ID_HR)
                    SCO_ERROR =1
                ELSE
                    contadorh = (fec_fin - fec_ini + 1) * SAR_HS_DIARIAS_PROM 
                ENDIF   
            ENDIF
        ENDIF
    
        contador = COMMONTIME(fec_ini,fec_fin, fec_ini,(SAR_ACCID_ACT.SAR_DT_ALLOC_START - 1))        ' dias anteriores al inicio de la paga actual		
    
        IF SAR_ACCID_ANT.COUNT() <> 0 THEN
        K = 0
        ult = SAR_ACCID_ANT.COUNT() - 1
            WHILE K <= ult AND total < tope
            SAR_ACCID_ANT.MOVETO(K)
            rec_ini = SAR_ACCID_ANT.SAR_DT_START
            rec_fin = SAR_ACCID_ANT.SAR_DT_END
                IF ordact = SAR_ACCID_ANT.SAR_ID_ORDINAL THEN
                    IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario Horario
                        IF SCO_NUM_HOURS_THEO > 0 THEN
                            conth = SAR_CALC_HORAS_TEORICAS(rec_ini,rec_fin)
                        ELSE
                            IF SAR_HS_DIARIAS_PROM = 0 THEN
                                Setlog (-1,80,4,205,SCO_ID_HR)
                                SCO_ERROR =1
                            ELSE  
                                conth = (rec_fin - rec_ini + 1) * SAR_HS_DIARIAS_PROM 
                            ENDIF    
                        ENDIF
                    ENDIF
                    cont = COMMONTIME(rec_ini,rec_fin, rec_ini,rec_fin)     'dias que dura la recaida    
                    total = total + cont
                    totalhs = totalhs + conth 
                ENDIF
            K = K + 1
            WEND
        ENDIF	
        total = total + contador      'total dias antes del mes a calcular
        quedan = tope - total
    ENDIF

    IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario Horario
        IF SCO_NUM_HOURS_THEO > 0 THEN
            numdiash = SAR_CALC_HORAS_TEORICAS(fec_ini,fec_fin)
        ELSE
            IF SAR_HS_DIARIAS_PROM = 0 THEN
                Setlog (-1,80,4,205,SCO_ID_HR)
                SCO_ERROR =1
            ELSE 
                numdiash = (fec_fin - fec_ini + 1) * SAR_HS_DIARIAS_PROM 
            ENDIF   
        ENDIF
    ENDIF

    numdias = COMMONTIME(fec_ini,fec_fin, SAR_ACCID_ACT.SAR_DT_ALLOC_START,SAR_ACCID_ACT.SAR_DT_ALLOC_END)

    'Ajuste para los mensuales.

    IF SAR_TIPO_SALARIO = "001" THEN 
       d_natural_paga = SAR_ACCID_ACT.SAR_DT_ALLOC_END - SAR_ACCID_ACT.SAR_DT_ALLOC_START + 1
       d_paga = SAR_DIAS_NORM_SUELD
       diferencia = d_paga - d_natural_paga
       IF numdias = d_natural_paga THEN
          numdias = numdias + diferencia
       ENDIF
    ENDIF 

    IF quedan > 0 THEN                 'todavia quedan dias para la empresa
        IF quedan < numdias THEN
            demp = demp + quedan
            dart = dart + (numdias - quedan)				
            IF fec_acc < aux THEN         				
                dart_ag = dart_ag + (numdias - quedan)				
                quedan=0                
            endif
            quedan=0
        ELSE
            demp = demp + numdias
            quedan = quedan - numdias
        ENDIF				
    ELSE
    
        dart = dart + numdias
        quedan = 0
        
        IF fec_acc < aux THEN 
            dart_ag = dart_ag + numdias
            quedan=0            
        ENDIF
    ENDIF

    totdemp = totdemp + demp
    totdart = totdart + dart
    IF fec_acc < aux THEN     
        totdart_ag = totdart_ag + dart_ag
    ENDIF
    
    IF graba_acum = 1 THEN 
     
      '************************* Inicio Insert en M4_ACM_REC_ART *****************************
        SAR_ACM_REC_ART.ADDREGISTER()
        SAR_ACM_REC_ART.SAR_ID_ORDINAL = ordact
        SAR_ACM_REC_ART.SAR_DT_START = fec_ini
        SAR_ACM_REC_ART.SAR_DIAS_EMP = demp
        SAR_ACM_REC_ART.SAR_DIAS_ART = dart
        
        '************************* Fin Insert en M4_ACM_REC_ART *****************************
    ENDIF    

    ordant=ordact
    demp=0
    dart=0

NEXT                      'DESDEI

IF SAR_TIPO_SALARIO = "001" Then
    SAR_DIAS_ART = totdart
Else
    SAR_DIAS_ART = totalhs
Endif


SAR_DIAS_ART_DTO_SAC = totdart_ag


Return(totdemp)
