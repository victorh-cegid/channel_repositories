///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// Nombre: SAR_SAC_NETO                                                      //
// Tipo: Variable                                                            //
// Id. : 5900                                                                //
// Clasificación: 2                                                          //
// G. de Ejecución: 4                                                        //
// Salida acumulado: Si                                                      //
// Retroactividad: Si                                                        //
// Entrada por valores: No                                                   //
// Retorno: N/A                                                              //
// Parámetros: N/A                                                           //
// ------------------------------------------------------------------------  //
// Autor: N/A                                                                //
// Fecha de Creación: N/A                                                    //
// Asunto: Calcula el SAC neto realizando la suma del SAC del 2° semestre    //
//         con el SAC de egreso del 2°, a esta suma se le resta la suma de   //
//         los descuentos por ley, jubilación, O.S, etc. Para ser aplicado   //
//         al calculo de la deducción especial según decreto 2191/2012.      //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////


///////////////////////////////////////////////////////////////////////////////
//                                                                           //
// Autor: DAV                                                                //
// Fecha de Modificación: 27/02/2013                                         //
// Asunto: Nueva validación: Si la fecha de baja se encuentra entre          //
// 01/01/2013 y 31/03/2013 este concepto retorna valor cero (0)              //
//                                                                           //
///////////////////////////////////////////////////////////////////////////////



// Con bajas anteriores al 155/11/2012 Retorna 0:

If (SAR_ES_BAJA = 1 And  SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Then 

    If(SAR_FECHA_BAJA < ToDate("2012-11-15")) Then
        
        Return(0)    
    
    EndIf
    
EndIf

SAC_NETO = 0
SAC_NETO = (SAR_PAGA_EXTRA_2 + SAR_EGRESO_PAGA_2) - (SAR_JUBILACION_SAC + SAR_LEY_19032_SAC + SAR_OBRA_SOCIAL_SAC + SAR_C_SINDICAL_SAC + SAR_OB_SOC_ADIC_SAC )

SAC_NETO = SAC_NETO + SAR_SAC_NETO_OE 'Sumamos el SAC Neto correspondiente a otros empleadores.


Return(SAC_NETO)
