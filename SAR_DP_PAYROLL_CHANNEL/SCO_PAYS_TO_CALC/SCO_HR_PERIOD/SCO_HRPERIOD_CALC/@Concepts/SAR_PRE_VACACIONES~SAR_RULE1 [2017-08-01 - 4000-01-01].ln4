'Excluimos del calculo los tipos de paga: Extra(2)-Aguinaldo, Reliquidacion impuesto(99).
If (SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1) Or SAR_TP_IMPUT = "99" Then Return(0)

'Anticipo de vacaciones: Se excluye si esta activo el indicador de paga especial de vacaciones o si no esta activado el indicador de anticipo
If SAR_TP_IMPUT = "88" And (SAR_IND_PAGA_ESP_VAC = 1 Or SAR_IND_ANT_VAC = 0) Then Return(0)

'Tenemos que tener en cuenta la posibilidad de que exista un tramado en el calculo de nomina. Realizamos todos los calculos en el primer tramo.
num_tramos = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA..SysSliceNumber

If num_tramos > 1 Then
    ini_prim_tramo = GetStartDate()         'Fecha de incio del primer tramo del calculo
    fecha_ini_tram = GetRunningStartDate()  'Fecha de incio del tramo en ejecucion
EndIf

prec_dias_vac = 0   'Precio de los dias de vacaciones abonados

'Recorremos los periodos vacacionales existentes para el mes de calculo.
primerreg = 0
ultimoreg = SAR_VACACIONES.Count() - 1

For i = primerreg To ultimoreg 
    SAR_VACACIONES.MoveTo(i)

    'Determinamos la fecha de inicio de vacaciones del periodo vacacional procesado para calcular el precio que hay que aplicar para el abono de vacaciones.
    fec_ini_vac = SAR_VACACIONES.SCO_DT_START
    prec_dias_vac = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_vac,"#3553")
Next

    'Debemos tener en cuenta los ajustes, para ello debemos componer el precio de vacaciones del mes en que nos encontramos cuando el mes de calculo supera 
    'el mes que comienzan las vacaciones
    ini_per_tram_act = GetRunningStartDate()
    If prec_dias_vac = 0 And SAR_DIAS_VACACIONES <> 0 Then 
        fec_ini_vac = ini_per_tram_act
        prec_dias_vac = SAR_HR_ROLE.SAR_CALCULA_PRECIO_FECHA(fec_ini_vac,"#3553")
    EndIf

Return Round(prec_dias_vac,SAR_NUM_DEC)
