If SCO_DT_PAYMENT = SCO_DT_ALLOCATION And SAR_SEP23_IND_AJ_NORM = 0 Then Return(0)
'Bases de impuesto originales

If SAR_SEP23_IND_AJ_NORM = 0 Then
    base = SCO_AC_HR_PERIOD_REV_1.SAR_AGO23_IMP_SIN_HE - SAR_SEPT23_DIF_SAC
    If base < 0 And SCO_AC_HR_PERIOD_REV_1.SAR_AGO23_BASE_IMP - SAR_SEPT23_DIF_SAC > 0 Then base = 0
Else
    base = SAR_AGO23_IMP_SIN_HE + SAR_SEPT23_DIF_SAC
    If base < 0 And SAR_AGO23_BASE_IMP + SAR_SEPT23_DIF_SAC > 0 Then base = 0
EndIf

'Fecha de impuesto original
fec_imp = SAR_FEC_IMPUT_IG
If SAR_IND_IMPUESTO_RETRO = 1 Then fec_imp = SAR_FEC_IMPUT_IG

esBaja = 0
If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then esBaja = 1
If esBaja = 1 And SAR_IG_DICIEMBRE = 1 Then fec_imp = DxDate("31","12",DxYear(fec_imp))

aux = SAR_IMPUESTO.SAR_RETORNA_CUOTA_FIJA(base,fec_imp,ID_CURRENCY)

RETURN Round(aux,SAR_NUM_DEC)
