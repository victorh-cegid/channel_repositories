'Calcula las licencias sin parte variable y sin plus y devuelve la diferencia

'Dependencias
aux = SAR_TOT_DEV_COTIZ + SAR_PRESTACION_ART
If SAR_D612_IND = 0 Then Return(0)

difIncidencias = 0
fijoLicencias = SAR_TOT_P_COMP_EA
fijoJornal = SAR_ACM_ULT_PAGO_IMPUT[0].SAR_TOT_P_COMP_EA
If fijoJornal = 0 Then fijoJornal = fijoLicencias

fijoUnidad = fijoLicencias/SAR_DIAS_NORM_SUELD
If SAR_TIPO_SALARIO = "003" Then fijoUnidad = fijoJornal

totImportesInciden = SAR_NACIMIENTO + SAR_LIC_GREMIAL + SAR_CASAMIENTO + SAR_DEFUNCION+ SAR_EXAMEN
totDiasInciden = SAR_DIAS_NACIMIENTO + SAR_DIAS_LIC_CONV + SAR_DIAS_CASAMIENTO + SAR_DIAS_DEFUNCION + SAR_DIAS_EXAMEN

totImportesIncSind = fijoUnidad * totDiasInciden

If totImportesInciden > totImportesIncSind Then difIncidencias = totImportesInciden - totImportesIncSind

Return Round(difIncidencias,SAR_NUM_DEC)

