'El concepto 631 (% de contribuci?n fondo nacional de empleo) tomar? su valor de zonas dgi o de valores modalidades de 
'contrataci?n para cada modalidad vigente.

valor = SAR_REMUN_IMPO_CNT * SAR_PORC_F_EMPLEO_FAL / 100

'Dec 792 proporcionamos la detracci?n seg?n los d?as trabajados
If SAR_DIAS_DEC792 > 0 Then

    dias_efectivos = SAR_TIEMPO_EFVO_TR
    dias_descontar = SAR_DIAS_MATERN + SAR_LIC_ONCO_DIAS + SAR_UN_VACACIONES + SAR_DIAS_ART + SAR_DIAS_DEC792
    dias_detraccion = Max(dias_efectivos - dias_descontar,0)
    dias_cotiz = SAR_DIAS_NORM_COTIZ
    
    imp_detrac_aplicable = Round(SAR_REDUC_IMPO * dias_detraccion/dias_cotiz, SAR_NUM_DEC)
    
    'recalculamos la base sobre la que aplicar la contribuci?n con la detracci?n que puede aplicarse
    base = SAR_TOT_DEV_COTIZ - imp_detrac_aplicable
    valor = base * SAR_PORC_F_EMPLEO_FAL / 100
    
endif

'Dec 792 compensacion exenta de contribucion
valor = valor - Percentage(SAR_PORC_F_EMPLEO_FAL,SAR_IMP_DEC792_NRED)
valor = Max(valor,0)

RETURN(valor)
