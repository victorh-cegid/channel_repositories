'
'Son las renumeraciones asociadas a las vacaciones imponibles con limite maximo de 75 MOPRES, 
'este concepto fue creado por la LEY 25239 - Reforma Tributaria 
'
IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
    tope = SAR_TOPE_COTIZ_CNT 
ELSE
     SAR_ACM_ACT_CONTRIB.BEGIN()
    'Resto al tope lo acumulado en el mes
    tope = SAR_TOPE_COTIZ_CNT - SAR_ACM_ACT_CONTRIB.SAR_VAC_IMPO_CNT
ENDIF


IF SAR_UN_VACACIONES = 0 THEN
    tope = 0
ELSE
    tope =(tope/SAR_DIAS_NORM_COTIZ)* SAR_UN_VACACIONES
ENDIF

aux = SAR_IMPORTE_LICENCIAS
vac = SAR_VACACIONES

base= Min(tope,vac)

RETURN(base)
