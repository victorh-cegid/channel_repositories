'Si el concepto se informa por tabla de valor continuara tomando el importe informado, 
'pero si no se informa nada devolvera el importe del concepto 4040 (SAR_TOT_P_COMP_EA)
'aplicando el porcentaje SAR_PORC_ART_233
importe = SAR_PR_PREST_SUSP_ART_223BIS
precio = 0
dias = SAR_DIAS_SUSP_ART_223BIS
If SAR_TIPO_SALARIO = "001" Then         
    If SAR_DIAS_NORM_SUELD <> 0 Then Precio = SAR_TOT_P_COMP_EA/SAR_DIAS_NORM_SUELD                       
Else
    Precio = SAR_TOT_P_COMP_EA/SAR_HORAS_MES
EndIf
precio = Percentage(SAR_PORC_ART_233,precio)
If importe = 0 And dias <> 0 Then importe = precio
Return Round(importe,SAR_NUM_DEC)
