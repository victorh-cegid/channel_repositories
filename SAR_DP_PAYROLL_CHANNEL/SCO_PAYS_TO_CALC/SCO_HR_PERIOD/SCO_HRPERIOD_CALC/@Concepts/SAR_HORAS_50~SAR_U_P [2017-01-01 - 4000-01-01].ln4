If SAR_TP_IMPUT = "77" or SAR_TP_IMPUT = "88" or SAR_TP_IMPUT = "99" Then Return(0)

a = SAR_IMPORTE_LICENCIAS
uds = SAR_UN_HORAS_50
precio = SAR_PR_HORAS_50

precio_trib = precio / 1.5 'Calculamos el precio base que será tributable
precio_plus = precio - precio_trib 'Precio plus, que estará exento.

importe = Round(uds * precio,SCO_CURR_DECIMALS)

'asignación importes tributables y exentos
unid_sem = SAR_UN_HS_SEM_50
unid_finde = SAR_UN_HS_FINDE_50
unid_trib = (unid_sem + unid_finde)

importe_trib = Round(unid_trib * precio_trib,SCO_CURR_DECIMALS)
SAR_HS_FINDE_TRIB_50 = importe_trib

importe_exen = Round(unid_finde * precio_plus,SCO_CURR_DECIMALS)
SAR_HS_FINDE_EXEN_50 = importe_exen

importe_plus_trib= Round(unid_sem * precio_plus,SCO_CURR_DECIMALS)
SAR_PLUS_HS_TRIB_50 = importe_plus_trib

Return(importe)
