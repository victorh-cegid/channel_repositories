If SAR_TP_IMPUT = "99" Or SAR_TP_IMPUT = "88" Then Return(0)

'Calcula todas las remuneraciones imponibles de jubilacion y LEY. El calculo se realiza en forma mensual por mes de LSD.
RemImpoOrigVac = 0

'dependencia
a = SAR_REMUN_IMPO

'Dias para proporcionar el tope
'Jornales se convierten las horas a dias usando SAR_HS_DIARIAS_PROM
diasVacPago = SAR_UN_VACACIONES
diasVacPagoOrig = 0
If SCO_DT_PAYMENT <> SCO_DT_ALLOCATION Then diasVacPagoOrig = SCO_AC_HR_PERIOD_REV_1.SAR_UN_VACACIONES
diasVacPago = diasVacPago - diasVacPagoOrig
diasVacPagoPrev = SAR_LSD_COTIZ[0].SAR_UN_VACACIONES
diasVacPagoTotMesLSD = diasVacPago + diasVacPagoPrev
horas = 1
If SAR_HS_DIARIAS_PROM > 0 AND SCO_PAY_FREQ_ALLOC = "003" Then horas = SAR_HS_DIARIAS_PROM
diasVacPagoTotMesLSD = diasVacPagoTotMesLSD/horas
'Fin dias para proporcionar el tope

topeMax = (SAR_TOPE_COTIZ/30) * diasVacPagoTotMesLSD

'Los devengos cotizables de la paga de proceso
devengosVac = SAR_LSD_VAC_AD

'En caso de retroactividad, se considera como devengos cotizables de la paga de proceso el importe de la diferencia
If SCO_DT_PAYMENT <> SCO_DT_ALLOCATION Then
    devengosOrigVac = SCO_AC_HR_PERIOD_REV_1.SAR_LSD_VAC_AD
    RemImpoOrigVac = SCO_AC_HR_PERIOD_REV_1.SAR_VAC_IMPO_AD
    devengosVac = devengosVac - devengosOrigVac
EndIf

'Se a?aden al calculo los devengos cotizables de pagas ANTERIORES del mismo mes de LSD, 
'para tener el importe completo sobre el que realizar topes
devengosVacPrev = SAR_LSD_COTIZ[0].SAR_LSD_VAC_AD

'En devengosTotMesLSD tenemos todos los devengos sobre los que aplicar topes
devengosTotMesLSD = devengosVac + devengosVacPrev

baseTopada = Min(topeMax,devengosTotMesLSD)

baseRemVacPrev = SAR_LSD_COTIZ[0].SAR_VAC_IMPO_AD
baseRemVac = baseTopada - baseRemVacPrev + RemImpoOrigVac

Return Round(baseRemVac,SAR_NUM_DEC)
