'Si el concepto se informa por tabla de valor continuará tomando el importe informado, 
'pero si no se informa nada devolverá el importe del concepto 4040 (SAR_TOT_P_COMP_EA) 
importe = SAR_PR_DESC_SUSP_RES_397
precio = 0
dias = SAR_DIAS_SUSP_RES_397
If SAR_TIPO_SALARIO = "001" Then         
    If SAR_DIAS_NORM_SUELD <> 0 Then Precio = SAR_TOT_P_COMP_EA/SAR_DIAS_NORM_SUELD                       
Else
    Precio = SAR_TOT_P_COMP_EA/SAR_HORAS_MES
EndIf
If importe = 0 And dias <> 0 Then importe = precio
Return Round(importe,SAR_NUM_DEC)
