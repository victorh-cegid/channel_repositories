'Excluimos del calculo los tipos de paga: Extra(2), Anticipo de Vacaciones(88), Reliquidacion Impuesto(99).
If (SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1) Or SAR_TP_IMPUT = "88" Or SAR_TP_IMPUT = "99" Then Return(0)

'Evaluamos si se esta ejecutando una Paga Especial de Licencia por Vacaciones. En este tipo de paga se liquidan las vacaciones y no se descuentan.
If SAR_TP_IMPUT = "77" Then Return(0)

'Tenemos que tener en cuenta la posibilidad de que exista un tramado en el calculo de nomina. Realizamos todos los calculos en el primer tramo
num_tramos = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA..SysSliceNumber

If num_tramos > 1 Then
    ini_prim_tramo = GetStartDate()         'Fecha de incio del primer tramo del calculo
    fecha_ini_tram = GetRunningStartDate()  'Fecha de incio del tramo en ejecucion
EndIf

'Inicializo las variables para los calculos a efectuar
prec_vac_ant_desc = 0                               'Precio parcial Vacaciones descontadas periodo anterior
prec_vac_act_desc = 0                               'Precio parcial Vacaciones descontadas periodo actual
pre_tot_vac_desc  = 0                               'Precio total Vacaciones descontadas en paga actual
dias_tot_desc_vac = SAR_DIAS_VACACIONES             'Total dias Descuento Licencia por Vacaciones en la paga procesada

'1.- Comprobamos si existen dias pendientes descontados en la paga actual.
dias_vac_ant_desc = SAR_EXC_DIAS_VAC_DESC        'Total dias Descuento pendientes descontados en la paga procesada

If dias_vac_ant_desc > 0 Then
    prec_vac_ant_desc = SAR_ACM_ULT_MES[0].SAR_EXC_PRE_VAC 'Precio descuento Vacaciones pendientes
    If prec_vac_ant_desc = 0 And SAR_TIPO_SALARIO = "003" Then
        prec_vac_ant_desc = SAR_ACM_ULT_PAGO_IMPUT[0].SAR_EXC_PRE_VAC 'Precio descuento Vacaciones pendientes      
    EndIf
EndIf

'2.- Comprobamos si existe algun periodo vacacional que comience en el mes de calculo y deba ser tenido en cuenta para el calculo del precio. 
num_reg_vac = SAR_VACACIONES.Count()

'Si no obtengo dias de Licencia por vacaciones a descontar en el mes actual no los tengo en cuenta para el calculo del precio y continuo.
If num_reg_vac > 0 Then
    dias_vac_act_desc = dias_tot_desc_vac - dias_vac_ant_desc
    promedio = SAR_PRO_VAR_ULT_6
    If dias_vac_act_desc > 0 Then
        If SAR_DIAS_NORM_SUELD = 0 Then
            prec_vac_act_desc = 0
        Else
'Si tengo mas de un tramo en el mes y varios periodos vacacionales en el mes tengo que proporcionar el precio a cada tramo por cambio de salario.           
            If num_tramos > 1 Then 
                For j = 0 To num_reg_vac - 1
                    SAR_VACACIONES.MoveTo(j)
    
                    fec_ini_vac = SAR_VACACIONES.SCO_DT_START
                    fec_fin_vac = SAR_VACACIONES.SCO_DT_END
                    
                    For i = 0 To num_tramos - 1
                        fec_ini_tramo = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[i]..SysStartDate
                        fec_fin_tramo = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[i]..SysEndDate

                        If fec_ini_tramo <= fec_ini_vac And fec_fin_tramo >= fec_ini_vac Then
                            If SAR_TIPO_SALARIO <> "003" Then
                                prec_vac_act_desc = prec_vac_act_desc + ((SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[i] + promedio) / SAR_HRPERIOD_CALC.SAR_DIAS_NORM_SUELD)
                            Else
                                prec_vac_act_desc = prec_vac_act_desc + SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[i] + promedio
                            EndIf
                        EndIf
                    Next
                Next
            Else
                If SAR_TIPO_SALARIO <> "003" Then
                    prec_vac_act_desc = (SAR_TOT_P_COMP_EA + promedio) / SAR_DIAS_NORM_SUELD
                Else
                    prec_vac_act_desc = SAR_TOT_P_COMP_EA + promedio
                EndIf
            EndIf
        EndIf
    EndIf
EndIf

'3.- Obtengo el precio total teniendo en cuenta si tenemos descuentos de uno o mas tramos salariales. En caso de existir mas de un tramo calculamos la media ponderada.
If prec_vac_ant_desc > 0 And prec_vac_act_desc > 0 Then
    prec_vac_ant_desc = ((prec_vac_ant_desc * dias_vac_ant_desc))/dias_tot_desc_vac
    prec_vac_act_desc = ((prec_vac_act_desc * dias_vac_act_desc))/dias_tot_desc_vac
EndIf

'Sumamos los precios de los distintos tipos de periodos vacacionales que podemos tener para calcular el precio total final.
pre_tot_vac_desc = prec_vac_ant_desc + prec_vac_act_desc

Return(pre_tot_vac_desc)
