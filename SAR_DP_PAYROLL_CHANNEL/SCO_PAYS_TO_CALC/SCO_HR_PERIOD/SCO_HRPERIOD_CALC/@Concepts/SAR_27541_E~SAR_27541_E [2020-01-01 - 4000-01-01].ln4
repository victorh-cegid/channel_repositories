'Sólo baja y reliquidación. Recibe el valor de SAR_RET_VALOR_COMPL
importe = 0

'Paga especial de reliq septiembre, no se levantan pagos a cta.
indReliq = SAR_IND_PAGA_RELIQ
If indReliq = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then indReliq = 0

If (indReliq = 1 Or SAR_IND_DIC_DED_ANU = 1) Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" And SAR_IG_DICIEMBRE = 1) Then importe = SAR_27541_E
Return Round(importe,SAR_NUM_DEC)
