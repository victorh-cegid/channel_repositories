'IF SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN Return(0)
IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN Return(0)


'No debe tomar el valor en Pagas Extra.
If ((SAR_TP_IMPUT = "2") or (SAR_TP_IMPUT = "3" and SAR_ES_BAJA = 0)) Then
    Return(0)    
EndIf

AUX         = SAR_TOT_P_COMP_EA
AUX         = SAR_DIAS_MES_VAC
promedios   = 0

'precio
IF SCO_PAY_FREQ_ALLOC = "004" THEN
    SAR_ACM_6_MESES_EXTR.BEGIN()
    IF SAR_ACM_6_MESES_EXTR.COUNT() > 0 THEN
        promedios = SAR_ACM_6_MESES_EXTR.SAR_TOT_PROMEDIOS
    ENDIF
ELSE
    promedios_6_m = SAR_PRO_VAR_ULT_6
    promedios_12_m = SAR_PRO_VAR_ULT_12
    promedios = Max(promedios_6_m,promedios_12_m)

    IF SAR_TIPO_SALARIO = "003" THEN
        promedios = Round(promedios /SAR_HORAS_MES,2)
    ENDIF
ENDIF

IF IsNull(PROMEDIOS)= TRUE THEN PROMEDIOS = 0

SALARIO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA + promedios

IF SAR_TIPO_SALARIO <> "003" THEN
    SALARIO = SALARIO/25
ELSE
    SALARIO = SALARIO * SAR_HS_DIARIAS_PROM
ENDIF

valor = SALARIO

IF ISNULL(valor) = TRUE THEN valor = 0

valor   = round(salario * SAR_SALDO_VACACION,2) 
val     = 0
SAR_ACM_ULT_MES.begin()

If(SAR_ES_ALTA = 1 And SAR_HR_PERIOD.STD_ID_HRP_START_REASON = "005")Then
    val = valor
Else
    If (SAR_ACM_ULT_MES.count() > 0) Then
        val = valor - SAR_ACM_ULT_MES.SAR_PROV_VAC_ACUM
    Else
        val = valor
    Endif
    If val < 0 Then    
        dias_vac_x_mes = Round( SAR_DIAS_VACACION / 12, 4)
        val= round(salario * dias_vac_x_mes,2) 
    EndIf
EndIf    
 
'Paga especial de vacaciones no debe tener valor en la provisión mensual
IF SAR_TP_IMPUT <> "77" Then SAR_PROV_VAC_MES = val   

return(valor)
