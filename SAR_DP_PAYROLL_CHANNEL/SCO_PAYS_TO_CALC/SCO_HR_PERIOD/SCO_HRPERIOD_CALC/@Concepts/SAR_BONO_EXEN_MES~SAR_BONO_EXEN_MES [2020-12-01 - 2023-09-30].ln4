'Ley 27617 el bono quedara exento hasta el 40% de la gni si las retribuciones del mes no superan un limite.
exenMes = 0
bonosPrevMesIG = 0
bonosPagaAct = 0
bonosMesIG = 0
bonosAnioIG = 0
exenPagaAntMismoMes = 0
grabPagaAntMismoMes = 0
exenGastadoHastaMesAnt = 0
exenTeorPagaAntMismoMes = 0
exenTeorGastadoHastaMesAnt = 0
esBajaReliq = 0
esRetro = 0
exenMesTeor = 0
aporteJubTeor = 0
aporteLeyTeor = 0
aporteOsocTeor = 0
aporteAdosTeor = 0
aporteSindTeor = 0
calcula_bono_mes = 1
bonosPagaAct_OE = 0
totalExentoOe = 0

If SAR_IND_PAGA_RELIQ = 1 Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Then esBajaReliq = 1

'Bonos pagados en pagas anteriores del mismo mes IG sin incluir la paga de proceso
bonosPrevMesIG = SAR_ACM_MESACT_IMPIG[0].SAR_TOT_BONOS_27617

If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then bonosPrevMesIG_OE = SAR_ACM_MESACT_IMPIG[0].SAR_IMP_BONOS_OE_PAGA 

'Bonos pagados en la paga de proceso
bonosPagaAct = SAR_TOT_BONOS_27617

'El total de bonos pagado en la paga IG de proceso, considerando carga tardia
If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then 
    bonosPagaAct_OE = SAR_IMP_BONOS_OE_PAGA
    If esBajaReliq = 1 Then bonosPagaAct_OE = SAR_IMP_BONOS_PROD_OE - SAR_ACM_IG_ANIO_IMPUT[0].SAR_IMP_BONOS_OE_PAGA
EndIf    

If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then
    bonosMesIG = bonosPagaAct + bonosPrevMesIG + bonosPagaAct_OE + bonosPrevMesIG_OE
Else
    bonosMesIG = bonosPagaAct + bonosPrevMesIG
EndIf

If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then
    'Bonos pagados en el a?o fiscal incluida la paga de proceso
    bonosAnioIG = SAR_TOT_BONOS_27617 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_BONOS_27617 + SAR_IMP_BONOS_OE_PAGA + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IMP_BONOS_OE_PAGA
    If esBajaReliq = 1 Then bonosAnioIG = SAR_TOT_BONOS_27617 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_BONOS_27617 + SAR_IMP_BONOS_PROD_OE
Else
    'Bonos pagados en el a?o fiscal incluida la paga de proceso
    bonosAnioIG = SAR_TOT_BONOS_27617 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_BONOS_27617
    If esBajaReliq = 1 Then bonosAnioIG = SAR_TOT_BONOS_27617 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_BONOS_27617
EndIf

'Bonos exentos calculados en las pagas anteriores del mismo mes IG de proceso, sin incluir la paga de proceso
exenPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_EXEN_MES

'Bonos grabados calculados en las pagas anteriores del mismo mes IG de proceso, sin incluir la paga de proceso
grabPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_GRAV_MES

'Bonos exentos calculados en el a?o fiscal sin considerar los del mes IG de proceso
exenGastadoHastaMesAnt = SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_EXEN_MES - exenPagaAntMismoMes

'Bonos exentos teoricos calculados en las pagas anteriores del mismo mes IG de proceso, sin incluir la paga de proceso
exenTeorPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_EXEN_MES_TEOR

'Bonos exentos teoricos calculados en el a?o fiscal sin considerar los del mes IG de proceso
exenTeorGastadoHastaMesAnt = SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_EXEN_MES_TEOR - exenTeorPagaAntMismoMes

'Porcentajes para calculo de aportes
porcJub = 0
porcLey = 0
If SAR_EDAD >= 18 Then 
    porcJub = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
    porcLey = SAR_PORC_LEY_19032 - (SAR_PORC_LEY_19032 * SAR_PP_AP_INSSJP/100)
EndIf
porcObSoc = SAR_PORC_OBR_SOCIAL -(SAR_PORC_OBR_SOCIAL * SAR_PP_AP_OB_SOC/100)
porcAdObSoc = SAR_PORC_ADIC_O_SOC - (SAR_PORC_ADIC_O_SOC * SAR_PP_AP_OB_SOC/100)
porcSind = SAR_PORC_C_SIND_VOL + SAR_PORC_C_SIND_OBL

'Aportes a descontar calculados en las pagas anteriores del mismo mes IG de proceso, sin incluir la paga de proceso
jubPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_JUB
jubPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_JUB_TEO
leyPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_LEY
leyPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_LEY_TEO
osocPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_OSOC
osocPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_OSOC_TEO
adosPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_ADOS
adosPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_ADOS_TEO
sindPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_SIND
sindPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_BONO_IG_SIND_TEO

'Tope exento para aplicar en el a?o fiscal
topeMaxExen = Percentage(40,SAR_NO_IMP_27617)

If bonosAnioIG = 0 Or (bonosMesIG = 0 And esBajaReliq = 0) Or (SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1) Then calcula_bono_mes = 0

If calcula_bono_mes = 1 Then
    'En el calculo del mes se comprueba si esta alcanzado tomando lo menor entre el promedio y el mes
    If esBajaReliq = 0 Then
        'La exencion teorica se calcula siempre, puede hacer falta para la paga de reliquidacion
        disponibleExenTeor = Max(topeMaxExen - exenTeorGastadoHastaMesAnt,0)
        exenMesTeor = Min(disponibleExenTeor,bonosMesIG) - exenTeorPagaAntMismoMes
        SAR_BONO_EXEN_MES_TEOR = exenMesTeor
    
        'Valida si el empleado esta alcanzado por la exencion del bono
        retrib = SAR_PROM_27617_BONOS

        'En paga especial reliq. septiembre, se considera el promedio de la paga normal que origina la retroactividad
        If SAR_IND_PAGA_RELIQ = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then retrib = SAR_PROM_BONOS_ULTIMO

        vValor = SAR_DED_ESP_INC.SAR_RETORNA_VAL_TRAM(3,SAR_FEC_IMPUT_IG,ID_CURRENCY)
        If vValor >= retrib Then
            disponibleExen = Max(topeMaxExen - exenGastadoHastaMesAnt,0)
            exenMes = Min(disponibleExen,bonosMesIG) - exenPagaAntMismoMes
        EndIf
    
        'El bono grabado es la diferencia entre el bono del mes IG y el exento del mes IG, considerando pagas anteriores.
        exenTotalDelMes = exenMes + exenPagaAntMismoMes
        exenTotalDelMesTeor = exenMesTeor + exenTeorPagaAntMismoMes
    
        gravMes = bonosMesIG - exenTotalDelMes - grabPagaAntMismoMes
        SAR_BONO_GRAV_MES = gravMes
    
        'Aportes a descontar de IG
        aporteJub = Percentage(porcJub,exenTotalDelMes) - jubPagaAntMismoMes
        aporteJubTeor = Percentage(porcJub,exenTotalDelMesTeor) - jubPagaAntMismoMesTeo
        SAR_BONO_IG_JUB = aporteJub
        SAR_BONO_IG_JUB_TEO = aporteJubTeor
        
        aporteLey = Percentage(porcLey,exenTotalDelMes) - leyPagaAntMismoMes
        aporteLeyTeor = Percentage(porcLey,exenTotalDelMesTeor) - leyPagaAntMismoMesTeo
        SAR_BONO_IG_LEY = aporteLey
        SAR_BONO_IG_LEY_TEO = aporteLeyTeor
    
        aporteOsoc = Percentage(porcObSoc,exenTotalDelMes) - osocPagaAntMismoMes
        aporteOsocTeor = Percentage(porcObSoc,exenTotalDelMesTeor) - osocPagaAntMismoMesTeo
        SAR_BONO_IG_OSOC = aporteOsoc
        SAR_BONO_IG_OSOC_TEO = aporteOsocTeor
    
        aporteAdos = Percentage(porcAdObSoc,exenTotalDelMes) - adosPagaAntMismoMes
        aporteAdosTeor = Percentage(porcAdObSoc,exenTotalDelMesTeor) - adosPagaAntMismoMesTeo
        SAR_BONO_IG_ADOS = aporteAdos * SAR_FAM_CARGO_OS
        SAR_BONO_IG_ADOS_TEO = aporteAdosTeor * SAR_FAM_CARGO_OS
       
        aporteSind = Percentage(porcSind,exenTotalDelMes) - sindPagaAntMismoMes
        aporteSindTeor = Percentage(porcSind,exenTotalDelMesTeor) - sindPagaAntMismoMesTeo
        SAR_BONO_IG_SIND = aporteSind
        SAR_BONO_IG_SIND_TEO = aporteSindTeor            
    'En el calculo de baja o reliquidacian solo se toma el promedio y se ajusta la situacion final
    Else
        retrib = SAR_PROM_27617_BONOS

        'En paga especial reliq. septiembre, se considera el promedio de la paga normal que origina la retroactividad
        If SAR_IND_PAGA_RELIQ = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then retrib = SAR_PROM_BONOS_ULTIMO
    
        'En caso de baja o paga de reliquidacion se mira la fecha de pago IG
        vValor = SAR_DED_ESP_INC.SAR_RETORNA_VAL_TRAM(3,SAR_FEC_PAGO_IG,ID_CURRENCY)
    
        'Si esta alcanzado por la exencion se toma la exencion teorica para los aportes
        If vValor >= retrib Then
            exenBonoFinal = Min(topeMaxExen,bonosAnioIG)
            gravBonoFinal = bonosAnioIG - exenBonoFinal
    
            'En caso de baja o carga tardia de OE hay que contemplar que puede percibir un bono el mes de la baja
            If SAR_ES_BAJA = 1 Or bonosPagaAct_OE <> 0 Then
                disponibleExenTeor = Max(topeMaxExen - exenTeorGastadoHastaMesAnt,0)
                
                exenMesTeor = Min(disponibleExenTeor,bonosMesIG) - exenTeorPagaAntMismoMes
                SAR_BONO_EXEN_MES_TEOR = exenMesTeor
                
                aporteJubTeor = Percentage(porcJub,exenMesTeor) - jubPagaAntMismoMesTeo
                SAR_BONO_IG_JUB_TEO = aporteJubTeor
                
                aporteLeyTeor = Percentage(porcLey,exenMesTeor) - leyPagaAntMismoMesTeo            
                SAR_BONO_IG_LEY_TEO = aporteLeyTeor
                
                aporteOsocTeor = Percentage(porcObSoc,exenMesTeor) - osocPagaAntMismoMesTeo            
                SAR_BONO_IG_OSOC_TEO = aporteOsocTeor
                
                aporteAdosTeor = Percentage(porcAdObSoc,exenMesTeor) - adosPagaAntMismoMesTeo            
                SAR_BONO_IG_ADOS_TEO = aporteAdosTeor * SAR_FAM_CARGO_OS
                
                aporteSindTeor = Percentage(porcSind,exenMesTeor) - sindPagaAntMismoMesTeo
                SAR_BONO_IG_SIND_TEO = aporteSindTeor   
            EndIf
    
            'Aportes: en baja o reliquidacion seran los teoricos, agregamos los del mes en caso de baja
            aporteJubFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_JUB_TEO + aporteJubTeor
            aporteLeyFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_LEY_TEO + aporteLeyTeor
            aporteOsocFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_OSOC_TEO + aporteOsocTeor
            aporteAdosFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_ADOS_TEO + aporteAdosTeor
            aporteSindFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_SIND_TEO + aporteSindTeor
        'Si no esta alcanzado todo el bono sera grabado. Parte exenta y aportes quedan a 0
        Else
            gravBonoFinal = bonosAnioIG
            exenBonoFinal = 0
            aporteJubFinal = 0
            aporteLeyFinal = 0
            aporteOsocFinal = 0
            aporteAdosFinal = 0
            aporteSindFinal = 0
        EndIf
    
        'Graba la diferencia entre lo calculado y lo acumulado en el a?o fiscal
        exenMes = exenBonoFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_EXEN_MES
    
        gravMes = gravBonoFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_GRAV_MES
        SAR_BONO_GRAV_MES = gravMes
    
        aporteJubMes = aporteJubFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_JUB
        SAR_BONO_IG_JUB = aporteJubMes
        
        aporteLeyMes = aporteLeyFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_LEY
        SAR_BONO_IG_LEY = aporteLeyMes
    
        aporteOsocMes = aporteOsocFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_OSOC
        SAR_BONO_IG_OSOC = aporteOsocMes
    
        aporteAdosMes = aporteAdosFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_ADOS
        SAR_BONO_IG_ADOS = aporteAdosMes * SAR_FAM_CARGO_OS
    
        aporteSindMes = aporteSindFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_IG_SIND
        SAR_BONO_IG_SIND = aporteSindMes
    EndIf
EndIf

'Reparto en reportes
totalBonoEmpresa = SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_BONOS_27617 + SAR_TOT_BONOS_27617
If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then 
    totalBonoOE = SAR_IMP_BONOS_OE_PAGA + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IMP_BONOS_OE_PAGA
    If esBajaReliq = 1 Then totalBonoOE = SAR_IMP_BONOS_PROD_OE
EndIf

totalExento = SAR_ACM_IG_ANIO_IMPUT[0].SAR_BONO_EXEN_MES + exenMes

If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then totalExentoOe = Min(totalExento,totalBonoOE)
totalExentoResto = Max(totalExento - totalExentoOe,0)
totalExentoEmp = Min(totalExentoResto,totalBonoEmpresa)
If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then totalGravadoOe = Max(totalBonoOE - totalExentoOe,0)
totalGravadoEmp = Max(totalBonoEmpresa - totalExentoEmp,0)

SAR_BONO_GRAV_4CATEG = totalGravadoEmp
SAR_BONO_EXEN_4CATEG = totalExentoEmp

If DxYear(SAR_FEC_IMPUT_IG) < 2023 Then
    SAR_BONO_GRAV_OE = totalGravadoOe
    SAR_BONO_EXEN_OE = totalExentoOe
EndIf

Return(exenMes)
