' son las renumeraciones asociadas al ART imponibles con limite maximo de 75 MOPRES, 
' este concepto fue creado por la LEY 25239 - Reforma Tributaria 

IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
    tope=SAR_TOPE_COTIZ_CNT
ELSE
    SAR_ACM_ACT_CONTRIB.BEGIN()
    'resto al tope lo acumulado en el mes
    tope = SAR_TOPE_COTIZ_CNT - SAR_ACM_ACT_CONTRIB.SAR_BASE_CO_ART_CNT
ENDIF

aux=SAR_ACCIDENTE

diasart=SAR_DIAS_ART
IF diasart = 0 THEN
    basetop = 0
ELSE
    basetop = tope / SAR_DIAS_NORM_COTIZ * diasart
ENDIF
real=SAR_PRESTACION_ART
IF real < basetop THEN
   base = real 
ELSE
   base= basetop
ENDIF   

Return(base)
