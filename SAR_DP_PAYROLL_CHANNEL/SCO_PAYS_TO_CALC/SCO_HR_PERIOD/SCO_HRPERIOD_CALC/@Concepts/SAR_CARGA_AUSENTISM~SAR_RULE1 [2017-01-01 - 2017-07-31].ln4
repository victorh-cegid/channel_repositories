' No se ejecuta en las pagas extras, salvo si en las Pagas Extras de Aguinaldo
If (SAR_TP_IMPUT = "2") AND SAR_IND_AGUINALDO = 0 Then Return(0)

IF SAR_TP_IMPUT = "99" THEN 
    Return(0)
ENDIF

'Obtengo la fecha de inicio y fin de cada tramo

INICIO_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysStartDate
FIN_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysEndDate


'para que se ejecuten antes de hacer la asignación y funcione en revisión


aux = SAR_DIA_DONAR_SANG     'Donación Sangre
aux = SAR_DIAS_EXAMEN        'Lic. Examen 
aux = SAR_DIAS_DEFUNCION     'Lic.Defunción
aux = SAR_DIAS_NACIMIENTO    'Lic.Nacimiento
aux = SAR_DIAS_CASAMIENTO    'Lic.Casamiento
aux = SAR_DIAS_VACACIONES    'Vacaciones
aux = SAR_DIAS_HUELGA        'Huelga
aux = SAR_DIAS_LIC_CONV      'Lic.Convenio
aux = SAR_LIC_S_GOC_SUELD    'Lic.sin Goce de Sueldo
aux = SAR_DIAS_EXCEDENCIA    'Excedencia
aux = SAR_DIAS_SUS_DISCI     'Suspensión
aux = SAR_DIAS_ENFERMEDAD    'Enfermedad
aux = SAR_DIAS_MATERN        'Maternidad
aux = SAR_DIAS_AUSENCIA      'Ausencia sin aviso
aux = SAR_R_PTO_ACC          'Reserva de Puesto por Accidente
aux = SAR_R_PTO_ENF          'Reserva de Puesto por Enfermedad
aux = SAR_R_PTO_SIN          'Reserva de Puesto por Actividad Sindical
'Bug(0310670) - No eliminar el código
'aux = SAR_UN_HORAS_150
aux = SAR_UNIDAD_HS_AUSENCIA
aux = SAR_UN_FER_TRAB

'Cantidades de días de licencias

dias_enf = 0        'días de enfermedad
dias_acc = 0        'días accidente
dias_mat = 0        'días maternidad
dias_lconv = 0      'días de licencia convenio
dias_lsgs = 0       'días de licencia sin goce de sueldo
dias_exced = 0      'días de excedencia
dias_ausin = 0      'días de ausencia injustificada
dia_huelga = 0      'días de huelga
dias_vac = 0        'días de descuento vacaciones
dias_lic_vac = 0    'días licencia vacaciones
dias_lcas = 0       'días licencia casamiento
dias_lnac = 0       'días licencia nacimiento
dias_ldef = 0       'días de licencia por defunción
dias_lex = 0        'días de licencia por examen
dias_dsan = 0       'días donación de sangre
dias_susp=0         'días suspensión
dias_re_acc = 0     'días de reserva de puesto por accidente
dias_re_enf = 0     'días de reserva de puesto por enfermedad
dias_re_sin = 0     'días de reserva de puesto por actividad sindical
'Bug(0310670) - No eliminar el código
'horas_150 = 0       'horas al 150%
horas_ausencia = 0  'horas ausencia
d_tomados = 0 
plus_noc_100 = 0    'plus nocturno 100%
horas_fer_trab = 0  'horas feriado trabajado


dias_vacaciones_recalc = 0

'Fechas para topear:
'5 Lic. sin  Goce de Sueldo
    fec_fin_abs_lsgs   = ToDate("1800-01-01")
'6 Excedencia
    fec_fin_abs_exced  = ToDate("1800-01-01")
'1 Enfermedad
    fec_fin_abs_enfer  = ToDate("1800-01-01")
'3 Maternidad
    fec_fin_abs_matern = ToDate("1800-01-01")
'31 Reserva de Puesto por Accidente
    fec_fin_abs_rpa    = ToDate("1800-01-01")
'30 Reserva de Puesto por Enfermedad
    fec_fin_abs_rpe    = ToDate("1800-01-01")
'32 Reserva de Puesto por Actividad Sindical*/
    fec_fin_abs_rpas   = ToDate("1800-01-01")

'Verificamos si el empleado posee ausentismos a nivel de Periodo y a nivel de Role
'Si posee a nivel de Rol, contamos las Hs de ausencia y las Hs Extras

REG_AUSENTISMOS = SAR_REAL_TIME_PERIOD.COUNT()


REG_HS_AUSENCIA = 0
SAR_HR_ROLE.BEGIN()
WHILE SAR_HR_ROLE.ISEOF() = FALSE
    IF SAR_REAL_TIME_PER_ROLE.COUNT() > 0 THEN
        REG_HS_AUSENCIA = REG_HS_AUSENCIA + 1
        SAR_REAL_TIME_PER_ROLE.BEGIN()
        WHILE SAR_REAL_TIME_PER_ROLE.ISEOF() = FALSE
            'Para calcular las unidades de Horas Extras y ausencias se tiene en cuenta que la 
            'fecha de inicio del ausentismo esté comprendida en el tramo que se está procesando.
            IF INICIO_TRAMO <= SAR_REAL_TIME_PER_ROLE.SCO_DT_START AND SAR_REAL_TIME_PER_ROLE.SCO_DT_START <=  FIN_TRAMO THEN 
                motivoabs = FORMAT(SAR_REAL_TIME_PER_ROLE.SCO_ID_INC_GROUP,0)
                fec_abs = SAR_REAL_TIME_PER_ROLE.SCO_DT_END

                
                '
                'Para contar las Hs de ausencia consideramos el tipo de incidencia SCO_ID_INC_GROUP
                '
                IF motivoabs = "500" THEN
                    horas_ausencia = horas_ausencia + SAR_REAL_TIME_PER_ROLE.SCO_UNITS
                ENDIF
                '
                'Para contar las Hs Extras consideramos el ID de incidencia SCO_ID_INCIDENCE
                '
                idabs = FORMAT(SAR_REAL_TIME_PER_ROLE.SCO_ID_INCIDENCE,0)
                'Calculamos las unidades de las horas extras al 50%
                'Bug(0310670) - No eliminar el código
                'IF idabs = "35" THEN
                '   horas_150 = horas_150 + SAR_REAL_TIME_PER_ROLE.SCO_UNITS
                'Fin Bug(0310670)
                IF idabs = "54" THEN  
                'Calculamos las unidades de las horas de feriado trabajado
                   horas_fer_trab = horas_fer_trab + SAR_REAL_TIME_PER_ROLE.SCO_UNITS
                ENDIF


            ENDIF
            SAR_REAL_TIME_PER_ROLE.GONEXT()
        WEND
    ENDIF
    SAR_HR_ROLE.GONEXT()
WEND



'Se busca si existe un registro para esta paga en la tabla Vacaciones a Descontar.
'En caso que exista se elimina.
'--------------------------------------------------------------------------------.  
IF REG_AUSENTISMOS = 0 THEN
    SAR_VAC_DELETE.begin()
    if SAR_VAC_DELETE.COUNT() > 0 Then
        primerreg_vac = 0
        ultimoreg_vac = SAR_VAC_DELETE.COUNT() - 1
        FOR  I = primerreg_vac  TO  ultimoreg_vac 
             SAR_VAC_DELETE.MOVETO(I)
             fec_pago_del = SAR_VAC_DELETE.SCO_DT_PAY
             if fec_pago_del = SCO_DT_PAYMENT Then
                'Se elimina el registro existente.
                '--------------------------------.
                SAR_VAC_DELETE.Deleteregister()
                '--------------------------------.
             endif
        NEXT
    endif
ENDIF


IF REG_AUSENTISMOS = 0 THEN
    IF REG_HS_AUSENCIA = 0 THEN
        Return(0)
    ENDIF
ENDIF



'Ahora contabilizamos las ausencias diarias que se cargan a nivel de period



primerreg = 0
ultimoreg = SAR_REAL_TIME_PERIOD.COUNT() - 1


'Asigno las fechas de inicio y fin de tramo

fec_ini_paga = INICIO_TRAMO
fec_fin_paga = FIN_TRAMO
FOR  I = primerreg  TO  ultimoreg 
    SAR_REAL_TIME_PERIOD.MOVETO(I)
    motivoabs = FORMAT(SAR_REAL_TIME_PERIOD.SCO_ID_INCIDENCE,0)
    fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
    fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END
    '
    'Contabilizo la cantidad de días y si el tipo de salario es Horario, 
    'traspaso las unidades a horas
    '
    IF SAR_TIPO_SALARIO <> "003" THEN    
        IF motivoabs = "1" THEN
            dias_enf = dias_enf + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
            'Agregado por exceso de días ---------------------------------- 
            if fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
                dias_enf = dias_enf -1                                 '  |
            endif                                                      '  |
            'Fin agregado por exceso de días-------------------------------
        ELSEIF motivoabs = "2" THEN
            dias_susp = dias_susp + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "3" THEN
            dias_mat = dias_mat + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
            'Agregado por exceso de días ---------------------------------- 
            if fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
                dias_mat = dias_mat -1                                 '  |
            endif                                                      '  |
            'Fin agregado por exceso de días-------------------------------
        ELSEIF motivoabs = "4" THEN
            dias_lconv = dias_lconv + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "5" THEN
            dias_lsgs = dias_lsgs + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
            'Agregado por exceso de días ---------------------------------- 
            if fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
                dias_lsgs = dias_lsgs -1                               '  |
            endif                                                      '  |
            'Fin agregado por exceso de días-------------------------------
        ELSEIF motivoabs = "6" THEN
            dias_exced = dias_exced + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) 
            fecha_ini_exced = fec_ini_abs
            fecha_fin_exced = fec_fin_abs
            'Agregado por exceso de días ---------------------------------- 
            if fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
                dias_exced = dias_exced -1                             '  |
            endif                                                      '  |
            'Fin agregado por exceso de días-------------------------------
        ELSEIF motivoabs = "7" THEN
            dias_ausin = dias_ausin + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "8" THEN
            dia_huelga = dia_huelga + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "9" THEN
            dias_vac = dias_vac + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
            fecha_ini_vac = fec_ini_abs
            fecha_fin_vac = fec_fin_abs
        ELSEIF motivoabs = "10" THEN
            dias_lcas = dias_lcas + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "11" THEN
            dias_lnac = dias_lnac + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "12" THEN
            dias_ldef = dias_ldef + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "13" THEN
            dias_lex = dias_lex + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "17" THEN
            dias_dsan = dias_dsan + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
        ELSEIF motivoabs = "31" THEN
            dias_re_acc = dias_re_acc + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
            'Agregado por exceso de días ---------------------------------- 
            if fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
                dias_re_acc = dias_re_acc -1                           '  |
            endif                                                      '  |
            'Fin agregado por exceso de días-------------------------------
        ELSEIF motivoabs = "30" THEN
            dias_re_enf = dias_re_enf + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
            'Agregado por exceso de días ---------------------------------- 
            if fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
                dias_re_enf = dias_re_enf -1                           '  |
            endif                                                      '  |
            'Fin agregado por exceso de días-------------------------------
        ELSEIF motivoabs = "32" THEN
            dias_re_sin = dias_re_sin + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs )
            'Agregado por exceso de días ---------------------------------- 
            if fec_fin_abs >= FIN_TRAMO and DXDAY(FIN_TRAMO) > 30 then '  |
                dias_re_sin = dias_re_sin -1                           '  |
            endif                                                      '  |
            'Fin agregado por exceso de días-------------------------------
        ENDIF           
    ELSE 'tipo salario horario
        IF SCO_NUM_HOURS_THEO > 0 THEN
            IF fec_fin_abs > fec_fin_paga then
               fec_fin_abs = fec_fin_paga
            ENDIF
            IF fec_ini_abs < fec_ini_paga then
               fec_ini_abs = fec_ini_paga
            ENDIF
        ENDIF
        IF motivoabs = "1" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_enf = dias_enf + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_enf = dias_enf + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "2" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_susp = dias_susp + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_susp = dias_susp + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "3" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_mat = dias_mat + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_mat = dias_mat + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "4" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_lconv = dias_lconv + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_lconv = dias_lconv + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "5" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
               dias_lsgs = dias_lsgs + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
               dias_lsgs = dias_lsgs + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "6" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_exced = dias_exced + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_exced = dias_exced + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "7" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_ausin = dias_ausin + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_ausin = dias_ausin + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "8" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dia_huelga = dia_huelga + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dia_huelga = dia_huelga + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "9" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_vac = dias_vac + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_vac = dias_vac + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM
            ENDIF
        ELSEIF motivoabs = "10" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_lcas = dias_lcas + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_lcas = dias_lcas + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "11" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_lnac = dias_lnac + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_lnac = dias_lnac + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "12" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_ldef = dias_ldef + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_ldef = dias_ldef + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "13" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_lex = dias_lex + SAR_CALC_HORAS_TEORICAS (fec_ini_abs,fec_fin_abs)
            ELSE
                dias_lex = dias_lex + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "17" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_dsan = dias_dsan + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_dsan = dias_dsan + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "31" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_re_acc = dias_re_acc + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_re_acc = dias_re_acc + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "30" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
                dias_re_enf = dias_re_enf + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_re_enf = dias_re_enf + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSEIF motivoabs = "32" THEN
            IF SCO_NUM_HOURS_THEO > 0 THEN
               dias_re_sin = dias_re_sin + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
            ELSE
                dias_re_sin = dias_re_sin + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ENDIF
    ENDIF
NEXT



'Contabilizamos las vacaciones
'                             
primerreg = 0
ultimoreg = SAR_VACACIONES.COUNT() - 1
FOR  I = primerreg  TO  ultimoreg 
    SAR_VACACIONES.MOVETO(I)
    motivoabs = FORMAT(SAR_VACACIONES.SCO_ID_INCIDENCE,0)
    fec_ini_abs = SAR_VACACIONES.SCO_DT_START
    fec_fin_abs = SAR_VACACIONES.SCO_DT_END

    'Calculo de los días a pagar de vacaciones
    IF SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC <= fec_ini_abs AND fec_ini_abs <= SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC THEN
        fec_ini_tramo = INICIO_TRAMO
        fec_fin_tramo = FIN_TRAMO
        IF FIN_TRAMO = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC THEN
            fec_fin_tramo = fec_fin_abs
        ENDIF
        IF  SAR_TIPO_SALARIO <> "003" THEN             
            dias_lic_vac = dias_lic_vac + CommonTime(fec_ini_tramo , fec_fin_tramo , fec_ini_abs , fec_fin_abs) 
        ELSEIF SCO_NUM_HOURS_THEO > 0 THEN
                dias_lic_vac = dias_lic_vac + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)              
            ELSE
                dias_lic_vac = dias_lic_vac + CommonTime(fec_ini_tramo , fec_fin_tramo , fec_ini_abs , fec_fin_abs) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ENDIF

NEXT

                     
tipo_paga = SAR_PAYS_TO_CALC.SCO_PAY_TYPE_PAYM

FECHA_FIN_TRAMO = FIN_TRAMO



IF SAR_TIPO_SALARIO = "001" THEN
    IF DXDAY(FIN_TRAMO) > 30 THEN
        DIA = "30"
        MES = DXMONTH(FIN_TRAMO)
        IF MES < 10 THEN
            MES = "0" + TOSTRING(MES,0)
        ELSE
            MES = TOSTRING(MES,0)
        ENDIF
        ANIO = TOSTRING(DXYEAR(FIN_TRAMO),0)
        STR_FECHA = ANIO + "-" + MES + "-" + DIA
        FECHA_FIN_TRAMO = TODATE(STR_FECHA)
    ENDIF
    IF DXMONTH(FIN_TRAMO) = 2 THEN
        IF DXDAY(FIN_TRAMO) = 28 THEN
            FECHA_FIN_TRAMO = FECHA_FIN_TRAMO + 2
        ELSEIF DXDAY(FIN_TRAMO) = 29 THEN
            FECHA_FIN_TRAMO = FECHA_FIN_TRAMO + 1
        ENDIF
    ENDIF
ENDIF

'Calculo los días del tramo
dias_tramo = (FECHA_FIN_TRAMO - INICIO_TRAMO) + 1

'Calculo los días del tramo real
dias_tramo_real = FIN_TRAMO - INICIO_TRAMO + 1

IF dias_lex > 0 THEN
    IF dias_lex = dias_tramo_real AND SAR_TIPO_SALARIO = "001" THEN
        dias_lex = Max(dias_lex, dias_tramo)        'para los mensuales en febrero
    ENDIF
    IF SAR_TIPO_SALARIO = "001" THEN 'es mensual
        maxdias_lex = dias_tramo       
    ELSE
        IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario horario
            IF SCO_NUM_HOURS_THEO > 0 THEN
                maxdias_lex = SAR_CALC_HORAS_TEORICAS(INICIO_TRAMO,FIN_TRAMO)
            ELSE
                maxdias_lex = dias_tramo_real * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSE
