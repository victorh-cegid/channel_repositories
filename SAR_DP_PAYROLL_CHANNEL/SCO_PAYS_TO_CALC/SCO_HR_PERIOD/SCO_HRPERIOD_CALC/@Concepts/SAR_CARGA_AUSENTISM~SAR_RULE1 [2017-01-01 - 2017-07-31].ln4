        dia_huelga = Max(SAR_DIAS_HUELGA, dias_tramo)        'para los mensuales en febrero
    ENDIF
    IF SAR_TIPO_SALARIO = "001" THEN 'es mensual
        maxdias_huelga = dias_tramo       
