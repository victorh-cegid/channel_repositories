    dia_huelga = Min(dia_huelga, maxdias_huelga)
    dia_huelga = Max(dia_huelga, 0)
ENDIF

'*-------------------------------------------------------------
/* se descomento*/
IF dias_vac > 0 And  SAR_TIPO_SALARIO <> "001" THEN 

    'Se busca si existe un registro para esta paga en la tabla Vacaciones a Descontar.
    '--------------------------------------------------------------------------------.  
    SAR_VAC_DELETE.begin()
    if SAR_VAC_DELETE.COUNT() > 0 Then
        primerreg_vac = 0
        ultimoreg_vac = SAR_VAC_DELETE.COUNT() - 1
        FOR  I = primerreg_vac  TO  ultimoreg_vac 
             SAR_VAC_DELETE.MOVETO(I)
             fec_pago_del = SAR_VAC_DELETE.SCO_DT_PAY
             fec_inicio_del = SAR_VAC_DELETE.DT_START_VAC
           
             if fec_pago_del = SCO_DT_PAYMENT and  fec_inicio_del <> fec_ini_abs Then
                'Se elimina el registro existente.
                '--------------------------------.
                SAR_VAC_DELETE.Deleteregister()
                '--------------------------------.
             endif
        NEXT
    Endif
    '--------------------------------------------------------------------------------.
        
    IF dias_vac = dias_tramo_real AND tipo_paga = "1" THEN
        dias_vac = Max(dias_vac, dias_tramo)        'para los mensuales en febrero
    ENDIF
    IF SAR_TIPO_SALARIO = "001" THEN 'es mensual
        maxdias_vac = dias_tramo       
    ELSE
        IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario horario
            
            IF SCO_NUM_HOURS_THEO > 0 THEN
                maxdias_vac = SAR_CALC_HORAS_TEORICAS(INICIO_TRAMO,FIN_TRAMO)
            ELSE
                maxdias_vac = dias_tramo_real * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSE
            maxdias_vac = dias_tramo_real
        ENDIF
    ENDIF
       dias_vac = Min(dias_vac, maxdias_vac)
       dias_vac = Max(dias_vac, 0)

    If (FIN_TRAMO = SAR_HR_PERIOD.SCO_DT_ALLOC_END) and (dias_vac > 0) Then
        pos = 0
        fin_inc = 0

        if SAR_VAC_DESC.count() = 0 then 
               SAR_VAC_DESC.SAR_DT_ALLOC_START = fec_ini_abs               
               SAR_VAC_DESC.SCO_ID_INCIDENCIA = "9"               
               SAR_VAC_DESC.LOAD_BLK()
        endif  
        If dias_tramo_real < dias_lic_vac Then
            SAR_VAC_DESC.begin()
            'Se verifica si existe el registro con datos de la paga, si no existe inserto el registro.
            IF SAR_VAC_DESC.count()=0 THEN 
                        'Se inserta nuevo registro en Vacaciones a Descontar
                        SAR_VAC_DESC.Addregister()
                        SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
                        SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
                        SAR_VAC_DESC.SAR_DIAS_TOMADOS = dias_lic_vac
                        SAR_VAC_DESC.SAR_DIAS_DESCONT = dias_vac
                        SAR_VAC_DESC.SCO_DT_PAY = SCO_DT_PAYMENT
                        SAR_VAC_DESC.SCO_DT_ALLOC = SCO_DT_ALLOCATION
                        'A continuación el campo nuevo: la ID de Incidencia = 9                           
                        SAR_VAC_DESC.SCO_ID_INCIDENCE = "9"
'                    endif
             ELSE
             'Se actualizan los datos, dado que el registro existe.   
                SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
                SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
                SAR_VAC_DESC.SAR_DIAS_TOMADOS = dias_lic_vac
                SAR_VAC_DESC.SAR_DIAS_DESCONT = dias_vac
            Endif
        Else
            'Se busca el registro con el inicio de la incidencia.                 
            pos =  SAR_VAC_DESC.FINDREGISTER("DT_START_VAC",fec_ini_abs,equal,0)                                   

            IF POS <> -1  tHEN
                SAR_VAC_DESC.moveto(pos)           
                dias_tomados = SAR_VAC_DESC.SAR_DIAS_TOMADOS  
                dias_descontados = SAR_VAC_DESC.SAR_DIAS_DESCONT  
                fec_paga =  SAR_VAC_DESC.SCO_DT_PAY 
                fec_imput =  SAR_VAC_DESC.SCO_DT_ALLOC 

                'Se verifica si el fin de la incidencia corresponde a la paga que se esta calculando.
                'En caso afirmativo, fin_inc valdra 1, de lo contrario valdra 0.
                '------------------------------------------------------------------------------------------------------------
                fin_inc = commontime(SAR_HR_PERIOD.SCO_DT_ALLOC_START, SAR_HR_PERIOD.SCO_DT_ALLOC_END,fec_fin_abs,fec_fin_abs)
                '------------------------------------------------------------------------------------------------------------
                'Se verifica que la paga calculada exista en la tabla SAR_VAC_DESC, 
                'para analizar si corresponde insertar un nuevo registro o actualizarlo.
                If (fec_paga <> SCO_DT_PAYMENT)  then
                        'Se inserta nuevo registro en Vacaciones a Descontar 
                         SAR_VAC_DESC.Addregister()
                         SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
                         SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
       
                         SAR_VAC_DESC.SAR_DIAS_TOMADOS = dias_tomados
                         if fin_inc = 1 then
                             'El fin de la incidencia corresponde al mes de la paga que se esta calculando.
                             'Por lo que se debe modificar dias_vac que es el valor a descontar en la paga actual
                             'de manera que coincida con los dias reales pagos de la incidencia.
                             SAR_VAC_DESC.SAR_DIAS_DESCONT = dias_tomados
                             dias_vac = dias_tomados - dias_descontados                      
                         else
                             SAR_VAC_DESC.SAR_DIAS_DESCONT = dias_descontados + dias_vac
                         endif
                         SAR_VAC_DESC.SCO_DT_PAY = SCO_DT_PAYMENT
                         SAR_VAC_DESC.SCO_DT_ALLOC = SCO_DT_ALLOCATION
                         'A continuación el campo nuevo: la ID de Incidencia = 9  
                         SAR_VAC_DESC.SCO_ID_INCIDENCE = "9"
                Else
                    
                    'Se elimina el registro existente.
                    '--------------------------------.
                    SAR_VAC_DESC.Deleteregister()
                    '--------------------------------.

                    'Se verifica si es revision.
                    if SCO_DT_PAYMENT = SCO_DT_ALLOCATION then
                        'Se obtiene la posicion siguiente.
                        '--------------------------------.
                        SAR_VAC_DESC.getcurrent()
                        SAR_VAC_DESC.moveto(pos + 1)
                        '--------------------------------.
                        If(SAR_VAC_DESC.isEOF() = FALSE)Then
                          dias_tomados = SAR_VAC_DESC.SAR_DIAS_TOMADOS  
                          dias_descontados = SAR_VAC_DESC.SAR_DIAS_DESCONT
                        EndIf
                    else
                        'Se obtiene la posicion.
                        '--------------------------------.
                        SAR_VAC_DESC.getcurrent()
                        SAR_VAC_DESC.moveto(pos + 2)
                        '--------------------------------.
                        If(SAR_VAC_DESC.isEOF() = FALSE)Then
                           dias_tomados = SAR_VAC_DESC.SAR_DIAS_TOMADOS  
                           dias_descontados = SAR_VAC_DESC.SAR_DIAS_DESCONT
                        EndIf   
                    endif    

                    'Se inserta nuevo registro en Vacaciones a Descontar
                    SAR_VAC_DESC.Addregister()
                    SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
                    SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
                    SAR_VAC_DESC.SAR_DIAS_TOMADOS = dias_tomados
                    if fin_inc = 1 then
                        'El fin de la incidencia corresponde al mes de la paga que se esta calculando.
                        'Por lo que se debe modificar dias_vac que es el valor a descontar en la paga actual
                        'de manera que coincida con los dias reales pagos de la incidencia.
                         SAR_VAC_DESC.SAR_DIAS_DESCONT = dias_tomados
                         dias_vac = dias_tomados - dias_descontados                     
                    else
                        SAR_VAC_DESC.SAR_DIAS_DESCONT = dias_descontados + dias_vac
                    endif
                    SAR_VAC_DESC.SCO_DT_PAY = SCO_DT_PAYMENT
                    SAR_VAC_DESC.SCO_DT_ALLOC = SCO_DT_ALLOCATION
                   'A continuación el campo nuevo: la ID de Incidencia = 9  
                    SAR_VAC_DESC.SCO_ID_INCIDENCE = "9"                        
                EndIf
               '---------------------------------------------------------------------------------------
            EndIf
        EndIf
    EndIf
EndIf
'*----------------------------------
/*se descomento*/ 

