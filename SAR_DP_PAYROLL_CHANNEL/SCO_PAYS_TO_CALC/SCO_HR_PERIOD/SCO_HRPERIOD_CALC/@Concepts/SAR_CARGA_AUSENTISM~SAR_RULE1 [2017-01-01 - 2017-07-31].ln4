IF  dias_re_enf > 0 THEN
    IF  dias_re_enf = dias_tramo_real AND tipo_paga = "1" THEN
        dias_re_enf = Max(dias_re_enf, dias_tramo)        'para los mensuales en febrero
    ENDIF
    IF SAR_TIPO_SALARIO = "001" THEN 'es mensual
        maxdias_re_enf = dias_tramo       
    ELSE
        IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario horario
            
            IF SCO_NUM_HOURS_THEO > 0 THEN
                maxdias_re_enf = SAR_CALC_HORAS_TEORICAS(INICIO_TRAMO,FIN_TRAMO)
            ELSE
                maxdias_re_enf = dias_tramo_real * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSE
            maxdias_re_enf = dias_tramo_real
        ENDIF
    ENDIF
    dias_re_enf = Min(dias_re_enf, maxdias_re_enf)
    dias_re_enf = Max(dias_re_enf, 0)
ENDIF
IF  dias_re_sin > 0 THEN
    IF  dias_re_sin = dias_tramo_real AND tipo_paga = "1" THEN
        dias_re_sin = Max(dias_re_sin, dias_tramo)        'para los mensuales en febrero
    ENDIF
    IF SAR_TIPO_SALARIO = "001" THEN 'es mensual
        maxdias_re_sin = dias_tramo       
    ELSE
        IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario horario
            
            IF SCO_NUM_HOURS_THEO > 0 THEN
                maxdias_re_sin = SAR_CALC_HORAS_TEORICAS(INICIO_TRAMO,FIN_TRAMO)
            ELSE
                maxdias_re_sin = dias_tramo_real * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSE
            maxdias_re_sin = dias_tramo_real
        ENDIF
    ENDIF
    dias_re_sin = Min(dias_re_sin, maxdias_re_sin)
    dias_re_sin = Max(dias_re_sin, 0)
ENDIF




'Asigno las cantidades obtenidas a los conceptos correspondientes

SAR_DIA_DONAR_SANG = dias_dsan
SAR_DIAS_EXAMEN = dias_lex
SAR_DIAS_DEFUNCION = dias_ldef
SAR_DIAS_NACIMIENTO = dias_lnac
SAR_DIAS_CASAMIENTO = dias_lcas
SAR_DIAS_VACACIONES = dias_vac
SAR_UN_VACACIONES = dias_lic_vac
SAR_DIAS_HUELGA = dia_huelga
SAR_DIAS_LIC_CONV = dias_lconv
SAR_LIC_S_GOC_SUELD = dias_lsgs
SAR_R_PTO_ACC = dias_re_acc
SAR_R_PTO_ENF = dias_re_enf
SAR_R_PTO_SIN = dias_re_sin
SAR_DIAS_EXCEDENCIA = dias_exced
SAR_DIAS_SUS_DISCI = dias_susp 
SAR_DIAS_ENFERMEDAD = dias_enf
SAR_DIAS_MATERN = dias_mat
SAR_DIAS_AUSENCIA = dias_ausin
