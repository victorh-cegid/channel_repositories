'Con la línea #702 = 0 se controla si le corresponde cobrar o no asignacion
'por hijo, en el caso de que el valor sea 0 el concepto valdrá 0 y de esta 
'forma se grabará en el acumulado la cantidad correcta de hijos abonados.
'

IF  SAR_FAMILIARES.COUNT() = 0 THEN
   Return(0)
ENDIF

ayuda_1 = 0
ayuda_2 = 0
contador_1 =0
contador_2 =0
motivodesc = ""

primerreg = 0
ultimoreg = SAR_FAMILIARES.COUNT() -1
FOR I = primerreg TO ultimoreg 
    SAR_FAMILIARES.MOVETO(I)
    parent = SAR_FAMILIARES.STD_ID_ACT_DEP_TYPE
    fec_nac = SAR_FAMILIARES.STD_DT_BIRTH
    edad = DATEDIFF(fec_nac,SAR_FAMILIARES.SAR_DT_ALLOC_END,M4_YEAR)
    IF SAR_INCAPACIDAD_FAM.COUNT() > 0 THEN
        incap = "S"
    ELSE
        incap = "N"
    ENDIF
    nro_familiar = SAR_FAMILIARES.STD_OR_DEP_NB
    f_asig = SAR_FAMILIARES.STD_DT_START
    pago=0
    marca = 0
    ban = 0
    
    IF SAR_FAM_A_CARGO.COUNT() > 0 THEN
        primerreg_1 = 0
        ultimoreg_1 = SAR_FAM_A_CARGO.COUNT() -1
        FOR P = primerreg_1 TO ultimoreg_1 
            SAR_FAM_A_CARGO.MOVETO(P)
            motivodesc = SAR_FAM_A_CARGO.SAR_ID_TIPO_ASIG
            fec_cert= SAR_FAM_A_CARGO.SAR_DT_PRES_CERT            
            fvt_dec_jur = SAR_FAM_A_CARGO.SAR_DT_DEC_JUR
        NEXT
    endif

    '
    'Condición para contabilizar los Hijos a Cargo
    '
    IF SAR_PR_AS_HIJOS <> 0 AND incap = "N" AND motivodesc = "01" AND (parent = "2" OR parent = "7" OR parent = "8") AND (fvt_dec_jur >= SAR_FAMILIARES.SAR_DT_ALLOC_END OR fec_cert <= SAR_FAMILIARES.SAR_DT_ALLOC_END) AND (edad < 18 or (edad = 18 AND (DXMonth(fec_nac) = DXMonth(SCO_DT_ALLOCATION)))) THEN
        contador_1 = contador_1 + 1
        pago_1 = 1
    ENDIF
    '
    'Condición para contabilizar los Hijos con Incapacidad a Cargo
    '
    IF SAR_PR_AS_HIJO_INC <> 0 AND ( incap = "S" AND (parent = "2" OR parent = "7" OR parent = "8")) AND motivodesc = "01" AND fvt_dec_jur >= SAR_FAMILIARES.SAR_DT_ALLOC_END THEN
        contador_2 = contador_2 + 1
        pago_2 = 1
    ENDIF
    
    IF pago_1 = 1 THEN
        IF SAR_ESCOLARIDAD.COUNT() > 0 THEN
            primesc = 0
            ultimesc = SAR_ESCOLARIDAD.COUNT() - 1
            FOR K = 0 TO ultimesc
                SAR_ESCOLARIDAD.MOVETO(K)
                f_fin_cert = SAR_ESCOLARIDAD.SAR_DT_END_CERT
                f_ini = SAR_ESCOLARIDAD.DT_START
                f_inscrip = SAR_ESCOLARIDAD.SAR_DT_PRES_INSC_ST
                nro_fam_escol = SAR_ESCOLARIDAD.STD_OR_DEP_NB
                anio_fin = DXYEAR(f_fin_cert)
                anio_inicio = DXYEAR(f_ini)
                IF anio_inicio = DXYEAR(SAR_ESCOLARIDAD.SAR_DT_ALLOC_END) THEN
                    IF nro_familiar = nro_fam_escol AND DXMONTH(SAR_ESCOLARIDAD.SAR_DT_ALLOC_END) >= 2 AND f_inscrip >= SAR_ESCOLARIDAD.SAR_DT_ALLOC_START AND f_inscrip <= SAR_ESCOLARIDAD.SAR_DT_ALLOC_END THEN 
                        ayuda_1 = ayuda_1 + 1    
                    ENDIF
                ENDIF
            NEXT
        ENDIF
    ENDIF
    IF pago_2 = 1 THEN
        IF SAR_ESCOLARIDAD.COUNT() > 0 THEN
            primesc = 0
            ultimesc = SAR_ESCOLARIDAD.COUNT() - 1
            FOR K = primesc TO ultimesc
                SAR_ESCOLARIDAD.MOVETO(K)
                f_fin_cert = SAR_ESCOLARIDAD.SAR_DT_END_CERT
                f_ini = SAR_ESCOLARIDAD.DT_START
                f_inscrip = SAR_ESCOLARIDAD.SAR_DT_PRES_INSC_ST
                nro_fam_escol = SAR_ESCOLARIDAD.STD_OR_DEP_NB
                anio_fin = DXYEAR(f_fin_cert)
                anio_inicio = DXYEAR(f_ini)
                IF anio_inicio = DXYEAR(SAR_ESCOLARIDAD.SAR_DT_ALLOC_END) THEN
                    IF nro_familiar = nro_fam_escol AND DXMONTH(SAR_ESCOLARIDAD.SAR_DT_ALLOC_END) >= 2 AND f_inscrip >= SAR_ESCOLARIDAD.SAR_DT_ALLOC_START AND f_inscrip <= SAR_ESCOLARIDAD.SAR_DT_ALLOC_END THEN 
                        ayuda_2 = ayuda_2 + 1    
                    ENDIF
                ENDIF
            NEXT
        ENDIF
    ENDIF
    
'inicializo las variables pago1 y pago2
pago_1 = 0
pago_2 = 0

NEXT


'
'Primero asigno las cantidades a los conceptos de Hijos con Incapacidad
'
aux = SAR_AYU_ESC_PRIM_IN
aux = SAR_NUM_HIJOS_INC
SAR_AYU_ESC_PRIM_IN = ayuda_2
SAR_NUM_HIJOS_INC = contador_2
'
'Ahora asigno las cantidades a este concepto
'
aux = SAR_AYUDA_ESC_PRIMA
SAR_AYUDA_ESC_PRIMA = ayuda_1

Return(contador_1)
