'Toma su valor a traves del metodo SAR_RET_VALOR_COMPL y lo ejecuta.


SAR_HRPERIOD_CALC.SAR_RET_VALOR_COMPL()

If(SAR_H_COMPLEM_GCIAS.COUNT()=0)Then
    SAR_H_COMPLEM_GCIAS.LOAD_BLK()
EndIf    

IF SAR_H_COMPLEM_GCIAS.COUNT()=0 THEN
   ' SCO_ERROR =1
   SAR_DEBITO_BANCARIO = 0
ELSE
    SAR_H_COMPLEM_GCIAS.BEGIN()
ENDIF


return(SAR_DEBITO_BANCARIO)
