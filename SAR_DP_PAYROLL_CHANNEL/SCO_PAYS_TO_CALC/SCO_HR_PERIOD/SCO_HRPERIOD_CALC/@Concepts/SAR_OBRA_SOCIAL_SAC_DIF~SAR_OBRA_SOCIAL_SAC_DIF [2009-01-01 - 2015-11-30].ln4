IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

If SAR_COEF_JORNADA_PER = 1 Then
    Return (0)
Endif

/*  Primero calculamos la base 
    deberia ser dias para S.A.C. */

tope=(SAR_TOPE_COTIZ*(SAR_U_PAGA_EX_1+SAR_U_PAGA_EX_2)*180)/360
tope_min=((SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO)*(SAR_U_PAGA_EX_1+SAR_U_PAGA_EX_2)*180)/360

sac=(SAR_PAGA_EXTRA_1+SAR_PAGA_EXTRA_2)/SAR_COEF_JORNADA_PER


'Por modificacion del empleado se agrega : And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "17"
IF SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" THEN
    tope=(SAR_TOPE_COTIZ*(SAR_U_EGRESO_PAGA_1+SAR_U_EGRESO_PAGA_2)*180)/360
    tope_min=((SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO)*(SAR_U_EGRESO_PAGA_1+SAR_U_EGRESO_PAGA_2)*180)/360
    sac=(SAR_EGRESO_PAGA_1+SAR_EGRESO_PAGA_2)/SAR_COEF_JORNADA_PER
ENDIF

base= Min(tope,sac)



base = Max(base, tope_min)

/* Fin de la base */

porc = SAR_PORC_OBR_SOCIAL - (SAR_PORC_OBR_SOCIAL*SAR_PP_AP_OB_SOC/100)
precio = base * porc / 100
IF ISNULL(precio) = TRUE THEN
    precio = 0
ENDIF
precio = precio - SAR_OBRA_SOCIAL_SAC
Return(precio)
