'
' son las renumeraciones asociadas al aguinaldo imponibles con limite maximo de 75 MOPRES, 
' este concepto fue creado por la LEY 25239 - Reforma Tributaria 
'
tope=(SAR_TOPE_COTIZ_CNT*(SAR_U_PAGA_EX_1+SAR_U_PAGA_EX_2)*180)/360
sac=SAR_PAGA_EXTRA_1+SAR_PAGA_EXTRA_2

IF SAR_ES_BAJA = 1 THEN
    tope=(SAR_TOPE_COTIZ_CNT*(SAR_U_EGRESO_PAGA_1+SAR_U_EGRESO_PAGA_2)*180)/360
    sac=SAR_EGRESO_PAGA_1 +SAR_EGRESO_PAGA_2
ENDIF

base= Min(tope,sac)
RETURN(base)
