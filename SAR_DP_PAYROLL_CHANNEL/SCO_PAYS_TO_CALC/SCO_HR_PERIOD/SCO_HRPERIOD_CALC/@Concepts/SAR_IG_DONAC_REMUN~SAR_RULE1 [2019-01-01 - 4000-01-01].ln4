topdonac = SAR_BASE_IMP_SUBDONAC * SAR_TOPE_DONAC / 100 ' tope donaciones

'Solo 2023: ante la situacion de 2 periodos fiscales, se estan dando casos de error por superar el tope, se incluye truncate para que no lo supere
If DxYear(SAR_FEC_IMPUT_IG) = 2023 Then topdonac = Truncate(topdonac,2)

donac    = Min(SAR_JUR_DONACIONES,topdonac) 'donaciones 
donac    = Max(donac,0)
Return(donac)
