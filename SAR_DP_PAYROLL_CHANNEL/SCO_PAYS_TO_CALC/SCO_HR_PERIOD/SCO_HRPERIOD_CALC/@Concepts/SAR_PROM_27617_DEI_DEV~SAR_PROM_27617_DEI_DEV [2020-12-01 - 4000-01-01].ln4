'dependencias
a = SAR_TOT_REMUN_27617 + SAR_REM_27617_DEI_DEV

orientacion = 1
fec_aplica = SCO_DT_ALLOCATION
mes_ini = 1
mes_fin = 12
promedio = 0

SAR_CORTE_DED_27617.Begin()
registros = SAR_CORTE_DED_27617.Count()
For i=0 To registros-1
    fecCorte = SAR_CORTE_DED_27617[i].DT_START
    If DxYear(fec_aplica) = DxYear(fecCorte) And DxMonth(fec_aplica) >= DxMonth(fecCorte) Then mes_ini = DxMonth(fecCorte)
Next

SAR_CALCULA_PROM_27617(orientacion,mes_ini,mes_fin,promedio)

Return Round(promedio,SAR_NUM_DEC)
