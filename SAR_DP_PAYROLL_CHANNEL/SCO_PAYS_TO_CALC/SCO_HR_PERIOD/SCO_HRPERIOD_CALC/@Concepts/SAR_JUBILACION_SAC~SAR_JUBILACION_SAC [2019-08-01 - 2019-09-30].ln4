IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

IF (SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2 + SAR_U_EGRESO_PAGA_1 + SAR_U_EGRESO_PAGA_2 + SAR_U_PAGA_AJ_EX_1 + SAR_U_PAGA_AJ_EX_2) = 0 THEN
    Return(0)
ENDIF

edad  = SAR_EDAD
valor = 0

IF edad >= 18 THEN
    porc = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA/100)
    valor = SAR_IMP_JUBI * porc / 100
ENDIF

IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF

' Apliación del Art. 4 del Decreto 561/2019: "... se financiará el aporte personal de los trabajadores
' en relación de dependencia a que se refiere el inciso a) del artículo 10 de la Ley N° 24.241 y sus modificaciones,
' ... durante los meses de agosto y septiembre del año 2019, en una suma equivalente a PESOS DOS MIL ($2.000) 
' mensuales o al CIEN POR CIENTO (100%) de su valor, lo que resulte menor."
TopeArt4Dec561Aux = SAR_FINAN_APO_JUB_AUX

If TopeArt4Dec561Aux = 4561 Then            ' Devolución de la financiación aplicada en pagas anteriores en el mes, en esta paga se superan los 60000 pesos de remuneración bruta devengada

    DifJubSACMesAct = SAR_ACM_MES_ACTUAL_DIF[0].SAR_FINAN_APO_JUB_SAC_DIF
    
    SAR_FINAN_APO_JUB_SAC_DIF = -1 * DifJubSACMesAct                            // Pasamos el importe de la financiación aplicado anterioremente para descontarselo de nuevo al empleado
    
    SAR_IG_JUB_MEN = SAR_IG_JUB_MEN - DifJubSACMesAct                           // Consideramos la financiación para el concepto que va al impuesto
Else
    DiferenciaValores = Min(TopeArt4Dec561Aux, valor)
    DiferenciaValores = Round(DiferenciaValores, SCO_CURR_DECIMALS)
    
    SAR_FINAN_APO_JUB_SAC_DIF = -1 * DiferenciaValores                          // Pasamos el importe de la financiación como negativo
    SAR_FINAN_APO_JUB_AUX     = SAR_FINAN_APO_JUB_AUX - DiferenciaValores
EndIf

Return(valor)
