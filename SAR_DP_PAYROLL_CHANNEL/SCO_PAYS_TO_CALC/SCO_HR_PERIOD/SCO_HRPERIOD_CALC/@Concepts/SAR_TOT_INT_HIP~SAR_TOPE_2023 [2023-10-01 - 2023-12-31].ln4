If DxYear(SAR_FEC_IMPUT_IG) > 2023 Then Return (SAR_TOT_INT_HIP)

'Controla que no se supere el importe anual
valor = SAR_TOT_INT_HIP

importeSep = SAR_ACM_SEP23_DED_REV[0].SAR_IMP_D_IN_HIP
importeCompleto = SAR_TOPE_INT_HIP

If valor + importeSep > importeCompleto Then valor = importeCompleto - importeSep

Return Round(valor,SAR_NUM_DEC)
