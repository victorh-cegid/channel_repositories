'we aren´t saving this data in the year-to-date and we only need this data in presentation, so 
'we don´t need to execute this concept if we are launching the payroll in the server with 
'job scheduler.

NumRec = 0
Ret = "None"


If SCO_HT_PAYS.SCO_FROM_JS <> 1 Then
	NumRec =  SCO_PERSON_CALC.Count()

	If NumRec <> 0 Then
		SCO_PERSON_CALC.MoveTo(0)
		FName = SCO_PERSON_CALC.STD_N_FIRST_NAME
		N1Name = SCO_PERSON_CALC.STD_N_FAMILY_NAME_1
		Ret = FName + " " + N1Name
	Endif

	SCO_AUX_AC_HRPERIOD.SCO_NAME_HR=ret
EndIf

Return(Ret)
