'----------------------------------------------------------------------------------------------------------
'Se cierra la regla de cálculo a partir del 29/02/2016, debido a la publicación del Decreto 394/2016 que
'deja sin efecto los rangos de remuneraciones para determinar los valores correspodientes a aplicar de 
'deducciones.
'----------------------------------------------------------------------------------------------------------


SAR_HR_ROLE.begin()

'Recuperamos el valor del 792 del mes anterior        
Rango = 0
V792_ant = -1
Es_Paga_Diferida = 0

'Iniciamos la lectura del acumulado del periodo:
SCO_AC_HR_PERIOD_READ_1.BEGIN() 'Iniciamos el acumulado y quedamos posicionados en el ultimo registro de haber.
Num_Reg = SCO_AC_HR_PERIOD_READ_1.Count() - 1
If(Num_Reg >= 0)Then
   V792_ant       = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
   Mejor_Remu_Ant = SCO_AC_HR_PERIOD_READ_1.SAR_MAYOR_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
EndIf   

'Buscamos el valor de abril de 2015.
If(Num_Reg >= 0)Then
   Cont  = 0
   Abril = 0
   Alta  = 0
   
   While(Cont <= Num_Reg And (Abril = 0 Or Alta = 0))   
      SCO_AC_HR_PERIOD_READ_1.MoveTo(Cont)
      'Detección de paga diferida para paga 99:
      If(DxMonth(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) <> DxMonth(SCO_AC_HR_PERIOD_READ_1.SAR_FEC_PAGO_IG))Then
         Es_Paga_Diferida = 1
      EndIf
      If(DxMonth(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) = 4 And DxYear(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) = 2015)Then
         Mejor_Remu_Acu_Abril = SCO_AC_HR_PERIOD_READ_1.SAR_MAYOR_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
         Rango_Abril = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
         Abril = 1
      EndIf   
      If(DxMonth(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) = DxMonth(#SAR_FECHA_ALTA) And DxYear(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) = DxYear(#SAR_FECHA_ALTA))Then
         Rango_Del_Alta = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
         Alta = 1
      EndIf   
      Cont = Cont + 1
   Wend 
EndIf

Rango = V792_ant     
'Iniciamos la lectura del acumulado del rol:
If(SAR_HR_PERIOD.SAR_ACM_ZONA = -1)Then
    SCO_AC_HR_ROLE_READ_1.BEGIN() 'Iniciamos el acumulado y quedamos posicionados en el ultimo registro de haber.
    Num_Reg_Role = SCO_AC_HR_ROLE_READ_1.Count() - 1
    If(Num_Reg_Role >= 0)Then
       Zona_ant = SCO_AC_HR_ROLE_READ_1.SAR_INDIC_REDUC_ZON_DES
       SAR_HR_PERIOD.SAR_ACM_ZONA = Zona_ant
    EndIf  
Else    
       Zona_ant = SAR_HR_PERIOD.SAR_ACM_ZONA
EndIf    
Zona_ant = ToString(ToDouble(Zona_ant), 0) 

 
'Buscamos la zona encontrada del mes anterior al de la paga pero actualizada o no segun la Worck location.
Fecha_Previa = DateAdd(SCO_DT_PAYMENT, -1, M4_MONTH)  
Zona_Previa = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(Fecha_Previa)
Zona_Previa = ToString(ToDouble(Zona_Previa), 0)

If(ISNULL(Zona_ant) = M4_TRUE)Then
   Zona_Ant = Zona_Previa
EndIf
'Si no tiene acumulado, significa que es un alta nueva y debe armarse el 792
     
'Se calcula el rango correspondiente al empleado.
If(Es_Paga_Diferida = 1 And #SAR_TP_IMPUT = "99")Then
   IND_DES = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(Fecha_Previa) 
Else
   IND_DES = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(SCO_DT_PAYMENT) 'SAR_HRROLE_CALC.SAR_INDIC_REDUC_ZON_DES..sysTotalSlices(M4_TOTAL_SUM)  'Indicador de zona desfavorable de la paga.
EndIf   

IND_DES = ToString(ToDouble(IND_DES), 0)
MAX_REM = #SAR_MAYOR_REM_IG_2013   'Maxima remuneración de la paga

If(IND_DES <> Zona_Previa Or MAX_REM <> Mejor_Remu_Ant Or IND_DES <> Zona_ant)Then        

    If(MAX_REM <= 15000 )Then 'Rango 1
       Rango = 1
    ElseIf(IND_DES <> "1" And MAX_REM > 15000 And MAX_REM <= 25000)Then 'Rango 2
       Rango = 2
    ElseIf(IND_DES = "1" And MAX_REM > 15000)Then 'Rango 3
       Rango = 3
    ElseIf(MAX_REM > 25000 )Then 'Rango 0
        If(IND_DES = "1")Then
            Rango = 3
        ElseIf(#SAR_FECHA_ALTA < DxDate(1, 9, 2013))Then 
            Rem_Ajuste = Mejor_Remu_Acu_Abril 'La mejor remuneración de abril    
            If(Rem_Ajuste <= 15000)Then
                   Rango_Ajuste = 1
            ElseIf(Rem_Ajuste > 15000 And Rem_Ajuste <= 25000)Then
                   Rango_Ajuste = 2 
            Else   
                   Rango_Ajuste = 0 
            EndIf  
            Rango = Rango_Ajuste
        ElseIf((#SAR_FECHA_ALTA >= DxDate(1, 9, 2013) And Rango_Abril = 2) Or (#SAR_FECHA_ALTA >= DxDate(1, 5, 2015) And Rango_Del_Alta = 2))Then
               Rango_Ajuste = 2 
               Rango = Rango_Ajuste
        Else    
            Rango_Ajuste = 0 
            Rango = Rango_Ajuste
        EndIf
    EndIf
EndIf   


Return(Rango)
