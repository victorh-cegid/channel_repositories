IF SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

edad = SAR_EDAD
base = SAR_REMUN_IMPO + SAR_BASE_COTIZ_ART
valor = 0

IF edad >= 18 THEN
    porc = SAR_PORC_LEY_19032 - (SAR_PORC_LEY_19032 * SAR_PP_AP_INSSJP/100)
    valor = base * porc / 100
ENDIF

IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF

Return(valor)
