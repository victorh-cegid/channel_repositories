If SAR_TP_IMPUT = "99" Or SAR_TP_IMPUT = "88" Then Return(0)

'Calcula todas las remuneraciones imponibles OS. El cálculo se realiza en forma mensual por mes de LSD.
baseRem = 0 : baseRemArt = 0 : baseRemVac = 0 : RemImpoOrig = 0 : RemImpoOrigArt = 0 : RemImpoOrigVac = 0
topeMax = SAR_LSD_TOPE_COTIZ_PROP
tope_min = ((SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO)/30)*SAR_TIEMPO_EFVO_TR

'Los devengos cotizables de la paga de proceso, separados normales/art/vacaciones para realizar posteriormente el reparto
devengosNorm = SAR_LSD_TOT_COTIZ_OS 
devengosArt = SAR_LSD_TOT_PREST_ART_OS 
devengosVac = SAR_LSD_VAC_PLUS_OS
devengosTot = devengosNorm + devengosArt + devengosVac

'En caso de retroactividad, se considera como devengos cotizables de la paga de proceso el importe de la diferencia
If SCO_DT_PAYMENT <> SCO_DT_ALLOCATION Then
    devengosOrigNorm = SCO_AC_HR_PERIOD_REV_1.SAR_LSD_TOT_COTIZ_OS    
    devengosOrigArt = SCO_AC_HR_PERIOD_REV_1.SAR_LSD_TOT_PREST_ART_OS
    devengosOrigVac = SCO_AC_HR_PERIOD_REV_1.SAR_LSD_VAC_PLUS_OS
    RemImpoOrig = SCO_AC_HR_PERIOD_REV_1.SAR_REMUN_IMPO_OS
    RemImpoOrigArt = SCO_AC_HR_PERIOD_REV_1.SAR_BASE_COTIZ_ART_OS
    RemImpoOrigVac = SCO_AC_HR_PERIOD_REV_1.SAR_VAC_IMPO_PLUS_OS
    devengosNorm = devengosNorm - devengosOrigNorm
    devengosArt = devengosArt - devengosOrigArt
    devengosVac = devengosVac - devengosOrigVac
    devengosTot = devengosNorm + devengosArt + devengosVac
EndIf

'Se añaden al cálculo los devengos cotizables de pagas ANTERIORES del mismo mes de LSD, 
'para tener el importe completo sobre el que realizar topes
devengosNormPrev = SAR_LSD_COTIZ[0].SAR_LSD_TOT_COTIZ_OS 
devengosArtPrev = SAR_LSD_COTIZ[0].SAR_LSD_TOT_PREST_ART_OS 
devengosVacPrev = SAR_LSD_COTIZ[0].SAR_LSD_VAC_PLUS_OS
devengosTotPrev = devengosNormPrev + devengosArtPrev + devengosVacPrev

devengosNormLSD = devengosNorm + devengosNormPrev
devengosArtLSD = devengosArt + devengosArtPrev
devengosVacLSD = devengosVac + devengosVacPrev

'En devengosTotMesLSD tenemos todos los devengos sobre los que aplicar topes
devengosTotMesLSD = devengosTot + devengosTotPrev

'Tope máximo mes
baseTopada = Min(topeMax,devengosTotMesLSD)

'Tope mínimo mes, respetando STD actual aplica sólo si existe pago, en pagas de frecuencia 004. Se añade que en retro no aplique minimo si se va por LSD por pago
aplicaMinimo = 0
If baseTopada > 0 And SCO_PAY_FREQ_ALLOC = "004" And (SCO_DT_PAYMENT = SCO_DT_ALLOCATION Or (SCO_DT_PAYMENT <> SCO_DT_ALLOCATION And SAR_LSD_IND_PAGO = 0)) Then aplicaMinimo = 1
If aplicaMinimo = 1 Then baseTopada = Max(baseTopada,tope_min) 

'Reparto de imponibles entre remuneracion/art y vacacciones
If devengosTotMesLSD <> 0 Then
    baseRem = (devengosNormLSD*baseTopada)/devengosTotMesLSD
    baseRemArt = (devengosArtLSD*baseTopada)/devengosTotMesLSD
    baseRemVac = (devengosVacLSD*baseTopada)/devengosTotMesLSD
EndIf

'Considera los imponibles ya aplicada en el mismo mes LSD para ajustar en la paga de proceso (variables "xxxPrev")
'y si estamos en una paga retroactiva considera el importe original para que quede grabada la diferencia (variables "xxxOrig")
baseRemPrev = SAR_LSD_COTIZ[0].SAR_REMUN_IMPO_OS
baseRemArtPrev = SAR_LSD_COTIZ[0].SAR_BASE_COTIZ_ART_OS
baseRemVacPrev = SAR_LSD_COTIZ[0].SAR_VAC_IMPO_PLUS_OS
baseRem = baseRem - baseRemPrev + RemImpoOrig
baseRemArt = baseRemArt - baseRemArtPrev + RemImpoOrigArt
baseRemVac = baseRemVac - baseRemVacPrev + RemImpoOrigVac

'Se mira el indicador de desglose vacaciones, si no está activado las vacaciones se integran en los imponibles normales
If SAR_LSD_IND_DESGLOSE_VAC = 0 Then
    baseRem = baseRem + baseRemVac
    baseRemVac = 0
EndIf

'Asigna a los conceptos
SAR_BASE_COTIZ_ART_OS = Round(baseRemArt,SAR_NUM_DEC)
SAR_VAC_IMPO_PLUS_OS = Round(baseRemVac,SAR_NUM_DEC)

Return Round(baseRem,SAR_NUM_DEC)
