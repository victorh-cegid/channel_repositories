IF #SAR_TP_IMPUT <> "88" THEN
    Return(0)
ENDIF

'Obtengo la próxima paga para poder eliminar e insertar el descuento de anticipo de vacaciones.

SCO_H_HR_PAY_FREQ.BEGIN()
SAR_PROXIMA_PAGA.BEGIN()
POS = SAR_PROXIMA_PAGA.FINDREGISTER("SCO_ID_PAY_FREQUENCY",SCO_H_HR_PAY_FREQ.SCO_ID_PAY_FREQUENCY,EQUAL,0)
IF POS <> -1 THEN
    SAR_PROXIMA_PAGA.MOVETO(POS)
ENDIF

'Asigno los datos de la próxima paga para filtrar el nodo de Anticipo de Vacaciones

SAR_ANTICIPO_VACACIONES.SAR_DT_START = SAR_PROXIMA_PAGA.SCO_DT_START
SAR_ANTICIPO_VACACIONES.SAR_DT_END = SAR_PROXIMA_PAGA.SCO_DT_END
SAR_ANTICIPO_VACACIONES.SAR_DT_ACCRUED = SAR_PROXIMA_PAGA.SCO_DT_ACCRUED
SAR_ANTICIPO_VACACIONES.SAR_ID_PAY_FREQUENCY = SAR_PROXIMA_PAGA.SCO_ID_PAY_FREQUENCY

'Cargo el nodo
IF SAR_ANTICIPO_VACACIONES.COUNT()= 0 THEN
    SAR_ANTICIPO_VACACIONES.LOAD_BLK()
ENDIF

'Si tiene cargado el descuento de anticipo de vacaciones lo elimino

IF SAR_ANTICIPO_VACACIONES.COUNT() <> 0 THEN
    SAR_ANTICIPO_VACACIONES.MOVETO(SAR_ANTICIPO_VACACIONES.COUNT()- 1)
    SAR_ANTICIPO_VACACIONES.DELETEREGISTER()
ENDIF  

'Suma de lo calculado en Anticipo de Vacaciones

IF SAR_VACACIONES.COUNT() = 0 THEN 
    Return(0)
ENDIF

Valor = #SAR_ANTICIPO_VAC..SysTotalslices(M4_TOTAL_SUM)  

SAR_ANTICIPO_VACACIONES.ADDREGISTER()
SAR_ANTICIPO_VACACIONES.ID_DMD = "DMD1"
SAR_ANTICIPO_VACACIONES.ID_DMD_COMPONENT = "SAR_DESC_ANT_VAC"
SAR_ANTICIPO_VACACIONES.DT_START = SAR_PROXIMA_PAGA.SCO_DT_START
SAR_ANTICIPO_VACACIONES.DT_COR_START = SAR_PROXIMA_PAGA.SCO_DT_START
SAR_ANTICIPO_VACACIONES.SCO_DT_ACCRUED = SAR_PROXIMA_PAGA.SCO_DT_ACCRUED
SAR_ANTICIPO_VACACIONES.SCO_ID_PAY_FREQUENCY = SAR_PROXIMA_PAGA.SCO_ID_PAY_FREQUENCY
SAR_ANTICIPO_VACACIONES.DT_END = SAR_PROXIMA_PAGA.SCO_DT_END
SAR_ANTICIPO_VACACIONES.SCO_VALUE = Valor
SAR_ANTICIPO_VACACIONES.ID_PRIORITY = 2
SAR_ANTICIPO_VACACIONES.EX_TYPE = EX_TYPE 
SAR_ANTICIPO_VACACIONES.ID_M4_TYPE = 8
SAR_ANTICIPO_VACACIONES.SCO_ID_CURRENCY = ID_CURRENCY


Return(valor)
