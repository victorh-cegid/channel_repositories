IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

IF SAR_IND_ADH_SUAF = 0 THEN 
    Return(0)
ENDIF

aux = SAR_A_CARGO_HIJOS
IF SAR_PAYS_TO_CALC.SCO_PAY_TYPE_PAYM <> "1" AND SAR_PAYS_TO_CALC.SCO_PAY_TYPE_PAYM <> "4" THEN 
    Return(0)
ENDIF
dias_trab = SAR_DIAS_NORM_SUELD - SAR_DIAS_ANT_ALTA - SAR_DIAS_POST_BAJA - SAR_LIC_S_GOC_SUELD - SAR_DIAS_EXCEDENCIA

IF dias_trab < 1 THEN 
    Return(0)
ENDIF

valor = SAR_AYUDA_ESC_PRIMA * SAR_PR_AY_ESC_PRIM

'Se incluye el tope al cual se tiene derecho para percibir dicha asignacion.
if ((SAR_REMUN_P_SAL_FAM <= 4000) and  (SAR_REMUN_P_SAL_FAM >= SAR_TOPE_S_FAMIL) )then   
     return(valor)
else
    return(0)
endif
