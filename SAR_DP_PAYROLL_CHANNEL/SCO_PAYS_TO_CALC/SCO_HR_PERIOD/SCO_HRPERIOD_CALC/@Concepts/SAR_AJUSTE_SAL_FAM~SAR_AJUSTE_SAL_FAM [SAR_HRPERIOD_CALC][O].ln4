IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR SAR_TP_IMPUT = "77" THEN
    Return(0)
ENDIF

SAR_ACM_PAGO_ULT_ANTERIOR.BEGIN()

IF SAR_ES_BAJA <> 0 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" THEN 
    Return(SAR_INF_AJ_SAL_FAM + SAR_ACM_PAGO_ULT_ANTERIOR.SAR_AJ_SAL_FAM_PEND)
ENDIF

ajuste = 0
tot = 0
valor = 0
ajuste = (SAR_INF_AJ_SAL_FAM + SAR_ACM_PAGO_ULT_ANTERIOR.SAR_AJ_SAL_FAM_PEND)
tot = (SAR_TOT_ASIG_FAM + ajuste)

IF tot < 0 THEN
    valor = SAR_TOT_ASIG_FAM * (-1)
ELSE
    valor=ajuste
ENDIF

Return(valor)
