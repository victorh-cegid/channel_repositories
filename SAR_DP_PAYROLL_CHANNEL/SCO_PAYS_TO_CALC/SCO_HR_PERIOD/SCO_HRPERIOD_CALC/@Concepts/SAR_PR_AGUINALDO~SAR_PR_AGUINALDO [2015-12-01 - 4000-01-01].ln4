' En caso que No sea paga extra de Aguinaldo no se calcula el precio para SAC.
If SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 0 Or SAR_TP_IMPUT = "77" Then Return(0)

remunMesAct = SAR_M_REMUN_INDEM
If SCO_PAY_FREQ_ALLOC = "004" Then remunMesAct = SAR_TOTAL_P_SAC

If DxMonth(SCO_DT_ALLOCATION) < 7 Then
    fec_ini = DxDate("01","01",DxYear(SCO_DT_ALLOCATION))
    fec_fin = DxDate("30","06",DxYear(SCO_DT_ALLOCATION))
Else
    fec_ini = DxDate("01","07",DxYear(SCO_DT_ALLOCATION))
    fec_fin = DxDate("31","12",DxYear(SCO_DT_ALLOCATION))
EndIf

SAR_ACM_6_MESES_SAC.DESTROYBLOCK()
SAR_ACM_6_MESES_SAC.SCO_DT_PAYMENT = fec_fin
SAR_ACM_6_MESES_SAC.SCO_DT_START = fec_ini
SAR_ACM_6_MESES_SAC.SCO_DT_END = fec_fin
SAR_ACM_6_MESES_SAC.Load_Blk()

valor = Max(SAR_ACM_6_MESES_SAC[0].SAR_M_REMUN_INDEM,remunMesAct)/2

Return(valor)
