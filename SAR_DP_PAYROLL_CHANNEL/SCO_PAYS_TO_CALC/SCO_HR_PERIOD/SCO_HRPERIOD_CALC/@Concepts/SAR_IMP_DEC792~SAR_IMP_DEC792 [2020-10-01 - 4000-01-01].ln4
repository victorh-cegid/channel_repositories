valor = SAR_DIAS_DEC792 * SAR_P_DEC792

'Control de tope sipa jornales
If SAR_TIPO_SALARIO = "003" And valor<>0 Then
    tope = Percentage(SAR_PORC_JUBILACION,SAR_TOPE_JUBIL)
    jubNred = Percentage(SAR_PORC_JUBILACION,SAR_IMP_DEC792_NRED+SAR_ACM_ACT_CONTRIB[0].SAR_IMP_DEC792_NRED) + SAR_ACM_ACT_CONTRIB[0].SAR_JUBILACION
    jubNredPagAnt = Percentage(SAR_PORC_JUBILACION,SAR_ACM_ACT_CONTRIB[0].SAR_IMP_DEC792_NRED)
    dif = Max(jubNred - tope,0)
    difPagAnt = Max(jubNredPagAnt - tope,0)
    valor = valor + dif - difPagAnt
    'Se ajusta el precio
    If SAR_DIAS_DEC792 >0 Then SAR_P_DEC792 = valor / SAR_DIAS_DEC792
EndIf

'Se redondean los precios de cara a visualización en recibo.
SAR_P_DEC792 = Round(SAR_P_DEC792,0)
SAR_P_DEC792_NRED = Round(SAR_P_DEC792_NRED,0)

'Si se opta por la "opcion A" de LSD se retorna el importe completo sin reducir
'ya que se expondra el descuento de jubilacion por separado
If SAR_IND_OP_DEC792 = 1 Then
    SAR_IMP_DEC792_JUB_INF = Round(SAR_IMP_DEC792_NRED - valor,SAR_NUM_DEC)
    valor = SAR_IMP_DEC792_NRED
    SAR_P_DEC792 = SAR_P_DEC792_NRED
EndIf

Return Round(valor,SAR_NUM_DEC)
