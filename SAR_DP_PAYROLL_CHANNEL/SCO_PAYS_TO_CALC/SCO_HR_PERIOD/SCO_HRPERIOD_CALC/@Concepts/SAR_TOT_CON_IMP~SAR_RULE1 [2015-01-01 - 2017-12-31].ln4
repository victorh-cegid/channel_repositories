ban = SAR_TOT_REM_IMP

val_otros_empl = SAR_BRUTO_OE
val_ant_emp    = SAR_BASE_ANT_EMP

sar_acum_bruto_oe = 0
sar_acum_bruto_ant_emp = 0

IF SAR_TP_IMPUT = "99" THEN 
    ban = 0
ENDIF

'Recorro el acumulado del empleado y sumarizo los valores para armar las TI.
SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()

I = ULTIMO_REG - 1 

' Si es Paga de RETRO modificamos la fecha para que sea el mes anterior a la fecha de imputacion.
If (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) Then
    vfecha = SCO_DT_ALLOCATION
Else
    vfecha = SAR_FEC_PAGO_IG
EndIf
    

    
WHILE I >= 0 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
       
    ' Armo los datos para SAR_ACM_IMPUESTO    
    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND vfecha > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG  THEN
        sar_acum_bruto_oe      = SCO_AC_HR_PERIOD_READ_1.SAR_BRUTO_OE
        sar_acum_bruto_ant_emp = SCO_AC_HR_PERIOD_READ_1.SAR_BASE_ANT_EMP
    ENDIF
    I = I - 1
Wend

'Entidad 01
If val_ant_emp = sar_acum_bruto_ant_emp Then
    val_ant_emp = 0 
Else    
    val_ant_emp = val_ant_emp - sar_acum_bruto_ant_emp
EndIf

'Entidad 13
if val_otros_empl = sar_acum_bruto_oe then
    val_otros_empl = 0 
else
    val_otros_empl = val_otros_empl - sar_acum_bruto_oe
endif


valor = ban + val_ant_emp + val_otros_empl


IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF

RETURN(valor)
