IF SAR_TP_IMPUT <> "1" AND SAR_TP_IMPUT <> "4" AND SAR_TP_IMPUT = "3" AND SAR_ES_BAJA = 0 THEN 'Tipo mensual y quincenal
    Return(0)  
ELSE
    IF  SAR_REMUN_P_SAL_FAM < SAR_TOPE_S_FAMIL THEN
        valor=0
    ELSE
        valor = SAR_ASIGNACIONES.SAR_RETORNA_VALOR("2", SAR_ID_ZONA_SUB, SAR_REMUN_P_SAL_FAM, ID_CURRENCY)
        IF ISNULL(valor) = TRUE THEN
            valor = 0
        ENDIF
    ENDIF
    Return(valor)
ENDIF
