'Cambio Ganancias Ley 26.731
'las bajas a partir del 28 Diciembre 2011 deben ser procesadas con los valores de las tablas de vigencia del 2011


ind = SAR_IND_DED_IG_2010

'Calculo de la deduccion especial segun informacion recopilada del concepto #792 por Decreto 1242/2013.
'#792 Es el rango obtenido en el que el empleado se ubica segun su Maxima remuneracion y la zona desfavorable 
'Y sus valores posibles para este concepto son:
'2: Empleado que tiene entre 15000$ y 25000$ de rem max y zona no desfavorable.
'3: Empleado que tiene mas de 15000$ de rem max y zona desfavorable.

If(SAR_RANGO_REM_IG_2013 = 3)Then
    RETURN(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("98","SAR_VAL_HIJO_IMP",SAR_FEC_PAGO_IG,ind))
ElseIf(SAR_RANGO_REM_IG_2013 = 2)Then
    RETURN(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("99","SAR_VAL_HIJO_IMP",SAR_FEC_PAGO_IG,ind))
Else
    RETURN(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_VAL_HIJO_IMP",SAR_FEC_PAGO_IG,ind))
EndIf
