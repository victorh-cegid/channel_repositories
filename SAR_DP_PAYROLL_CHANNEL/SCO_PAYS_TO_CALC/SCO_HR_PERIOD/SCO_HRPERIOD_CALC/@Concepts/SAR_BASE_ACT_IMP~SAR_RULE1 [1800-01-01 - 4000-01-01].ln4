IF (#SAR_ES_BAJA = 0) and (#SAR_FECHA_BAJA < SCO_DT_ALLOCATION)  and (#SAR_BASE_IMPUESTO = 0)Then  Return(0)   'condicion para Nomina despues de la baja

SAR_SICORE.BEGIN()

'
'En la primera parte de esta fórmula se calcula la ganancia neta sujeta a impuesto correspondiente
'a la paga actual sólo si el impuesto calculado es >= 0.
'Para esto restamos la ganancia neta acumulada calculada en la paga actual a la calculada en 
'la paga inmediatamente anterior.
'Siempre dentro del mismo año fiscal.
'
aux = 0
fecha = SAR_SICORE.SAR_FECHA_PAGO_IG

IF #SAR_IMPUESTO >= 0 THEN  
	IF DXYear(fecha) <> DXYear(#SAR_FEC_PAGO_IG) THEN
		aux= #SAR_BASE_IMPUESTO
	ELSE
		aux= #SAR_BASE_IMPUESTO - SAR_SICORE.SAR_BASE_IMPUESTO
	ENDIF
ELSE
	
'En la 2da. parte se calcula el último impuesto retenido en la última paga
'sólo si el impuesto actual es < 0.
'Para esto traemos el valor del campo IMPUESTO_ANT de la última paga.
'Siempre dentro del mismo año fiscal.
'Este campo se utiliza en el reporte DGIMEN.RPT para el caso en el que
'la retención que haya que informar sea a favor del contribuyente. 

	IF DXYear(fecha) = DXYear(#SAR_FEC_PAGO_IG) THEN

		aux= #SAR_IMPUESTO_ANT

	ENDIF
ENDIF

RETURN (aux)
