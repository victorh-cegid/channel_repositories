IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR SAR_TP_IMPUT = "77" THEN
    Return(0)
ENDIF

fin_prueba = SAR_DT_END_PRUEBA


'Modificacion 6 de Marzo

'Si el cliente quiere mantener criterio anterior por ser mas favorable (NO tiene mantenimiento en STD)
'o la baja es anterior al 6/3/2026, aplicamos el calculo anterior
indAplicaRl = SAR_IND_INDEMNIZ_RL26
If SAR_FECHA_BAJA < DxDate(6,3,2026) Then indAplicaRl = 0

If indAplicaRl <> 0 Then
    
    IF SAR_FECHA_BAJA <= fin_prueba AND ISNULL(fin_prueba)= FALSE AND fin_prueba <> PLUS_INF THEN
        Return(0)
    EndIf  
    
EndIf

'Fin Modificacion  
   '02/12/2011 Fernando Miguel Siri
   'agregado para detectar si se esta en el fin del periodo de prueba ya que en ese caso este concepto debe retornar 0.
   IF SAR_FECHA_BAJA = fin_prueba Then
     Return(0)
   EndIf
   'fin del agregado

' De acuerdo al articulo 2do. de la Ley 25.877 se considera que se encuentra dentro del periodo a prueba durante 
' los tres primeros meses de la relacion laboral. Por lo tanto:
' si se encontrare dentro del periodo a prueba se abonan quince dias de sueldo + la parte proporcional del aguinaldo del preaviso.
' si la antiguedad es menor a cinco a?os y no esta dentro del periodo a prueba se le paga un mes de sueldo + la parte proporcional del aguinaldo del mes de preaviso.
' si la antiguedad es mayor a los cinco a?os se le pagan dos meses de sueldo + la parte proporcional del aguinaldo del mes de preaviso.


' Cuando se da de baja un empleado por los motivos abajo detallados se le paga el preaviso

'4   (Incapacidad articulo 212 ley 20744 segundo parrafo)
'5   (Incapacidad articulo 212 ley 20744 cuarto parrafo)
'9   (Despido sin causa sin otorgar preaviso)
'11 (Incapacidad articulo 212 ley 20744 tercer parrafo)
'12 (Fin de contrato sin otorgar preaviso) 
'13 (Delegado gremial)
'14 (Fuerza mayor o Disminucion del Trabajo)
'15 (Embarazo)
'16 (Matrimonio)
prom_var = 0
MOTIVO_BAJA = SCO_HR_PERIOD.STD_ID_HRP_END_REASON

IF (SAR_ES_BAJA <> 1) OR ( MOTIVO_BAJA <> "4" AND MOTIVO_BAJA <> "5" AND MOTIVO_BAJA <>"9" AND MOTIVO_BAJA <> "11" AND MOTIVO_BAJA <> "12" AND MOTIVO_BAJA <> "13" AND MOTIVO_BAJA <> "14" AND MOTIVO_BAJA <> "15" AND MOTIVO_BAJA <> "16") THEN 
    Return(0)
ENDIF

base = SAR_TOT_INDEMNIZ 

IF SAR_TIPO_SALARIO = "002" THEN
    base = SAR_TOT_INDEMNIZ * 30
ELSEIF SAR_TIPO_SALARIO = "003" THEN 'es horario
    base = SAR_TOT_INDEMNIZ * SAR_HORAS_MES
endif

prom_ult_6_meses = SAR_PRO_VAR_ULT_6

aantig = SAR_ANIOS_ANTIG      'a?os de antiguedad

coef=0

IF aantig < 5 THEN
    coef = 1
ENDIF

  

IF SAR_FECHA_BAJA < fin_prueba AND ISNULL(fin_prueba)= FALSE AND fin_prueba <> PLUS_INF THEN
   coef = 0.50
ENDIF

IF aantig >= 5 THEN
      coef = 2
ENDIF

valor = (base + prom_ult_6_meses) * coef

RETURN(valor)
