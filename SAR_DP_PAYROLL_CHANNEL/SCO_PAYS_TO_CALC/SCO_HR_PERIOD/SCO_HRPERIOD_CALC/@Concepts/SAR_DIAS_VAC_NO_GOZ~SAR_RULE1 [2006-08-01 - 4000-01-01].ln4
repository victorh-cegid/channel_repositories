IF SAR_ES_BAJA = 0 THEN 
    Return(0)
ENDIF
'Por modificacion del empleado
IF SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" THEN 
    Return(0)
ENDIF

aux = SAR_CARGA_AUSENTISM

dias_vac=0
dias_20=0
dias_teor=0
contador = 0
num_dias=0
prop=0
base = 0


IF ISNULL (SAR_HR_PERIOD.SSP_FEC_ANTIGUEDAD) = FALSE AND SAR_HR_PERIOD.SSP_FEC_ANTIGUEDAD < SAR_FECHA_ALTA THEN
    fec_ini = SAR_HR_PERIOD.SSP_FEC_ANTIGUEDAD
ELSE
    fec_ini = SAR_FECHA_ALTA
ENDIF
antmes = DATEDIFF(fec_ini,SAR_FECHA_BAJA,M4_MONTH)
IF antmes > 6  THEN
    dias_teor = SAR_DIAS_VACACION 
    ELSE
    dias_20 =1
ENDIF
FECHA = TOSTRING(SAR_PAYS_TO_CALC.SAR_ANIO_PROCESO,0) + "/" + "01" + "/" + "01"
fec_ini_anio = TODATE(FECHA)
fec_fin_paga = SAR_HR_PERIOD.SCO_DT_ALLOC_END
IF dias_teor <> 0 THEN  ' tiene antiguedad mayor a seis meses
    dias_alta = CommonTime(fec_ini_anio,fec_fin_paga,SAR_FECHA_ALTA,SAR_FECHA_BAJA)       
    dias_alta = dias_alta - SAR_ACM_IG_ANIO_ACT[0].SAR_DIAS_LIC_NO_RETRIB    
    dias_vac = dias_teor*dias_alta/365  
ELSE
    IF dias_20 <> 0 THEN
        base = 0
        K = TODATE(FECHA)
        fec_fin = SAR_FECHA_BAJA
        IF SAR_FECHA_ALTA < k THEN
            fec_ini=k
        ELSE
            fec_ini=SAR_FECHA_ALTA
        ENDIF
        fi_base = DXDAY(fec_ini)
        ff_base = DXDAY(fec_fin)
        base = fec_ini
        num_dias = fec_fin - fec_ini + 1
        FOR i = fec_ini to fec_fin
            base_d = DayOfTheWeek(base)
            IF base_d = 6 OR base_d = 7 THEN
                contador = contador +1
            ENDIF
            base = base + 1
        NEXT
        dias_trab = num_dias - contador
        a=SAR_ACM_IG_ANIO_ACT[0].SAR_DIAS_LIC_NO_RETRIB
        b=SAR_DIAS_LIC_NO_RETRIB
        dias_trab = dias_trab - SAR_ACM_IG_ANIO_ACT[0].SAR_DIAS_LIC_NO_RETRIB
        dias_vac = dias_trab/20
    ENDIF
ENDIF

SAR_ACM_DIC_SALDO.BEGIN()
SAR_ACM_DIAS_VAC_DISFR.BEGIN()


dias_vac = dias_vac + Round(SAR_ACM_DIC_SALDO.SAR_SALDO_VACACION,0) - SAR_ACM_DIAS_VAC_DISFR.SAR_UN_VACACIONES - SAR_UN_VACACIONES


If SAR_TIPO_SALARIO = "003" Then 
    dias_vac = dias_vac  * SAR_HS_DIARIAS_PROM
Endif


Return(dias_vac)
