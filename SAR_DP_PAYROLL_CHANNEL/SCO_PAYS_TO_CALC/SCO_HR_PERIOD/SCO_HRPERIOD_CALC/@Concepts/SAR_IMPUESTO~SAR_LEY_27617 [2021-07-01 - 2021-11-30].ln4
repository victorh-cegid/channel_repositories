'En retroactiva desde paga de reliquidación se anula todo el cálculo de las cuotas
If SAR_IND_IMPUESTO_RETRO = 2 Then Return (SAR_IMPUESTO)

If (SAR_TP_IMPUT = "77" And SAR_VACACIONES = 0) Or SAR_TP_IMPUT = "88" Or SAR_TP_IMPUT = "99" Or SAR_IND_NO_RET_GAN = 1 Then Return(0)
'Si la baja no finaliza el último día del mes no se calcula impuesto
If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" And (DxDay(SAR_FECHA_BAJA) <> DaysOfMonth(SAR_FECHA_BAJA) Or (SAR_FECHA_BAJA < SCO_DT_ALLOCATION and SAR_IMPUESTO_TOTAL = 0)) Then Return (0)

'En revisión, salvo en baja, no se calcula impuesto, devuelve valor original para no generar retención
If SAR_PAYS_TO_CALC.SAR_REVISION = 1 And SAR_IND_IMPUESTO_RETRO = 0 And ((SAR_ES_BAJA <> 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Or (SAR_ES_BAJA = 1 And SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1)) Then 
    SAR_SALDO_PTE_27617 = SCO_AC_HR_PERIOD_REV_1.SAR_SALDO_PTE_27617
    SAR_CUOTA_APLIC_27617 = SCO_AC_HR_PERIOD_REV_1.SAR_CUOTA_APLIC_27617
    Return (SCO_AC_HR_PERIOD_REV_1.SAR_IMPUESTO)
EndIf
impuesto = SAR_IMPUESTO
saldo_pendiente = 0
'Recupera el saldo pendiente de devolver y lo incorpora al impuesto, para que no trate de devolverlo completo o en pagas que no corresponda.
If DxYear(SAR_FEC_IMPUT_IG) = 2021 And SCO_DT_ALLOCATION>=DxDate(01,07,2021) Then
    ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
    paga_esp = dxDate (30,06,2021)
    paga_esp_dif = dxDate (07,07,2021)    
    saldo_pendiente = 0
    For acum = 0 To ult_reg - 1
        If (SCO_AC_HR_PERIOD_READ_1[acum].SAR_FECHA_PAGO_IG = paga_esp Or SCO_AC_HR_PERIOD_READ_1[acum].SAR_FECHA_PAGO_IG = paga_esp_dif) And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT="99" And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION Then
            saldo_pendiente = SCO_AC_HR_PERIOD_READ_1[acum].SAR_SALDO_PTE_27617
        EndIf
    Next
    'Las cuotas ya devueltas no se reincorporan
    saldo_pendiente = saldo_pendiente - SAR_ACM_IG_ANIO_IMPUT[0].SAR_CUOTA_APLIC_27617
    'Se incorpora lo pendiente para que no trate de devolverlo
    impuesto = impuesto + saldo_pendiente
    'Aplica el descuento de la cuota si corresponde:
    If SAR_IND_PAGA_CALCULA_27617 = 1 And saldo_pendiente > 0 Then
        meses_quedan = 12 - DxMonth(SCO_DT_ALLOCATION)
        'Bajas devuelve todo
        If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then meses_quedan = 0
        cuota_mes = saldo_pendiente
        If meses_quedan > 0 Then cuota_mes = cuota_mes / meses_quedan
        cuota_mes = Round(cuota_mes,SAR_NUM_DEC)
        impuesto = impuesto - cuota_mes
        SAR_CUOTA_APLIC_27617 = cuota_mes
        saldo_pendiente = saldo_pendiente - cuota_mes
    EndIf
    SAR_SALDO_PTE_27617 = saldo_pendiente
EndIf
Return Round(impuesto,SAR_NUM_DEC)
