// Si el trabajador se encuentra en tramo 1 en el mes debe considerar los conceptos incluidos en este total
// dentro del impuesto del propio mes sin prorratear su importe para incluirlo en el impuesto hasta final de año
indAjusteRetro = SAR_IND_IMPUESTO_RETRO
TotalProrrateoConAP = SAR_TOT_PROR_CON_AP
ImporteProrrateo_T1 = SAR_IG_PROR_LEY_27617_T1

'Calcula la deducción que pertenece al mes de proceso
If SAR_TIPO_SALARIO = "003" Then
    remun_mes = SAR_TOT_REMUN_27617
    remun_prom = SAR_PROM_27617_DEI_IG
    fec_ded = SAR_FEC_IMPUT_IG 'Se mantiene fecha IG por coherencia de cálculo en jornalizados, cambiar por SCO_DT_ALLOCATION si se considera que debe levantarse el dato por devengado
Else
    remun_mes = SAR_REM_27617_DEI_DEV
    remun_prom = SAR_PROM_27617_DEI_DEV
    fec_ded = SCO_DT_ALLOCATION
    If indAjusteRetro = 2 And DxYear(SAR_FEC_IMPUT_IG) > DxYear(SCO_DT_ALLOCATION) Then fec_ded = SAR_FEC_IMPUT_IG    
EndIf

retrib = Min(remun_mes,remun_prom)

vTramo = SAR_DED_ESP_INC.SAR_RETORNA_TRAMO(retrib,fec_ded,ID_CURRENCY)

If vTramo = 1 Then
    SAR_IG_PROR_LEY_27617_T1 = ImporteProrrateo_T1 + TotalProrrateoConAP
    Return (0)
Else
    Return (TotalProrrateoConAP)    
EndIf
