' Se descuenta del total remunerativo a abonar el importe de las horas extras y del SAC, de acuerdo al 
' artículo 2do. del Decreto 368/2004

IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
    rem_men= SAR_TOT_HAB_CON_AP + SAR_MATERNIDAD - SAR_TOT_HS_EXTRAS - SAR_TOT_SAC_COTIZ - SAR_TOTAL_DESFA
    aux = 31
ELSE 
    SAR_REMUN_BASE_SAL_FAM.BEGIN()
    rem_men= (SAR_REMUN_BASE_SAL_FAM.SAR_TOT_HAB_CON_AP + SAR_TOT_HAB_CON_AP) + (SAR_REMUN_BASE_SAL_FAM.SAR_MATERNIDAD + SAR_MATERNIDAD) - (SAR_REMUN_BASE_SAL_FAM.SAR_TOT_HS_EXTRAS + SAR_TOT_HS_EXTRAS) - (SAR_REMUN_BASE_SAL_FAM.SAR_TOT_SAC_COTIZ + SAR_TOT_SAC_COTIZ) - (SAR_REMUN_BASE_SAL_FAM.SAR_TOTAL_DESFA + SAR_TOTAL_DESFA)
ENDIF

aux = 31


IF DAYSOFMONTH(SCO_HR_PERIOD.STD_DT_START) = 31 THEN
    aux = 32
ENDIF

IF SAR_ES_ALTA = 1 And SAR_HR_PERIOD.STD_ID_HRP_START_REASON <> "005" THEN
    rem_men= (rem_men)/(aux-DxDay(SCO_HR_PERIOD.STD_DT_START)) * 30
ENDIF

return(rem_men)
