if SAR_PROV_SAC_ACUM = 0 then return(0)  
 
'CALCULO TOPE PARA os 
Tope=SAR_TOPE_COTIZ *SAR_UNIDADES_PROV_SAC/2
sac=SAR_PROV_SAC_ACUM 
base= min(tope,sac) 

CONTR_OS= BASE * SAR_P_PAT_L_23660/100 

'CALCULO TOPE PARA JUB 
base= sac 
porc = SAR_PORC_PAT_JUBIL + SAR_P_PAT_L_19032 + SAR_PORC_F_EMPLEO + SAR_P_PAT_CASFEC_PI 
c_JUB = BASE * porc / 100 

valor_total = round(C_JUB + CONTR_OS,2)	
 
return(valor_total)
