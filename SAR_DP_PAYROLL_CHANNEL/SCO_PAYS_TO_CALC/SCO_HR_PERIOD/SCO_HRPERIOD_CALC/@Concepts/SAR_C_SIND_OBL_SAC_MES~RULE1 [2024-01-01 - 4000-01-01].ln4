If SAR_TP_IMPUT = "88" Then Return(0)
sac_anio_ant = SAR_IND_SAC_ANIO_ANT

'Control retroactividad años anteriores: se ajusta siempre para que entre directamente al impuesto en la siguiente paga normal
If sac_anio_ant = 1 Then 
    mes_orig = SAR_AC_SAC_REV[0].SAR_C_SIND_OBL_SAC_MES
    sac_dif = SAR_C_SINDIC_OBL_SAC - SAR_AC_SAC_REV[0].SAR_C_SINDIC_OBL_SAC
    valor = mes_orig + sac_dif
    If SAR_TFUEG_IND = 1 Then valor = mes_orig    
    Return(valor)
EndIf

If SAR_TP_IMPUT = "99" Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Or SAR_IND_AJUSTE_SAC = 1 Then
    'En baja o reliquidación retornamos la diferencia entre el descuento del pago y el que se ha ido descontando mes a mes
    tot_desc_sac_pago = SAR_ACM_IG_ANIO_IMPUT[0].SAR_C_SINDIC_OBL_SAC + SAR_C_SINDIC_OBL_SAC
    
    'Tierra de fuego a descontar
    tot_s_ob_sac_tfuego = SAR_ACM_IG_ANIO_IMPUT[0].SAR_TFUEG_SINDOB_SAC + SAR_TFUEG_SINDOB_SAC
    tot_desc_sac_pago = tot_desc_sac_pago - tot_s_ob_sac_tfuego
        
    tot_desc_sac_mes = SAR_ACM_IG_ANIO_IMPUT[0].SAR_C_SIND_OBL_SAC_MES
    valor = tot_desc_sac_pago - tot_desc_sac_mes
    
    'Para evitar diferencias en reliquidación por redondeos
    If abs(valor) <= SAR_TOLERANCIA_DEC Then valor = 0
    
    Return (valor)
EndIf

base = SAR_B_SAC_MES_RG3976

valor = base * SAR_PORC_C_SIND_OBL / 100

Return(valor)
