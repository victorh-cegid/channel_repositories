IF DXMONTH(SCO_DT_ALLOCATION) >= 3 AND DXMONTH(SCO_DT_ALLOCATION) <= 8 THEN
    FECHA = TOSTRING(DXYEAR(SCO_DT_ALLOCATION)-1,0) + "-12-31"
    fecha_fin = TODATE(FECHA)
ELSE
    IF DXMONTH(SCO_DT_ALLOCATION) >= 9 THEN
        FECHA = TOSTRING(DXYEAR(SCO_DT_ALLOCATION),0) + "-06-30"
        fecha_fin = TODATE(FECHA)
    ELSE
        IF DXMONTH(SCO_DT_ALLOCATION) = 1 OR DXMONTH(SCO_DT_ALLOCATION) = 2 THEN
            FECHA = TOSTRING(DXYEAR(SCO_DT_ALLOCATION)-1,0) + "-06-30"
            fecha_fin = TODATE(FECHA)
        ENDIF
    ENDIF
ENDIF

Return(fecha_fin)
