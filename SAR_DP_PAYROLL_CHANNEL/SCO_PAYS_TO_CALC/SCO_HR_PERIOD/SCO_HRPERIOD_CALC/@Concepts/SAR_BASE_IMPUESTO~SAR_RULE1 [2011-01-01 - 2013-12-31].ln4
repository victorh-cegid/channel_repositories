'Antes de realizar cualquier calculo se verifica que la empresa haga la retencion correspondiente a ganancias:
If(SAR_IND_NO_RET_GAN = 1)Then 
  Return(0)
endIf  

'En esta formula se utilizan tres nodos que devuelven:

'SAR_ACM_IMPUESTO: 
'La suma de los valores del actual a?o fiscal, excepto las revisiones con la misma fecha de pago que la paga actual.

'SAR_REV_ACM_IMPUESTO2: 
'La suma de los valores de las revisiones cuya fecha de pago coincida con la fecha de pago de la paga actual.

'REV_ACM_IMPUESTO: 
'Solo actua en una revision y devuelve los valores originales de la paga original que estamos revisando.

'---------------------------------------------------
'                  Aclaraciones
'---------------------------------------------------

'COMPORTAMIENTO EN LAS REVISIONES

'Si es una revision descontamos el importe que se acumulo en la paga original
'Es importante entender bien como funciona en estos casos:
'Si la revision es del mismo a?o fiscal entonces descontamos el importe porque ya lo estamos tomando
'en la TI ACM_IMPUESTO, si no lo descontaramos estariamos sumando dos veces la misma base imponible.
'Si la revision es de diferente a?o fiscal respecto al actual, entonces no debemos tomar la base imponible
'de la paga original debido a que corresponde a otro a?o fiscal. Como la TI ACM_IMPUESTO solo devuelve ''los valores del actual a?o fiscal entonces basta con restar al valor recalculado del v4999 la parte correspondiente 
'a la paga original, de esa manera la base imponible acumulada solo se incrementara en la parte que estamos''pagando en este a?o fiscal.

 


'---------------------------------------------------
'          Inicializacion de variables
'---------------------------------------------------
aux = 0
base = 0           
nummes = 0          'Mes de pago
tsv = 0             'Tope seguro de vida
tgs = 0             'Tope gastos de sepelio
gni = 0             'Ganancia no imponible
desp = 0            'Deduccion especial
tcma = 0            'Tope cuota medica asistencial
gnoi = 0            'Ganancias no Imponibles 
oded = 0            'Otras deducciones
donac = 0           'Donaciones 
topdonac = 0        'Tope donaciones 
segjur = 0          'Ingreso 572 Seguro de vida 
retjur = 0          'Ingreso 572 Seguro de retiro 
sepjur = 0          'Ingreso 572 Seguro de vida 
cmajur = 0          'Ingreso 572 Prepaga 
donajur = 0         'Ingreso 572 Donaciones 
topehm = 0          'Tope honorarios medicos 
hono = 0            'Honorarios Medicos 
serv = 0            'Servicio Domestico
tope_serv = 0       'Tope Servicio Domestico
tope_servicio = 0   'Deduccion Servicio Domestico
ap_cap_soc = 0      'Aporte capital socia o fondo de riesgo
sac_neto= 0         'SAC neto dic08

'Variables de los acumulados anuales
SAR_IG_TOT_C_IM = 0    'Total haberes tributables
SAR_IG_TOT_JUB = 0    'Fondos de Jubilaciones
SAR_IG_T_19032 = 0    'Obras Sociales
SAR_IG_TOT_OB_S = 0    'Ley 19032
SAR_IG_CMASIS_REMUN = 0    'Cobertura medico asistencial
SAR_IG_SEGURO_REMUN = 0    'Primas de seguro para el caso de muerte
SAR_IG_SEPELIO_REM = 0    'Gastos de sepelio
SAR_IG_DONAC_REMUN = 0    'Donaciones
SAR_IG_RETIRO_REMUN = 0    'Aportes seguros de retiro
SAR_IG_O_DEDUC_REM = 0    'Otras deducciones
SAR_IMP_DED_HON_MED = 0    'Honorarios y gastos medicos
SAR_IMP_D_IN_HIP = 0    'Intereses creditos hipotecarios 
SAR_IG_G_NO_IMP = 0    'Ganancias no imponibles
SAR_IG_DED_ESP = 0    'Deduccion especial
SAR_IG_AP_VOL_REM = 0    'Aporte Voluntario
SAR_IG_CONYUGE_REM = 0    'Conyuge
SAR_IG_HIJOS_REM = 0    'Hijos
SAR_IG_OCARGAS_REM = 0    'Otras cargas de familia
SAR_DED_SER_DOM = 0    'Servicio Domestico
SAR_TOT_AP_C_SOC = 0    'Aporte capital social o fondo de riesgo
SAR_DED_CUO_SIND = 0    'Cuota Sindical de acuerdo a la RG. 2362/07  

'---------------------------------------------------
'          Calculo de la Ganancia Bruta
'---------------------------------------------------

'Recorro el acumulado del empleado y sumarizo los valores para armar las TI.

SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()- 1

'Inicializo totales para SAR_ACM_IMPUESTO

sum_tot_con_imp     = 0
sum_tot_jub         = 0
sum_tot_ap_vol      = 0
sum_tot_ley_19032   = 0
sum_tot_ob_soc      = 0
sum_tot_o_ded       = 0 
sum_tot_seg_sep     = 0
sum_tot_seg_vida    = 0
sum_tot_acm_impuesto = 0
sum_tot_int_hip     = 0
sum_tot_cuo_sind    = 0
sum_tot_ap_cap_soc  = 0

'Inicializo totales para SAR_REV_ACM_IMPUESTO2

sum_tot_con_imp_rev2    = 0
sum_tot_jub_rev2        = 0
sum_tot_ap_vol_rev2     = 0
sum_tot_ley_19032_rev2  = 0
sum_tot_ob_soc_rev2     = 0
sum_tot_o_ded_rev2      = 0 
sum_tot_seg_sep_rev2    = 0
sum_tot_seg_vida_rev2   = 0
sum_tot_int_hip_rev2    = 0
sum_tot_cuo_sind_rev2   = 0
sum_tot_ap_cap_soc_rev2 = 0

'Inicializo totales para REV_ACM_IMPUESTO

sum_tot_con_imp_rev    = 0
sum_tot_jub_rev        = 0
sum_tot_ap_vol_rev     = 0
sum_tot_ley_19032_rev  = 0
sum_tot_ob_soc_rev     = 0
sum_tot_o_ded_rev      = 0 
sum_tot_seg_sep_rev    = 0
sum_tot_seg_vida_rev   = 0
sum_tot_int_hip_rev    = 0
sum_tot_cuo_sind_rev   = 0
sum_tot_ap_cap_soc_rev = 0

fec_1 = SAR_FEC_PAGO_IG
fec_2 = SAR_FEC_FIN_IG_DEC

if (SAR_IG_DEC142_AUX = 0) and (SAR_TP_IMPUT = "99") and (SAR_RANGO_REM_IG_2013 = 1) Then 
    fec_1 = fec_2
endif

meses_prop = DxMonth(fec_1)

FOR I = 0 TO ULTIMO_REG 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
   
    ' Armo los datos para SAR_ACM_IMPUESTO
    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND fec_1 > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
        sum_tot_con_imp      = sum_tot_con_imp + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_CON_IMP
        sum_tot_jub          = sum_tot_jub + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_JUBILACION 
        sum_tot_ap_vol       = sum_tot_ap_vol + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_AP_VOLUNT 
        sum_tot_ley_19032    = sum_tot_ley_19032 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_LEY_19032
        sum_tot_ob_soc       = sum_tot_ob_soc + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_OBRA_SOC
        sum_tot_o_ded        = sum_tot_o_ded + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_OTRAS_DED
        sum_tot_seg_sep      = sum_tot_seg_sep + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_SEG_SEPEL 
        sum_tot_seg_vida     = sum_tot_seg_vida + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_SEG_VIDA
        sum_tot_acm_impuesto = SCO_AC_HR_PERIOD_READ_1.SAR_ACM_IMPUESTO       

        'Agregado de acuerdo a la RG. 2362/07
        sum_tot_cuo_sind     = sum_tot_cuo_sind + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_CUO_SIND
    ENDIF

    ' Armo los datos para SAR_REV_ACM_IMPUESTO2

    IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <> SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND fec_1 = SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
        sum_tot_con_imp_rev2    = sum_tot_con_imp_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_CON_IMP
        sum_tot_jub_rev2        = sum_tot_jub_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_JUBILACION 
        sum_tot_ap_vol_rev2     = sum_tot_ap_vol_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_AP_VOLUNT 
        sum_tot_ley_19032_rev2  = sum_tot_ley_19032_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_LEY_19032
        sum_tot_ob_soc_rev2     = sum_tot_ob_soc_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_OBRA_SOC
        sum_tot_o_ded_rev2      = sum_tot_o_ded_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_OTRAS_DED
        sum_tot_seg_sep_rev2    = sum_tot_seg_sep_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_SEG_SEPEL 
        sum_tot_seg_vida_rev2   = sum_tot_seg_vida_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_SEG_VIDA

        'Agregado de acuerdo a la RG. 2362/07
        sum_tot_cuo_sind_rev2   = sum_tot_cuo_sind_rev2 + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_CUO_SIND

    ENDIF

    'Armo los datos para REV_ACM_IMPUESTO

    IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_DT_ALLOCATION AND SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG < fec_1 THEN 
        sum_tot_con_imp_rev     = sum_tot_con_imp_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_CON_IMP
        sum_tot_jub_rev         = sum_tot_jub_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_JUBILACION 
        sum_tot_ap_vol_rev      = sum_tot_ap_vol_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_AP_VOLUNT 
        sum_tot_ley_19032_rev   = sum_tot_ley_19032_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_LEY_19032
        sum_tot_ob_soc_rev      = sum_tot_ob_soc_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_OBRA_SOC
        sum_tot_o_ded_rev       = sum_tot_o_ded_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_OTRAS_DED
        sum_tot_seg_sep_rev     = sum_tot_seg_sep_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_SEG_SEPEL 
        sum_tot_seg_vida_rev    = sum_tot_seg_vida_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_SEG_VIDA

        'Agregado de acuerdo a la RG. 2362/07
        sum_tot_cuo_sind_rev    = sum_tot_cuo_sind_rev + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_CUO_SIND
    ENDIF
    
NEXT


tot_con_imp = SAR_TOT_CON_IMP + sum_tot_con_imp + sum_tot_con_imp_rev2

IF (SAR_ES_BAJA = 0) and (SAR_FECHA_BAJA < SCO_DT_ALLOCATION) Then    'condicion para Nomina despues de la baja
    if SAR_TOT_CON_IMP = 0 Then
        tot_con_imp = 0
    endif
endif

'REVISION:

IF (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) THEN
    tot_con_imp = tot_con_imp - sum_tot_con_imp_rev
ENDIF

'---------------------------------------------------
'          Calculo de las Deducciones
'---------------------------------------------------

tot_jub         = SAR_TOT_JUBILACION + sum_tot_jub + sum_tot_jub_rev2
tot_ap_vol      = SAR_TOT_AP_VOLUNT + sum_tot_ap_vol + sum_tot_ap_vol_rev2 
tot_ley_19032   = SAR_TOT_LEY_19032 + sum_tot_ley_19032 + sum_tot_ley_19032_rev2
tot_ob_soc      = SAR_TOT_OBRA_SOC + sum_tot_ob_soc + sum_tot_ob_soc_rev2
tot_o_ded       = SAR_TOT_OTRAS_DED + sum_tot_o_ded + sum_tot_o_ded_rev2
tot_seg_sep     = SAR_TOT_SEG_SEPEL + sum_tot_seg_sep + sum_tot_seg_sep_rev2
tot_seg_vida    = SAR_TOT_SEG_VIDA + sum_tot_seg_vida + sum_tot_seg_vida_rev2
tot_int_hip     = SAR_TOT_INT_HIP
tot_cuo_sind    = SAR_TOT_CUO_SIND + sum_tot_cuo_sind  + sum_tot_cuo_sind_rev2
tot_ap_cap_soc  = SAR_TOT_AP_C_SOC



'ES UNA REVISION:

IF (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) THEN

    tot_jub         = tot_jub - sum_tot_jub_rev
    tot_ap_vol      = tot_ap_vol - sum_tot_ap_vol_rev
    tot_ley_19032   = tot_ley_19032 - sum_tot_ley_19032_rev
    tot_ob_soc      = tot_ob_soc - sum_tot_ob_soc_rev 
    tot_o_ded       = tot_o_ded - sum_tot_o_ded_rev
    tot_seg_sep     = tot_seg_sep - sum_tot_seg_sep_rev
    tot_seg_vida    = tot_seg_vida - sum_tot_seg_vida_rev
    tot_int_hip     = tot_int_hip 
    tot_cuo_sind    = tot_cuo_sind - sum_tot_cuo_sind_rev
    tot_ap_cap_soc  = tot_ap_cap_soc - sum_tot_ap_cap_soc_rev
   
ENDIF


'---------------------------------------------------
'          Inicio del calculo
'---------------------------------------------------

'Calculamos el mes de pago.
nummes = SAR_MES_PAGO_IG

IF nummes = 0 THEN
    nummes = 1
ENDIF


'---------------------------------------------------
'               Deduccion Especial
'         (Res.Gral. AFIP 1410/2003 ANEXO I
'---------------------------------------------------
'aumentamos la deduccion especial para los empleados de Rango 1.
desp = SAR_DED_ESPECIAL + SAR_IG_DEC142_AUX 

'---------------------------------------------------
'             Ganancia no Imponible
'         (Res.Gral. AFIP 1410/2003 ANEXO I
'---------------------------------------------------
gni = SAR_GAN_NO_IMP

'---------------------------------------------------
'              Otras deducciones
'       (Res.Gral. AFIP 1261/2002 ANEXO III
'---------------------------------------------------
oded = tot_o_ded + SAR_JUR_OTRAS_DED 'otras deducciones

'-------------------------------------------------------------------------------------------
'Dentro de la liquidacion anual o final calculamos la deduccion por valores/contribuciones 
'abonados al Servicio Domestico RG 1978 AFIP
'-------------------------------------------------------------------------------------------

IF SAR_TP_IMPUT = "99" OR ( SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") OR SAR_MES_PAGO_IG = 12 THEN  
    serv          = SAR_SERV_DOMEST
    tope_serv     = (SAR_TOPE_SER_DOM/12 * meses_prop)
    tope_servicio = Min(serv,tope_serv)
EndIf
  

'---------------------------------------------------
'     Aportes capital social o fondo de riesgo
'               Art.79 Ley N? 2446
'---------------------------------------------------
ap_cap_soc = tot_ap_cap_soc + SAR_AP_CAP_SOC_FDO_R


'---------------------------------------------------------------
'Complemento impuesto a las Gcias.- Entidades de carga mensual 
'Frecuencia de Carga = 1
'---------------------------------------------------------------
SAR_H_COMPLEM_GCIAS.BEGIN()

IF SAR_H_COMPLEM_GCIAS.count() > 0 THEN
    ULTIMO_REG = SAR_H_COMPLEM_GCIAS.COUNT()- 1
    FOR I = 0 TO ULTIMO_REG 
        SAR_H_COMPLEM_GCIAS.MOVETO(I)
        If IsNull(SAR_H_COMPLEM_GCIAS.SAR_ID_ENTIDAD)= M4_FALSE then
             entidad = SAR_H_COMPLEM_GCIAS.SAR_ID_ENTIDAD
        endif

        IF SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA = "1" THEN
            IF entidad = "02" THEN '--Cuota medico asistencial--
                cmajur = SAR_IG_CMASIS_REMUN
            ELSEIF entidad = "03" THEN '--Seguro de vida particular --
                segjur = SAR_IG_SEGURO_REMUN
            ELSEIF entidad = "05" THEN '--Gastos de sepelio --
                sepjur = SAR_IG_SEPELIO_REM  
            ELSEIF entidad = "06" THEN '--Donaciones--
                donajur = SAR_IG_DONAC_REMUN
            ENDIF
        ELSE
            IF entidad = "02" THEN '--Cuota medico asistencial--
                cmajur = SAR_JUR_CTA_MED_ASI
            ELSEIF entidad = "03" THEN '--Seguro de vida particular --
                segjur = SAR_JUR_SEG_PART
            ELSEIF entidad = "05" THEN '--Gastos de sepelio --
                sepjur = SAR_JUR_SEPELIO
            ELSEIF entidad = "06" THEN '--Donaciones--
                donajur = SAR_JUR_DONACIONES
            ENDIF
        ENDIF    
    NEXT  
ENDIF

'---------------------------------------------------
'                 Seguro de vida 
'     (Res.Gral. AFIP 1261/2002 ANEXO III d)
'---------------------------------------------------
tsv = Min(tot_seg_vida+segjur,SAR_TOPE_SEG_VIDA)  'aplico tope seguro de vida 


'---------------------------------------------------
'                Gastos de Sepelio
'    (Res.Gral. AFIP 1261/2002 ANEXO III e)
'---------------------------------------------------
tgs = Min(tot_seg_sep+ sepjur,SAR_TOPE_GAST_SEP) 'aplico tope gastos sepelio


'---------------------------------------------------
'                   Donaciones
'     (Res.Gral. AFIP 1261/2002 ANEXO III g)
'---------------------------------------------------
'Segun el inciso L del art. 53 del decreto 290/00. Se exceptuan las deducciones del
'inciso g (obras sociales y cuota medico-asistenciales), honorarios medicos, donaciones
'y las deducciones del art. 23. de la ley.

'Para calcular el subtotal desde el cual se calcula el tope del 5% se descuentan del Total haberes tributables:
'Fondos de Jubilaciones
'Ley 19032
'Primas de seguro para el caso de muerte
'Gastos de sepelio
'Aportes seguros de retiro
'Otras deducciones
'Intereses creditos hipotecarios 
'Servicio Domestico
'Cuota Sindical


subdonac = tot_con_imp - tot_jub - tot_ap_vol - tot_ley_19032 - tsv - tgs - oded - tot_int_hip - tope_servicio - tot_cuo_sind - ap_cap_soc

base     = subdonac - tot_ob_soc
topdonac = subdonac * 5/100 ' tope donaciones
donac    = Min(donajur,topdonac) 'donaciones 
donac    = Max(donac,0) 
base     = base - donac


'---------------------------------------------------
'          Cuota medica asistencial
' (Res.Gral. AFIP 1261/2002 ANEXO III c)
'---------------------------------------------------
'Para calcular el subtotal al tope de donaciones se le descuenta la obra social.
'Segun el inciso M del art. 53 del decreto 290/00. 
'Este inciso solo exceptua a las propias cuotas medica-asistenciales, a las
'donaciones, a los honorarios medicos y a las deducciones del art. 23. de la ley.


submedhon = subdonac - tot_ob_soc
aux       = submedhon * SAR_PORC_TOPE_C_MED/100 'tope cuota med.asistencial 
cmajur    = cmajur + SAR_TOT_AD_OBRA_SOC 
tcma      = Min(cmajur,aux) 'compara con tope cta.med.asistencial declarada 
tcma      = Max(tcma,0) 
base      = base - tcma


'---------------------------------------------------
'             Honorarios Medicos
'    (Res.Gral. AFIP 1261/2002 ANEXO III j)
'---------------------------------------------------
'Se utiliza el mismo subtotal que para el calculo de las cuota medico asistenciales
'Inciso M del art. 53 del decreto 290/00. 

IF SAR_TP_IMPUT = "99" OR (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") OR SAR_MES_PAGO_IG =12 THEN

    'Calculamos la deduccion por  honorarios medicos
    'si es una liquidacion anual o final segun RG 756/2000 de la AFIP

    sID_PKA                 = "STD_ID_LEG_ENT"
    sID_PKB                 = NullValue()          
    sID_PKC                 = NullValue()
    sID_PKD                 = NullValue()
    sPKA                    = SCO_ID_LEG_ENT
    sPKB                    = NullValue()
    sPKC                    = NullValue()
    sPKD                    = NullValue()
    dDT_ALLOCATION          = SCO_DT_ALLOCATION
    dDT_PAYMENT             = NullValue()
    sID_DMD                 = "DMD1"
    sID_DMD_COMPONENT       = "SAR_P_TOPE_HONORAR_MED"
    iSliceFilter            = 0   'Todos los tramos            

                         
    lnresultado = SRCO_PY_VT_LEG_ENT!SRTC_PY_VT_EXT_CALL.READ_VALUES(sID_PKA,sID_PKB,sID_PKC,sID_PKD,sPKA,sPKB,sPKC,sPKD,dDT_ALLOCATION,dDT_PAYMENT,sID_DMD,sID_DMD_COMPONENT,iSliceFilter)
    if (lnResultado <> M4_ERROR) then
        SRCO_PY_VT_LEG_ENT!SRTC_PY_VT_DATA.Begin()
        PORCHONMED = toint(SRCO_PY_VT_LEG_ENT!SRTC_PY_VT_DATA.SCO_VALUE)
    else
        PORCHONMED = 100
    endif 
    hono   = SAR_HONORAR_MEDICOS * (PORCHONMED/100) 'Art. 7 inciso j de la RG 4139 DGI, segun RG 756 AFIP
    topehm = Min(hono,submedhon * 0.05) ' tope honorarios medicos 
    topehm = Max(topehm,0)
    base   = base - topehm    

ENDIF

deduc = (desp + gni + SAR_IMP_CONY_IG + SAR_IMP_HIJO_IG + SAR_IMP_O_CAR_IG)

'---------------------------------------------------
'           Ganancia Neta Sujeta a Impuesto 
'        (Res.Gral. AFIP 1261/2002 Art. 7 2.b)
'---------------------------------------------------
base = base - deduc 

IF (SAR_ES_BAJA = 0) and (SAR_FECHA_BAJA < SCO_DT_ALLOCATION)  and (tot_con_imp = 0) Then    'condicion para Nomina despues de la baja
    base          = 0
    tot_jub       = 0        
    tot_ap_vol    = 0
    tot_ley_19032 = 0
    tot_ob_soc    = 0
    desp          = 0
    gni           = 0
    tcma          = 0
    tsv           = 0
    tgs           = 0
    oded          = 0
    donac         = 0  
    topehm        = 0  
    tot_int_hip   = 0   
    tope_servicio = 0
    tot_cuo_sind  = 0
ENDIF


'-----------------------------------------------------
'Grabacion de los valores calculados en cada variable
'-----------------------------------------------------

SAR_IG_TOT_C_IM = tot_con_imp    'total acumulado de haberes tributables 
SAR_IG_TOT_JUB = tot_jub        'total acumulado de retencion por jubilacion
SAR_IG_AP_VOL_REM = tot_ap_vol     'total acumulado de aporte voluntario
SAR_IG_T_19032 = tot_ley_19032  'total acumulado de retencion para el INSSJP-Ley 19032
SAR_IG_TOT_OB_S = tot_ob_soc     'total acumulado de retencion para la obra social

SAR_IG_DED_ESP = desp           'deduccion especial
SAR_IG_G_NO_IMP = gni            'Gcia.no imponible
SAR_IG_CMASIS_REMUN = tcma	     'Cuota medico Asistencial 
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_IG_CMASIS_REMUN",-1,tcma)

SAR_IG_SEGURO_REMUN = tsv		     'Seguro de vida
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_IG_SEGURO_REMUN",-1,tsv)

SAR_IG_SEPELIO_REM = tgs		     'Gastos Sepelio 
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_IG_SEPELIO_REM",-1,tgs)

SAR_IG_O_DEDUC_REM = oded	     'Otras Deducciones
SAR_IG_DONAC_REMUN = donac	     'Donaciones  
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_IG_DONAC_REMUN",-1,donac)

SAR_IG_CONYUGE_REM = SAR_IMP_CONY_IG	     'Conyuge
SAR_IG_HIJOS_REM = SAR_IMP_HIJO_IG	     'Hijos
