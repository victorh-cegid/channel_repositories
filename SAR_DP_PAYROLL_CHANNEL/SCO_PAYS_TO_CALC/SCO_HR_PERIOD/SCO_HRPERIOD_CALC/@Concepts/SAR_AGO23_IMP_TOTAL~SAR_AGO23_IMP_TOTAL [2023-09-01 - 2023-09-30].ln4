If SCO_DT_PAYMENT = SCO_DT_ALLOCATION And SAR_SEP23_IND_AJ_NORM = 0 Then Return(0)
aux    = 0
debito = 0

aux = SAR_AGO23_DESDE_IMP

If SAR_SEP23_IND_AJ_NORM = 0 Then
    base = SCO_AC_HR_PERIOD_REV_1.SAR_AGO23_BASE_IMP - SAR_SEPT23_DIF_SAC
Else
    base = SAR_AGO23_BASE_IMP + SAR_SEPT23_DIF_SAC
EndIf

valor = SAR_AGO23_C_FIJ_IMP + SAR_AGO23_PORC_IMP * (base - aux )/100


if isnull(valor) = true Then valor = 0

RETURN Round (valor,SAR_NUM_DEC)
