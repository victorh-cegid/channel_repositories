'Ley 27617. Este concepto contiene el importe mensual IG de la remuneración por percibido.
'Consideramos los importes de todas las pagas del mes:
importePaga = SAR_TOTAL_DEVENGOS + SAR_TOT_REMUN_27617_OE - SAR_SAC_ABONADO - SAR_ANTICIPO_VAC
ImporteAcum = SAR_ACM_MESACT_IMPUTIG[0].SAR_TOTAL_DEVENGOS - SAR_ACM_MESACT_IMPUTIG[0].SAR_SAC_ABONADO - SAR_ACM_MESACT_IMPUTIG[0].SAR_ANTICIPO_VAC

'Retroactividad: Los importes de la empresa serán los de la paga original, ya que estamos calculando por percibido
'no debe levantar los importes recalculados salvo complementos (SIRADIG)
esBaja = 0
If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then esBaja = 1
If SCO_DT_PAYMENT<>SCO_DT_ALLOCATION And esBaja = 0 Then
    importePaga = 0
    ImporteAcum = 0
    orientacion = 3
    fec_aplica = SAR_FEC_IMPUT_IG
    mes_ini = DxMonth(SAR_FEC_IMPUT_IG)
    mes_fin = mes_ini
    SAR_CALCULA_PROM_27617(orientacion,mes_ini,mes_fin,importePaga)
EndIf

Return Round(importePaga+ImporteAcum,SAR_NUM_DEC)
