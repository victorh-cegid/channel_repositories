'Precio para 14.- Lic. Gremial CCT y 15.- Lic. Gremial CCT (Sólo descuento)
precio = 0
unidades = SAR_LIC_CCT_U_PAGO + SAR_LIC_CCT_U_DESC

'Solo si hay unidades.
If unidades = 0 Then Return(0)

'Legalmente no debe tomarse variable, pero si el cliente lo quiere incluir (SAR_LIC_CCT_IND_VAR = 1) se considera
variable = 0
If SAR_LIC_CCT_IND_VAR = 1 And SAR_HORAS_MES <> 0 Then variable = Max(SAR_PRO_VAR_ULT_6,SAR_PRO_VAR_ULT_12) / SAR_HORAS_MES

'La parte fija es el total precios para licencias, si no es jornal se convierte a hora
fijo = SAR_TOT_P_COMP_EA
If SAR_TIPO_SALARIO <> "003" And SAR_HORAS_MES <> 0 Then fijo = fijo / SAR_HORAS_MES

precio = Round(variable + fijo,SAR_NUM_DEC)

Return (precio)
