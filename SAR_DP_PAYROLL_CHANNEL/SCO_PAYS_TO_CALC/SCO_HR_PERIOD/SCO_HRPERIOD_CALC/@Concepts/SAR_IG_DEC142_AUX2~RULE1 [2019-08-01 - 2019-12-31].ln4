'Antes de realizar cualquier cálculo se verifica que la empresa haga la retención correspondiente a ganancias:
If(SAR_IND_NO_RET_GAN = 1)Then 
    Return(0)
EndIf

// Calculamos el concepto en pagas 1 - normales, 3 - 1ª quincena, 4 - 2ª quincena (de agosto 2019 para que no aplique las direncias de tablas nuevas) y 99 - reliquidación
If (SAR_TP_IMPUT <> "1" And SAR_TP_IMPUT <> "3" And SAR_TP_IMPUT <> "4" And SAR_TP_IMPUT <> "99" And SAR_TP_IMPUT <> "2") Then
    Return(0)
EndIf

/* ------------------------------------------------------------------------------ */
/*    SÓLO DEBE CALCULARSE CUANDO LA FECHA DE IMPUESTO ES SEPTIEMBRE DE 2019    */
/* ------------------------------------------------------------------------------ */
MMPagoIG = DxMonth(SAR_FEC_IMPUT_IG)
AAPagoIG = DxYear (SAR_FEC_IMPUT_IG)
FePagoIG =         SAR_FEC_IMPUT_IG


MMAjusteDec561  = 8
AAAjusteDec561  = 2019
IniAjusteDec561 = DxDate ( 1 , MMAjusteDec561 , AAAjusteDec561 )
FinAjusteDec561 = DxDate (31 , MMAjusteDec561 , AAAjusteDec561 )

If (MMPagoIG > 9 And AAPagoIG = AAAjusteDec561) Or (SAR_TP_IMPUT = "2") Then

    BenefDecreto561 =  SAR_ACM_ULT_PAGO_IMPUT[0].SAR_IG_DEC142_AUX2
    
    SetValuePriority ( 0 , GetThisNodeId ( ) , "SAR_IG_DEC142_AUX" , -1 , SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_IG_DEC142_AUX )
    SetValuePriority ( 0 , GetThisNodeId ( ) , "SAR_DIF_TOT_DEVOL" , -1 , SAR_ACM_ULT_PAGO_IMPUT[0].SAR_DIF_TOT_DEVOL )
    
    If MMPagoIG = 10 And SAR_TP_IMPUT <> "4" Then 
        CuotaDecreto561 =  SAR_ACM_ULT_PAGO_IMPUT[0].SAR_BENEF_IG_DEC651_2019
        SetValuePriority ( 3 , GetThisNodeId ( ) , "SAR_BENEF_IG_DEC651_2019" , -1 , CuotaDecreto561 )
    EndIf
    
    Return(BenefDecreto561)
ElseIf MMPagoIG < 9 Then
    Return(0)
EndIf    

'---------------------------------------------------
'          Inicialización de variables
'---------------------------------------------------
BaseAjusteDec561 = 0
BaHEAjusteDec561 = 0
ImpuAjusteDec561 = 0
DEspAjusteDec561 = 0
GNImAjusteDec561 = 0
ServAjusteDec561 = 0
DSerAjusteDec561 = 0
ViatAjusteDec561 = 0
DViaAjusteDec561 = 0
VComAjusteDec561 = 0
MComAjusteDec561 = 0
DComAjusteDec561 = 0
AlquAjusteDec561 = 0
DAlqAjusteDec561 = 0

// En paga de tipo 3 calculamos sólo si no tenemos valor acumulado ya en la paga 4 anterior
BenefDecreto561 = SAR_ACM_ULT_PAGO_IMPUT[0].SAR_IG_DEC142_AUX2

If SAR_TP_IMPUT = "3" And BenefDecreto561 <> 0 Then
    
    SetValuePriority ( 0 , GetThisNodeId ( ) , "SAR_IG_DEC142_AUX" , -1 , SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_IG_DEC142_AUX )
    SetValuePriority ( 0 , GetThisNodeId ( ) , "SAR_DIF_TOT_DEVOL" , -1 , SAR_ACM_ULT_PAGO_IMPUT[0].SAR_DIF_TOT_DEVOL )
    
    Return(BenefDecreto561)
Else
    BaseAjusteDec561 = BaseAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_BASE_IMPUESTO         // para aplicar el porcentaje y obtener el impuesto
    BaHEAjusteDec561 = BaHEAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_B_IMP_SIN_HEXT        // para obtener el porcentaje de impuesto
    ImpuAjusteDec561 = ImpuAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_IMPUESTO_TOTAL        // impuesto acumulado
    
    DEspAjusteDec561 = DEspAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_IG_DED_ESP            // 5041       SAR_IG_DED_ESP        Deducción especial
    GNImAjusteDec561 = GNImAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_IG_G_NO_IMP           // 5040       SAR_IG_G_NO_IMP       Ganancias no imponibles
    
    ServAjusteDec561 = ServAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_SERV_DOMEST           // 5075       SAR_SERV_DOMEST       Servicio Doméstico 
    DSerAjusteDec561 = DSerAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_DED_SER_DOM           // 5077       SAR_DED_SER_DOM       Importe deducible de Servicio Doméstico
        
    ViatAjusteDec561 = ViatAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_IG_VIATICOS           // 4950       SAR_IG_VIATICOS       Declar. Jurada Gastos de Movilidad Viáticos
    DViaAjusteDec561 = DViaAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_DED_IG_VIATICOS       // 4960       SAR_DED_IG_VIATICOS   Ded. Gastos de Movilidad Viáticos 
    
    VComAjusteDec561 = VComAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_JUR_VEHIC_COR         // 4916       SAR_JUR_VEHIC_COR     Declar. Jurada vehículos corredores comercio
    MComAjusteDec561 = MComAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_JUR_MOV_COR           // 4917       SAR_JUR_MOV_COR       Declar. Jurada movilidad corredores comercio  
    DComAjusteDec561 = DComAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_IG_GTOS_COR           // 5038       SAR_IG_GTOS_COR       I.G. Gastos Movilidad Corredores comercio
    
    AlquAjusteDec561 = AlquAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_IG_ALQUILER           // 4952       SAR_IG_ALQUILER       Declar. Jurada Alquileres de Inmuebles 
    DAlqAjusteDec561 = DAlqAjusteDec561 + SAR_ACM_ULT_PAGO_IMPUT_REV[0].SAR_DED_IG_ALQUILER       // 4962       SAR_DED_IG_ALQUILER   Ded. Gastos de Alquileres de Inmuebles      
EndIf        

   
'------------------------------------------------------------------
' Restauramos la base con las deducciones afectadas por el cambio
'------------------------------------------------------------------
DeducAjusteDec561 = DEspAjusteDec561 + GNImAjusteDec561 + DSerAjusteDec561 + DViaAjusteDec561 + DComAjusteDec561 + DAlqAjusteDec561
BaseAjusteDec561 = BaseAjusteDec561 + DeducAjusteDec561
BaHEAjusteDec561 = BaHEAjusteDec561 + DeducAjusteDec561
         
'---------------------------------------------------------------
' Valores nuevos que debemos aplicar
'---------------------------------------------------------------
indZonaPat = SAR_IND_ZONA_PAT              'indicador zona patagónica
indDeduc   = SAR_IND_DED_IG_2010           'indicador deducción 2010
If indZonaPat = 1 Then
    DEspValorMensual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_DED_ESPECIAL_REDUC",FePagoIG,indDeduc))/12
    GNImValorMensual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_GAN_NO_IMP_REDUC",FePagoIG,indDeduc))/12
Else
    DEspValorMensual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_DED_ESPECIAL",FePagoIG,indDeduc))/12
    GNImValorMensual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_GAN_NO_IMP",FePagoIG,indDeduc))/12
EndIf
TSerValorMensual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_TOPE_SER_DOM",FePagoIG,indDeduc))/12   

If IsNull(DEspValorMensual) = True Then DEspValorMensual = 0
If IsNull(GNImValorMensual) = True Then GNImValorMensual = 0
If IsNull(TSerValorMensual) = True Then TSerValorMensual = 0
    
DEspNuevaDec561 = Round(DEspValorMensual * MMAjusteDec561, SCO_CURR_DECIMALS)   // Deducción Especial
GNImNuevaDec561 = Round(GNImValorMensual * MMAjusteDec561, SCO_CURR_DECIMALS)   // Ganancia no Imponible

tope_serv       = Round(TSerValorMensual * MMAjusteDec561, SCO_CURR_DECIMALS)   // Tope Servicio doméstico
DSerNuevaDec561 = Min(ServAjusteDec561, tope_serv)                              // Servicio Doméstico RG 1978 AFIP

tope_viaticos   = Percentage(SAR_TOPE_PORC_VIATICO, tope_serv)
DViaNuevaDec561 = Min(ViatAjusteDec561, tope_viaticos)                          // Gastos de Movilidad Viáticos RG 4003

tope_viajantes  = Percentage(SAR_TOPE_GTOS_COR, tope_serv)
viajantes       = Min(MComAjusteDec561, tope_viajantes)
DComNuevaDec561 = VComAjusteDec561 + viajantes                                  // Gastos de Movilidad Corredores y Viajantes de comercio RG 4003

DAlqNuevaDec561 = Min(AlquAjusteDec561, tope_serv)                              // Alquileres de Inmuebles RG 4003

'------------------------------------------------------------------
' Calculamos base con deducciones por valores nuevos
'------------------------------------------------------------------
DeducNuevaDec561 = DEspNuevaDec561 + GNImNuevaDec561 + DSerNuevaDec561 + DViaNuevaDec561 + DComNuevaDec561 + DAlqNuevaDec561

BaseAjusteDec561 = BaseAjusteDec561 - DeducNuevaDec561
BaHEAjusteDec561 = BaHEAjusteDec561 - DeducNuevaDec561    

SAR_IG_DEC142_AUX = BaHEAjusteDec561            // Para revisión se guarda la base de impuesto calculada incluyendo HE
SAR_DIF_TOT_DEVOL = BaseAjusteDec561            // Para revisión se guarda la base de impuesto calculada

'------------------------------------------------------------------
' Calculamos el porcentaje de impuesto a aplicar y la parte fija
'------------------------------------------------------------------
base = BaHEAjusteDec561
If BaHEAjusteDec561 < 0 And BaseAjusteDec561 > 0 Then base = 0
PorcNuevaDec561 = SAR_IMPUESTO.SAR_RETORNA_PORCENTAJE(base,FinAjusteDec561,ID_CURRENCY)
CFijNuevaDec561 = SAR_IMPUESTO.SAR_RETORNA_CUOTA_FIJA(base,FinAjusteDec561,ID_CURRENCY)
IDesNuevaDec561 = SAR_IMPUESTO.SAR_RETORNA_VALOR     (base,FinAjusteDec561,ID_CURRENCY)

'------------------------------------------------------------------
' Calculamos el impuesto con los nuevos valores
'------------------------------------------------------------------
ImpuNuevaDec561 = CFijNuevaDec561 + PorcNuevaDec561 * (BaseAjusteDec561 - IDesNuevaDec561)/100
If IsNull(ImpuNuevaDec561) = M4_TRUE Then ImpuNuevaDec561 = 0

'------------------------------------------------------------------
' Calculamos el beneficio por el Decreto 561/2019
'------------------------------------------------------------------
BenefDecreto561 = ImpuNuevaDec561 - ImpuAjusteDec561

'------------------------------------------------------------------
' Control: Si hubo imposibilidad de retención, el beneficio se minora hasta ella
'------------------------------------------------------------------
impor_ret = SAR_ACM_ULT_PAGO_IMPUT[0].SAR_SALD_RET_GAN_ST * -1
BenefDecreto561 = Min(BenefDecreto561 - impor_ret,0)

Return Round(BenefDecreto561,SCO_CURR_DECIMALS)
