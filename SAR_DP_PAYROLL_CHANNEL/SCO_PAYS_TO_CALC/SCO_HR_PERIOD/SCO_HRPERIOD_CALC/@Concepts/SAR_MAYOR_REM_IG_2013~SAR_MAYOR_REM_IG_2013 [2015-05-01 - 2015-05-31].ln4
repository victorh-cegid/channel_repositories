'Recorro el acumulado para obtener el v792 del mes anterior al que estoy liquidando.
    '----------------------------------------------------------------------------------------------
    ANIO_ACT = DXYEAR(SAR_FEC_PAGO_IG)
    MES_ACT  = DXMONTH(SAR_FEC_PAGO_IG)
    
    if SAR_ES_BAJA = 1 Then
        ANIO_ACT = DXYEAR(SCO_DT_PAYMENT)
        MES_ACT  = DXMONTH(SCO_DT_PAYMENT)
    endif
    
    If(MES_ACT = 1)Then
        MES_ANT = 12   
        ANIO_ANT = ANIO_ACT - 1
    Else   
        MES_ANT = MES_ACT - 1 
        ANIO_ANT = ANIO_ACT  
    EndIf
    
    DIAS_MES_ANT     = DaysOfMonth(MES_ANT)
    DIAS_MES_ANT_STR = ToString(DIAS_MES_ANT, 0)
    
    If(MES_ANT < 10)Then
        MES_ANT_STR = "0" + ToString(MES_ANT, 0)
    Else
        MES_ANT_STR = ToString(MES_ANT, 0)
    EndIf
    
    ANIO_ANT_STR  = Tostring(ANIO_ANT, 0)
    
    F_MES_ANT_INI = ToDate(ANIO_ANT_STR + "-" + MES_ANT_STR + "-" + "01")
    F_MES_ANT_FIN = ToDate(ANIO_ANT_STR + "-" + MES_ANT_STR + "-" + DIAS_MES_ANT_STR)  
    
    
    'Iniciamos la lectura del acumulado:
    SCO_AC_HR_PERIOD_READ_1.BEGIN()                 'Iniciamos el acumulado
    CantReg = SCO_AC_HR_PERIOD_READ_1.Count()-1    'Inicializamos el numero de registros
    
    If(CantReg >= 0) Then
      ContReg = 0                                     'Lleva el numero leido de registros 
      V792_ant  = 0
      While (ContReg <= CantReg)
         SCO_AC_HR_PERIOD_READ_1.MoveTo(ContReg)
         If(SCO_AC_HR_PERIOD_READ_1.SAR_FEC_PAGO_IG >= F_MES_ANT_INI And SCO_AC_HR_PERIOD_READ_1.SAR_FEC_PAGO_IG <= F_MES_ANT_FIN And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1") Then
             V792_ant  = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
         EndIf
         ContReg = ContReg + 1
      Wend    
    EndIf
    '-------------------------------------------------------------------------------
recalc = 0
If (V792_ant = 3) or(V792_ant = 0) Then
   recalc = 1
EndIf
'--------------------------------------------------------------------------------------------------------------
' Por Resolucion 3770
'       Para altas entre Septiembre 2013 y Mayo 2015, con Rango 2 y
'       Para rango 3 y 0 sin importar el alta
'       se debe recalcular la mejor Remuneracion teniendo en cuenta lo percibido de Enero a Abril de 2015.
'--------------------------------------------------------------------------------------------------------------  
If  (((SAR_FECHA_ALTA >= ToDate("2013-09-01"))and (SAR_FECHA_ALTA < ToDate("2015-05-01")) and  (V792_ant = 2)) or  (recalc = 1)) and (SCO_DT_PAYMENT = SCO_DT_ALLOCATION )Then         
    
    ' Se recalculan los conceptos no habituales de Enero a Abril de 2015 y se evalua la mejor remuneracion.
    '------------------------------------------------------------------------------------------------------
    
    ContConcep  = 0 
    
    ENERO       = TODATE("2015-01-01")
    FEBRERO     = TODATE("2015-02-01")
    MARZO       = TODATE("2015-03-01")
    ABRIL       = TODATE("2015-04-01")
    MAYO        = TODATE("2015-05-01")
    
    MaxENE  = 0
    MaxFEB  = 0
    MaxMAR  = 0
    MaxABR  = 0
    MaxAGO  = 0  
    
    MAX_REM = 0
    
    SAC_1   = 0
    EGRE_1  = 0
    
    GREM_1  = 0
    GREM_2  = 0
    GREM_3  = 0
    GREM_4  = 0
    
    
    SRAR_PY_MN_HABITUALES.DESTROYBLOCK()                   'Inicializamos los conceptos no habituales del empleadoc
    SRAR_PY_MN_HABITUALES.SAR_P_PROCESO = MAYO
    SRAR_PY_MN_HABITUALES.LOAD_BLK() 
    SRAR_PY_MN_HABITUALES.Begin() 
    CantRegHab = SRAR_PY_MN_HABITUALES.Count()
    
    SCO_AC_HR_PERIOD_READ_1.BEGIN()                  'Iniciamos el acumulado
    SCO_AC_HR_PERIOD_READ_1.MoveTo(0)                'Vamos al primer registro
    CantReg = SCO_AC_HR_PERIOD_READ_1.Count() - 1    'Inicializamos el numero de registros
    
    ContReg = 0
            
    
    While (ContReg <= CantReg)
    
        'Maximo de Enero
        If(SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= ENERO  And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION < FEBRERO)Then
            SAC_1   = SCO_AC_HR_PERIOD_READ_1.SAR_PAGA_EXTRA_1..sysTotalSlices(M4_TOTAL_SUM)    
            EGRE_1  = SCO_AC_HR_PERIOD_READ_1.SAR_EGRESO_PAGA_1..sysTotalSlices(M4_TOTAL_SUM)   
            DIA_GRE = SCO_AC_HR_PERIOD_READ_1.SAR_DIA_GREMIO..sysTotalSlices(M4_TOTAL_SUM)  
            
            'No habituales
            ContConcep = 0
            TotNoHabit = 0
            If(CantRegHab > 0)Then
        
                SRAR_PY_MN_HABITUALES.Moveto(ContConcep)                          
                While (ContConcep < CantRegHab)                                                                         
                     Concepto   = SRAR_PY_MN_HABITUALES.SAR_ID_DMD_COMPONENT 
                     ValCon     = GetValue("SCO_AC_HR_PERIOD_READ_1",Concepto,-1)  'Tomamos el valor del concepto que se encuentra acumulado.
                     TotNoHabit = TotNoHabit + ValCon
                     ContConcep = ContConcep + 1
                     
                     If(ContConcep < CantRegHab) Then 'CantConcep)Then
                        SRAR_PY_MN_HABITUALES.MoveTo(ContConcep)
                     EndIf                                                                  
                 Wend            
             EndIf    
             MaxENE = MaxENE + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_DEVENGOS..sysTotalSlices(M4_TOTAL_SUM) - SAC_1 - EGRE_1 - DIA_GRE - TotNoHabit              
        EndIf       
               
        'Maximo de Febrero
        If(SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= FEBRERO And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION < MARZO)Then
            SAC_1   = SCO_AC_HR_PERIOD_READ_1.SAR_PAGA_EXTRA_1..sysTotalSlices(M4_TOTAL_SUM)    
            EGRE_1  = SCO_AC_HR_PERIOD_READ_1.SAR_EGRESO_PAGA_1..sysTotalSlices(M4_TOTAL_SUM)   
            DIA_GRE = SCO_AC_HR_PERIOD_READ_1.SAR_DIA_GREMIO..sysTotalSlices(M4_TOTAL_SUM)  
            
            'No habituales
            ContConcep = 0
            TotNoHabit = 0
            
            If(CantRegHab > 0)Then
                SRAR_PY_MN_HABITUALES.MoveTo(ContConcep)
                While ContConcep < CantRegHab    
                     Concepto   = SRAR_PY_MN_HABITUALES.SAR_ID_DMD_COMPONENT 
                     ValCon     = GetValue("SCO_AC_HR_PERIOD_READ_1",Concepto,-1)  'Tomamos el valor del concepto que se encuentra acumulado.
                     TotNoHabit = TotNoHabit + ValCon
                     ContConcep = ContConcep + 1
                     
                     If(ContConcep < CantRegHab) Then 
                        SRAR_PY_MN_HABITUALES.MoveTo(ContConcep)
                     EndIf   
                 Wend            
             EndIf    
             MaxFEB  = MaxFEB + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_DEVENGOS..sysTotalSlices(M4_TOTAL_SUM) - SAC_1 - EGRE_1 - DIA_GRE - TotNoHabit              
        EndIf

               
        'Maximo de Marzo
        If(SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= MARZO   And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION < ABRIL)Then
            SAC_1   = SCO_AC_HR_PERIOD_READ_1.SAR_PAGA_EXTRA_1..sysTotalSlices(M4_TOTAL_SUM)    
            EGRE_1  = SCO_AC_HR_PERIOD_READ_1.SAR_EGRESO_PAGA_1..sysTotalSlices(M4_TOTAL_SUM)   
            DIA_GRE = SCO_AC_HR_PERIOD_READ_1.SAR_DIA_GREMIO..sysTotalSlices(M4_TOTAL_SUM)
            
            'No habituales
            ContConcep = 0
            TotNoHabit = 0
            
            If(CantRegHab > 0)Then
                SRAR_PY_MN_HABITUALES.MoveTo(ContConcep)
                While ContConcep < CantRegHab   
                     Concepto   = SRAR_PY_MN_HABITUALES.SAR_ID_DMD_COMPONENT 
                     ValCon     = GetValue("SCO_AC_HR_PERIOD_READ_1",Concepto,-1)  'Tomamos el valor del concepto que se encuentra acumulado.
                     TotNoHabit = TotNoHabit + ValCon
                     ContConcep = ContConcep + 1
                     
                     If(ContConcep < CantRegHab) Then 
                        SRAR_PY_MN_HABITUALES.MoveTo(ContConcep)
                     EndIf   
                 Wend 
             EndIf               
             MaxMAR  = MaxMAR + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_DEVENGOS..sysTotalSlices(M4_TOTAL_SUM) - SAC_1 - EGRE_1 - DIA_GRE - TotNoHabit              
        EndIf
               
               
        'Maximo de Abril
        If(SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= ABRIL   And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION < MAYO)Then
            SAC_1   = SCO_AC_HR_PERIOD_READ_1.SAR_PAGA_EXTRA_1..sysTotalSlices(M4_TOTAL_SUM)    
            EGRE_1  = SCO_AC_HR_PERIOD_READ_1.SAR_EGRESO_PAGA_1..sysTotalSlices(M4_TOTAL_SUM)   
            DIA_GRE = SCO_AC_HR_PERIOD_READ_1.SAR_DIA_GREMIO..sysTotalSlices(M4_TOTAL_SUM)
            
            'No habituales
            ContConcep = 0
            TotNoHabit = 0
            
            If(CantRegHab > 0)Then
                 SRAR_PY_MN_HABITUALES.MoveTo(ContConcep)
                 While ContConcep < CantRegHab  
                     Concepto   = SRAR_PY_MN_HABITUALES.SAR_ID_DMD_COMPONENT 
                     ValCon     = GetValue("SCO_AC_HR_PERIOD_READ_1",Concepto,-1)  'Tomamos el valor del concepto que se encuentra acumulado.
                     TotNoHabit = TotNoHabit + ValCon
                     ContConcep = ContConcep + 1
                     If(ContConcep < CantRegHab) Then 'CantConcep)Then
                        SRAR_PY_MN_HABITUALES.MoveTo(ContConcep)
                     EndIf   
                 Wend
             EndIf                
             MaxABR  = MaxABR + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_DEVENGOS..sysTotalSlices(M4_TOTAL_SUM) - SAC_1 - EGRE_1 - DIA_GRE - TotNoHabit              
        EndIf
               
        If(ContReg <= CantReg)Then
           ContReg = ContReg + 1
        EndIf   
        SCO_AC_HR_PERIOD_READ_1.MoveTo(ContReg)
     Wend
              
    
    If(MaxENE >= MAX_REM)Then
      MAX_REM = MaxENE
    EndIf  
    
    If(MaxFEB >= MAX_REM)Then  
      MAX_REM = MaxFEB
    EndIf  
    
    If(MaxMAR >= MAX_REM)Then  
      MAX_REM = MaxMAR
    EndIf  
    
    If(MaxABR >= MAX_REM)Then  
      MAX_REM = MaxABR
    EndIf  
    
    MaxV = MAX_REM 
  
Else


    V5600_ant = 0
    V792_ant = 0
    
    'Recorro el acumulado para obtener el 5600 y el 792 del mes anterior al que estoy liquidando.
    '----------------------------------------------------------------------------------------------
    ANIO_ACT = DXYEAR(SAR_FEC_PAGO_IG)
    MES_ACT  = DXMONTH(SAR_FEC_PAGO_IG)
    
    if SAR_ES_BAJA = 1 Then
        ANIO_ACT = DXYEAR(SCO_DT_PAYMENT)
        MES_ACT  = DXMONTH(SCO_DT_PAYMENT)
    endif
    
    If(MES_ACT = 1)Then
        MES_ANT = 12   
        ANIO_ANT = ANIO_ACT - 1
    Else   
        MES_ANT = MES_ACT - 1 
        ANIO_ANT = ANIO_ACT  
    EndIf
    
    DIAS_MES_ANT     = DaysOfMonth(MES_ANT)
    DIAS_MES_ANT_STR = ToString(DIAS_MES_ANT, 0)
    
    If(MES_ANT < 10)Then
        MES_ANT_STR = "0" + ToString(MES_ANT, 0)
    Else
        MES_ANT_STR = ToString(MES_ANT, 0)
    EndIf
    
    ANIO_ANT_STR  = Tostring(ANIO_ANT, 0)
    
    F_MES_ANT_INI = ToDate(ANIO_ANT_STR + "-" + MES_ANT_STR + "-" + "01")
    F_MES_ANT_FIN = ToDate(ANIO_ANT_STR + "-" + MES_ANT_STR + "-" + DIAS_MES_ANT_STR)  
    
    
    'Iniciamos la lectura del acumulado:
    SCO_AC_HR_PERIOD_READ_1.BEGIN()                 'Iniciamos el acumulado
    CantReg = SCO_AC_HR_PERIOD_READ_1.Count()-1    'Inicializamos el numero de registros
    
    If(CantReg >= 0) Then
      ContReg = 0                                     'Lleva el numero leido de registros 
      MaxV = 0
     'Maximo del Mes anterior:
      While (ContReg <= CantReg)
         SCO_AC_HR_PERIOD_READ_1.MoveTo(ContReg)
         If(SCO_AC_HR_PERIOD_READ_1.SAR_FEC_PAGO_IG >= F_MES_ANT_INI And SCO_AC_HR_PERIOD_READ_1.SAR_FEC_PAGO_IG <= F_MES_ANT_FIN And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1") Then
             V5600_ant = V5600_ant + SCO_AC_HR_PERIOD_READ_1.SAR_MAYOR_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM)
             V792_ant  = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
         EndIf
         ContReg = ContReg + 1
      Wend       
    EndIf
     '-------------------------------------------------------------------------------
    
    
    '------------------------------------------------------------------------------------------------------------------------------------------------------
    'Por Resolucion 3770
    'En los casos en que el importe de la mayor Remuneracion y/o haber devengado en el periodo enero a agosto de 2013 NO supera los $15.000  
    'y en los casos en que sean sujetos que hayan iniciado sus actividades como empleados en relacion de dependencia a partir del mes de Septiembre de 2013 
    'con salario del primer mes inferior a $15.000
    'no seran pasible de retencion
    'Es decir todos los casos de Rango 1, continuan en Rango 1.
    
    'En los casos en que el importe de la mayor Remuneracion y/o haber devengado en el periodo enero a agosto de 2013 supera los $15.000 y no supera los $25.000
    'Es decir todos los casos de altas anteriores a Septiembre de Rango 2, No se revisa su remuneracion y se recategorizan segun Anexo A.
    '-------------------------------------------------------------------------------------------------------------------------------------------------------
    If (ContReg >= 0) Then
        MaxV = V5600_ant
    Endif
       
     
    '-------------------------------------------------------------------------------------------------------------------
    'Por Resolucion 3770
    'En los casos de altas posteriores a Mayo 2015:
    '   *En el mes del alta se debe tomar la Remuneracion del mes completa.  
    '   *En meses posteriores al alta, tomamos el 5600 del acumulado (que seria el 5600 obtenido en el mes del alta)
    '-------------------------------------------------------------------------------------------------------------------
     
    If  (SAR_FECHA_ALTA >= ToDate("2015-05-01")) And  (SCO_DT_PAYMENT = SCO_DT_ALLOCATION) Then
        'Mes del alta    
        If SAR_ES_ALTA = 1 Then          
            SAC_1   = SAR_PAGA_EXTRA_1       'SAC 1er. Semestre
            SAC_2   = SAR_PAGA_EXTRA_2       'SAC 2do. Semestre
            EGRE_1  = SAR_EGRESO_PAGA_1      'Egreso 1er. Semestre
            EGRE_2  = SAR_EGRESO_PAGA_2      'Egreso 2do. Semestre
            DIA_GRE = SAR_DIA_GREMIO         'Dia del gremio.
            MaxMes  = SAR_P_SUELDO + SAR_TOTAL_DEVENGOS - SAR_IMPORTE_SUELDO  '1 - Primer asignacion para entender que tenemos el total de devengos.
            MaxMes  = MaxMes -  SAC_1 - SAC_2 - EGRE_1 -  EGRE_2 - DIA_GRE    '2 - Al total de devengos le restamos los conceptos de SAC y el dia del gremio 
            MaxV    = MaxMes    
        Else   
            'Meses posteriores al alta.      
            MaxV = V5600_ant        
        EndIf   
         
    Endif 
    
Endif

Return(MaxV)
