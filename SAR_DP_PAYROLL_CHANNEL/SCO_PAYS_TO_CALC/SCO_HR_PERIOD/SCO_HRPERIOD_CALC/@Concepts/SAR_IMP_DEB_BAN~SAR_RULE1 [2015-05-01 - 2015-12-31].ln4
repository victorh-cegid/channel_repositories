'Calculamos la deduccion por impuesto a los debitos y creditos
'si es una liquidacion anual o final segun la R.G. 1674/2004

valor=0


IF SAR_TP_IMPUT = "99" OR (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") THEN
   'Se suman el SAR_DEBITO_BANCARIO y el SAR_PAG_CUEN_EXT por aplicacion del 15 % de devolucion en compras al exterior.
   x = SAR_DEBITO_BANCARIO + SAR_PAG_CUENT_EXT
   
   if SAR_IMPUESTO_TOTAL > 0 and x > 0 Then
        val_1 = SAR_IMPUESTO_TOTAL + SAR_SALDO_DIF_TOT_DEVOL 'por res 3770/2015 debemos descontar el saldo pendiente de devolucion.
        
        valor= Min(x,val_1) 'Con este control verificamos que no le descontemos un importe superior al impuesto calculado
   else
     valor= Min(x,SAR_IMPUESTO_TOTAL)
   endif
 
ENDIF

RETURN(valor)  'Importe efectivamente deducido
