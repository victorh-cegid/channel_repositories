If SAR_TP_IMPUT = "88" Then Return(0)                                       'No corresponde beneficio en la paga 88 - Anticipo de vacaciones
If SAR_TP_IMPUT = "77" And DxMonth(SCO_DT_ALLOCATION) < DxMonth(SAR_HR_PERIOD.SCO_DT_ALLOC_START) Then Return(0)

importe        = SAR_FINAN_APO_JUB
importeInicial = importe

TopeRemunBrutaDev = 60000

' Financiación aplicada en pagas anteriores dentro del mes de proceso
DifJubMesAct      = SAR_ACM_MES_ACTUAL_DIF[0].SAR_FINAN_APO_JUB_DIF
DifJubSACMesAct   = SAR_ACM_MES_ACTUAL_DIF[0].SAR_FINAN_APO_JUB_SAC_DIF
DifJubVACMesAct   = SAR_ACM_MES_ACTUAL_DIF[0].SAR_FINAN_APO_JUB_VAC_DIF 
TotalDifJubMesAct = DifJubMesAct + DifJubSACMesAct + DifJubVACMesAct
    
RemunBrutaDevPaga   = SAR_TOT_SUE_ADI_SICOSS                                        ' Total  Sueldo + Adicional SICOSS de la paga procesada
RemunBrutaDevMesAct = SAR_ACM_MES_ACTUAL_DIF[0].SAR_TOT_SUE_ADI_SICOSS              ' Total  Sueldo + Adicional SICOSS de pagas anteriores en el mismo mes de proceso
RemunBrutaDevMes    = RemunBrutaDevPaga + RemunBrutaDevMesAct

TopeRemunBrutaTot = TopeRemunBrutaDev
    
If RemunBrutaDevMes > TopeRemunBrutaTot Then 
    If TotalDifJubMesAct <> 0 Then SAR_FINAN_APO_JUB_AUX = 4561                 ' Art.4 Decreto 561, aviso para devolución del aporte financiado en el concepto #6000   
    Return(0)
EndIf

' Jornada parcial, reduce el importe inicial
coef = SAR_COEF_JORNADA_PER                                      

importe = importe * coef

'Parte proporcional para jornales
If SAR_TIPO_SALARIO = "003" Then 
    coefJornales = 0
    horasPaga = 0

    'Si en la paga hay horas informadas, hace precio diario, en cualquier otra situación, se usará el modelo de semana.
    HorasInformadas = SAR_CANT_HS_TRABAJADAS
    horasTotales    = SAR_HORAS_MES
    If HorasInformadas > 0 THEN
        horasPaga = HorasInformadas
    ElseIf SCO_NUM_HOURS_THEO > 0 THEN
        horasPaga = SAR_CALC_HORAS_TEORICAS (SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC,SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC)
    EndIf
    If horasTotales > 0 Then coefJornales = horasPaga / horasTotales

    impoNor = importe * coefJornales

    impoNor = Bound(impoNor - TotalDifJubMesAct, 0, importeInicial)             'Topamos la financiación total del mes al valores recibido por valores empresa (2.000 PESOS)
    impoNor = Max  (impoNor + TotalDifJubMesAct, 0) 
        
    impoFin = impoNor
'Parte proporcional para el resto de empleados
Else
    'Parte proporcional mes alta/baja
    DiasNormal30  = SAR_DIAS_NORM_SUELD                                         'Días normalizados de sueldo, para topar a 30 
    DiasNormaliz = DiasNormal30  
    If SAR_ES_BAJA = 1 Then DiasNormaliz = SAR_PAYS_TO_CALC.SCO_DAYS_NUM_ALLOC  'Días de la paga si estamos en el mes de baja, en el caso del mes de alta no es necesario
    DiasPostBaja  = SAR_DIAS_POST_BAJA                                          'Días posteriores a la fecha de baja del empleado
    DiasAnteAlta  = SAR_DIAS_ANT_ALTA                                           'Días anteriores a la fecha de alta del empleado
    DiasLicNoDesc = SAR_DIAS_LIC_NO_RETRIB                                      'Total días en el mes con Licencia no retribuida
    DiasVacacPago = SAR_UN_VACACIONES                                           'Días de vacaciones pagadas en la paga en proceso
    DiasVacacPago = DiasVacacPago + SAR_ACM_MES_ACTUAL_DIF[0].SAR_UN_VACACIONES     'Sumamos los Días de vacaciones ya pagadas en el mes actual
    DiasVacacDesc = SAR_DIAS_VACACIONES                                         'Días de vacaciones descontadas en el mes
    
    DiasAltaReal  = Max(DiasNormaliz - DiasPostBaja - DiasAnteAlta - DiasLicNoDesc, 0)
    DiasAltaProp  = DiasAltaReal / DiasNormal30

    impoNor = importe * DiasAltaProp
    
    impoNor = Bound(impoNor - TotalDifJubMesAct, 0, importeInicial)             'Topamos la financiación total del mes al valores recibido por valores empresa (2.000 PESOS)
    impoNor = Max(impoNor + TotalDifJubMesAct, 0)    
    
    impoFin = impoNor
EndIf

impoFin = Round(impoFin, SCO_CURR_DECIMALS)

SAR_FINAN_APO_JUB_AUX = impoFin                                                 'Propiedad auxiliar para llevar la cuenta de lo descontado en total

Return(impoFin)
