If (SAR_TP_IMPUT = "77" And SAR_VACACIONES = 0) Or SAR_TP_IMPUT = "88" Or SAR_TP_IMPUT = "99" Or SAR_IND_NO_RET_GAN = 1 Then Return(0)
'Si la baja no finaliza el último día del mes no se calcula impuesto
If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" And (DxDay(SAR_FECHA_BAJA) <> DaysOfMonth(SAR_FECHA_BAJA) Or (SAR_FECHA_BAJA < SCO_DT_ALLOCATION and SAR_IMPUESTO_TOTAL = 0)) Then Return (0)
'En revisión, salvo en baja, no se calcula impuesto, devuelve valor original para no generar retención
imp_retro = 0
If SAR_IND_IMPUESTO_RETRO = 1 Then imp_retro = 1
If SAR_PAYS_TO_CALC.SAR_REVISION = 1 And imp_retro = 0 And ((SAR_ES_BAJA <> 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Or (SAR_ES_BAJA = 1 And SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1)) Then Return (SCO_AC_HR_PERIOD_REV_1.SAR_IMPUESTO)

impuesto_tot = SAR_JUN23_IMP_TOTAL
imp_ae = SAR_IMP_ANT_EMP
imp_oe = SAR_IMP_OTROS_EMP
imp_ban = SAR_IMP_DEB_BAN

impuesto_acum = SAR_ACM_IG_ANIO_IMPUT[0].SAR_IG_FINAL + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IMPUESTO
valor = impuesto_tot - imp_ae - imp_oe - impuesto_acum - imp_ban

'valores acumulados del mes
vTotal_Dev       = SAR_ACM_MES_ACT_IG[0].SAR_TOT_DEVENGO
vREM_26341       = SAR_ACM_MES_ACT_IG[0].SAR_TI_REM_26341_ST
vAJUSTE_SAL_FAM  = SAR_ACM_MES_ACT_IG[0].SAR_AJUSTE_SAL_FAM
vASIGNAC_HIJOS   = SAR_ACM_MES_ACT_IG[0].SAR_ASIGNAC_HIJOS
vASIG_HIJOS_INC  = SAR_ACM_MES_ACT_IG[0].SAR_ASIG_HIJOS_INC
vASIG_PRENATAL   = SAR_ACM_MES_ACT_IG[0].SAR_ASIG_PRENATAL
vAYUDA_ESC_PRIM  = SAR_ACM_MES_ACT_IG[0].SAR_AYUDA_ESC_PRIM
vAY_ESC_PRIM_INC = SAR_ACM_MES_ACT_IG[0].SAR_AY_ESC_PRIM_INC
vAS_REM_26341_ST = SAR_ACM_MES_ACT_IG[0].SAR_AS_REM_26341_ST
vTotal_ret_mes   = SAR_ACM_MES_ACT_IG[0].SAR_IG_FINAL + SAR_ACM_MES_ACT_IG[0].SAR_IMPUESTO

'Se agrega el valor del mes para el calculo del tope del 35%, para casos con pagas extras.
vBase =  vTotal_Dev - vREM_26341 - vAJUSTE_SAL_FAM - vASIGNAC_HIJOS - vASIG_HIJOS_INC - vASIG_PRENATAL - vAYUDA_ESC_PRIM - vAY_ESC_PRIM_INC - vAS_REM_26341_ST
base = (SAR_TOTAL_DEVENGOS..Systotalslices(M4_TOTAL_SUM) + SAR_BRUTO_OE_MES) - SAR_TI_REM_26341_ST - SAR_AJUSTE_SAL_FAM - SAR_ASIGNAC_HIJOS - SAR_ASIG_HIJOS_INC - SAR_ASIG_PRENATAL - SAR_AYUDA_ESC_PRIM - SAR_AY_ESC_PRIM_INC - SAR_AS_REM_26341_ST 

base = base + (SAR_IMP_DEC792_NRED - SAR_IMP_DEC792)

Tope = Max((base + vBase) * SAR_PP_RET_GAN_ST/100,0)
valor_imp_mes = valor + vTotal_ret_mes

'Si es baja y su retención excede el tope permitido generamos la diferencia
If SAR_ES_BAJA = 0 Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" And SAR_IND_APLIC_TOPE_35 = 1) Then
    SAR_SALD_RET_GAN_ST = Max(valor_imp_mes - tope,0)
    If valor_imp_mes > tope Then
         tope = tope - vTotal_ret_mes
         valor = tope
    Endif
EndIf
Return(Round(valor,2))
