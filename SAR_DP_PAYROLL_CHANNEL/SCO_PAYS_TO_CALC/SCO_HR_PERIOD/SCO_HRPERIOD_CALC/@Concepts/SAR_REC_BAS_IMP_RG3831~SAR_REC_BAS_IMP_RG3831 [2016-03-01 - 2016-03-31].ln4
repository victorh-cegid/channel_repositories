'Solo se debe calcular en paga normal.
IF SAR_TP_IMPUT = "2" OR (SAR_TP_IMPUT = "4" and SAR_ES_ALTA = 0) OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR SAR_ES_BAJA = 1 THEN Return(0)

'---------------------------------------------------
'          Inicialización de variables
'---------------------------------------------------
aux = 0
base = 0           
nummes = 0              'Mes de pago

fam = 0                 'Familiares a cargo
gni_ant = 0             'Ganancia no imponible dto.1242/2013
desp_ant = 0            'Deducción especial dto.1242/2013
val_cony_ig = 0         'Valor Conyuge dto.1242/2013
val_h_ig = 0            'Valor Hijo dto.1242/2013
val_o_car = 0           'Valor Otras cargas dto.1242/2013
fam_ig = 0              'Familiares IG dto.1242/2013
ded_tot_mes_ant = 0     'Deducciones totales mes anterior
bas_imp_ant = 0         'Base impuesto mes anterior sin deducciones

gni_nvo = 0             'Ganancia no imponible dto.394/2016
desp_nvo = 0            'Deducción especial dto.394/2016
val_cony_ig_nvo = 0     'Valor Conyuge dto.394/2016
val_h_ig_nvo = 0        'Valor Hijo dto.394/2016
val_o_car_nvo = 0       'Valor Otras cargas dto.394/2016
deduc_tot_act = 0       'Deducciones dto.394/2016
bas_imp_s_ded = 0       'Base impuesto sin deducciones mes anterior

imp_nvo = 0             'Nuevo impuesto a prorratear RG 3831/16
meses_pro = 0           'Cantidad de meses a prorratear cuota RG 3831/16

val_serv_dom = 0        'Servicio Domestico
val_serv_dom_nvo = 0    'Servicio Domestico recalculo

'---------------------------------------------------------------------------------------
'                                  Inicio del cálculo
'---------------------------------------------------------------------------------------

'Calculamos el mes de pago.

nummes = SAR_MES_PAGO_IG - 1


SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()
'agregar año para que no busque 2015

    FOR I = 0 TO ULTIMO_REG -1
        SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
        mes_p_ig =  DxMonth(SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG)
        anio_ig =   DxYear(SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG)
        pay_tp = SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC

        If SAR_TP_IMPUT = "3" and (mes_p_ig = DxMonth(SCO_DT_ALLOCATION)) Then
            nummes = SAR_MES_PAGO_IG
        Endif 

        'Armo los datos
        IF (nummes = mes_p_ig AND anio_ig = 2016) AND ((pay_tp = "1" or pay_tp = "4") and (SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT)) THEN 
            fec_ig_ant = SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG
            gni_ant = SCO_AC_HR_PERIOD_READ_1.SAR_IG_G_NO_IMP                                                           'Ganancia no imponible
            desp_ant = SCO_AC_HR_PERIOD_READ_1.SAR_IG_DED_ESP - SCO_AC_HR_PERIOD_READ_1.SAR_IG_DEC142_AUX               'Deducción especial
            val_cony_ig = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_CONY_IG                                                       'Valor conyuge
            val_h_ig = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_HIJO_IG                                                          'Valor hijo
            val_o_car = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_O_CAR_IG                                                        'Valor otras cargas

            val_serv_dom = SCO_AC_HR_PERIOD_READ_1.SAR_SERV_DOMEST                                                      'Servicio Domestico

            fam_ig = val_cony_ig + val_h_ig + val_o_car                                                                 'total deducción por carga de familia
            ded_tot_mes_ant = gni_ant + desp_ant + fam_ig                                                               'deducción total mes anterior
            ded_tot_mes_ant = ded_tot_mes_ant + val_serv_dom                                                            'deducción total mes anterior            
            bas_imp_ant = SCO_AC_HR_PERIOD_READ_1.SAR_IG_DEC142_AUX                                                     'base impuesto mes anterior
        EndIf
    NEXT

'--------------------------------------------------------------------------------------
'Para comprobar que el empleado haya estado en rango 1
'exceptuado de tributar el impuesto, verifico el valor del 
'concepto 5930, concepto auxiliar utilizado con la finalidad
'de llevar a cero la base de impuesto 5002.
'Si el dato es cero no se realiza el recalculo, ya que el 
'empleado no se encontraba dentro del rango 1
'--------------------------------------------------------------------------------------
IF bas_imp_ant = 0 THEN
    Return(0)
ENDIF


'--------------------------------------------------------------------------------------
'A la base de impuesto del último mes, cpto 5930 se le adiciona
'las deducciones con los valores de la tabla anterior al decreto
'394/2016.
'--------------------------------------------------------------------------------------
bas_s_ded_mes_ant = bas_imp_ant + ded_tot_mes_ant

'--------------------------------------------------------------------------------------
'Tomo el valor de las deducciones con los nuevos valores según
'la tabla del decrero 394 / 2016 dependiendo de la fecha de 
'pago IG, esta puede ser el mes de Febrero o Marzo según el caso
'que se liquide con fecha de pago diferida o no.
'--------------------------------------------------------------------------------------
'Importe de las deducciones acumuladas correspondientes  
gni_nvo = SAR_GAN_NO_IMP / SAR_MES_PAGO_IG * nummes
desp_nvo = SAR_DED_ESPECIAL / SAR_MES_PAGO_IG * nummes


'Se verifica si la carga de familia fue alta el mes anterior o desde el principio del año fiscal.
ini_anio = SAR_FEC_INI_IG
fam = Todouble(val_cony_ig + val_h_ig + val_o_car)

IF fam > 0 THEN
    
    IF SAR_INCAPACIDADES.COUNT() = 0 THEN
        SAR_INCAPACIDADES.LOAD_BLK()
        SAR_INCAPACIDADES.BEGIN()
    ENDIF
    
    SAR_FAMIL_IMPUESTO.Begin()
    primerreg = 0
    ultimoreg = SAR_FAMIL_IMPUESTO.COUNT() -1
    FOR I = primerreg TO ultimoreg 
    SAR_FAMIL_IMPUESTO.MOVETO(I)
        
    fecha_alta_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_ALTA_IMP
    fecha_ini           = Max(fecha_alta_impuesto,SAR_FEC_INI_IG)
    mini                = DXMONTH(fecha_ini)
    parent              = SAR_FAMIL_IMPUESTO.STD_ID_ACT_DEP_TYPE
    tipo_parent         = SAR_FAMIL_IMPUESTO.STD_ID_DEP_TYPE

        'Control de Conyuge
        '------------------------------------------------------
        IF val_cony_ig > 0 and parent = "1" then
            IF mini = 1 then
                val_cony_ig_nvo = SAR_VAL_CONY_IMP * nummes
            ELSEIF mini = 2 THEN
                val_cony_ig_nvo = SAR_VAL_CONY_IMP * (nummes - 1)
            ENDIF            
        ENDIF
        
        fec_nac = SAR_FAMIL_IMPUESTO.STD_DT_BIRTH 
        edad = Years(fec_nac,DxDate(01,mini,DxYear(SCO_DT_ALLOCATION)))
        SAR_INCAPACIDADES.BEGIN()
        Reg_inc=SAR_INCAPACIDADES.FindRegister("SCO_ID_HR",SAR_FAMIL_IMPUESTO.STD_ID_FAMILY_PERSON,EQUAL,"SCO_PERMANENT","1",EQUAL,"SCO_ID_DISABILITY","05",EQUAL,-1)
        If Reg_inc <> -1 Then
            Existe_inc  = 1
        Else
            Existe_inc = 0
        EndIf        
        
        'Control de Hijos
        '------------------------------------------------------      
        IF val_h_ig > 0 and parent = "2" Then 
            If(edad <= SAR_TOPE_EDAD_FAMILIAR or Existe_inc = 1 )THEN
                IF mini = 1 then
                    val_h_ig_nvo = val_h_ig_nvo + (SAR_VAL_HIJO_IMP * nummes)
                ELSEIF mini = 2 THEN
                    val_h_ig_nvo = val_h_ig_nvo + (SAR_VAL_HIJO_IMP * (nummes - 1))
                ENDIF
            Endif        
        ENDIF
        
        'Control de Otras Cargas
        '------------------------------------------------------
        IF val_o_car > 0 and (tipo_parent = "11" OR tipo_parent = "12" OR tipo_parent = "16" OR tipo_parent = "18" or tipo_parent = "2" Or tipo_parent = "5" Or tipo_parent = "13" Or tipo_parent = "14" Or tipo_parent = "15" Or tipo_parent = "17")  THEN  
            '-------------------------------------------------------------------------------------------
            'Se condiciona para controlar la edad en este tipo de parentezcos.
            '11- Nieto, 12 - Bisnieto, 16 - Hermano, 18 - Yerno/Nuera.
            IF (tipo_parent= "11" OR tipo_parent= "12" OR tipo_parent= "16" OR tipo_parent= "18") THEN
                control_edad = 1
            else
                control_edad = 0
            ENDIF
            '-------------------------------------------------------------------------------------------            

            If(((Existe_inc = 1 or control_edad = 0) or (control_edad = 1 and (edad < SAR_TOPE_EDAD_FAMILIAR OR (edad = SAR_TOPE_EDAD_FAMILIAR AND (DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG) ))))))Then
                IF mini = 1 then
                    val_o_car_nvo = val_o_car_nvo + (SAR_VAL_OTRAS_IMP * nummes)
                ELSEIF mini = 2 THEN
                    val_o_car_nvo = val_o_car_nvo + (SAR_VAL_OTRAS_IMP * (nummes - 1))
                ENDIF    
            Endif                
        ENDIF
    NEXT
ENDIF
'--------------------------------------------------------------------------------------


'--------Servicio doméstico----------------------------
IF val_serv_dom > 0 Then
    serv          = val_serv_dom
    tope_serv     = SAR_TOPE_SER_DOM
    val_serv_dom_nvo = Min(serv,tope_serv)    
Endif


'------------------------------------------------------------------------------------
'Aplico los valores de deducciones de la tabla dto.394/2016 a la
'base recalculada del mes anterior, con el fin de obtener el nuevo
'valor de la base impuesto del mes anterior ya actualizada.
'------------------------------------------------------------------------------------
deduc_tot_act = gni_nvo + desp_nvo + val_cony_ig_nvo + val_h_ig_nvo + val_o_car_nvo + val_serv_dom_nvo

'------------------------------------------------------------------------------------
'A la base de impuesto del ultimo mes recalculada, le aplico  
'las deducciones con los valores de la tabla al decreto 394/2016.
'------------------------------------------------------------------------------------
nva_base_imp = bas_s_ded_mes_ant - deduc_tot_act

'------------------------------------------------------------------------------------
'Con el valor de la base de impuesto recalculada al mes anterior con
'los nuevos valores de las deducciones dto.394/2016, se recalcula
'el impuesto.
'------------------------------------------------------------------------------------
base = nva_base_imp
cant_fija = SAR_IMPUESTO.SAR_RETORNA_CUOTA_FIJA(base,fec_ig_ant,ID_CURRENCY)
porc = SAR_IMPUESTO.SAR_RETORNA_PORCENTAJE(base,fec_ig_ant,ID_CURRENCY)        
aux = SAR_IMPUESTO.SAR_RETORNA_VALOR(base,fec_ig_ant,ID_CURRENCY)
imp_nvo = Round(cant_fija + porc * (base - aux )/100,0)



Return(imp_nvo)
