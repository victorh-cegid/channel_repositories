'Decreto 14 2020: Se replica SAR_IMPORTE_SUELDO con el precio del incremento solidario 
If SAR_TP_IMPUT = "77" or SAR_TP_IMPUT = "88" or SAR_TP_IMPUT = "99" or SAR_TP_IMPUT = "2" Then Return(0)

If SAR_TIPO_SALARIO = "001" Then
    valor = (SAR_U_CONC_FIJOS * SAR_P_DEC_14) / SAR_DIAS_NORM_SUELD
Else
    valor = SAR_U_CONC_FIJOS * SAR_P_DEC_14
EndIf

Return Round(valor,SAR_NUM_DEC)
