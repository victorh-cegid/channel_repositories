'Doble indemnización decreto 34/19 se expondrá en este concepto
total_ini = SAR_INDEM_DEC34

total_ini = Percentage (50, total_ini)                  ' Decreto 886/2021
total_ini = Round (total_ini, SAR_NUM_DEC)

If SAR_IND_DOB_INDE = 0 Or total_ini = 0 Then Return(0)

total_topado = total_ini
If SAR_TOPE_INDEM_DEC39 > 0 Then total_topado = Min(total_topado,SAR_TOPE_INDEM_DEC39)
saldo = total_topado

SAR_TOTAL_VALUES.DESTROYBLOCK()
SAR_TOTAL_VALUES.SAR_ID_NODO = "SAR_HRPERIOD_CALC"
SAR_TOTAL_VALUES.SAR_ID_TOTAL = "SAR_INDEM_DEC34"
SAR_TOTAL_VALUES.SAR_FEC_VIGENCIA = SCO_DT_ALLOCATION
SAR_TOTAL_VALUES.Load_Blk()

For i=0 To SAR_TOTAL_VALUES.Count()-1
    id_concepto = SAR_TOTAL_VALUES[i].ID_ITEM_USED
    val_concepto_ini = GetValue("SCO_HRPERIOD_CALC",id_concepto,-1)
    val_concepto_red = Percentage (50, val_concepto_ini)                  ' Decreto 886/2021
    val_concepto_red = Round (val_concepto_red, SAR_NUM_DEC)    
    If val_concepto_ini > 0 And saldo <> 0 Then
        incremento = Round((val_concepto_red/total_ini)* total_topado,SAR_NUM_DEC)
        saldo = saldo - incremento
        If Abs(saldo) <= SAR_TOLERANCIA_DEC Then 
            incremento = incremento + Round(saldo,SAR_NUM_DEC)
            saldo = 0
        EndIf
        SetValuePriority(1,"SCO_HRPERIOD_CALC",id_concepto,-1,val_concepto_ini+incremento)
    EndIf
    If saldo = 0 Then Return(0)
Next

Return(0)
