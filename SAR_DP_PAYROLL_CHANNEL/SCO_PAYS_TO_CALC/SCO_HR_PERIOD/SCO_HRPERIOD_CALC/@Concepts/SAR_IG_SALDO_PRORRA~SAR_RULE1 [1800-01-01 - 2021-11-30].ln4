IF ((SAR_MES_PAGO_IG = 12 and SCO_DT_ALLOCATION = SCO_DT_PAYMENT) OR (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" )) THEN  RETURN(0)

'Se elimina del calculo la paga extra de sac mensual de junio.
If SAR_TP_IMPUT = "2" AND SAR_IND_AGUINALDO = 1 AND DxMonth(SCO_DT_PAYMENT) = 6 Then Return(0)

valor = 0
dif = 0
aux = SAR_TOT_PROR_SIN_AP + SAR_TOT_PROR_CON_AP

IF SCO_DT_ALLOCATION <> SCO_DT_PAYMENT THEN
    SAR_PAGA_ACTUAL_IMPUT.BEGIN()
    dif = SAR_TOT_PROR_SIN_AP + SAR_TOT_PROR_CON_AP - SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_SIN_AP - SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_CON_AP
    IF dif > 0 THEN
        aux = SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_SIN_AP + SAR_PAGA_ACTUAL_IMPUT.SAR_TOT_PROR_CON_AP
    ENDIF
    SAR_ACM_ULT_MES.BEGIN()
    valor = aux - SAR_IG_CUOT_PRORRA + SAR_ACM_ULT_MES.SAR_IG_SALDO_PRORRA
    IF valor < 0 THEN
        valor = 0
    ENDIF 
ELSE
    if SAR_TP_IMPUT = "4" or SAR_TP_IMPUT = "3" then
        SAR_ACM_ULT_PAGO_IMPUT.begin()
        if SAR_IG_CUOT_PRORRA = 0 Then Return(0)
        
        val_ant = SAR_ACM_ULT_PAGO_IMPUT.SAR_IG_SALDO_PRORRA + SAR_ACM_ULT_PAGO_IMPUT.SAR_IG_CUOT_AD
        if val_ant = 0 and SAR_TP_IMPUT = "4" Then
            valor1 = aux - SAR_IG_CUOT_PRORRA + SAR_ACM_ULT_MES.SAR_IG_SALDO_PRORRA + SAR_INCRE_PRORRATEOS.SAR_IG_CUOT_AD
        else 
            valor1 = aux - SAR_IG_CUOT_PRORRA + SAR_ACM_ULT_PAGO_IMPUT.SAR_IG_SALDO_PRORRA + SAR_ACM_ULT_PAGO_IMPUT.SAR_IG_CUOT_AD
        endif
        return(valor1)
    endif
    
    If SAR_TP_IMPUT <> "2" THEN
        SAR_ACM_ULT_MES.BEGIN()
        SAR_INCRE_PRORRATEOS.BEGIN()
        valor = aux - SAR_IG_CUOT_PRORRA + SAR_ACM_ULT_MES.SAR_IG_SALDO_PRORRA + SAR_INCRE_PRORRATEOS.SAR_IG_CUOT_AD
    ENDIF
ENDIF

RETURN(valor)
