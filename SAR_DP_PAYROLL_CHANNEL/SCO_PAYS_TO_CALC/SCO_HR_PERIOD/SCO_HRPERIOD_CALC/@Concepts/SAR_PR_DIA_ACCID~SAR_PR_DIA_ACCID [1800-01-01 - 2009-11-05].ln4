'Ley 24557 articulo 12

'1) Se traen el acumulado del ultimo a?o de todas las bases imponibles
'2) Se trae la cantidad de dias corridos
'3) Se divide 1 / 2
'4) A 3) se lo multiplica por 30,4 (asi se obtiene el valor mensual)

IF SAR_TP_IMPUT = "2" OR SAR_TP_IMPUT = "99" THEN 
    Return(0)
ENDIF
IF SAR_IND_ACCIDENTE = 0 THEN 
    Return(0)
ENDIF

base = 0
dia = 0
SAR_DIAS_PR_ACC = 0
inicio_paga = SAR_HR_PERIOD.SCO_DT_ALLOC_START

IF SAR_ES_ALTA = 1 THEN
     base = SAR_P_SUELDO + SAR_P_COMPL_DEVENG
     dia = SAR_DIAS_NORM_SUELD - SAR_DIAS_DTO_AGUIN
ELSE
    SAR_ACM_REM_P_ACC.BEGIN()
    base = SAR_ACM_REM_P_ACC.SAR_TOT_DEV_ACC..SysTotalslices(M4_TOTAL_SUM)

    DIA = DXDAY(inicio_paga)
    IF DIA < 10 THEN
        DIA = "0" + TOSTRING(DIA,0)
    ELSE
        DIA = TOSTRING(DIA,0)
    ENDIF
    MES = DXMONTH(inicio_paga)
    IF MES < 10 THEN
        MES = "0" + TOSTRING(MES,0)
    ELSE
        MES = TOSTRING(MES,0)
    ENDIF
    ANIO = TOSTRING(DXYEAR(inicio_paga) - 1,0)
    FECHA = ANIO + "/" + MES + "/" + DIA
    fec_ini = TODATE(FECHA)
    dia = COMMONTIME(fec_ini,inicio_paga-1,SAR_FECHA_ALTA,inicio_paga-1) - SAR_ACM_REM_P_ACC.SAR_DIAS_DTO_AGUIN 
ENDIF
IF dia = 0 THEN
    base = 0
ELSE
   base = (base/dia) * 30.4
ENDIF

SAR_DIAS_PR_ACC = dia

IF SAR_TIPO_SALARIO = "001" THEN 'Es mensual
   dias_mes = 30
ELSE
   dias_mes = DAYSOFMONTH(SCO_DT_ALLOCATION)
ENDIF

valor = base/dias_mes

Return(valor)
