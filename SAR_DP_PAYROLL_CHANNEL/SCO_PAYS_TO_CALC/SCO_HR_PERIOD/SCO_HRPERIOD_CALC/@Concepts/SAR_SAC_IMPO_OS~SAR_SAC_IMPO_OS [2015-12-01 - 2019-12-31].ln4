/*Se calcula la base imponible para obra social del SAC
     Para ello se concidrara que se puede trabajar con:
       1 - Paga extra de aguinaldo.
       2 - Una o mas pagas donde se liquiden ajustes del aguinaldo.
*/

IF SAR_ES_BAJA = 1 THEN
    'Valores en baja
    Tope_Maximo = (SAR_TOPE_COTIZ*(SAR_U_EGRESO_PAGA_1+SAR_U_EGRESO_PAGA_2)*180)/360
    Sac         = SAR_EGRESO_PAGA_1 + SAR_EGRESO_PAGA_2
    Tope_Minimo = (((SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO) * (SAR_U_EGRESO_PAGA_1+SAR_U_EGRESO_PAGA_2)*180)/360) 
Else    
    'Valores en alta
    Tope_Maximo  = (SAR_TOPE_COTIZ * (SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2 + SAR_U_PAGA_AJ_EX_1 + SAR_U_PAGA_AJ_EX_2)*180)/360
    Sac          = SAR_PAGA_EXTRA_1 + SAR_PAGA_EXTRA_2 + SAR_PAGA_EXTRA_AJ_1 + SAR_PAGA_EXTRA_AJ_2
    Tope_Minimo  = (((SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO) * (SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2 + SAR_U_PAGA_AJ_EX_1 + SAR_U_PAGA_AJ_EX_2)*180)/360) 
ENDIF

/*Se calcula la base de acuerdo a los topes maximo y minimo*/
Base_Total = 0
Base       = 0

SAR_SAC_AJUSTE_CONTRIB.Begin()
If(SAR_SAC_AJUSTE_CONTRIB.Count() > 0)Then
   Base_Total       = SAR_SAC_AJUSTE_CONTRIB.SAR_SAC_IMPO_OS 'Contiene la suma de las bases anteriormente aplicadas.
   Sac_Total_Previo = SAR_SAC_AJUSTE_CONTRIB.SAR_SAC_ABONADO 'Contiene la suma de los SACs anteriormente liquidados.
EndIf   

Sac_Del_Mes = Sac_Total_Previo + Sac 'Contiene el total actual del SAC con paga actual incluida.

If(Sac <> 0)Then
    If(Sac_Del_Mes > Tope_Maximo)Then         'Si Pasamos el tope maximo....  
           Sac_Del_Mes = Tope_Maximo              '   Por lo que se toma como valor el del mismo tope maximo.
           Base        = Sac_Del_Mes - Base_Total '   La base sera la diferencia entre el tope maximo y la base total anteriormente aplicada.                        
    ElseIf(Sac_Del_Mes < Tope_Minimo)Then     'Si No llegamos al tope minimo.....
        If(Base_Total = Tope_Minimo)Then       '   Si Existe una base con valor del minimo.....
            Base        = 0                      '     La base sera 0. No se realiza descuento de O.S.
        Else                                   '   Si No.....
            Base = Tope_Minimo                   '     La base sera el valor del minimo.             
        EndIf                                  '
    Else                                      'Si No.... 
        Base = Sac_Del_Mes - Base_Total         '   La base sera la diferencia entre el SAC del mes y el total de la base.  
    EndIf
EndIf

Base = Round(Base, 2)

RETURN(Base)
