'Cargo el nodo de Familiares para Impuesto

SAR_FAMIL_IMPUESTO.DESTROYBLOCK()
IF SAR_ES_BAJA = 1 and (DXYEAR(SCO_DT_ALLOCATION) <> DXYEAR(SAR_FEC_IMPUT_IG)) THEN
    YEAR_ALLOC = TOSTRING(DXYEAR(SCO_DT_ALLOCATION),0)
    SAR_FAMIL_IMPUESTO.SAR_FEC_INI_IG = DXDATE("01", "01", YEAR_ALLOC)
    SAR_FAMIL_IMPUESTO.SAR_FEC_FIN_IG = DXDATE("31", "12", YEAR_ALLOC)
ELSE
    SAR_FAMIL_IMPUESTO.SAR_FEC_INI_IG = DxDate("01","01",DxYear(SAR_FEC_IMPUT_IG))
    SAR_FAMIL_IMPUESTO.SAR_FEC_FIN_IG = DxDate("31","12",DxYear(SAR_FEC_IMPUT_IG)) 
ENDIF
    SAR_FAMIL_IMPUESTO.LOAD_BLK()
    IF SAR_FAMIL_IMPUESTO.COUNT() = 0 THEN
       Return(0)
    ENDIF
'ENDIF

importe = 0
mini = 0
precio = 0

primerreg = 0
ultimoreg = SAR_FAMIL_IMPUESTO.COUNT() -1

'Aca voy a cargar la TI de incapacidades
IF SAR_INCAPACIDADES.COUNT() = 0 THEN
    SAR_INCAPACIDADES.LOAD_BLK()
    SAR_INCAPACIDADES.BEGIN()
ENDIF


/**************************** BUSCAMOS LOS FAMILIARES ACTIVOS PARA PROCESAR *****************************************/
FOR I = primerreg TO ultimoreg 
    SAR_FAMIL_IMPUESTO.MOVETO(I)
    parent          = SAR_FAMIL_IMPUESTO.STD_ID_ACT_DEP_TYPE
    fec_nac         = SAR_FAMIL_IMPUESTO.STD_DT_BIRTH       
    Existe_hijo_inc = 0
    
    If(parent = "2" Or parent = "7" Or parent = "8" ) Then
'        Se busca (findregister) si existe incapacidad para el hijo.
        SAR_INCAPACIDADES.BEGIN()
        Reg_inc = SAR_INCAPACIDADES.FindRegister("SCO_ID_HR",SAR_FAMIL_IMPUESTO.STD_ID_FAMILY_PERSON,EQUAL,"SCO_ID_DISABILITY","05",EQUAL)
        If Reg_inc <> -1 Then
            SAR_INCAPACIDADES.MOVETO(Reg_inc)
            If (SAR_FEC_IMPUT_IG >= SAR_INCAPACIDADES.SCO_DT_START) and (SAR_FEC_IMPUT_IG <= SAR_INCAPACIDADES.SCO_DT_END) Then
                 Existe_hijo_inc = 1
            Else
                 Existe_hijo_inc = 0
            EndIf
        EndIf
        
        If Reg_inc <> -1 Then
            inc_permanente = SAR_INCAPACIDADES.SCO_PERMANENT
            fec_fin_incap = SAR_INCAPACIDADES.SCO_DT_END
            
            If inc_permanente = "1" Then
                inc = "N"
            Else
                inc = "S"
            EndIf
        Else
            inc = "N"
        EndIf
        
        fecha_alta_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_ALTA_IMP
        fecha_baja_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_BAJA_IMP
        If ISNULL(fecha_baja_impuesto)  = M4_TRUE  and fecha_baja_impuesto > SAR_FEC_IMPUT_IG Then
            fecha_tope = SAR_FEC_IMPUT_IG
        Else
        	fecha_tope = Min(fecha_baja_impuesto,SAR_FEC_IMPUT_IG)
        EndIf  
        edad = Years(fec_nac,SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC)
        fecha_alta_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_ALTA_IMP
	   fecha_baja_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_BAJA_IMP
        fecha_ini = Max(fecha_alta_impuesto,DxDate("01","01",DxYear(SAR_FEC_IMPUT_IG)))
        IF ISNULL(fecha_baja_impuesto)  = TRUE THEN 
            fecha_tope = SAR_FEC_IMPUT_IG
	  ELSE
        	fecha_tope = Min(fecha_baja_impuesto,SAR_FEC_IMPUT_IG)
	  ENDIF
'        Si no es hijo incapacitado, verIfico los a?os contra el tope de la edad para ganancias.(24 a?os) 
               
        IF edad = SAR_TOPE_EDAD_FAMILIAR AND DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_IMPUT_IG) THEN
            DIAT = DXDAY(fec_nac)
            IF DIAT < 10 then
                DIAT = "0" + TOSTRING(DIAT,0)
            ELSE
                DIAT = TOSTRING(DIAT,0)
            ENDIF
            MEST = DXMONTH(fec_nac)
            IF MEST < 10 then
                MEST = "0" + TOSTRING(MEST,0)
            ELSE
                MEST = TOSTRING(MEST,0)
            ENDIF
            FECHA = TOSTRING(DXYEAR(SAR_FEC_IMPUT_IG),0) + "/" + MEST + "/" + DIAT
            fecha_tope = TODATE(FECHA)
            IF fecha_tope > fecha_baja_impuesto AND  ISNULL(fecha_baja_impuesto) = FALSE THEN
                fecha_tope = fecha_baja_impuesto 
                IF fecha_baja_impuesto > SAR_FEC_IMPUT_IG THEN
                    fecha_tope = SAR_FEC_IMPUT_IG
                ENDIF
            ENDIF
        ENDIF
        MES = DXMONTH(fecha_ini)
        IF MES < 10 then
            MES = "0" + TOSTRING(MES,0)
        ELSE
            MES = TOSTRING(MES,0)
        EndIf
        
        FECHA     = TOSTRING(DXYEAR(fecha_ini),0) + "/" + MES + "/" + "25"
        
        If SAR_IG_DICIEMBRE = 1 and SAR_ES_BAJA = 1 Then
            FEC = TOSTRING(DXYEAR(SAR_FEC_IMPUT_IG),0)
            FEC_PAG = TOSTRING(SAR_PAYS_TO_CALC.SAR_ANIO_PROCESO,0)
            If FEC <> FEC_PAG Then
                FECHA = fecha_alta_impuesto
                fecha_ini = TODATE(FECHA)
                IF ISNULL(fecha_baja_impuesto)  = M4_TRUE THEN
                    fecha_tope =  todate(FEC_PAG + "/" + "12" + "/" + "25")
                ELSE
                    MES_BAJA = DXMONTH(fecha_baja_impuesto)
                    IF MES_BAJA < 10 then
                        MES_BAJA = "0" + TOSTRING(MES_BAJA,0)
                    else
                        MES_BAJA = TOSTRING(MES_BAJA,0)
                    endif
                    fecha_tope =  todate(FEC_PAG + "/" + MES_BAJA + "/" + "25")
                ENDIF
            EndIf
        Endif

        'Verficacion que permite obtener lafecha de inicio cuando existe incapacidad en meses mayores al inicio del 
        'a?o fiscal, con familiares de 24 a?os o mas.
        If(edad >= SAR_TOPE_EDAD_FAMILIAR And Existe_hijo_inc = 1) Then 
           If(SAR_FEC_IMPUT_IG >= SAR_INCAPACIDADES.SCO_DT_START And DxYear(SAR_INCAPACIDADES.SCO_DT_START) = DxYear(SAR_FEC_IMPUT_IG))Then
              fecha_ini = SAR_INCAPACIDADES.SCO_DT_START
           EndIf
        EndIf

        mini      = DXMONTH(fecha_ini)

        WHILE mini <= DXMONTH(fecha_tope) 
            precio = 0
            'Toma su valor por valores empresa
            ind = SAR_IND_DED_IG_2010
            
                    vDia = tostring(DxDaysOfMonth(mini, DxYear(SAR_FEC_IMPUT_IG)),0)

                    If mini < 10 Then
                        mini3 = "0" + TOSTRING(mini,0)
                    Else
                        mini3 = TOSTRING(mini,0)
                    EndIf
                    
                    vAnio  = tostring(DxYear(SAR_FEC_IMPUT_IG),0)  
                    vFecha = DxDate(vDia,mini3,vAnio)
                    SAR_INCAPACIDADES.BEGIN()
                    Reg_inc = SAR_INCAPACIDADES.FindRegister("SCO_ID_HR",SAR_FAMIL_IMPUESTO.STD_ID_FAMILY_PERSON,EQUAL,"SCO_ID_DISABILITY","05",EQUAL)
                    If Reg_inc <> -1 Then
                        SAR_INCAPACIDADES.MOVETO(Reg_inc)
                        If (vFecha >= SAR_INCAPACIDADES.SCO_DT_START) and (vFecha <= SAR_INCAPACIDADES.SCO_DT_END) Then
                            Existe_hijo_inc = 1
                        Else
                            Existe_hijo_inc = 0
                        EndIf
                    Endif

                If ((Existe_hijo_inc = 1 or edad < SAR_TOPE_EDAD_FAMILIAR or(edad = SAR_TOPE_EDAD_FAMILIAR AND DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_IMPUT_IG) and DXMONTH(fec_nac) >= mini))) and (parent = "2" OR parent = "7" OR parent = "8") Then                                 
                    precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_VAL_HIJO_IMP",fecha,ind))
                EndIf

                importe = importe + precio
                mini    = mini + 1
                mini2   = mini

                IF mini < 10 then
                    mini2 = "0" + TOSTRING(mini,0)
                ELSE
                    mini2 = TOSTRING(mini,0)
                ENDIF
            
                fecha = TOSTRING(DXYEAR(fecha_ini),0) + "/" + mini2 + "/" + "25"
                fecha_ini= TODATE(fecha)
            WEND
'        ENDIF    
    
    ENDIF

NEXT

  
If isNull(importe) = M4_TRUE Then
    importe = 0
EndIf
 
'Se redondea el importe antes de su devolucion
RETURN(Round(importe,2))
