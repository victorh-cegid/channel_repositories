'De acuerdo al articulo 3? el decreto 491/04 desde el 01/10/05 no hay topes para 
'el calculo de la base imponible de las contribuciones.

aux = SAR_IMPORTE_LICENCIAS
aux = SAR_AJ_VACACIONES
base = SAR_VACACIONES + SAR_AJ_VACACIONES

'Compara mos con el minimo imponible solo si base > 0
If(base > 0)Then

    'Si hay ajuste en el pago contemplamos el ajuste en el impuesto
    dias_ajuste = 0
    If SAR_AJ_VACACIONES > 0 Then
        dias_ajuste = SAR_DIAS_VACACIONES
        If dias_ajuste + SAR_UN_VACACIONES > SAR_DIAS_NORM_COTIZ Then dias_ajuste = SAR_DIAS_NORM_COTIZ - SAR_UN_VACACIONES
    EndIf
    
    IF SCO_PAY_FREQ_ALLOC = "004" THEN
        base_min_os = (SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO) / 30 * (SAR_UN_VACACIONES + dias_ajuste)
        base = Max(base_min_os, base)
    else
        base_min_os = (SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO) / 240 * (SAR_UN_VACACIONES + dias_ajuste)
        base = Max(base_min_os, base)
    Endif    

EndIf   

RETURN(base)
