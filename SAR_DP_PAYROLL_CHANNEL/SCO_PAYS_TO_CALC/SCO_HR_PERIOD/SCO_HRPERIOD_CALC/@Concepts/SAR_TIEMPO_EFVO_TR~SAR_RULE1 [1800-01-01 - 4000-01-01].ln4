'
'Calcula la cantidad días trabajados menos las ausencias que generan interrupción
'en el período que se encuentra entre el inicio y fin de la paga 
'
INICIO = SAR_P_SUELDO..SysStartDate
FIN = SAR_P_SUELDO..SysEndDate
finTramo = FIN

dias_paga = FIN - INICIO + 1
IF dias_paga = 0 THEN
   RETURN(0)
ENDIF

dias = 0
IF SAR_TIPO_SALARIO = "001" THEN
    IF DXDAY(FIN) > 30 THEN
        DIA = "30"
        MES = DXMONTH(FIN)
        IF MES < 10 THEN
            MES = "0" + TOSTRING(MES,0)
        ELSE
            MES = TOSTRING(MES,0)
        ENDIF
        ANIO = TOSTRING(DXYEAR(FIN),0)
        STR_FECHA = ANIO + "-" + MES + "-" + DIA
        FIN = TODATE(STR_FECHA)
    ENDIF
    IF DXMONTH(FIN) = 2 THEN
        IF DXDAY(FIN) = 28 THEN
            FIN = FIN + 2
        ELSEIF DXDAY(FIN) = 29 THEN
            FIN = FIN + 1
        ENDIF
    ENDIF
    IF (dias_paga > 30) OR (dias_paga > 27 AND DXMONTH(SCO_DT_ALLOCATION) = 2)THEN
        dias_paga = 30
    ENDIF
ENDIF

dias_tramo = FIN - INICIO + 1

'Control alta día 31
If SAR_ES_ALTA = 1 And DxDay(SAR_FECHA_ALTA)=31 Then dias_tramo = 1

IF SAR_DIAS_ANT_ALTA > 0 OR SAR_DIAS_POST_BAJA > 0 THEN ' esta de baja o de alta en el mes
    IF SAR_TIPO_SALARIO = "001"  THEN
        dias = dias_tramo
        IF SAR_FECHA_ALTA > INICIO THEN
            dias = FIN - SAR_FECHA_ALTA + 1
            IF dias < 0 THEN
                dias = 0
            ENDIF
        ELSEIF SAR_FECHA_BAJA < FIN THEN
            dias = SAR_FECHA_BAJA - INICIO + 1
            IF dias < 0 THEN
                dias = 0
            ENDIF
        ENDIF
    ELSEIF SAR_TIPO_SALARIO = "002" THEN    'tipo salario diario
        IF SAR_CANT_DIAS_TRABAJADOS = 0 THEN
            dias = dias_tramo
            IF SAR_FECHA_ALTA > INICIO THEN
                dias = FIN - SAR_FECHA_ALTA + 1
                IF dias < 0 THEN
                    dias = 0
                ENDIF
            ELSEIF SAR_FECHA_BAJA < FIN THEN
                dias = SAR_FECHA_BAJA - INICIO + 1
                IF dias < 0 THEN
                    dias = 0
                ENDIF
            ENDIF
        ELSE
            IF dias_paga = 0 THEN
                dias = 0
            ELSE
                fechaini = max(INICIO,SAR_FECHA_ALTA)
                fechafin = min(FIN,SAR_FECHA_BAJA)
                dias_paga = fechafin - fechaini + 1
                dias = ROUND((dias_tramo * SAR_CANT_DIAS_TRABAJADOS) / dias_paga,2)
            ENDIF
        ENDIF
    ELSEIF SAR_TIPO_SALARIO = "003" THEN    'tipo salario horario
        IF SAR_CANT_HS_TRABAJADAS > 0 THEN
            IF dias_paga = 0 THEN
                dias = 0
            ELSE
                fechaini = max(INICIO,SAR_FECHA_ALTA)
                fechafin = min(FIN,SAR_FECHA_BAJA)
                dias_paga = fechafin - fechaini + 1
                dias = ROUND((dias_tramo * SAR_CANT_HS_TRABAJADAS) / dias_paga,2)
            ENDIF
        ELSEIf SCO_NUM_HOURS_THEO > 0 THEN
            inicio_paga = INICIO
            fin_paga = FIN
            dias = SAR_CALC_HORAS_TEORICAS(inicio_paga,fin_paga)
        ELSE
            dias = 0
        ENDIF
    ENDIF
ELSE
    IF SAR_TIPO_SALARIO = "001" THEN    'tipo salario mensual
        dias = dias_tramo
    ELSEIF SAR_TIPO_SALARIO = "002" THEN    'tipo salario diario
        IF SAR_CANT_DIAS_TRABAJADOS <> 0 THEN
            IF dias_paga = 0 THEN
                dias = 0
            ELSE
                dias = ROUND((dias_tramo * SAR_CANT_DIAS_TRABAJADOS) / dias_paga,2)
            ENDIF
        ELSE
            dias = dias_tramo
        ENDIF
    ELSEIF SAR_TIPO_SALARIO = "003" THEN    'tipo salario horario
        IF SAR_CANT_HS_TRABAJADAS > 0 THEN
            IF dias_paga = 0 THEN
                dias = 0
            ELSE
                fechaini = max(INICIO,SAR_FECHA_ALTA)
                fechafin = min(FIN,SAR_FECHA_BAJA)
                dias_paga = fechafin - fechaini + 1
                dias = ROUND((dias_tramo * SAR_CANT_HS_TRABAJADAS) / dias_paga,2)
            ENDIF
        ELSEIF SCO_NUM_HOURS_THEO > 0 THEN
            inicio_paga = INICIO
            fin_paga = FIN
            dias = SAR_CALC_HORAS_TEORICAS(inicio_paga,fin_paga)
        ELSE
            dias = 0
        ENDIF
    ENDIF
ENDIF
'
'Recorro la TI con las licencias que producen interrupcion
'
descuento_dias = 0
primerreg = 0
ultimoreg = SAR_REAL_TIME_PERIOD.COUNT() - 1
fec_ini_paga = INICIO
fec_fin_paga = FIN
FOR  I = primerreg  TO  ultimoreg 
        SAR_REAL_TIME_PERIOD.MOVETO(I)
        es_interrup = SAR_REAL_TIME_PERIOD.SAR_CK_INTERRUP
        fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
        fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END

        'Control dias febrero
        excedente = 0
        If DxMonth(finTramo) = 2 THEN
            IF fec_fin_abs = finTramo And DxDay(finTramo) = 28 THEN
                excedente = excedente + 2
            ELSEIF fec_fin_abs = finTramo And DxDay(finTramo) = 29 THEN
                excedente = excedente + 1
            Endif
        Endif
    
        '
        'Contabilizo la cantidad de días y si el tipo de salario es Horario, 
        'traspaso las unidades a horas
        '
        IF SAR_TIPO_SALARIO <> "003" THEN    
            IF es_interrup = "S" THEN
                descuento_dias = descuento_dias + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) + excedente
            ENDIF           
        ELSE 'tipo salario horario
            IF es_interrup = "S" THEN
                IF SCO_NUM_HOURS_THEO > 0 THEN
                    IF fec_ini_abs < fec_ini_paga THEN
                        fec_ini_abs = fec_ini_paga
                    ENDIF
                    IF fec_fin_abs > fec_fin_paga THEN
                        fec_fin_abs = fec_fin_paga
                    ENDIF
                    descuento_dias = descuento_dias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
                ELSE
                   IF SAR_HS_DIARIAS_PROM = 0 THEN
                      Setlog (-1,80,4,205,SCO_ID_HR)
                      SCO_ERROR =1
                   ELSE
                      descuento_dias = descuento_dias + CommonTime(fec_ini_paga , fec_fin_paga , fec_ini_abs , fec_fin_abs ) * SAR_HS_DIARIAS_PROM 
                   ENDIF
                ENDIF
            ENDIF
        ENDIF
NEXT

dias_final = dias - descuento_dias

IF SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "1" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "3" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "4" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "99" THEN
    Return(MAX(dias_final,0))
ELSE
    Return(0)
ENDIF
