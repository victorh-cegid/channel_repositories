'Esta regla es la encargada de calcular la deducción del piso IG de la ley 27617
baseImp = SAR_BASE_IMPUESTO

ded_ac_ajust_a = 0 : ded_ac_ajust_b = 0 : sac_grabado_mes = 0 : apo_grabado_mes = 0
sac_grabado_mes_oe = 0 : apo_grabado_mes_oe = 0 : sac_grabado_mes_ant = 0 : apo_grabado_mes_ant = 0
sac_grabado_mes_ant_oe = 0 : apo_grabado_mes_ant_oe = 0 : cuo_pro_grabado_mes_ant = 0 : apo_pro_grabado_mes_ant = 0 : porcApo = 0

indAjusteRetro = SAR_IND_IMPUESTO_RETRO
indAjusteRemun = SAR_IND_AJUSTE_REMUN_27617

'Si viene el valor de la deducción informado por tabla de valor con algo distinto de 0 se respeta
If SAR_DED_IG_27617 <> 0 Or SAR_DED_IG_27617_T2 <> 0 Then
    baseImp = baseImp - SAR_DED_IG_27617 - SAR_DED_IG_27617_T2
ElseIf indAjusteRetro = 0 And SAR_PAYS_TO_CALC.SAR_REVISION = 1 And ((SAR_ES_BAJA <> 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Or (SAR_ES_BAJA = 1 And SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1)) Then 
'Controlamos retroactivas que no cambie la deducción
    SAR_DED_IG_27617 = SCO_AC_HR_PERIOD_REV_1.SAR_DED_IG_27617
    SAR_DED_IG_27617_T2 = SCO_AC_HR_PERIOD_REV_1.SAR_DED_IG_27617_T2
    baseImp = baseImp - SAR_DED_IG_27617 - SAR_DED_IG_27617_T2
'Sólo en pagas normales (mensuales), 1ª quincena, paga adicional de liquidación, o porque el usuario determina 
'que estamos en la paga donde puede determinarse el importe del mes (informando el indicador a 1), se calcula.
ElseIf SAR_IND_PAGA_CALCULA_27617 = 1 Then
    'En este proceso se entrá sólo en la paga adicional para calcular las deducciones y el importe a devolver de IG enero a junio.
    'Llama al proceso de ajuste, simula el cálculo de la deducción que habria correspondido de enero a junio tanto de tramo 1 como 2
    'y se resta de la base del impuesto que se calcula en esta paga adicional, lo que provocará un ajuste del impuesto que se almacenará (desde SAR_IG_FINAL)
    'para devolverlo en cuotas en las pagas devengadas de julio a noviembre.
    If SAR_IND_PAGA_RELIQ = 2 And indAjusteRetro <> 2 Then 
        SAR_PROCESO_AJUSTE_27617(ded_ac_ajust_a,ded_ac_ajust_b)
        baseImp = baseImp - (ded_ac_ajust_a+ded_ac_ajust_b)
        SAR_DED_IG_27617 = ded_ac_ajust_a
        SAR_DED_IG_27617_T2 = ded_ac_ajust_b
    Else
        'Dentro de este ELSE se calcula la deducción que pertenece al mes de proceso
        base_mes_ant = 0

        'Porcentajes para calculo de aportes, necesario para OE
        porcJub = 0
        porcLey = 0
        If SAR_EDAD >= 18 Then 
            porcJub = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
            porcLey = SAR_PORC_LEY_19032 - (SAR_PORC_LEY_19032 * SAR_PP_AP_INSSJP/100)
        EndIf
        porcObSoc = SAR_PORC_OBR_SOCIAL -(SAR_PORC_OBR_SOCIAL * SAR_PP_AP_OB_SOC/100)
        porcAdObSoc = SAR_PORC_ADIC_O_SOC - (SAR_PORC_ADIC_O_SOC * SAR_PP_AP_OB_SOC/100)
        porcAdObSoc = porcAdObSoc * SAR_FAM_CARGO_OS
        porcSindObl = SAR_PORC_C_SIND_OBL
        porcSindVol = SAR_PORC_C_SIND_VOL
        porcApo = porcJub + porcLey + porcObSoc + porcAdObSoc + porcSindObl + porcSindVol
        
        'Obtiene la última base del impuesto calculada en algún mes anterior al que se está procesando, normalmente será la base del impuesto del mes anterior
        'pero debemos recorrer el año IG completo porque no sabemos si el mes anterior tuvo o no acumulado.
        If DxMonth(SAR_FEC_IMPUT_IG)>1 Then
            fec_ig_ant = DxDate(1,1,1800)
            mes_ini_ig = DxDate(1,1,DxYear(SAR_FEC_IMPUT_IG))
            ult_dia_mes = DaysOfMonth (DxDate(1,DxMonth(SAR_FEC_IMPUT_IG)-1,DxYear(SAR_FEC_IMPUT_IG)))
            mes_fin_ig = DxDate(ult_dia_mes,DxMonth(SAR_FEC_IMPUT_IG)-1,DxYear(SAR_FEC_IMPUT_IG))
            ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
            For acum = 0 To ult_reg - 1

                If SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG >= mes_ini_ig And SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG <= mes_fin_ig And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT<>"88" Then
                    If SAR_IND_SAC_DEI = 0 Then
                        sac_grabado_mes_ant = sac_grabado_mes_ant + SCO_AC_HR_PERIOD_READ_1[acum].SAR_DIF_SAC_RG3976 + SCO_AC_HR_PERIOD_READ_1[acum].SAR_B_SAC_MES_RG3976                    
                        apo_grabado_mes_ant = apo_grabado_mes_ant + SCO_AC_HR_PERIOD_READ_1[acum].SAR_JUB_SAC_MES + SCO_AC_HR_PERIOD_READ_1[acum].SAR_LEY_19032_SAC_MES + SCO_AC_HR_PERIOD_READ_1[acum].SAR_OBRA_SOCIAL_SAC_MES + SCO_AC_HR_PERIOD_READ_1[acum].SAR_OB_SOC_ADIC_SAC_MES + SCO_AC_HR_PERIOD_READ_1[acum].SAR_C_SIND_OBL_SAC_MES + SCO_AC_HR_PERIOD_READ_1[acum].SAR_C_SINDICAL_SAC_MES 
                        sac_grabado_mes_ant_oe = sac_grabado_mes_ant_oe + SCO_AC_HR_PERIOD_READ_1[acum].SAR_B_PLUR_SAC_MES + SCO_AC_HR_PERIOD_READ_1[acum].SAR_DIF_PROR_SAC
                        apo_grabado_mes_ant_oe = apo_grabado_mes_ant_oe + SCO_AC_HR_PERIOD_READ_1[acum].SAR_JUB_SAC_OE + SCO_AC_HR_PERIOD_READ_1[acum].SAR_C_SINDICAL_SAC_OE + SCO_AC_HR_PERIOD_READ_1[acum].SAR_LEY_19032_SAC_OE + SCO_AC_HR_PERIOD_READ_1[acum].SAR_OB_SOC_ADIC_SAC_OE + SCO_AC_HR_PERIOD_READ_1[acum].SAR_OBRA_SOCIAL_SAC_OE
                    EndIf
                    
                    cuo_pro_grabado_mes_ant = cuo_pro_grabado_mes_ant + SCO_AC_HR_PERIOD_READ_1[acum].SAR_IG_CUOT_PRORRA
                    apo_pro_grabado_mes_ant = apo_pro_grabado_mes_ant + SCO_AC_HR_PERIOD_READ_1[acum].SAR_IG_CUOT_PROR_JU + SCO_AC_HR_PERIOD_READ_1[acum].SAR_IG_CUO_PROR_LEY + SCO_AC_HR_PERIOD_READ_1[acum].SAR_IG_CUOT_PROR_OB + SCO_AC_HR_PERIOD_READ_1[acum].SAR_IG_CUO_PR_AD_OB + SCO_AC_HR_PERIOD_READ_1[acum].SAR_IG_CP_SIND_ST 

                    If SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG > fec_ig_ant And (SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION Or SCO_AC_HR_PERIOD_READ_1[acum].SAR_IND_IMPUESTO_RETRO > 0) Then
                        'Obtiene la última base de impuesto
                        'En caso de retro especial de ajuste DEI desde paga de reliquidación, no considera la paga especial que hubo en junio
                        If indAjusteRetro = 2 And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT="99" Then
                            fec_ig_ant = fec_ig_ant
                            base_mes_ant = base_mes_ant
                        Else
                            fec_ig_ant = SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG
                            base_mes_ant = SCO_AC_HR_PERIOD_READ_1[acum].SAR_BASE_IMPUESTO
                        EndIf
                    EndIf
                EndIf
            Next
        EndIf

        'Se excluye el SAC del cálculo de la base mes para DEI según el indicador
        If SAR_IND_SAC_DEI = 0 Then
            sac_grabado_mes = SAR_DIF_SAC_RG3976 + SAR_B_SAC_MES_RG3976 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_DIF_SAC_RG3976 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_B_SAC_MES_RG3976
            apo_grabado_mes = SAR_JUB_SAC_MES + SAR_LEY_19032_SAC_MES + SAR_OBRA_SOCIAL_SAC_MES + SAR_OB_SOC_ADIC_SAC_MES + SAR_C_SIND_OBL_SAC_MES + SAR_C_SINDICAL_SAC_MES + SAR_ACM_IG_ANIO_IMPUT[0].SAR_JUB_SAC_MES + SAR_ACM_IG_ANIO_IMPUT[0].SAR_LEY_19032_SAC_MES + SAR_ACM_IG_ANIO_IMPUT[0].SAR_OBRA_SOCIAL_SAC_MES + SAR_ACM_IG_ANIO_IMPUT[0].SAR_OB_SOC_ADIC_SAC_MES + SAR_ACM_IG_ANIO_IMPUT[0].SAR_C_SIND_OBL_SAC_MES + SAR_ACM_IG_ANIO_IMPUT[0].SAR_C_SINDICAL_SAC_MES
            sac_grabado_mes_oe = SAR_DIF_PROR_SAC + SAR_B_PLUR_SAC_MES + SAR_ACM_IG_ANIO_IMPUT[0].SAR_DIF_PROR_SAC + SAR_ACM_IG_ANIO_IMPUT[0].SAR_B_PLUR_SAC_MES
            apo_grabado_mes_oe = SAR_JUB_SAC_OE + SAR_C_SINDICAL_SAC_OE + SAR_LEY_19032_SAC_OE + SAR_OB_SOC_ADIC_SAC_OE + SAR_OBRA_SOCIAL_SAC_OE + SAR_ACM_IG_ANIO_IMPUT[0].SAR_JUB_SAC_OE + SAR_ACM_IG_ANIO_IMPUT[0].SAR_C_SINDICAL_SAC_OE + SAR_ACM_IG_ANIO_IMPUT[0].SAR_LEY_19032_SAC_OE + SAR_ACM_IG_ANIO_IMPUT[0].SAR_OB_SOC_ADIC_SAC_OE + SAR_ACM_IG_ANIO_IMPUT[0].SAR_OBRA_SOCIAL_SAC_OE
        EndIf

        'Se excluye el prorrateo del cálculo de la base
        cuo_pro_grabado_mes = SAR_IG_CUOT_PRORRA + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IG_CUOT_PRORRA
        apo_pro_grabado_mes = SAR_IG_CUOT_PROR_JU + SAR_IG_CUO_PROR_LEY + SAR_IG_CUOT_PROR_OB + SAR_IG_CUO_PR_AD_OB + SAR_IG_CP_SIND_ST
        apo_pro_grabado_mes = apo_pro_grabado_mes + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IG_CUOT_PROR_JU + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IG_CUO_PROR_LEY + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IG_CUOT_PROR_OB + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IG_CUO_PR_AD_OB + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IG_CP_SIND_ST

        'Al recalcular DEI dentro de todas las pagas del mes, baseImp debe ir sin las deducciones T1 o T2 calculadas previamente en el mismo mes IG
        dedTramoUnoPagAnt = SAR_ACM_MESACT_IMPIG[0].SAR_DED_IG_27617
        dedTramoDosPagAnt = SAR_ACM_MESACT_IMPIG[0].SAR_DED_IG_27617_T2
        baseImp = baseImp + dedTramoUnoPagAnt + dedTramoDosPagAnt

        'Control de bajas con deducciones anuales, no deben formar parte de la DEI
        dedAnu = 0
        If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then dedAnu = SAR_TOT_DED_AUALES
        'En paga especial reliq. septiembre, se calcula DEI pero no debe incluir la DEI las deducciones anuales
        If SAR_IND_PAGA_RELIQ = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then dedAnu = SAR_TOT_DED_AUALES

        base_mes_aplica_ded = (baseImp + dedAnu - sac_grabado_mes - sac_grabado_mes_oe - cuo_pro_grabado_mes + apo_grabado_mes + apo_grabado_mes_oe + apo_pro_grabado_mes)
        base_mes_aplica_ded = base_mes_aplica_ded - (base_mes_ant - sac_grabado_mes_ant - sac_grabado_mes_ant_oe - cuo_pro_grabado_mes_ant + apo_grabado_mes_ant + apo_grabado_mes_ant_oe + apo_pro_grabado_mes_ant)

        'Calcula la deducción que pertenece al mes de proceso
        'indAjusteRemun = 1 remuneración y promedio se miran por criterio percibido
        If indAjusteRemun = 1 Then
            remun_mes = SAR_REM_27617_DEI_PERC
            remun_prom = SAR_PROM_27617_DEI_PERC
            fec_ded = SAR_FEC_IMPUT_IG
        'indAjusteRemun = 0 remuneración y promedio se miran por criterio devengado (excepto jornalizados)
        Else
            If SAR_TIPO_SALARIO = "003" Then
                remun_mes = SAR_TOT_REMUN_27617
                remun_prom = SAR_PROM_27617_DEI_IG
                fec_ded = SAR_FEC_IMPUT_IG 'Se mantiene fecha IG por coherencia de cálculo en jornalizados, cambiar por SCO_DT_ALLOCATION si se considera que debe levantarse el dato por devengado
            Else
                remun_mes = SAR_REM_27617_DEI_DEV
                remun_prom = SAR_PROM_27617_DEI_DEV
                fec_ded = SCO_DT_ALLOCATION
                'Diferidos diciembre 2020 IG 2021 debe calcular deducción
                If indAjusteRetro = 2 And DxYear(SAR_FEC_IMPUT_IG) > DxYear(SCO_DT_ALLOCATION) Then fec_ded = SAR_FEC_IMPUT_IG
            EndIf
        EndIf
        
        retrib = Min(remun_mes,remun_prom)
        vTramo = SAR_DED_ESP_INC.SAR_RETORNA_TRAMO(retrib,fec_ded,ID_CURRENCY)
        
        SAR_AUX_REMUN_27617 = retrib
        SAR_AUX_TRAMO_27617 = vTramo
        SAR_AUX_PROMEDIO_27617 = remun_prom
        SAR_AUX_BASE_IMP_MES = base_mes_aplica_ded
        
        dedIgTramoUno = 0
        dedIgTramoDos = 0
        If base_mes_aplica_ded > 0 Then
            If vTramo = 1 Then
                dedIgTramoUno = base_mes_aplica_ded
                baseImp = baseImp - base_mes_aplica_ded
            ElseIf vTramo = 2 Then
                vValor = SAR_DED_ESP_INC.SAR_RETORNA_VALOR(retrib,fec_ded,ID_CURRENCY)
                vValor = Min(vValor,base_mes_aplica_ded)
                dedIgTramoDos = vValor
                baseImp = BaseImp - vValor
            EndIf
        EndIf

        'Ajustamos en la paga en caso de existir cálculo DEI en pagas anteriores del mes fiscal
        dedIgTramoUnoPaga = dedIgTramoUno - dedTramoUnoPagAnt
        dedIgTramoDosPaga = dedIgTramoDos - dedTramoDosPagAnt
        SAR_DED_IG_27617 = dedIgTramoUnoPaga
        SAR_DED_IG_27617_T2 = dedIgTramoDosPaga        
        
        If abs(baseImp)<=SAR_TOLERANCIA_DEC Then baseImp = 0

        'Situación especial SAC 1 en diciembre 2021: El SAC 1 quedó grabado formando parte de DEI1 generando en diciembre una base negativa al dejarlo ahora exento. Se ajusta la situación:
        If SAR_IND_AJUSTE_SAC = 1 And DxYear(SAR_FEC_IMPUT_IG)=2021 And DxMonth(SAR_FEC_IMPUT_IG)=12 And baseImp < 0 And SAR_SAC_1_EXEN > 0 Then
            minoraMaxDed = (SAR_DED_IG_27617 + SAR_DED_IG_27617_ACUM)*-1
            minoraDed = Max(baseImp,minoraMaxDed)
            SAR_DED_IG_27617 = SAR_DED_IG_27617 + minoraDed
            baseImp = baseImp - minoraDed
        EndIf
        'Fin situación especial SAC 1 2021

    EndIf
EndIf

'Se agrega el importe DEI T1 o T2 de AE informado por tabla de valor:
SAR_DED_IG_27617 = SAR_DED_IG_27617 + SAR_AE_DED_IG_27617_T1
SAR_DED_IG_27617_T2 = SAR_DED_IG_27617_T2 + SAR_AE_DED_IG_27617_T2
baseImp = baseImp - SAR_AE_DED_IG_27617_T1 - SAR_AE_DED_IG_27617_T2

Return(baseImp)
