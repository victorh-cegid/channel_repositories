If SAR_IND_NO_RET_GAN = 1 Or SAR_TP_IMPUT <> "99" Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" And SAR_FECHA_BAJA < DxDate("30","09",DxYear(SCO_DT_ALLOCATION))) Then Return(0)

impuesto_tot = SAR_IMPUESTO_TOTAL
imp_ae = SAR_IMP_ANT_EMP
imp_ban = SAR_IMP_DEB_BAN
imp_oe = SAR_IMP_OTROS_EMP

impuesto_acum = SAR_ACM_IG_ANIO_IMPUT[0].SAR_IMPUESTO + SAR_ACM_IG_ANIO_IMPUT[0].SAR_IG_FINAL
valor = impuesto_tot - imp_ae - imp_oe - impuesto_acum - imp_ban

If abs(valor) <= SAR_TOLERANCIA_DEC and valor <> 0 then
	ImpRetTot = imp_ae + imp_oe + impuesto_acum + valor
      valor = 0
      SetvaluePriority(0,"SAR_HRPERIOD_CALC","SAR_IMP_RET_TOT",-1,ImpRetTot)
EndIf

Return(valor)
