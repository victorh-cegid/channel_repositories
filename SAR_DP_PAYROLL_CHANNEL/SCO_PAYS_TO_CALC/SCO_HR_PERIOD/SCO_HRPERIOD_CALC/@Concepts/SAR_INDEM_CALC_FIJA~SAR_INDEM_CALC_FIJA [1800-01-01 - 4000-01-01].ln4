'Este concepto recibe 3 parámetros de entrada:
'
'ID_CONCEPTO:
'    Identificador del total de conceptos (SAR_TOTAL_VALUES.SAR_ID_TOTAL) cuyos importes
'    se obtienen de la tabla SCO_AC_HR_PERIOD_READ_1 y, cuando INC_MES_BAJA = 1,
'    también de la paga de proceso (SCO_HRPERIOD_CALC).
'
'PERIODO:
'    Número de meses hacia atrás que definen el periodo completo a considerar.
'    Si INC_MES_BAJA = 1, el periodo se desplaza para incluir el mes de la baja.
'
'INC_MES_BAJA:
'    Indicador (0/1) que determina si debe incluirse el mes de la baja y fusionar
'    la paga de proceso con las pagas del READ del mismo mes.
'
'El concepto devuelve un parámetro de salida:
'
'IMPORTE:
'    Mejor importe mensual del conjunto de conceptos evaluado dentro del periodo indicado.
'    Para cada mes se suman los importes de todos los conceptos del total,
'    y el resultado es el máximo de esas sumas mensuales.


'Recoge parámetros, inicializa variables
totalId = ID_CONCEPTO : mesAtrasCompleto = PERIODO : incMesBaja = INC_MES_BAJA : IMPORTE = 0

'Mes y año de la paga de proceso (mes de la baja)
mesBaja = DxMonth(SCO_DT_ALLOCATION)
anyoBaja = DxYear(SCO_DT_ALLOCATION)

'Importe del total en la paga de proceso
valorMesBaja = 0

'Carga y aplana los conceptos que forman parte del total
SAR_TOTAL_VALUES.DESTROYBLOCK()
SAR_TOTAL_VALUES.SAR_ID_NODO = "SAR_HRPERIOD_CALC"
SAR_TOTAL_VALUES.SAR_ID_NODO_CLI = SAR_AUX_NODO_CALC
SAR_TOTAL_VALUES.SAR_ID_TOTAL = totalId
SAR_TOTAL_VALUES.SAR_FEC_VIGENCIA = SCO_DT_ALLOCATION
SAR_TOTAL_VALUES.Load_Blk()
countTotal = SAR_TOTAL_VALUES.Count() - 1

'Método para poder usar herencia en el objeto y anular de la lista items que se mandan restando al total
SAR_TOTAL_VALUES.SAR_APLANAR()

If incMesBaja = 1 Then
    For i = 0 To countTotal
        id_concepto = SAR_TOTAL_VALUES[i].ID_ITEM_USED
        descartado = SAR_TOTAL_VALUES[i].SAR_DESCARTADO
        'Si descartado = 1 significa que por herencia se ha restado del total STD y no debe considerarse
        If descartado = 0 Then valorMesBaja = valorMesBaja + GetValue("SCO_HRPERIOD_CALC", id_concepto, -1)
    Next
EndIf

'Fechas de inicio y fin del periodo
If incMesBaja = 0 Then
    fecIni = AddMonths(SCO_DT_ALLOCATION, -mesAtrasCompleto)
    fecIni = DxDate(1, DxMonth(fecIni), DxYear(fecIni))

    fecFin = AddMonths(SCO_DT_ALLOCATION, -1)
    fecFin = DxDate(DaysOfMonth(fecFin), DxMonth(fecFin), DxYear(fecFin))
Else
    fecIni = AddMonths(SCO_DT_ALLOCATION, -(mesAtrasCompleto - 1))
    fecIni = DxDate(1, DxMonth(fecIni), DxYear(fecIni))

    fecFin = DxDate(DaysOfMonth(SCO_DT_ALLOCATION), DxMonth(SCO_DT_ALLOCATION), DxYear(SCO_DT_ALLOCATION))
EndIf

'Variables para agrupar por mes
mesActual = -1 : anyoActual = -1 : sumaMes = 0 : mejorSumaMes = 0 : mesBajaProcesado = 0

ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()

For acum = 0 To ult_reg - 1

    fecPay = SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT
    fecImp = SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION
    payType = SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT

    'Filtrado por periodo
    If fecPay <= SCO_DT_PAYMENT And fecPay >= fecIni And fecImp <= fecFin And fecImp >= fecIni And fecImp <> SCO_DT_ALLOCATION And payType <> "99" And payType <> "88" Then

        'Suma de todos los conceptos del total para este registro
        valorRegistro = 0
        For j = 0 To countTotal
            id_concepto = SAR_TOTAL_VALUES[j].ID_ITEM_USED
            descartado = SAR_TOTAL_VALUES[j].SAR_DESCARTADO
            'Si descartado = 1 significa que por herencia se ha restado del total STD y no debe considerarse
            If descartado = 0 Then valorRegistro = valorRegistro + GetValue("SCO_AC_HR_PERIOD_READ_1", id_concepto, acum)
        Next

        'Detectar cambio de mes
        If DxMonth(fecImp) <> mesActual Or DxYear(fecImp) <> anyoActual Then
            mejorSumaMes = Max(mejorSumaMes, sumaMes)
            mesActual = DxMonth(fecImp)
            anyoActual = DxYear(fecImp)
            sumaMes = 0
        EndIf

        'Acumular suma del mes
        sumaMes = sumaMes + valorRegistro

        'Integrar paga de proceso si corresponde
        If mesActual = mesBaja And anyoActual = anyoBaja Then
            mesBajaProcesado = 1

            If incMesBaja = 1 And valorMesBaja <> 0 Then
                sumaMes = sumaMes + valorMesBaja
                valorMesBaja = 0
            EndIf
        EndIf

    EndIf
Next

'Mes de la baja no apareció en la READ
If incMesBaja = 1 And mesBajaProcesado = 0 Then
    mejorSumaMes = Max(mejorSumaMes, sumaMes)
    sumaMes = valorMesBaja
    mejorSumaMes = Max(mejorSumaMes, sumaMes)
Else
    mejorSumaMes = Max(mejorSumaMes, sumaMes)
EndIf

IMPORTE = Round(mejorSumaMes, SAR_NUM_DEC)
