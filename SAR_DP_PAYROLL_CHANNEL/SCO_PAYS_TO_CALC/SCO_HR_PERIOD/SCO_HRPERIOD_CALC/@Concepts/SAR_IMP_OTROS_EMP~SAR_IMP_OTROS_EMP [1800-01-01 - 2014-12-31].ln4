'Toma su valor a traves del metodo SAR_RET_VALOR_COMPL

val_otros_emp = SAR_IMP_OTROS_EMP     
sar_acum_imp_oe = 0

IF SAR_TP_IMPUT = "99" THEN
    ban = 0
    'val_otros_empl = 0
ENDIF

'Recorro el acumulado del empleado y sumarizo los valores para armar las TI.
SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()

I = ULTIMO_REG - 1 

WHILE I >= 0 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
       
    ' Armo los datos para SAR_ACM_IMPUESTO
    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
        sar_acum_imp_oe      = sar_acum_imp_oe + SCO_AC_HR_PERIOD_READ_1.SAR_IMP_OTROS_EMP
    ENDIF
    I = I - 1
Wend


val_otros_emp = val_otros_emp - sar_acum_imp_oe

valor = val_otros_emp   

RETURN(valor)
