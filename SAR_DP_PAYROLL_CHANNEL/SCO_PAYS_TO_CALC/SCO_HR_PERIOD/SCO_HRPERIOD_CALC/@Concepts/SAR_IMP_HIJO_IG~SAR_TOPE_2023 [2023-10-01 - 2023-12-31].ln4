If DxYear(SAR_FEC_IMPUT_IG) > 2023 Then Return (SAR_IMP_HIJO_IG)

'Controla que no se supere el importe anual
valor = SAR_IMP_HIJO_IG

importeSep = SAR_ACM_SEP23_DED_REV[0].SAR_IG_HIJOS_REM
importeCompleto = SAR_IMP23_HIJ_COMPL

If valor + importeSep > importeCompleto Then valor = importeCompleto - importeSep

'Control de hijo incapacitado
valorInc = SAR_IG_HIJOS_INC
importeSepInc = SAR_ACM_SEP23_DED_REV[0].SAR_IG_HIJOS_INC
importeCompletoInc = SAR_IMP23_HINC_COMPL
If valorInc + importeSepInc > importeCompletoInc Then 
    valorInc = importeCompletoInc - importeSepInc
    SAR_IG_HIJOS_INC = valorInc
EndIf

Return Round(valor,SAR_NUM_DEC)
