importe = SAR_ACM_IG_ANIO_IMPUT[0].SAR_DED_IG_27617_T2

'Incorpora el importa de la paga adicional
ded_paga_adic = 0

If DxYear(SAR_FEC_IMPUT_IG) = 2021 And SAR_IND_IMPUESTO_RETRO <> 2 Then
    ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
    paga_esp = dxDate (30,06,2021)
    paga_esp_dif = dxDate (07,07,2021)    
    For acum = 0 To ult_reg - 1
        If (SCO_AC_HR_PERIOD_READ_1[acum].SAR_FECHA_PAGO_IG = paga_esp Or SCO_AC_HR_PERIOD_READ_1[acum].SAR_FECHA_PAGO_IG = paga_esp_dif) And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT="99" And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION Then
            ded_paga_adic = SCO_AC_HR_PERIOD_READ_1[acum].SAR_DED_IG_27617_T2
        EndIf
        
        'Si se ha realizado ajuste retro desde la paga de reliquidacion, no debe levantarse la informacion de la paga especial de junio, ya que el ajuste de esta paga se ha realizado imputado a cada mes
        If SAR_IND_PAGA_RELIQ = 1 And SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_PAGO_IG >= DxDate(1,1,2021) And SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_PAGO_IG <= DxDate(31,12,2021) And SCO_AC_HR_PERIOD_READ_1[acum].SAR_IND_IMPUESTO_RETRO = 2 Then
            tiene_ajuste_retro = 1
        EndIf
        
    Next
EndIf
'Fin incorporacion de la paga adicional
If tiene_ajuste_retro = 1 Then ded_paga_adic = 0
importe = importe + ded_paga_adic

'Solo 2023 correccion de ajustes DEI imputados con origen octubre o posterior a pagas anteriores a octubre
If SCO_PAYS_TO_CALC.SCO_PAY_TYPE_PAYM = "99" And DxYear(SAR_FEC_PAGO_IG) = 2023 And DxYear(SCO_DT_ALLOCATION) = 2023 And DxMonth(SAR_FEC_PAGO_IG) = 12 And DxMonth(SCO_DT_ALLOCATION) > 9 Then
    ajusteSobraDei = 0
    mes_ini_ig = DxDate(1,1,DxYear(SAR_FEC_IMPUT_IG))
    ult_dia_mes = DaysOfMonth (DxDate(1,DxMonth(SAR_FEC_IMPUT_IG)-1,DxYear(SAR_FEC_IMPUT_IG)))
    mes_fin_ig = DxDate(ult_dia_mes,DxMonth(SAR_FEC_IMPUT_IG)-1,DxYear(SAR_FEC_IMPUT_IG))
    ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
    
    For acum = 0 To ult_reg - 1
        If SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG >= mes_ini_ig And SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG <= mes_fin_ig And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT<>"88" And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT<>"99" And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION <> SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION < DxDate(1,10,2023) And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT >= DxDate(1,10,2023) And SCO_AC_HR_PERIOD_READ_1[acum].SAR_IND_D473_IMP_PER_ANT = 0 Then
            ajusteSobraDei = ajusteSobraDei + SCO_AC_HR_PERIOD_READ_1[acum].SAR_DED_IG_27617_T2
        EndIf
    Next

    importe = importe - ajusteSobraDei

EndIf
'Fin solo 2023

Return(importe)
