'Req 0165503 y 0161430 Calcula el ajuste negativo. 
ajuste = 0


'En el ultimo tramo se debe realizar el ajuste

If SAR_SLICE_UNIT..SysEndDate = SAR_FECHA_BASE Then 

    'totaliza el valor de todos los tramos
    dif = SAR_TOTAL_DEVENGOS..SysTotalslices(M4_TOTAL_SUM) - SAR_TOT_RETEN..SysTotalslices(M4_TOTAL_SUM) 
        
    
    IF dif < 0 then
       ajuste = dif * -1
    EndIf
    
    
    SCO_NET = SCO_NET + ajuste
    SCO_NET_WITHOUT_ADVANCES = SCO_NET_WITHOUT_ADVANCES + ajuste

EndIf

Return(Ajuste)
