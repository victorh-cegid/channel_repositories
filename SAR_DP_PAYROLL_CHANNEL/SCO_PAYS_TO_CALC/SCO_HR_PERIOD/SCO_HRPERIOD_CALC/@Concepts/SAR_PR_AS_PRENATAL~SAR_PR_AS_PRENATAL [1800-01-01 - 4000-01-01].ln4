'
'De acuerdo con la resolución 136/98 de la Administración Federal de Ingresos Públicos
'y con el Decreto 805/2001 Yse modifica la fórmula para tener en cuenta todas las zonas 
'posibles de Asignaciones Familiares para el cálculo del precio respectivo según los rangos
'en los que se encuentre el empleado. 
'

IF SAR_TP_IMPUT <> "1" AND SAR_TP_IMPUT <> "4" THEN 'Tipo mensual y quincenal
    Return(0)
ELSE
    rem_men = 0
    rem_men = SAR_TOT_HAB_CON_AP-SAR_DIAS_DTO_AGUIN-SAR_HORAS_50-SAR_HORAS_100-SAR_HORAS_150
    IF rem_men < SAR_TOPE_S_FAMIL and SAR_REMUN_P_SAL_FAM < SAR_TOPE_S_FAMIL THEN
        valor=0
    ELSE
        valor = SAR_ASIGNACIONES.SAR_RETORNA_VALOR("4", SAR_ID_ZONA_SUB, SAR_REMUN_P_SAL_FAM, ID_CURRENCY)
        IF ISNULL(valor) = TRUE THEN
            valor = 0
        ENDIF
    ENDIF
Return(valor)
ENDIF
