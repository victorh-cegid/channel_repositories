'Inicializo variables
indZonaPat          = SAR_IND_ZONA_PAT              'indicador zona patagónica
indDeduc            = SAR_IND_DED_IG_2010           'indicador deducción 2010
ano_pago_act        = DxYear(SAR_FEC_IMPUT_IG)      'Año fecha cálculo actual
mes_pago_act        = DxMonth(SAR_FEC_IMPUT_IG)     'Mes fecha cálculo actual
dia_pago_act        = DaysOfMonth(SAR_FEC_IMPUT_IG) 'Día fecha cálculo actual

'Control, baja debe calcularse respecto a la fecha de pago IG
If SAR_ES_BAJA = 1 Then
    ano_pago_act        = DxYear(SAR_FEC_PAGO_IG)      'Año fecha cálculo actual
    mes_pago_act        = DxMonth(SAR_FEC_PAGO_IG)     'Mes fecha cálculo actual
    dia_pago_act        = DaysOfMonth(SAR_FEC_PAGO_IG) 'Día fecha cálculo actual
EndIf

'Calculamos el precio mensual de los conceptos de Deducción partiendo del valor acumulado anual del mes de Diciembre, que figura por valores Empresa
If indZonaPat = 1 Then
    valorAnual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_GAN_NO_IMP_REDUC",DxDate(dia_pago_act,mes_pago_act,ano_pago_act),indDeduc))
Else
    valorAnual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_GAN_NO_IMP",DxDate(dia_pago_act,mes_pago_act,ano_pago_act),indDeduc))
EndIf    
If IsNull(valorAnual) = True Then valorAnual = 0

valorMensual = valorAnual/12

'Fecha inicio y fin, en enero un empleado no diferido serán 01/01/añoIG y 31/01/añoIG, un empleado diferido serán 01/01/añoIG y 28/02/añoIG
fec_mes_ini  = DxDate("01","01",ano_pago_act)                   'Fecha mes inicio año fiscal
fec_mes_fin  = DxDate(dia_pago_act,mes_pago_act,ano_pago_act)   'Fecha mes fin imput actual

meses = DateDiff (fec_mes_ini,fec_mes_fin+1,M4_MONTH)

'Si el empleado es baja y el indicador "Calcula ganancias a Diciembre" activo se calculará el importe anual
If SAR_ES_BAJA = 1 And SAR_IG_DICIEMBRE = 1 Then meses = 12

importe = valorMensual * meses

Return(Round(importe,SAR_NUM_DEC))
