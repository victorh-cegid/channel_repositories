'impuesto cedular no tiene deducciones:
If SAR_CEDU_IND_IMPUESTO = 1 Then Return(SAR_BASE_IMPUESTO)

base_impuesto = SAR_BASE_IMPUESTO
ind_reliq = 0
If SAR_IND_PAGA_RELIQ = 1 And SCO_DT_PAYMENT = SCO_DT_ALLOCATION Then ind_reliq = 1

indNoNeg = SAR_IND_GAN_NONEG
If base_impuesto < 0 And indNoNeg = 1 Then
    saldo = base_impuesto * -1
    'Deduccion especial tramo 1 y 2. En pagas normales solo se minora la deduccion del propio mes
    'que se haya calculado, no se minora el importe de deduccion consolidado de meses anteriores
    'En reliquidacion se minora el importe acumulado de deduccion de todo el a?o.
    dedTramoDos = SAR_DED_IG_27617_T2
    If ind_reliq = 1 Then dedTramoDos = SAR_DED_IG_27617_T2 + SAR_DED_IG_27617_T2_ACUM
    If saldo > 0 And dedTramoDos > 0 Then
        dedTramoDosFinal = Max(dedTramoDos - saldo,0)
        dedTramoDosAjustado = dedTramoDos - dedTramoDosFinal
        saldo = saldo - dedTramoDosAjustado
        dedTramoDosMes = SAR_DED_IG_27617_T2 - dedTramoDosAjustado
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_DED_IG_27617_T2",-1,dedTramoDosMes)
    EndIf

    'Deduccion especial tramo 1
    dedTramoUno = SAR_DED_IG_27617
    If ind_reliq = 1 Then dedTramoUno = SAR_DED_IG_27617 + SAR_DED_IG_27617_ACUM
    If saldo > 0 And dedTramoUno > 0 Then
        dedTramoUnoFinal = Max(dedTramoUno - saldo,0)
        dedTramoUnoAjustado = dedTramoUno - dedTramoUnoFinal
        saldo = saldo - dedTramoUnoAjustado
        dedTramoUnoMes = SAR_DED_IG_27617 - dedTramoUnoAjustado
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_DED_IG_27617",-1,dedTramoUnoMes)
    EndIf  

    'Deduccion especial 12ava
    dedDoceava = SAR_IG_DED_12AVA
    If saldo > 0 And dedDoceava > 0 Then
        dedDoceavaFinal = Max(dedDoceava - saldo,0)
        dedDoceavaAjustado = dedDoceava - dedDoceavaFinal
        saldo = saldo - dedDoceavaAjustado
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_IG_DED_12AVA",-1,dedDoceavaFinal)
    EndIf  

    'Deduccion especial
    dedEspec = SAR_IG_DED_ESP
    If saldo > 0 And dedEspec > 0 Then
        dedEspecFinal = Max(dedEspec - saldo,0)
        dedEspecAjustado = dedEspec - dedEspecFinal
        saldo = saldo - dedEspecAjustado
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_IG_DED_ESP",-1,dedEspecFinal)
    EndIf  

    'Ganancia no imponible
    ganNoImp = SAR_IG_G_NO_IMP
    If saldo > 0 And ganNoImp > 0 Then
        ganNoImpFinal = Max(ganNoImp - saldo,0)
        ganNoImpAjustado = ganNoImp - ganNoImpFinal
        saldo = saldo - ganNoImpAjustado
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_IG_G_NO_IMP",-1,ganNoImpFinal)
    EndIf  

    'Conyuge
    dedConyuge = SAR_IMP_CONY_IG
    If saldo > 0 And dedConyuge > 0 Then
        dedConyugeFinal = Max(dedConyuge - saldo,0)
        dedConyugeAjustado = dedConyuge - dedConyugeFinal
        saldo = saldo - dedConyugeAjustado
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_IMP_CONY_IG",-1,dedConyugeFinal)
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_IG_CONYUGE_REM",-1,dedConyugeFinal)        
    EndIf  
    
    'Hijos
    dedHijos = SAR_IMP_HIJO_IG
    dedHijMenor = SAR_IG_HIJOS_REM - SAR_IG_HIJOS_INC
    dedHijDisca = SAR_IG_HIJOS_INC
    If saldo > 0 And dedHijos > 0 Then

        'Menor
        dedHijMenorFinal = Max(dedHijMenor - saldo,0)
        dedHijMenorAjustado = dedHijMenor - dedHijMenorFinal
        saldo = saldo - dedHijMenorAjustado

        'Discapacitado
        dedHijDiscaFinal = Max(dedHijDisca - saldo,0)
        dedHijDiscaAjustado = dedHijDisca - dedHijDiscaFinal
        saldo = saldo - dedHijDiscaAjustado

        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_IMP_HIJO_IG",-1,dedHijMenorFinal + dedHijDiscaFinal)
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_IG_HIJOS_REM",-1,dedHijMenorFinal + dedHijDiscaFinal)
        SetValuePriority(1,"SCO_HRPERIOD_CALC","SAR_IG_HIJOS_INC",-1,dedHijDiscaFinal)        
    EndIf  
   
   base_impuesto = saldo * -1 

EndIf

Return(base_impuesto)
