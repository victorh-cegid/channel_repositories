If SAR_TP_IMPUT = "88" Then
    Return(0)
EndIf

porc = SAR_PORC_ADIC_O_SOC - (SAR_PORC_ADIC_O_SOC * SAR_PP_AP_OB_SOC/100)

'En baja o reliquidación retornamos la diferencia entre el descuento del pago y el que se ha ido descontando mes a mes
If SAR_IND_PAGA_RELIQ = 1 OR SAR_ES_BAJA = 1 Then 
    tot_desc_sac_pago = SAR_JUR_SAC * porc / 100
    tot_desc_sac_pago = tot_desc_sac_pago * SAR_FAM_CARGO_OS_OE
    tot_desc_sac_mes = SAR_ACM_IG_ANIO_IMPUT[0].SAR_OB_SOC_ADIC_SAC_OE
    valor = tot_desc_sac_pago - tot_desc_sac_mes
    Return (valor)
EndIf

base = SAR_B_PLUR_SAC_MES
precio = base * porc / 100
valor = precio * SAR_FAM_CARGO_OS_OE
If IsNull(valor) = TRUE Then
    valor = 0
EndIf
Return(valor)
