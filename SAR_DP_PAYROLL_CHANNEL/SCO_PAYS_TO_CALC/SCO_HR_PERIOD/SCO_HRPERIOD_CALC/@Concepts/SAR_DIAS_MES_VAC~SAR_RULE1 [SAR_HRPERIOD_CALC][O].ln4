'
'Para los mensuales los del mes.
'
dias_20 = 0
prop = 0
contador = 0
dias_teor = 0

If(SAR_HR_PERIOD.STD_ID_HRP_START_REASON <> "005")Then 'Por modificacion del empleado
   IF DxMonth(SAR_FECHA_ALTA)> 6 AND DxYear(SAR_FECHA_ALTA) = SAR_PAYS_TO_CALC.SAR_ANIO_PROCESO THEN
       IF ISNULL(SAR_HR_PERIOD.SSP_FEC_ANTIGUEDAD) = FALSE AND SAR_HR_PERIOD.SSP_FEC_ANTIGUEDAD < SAR_FECHA_ALTA THEN
           dias_teor = SAR_DIAS_VACACION 
           prop = 1      ' dias anuales teoricos segun a?os de antiguedad
       ELSE
           dias_20 = 1
       ENDIF
   ELSE
       dias_teor = SAR_DIAS_VACACION
   ENDIF
Else 'Por modificacion del empleado 
   IF DxMonth(SAR_FECHA_ALTA_PER_ANT)> 6 AND DxYear(SAR_FECHA_ALTA_PER_ANT) = SAR_PAYS_TO_CALC.SAR_ANIO_PROCESO THEN
       IF ISNULL(SAR_HR_PERIOD.SSP_FEC_ANTIGUEDAD) = FALSE AND SAR_HR_PERIOD.SSP_FEC_ANTIGUEDAD < SAR_FECHA_ALTA_PER_ANT THEN
           dias_teor = SAR_DIAS_VACACION 
           prop = 1      ' dias anuales teoricos segun a?os de antiguedad
       ELSE
           dias_20 = 1
       ENDIF
   ELSE
       dias_teor = SAR_DIAS_VACACION
   ENDIF
EndIf   

IF dias_teor <> 0 AND prop = 1  THEN  'entro despues de Junio y tiene antiguedad reconocida superior a seis meses
    If(SAR_HR_PERIOD.STD_ID_HRP_START_REASON <> "005")Then 'Por modificacion del empleado
        dias_alta = CommonTime(SAR_FECHA_ALTA,SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC, SAR_FECHA_ALTA,SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC)      
        dias_vac = dias_teor*dias_alta/365   
    Elseif SAR_ES_BAJA = 1 then 
        FECHA = TOSTRING(SAR_PAYS_TO_CALC.SAR_ANIO_PROCESO,0) + "/" + "01" + "/" + "01"
        fec_ini_anio = TODATE(FECHA)  
        dias_alta = CommonTime(fec_ini_anio,SAR_HR_PERIOD.SCO_DT_ALLOC_END,SAR_FECHA_ALTA,SAR_FECHA_BAJA) 
        
        dias_vac = dias_teor*dias_alta/365  
    Else 'Por modificacion del empleado
        dias_alta = CommonTime(SAR_FECHA_ALTA_PER_ANT,SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC, SAR_FECHA_ALTA_PER_ANT,SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC)             
        dias_vac = dias_teor*dias_alta/365   
    EndIf  
ELSE
    IF prop = 0 AND dias_teor <> 0 THEN
        If SAR_ES_BAJA = 0 then        
            dias_vac = dias_teor * DXMONTH(SCO_DT_ALLOCATION)/12
        Elseif SAR_ES_BAJA = 1 then 
            FECHA = TOSTRING(SAR_PAYS_TO_CALC.SAR_ANIO_PROCESO,0) + "/" + "01" + "/" + "01"
            fec_ini_anio = TODATE(FECHA)  
            dias_alta = CommonTime(fec_ini_anio,SAR_HR_PERIOD.SCO_DT_ALLOC_END,SAR_FECHA_ALTA,SAR_FECHA_BAJA)            
            dias_vac = dias_teor*dias_alta/365  
        Endif
    ELSE 
        IF dias_20 <> 0 THEN
            dias_teor = 0
            contador = 0
            num_dias = 0
            prop = 0
            base = 0
            fec_fin = SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC
            If(SAR_HR_PERIOD.STD_ID_HRP_START_REASON <> "005")Then 'Por modificacion del empleado
               fec_ini = SAR_FECHA_ALTA
            Else
               fec_ini = SAR_FECHA_ALTA_PER_ANT
            EndIf   
            fi_base = DXDAY(fec_ini)
            ff_base = DXDAY(fec_fin)
            base = fec_ini
            num_dias = fec_fin - fec_ini + 1
            for i = fec_ini to fec_fin
                base_d = DAYOFTHEWEEK(base)
                IF base_d = 6 OR base_d = 7 THEN
                    contador = contador +1
                ENDIF
                base = base + 1
            next
            dias_trab = num_dias - contador
            dias_vac = dias_trab/20
        ENDIF
    ENDIF
ENDIF
IF ISNULL(dias_vac) = TRUE THEN
    dias_vac = 0
ENDIF

RETURN(dias_vac)
