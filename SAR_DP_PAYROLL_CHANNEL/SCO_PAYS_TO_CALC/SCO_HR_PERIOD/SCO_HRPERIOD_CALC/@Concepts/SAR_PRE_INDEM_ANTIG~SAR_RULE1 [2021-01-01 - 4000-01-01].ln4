'No se calcula en paga de vacaciones, aguinaldo o bajas continuadas
If SAR_TP_IMPUT = "77" Or (SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1) Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017") Then Return(0)

precio = SAR_BASE_INDEMNIZ

If SAR_TOPE_INDEMNIZ > 0 And SAR_IND_INDEM_100 = 0 Then
    precio = Min(SAR_BASE_INDEMNIZ, SAR_TOPE_INDEMNIZ)
EndIf

precio   = precio * SAR_ANTIG_INDEMNIZ
indemmin = SAR_BASE_INDEMNIZ
precio   = Max(indemmin,precio)

Return Round(precio,2)
