'Este concepto devuelve la mejor remuneracion de los conceptos fijos configurados en el total SAR_TOT_INDEM_CONC_FIJ
'en los 12 meses por imputacion anteriores a la fecha de proceso (SCO_DT_ALLOCATION)

'dependencias
a = SAR_TOT_INDEM_CONC_FIJ

'Si no es baja no calcula nada
If SAR_ES_BAJA <> 1 Then Return(0)

importeNoIncMesBaja = 0 : importeIncMesBaja = 0

'uso interno
indTraza = 0 : idTraza = "SAR_TEST_IND_TRAZA" : separadorTraza = "-----------------------------------------"
If ExistNodeItemIndex("SCO_HRPERIOD_CALC", idTraza) <> -1 Then indTraza = GetValue("SCO_HRPERIOD_CALC", idTraza, -1)
If indTraza = 1 Then
    FileOut = "C:\Temp\indemFijos_" + SCO_ID_HR + ".txt" : InitFile(FileOut, "CONCEPTO: SAR_INDEM_ANTIG_FIJA --> Conceptos fijos se encuentran en: SAR_TOT_INDEM_CONC_FIJ")
EndIf

'Hace 2 recorridos, uno con criterio no incluir mes de la baja y otro si incluyendolo
For critMesBaja = 0 To 1

    indAplicaRl = SAR_IND_INDEMNIZ_RL26
    If SAR_FECHA_BAJA < DxDate(6,3,2026) Then indAplicaRl = 0
    
    'Condiciones de salida
    If SAR_ES_BAJA = 0 Or indAplicaRl = 0 Then Return(0)
    
    'Inc mes baja
    incMesBaja = critMesBaja
    
    'Esta linea es para forzar que la read ordene por dt_alloc ya que se queda con el orden
    'del ultimo nodo de acumulado cargado, lo cual puede ser aleatorio
    SAR_ACM_INDEMNIZ_VARIABLES.Load_Blk()
    
    importe = 0
    SAR_INDEM_CALC_FIJA("SAR_TOT_INDEM_CONC_FIJ",12,incMesBaja,importe)
    
    If critMesBaja = 0 Then importeNoIncMesBaja = importe
    If critMesBaja = 1 Then importeIncMesBaja = importe

    'uso interno
    If indTraza = 1 Then
        ConcatFile(FileOut, "") : trazaIncBaja = "INCLUYENDO MES DE LA BAJA:"
        If incMesBaja = 0 Then trazaIncBaja = "NO INCLUYENDO MES DE LA BAJA:"
        ConcatFile(FileOut, separadorTraza) : ConcatFile(FileOut, trazaIncBaja) : ConcatFile(FileOut, separadorTraza) : ConcatFile(FileOut, "")
        If importe <> 0 Then ConcatFile(FileOut, "Mejor fijo = " + ToString(importe))   
    EndIf
    
Next

SAR_INDEM_ANTIG_FIJA_IMB = importeIncMesBaja

Return Round(importeNoIncMesBaja,SAR_NUM_DEC)
