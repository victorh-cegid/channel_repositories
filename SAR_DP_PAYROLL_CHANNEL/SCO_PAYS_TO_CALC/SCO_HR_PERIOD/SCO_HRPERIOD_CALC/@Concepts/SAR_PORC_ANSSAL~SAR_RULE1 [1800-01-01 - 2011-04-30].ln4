'Obtiene el porcentaje que le corresponde de ANSSAL para la obra social y el sueldo
'al tipo de obra social.


IF SAR_SLICE_UNIT..SysSliceNumber > 1 THEN
    base = SAR_REMUN_IMPO..SYSTOTALSLICES(TOTAL_SUM) + SAR_BASE_COTIZ_ART..SYSTOTALSLICES(TOTAL_SUM) + SAR_SAC_IMPO..SYSTOTALSLICES(TOTAL_SUM) + SAR_VAC_IMPO..SYSTOTALSLICES(TOTAL_SUM)
ELSE
    base = SAR_REMUN_IMPO + SAR_BASE_COTIZ_ART + SAR_SAC_IMPO + SAR_VAC_IMPO 
ENDIF


IF SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC <= ToDate("2002-03-21") THEN
    tipo = "2"
ELSE
    tipo = SAR_ID_TIPO_OS 
ENDIF

porc = SAR_ANSSAL.SAR_RETORNA_VALOR(base,tipo,ID_CURRENCY)

RETURN(porc)
