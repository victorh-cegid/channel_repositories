    SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_DEBITO_BANCARIO",-1,0)
    SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_PERC_RET_ADUANERAS",-1,0)
    SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_PAG_CUENT_EXT",-1,0)
