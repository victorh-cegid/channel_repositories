IF SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

IF SAR_PR_COMP_ANTIG = 0 OR SAR_DIAS_NORM_SUELD = 0 THEN 
    Return(0)
ENDIF

IF SAR_TIPO_SALARIO = "001" THEN
    IF SAR_DIAS_NORM_SUELD = 0 THEN
        valor = 0
    ELSE
        valor = (SAR_U_CONC_FIJOS * SAR_PR_COMP_ANTIG) / SAR_DIAS_NORM_SUELD
    ENDIF
ELSE
    valor = (SAR_U_CONC_FIJOS * SAR_PR_COMP_ANTIG)
ENDIF

Return(valor)
