If SCO_DT_PAYMENT = SCO_DT_ALLOCATION Then Return(0)
'Las bases de las pagas originales
base = SCO_AC_HR_PERIOD_REV_1.SAR_AGO23_IMP_SIN_HE
If base < 0 And SCO_AC_HR_PERIOD_REV_1.SAR_AGO23_BASE_IMP > 0 Then base = 0

'La fecha del impuesto original
fecImp = SAR_FEC_IMPUT_IG
If SAR_IND_IMPUESTO_RETRO = 1 Then fecImp = SAR_FEC_IMPUT_IG

esBaja = 0
If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then esBaja = 1
If esBaja = 1 And SAR_IG_DICIEMBRE = 1 Then fecImp = DxDate("31","12",DxYear(fecImp))

aux = SAR_IMPUESTO.SAR_RETORNA_VALOR(base,fecImp,ID_CURRENCY)

Return Round(aux,SAR_NUM_DEC)
