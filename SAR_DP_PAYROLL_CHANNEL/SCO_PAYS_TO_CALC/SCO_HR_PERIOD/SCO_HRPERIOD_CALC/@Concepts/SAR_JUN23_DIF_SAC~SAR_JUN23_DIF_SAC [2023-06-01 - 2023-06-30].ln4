importe = SAR_JUN23_DIF_SAC
aplica = 0

'Promedio anual por percibido
retribJun = SAR_PROM_27617_BONOS

'Si el ajuste sac es negativo significa que esta ajustando sac grabado para dejarlo exento. Las cuotas aplican solo para promedio entre 506230 y 880000
If SAR_DIF_SAC_RG3976+SAR_DIF_PROR_SAC < 0 And DxYear(SAR_FEC_IMPUT_IG) = 2023 And retribJun >= 506230 And retribJun <= 880000 And importe < 0 Then aplica = 1
If aplica = 0 Then return (0)

'Se hace positivo porque se va a simular el incremento de la base en el impuesto
importe = importe * -1

Return(importe)
