'Este concepto asigna valor a propiedades del nodo de acumulado para poder mostrarlas
'en el recibo por pantalla. No necesitamos guardarlas en el acumulado.


If SAR_HT_PAYS.SCO_FROM_JS <> 1 Then
   IF SAR_H_HR_LEGAL_ENTITY.COUNT() > 0 THEN
      SAR_H_HR_LEGAL_ENTITY.BEGIN()
      EMPRESA = SAR_H_HR_LEGAL_ENTITY.SCO_ID_LEG_ENT + " - " + SAR_H_HR_LEGAL_ENTITY.STD_N_LEG_ENT
   ELSE
      EMPRESA = ""
   ENDIF
   SCO_AUX_AC_HRPERIOD_1.SAR_ANTIGUEDAD = SAR_FEC_INDEM
   SCO_AUX_AC_HRPERIOD_1.SAR_CUIL = SAR_PERSON_CALC.STD_SS_NUMBER
   SCO_AUX_AC_HRPERIOD_1.SAR_N_EMPRESA = EMPRESA
   SCO_AUX_AC_HRPERIOD_1.SAR_EMPLEADO = SAR_HR_PERIOD.STD_ID_HR + " / " + TOSTRING(SAR_HR_PERIOD.STD_OR_HR_PERIOD,0)
Endif   
Return(0)
