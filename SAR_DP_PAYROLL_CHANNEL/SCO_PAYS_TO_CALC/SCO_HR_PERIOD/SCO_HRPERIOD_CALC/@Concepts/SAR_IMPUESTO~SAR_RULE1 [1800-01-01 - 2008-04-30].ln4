IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR (SAR_TP_IMPUT = "3"  AND SAR_ES_BAJA = 0) THEN
    Return(0)
ENDIF

IF (SAR_ES_BAJA = 0) and (SAR_FECHA_BAJA < SCO_DT_ALLOCATION)  and (SAR_IMPUESTO_TOTAL = 0)Then    'condicion para Nomina despues de la baja
    RETURN(0)
ENDIF

'Inicializo variables 


v1 = SAR_IMPUESTO_TOTAL
v2 = 0
v3 = SAR_IMP_ANT_EMP
v4 = 0
v5 = 0

'Recorro acumulado de lectura para armar las TI de IG

SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()- 1

FOR I = 0 TO ULTIMO_REG 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
    ' Armo los datos para SAR_ACM_IMPUESTO
    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
        v2 = v2 + SCO_AC_HR_PERIOD_READ_1.SAR_ACM_IMPUESTO
    ENDIF

   ' Armo los datos para SAR_REV_ACM_IMPUESTO2
    IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <> SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SAR_FEC_PAGO_IG = SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG THEN 
        v5 = v5 + SCO_AC_HR_PERIOD_READ_1.SAR_IMPUESTO
    ENDIF

    'Armo los datos para REV_ACM_IMPUESTO
    IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_DT_ALLOCATION AND SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG < SAR_FEC_PAGO_IG THEN 
        v4 = v4 + SCO_AC_HR_PERIOD_READ_1.SAR_IMPUESTO
    ENDIF
NEXT

'-----------------------------------------------------------------------

IF ISNULL(v1) = TRUE THEN
    v1 = 0 
ENDIF
IF ISNULL(v2) = TRUE THEN
    v2 = 0 
ENDIF
IF ISNULL(v3) = TRUE THEN
    v3 = 0 
ENDIF
IF ISNULL(v4) = TRUE THEN
    v4 = 0 
ENDIF
IF ISNULL(v5) = TRUE THEN
    v5 = 0 
ENDIF

valor = v1 - (v2 + v3) + v4 - v5 - SAR_IMP_DEB_BAN

RETURN(valor)
