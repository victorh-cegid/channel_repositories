'Esta regla es sólo para bajas anteriores a junio en periodo fiscal 2023
esBaja = 0
If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" And DxYear(SAR_FEC_IMPUT_IG) = 2023 Then esBaja = 1
If esBaja = 0 Then Return(0)

aux    = 0
debito = 0

aux = SAR_JUN23_DESDE_IMP
base = SAR_BASE_IMPUESTO + SAR_JUN23_DIF_SAC

valor = SAR_JUN23_C_FIJ_IMP + SAR_JUN23_PORC_IMP * (base - aux )/100

if isnull(valor) = true Then valor = 0

RETURN(valor)
