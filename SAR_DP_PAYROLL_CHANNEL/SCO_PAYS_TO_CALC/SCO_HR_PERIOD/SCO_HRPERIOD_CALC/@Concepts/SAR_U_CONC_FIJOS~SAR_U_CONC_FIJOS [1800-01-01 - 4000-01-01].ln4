'Busco la cantidad de dias trabajados llamando al concepto 550

IF SAR_TP_IMPUT = "2" THEN Return(0)

INICIO_TRAMO = SAR_SLICE_UNIT..SysStartDate
FIN_TRAMO = SAR_SLICE_UNIT..SysEndDate

valor = SAR_DIAS_ALTA(INICIO_TRAMO,FIN_TRAMO)

'agregado pablo
valor = valor + SAR_DIAS_EXCEDENCIA

IF SAR_TIPO_SALARIO = "003" and SAR_CANT_HS_TRABAJADAS > 0 THEN 'Salario horario y tiene horas reales trabajadas informadas
    valor = valor - SAR_DIAS_EXCEDENCIA
ENDIF

'Guardo los dias trabajados en una propiedad para poder utilizarla desde el calculo
'del sueldo a nivel de Rol
SAR_HR_ROLE.SAR_P_DIAS_TRABAJADOS = valor

return(valor)
