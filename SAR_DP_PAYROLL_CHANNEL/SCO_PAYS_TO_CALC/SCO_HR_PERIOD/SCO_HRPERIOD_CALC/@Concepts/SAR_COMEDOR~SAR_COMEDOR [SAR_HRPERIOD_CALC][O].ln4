valor= 0
SAR_HRP_BNFT.begin()
credito_benef=0 

while (SAR_HRP_BNFT.iseof()  = M4_FALSE)
    if SAR_HRP_BNFT.SUS_ID_PLAN_TYPE = "D10" Then
            credito_benef = credito_benef + SAR_HRP_BNFT.SUS_CREDIT
    endif
    SAR_HRP_BNFT.GONEXT()
WEND 

'Calculo de los dias a pagar
IF #SAR_TIPO_SALARIO =  "003" THEN
    dias = (#SAR_U_CONC_FIJOS/#SAR_HS_DIARIAS_PROM) + #SCO_NUM_DAYS_CAL  'se tiene en cuenta los dia de feriados
ELSE
    dias = #SAR_U_CONC_FIJOS + #SCO_NUM_DAYS_CAL        'se tiene en cuenta los dia de feriados
ENDIF    
If dias < 0 Then dias = 0

valor = (credito_benef/30) * dias  'Se lleva el valor cargado por beneficios a valor diario.

return(valor)
