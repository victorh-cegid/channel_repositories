IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
    tope = SAR_TOPE_COTIZ 
ELSE
     SAR_ACM_ACT_CONTRIB.BEGIN()
    'Resto al tope lo acumulado en el mes
    tope = SAR_TOPE_COTIZ - SAR_ACM_ACT_CONTRIB.SAR_VAC_IMPO
ENDIF

IF SAR_DIAS_NORM_COTIZ = 0 THEN
    base = 0
ELSE
    base = tope/SAR_DIAS_NORM_COTIZ
ENDIF
tope = base * SAR_UN_VACACIONES
aux = SAR_IMPORTE_LICENCIAS
aux = SAR_AJ_VACACIONES
vac = SAR_VACACIONES

'Si hay ajuste en el pago contemplamos el ajuste en el impuesto
If SAR_AJ_VACACIONES > 0 Then
    dias_ajuste = SAR_DIAS_VACACIONES
    If dias_ajuste + SAR_UN_VACACIONES > SAR_DIAS_NORM_COTIZ Then dias_ajuste = SAR_DIAS_NORM_COTIZ - SAR_UN_VACACIONES
    tope_ajuste = base * dias_ajuste
    tope = tope + tope_ajuste
    vac = vac + SAR_AJ_VACACIONES
EndIf

base = Min(tope,vac)
Return(base)
