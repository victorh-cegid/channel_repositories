dif_sac_RG3976 = 0
valoracum = SAR_ACM_IG_ANIO_IMPUT[0].SAR_B_SAC_MES_RG3976 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_DIF_SAC_RG3976
valormes = SAR_B_SAC_MES_RG3976

importe = valoracum + valormes

sum_tot_sac = SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_PROR_SAC + SAR_TOT_PROR_SAC

indReliq = SAR_IND_PAGA_RELIQ
If indReliq = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then indReliq = 0

If SAR_ES_BAJA = 1 Or indReliq = 1 Or SAR_IND_AJUSTE_SAC = 1 Then
    dif_sac_RG3976 = sum_tot_sac - importe
    If abs(dif_sac_RG3976) <= SAR_TOLERANCIA_DEC   Then
        dif_sac_RG3976 = 0
        importe = sum_tot_sac
    Endif
EndIf    

'Control retroactividad años anteriores: se ajusta siempre para que entre directamente al impuesto en la siguiente paga normal
sac_anio_ant = SAR_IND_SAC_ANIO_ANT
If sac_anio_ant = 1 Then
    mes_orig = SAR_AC_SAC_REV[0].SAR_DIF_SAC_RG3976
    sac_dif = SAR_TOT_PROR_SAC - SAR_AC_SAC_REV[0].SAR_TOT_PROR_SAC
    dif_sac_RG3976 = mes_orig + sac_dif
    importe = SAR_AC_SAC_REV[0].SAR_ACM_PROR_SAC
EndIf

SAR_DIF_SAC_RG3976 = dif_sac_RG3976

Return(importe)
