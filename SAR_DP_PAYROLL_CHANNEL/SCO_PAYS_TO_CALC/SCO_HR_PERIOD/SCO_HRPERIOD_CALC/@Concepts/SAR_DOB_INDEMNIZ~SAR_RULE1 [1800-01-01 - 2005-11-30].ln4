'Aplicamos el porcentaje para duplicar los valores de indemnizaciones 
IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

IF SAR_ES_BAJA=0 THEN RETURN(0)
//IF #270="1" THEN RETURN(0)ENDIF

valor = 0

IF SAR_FECHA_ALTA < TODATE("2003-01-01") OR SAR_IND_DOB_INDE = 1 THEN 

   porc =  (SAR_PP_DOB_INDEM / 100)
  valor =  (SAR_INDEM_ANT_DESP + SAR_INDM_MATERNIDAD +  SAR_INDEM_EMBARAZO+ SAR_INDEM_MATRIM + SAR_INDEM_DEL_GREM + SAR_INDEM_ANT_FALLE + SAR_INDEM_INC_2 + SAR_INDEM_INC_3 + SAR_INDEM_INC_4 + SAR_INDEM_FIN_CONTR + SAR_INDEM_FUER_MAY  ) * porc

ENDIF
IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF
RETURN(valor)
