If DxYear(SAR_FEC_IMPUT_IG) > 2023 Then Return(0)

'Ley 27617 quedara exento hasta el 40% de la gni si las retribuciones del mes no superan un limite.
exenMes = 0
similarNatPrevMesIG = 0
similarNatPagaAct = 0
similarNatMesIG = 0
similarNatAnioIG = 0
exenPagaAntMismoMes = 0
grabPagaAntMismoMes = 0
exenGastadoHastaMesAnt = 0
exenTeorPagaAntMismoMes = 0
exenTeorGastadoHastaMesAnt = 0
esBajaReliq = 0
esRetro = 0
exenMesTeor = 0
aporteJubTeor = 0
aporteLeyTeor = 0
aporteOsocTeor = 0
aporteAdosTeor = 0
aporteSindTeor = 0
calcula_SimilarNat_mes = 1

If SAR_IND_PAGA_RELIQ = 1 Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Then esBajaReliq = 1

'Similar naturaleza pagados en pagas anteriores del mismo mes IG sin incluir la paga de proceso
similarNatPrevMesIG = SAR_ACM_MESACT_IMPIG[0].SAR_TOT_SIMILAR_NAT_27617

'Similar naturaleza pagados en la paga de proceso
similarNatPagaAct = SAR_TOT_SIMILAR_NAT_27617

similarNatMesIG = similarNatPagaAct + similarNatPrevMesIG

'Similar naturaleza pagados en el a?o fiscal incluida la paga de proceso
similarNatAnioIG = SAR_TOT_SIMILAR_NAT_27617 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_SIMILAR_NAT_27617
If esBajaReliq = 1 Then similarNatAnioIG = SAR_TOT_SIMILAR_NAT_27617 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_SIMILAR_NAT_27617

'Similar naturaleza exentos calculados en las pagas anteriores del mismo mes IG de proceso, sin incluir la paga de proceso
exenPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_EXEN_MES

'Similar naturaleza grabados calculados en las pagas anteriores del mismo mes IG de proceso, sin incluir la paga de proceso
grabPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_GRAV_MES

'Similar naturaleza exentos calculados en el a?o fiscal sin considerar los del mes IG de proceso
exenGastadoHastaMesAnt = SAR_ACM_IG_ANIO_COMPLETO[0].SAR_SIMILAR_NAT_EXEN_MES - exenPagaAntMismoMes

'Similar naturaleza exentos teoricos calculados en las pagas anteriores del mismo mes IG de proceso, sin incluir la paga de proceso
exenTeorPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_EXEN_MES_TEOR

'Similar naturaleza exentos teoricos calculados en el a?o fiscal sin considerar los del mes IG de proceso
exenTeorGastadoHastaMesAnt = SAR_ACM_IG_ANIO_COMPLETO[0].SAR_SIMILAR_NAT_EXEN_MES_TEOR - exenTeorPagaAntMismoMes

'Porcentajes para calculo de aportes
porcJub = 0
porcLey = 0
If SAR_EDAD >= 18 Then 
    porcJub = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
    porcLey = SAR_PORC_LEY_19032 - (SAR_PORC_LEY_19032 * SAR_PP_AP_INSSJP/100)
EndIf
porcObSoc = SAR_PORC_OBR_SOCIAL -(SAR_PORC_OBR_SOCIAL * SAR_PP_AP_OB_SOC/100)
porcAdObSoc = SAR_PORC_ADIC_O_SOC - (SAR_PORC_ADIC_O_SOC * SAR_PP_AP_OB_SOC/100)
porcSind = SAR_PORC_C_SIND_VOL + SAR_PORC_C_SIND_OBL

'Aportes a descontar calculados en las pagas anteriores del mismo mes IG de proceso, sin incluir la paga de proceso
jubPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_JUB
jubPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_JUB_TEO
leyPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_LEY
leyPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_LEY_TEO
osocPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_OSOC
osocPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_OSOC_TEO
adosPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_ADOS
adosPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_ADOS_TEO
sindPagaAntMismoMes = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_SIND
sindPagaAntMismoMesTeo = SAR_ACM_MESACT_IMPIG[0].SAR_SIMILAR_NAT_IG_SIND_TEO

'Tope exento para aplicar en el a?o fiscal
topeMaxExen = Percentage(40,SAR_NO_IMP_27617)

If similarNatAnioIG = 0 Or (similarNatMesIG = 0 And esBajaReliq = 0) Or (SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1) Then calcula_SimilarNat_mes = 0

If calcula_SimilarNat_mes = 1 Then
    'En el calculo del mes se comprueba si esta alcanzado tomando lo menor entre el promedio y el mes
    If esBajaReliq = 0 Then
        'La exencion teorica se calcula siempre, puede hacer falta para la paga de reliquidacion
        disponibleExenTeor = Max(topeMaxExen - exenTeorGastadoHastaMesAnt,0)
        exenMesTeor = Min(disponibleExenTeor,similarNatMesIG) - exenTeorPagaAntMismoMes
        SAR_SIMILAR_NAT_EXEN_MES_TEOR = exenMesTeor
    
        'Valida si el empleado esta alcanzado por la exencion
        retrib = SAR_PROM_27617_BONOS
        vValor = SAR_DED_ESP_INC.SAR_RETORNA_VAL_TRAM(3,SAR_FEC_IMPUT_IG,ID_CURRENCY)
        If vValor >= retrib Then
            disponibleExen = Max(topeMaxExen - exenGastadoHastaMesAnt,0)
            exenMes = Min(disponibleExen,similarNatMesIG) - exenPagaAntMismoMes
        EndIf
    
        'Similar naturaleza grabado es la diferencia entre Similar naturaleza del mes IG y el exento del mes IG, considerando pagas anteriores.
        exenTotalDelMes = exenMes + exenPagaAntMismoMes
        exenTotalDelMesTeor = exenMesTeor + exenTeorPagaAntMismoMes
    
        gravMes = similarNatMesIG - exenTotalDelMes - grabPagaAntMismoMes
        SAR_SIMILAR_NAT_GRAV_MES = gravMes
    
        'Aportes a descontar de IG
        aporteJub = Percentage(porcJub,exenTotalDelMes) - jubPagaAntMismoMes
        aporteJubTeor = Percentage(porcJub,exenTotalDelMesTeor) - jubPagaAntMismoMesTeo
        SAR_SIMILAR_NAT_IG_JUB = aporteJub
        SAR_SIMILAR_NAT_IG_JUB_TEO = aporteJubTeor
        
        aporteLey = Percentage(porcLey,exenTotalDelMes) - leyPagaAntMismoMes
        aporteLeyTeor = Percentage(porcLey,exenTotalDelMesTeor) - leyPagaAntMismoMesTeo
        SAR_SIMILAR_NAT_IG_LEY = aporteLey
        SAR_SIMILAR_NAT_IG_LEY_TEO = aporteLeyTeor
    
        aporteOsoc = Percentage(porcObSoc,exenTotalDelMes) - osocPagaAntMismoMes
        aporteOsocTeor = Percentage(porcObSoc,exenTotalDelMesTeor) - osocPagaAntMismoMesTeo
        SAR_SIMILAR_NAT_IG_OSOC = aporteOsoc
        SAR_SIMILAR_NAT_IG_OSOC_TEO = aporteOsocTeor
    
        aporteAdos = Percentage(porcAdObSoc,exenTotalDelMes) - adosPagaAntMismoMes
        aporteAdosTeor = Percentage(porcAdObSoc,exenTotalDelMesTeor) - adosPagaAntMismoMesTeo
        SAR_SIMILAR_NAT_IG_ADOS = aporteAdos * SAR_FAM_CARGO_OS
        SAR_SIMILAR_NAT_IG_ADOS_TEO = aporteAdosTeor * SAR_FAM_CARGO_OS
       
        aporteSind = Percentage(porcSind,exenTotalDelMes) - sindPagaAntMismoMes
        aporteSindTeor = Percentage(porcSind,exenTotalDelMesTeor) - sindPagaAntMismoMesTeo
        SAR_SIMILAR_NAT_IG_SIND = aporteSind
            SAR_SIMILAR_NAT_IG_SIND_TEO = aporteSindTeor            
    'En el calculo de baja o reliquidacion solo se toma el promedio y se ajusta la situacion final
    Else
        retrib = SAR_PROM_27617_BONOS
    
        'En caso de baja o paga de reliquidacion se mira la fecha de pago IG
        vValor = SAR_DED_ESP_INC.SAR_RETORNA_VAL_TRAM(3,SAR_FEC_PAGO_IG,ID_CURRENCY)
    
        'Si esta alcanzado por la exencion se toma la exencion teorica para los aportes
        If vValor >= retrib Then
            If DxYear(SAR_FEC_IMPUT_IG) = 2023 Then topeMaxExen = Max(topeMaxExen - SAR_ACM_SEP23_IMP_REV[0].SAR_SIMILAR_NAT_EXEN_4CATEG,0)
            exenSimilarNatFinal = Min(topeMaxExen,similarNatAnioIG)
            gravSimilarNatFinal = similarNatAnioIG - exenSimilarNatFinal
    
            'En caso de baja hay que contemplar que puede percibir Similar naturaleza el mes de la baja
            If SAR_ES_BAJA = 1 Then
                disponibleExenTeor = Max(topeMaxExen - exenTeorGastadoHastaMesAnt,0)
                
                exenMesTeor = Min(disponibleExenTeor,similarNatMesIG) - exenTeorPagaAntMismoMes
                SAR_SIMILAR_NAT_EXEN_MES_TEOR = exenMesTeor
                
                aporteJubTeor = Percentage(porcJub,exenMesTeor) - jubPagaAntMismoMesTeo
                SAR_SIMILAR_NAT_IG_JUB_TEO = aporteJubTeor
                
                aporteLeyTeor = Percentage(porcLey,exenMesTeor) - leyPagaAntMismoMesTeo            
                SAR_SIMILAR_NAT_IG_LEY_TEO = aporteLeyTeor
                
                aporteOsocTeor = Percentage(porcObSoc,exenMesTeor) - osocPagaAntMismoMesTeo            
                SAR_SIMILAR_NAT_IG_OSOC_TEO = aporteOsocTeor
                
                aporteAdosTeor = Percentage(porcAdObSoc,exenMesTeor) - adosPagaAntMismoMesTeo            
                SAR_SIMILAR_NAT_IG_ADOS_TEO = aporteAdosTeor * SAR_FAM_CARGO_OS
                
                aporteSindTeor = Percentage(porcSind,exenMesTeor) - sindPagaAntMismoMesTeo
                SAR_SIMILAR_NAT_IG_SIND_TEO = aporteSindTeor   
            EndIf
    
            'Solo en 2023 y para el periodo fiscal desde octubre: Al desvincular OE de este concepto que queda para empresa
            'se cambia el nodo de acumulado por otro especial SAR_ACM_IG_DESDE_OCT23, para que los ajustes de OE que se van
            'a producir retroactivamente desde reliq diciembre 23 a pagas anteriores a octubre no se consideren en el periodo
            'fiscal desde octubre, en caso contrario por el criterio "percibido" se considerarian, pero en caso de OE el critero
            'en retroactividad es que quede imputado siempre al mes donde se informa el dato.
            If DxYear(SAR_FEC_IMPUT_IG) = 2023 And SCO_DT_ALLOCATION > DxDate(1,10,2023) Then
                'Aportes: en baja o reliquidacion seran los teoricos, agregamos los del mes en caso de baja
                aporteJubFinal = SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_JUB_TEO + aporteJubTeor
                aporteLeyFinal = SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_LEY_TEO + aporteLeyTeor
                aporteOsocFinal = SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_OSOC_TEO + aporteOsocTeor
                aporteAdosFinal = SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_ADOS_TEO + aporteAdosTeor
                aporteSindFinal = SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_SIND_TEO + aporteSindTeor
            Else
                'Aportes: en baja o reliquidacion seran los teoricos, agregamos los del mes en caso de baja
                aporteJubFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_JUB_TEO + aporteJubTeor
                aporteLeyFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_LEY_TEO + aporteLeyTeor
                aporteOsocFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_OSOC_TEO + aporteOsocTeor
                aporteAdosFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_ADOS_TEO + aporteAdosTeor
                aporteSindFinal = SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_SIND_TEO + aporteSindTeor
            EndIf
        'Si no esta alcanzado todo Similar naturaleza sera grabado. Parte exenta y aportes quedan a 0
        Else
            gravSimilarNatFinal = similarNatAnioIG
            exenSimilarNatFinal = 0
            aporteJubFinal = 0
            aporteLeyFinal = 0
            aporteOsocFinal = 0
            aporteAdosFinal = 0
            aporteSindFinal = 0
        EndIf
    
        'Solo en 2023 y para el periodo fiscal desde octubre: Al desvincular OE de este concepto que queda para empresa
        'se cambia el nodo de acumulado por otro especial SAR_ACM_IG_DESDE_OCT23, para que los ajustes de OE que se van
        'a producir retroactivamente desde reliq diciembre 23 a pagas anteriores a octubre no se consideren en el periodo
        'fiscal desde octubre, en caso contrario por el criterio "percibido" se considerarian, pero en caso de OE el critero
        'en retroactividad es que quede imputado siempre al mes donde se informa el dato.
        If DxYear(SAR_FEC_IMPUT_IG) = 2023 And SCO_DT_ALLOCATION > DxDate(1,10,2023) Then
            'Graba la diferencia entre lo calculado y lo acumulado en el a?o fiscal
            exenMes = exenSimilarNatFinal - SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_EXEN_MES
        
            gravMes = gravSimilarNatFinal - SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_GRAV_MES
            SAR_SIMILAR_NAT_GRAV_MES = gravMes
        
            aporteJubMes = aporteJubFinal - SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_JUB
            SAR_SIMILAR_NAT_IG_JUB = aporteJubMes
            
            aporteLeyMes = aporteLeyFinal - SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_LEY
            SAR_SIMILAR_NAT_IG_LEY = aporteLeyMes
        
            aporteOsocMes = aporteOsocFinal - SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_OSOC
            SAR_SIMILAR_NAT_IG_OSOC = aporteOsocMes
        
            aporteAdosMes = aporteAdosFinal - SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_ADOS
            SAR_SIMILAR_NAT_IG_ADOS = aporteAdosMes * SAR_FAM_CARGO_OS
        
            aporteSindMes = aporteSindFinal - SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_IG_SIND
            SAR_SIMILAR_NAT_IG_SIND = aporteSindMes
        Else
            'Graba la diferencia entre lo calculado y lo acumulado en el a?o fiscal
            exenMes = exenSimilarNatFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_EXEN_MES
        
            gravMes = gravSimilarNatFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_GRAV_MES
            SAR_SIMILAR_NAT_GRAV_MES = gravMes
        
            aporteJubMes = aporteJubFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_JUB
            SAR_SIMILAR_NAT_IG_JUB = aporteJubMes
            
            aporteLeyMes = aporteLeyFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_LEY
            SAR_SIMILAR_NAT_IG_LEY = aporteLeyMes
        
            aporteOsocMes = aporteOsocFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_OSOC
            SAR_SIMILAR_NAT_IG_OSOC = aporteOsocMes
        
            aporteAdosMes = aporteAdosFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_ADOS
            SAR_SIMILAR_NAT_IG_ADOS = aporteAdosMes * SAR_FAM_CARGO_OS
        
            aporteSindMes = aporteSindFinal - SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_IG_SIND
            SAR_SIMILAR_NAT_IG_SIND = aporteSindMes
        EndIf
    
    EndIf
EndIf

'Reparto en reportes
totalSimilarNatEmpresa = SAR_ACM_IG_ANIO_IMPUT[0].SAR_TOT_SIMILAR_NAT_27617 + SAR_TOT_SIMILAR_NAT_27617
If DxYear(SAR_FEC_IMPUT_IG) = 2023 And SCO_DT_ALLOCATION > DxDate(1,10,2023) Then
    totalExento = SAR_ACM_IG_DESDE_OCT23[0].SAR_SIMILAR_NAT_EXEN_MES + exenMes
Else
    totalExento = SAR_ACM_IG_ANIO_IMPUT[0].SAR_SIMILAR_NAT_EXEN_MES + exenMes
EndIf

totalExentoResto = Max(totalExento,0)
totalExentoEmp = Min(totalExentoResto,totalSimilarNatEmpresa)
totalGravadoEmp = Max(totalSimilarNatEmpresa - totalExentoEmp,0)

SAR_SIMILAR_NAT_GRAV_4CATEG = totalGravadoEmp
SAR_SIMILAR_NAT_EXEN_4CATEG = totalExentoEmp

Return(exenMes)
