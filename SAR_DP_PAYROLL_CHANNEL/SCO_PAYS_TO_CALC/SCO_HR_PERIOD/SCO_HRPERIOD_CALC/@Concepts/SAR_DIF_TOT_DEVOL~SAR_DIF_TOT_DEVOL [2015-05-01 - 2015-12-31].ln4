'Solo en pagas normales, reliquidación o Paga extra de Aguinaldo:
If(SAR_TP_IMPUT = "1" Or SAR_TP_IMPUT = "99") Or (SAR_TP_IMPUT = "2" AND SAR_IND_AGUINALDO = 1) Then

'Por Res 3770 para los empleados rango 1 no debe recalcularse nada.
    valor = 0
    vMesPaga = ToString(DxMonth(SCO_DT_PAYMENT),0)
    If vMesPaga = "5" Then 'Si es mes Mayo
        IF SAR_RANGO_REM_IG_2015 = 1  Then Return(0)
    
        If SAR_IG_DEC142_AUX2 < 0 Then
            Return(valor)
        Else
            valor = SAR_IG_DEC142_AUX2
        Endif
    Else 'Si no es mes Mayo
    	'leer read de mayo ya que debe congelar su valor (LEER DONDE LA FECHA DE PAGO IG SEA MAYO)
            vIniDevolucion = DxDate(01,05,2015)
            vFinDevolucion = DxDate(31,12,2015)
            If (vIniDevolucion <= SAR_FEC_PAGO_IG and vFinDevolucion >= SAR_FEC_PAGO_IG) Then
                    
                 ANIO_ACT = DXYEAR(SCO_DT_PAYMENT)                                 
                 MES_ACT  = DXMONTH(SCO_DT_PAYMENT)                    
                    
                 If(MES_ACT = 1)Then
                       MES_ANT = 12
                       ANIO_ANT = ANIO_ACT - 1
                 Else   
                       MES_ANT = MES_ACT - 1     
                       ANIO_ANT = ANIO_ACT
                 EndIf                
                    
                 DIAS_MES_ANT     = DaysOfMonth(MES_ANT)                                 
                 DIAS_MES_ANT_STR = ToString(DIAS_MES_ANT, 0)                    
                        
                 If(MES_ANT < 10)Then
                        MES_ANT_STR = "0" + ToString(MES_ANT, 0)
                 Else
                        MES_ANT_STR = ToString(MES_ANT, 0)
                 EndIf
    
                 ANIO_ANT_STR  = Tostring(ANIO_ANT, 0)                                 
                  
                 F_MES_ANT_INI = ToDate(ANIO_ANT_STR + "-" + MES_ANT_STR + "-" + "01")              
                 F_MES_ANT_FIN = ToDate(ANIO_ANT_STR + "-" + MES_ANT_STR + "-" + DIAS_MES_ANT_STR)   
                    
    	       If SCO_AC_HR_PERIOD_READ_1.count() > 0  Then
                    For a = 0 To SCO_AC_HR_PERIOD_READ_1.count() -1
                        SCO_AC_HR_PERIOD_READ_1.MoveTo(a)
                        If(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT >= F_MES_ANT_INI And SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT <= F_MES_ANT_FIN) and (SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1") and  SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT =  SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION Then
                            valor = SCO_AC_HR_PERIOD_READ_1.SAR_DIF_TOT_DEVOL
                        Endif
                    Next
    	       Endif
            Endif
    Endif
Else
  Return(0)
EndIf

    
Return(valor)
