If DxYear(SAR_FEC_IMPUT_IG) > 2023 Then Return(SAR_IMP_CONY_IG)

'Controla que no se supere el importe anual
valor = SAR_IMP_CONY_IG

importeSep = SAR_ACM_SEP23_DED_REV[0].SAR_IG_CONYUGE_REM
importeCompleto = SAR_IMP23_CONY_COMPL

If valor + importeSep > importeCompleto Then valor = importeCompleto - importeSep

Return Round(valor,SAR_NUM_DEC)
