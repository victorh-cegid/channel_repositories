contador = 0
'Cargo el nodo de Familiares para Impuesto
IF SAR_FAMIL_IMPUESTO.COUNT() = 0 THEN
    SAR_FAMIL_IMPUESTO.SAR_FEC_INI_IG = SAR_FEC_INI_IG
    SAR_FAMIL_IMPUESTO.SAR_FEC_FIN_IG = SAR_FEC_FIN_IG 
    SAR_FAMIL_IMPUESTO.LOAD_BLK()
    IF SAR_FAMIL_IMPUESTO.COUNT() = 0 THEN
       Return(0)
    ENDIF
ENDIF

importe   = 0
mini      = 0
primerreg = 0
ultimoreg = SAR_FAMIL_IMPUESTO.COUNT() -1

'Inicio - Manejo de las incapacidades - Validaciones por edad de familiares a cargo 
'Aca voy a cargar la TI de incapacidades
IF SAR_INCAPACIDADES.COUNT() = 0 THEN
    SAR_INCAPACIDADES.LOAD_BLK()
    SAR_INCAPACIDADES.BEGIN()
ENDIF


FOR I = primerreg TO ultimoreg 
    SAR_FAMIL_IMPUESTO.MOVETO(I)
    parent              = SAR_FAMIL_IMPUESTO.STD_ID_ACT_DEP_TYPE
    tipo_parent         = SAR_FAMIL_IMPUESTO.STD_ID_DEP_TYPE
    fec_nac             = SAR_FAMIL_IMPUESTO.STD_DT_BIRTH
    Existe_inc = 0
    
    If (tipo_parent = "11" OR tipo_parent = "12" OR tipo_parent = "16" OR tipo_parent = "18" or tipo_parent = "2" Or tipo_parent = "5" Or tipo_parent = "13" Or tipo_parent = "14" Or tipo_parent = "15" Or tipo_parent = "17") Then
     
    If(parent = "3" Or parent = "9" ) Then   
                   
        'Se busca (findregister) si existe incapacidad para el familiar
        SAR_INCAPACIDADES.BEGIN()
        Reg_inc = SAR_INCAPACIDADES.FindRegister("SCO_ID_HR",SAR_FAMIL_IMPUESTO.STD_ID_FAMILY_PERSON,EQUAL,"SCO_ID_DISABILITY","05",EQUAL)
        If Reg_inc <> -1 Then
            SAR_INCAPACIDADES.moveto(Reg_inc)
            If (SAR_FEC_PAGO_IG >= SAR_INCAPACIDADES.SCO_DT_START) and (SAR_FEC_PAGO_IG <= SAR_INCAPACIDADES.SCO_DT_END) then
                Existe_inc = 1
            Else
                Existe_inc = 0
            Endif
        Endif

        If Reg_inc <> -1 Then
            inc_permanente = SAR_INCAPACIDADES.SCO_PERMANENT
            
            if inc_permanente = "1" then
                inc = "N"
            else
                inc = "S"
            endif
        Else
            inc = "N"
        EndIf
    EndIf
    
    '-------------------------------------------------------------------------------------------
    'Se condiciona para controlar la edad en este tipo de parentezcos.
    '11- Nieto, 12 - Bisnieto, 16 - Hermano, 18 - Yerno/Nuera.
    IF (tipo_parent= "11" OR tipo_parent= "12" OR tipo_parent= "16" OR tipo_parent= "18") THEN
        control_edad = 1
    else
        control_edad = 0
    ENDIF
    '------------------------------------------------------------------------------------------- 

    edad = Years(fec_nac,SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC)
    IF (Existe_inc = 1) or (( (edad < SAR_TOPE_EDAD_FAMILIAR OR ((edad < SAR_TOPE_EDAD_FAMILIAR OR (edad = SAR_TOPE_EDAD_FAMILIAR AND (DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG) and (DXMONTH(fec_nac) = DXMONTH(SAR_FEC_PAGO_IG)))))) OR  (inc = "S") OR (control_edad = 0) ) AND ((parent = "3" OR parent = "9")))) THEN
        fecha_alta_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_ALTA_IMP
	  fecha_baja_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_BAJA_IMP
        fecha_ini           = Max(fecha_alta_impuesto,SAR_FEC_INI_IG)

        IF ISNULL(fecha_baja_impuesto)  = M4_TRUE THEN 
            fecha_tope = SAR_FEC_PAGO_IG
	  ELSE
        	fecha_tope = Min(fecha_baja_impuesto,SAR_FEC_PAGO_IG)
        
	  ENDIF

        'Si no posee incapacidad permanente, y es un tipo de parentezco que se debe controlar la edad, verifico los a?os contra el tope de la edad para ganancias.(24 a?os)      
        IF (edad = SAR_TOPE_EDAD_FAMILIAR AND DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG))  AND (Existe_inc <> 1) and (control_edad = 1) and (inc = "N") THEN
            DIAT = DXDAY(fec_nac)
            IF DIAT < 10 then
                DIAT = "0" + TOSTRING(DIAT,0)
            ELSE
                DIAT = TOSTRING(DIAT,0)
            ENDIF
            
            MEST = DXMONTH(fec_nac)
            IF MEST < 10 then
                MEST = "0" + TOSTRING(MEST,0)
            ELSE
                MEST = TOSTRING(MEST,0)
            ENDIF
            
            FECHA      = TOSTRING(DXYEAR(SAR_FEC_PAGO_IG),0) + "/" + MEST + "/" + DIAT
            fecha_tope = TODATE(FECHA)

            IF fecha_tope > fecha_baja_impuesto AND  ISNULL(fecha_baja_impuesto) = FALSE THEN
                fecha_tope = fecha_baja_impuesto 
                IF fecha_baja_impuesto > SAR_FEC_PAGO_IG THEN
                    fecha_tope = SAR_FEC_PAGO_IG
                ENDIF
            ENDIF
        ENDIF
              

        MES = DXMONTH(fecha_ini)
        IF MES < 10 then
            MES = "0" + TOSTRING(MES,0)
        ELSE
            MES = TOSTRING(MES,0)
        ENDIF
        
        FECHA     = TOSTRING(DXYEAR(fecha_ini),0) + "/" + MES + "/" + "25"
        fecha_ini = TODATE(FECHA)
        mini      = DXMONTH(fecha_ini)
        
        WHILE mini <= DXMONTH(fecha_tope) 
            'Toma su valor por valores empresa
            ind  = SAR_IND_DED_IG_2010
            vDia = tostring(DxDay(SAR_FEC_PAGO_IG),0)
            IF mini < 10 then
                mini3 = "0" + TOSTRING(mini,0)
            ELSE
                mini3 = TOSTRING(mini,0)
            ENDIF
            vAnio  = tostring(DxYear(SAR_FEC_PAGO_IG),0)  
            vFecha = DxDate(vDia,mini3,vAnio)
            
            If (vFecha >= SAR_INCAPACIDADES.SCO_DT_START) and (vFecha <= SAR_INCAPACIDADES.SCO_DT_END) then
                Existe_inc = 1
            Else
                Existe_inc = 0
            Endif

                      
            IF ((Existe_inc = 1 or edad < SAR_TOPE_EDAD_FAMILIAR or(edad = SAR_TOPE_EDAD_FAMILIAR AND DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG) and DXMONTH(fec_nac) >= mini))) and (tipo_parent = "11" OR tipo_parent = "12" OR tipo_parent = "16" OR tipo_parent = "18" or tipo_parent = "2" Or tipo_parent = "5" Or tipo_parent = "13" Or tipo_parent = "14" Or tipo_parent = "15" Or tipo_parent = "17") THEN
                
                'Cambio Ganancias Res.3770/2015
                '--------------------------------------------------------------------------------------------------------------------------------
                'El concepto v57 recibe la empresa con la que buscara la informacion en la tabla de valor empresa segun el rango correspondiente.
                '--------------------------------------------------------------------------------------------------------------------------------                                   
                precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SAR_LEG_TABLA_IG,"SAR_VAL_OTRAS_IMP",fecha,ind))
          
                importe = importe + precio
            Endif
            If isNull(importe) = M4_TRUE Then
                importe = 0
            Endif
           	mini    = mini + 1
            mini2   = mini
                       
            IF mini < 10 then
                mini2 = "0" + TOSTRING(mini,0)
            ELSE
                mini2 = TOSTRING(mini,0)
            ENDIF
                
            fecha = TOSTRING(DXYEAR(fecha_ini),0) + "/" + mini2 + "/" + "25"
        WEND
    ELSE
        fecha_alta_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_ALTA_IMP
        fecha_baja_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_BAJA_IMP
        fecha_ini           = Max(fecha_alta_impuesto,SAR_FEC_INI_IG)
        MES                 = DXMONTH(fecha_ini)
        
        IF MES < 10 then
            MES = "0" + TOSTRING(MES,0)
        ELSE
            MES = TOSTRING(MES,0)
        ENDIF
        
        FECHA      = TOSTRING(DXYEAR(fecha_ini),0) + "/" + MES + "/" + "25"
        fecha_ini  = TODATE(FECHA)
        mini       = DXMONTH(fecha_ini)
        fecha_aniv = fec_nac 
           
        control = 0
        fecha_tope = fecha_aniv   
   
        IF (ISNULL(fecha_baja_impuesto) = FALSE) THEN
            if ( DXYEAR(fecha_baja_impuesto) = DXYEAR(fecha_ini) ) THEN
                fecha_tope = fecha_baja_impuesto
                control = 1 
                IF fecha_baja_impuesto > SAR_FEC_PAGO_IG THEN
                    fecha_tope = SAR_FEC_PAGO_IG
                ENDIF
            else
                fecha_tope = fecha_aniv
                control = 0
            endif             
        ENDIF   

        IF (parent = "3" OR parent = "9") AND ((((edad = SAR_TOPE_EDAD_FAMILIAR AND (DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG) ))) AND (control_edad = 1)) OR (control = 1)  )THEN

            WHILE mini<= DXMONTH(fecha_tope) 
                'Cambio Ganancias Res.3770/2015
                '--------------------------------------------------------------------------------------------------------------------------------
                'El concepto v57 recibe la empresa con la que buscara la informacion en la tabla de valor empresa segun el rango correspondiente.
                '-------------------------------------------------------------------------------------------------------------------------------- 
                
                ind = SAR_IND_DED_IG_2010            
                precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SAR_LEG_TABLA_IG,"SAR_VAL_OTRAS_IMP",fecha,ind))
                
                
                importe = importe + precio
                mini    = mini + 1
                mini2   = mini

                IF mini < 10 then
                    mini2 = "0" + TOSTRING(mini,0)
                ELSE
                    mini2 = TOSTRING(mini,0)
                ENDIF
            
                fecha     = TOSTRING(DXYEAR(fecha_ini),0) + "/" + mini2 + "/" + "25"
                fecha_ini = TODATE(fecha)

            WEND
        ENDIF        
    ENDIF
    endif
NEXT
    
'Se redondea el importe antes de su devolucion
RETURN(Round(importe,2))
