IF SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF
'
'Se calculan los aportes y  contribuciones con cargo al dependiente, emergentes de  la diferencia entre la 
'remuneracion  efectivamente percibida por el trabajador contratado a tiempo parcial y la equivalente a 3 
'MOPRES, a los efectos de acceder una cobertura medico asistencial (Art.8? Decreto N? 492/95) 
'En el caso de que el empleado opte por no tener cobertura medica, habra que cargarle por valores fase 
'de alta el valor 0 con prioridad 0.
'
valor = 0
aux = SAR_ID_CONTRATO

IF (aux = "1" OR aux = "21" ) AND SAR_P_SUELDO < (SAR_TOPE_COTIZ / 20)  THEN
    importeliq = (SAR_OBRA_SOCIAL + SAR_ADIC_OB_SOCIAL + SAR_OBRA_SOCIAL_SAC + SAR_OBRA_SOCIAL_VAC + SAR_OB_SOC_ADIC_SAC + SAR_OB_SOC_ADIC_VAC + SAR_LEY_23660_PAT + SAR_SAC_23660_PAT + SAR_VAC_23660_PAT + SAR_PAT_23660_ART) 
    porc = (SAR_P_PAT_L_23660 + SAR_PORC_OBR_SOCIAL + (SAR_FAM_CARGO_OS * SAR_PORC_ADIC_O_SOC)) / 100
    importemin = SAR_TOPE_COTIZ / 20 * porc
valor=importemin - importeliq
ENDIF
RETURN(valor)
