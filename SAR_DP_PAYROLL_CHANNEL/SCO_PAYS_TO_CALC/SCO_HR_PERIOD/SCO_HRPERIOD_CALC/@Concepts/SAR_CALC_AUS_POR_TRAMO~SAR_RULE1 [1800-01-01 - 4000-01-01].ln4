'Calcula las ausencias diarias u horarias (segun un argumento recibido) comprendidas entre 
'las fechas de inicio y fin del tramo. Estas fechas son pasadas por argumentos
fec_ini                 = ARG_INICIO_TRAMO
fec_fin                 = ARG_FIN_TRAMO
FIN_TRAMO               = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysEndDate
ausencias               = 0
exc_dias_mat_mes_ant    = 0

IF ARG_TIPO_AUSENCIA = "DIA" THEN

    'Ahora contabilizamos las ausencias diarias que se cargan a nivel de period
    primerreg = 0
    ultimoreg = SAR_REAL_TIME_PERIOD.COUNT() - 1
    
    FOR I = primerreg  TO  ultimoreg 
    
        SAR_REAL_TIME_PERIOD.MOVETO(I)
        motivoabs   = FORMAT(SAR_REAL_TIME_PERIOD.SCO_ID_INCIDENCE,0)
        fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
        fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END
        t_unid      = SAR_REAL_TIME_PERIOD.SCO_ID_TIME_UNIT
        unid        = SAR_REAL_TIME_PERIOD.SCO_UNITS
        excedencia = 0
        
        'Contabilizo la cantidad de dias y si el tipo de salario es Horario, traspaso las unidades a horas
        IF SAR_TIPO_SALARIO <> "003" THEN    'no es horario
        
        If DxMonth(FIN_TRAMO) = 2 THEN
    	   IF fec_fin_abs >= FIN_TRAMO And DxDay(FIN_TRAMO) = 28 THEN
    	       excedencia = excedencia + 2
    	   ELSEIF fec_fin_abs >= FIN_TRAMO And DxDay(FIN_TRAMO) = 29 THEN
    	       excedencia = excedencia + 1
    	   Endif
        Endif

            
            
            IF motivoabs = "1" THEN
                If fec_fin_abs >= fec_fin and DXDAY(fec_fin) > 30 then fec_fin = fec_fin - 1
                ausencias = ausencias + CommonTime(fec_ini, fec_fin, fec_ini_abs, fec_fin_abs) + excedencia 
            ELSEIF motivoabs = "23" THEN
                If fec_fin_abs >= fec_fin and DXDAY(fec_fin) > 30 then fec_fin = fec_fin - 1
                ausencias = ausencias + CommonTime(fec_ini, fec_fin, fec_ini_abs, fec_fin_abs) + excedencia 
            ELSEIF motivoabs = "4" THEN
                ausencias = ausencias + CommonTime(fec_ini, fec_fin, fec_ini_abs, fec_fin_abs) + excedencia 
            ELSEIF motivoabs = "10" THEN
                ausencias = ausencias + CommonTime(fec_ini, fec_fin, fec_ini_abs, fec_fin_abs) + excedencia
            ELSEIF motivoabs = "11" THEN
                ausencias = ausencias + CommonTime(fec_ini, fec_fin, fec_ini_abs, fec_fin_abs) + excedencia
            ELSEIF motivoabs = "12" THEN
                ausencias = ausencias + CommonTime(fec_ini, fec_fin, fec_ini_abs, fec_fin_abs) + excedencia
            ELSEIF motivoabs = "13" THEN
                ausencias = ausencias + CommonTime(fec_ini, fec_fin, fec_ini_abs, fec_fin_abs) + excedencia
            ELSEIF motivoabs = "17" THEN
                ausencias = ausencias + CommonTime(fec_ini, fec_fin, fec_ini_abs, fec_fin_abs) + excedencia
            ENDIF      
        ELSE 'tipo salario horario
            IF SCO_NUM_HOURS_THEO > 0 THEN
                IF fec_fin_abs > fec_fin then
                    fec_fin_abs = fec_fin
                ENDIF
                
                IF fec_ini_abs < fec_ini then
                    fec_ini_abs = fec_ini
                ENDIF
            ENDIF
            
            IF motivoabs = "1" THEN
                IF t_unid = "05" THEN 
                    ausencias = ausencias + Min(unid,SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs))
                ELSE
                    ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs)
                ENDIF
            ELSEIF motivoabs = "23" THEN
                IF t_unid = "05" THEN 
                    ausencias = ausencias + Min(unid,SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs))
                ELSE
                    ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs)
                ENDIF                
            ELSEIF motivoabs = "4" THEN
                ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs)
            ELSEIF motivoabs = "10" THEN
                ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs)
            ELSEIF motivoabs = "11" THEN
                ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs)
            ELSEIF motivoabs = "12" THEN
                ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs)
            ELSEIF motivoabs = "13" THEN
                ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs)
            ELSEIF motivoabs = "17" THEN
                ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_abs, fec_fin_abs)
            ENDIF
        ENDIF
    NEXT  
    
    'Resto los dias de accidente
    primerreg = 0
    ultimoreg = SAR_ACCID_ACT.COUNT() - 1
    
    FOR I = primerreg TO ultimoreg          'DESDE I
        SAR_ACCID_ACT.MOVETO(I)
        fec_ini_acc = SAR_ACCID_ACT.SAR_DT_START
        fec_fin_acc = SAR_ACCID_ACT.SAR_DT_END
        
        IF SAR_TIPO_SALARIO <> "003" THEN    'no es horario
            ausencias = ausencias + CommonTime(fec_ini , fec_fin , fec_ini_acc , fec_fin_acc)
        ELSE
            IF SCO_NUM_HOURS_THEO > 0 THEN
                IF fec_fin_acc > fec_fin then
                    fec_fin_acc = fec_fin
                ENDIF
                
                IF fec_ini_acc < fec_ini then
                    fec_ini_acc = fec_ini
                ENDIF
                
                ausencias = ausencias + SAR_CALC_HORAS_TEORICAS(fec_ini_acc, fec_fin_acc)
            ELSE
                ausencias = ausencias + CommonTime(fec_ini , fec_fin , fec_ini_acc , fec_fin_acc) * SAR_HS_DIARIAS_PROM 
            ENDIF
        ENDIF     
    NEXT
ENDIF

dias_tramo_real = ARG_FIN_TRAMO - ARG_INICIO_TRAMO + 1

IF ausencias > 0 THEN
    IF SAR_TIPO_SALARIO = "001" THEN 'es mensual
        maxdias_ausencias = ARG_DIAS       
    ELSE
        IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario horario
            IF SCO_NUM_HOURS_THEO > 0 THEN
                maxdias_ausencias = SAR_CALC_HORAS_TEORICAS(ARG_INICIO_TRAMO,ARG_FIN_TRAMO)
            ELSE
                maxdias_ausencias = dias_tramo_real * SAR_HS_DIARIAS_PROM 
            ENDIF
        ELSE
            maxdias_ausencias = dias_tramo_real
        ENDIF
    ENDIF
    
    ausencias = Min(ausencias, maxdias_ausencias)
    ausencias = Max(ausencias, 0)
Else
    ausencias = 0
ENDIF

Return(ausencias)
