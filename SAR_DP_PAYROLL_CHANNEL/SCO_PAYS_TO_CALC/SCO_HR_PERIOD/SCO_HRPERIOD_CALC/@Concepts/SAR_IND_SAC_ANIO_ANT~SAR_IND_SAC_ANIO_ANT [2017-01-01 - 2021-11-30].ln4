'Control retroactividad a?os anteriores: se ajusta siempre para que entre directamente al impuesto en la siguiente paga normal
'En baja no vamos a hacer el ajuste en la paga normal siguiente
If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then Return(0)
valor = 0
sac_abonado = SAR_SAC_ABONADO
If SCO_DT_PAYMENT <> SCO_DT_ALLOCATION And DxYear(SAR_FEC_IMPUT_IG) < DxYear(SAR_FEC_PAGO_IG) And sac_abonado <> 0 Then valor = 1
Return(valor)
