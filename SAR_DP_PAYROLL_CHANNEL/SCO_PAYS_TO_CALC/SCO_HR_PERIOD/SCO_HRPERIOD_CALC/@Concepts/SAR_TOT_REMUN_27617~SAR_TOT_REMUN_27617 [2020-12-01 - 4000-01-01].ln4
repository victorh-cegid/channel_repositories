'Ley 27617. Este concepto contiene el importe mensual IG de la remuneración.
'Consideramos los importes de todas las pagas del mes:
importePaga = SAR_TOTAL_DEVENGOS + SAR_TOT_REMUN_27617_OE - SAR_SAC_ABONADO - SAR_ANTICIPO_VAC
ImporteAcum = SAR_ACM_MESACT_IMPIG[0].SAR_TOTAL_DEVENGOS - SAR_ACM_MESACT_IMPIG[0].SAR_SAC_ABONADO - SAR_ACM_MESACT_IMPIG[0].SAR_ANTICIPO_VAC
Return Round(importePaga+ImporteAcum,SAR_NUM_DEC)
