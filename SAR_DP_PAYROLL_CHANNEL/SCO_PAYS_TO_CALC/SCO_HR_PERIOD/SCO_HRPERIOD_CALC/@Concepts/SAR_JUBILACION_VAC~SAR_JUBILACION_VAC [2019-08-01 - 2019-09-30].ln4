'calcula valor si es paga de vacaciones o si es paga normal o segunda quincena de normal, y si el ajuste de vacaciones es distinto de cero
If SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" Then Return(0)
If SAR_TP_IMPUT = "77" And SAR_IND_PAGA_ESP_VAC = 0 Then Return(0)

'Devolucion Art. 4 del Decreto 561/2019 si supera tope
TopeArt4Dec561Aux = SAR_FINAN_APO_JUB_AUX
If TopeArt4Dec561Aux = 4561 Then            ' Devolucion de la financiacion aplicada en pagas anteriores en el mes, en esta paga se superan los 60000 pesos de remuneracion bruta devengada
    DifJubVACMesAct = SAR_ACM_MES_ACTUAL_DIF[0].SAR_FINAN_APO_JUB_VAC_DIF 
    SAR_FINAN_APO_JUB_VAC_DIF = -1 * DifJubVACMesAct                            // Pasamos el importe de la financiacion aplicado anterioremente para descontarselo de nuevo al empleado
EndIf

If (SAR_TP_IMPUT = "1" or SAR_TP_IMPUT = "3" or SAR_TP_IMPUT = "4") And SAR_IND_PAGA_ESP_VAC = 1 Then Return(0)

edad = SAR_EDAD
valor = 0

IF edad >= 18 THEN
    porc = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION*SAR_PP_AP_JUBILA / 100)
    valor = SAR_VAC_IMPO_JUB * porc / 100
ENDIF

IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF

' Apliacion del Art. 4 del Decreto 561/2019: "... se financiara el aporte personal de los trabajadores
' en relacion de dependencia a que se refiere el inciso a) del articulo 10 de la Ley N? 24.241 y sus modificaciones,
' ... durante los meses de agosto y septiembre del a?o 2019, en una suma equivalente a PESOS DOS MIL ($2.000) 
' mensuales o al CIEN POR CIENTO (100%) de su valor, lo que resulte menor."
If TopeArt4Dec561Aux <> 4561 Then
    DiferenciaValores = Min(TopeArt4Dec561Aux, valor)
    DiferenciaValores = Round(DiferenciaValores, SCO_CURR_DECIMALS)
    SAR_FINAN_APO_JUB_VAC_DIF = -1 * DiferenciaValores                          // Pasamos el importe de la financiacion como negativo
    SAR_FINAN_APO_JUB_AUX     = SAR_FINAN_APO_JUB_AUX - DiferenciaValores    
EndIf

Return(valor)
