IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

base=SAR_PAGA_EXTRA_1 + SAR_PAGA_EXTRA_2 

'------------------------

'Por modificacion del empleado se agrega: And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017"  
IF SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017"  THEN 
base = SAR_EGRESO_PAGA_1 + SAR_EGRESO_PAGA_2 
ENDIF 
'------------------------

valor = base * SAR_PORC_C_SIND_OBL / 100
RETURN(valor)
