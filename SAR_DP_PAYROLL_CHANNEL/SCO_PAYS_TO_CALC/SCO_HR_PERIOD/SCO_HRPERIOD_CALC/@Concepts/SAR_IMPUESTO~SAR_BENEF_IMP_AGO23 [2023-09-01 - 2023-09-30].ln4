'En septiembre se expone la cuota calculada en agosto, no se altera el impuesto porque esté ya ajusta el importe considerando el aplicado (superior) en el mes anterior y ajustando al importe final que corresponde.
importe = SAR_IMPUESTO
If SAR_TP_IMPUT = "88" Then return(importe)
'Retro a SEPTIEMBRE no debe generar diferencias
If SCO_DT_PAYMENT<>SCO_DT_ALLOCATION Then 
    SAR_AGO23_BENEF_IMP = SCO_AC_HR_PERIOD_REV_1.SAR_AGO23_BENEF_IMP
    Return Round(importe,SAR_NUM_DEC)
EndIf

benefAgo = SAR_ACM_ULT_MES[0].SAR_AGO23_BENEF_IMP
benefSep = SAR_ACM_MES_ACTUAL_DIF[0].SAR_AGO23_BENEF_IMP

If benefAgo < 0 And benefSep = 0 Then SAR_AGO23_BENEF_IMP = benefAgo

Return Round(importe,SAR_NUM_DEC)
