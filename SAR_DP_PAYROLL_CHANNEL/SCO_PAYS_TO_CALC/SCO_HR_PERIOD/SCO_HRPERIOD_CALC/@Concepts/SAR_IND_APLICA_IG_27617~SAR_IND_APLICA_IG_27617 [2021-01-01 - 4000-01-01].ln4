''Indicador de aplicación ley 27617 piso salarial, se realiza aquí el cálculo, también permite ser informado por tabla de valor.
''0 - No aplica
''1 - Aplica exención completa del impuesto
''2 - Aplica exención parcial del impuesto
''3 - Alcanzado sólo para deducción de bonos de productividad
'
'If SAR_PISO_IG_27617 = 0 Then Return(0)
'
'indicador = 0
'remunEmpresa = SAR_TOT_REMUN_27617
'remunOE_AE = SAR_TOT_REMUN_27617_OE
'
''Control paga extra SAC separada de paga normal, al momento de calcularla no tenemos el importe de salario del mes, tomaremos el de la paga anterior
'If SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1 Then
'    remunEmpresaMesAnt = SAR_ACM_PAGA_ANT_IG[0].SAR_TOT_REMUN_27617
'    remunOE_AE_Mes_Ant = SAR_ACM_PAGA_ANT_IG[0].SAR_TOT_REMUN_27617_OE
'    If remunEmpresaMesAnt + remunOE_AE_Mes_Ant <= SAR_PISO_IG_27617 Then 
'        indicador = 1
'    ElseIf remunEmpresaMesAnt + remunOE_AE_Mes_Ant <= SAR_PISO_IG_27617_R2 Then 
'        indicador = 2
'    ElseIf remunEmpresaMesAnt + remunOE_AE_Mes_Ant <= SAR_PISO_BONOS_27617 Then 
'        indicador = 3
'    EndIf
''Resto de pagas
'ElseIf remunEmpresa + remunOE_AE <= SAR_PISO_IG_27617 Then 
'    indicador = 1
'ElseIf remunEmpresa + remunOE_AE <= SAR_PISO_IG_27617_R2 Then
'    indicador = 2
'ElseIf remunEmpresa + remunOE_AE <= SAR_PISO_BONOS_27617 Then
'    indicador = 3
'EndIf
'
'Return(indicador)
