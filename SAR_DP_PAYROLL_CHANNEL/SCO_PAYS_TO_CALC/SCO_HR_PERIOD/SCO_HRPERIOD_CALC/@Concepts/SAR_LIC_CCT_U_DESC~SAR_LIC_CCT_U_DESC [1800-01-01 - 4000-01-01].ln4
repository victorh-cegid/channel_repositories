'Toma las horas de la incidencia 14, agrega las de la incidencia 15 si las hubiera
'Solo en pagas normal (mensual) primera y segunda quincena
If SAR_TP_IMPUT <> "1" And SAR_TP_IMPUT <> "3" And SAR_TP_IMPUT <> "4" Then Return(0)

id_Incidencia = "15" 'Lic. Gremial CCT solo descuento
'Arrastra las horas de la licencia 14 + las propias de la licencia 15
horas = SAR_LIC_CCT_U_PAGO		  

'Cargamos el nodo de incidencias del periodo, en caso de que no esté ya cargado.
If SAR_REAL_TIME_PERIOD.COUNT()= 0 Then SAR_REAL_TIME_PERIOD.LOAD_BLK()

'Añadimos filtro RAM al nodo cargado para quedarnos exclusivamente con los registros de la licencia
sFilter = "If SCO_ID_INCIDENCE = ARG_SCO_ID_INCIDENCE Then Return(M4_TRUE) Else Return(M4_FALSE)"
SAR_REAL_TIME_PERIOD.ADDFILTER(sFilter, M4_TRUE, "ARG_SCO_ID_INCIDENCE", id_Incidencia)

'Si hay registros los recorremos para obtener las horas
SAR_REAL_TIME_PERIOD.BEGIN()
While SAR_REAL_TIME_PERIOD.ISEOF() = FALSE
    t_unid = SAR_REAL_TIME_PERIOD.SCO_ID_TIME_UNIT 	' tipo de unidades del ausentismo, Horas o Días
    unid = SAR_REAL_TIME_PERIOD.SCO_UNITS 		' número de unidades del ausentismo
    If t_unid = "05" Then horas = horas + unid
    SAR_REAL_TIME_PERIOD.GONEXT()
Wend

'Se elimina el filtro RAM aplicado al nodo
SAR_REAL_TIME_PERIOD.REMOVEFILTER()

Return(horas)
