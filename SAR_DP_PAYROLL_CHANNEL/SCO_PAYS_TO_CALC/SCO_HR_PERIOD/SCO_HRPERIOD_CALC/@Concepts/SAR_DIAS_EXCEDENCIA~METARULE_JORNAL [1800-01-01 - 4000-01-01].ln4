IF SAR_TIPO_SALARIO = "003" THEN 'tipo de salario horario
    x = SAR_DIAS_EXCEDENCIA()..SAR_RULE1_JORNAL
ELSE
    'A partir del uso del indicativo tipo fecha de Anses, se debe revisar si las incidencias de maternidad comienzan antes o despues
    'de esta fecha, para saber que regla va a ejecutar.
    primerreg = 0
    ultimoreg = SAR_REAL_TIME_PERIOD.COUNT() - 1
    
    FOR I = primerreg TO ultimoreg 
        SAR_REAL_TIME_PERIOD.MOVETO(I)
        motivoabs   = FORMAT(SAR_REAL_TIME_PERIOD.SCO_ID_INCIDENCE, 0)
        fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
        
        IF motivoabs = "6" THEN
            If SAR_FEC_MAT_ANSES >= fec_ini_abs or IsNull(SAR_FEC_MAT_ANSES) = M4_TRUE Then
                x = SAR_DIAS_EXCEDENCIA()..SAR_RULE1
            else
                x = SAR_DIAS_EXCEDENCIA()..SAR_RULE2
            Endif
        ENDIF
    NEXT
ENDIF

if SCO_PAYS_TO_CALC.SCO_REVISION = 1 then
    x = SAR_DIAS_EXCEDENCIA()..SAR_DIAS_EXCEDENCIA_REV
endif

Return(x)
