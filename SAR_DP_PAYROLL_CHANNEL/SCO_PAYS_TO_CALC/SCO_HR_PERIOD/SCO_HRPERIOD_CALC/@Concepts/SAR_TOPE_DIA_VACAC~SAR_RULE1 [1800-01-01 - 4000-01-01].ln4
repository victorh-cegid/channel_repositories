dias= SAR_UN_VACACIONES
devengado=SAR_VAC_DEV_SAC
IF dias=0 AND devengado= 0 THEN RETURN(0)
IF dias = 0 AND devengado > 0 THEN
SAR_ACM_ULT_PAGO_IMPUT.BEGIN()
valor=SAR_ACM_ULT_PAGO_IMPUT.SAR_TOPE_DIA_VACAC
ELSE
    IF dias = 0 THEN
        valor=0
    ELSE
        valor=SAR_VAC_IMPO/dias
    ENDIF

ENDIF
RETURN(valor)
