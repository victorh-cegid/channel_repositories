base_tot = 0
mes      = DxMonth(SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC)
intvalor = 0

SCO_AC_HR_PERIOD_READ_1.BEGIN()

If SCO_AC_HR_PERIOD_READ_1.Count() > 0 Then            
    vFechaIni = DxDate("01",DxMonth(SCO_DT_ALLOCATION),DxYear(SCO_DT_ALLOCATION))
    vfechaFin = SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC

    For a = 0 To SCO_AC_HR_PERIOD_READ_1.Count() - 1
        SCO_AC_HR_PERIOD_READ_1.MoveTo(a) 
        'If SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= vFechaIni And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= vFechaFin And (SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_PAYM <> "88" And SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_PAYM <> "99") Then
        If SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION < SCO_DT_ALLOCATION And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= vFechaIni And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= vFechaFin And (SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_PAYM <> "88" And SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_PAYM <> "99") Then

            intValor = intValor + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_P_SAC..sysTotalSlices(M4_TOTAL_SUM)
        EndIf
    Next
EndIf


IF SAR_TIPO_SALARIO = "001" THEN

    If SCO_DT_ALLOCATION = SCO_DT_PAYMENT Then
        'Mensuales  // Sumamos el valor de la paga liquidada + todas las pagas del mes que se esta liquidando.
        base_tot = SAR_TOTAL_P_SAC + intValor
    Else
        'Pagas Retro: Se retorna el valor de la paga actual nada mas.
        base_tot = SAR_TOTAL_P_SAC
    Endif
    
ELSEIF SAR_TP_IMPUT = "3" and (mes = 1 Or SAR_ES_ALTA = 1) THEN
    base_tot = SAR_TOTAL_P_SAC
ELSEIF SAR_TP_IMPUT = "3" and mes <> 1 and SAR_ES_ALTA <> 1 THEN
    'Segunda Quincena
    SAR_ACM_2QNA_MES_ANT.BEGIN()
    IF SAR_ACM_2QNA_MES_ANT.COUNT() > 0 THEN
        base_tot = SAR_ACM_2QNA_MES_ANT.SAR_M_REMUN_INDEM 
    ENDIF

ELSEIF SAR_TP_IMPUT = "4" THEN
    'Primera Quincena
    base = SAR_TOTAL_P_SAC
    base_tot = base + intValor 

Endif

Return(base_tot)
