If #SAR_TP_IMPUT = "88" OR #SAR_TP_IMPUT = "99" Then Return(0)
IF #SAR_TP_IMPUT <> "1" AND #SAR_TP_IMPUT <> "4" THEN Return(0)'Tipo mensual y quincenal
If SCO_DT_ALLOCATION > #SAR_FECHA_BAJA and #SAR_ES_BAJA <> 1 Then RETURN(0) 'Condicion para que no se pague el concepto en nomina despues de la baja.

IF #SAR_VAL_TICKET_ALIM = 0 THEN
    valor=0
ELSE
    valor = (#SAR_PAGA_EXTRA_1 + #SAR_PAGA_EXTRA_2 + #SAR_EGRESO_PAGA_1 + #SAR_EGRESO_PAGA_2 + #SAR_VACACIONES + #SAR_TOT_DEV_COTIZ + #SAR_PRESTACION_ART) * #SAR_VAL_TICKET_ALIM / 100
ENDIF
IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF
RETURN(valor)
