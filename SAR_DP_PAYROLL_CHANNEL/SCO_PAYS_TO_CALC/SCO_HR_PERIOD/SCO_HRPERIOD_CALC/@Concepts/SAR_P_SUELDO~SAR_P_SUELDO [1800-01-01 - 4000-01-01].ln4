'Si se carga el sueldo a nivel Period y Role se le dara prioridad al Role

'Guardamos en una propiedad a nivel de Period el valor del sueldo por Rol,
'mientras revisamos si tiene el sueldo asignado por Rol o por Period.


'inicio = SAR_SLICE_UNIT..SysStartDate
'fin = SAR_SLICE_UNIT..SysEndDate


rol = SAR_HRROLE_CALC.SAR_P_SAL_BASE


IF SAR_HRROLE_CALC.SAR_P_SAL_BASE > 0 THEN
   SAR_HR_PERIOD.SAR_VALOR_SUELDO = SAR_HR_PERIOD.SAR_VALOR_SUELDO + SAR_HRROLE_CALC.SAR_P_SAL_BASE

ENDIF

coef = SAR_HRROLE_CALC.SAR_COEF_JORNADA


IF SAR_HR_PERIOD.SAR_VALOR_SUELDO > 0 THEN   'Devuelve el sueldo por Rol
      'Se agrega el calculo del Coeficiente por Jornada Reducida(#675)
      Return(SAR_HR_PERIOD.SAR_VALOR_SUELDO * coef)
ElSE
   'Se agrega el calculo del Coeficiente por Jornada Reducida(#675)
   Return(SAR_P_SUELDO * coef)   'Devuelve el sueldo por Period
ENDIF
