tope_min = (SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO)
prest_no = SAR_PREST_SUSP_ART_223BIS

If SAR_COEF_JORNADA_PER <> 0 Then prest_no = prest_no / SAR_COEF_JORNADA_PER

real     = SAR_LSD_TOT_COTIZ_OS + prest_no
d_cot = SAR_DIAS_NORM_COTIZ

If (SAR_ID_MOD_CONTRAT = "27" And SAR_ASIGNACION_ESTIMULO > 0) Then 'Si SAR_ID_MOD_CONTRAT = "27" entonces...sumamos el estimulo del pasante
    real = real + SAR_ASIGNACION_ESTIMULO
ElseIf (SAR_ID_MOD_CONTRAT = "10" And SAR_ASIGNACION_ESTIMULO > 0) Then
    base = 0
    Return(base)
EndIf

base = Max(real,0)

dias_trabajados = SAR_TIEMPO_EFVO_TR

IF SAR_TIPO_SALARIO = "003" AND SAR_TP_IMPUT = "3" THEN
    tope_min = Round(tope_min/2,0)
    d_cot = d_cot/2    
ENDIF

'Frecuencia de pago mensual
If SCO_PAY_FREQ_ALLOC = "004" Then 
    If SAR_DIAS_NORM_COTIZ = 0 THEN
        base_min = 0
    Else
        tope_min = (tope_min / 30 * (dias_trabajados - SAR_DIAS_MATERN - SAR_LIC_ONCO_DIAS) ) - SAR_BASE_CO_ART_CNT_OS
        base_min = tope_min / SAR_DIAS_NORM_COTIZ * (SAR_DIAS_NORM_COTIZ - SAR_DIAS_VACACIONES )
        Base     = Max(base_min,base)
    EndIf

Else 'Quincenales
     SAR_ACM_ACT_CONTRIB.BEGIN()
     'Resto al tope_min lo acumulado en la primer quincena
     vac_periodo = SAR_ACM_ACT_CONTRIB.SAR_DIAS_VACACIONES + SAR_DIAS_VACACIONES
     art_periodo = SAR_ACM_ACT_CONTRIB.SAR_DIAS_ART + SAR_DIAS_ART
     tope        = (SAR_TOPE_COTIZ - SAR_BASE_COTIZ_ART_OS) / d_cot *(d_cot  - vac_periodo )
     tope        = tope - SAR_ACM_ACT_CONTRIB.SAR_REMUN_IMPO_OS - SAR_ACM_ACT_CONTRIB.SAR_BASE_COTIZ_ART_OS

EndIf

Return(base)
