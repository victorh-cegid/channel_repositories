IF SAR_TP_IMPUT <> "88" THEN Return(0)

IF SAR_VACACIONES.COUNT() = 0 THEN Return(0)

IF SAR_IND_PAGA_ESP_VAC = 1 THEN Return(0)

fec_ini = SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC
fec_fin = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC
aux     = SAR_CARGA_AUSENTISM
aux     = SAR_IMPORTE_LICENCIAS
tope    = SAR_UN_VACACIONES * (SAR_TOPE_COTIZ / 30)
valor   = SAR_PRE_VACACIONES * SAR_UN_VACACIONES 
base    = MIN(valor, tope)
desc    = (SAR_PORC_JUBILACION * base + SAR_PORC_LEY_19032 * base + SAR_PORC_OBR_SOCIAL * base + SAR_PORC_ADIC_O_SOC * base * SAR_FAM_CARGO_OS) / 100
valor   = valor - desc 
valor   = ROUND(valor * SAR_IND_ANT_VAC, SAR_NUM_DEC)

Return(valor)
