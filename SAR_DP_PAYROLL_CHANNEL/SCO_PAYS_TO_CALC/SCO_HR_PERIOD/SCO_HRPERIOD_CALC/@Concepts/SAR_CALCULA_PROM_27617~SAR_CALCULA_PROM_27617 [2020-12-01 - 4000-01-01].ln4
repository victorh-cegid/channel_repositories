'Concepto para calcular los promedios a los que hace referencia la ley 27617 rg 5008 y rg 5076
'Recibe 3 parámetros por valor de tipo numérico:

'ARG_ORIENTACION: 1 Por devengado / 2 Por imputación IG / 3 Por pago IG
'ARG_MES_INI: Mes inicial a considerar en el promedio
'ARG_MES_FIN: Mes final a considerar en el promedio

'Retorna 1 parámetro tipo moneda por referencia con el importe del promedio:

'IMP_PROMEDIO

orientacion = ARG_ORIENTACION
mes_ini = ARG_MES_INI
mes_fin = ARG_MES_FIN
IMP_PROMEDIO = 0
promedio = 0

FecImputacion = SCO_DT_ALLOCATION
FecImputac_IG = SAR_FEC_IMPUT_IG

If orientacion = 1 Then 
    importe_emp_actual = SAR_REM_27617_DEI_DEV
    fec_orientacion = FecImputacion
ElseIf orientacion = 2 Then
    importe_emp_actual = SAR_TOT_REMUN_27617
    fec_orientacion = FecImputac_IG 
Else
    importe_emp_actual = SAR_REM_27617_DEI_PERC
    fec_orientacion = FecImputac_IG 
EndIf

Mes_orientacion = DxMonth(fec_orientacion)
AnioOrientacion = DxYear(fec_orientacion)

'Si la paga no está en el rango no debe considerarse
If Mes_orientacion < mes_ini Or Mes_orientacion > mes_fin Then importe_emp_actual = 0

corte_mes = mes_ini - 1

divisor_prom = Mes_orientacion - corte_mes

'Contempla retroactividad en modalidad por percibido para devolver a los conceptos de remuneración por percibido el importe de la paga original excepto complementos
propio_mes = 0
If SCO_DT_PAYMENT<>SCO_DT_ALLOCATION And orientacion = 3 And mes_ini = mes_fin Then 
    propio_mes = 1
    importe_emp_actual = 0
EndIf

'Situación especial segundo periodo fiscal de 2023, diferidos no debe levantar acumulado de septiembre
mes_imp_ig = SAR_DIFERIDO_SEPT_2023[0].SAR_MES_IMPUT_IG
excluyeSept = 0
If mes_imp_ig = 10 And DxYear(SAR_FEC_IMPUT_IG) = 2023 And SCO_DT_ALLOCATION>=DxDate(1,10,2023) And mes_ini = 10 Then
    excluyeSept = 1
EndIf


'*****************************************************************************************************************************************************************
'******************** Calculo del divisor a aplicar para el cálculo del promedio 
'*****************************************************************************************************************************************************************
If divisor_prom > 1 Or propio_mes = 1 Then

    
    If propio_mes = 0 Then
        If mes_fin >= DxMonth(fec_orientacion) Then mes_fin = Min (mes_fin, DxMonth(fec_orientacion) - 1) 'Para no traer acumulados del mes en que nos encontramos
        
        divisor_prom = 0
        
        'Contempla el mes de proceso en el divisor
        If importe_emp_actual > 0 Then divisor_prom = 1
    EndIf
    
    'Evaluamos por mes
    For mes = mes_ini To mes_fin
        devengos_mes = 0
        oe_mes = 0
        oe_acum = 0
        
        ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
        
        'Obtiene el acumulado de lo que se considera retribución (devengos - sac abonado)
        For acum = 0 To ult_reg - 1
        
            mes_ini_ori = DxDate(1,           mes, AnioOrientacion)
            ult_dia_mes = DaysOfMonth(mes_ini_ori)
            
            mes_fin_ori  = DxDate(ult_dia_mes, mes, AnioOrientacion)
            If propio_mes = 1 Then mes_fin_ori = fec_orientacion
                
            If orientacion = 1 Then
                FecImputa_READ = SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION
                If FecImputa_READ >= mes_ini_ori And FecImputa_READ <= mes_fin_ori And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT <> "88" Then
                    devengos_mes = devengos_mes + (SCO_AC_HR_PERIOD_READ_1[acum].SAR_TOTAL_DEVENGOS - SCO_AC_HR_PERIOD_READ_1[acum].SAR_SAC_ABONADO - SCO_AC_HR_PERIOD_READ_1[acum].SAR_ANTICIPO_VAC)
                EndIf
            ElseIf orientacion = 2 Then
                FecPagoIG_READ = SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG
                If FecPagoIG_READ >= mes_ini_ori And FecPagoIG_READ <= mes_fin_ori And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT <> "88" Then
                    devengos_mes = devengos_mes + (SCO_AC_HR_PERIOD_READ_1[acum].SAR_TOTAL_DEVENGOS - SCO_AC_HR_PERIOD_READ_1[acum].SAR_SAC_ABONADO - SCO_AC_HR_PERIOD_READ_1[acum].SAR_ANTICIPO_VAC)
                EndIf
            Else
                FecPagoIG_READ = SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_PAGO_IG
                
                'Situación especial segundo periodo fiscal de 2023, diferidos no debe levantar acumulado de septiembre
                If excluyeSept = 0 Then
                    If FecPagoIG_READ >= mes_ini_ori And FecPagoIG_READ <= mes_fin_ori And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT <> "88" Then
                        devengos_mes = devengos_mes + (SCO_AC_HR_PERIOD_READ_1[acum].SAR_TOTAL_DEVENGOS - SCO_AC_HR_PERIOD_READ_1[acum].SAR_SAC_ABONADO - SCO_AC_HR_PERIOD_READ_1[acum].SAR_ANTICIPO_VAC)
                    EndIf
                Else
                    If FecPagoIG_READ >= mes_ini_ori And FecPagoIG_READ <= mes_fin_ori And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT <> "88" Then
                        If DxYear(SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_IMPUT_IG) = 2023 And DxMonth(SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT) = 9 And DxMonth(SCO_AC_HR_PERIOD_READ_1[acum].SAR_FEC_PAGO_IG) = 10 Then
                            devengos_mes = devengos_mes
                        Else
                            devengos_mes = devengos_mes + (SCO_AC_HR_PERIOD_READ_1[acum].SAR_TOTAL_DEVENGOS - SCO_AC_HR_PERIOD_READ_1[acum].SAR_SAC_ABONADO - SCO_AC_HR_PERIOD_READ_1[acum].SAR_ANTICIPO_VAC)
                        EndIf
                    EndIf
                EndIf
            EndIf
        Next
                
        ult_reg = SAR_H_COMPLEM_GCIAS.Count()
        
        'Obtiene de Complementos los importes de AE y OE calculados en el mes evaluado
        For acum = 0 To ult_reg - 1                
        
            IniComple = SAR_H_COMPLEM_GCIAS[acum].SAR_DT_START
            YIniCompl = DxYear(IniComple)
            YImputaci = Dxyear(FecImputac_IG)
            
            mes_ini_imp  = DxDate(1,           mes, YImputaci)
            ult_dia_mes = DaysOfMonth(mes_ini_imp)
            
            mes_fin_imp  = DxDate(ult_dia_mes, mes, YImputaci)
            
            FinComple = SAR_H_COMPLEM_GCIAS[acum].SAR_DT_END    
            Entidad = SAR_H_COMPLEM_GCIAS[acum].SAR_ID_ENTIDAD        

            '--Importe de remuneraciones: Se toman únicamente las coincidentes con el mes evaluado
            If (IniComple <= mes_fin_imp And FinComple >= mes_ini_imp) And (entidad = "01" Or entidad = "13") Then 
                BrutoCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_BRUTO
                ExeNoCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_IMP_EXE_NO_ALC
                HExTbCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_IMP_HS_EXTRAS_GRAV
                HExExCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_IMP_HS_EXTRAS_EXENT
                NoHabCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_NO_HAB_OE
                NHbExCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_NO_HAB_EXEN_OE
                MViTbCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_MOV_VIA_TRIB_OE
                movTbCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_IMP_MOVILIDAD_OE
                anaTbCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_IMP_OTROS_CONCEPT_ANA_OE                
                MViExCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_MOV_VIA_EXEN_OE
                MDiTbCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_MAT_DIC_TRIB_OE
                MDiExCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_MAT_DIC_EXEN_OE
                PAnTbCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_PER_ANT_GRAV_OE
                PAnExCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_PER_ANT_NO_GRAV_OE
/* SiRADIG versión 1.16*/
                BoProCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_IMP_BONOS_PROD_OE
                FCajaCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_IMP_FCAJA_OE
                SiNatCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_IMP_SIMILAR_NAT_OE
                RemExCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_LEY_27549_OE
                SupleCompl = SAR_H_COMPLEM_GCIAS[acum].SAR_SUPL_LEY_19101_OE
                Dec27Compl = SAR_H_COMPLEM_GCIAS[acum].SAR_GASTOS_DEC27_OE                
                
                If BrutoCompl <> 0 And IsNull(BrutoCompl) = M4_False Then oe_mes = oe_mes + BrutoCompl
                If ExeNoCompl <> 0 And IsNull(ExeNoCompl) = M4_False Then oe_mes = oe_mes + ExeNoCompl
                If HExTbCompl <> 0 And IsNull(HExTbCompl) = M4_False Then oe_mes = oe_mes + HExTbCompl
                If HExExCompl <> 0 And IsNull(HExExCompl) = M4_False Then oe_mes = oe_mes + HExExCompl
                If NoHabCompl <> 0 And IsNull(NoHabCompl) = M4_False Then oe_mes = oe_mes + NoHabCompl
                If NHbExCompl <> 0 And IsNull(NHbExCompl) = M4_False Then oe_mes = oe_mes + NHbExCompl
                If MViTbCompl <> 0 And IsNull(MViTbCompl) = M4_False Then oe_mes = oe_mes + MViTbCompl
                If movTbCompl <> 0 And IsNull(movTbCompl) = M4_False Then oe_mes = oe_mes + movTbCompl
                If anaTbCompl <> 0 And IsNull(anaTbCompl) = M4_False Then oe_mes = oe_mes + anaTbCompl                                
                If MViExCompl <> 0 And IsNull(MViExCompl) = M4_False Then oe_mes = oe_mes + MViExCompl
                If MDiTbCompl <> 0 And IsNull(MDiTbCompl) = M4_False Then oe_mes = oe_mes + MDiTbCompl
                If MDiExCompl <> 0 And IsNull(MDiExCompl) = M4_False Then oe_mes = oe_mes + MDiExCompl
                If PAnTbCompl <> 0 And IsNull(PAnTbCompl) = M4_False Then oe_mes = oe_mes + PAnTbCompl
                If PAnExCompl <> 0 And IsNull(PAnExCompl) = M4_False Then oe_mes = oe_mes + PAnExCompl
/* SiRADIG versión 1.16*/
                If BoProCompl <> 0 And IsNull(BoProCompl) = M4_False Then oe_mes = oe_mes + BoProCompl
                If FCajaCompl <> 0 And IsNull(FCajaCompl) = M4_False Then oe_mes = oe_mes + FCajaCompl
                If SiNatCompl <> 0 And IsNull(SiNatCompl) = M4_False Then oe_mes = oe_mes + SiNatCompl
                If RemExCompl <> 0 And IsNull(RemExCompl) = M4_False Then oe_mes = oe_mes + RemExCompl
                If SupleCompl <> 0 And IsNull(SupleCompl) = M4_False Then oe_mes = oe_mes + SupleCompl
                If Dec27Compl <> 0 And IsNull(Dec27Compl) = M4_False Then oe_mes = oe_mes + Dec27Compl                
            EndIf                
        Next
    
        'Importe completo del mes a considerar para la ley 27617
        retrib_mes = devengos_mes + oe_mes
        
        importe_emp_actual = importe_emp_actual + retrib_mes
        
        'Promedio: Se consideran únicamente los meses en los que se percibe algo.
        If retrib_mes > 0 Then divisor_prom = divisor_prom + 1
        If propio_mes = 1 Then
            If retrib_mes > 0 Then
                divisor_prom = 1
            Else
                divisor_prom = 0
            EndIf
        EndIf
    Next
EndIf

'*****************************************************************************************************************************************************************
'******************** Fin del cálculo del divisor para el promedio
'*****************************************************************************************************************************************************************

If divisor_prom > 0 Then promedio = importe_emp_actual / divisor_prom

IMP_PROMEDIO = promedio

Return 0
