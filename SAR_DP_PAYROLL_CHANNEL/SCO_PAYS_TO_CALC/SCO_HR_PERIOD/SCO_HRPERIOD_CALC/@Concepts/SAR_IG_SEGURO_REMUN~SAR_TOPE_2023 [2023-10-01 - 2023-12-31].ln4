If DxYear(SAR_FEC_IMPUT_IG) > 2023 Then Return (SAR_IG_SEGURO_REMUN)

'Controla que no se supere el importe anual
valor = SAR_IG_SEGURO_REMUN

importeSep = SAR_ACM_SEP23_DED_REV[0].SAR_IG_SEGURO_REMUN
importeCompleto = SAR_TOPE_SEG_VIDA

If valor + importeSep > importeCompleto Then valor = importeCompleto - importeSep

Return Round(valor,SAR_NUM_DEC)
