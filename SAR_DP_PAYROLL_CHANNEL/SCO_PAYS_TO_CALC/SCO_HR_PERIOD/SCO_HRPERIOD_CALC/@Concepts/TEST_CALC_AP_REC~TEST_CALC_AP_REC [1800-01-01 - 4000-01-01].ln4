'Porcentajes para calculo de aportes
porcJub = 0
porcLey = 0
If SAR_EDAD >= 18 Then 
    porcJub = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
    porcLey = SAR_PORC_LEY_19032 - (SAR_PORC_LEY_19032 * SAR_PP_AP_INSSJP/100)
EndIf
porcObSoc = SAR_PORC_OBR_SOCIAL -(SAR_PORC_OBR_SOCIAL * SAR_PP_AP_OB_SOC/100)
porcAdObSoc = SAR_PORC_ADIC_O_SOC - (SAR_PORC_ADIC_O_SOC * SAR_PP_AP_OB_SOC/100)
porcSindVol = SAR_PORC_C_SIND_VOL
porcSindObl = SAR_PORC_C_SIND_OBL

baseCot = TEST_AJCOT_TOT_COTIZ
topeCot = TEST_TOPE_COTIZ

apJubAux = Percentage(porcJub,baseCot)
apJubMax = Percentage(porcJub,topeCot)

apRetYaAplicadoJub = 0
ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
For acum = 0 To ult_reg - 1
    If SCO_AC_HR_PERIOD_READ_1[acum].TEST_FECHA_LSD = TEST_FECHA_LSD And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION <> SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION<SCO_DT_ALLOCATION Then
        apRetYaAplicadoJub = apRetYaAplicadoJub + SCO_AC_HR_PERIOD_READ_1[acum].TEST_AP_JUB_RETRO
    EndIf
Next     

apJubMax = apJubMax - apRetYaAplicadoJub

apJubAux = Min(apJubAux,apJubMax)

'Levanta todos los conceptoDif con fecha lsd = fecha pago, esto se debe hacer tanto en paga normal como en retroactiva (para que esta considere ajustes saldados en la normal)
importeDifJub = 0
ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
For acum = 0 To ult_reg - 1
    If SCO_AC_HR_PERIOD_READ_1[acum].TEST_FECHA_LSD = SCO_DT_ALLOCATION And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION <> SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT Then
        importeDifJub = importeDifJub + SCO_AC_HR_PERIOD_READ_1[acum].TEST_AP_JUB_RETRO
    EndIf
Next     


TEST_AP_JUB_RETRO = apJubAux - importeDifJub

Return(0)




