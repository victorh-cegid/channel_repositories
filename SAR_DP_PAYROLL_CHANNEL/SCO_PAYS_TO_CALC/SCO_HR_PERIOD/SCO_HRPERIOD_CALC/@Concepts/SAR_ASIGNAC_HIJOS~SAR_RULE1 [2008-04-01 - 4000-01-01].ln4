IF SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

IF SAR_TP_IMPUT = "2" AND SAR_IND_AGUINALDO = 1 THEN
    Return(0)
ENDIF

IF (SAR_IND_ADH_SUAF = 0) and (SAR_IND_RG_344_ST = 0) THEN 
    Return(0)
ENDIF

valor = SAR_A_CARGO_HIJOS * SAR_PR_AS_HIJOS

Return(valor)
