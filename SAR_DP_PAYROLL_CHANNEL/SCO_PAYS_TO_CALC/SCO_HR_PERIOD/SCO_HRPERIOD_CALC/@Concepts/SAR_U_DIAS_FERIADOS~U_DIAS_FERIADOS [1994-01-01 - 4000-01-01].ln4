'No debe tomar el valor en Pagas Extra.
If SAR_TP_IMPUT = "2" Then Return(0)    

cont_fest = SCO_NUM_DAYS_CAL

If cont_fest > 0 then

    INICIO_TRAMO = SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC
    FIN_TRAMO    = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC
    cont_fest    = 0
    
    If SCO_NUM_HOURS_THEO > 0 then 
    
        nTotTheoHours   = 0
        nTotTheoDays    = 0
        nTotTheoSat     = 0
        nTotTheoSun     = 0
        nTotCalHours    = 0
        nTotCalDays     = 0
        nTotCalSat      = 0
        nTotCalSun      = 0
        nExecution      = 3             'We execute both, theoretical time and calendars
        DtStart         = INICIO_TRAMO
        DtEnd           = FIN_TRAMO
        tipo_incidencia = "1"           'Ausencia
        Tot_hs_fest_aus = 0             'total de horas de festivos durante ausencias
        
        SCO_THEORETICAL_TIME!SCO_TT_HR_THEOR_TIME.SCO_CALC_THEOR_TIME(SCO_ID_HR, SCO_OR_HR_PERIOD, NullValue(), DtStart, DtEnd, nExecution, nTotTheoHours, nTotCalHours, nTotTheoDays, nTotCalDays, nTotTheoSat, nTotCalSat, nTotTheoSun, nTotCalSun)
        
        If SAR_TIPO_SALARIO = "003" Then
            cont_fest = cont_fest + nTotCalHours
        Else
            cont_fest = cont_fest + nTotCalDays
        EndIf
        
        total_unid_ausen = SAR_TOT_U_AUSEN
        
        'Si está toda la paga ausente
        IF nTotTheoHours  = total_unid_ausen THEN 
            Return(0)
        ENDIF   
        
        'Cargamos el nodo de incidencias del periodo (ausentismos), en caso de que no esté ya cargado.
        IF SAR_REAL_TIME_PERIOD.COUNT()= 0 THEN
            SAR_REAL_TIME_PERIOD.LOAD_BLK()
        ENDIF
        
        'Añadimos filtro RAM al nodo cargado para quedarnos exclusivamente con los registros de ausencia
        sFilter = "If SCO_ID_INCIDENCE_TP = ARG_SCO_ID_INCIDENCE_TP Then Return(M4_TRUE) Else Return(M4_FALSE)"
        SAR_REAL_TIME_PERIOD.ADDFILTER(sFilter, M4_TRUE, "ARG_SCO_ID_INCIDENCE_TP", tipo_incidencia)
        
        'Si hay registros de tipo ausencia los recorremos para obtener las horas
        SAR_REAL_TIME_PERIOD.BEGIN()
        
        WHILE SAR_REAL_TIME_PERIOD.ISEOF() = FALSE
            fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START     ' fecha de inicio del ausentismo
            fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END       ' fecha de fin del ausentismo
            hs_fest_aus = 0                                     'horas de festivos durante la ausencia
            
            IF commontime(INICIO_TRAMO, FIN_TRAMO, fec_ini_abs, fec_fin_abs) > 0 THEN	
                IF fec_fin_abs > FIN_TRAMO then
                    fec_fin_abs = FIN_TRAMO
                ENDIF
                
                IF fec_ini_abs < INICIO_TRAMO then
                    fec_ini_abs = INICIO_TRAMO
                ENDIF
                
                SCO_THEORETICAL_TIME!SCO_TT_HR_THEOR_TIME.SCO_CALC_THEOR_TIME(SCO_ID_HR, SCO_OR_HR_PERIOD, NullValue(), fec_ini_abs, fec_fin_abs, nExecution, nTotTheoHours, hs_fest_aus, nTotTheoDays, nTotCalDays, nTotTheoSat, nTotCalSat, nTotTheoSun, nTotCalSun)
                
                If SAR_TIPO_SALARIO = "003" Then
                    Tot_hs_fest_aus = Tot_hs_fest_aus + hs_fest_aus
                Else
                    Tot_hs_fest_aus = Tot_hs_fest_aus + nTotCalDays
                EndIf
            ENDIF
            
            SAR_REAL_TIME_PERIOD.GONEXT()
        WEND
        
        'Se elimina el filtro RAM aplicado al nodo
        SAR_REAL_TIME_PERIOD.REMOVEFILTER()		
        cont_fest = cont_fest - Tot_hs_fest_aus
    else
        If SAR_TIPO_SALARIO = "003" Then
            cont_fest = SCO_NUM_DAYS_CAL * SAR_HS_DIARIAS_PROM
        Else
            cont_fest = SCO_NUM_DAYS_CAL
        Endif
    Endif
Endif

Return(cont_fest)
