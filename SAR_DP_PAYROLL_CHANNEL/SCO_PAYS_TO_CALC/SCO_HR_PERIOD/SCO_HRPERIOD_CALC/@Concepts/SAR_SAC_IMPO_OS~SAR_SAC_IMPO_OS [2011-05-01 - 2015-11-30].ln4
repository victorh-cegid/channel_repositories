/* debería ser días para S.A.C. */

tope = (SAR_TOPE_COTIZ * (SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2)*180)/360
sac  = SAR_PAGA_EXTRA_1 + SAR_PAGA_EXTRA_2

IF SAR_ES_BAJA = 1 THEN
    tope = (SAR_TOPE_COTIZ*(SAR_U_EGRESO_PAGA_1+SAR_U_EGRESO_PAGA_2)*180)/360
    sac  = SAR_EGRESO_PAGA_1 + SAR_EGRESO_PAGA_2
ENDIF


base = Min(tope,sac)


'Comparación con el mínimo imponible solo en caso que base > 0
If base > 0 Then
    IF SAR_ES_BAJA = 1 THEN
        base_min_impo = (((SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO) * (SAR_U_EGRESO_PAGA_1+SAR_U_EGRESO_PAGA_2)*180)/360) 
    Else
        base_min_impo = (((SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO) * (SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2)*180)/360) 
    EndIf
    
    base = Max(base_min_impo, base)
EndIf


RETURN(base)
