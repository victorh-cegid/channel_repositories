dias= #SAR_UN_VACACIONES
devengado=#SAR_VAC_DEV_SAC

SAR_ACM_ULT_PAGO_IMPUT.BEGIN()

IF dias=0  AND devengado= 0 THEN 
    RETURN(0)
ENDIF
IF dias = 0 AND devengado > 0 THEN
    valor=SAR_ACM_ULT_PAGO_IMPUT.#SAR_TOPE_DIAVAC_CNT
ELSE
    IF (#SAR_VAC_IMPO_CNT = 0) OR (dias = 0) Then Return(0)
    valor=#SAR_VAC_IMPO_CNT/dias
ENDIF
RETURN(valor)
