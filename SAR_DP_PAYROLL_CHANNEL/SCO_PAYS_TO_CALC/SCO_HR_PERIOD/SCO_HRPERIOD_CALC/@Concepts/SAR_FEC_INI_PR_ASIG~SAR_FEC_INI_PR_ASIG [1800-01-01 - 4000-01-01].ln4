IF DXMONTH(SCO_DT_ALLOCATION) >= 3 AND DXMONTH(SCO_DT_ALLOCATION) <= 8 THEN
    FECHA = TOSTRING(DXYEAR(SCO_DT_ALLOCATION)-1,0) + "-01" + "-01"
    fecha_inicio = TODATE(FECHA)
ELSE
    IF DXMONTH(SCO_DT_ALLOCATION) >= 9 THEN
        FECHA = TOSTRING(DXYEAR(SCO_DT_ALLOCATION),0) + "-01" + "-01"
        fecha_inicio = TODATE(FECHA)
    ELSE
        IF DXMONTH(SCO_DT_ALLOCATION) = 1 OR DXMONTH(SCO_DT_ALLOCATION) = 2 THEN
            FECHA = TOSTRING(DXYEAR(SCO_DT_ALLOCATION)-1,0) + "-01" + "-01"
            fecha_inicio = TODATE(FECHA)
        ENDIF
    ENDIF
ENDIF

IF SAR_FECHA_ALTA >= fecha_inicio AND SAR_FECHA_ALTA <= SAR_FEC_FIN_PR_ASIG THEN 
  fecha_inicio = SAR_FECHA_ALTA
ENDIF

Return(fecha_inicio)
