'armo la fecha a utilizar segun la paga sea Normal o Retro
IF SAR_PAYS_TO_CALC.SCO_DT_PAYMENT <> SAR_PAYS_TO_CALC.SCO_DT_ALLOCATION THEN
    vFecha = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC
ELSEIF SAR_ES_BAJA = 1 THEN 'en caso de que sea Baja, utilizo la fecha de baja para la carga del filtro.
    vFecha = SAR_FECHA_BAJA
ELSE
    vDiasMes = tostring(DaysOfMonth(SAR_PAYS_TO_CALC.SCO_DT_PAYMENT),0)
    vMes = tostring(DxMONTH(SAR_PAYS_TO_CALC.SCO_DT_PAYMENT),0)
    vAnio = tostring(DxYEAR(SAR_PAYS_TO_CALC.SCO_DT_PAYMENT),0)
    vFecha = dxDate(vDiasMes,vMes,vAnio)
ENDIF

'cargo el nodo y me posiciono en el 1er registro.
SAR_H_EMP_TYPE.DESTROYBLOCK()
SAR_H_EMP_TYPE.SAR_P_FECHA = vFecha

SAR_H_EMP_TYPE.LOAD_BLK()
SAR_H_EMP_TYPE.BEGIN()

'se agrega la condicion para que solo se tenga en cuenta el porcentaje si el cod condicion es 5
IF SAR_H_EMP_TYPE.COUNT() > 0 THEN
    IF SAR_H_EMP_TYPE.SAR_ID_COD_COND = "5" THEN
        vPorc = SAR_PORC_CONT_T_DIF
    ELSE
        vPorc = 0
    ENDIF
ELSE
    vPorc = 0
ENDIF

RETURN(vPorc)
