contador = 0

'Cargo el nodo de Familiares para Impuesto
IF SAR_FAMIL_IMPUESTO.COUNT() = 0 THEN
    SAR_FAMIL_IMPUESTO.SAR_FEC_INI_IG = SAR_FEC_INI_IG
    SAR_FAMIL_IMPUESTO.SAR_FEC_FIN_IG = SAR_FEC_FIN_IG 
    SAR_FAMIL_IMPUESTO.LOAD_BLK()    
    IF SAR_FAMIL_IMPUESTO.COUNT() = 0 THEN
       Return(0)
    ENDIF
ENDIF

importe=0
mini=0

primerreg = 0
ultimoreg = SAR_FAMIL_IMPUESTO.COUNT() -1

'Aca voy a cargar la TI de incapacidades
IF SAR_INCAPACIDADES.COUNT() = 0 THEN
    SAR_INCAPACIDADES.LOAD_BLK()
    SAR_INCAPACIDADES.BEGIN()
ENDIF


FOR I = primerreg TO ultimoreg 
    SAR_FAMIL_IMPUESTO.MOVETO(I)
    parent  = SAR_FAMIL_IMPUESTO.STD_ID_ACT_DEP_TYPE
    fec_nac = SAR_FAMIL_IMPUESTO.STD_DT_BIRTH       
    Existe_hijo_inc = 0
    If(parent = "2" Or parent = "7" Or parent = "8" ) Then
       'Se busca (findregister) si existe incapacidad para el hijo.
       SAR_INCAPACIDADES.BEGIN()
       Reg_inc = SAR_INCAPACIDADES.FindRegister("SCO_ID_HR",SAR_FAMIL_IMPUESTO.STD_ID_FAMILY_PERSON,EQUAL,"SCO_ID_DISABILITY","05",EQUAL)
       If Reg_inc <> -1 Then
            SAR_INCAPACIDADES.MOVETO(Reg_inc)
            If (SAR_FEC_PAGO_IG >= SAR_INCAPACIDADES.SCO_DT_START) and (SAR_FEC_PAGO_IG <= SAR_INCAPACIDADES.SCO_DT_END) then
                Existe_hijo_inc = 1
            Else
                Existe_hijo_inc = 0
            Endif
        Endif
        
       If Reg_inc <> -1 Then
            inc_permanente = SAR_INCAPACIDADES.SCO_PERMANENT
            fec_fin_incap = SAR_INCAPACIDADES.SCO_DT_END
            
            If inc_permanente = "1" Then
'                Existe_hijo_inc = 1
                inc = "N"
            Else
                inc = "S"
'                Existe_hijo_inc = 0
            Endif
       Else
'            Existe_hijo_inc = 0
            inc = "N"
       EndIf
    EndIf       
      
    edad = Years(fec_nac,SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC)
    IF (Existe_hijo_inc = 1) or (( (edad < SAR_TOPE_EDAD_FAMILIAR OR ((edad < SAR_TOPE_EDAD_FAMILIAR OR (edad = SAR_TOPE_EDAD_FAMILIAR AND (DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG) and (DXMONTH(fec_nac) = DXMONTH(SAR_FEC_PAGO_IG)))))) OR  inc = "S") AND (parent = "2" OR parent = "7" OR parent = "8"))) THEN    
        fecha_alta_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_ALTA_IMP
	  fecha_baja_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_BAJA_IMP
        fecha_ini           = Max(fecha_alta_impuesto,SAR_FEC_INI_IG)

        IF ISNULL(fecha_baja_impuesto)  = TRUE THEN 
            fecha_tope = SAR_FEC_PAGO_IG
	  ELSE
        	fecha_tope = Min(fecha_baja_impuesto,SAR_FEC_PAGO_IG)
	  ENDIF
             

        'Si no es hijo incapacitado, verifico los años contra el tope de la edad para ganancias.(24 años) 
        IF (edad = SAR_TOPE_EDAD_FAMILIAR) AND (DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG)) AND (Existe_hijo_inc <> 1) THEN
            DIAT = DXDAY(fec_nac)
            IF DIAT < 10 then
                DIAT = "0" + TOSTRING(DIAT,0)
            ELSE
                DIAT = TOSTRING(DIAT,0)
            ENDIF
            
            MEST = DXMONTH(fec_nac)
            IF MEST < 10 then
                MEST = "0" + TOSTRING(MEST,0)
            ELSE
                MEST = TOSTRING(MEST,0)
            ENDIF
              
            FECHA      = TOSTRING(DXYEAR(SAR_FEC_PAGO_IG),0) + "/" + MEST + "/" + DIAT
            fecha_tope = TODATE(FECHA)
                   
            IF fecha_tope > fecha_baja_impuesto AND  ISNULL(fecha_baja_impuesto) = FALSE THEN
                fecha_tope = fecha_baja_impuesto 
                IF fecha_baja_impuesto > SAR_FEC_PAGO_IG THEN
                    fecha_tope = SAR_FEC_PAGO_IG
                ENDIF
            ENDIF
              
        ENDIF
                  
        MES = DXMONTH(fecha_ini)
        IF MES < 10 then
            MES = "0" + TOSTRING(MES,0)
        ELSE
            MES = TOSTRING(MES,0)
        ENDIF
        
        FECHA     = TOSTRING(DXYEAR(fecha_ini),0) + "/" + MES + "/" + "25"
        fecha_ini = TODATE(FECHA)
        mini      = DXMONTH(fecha_ini)
              
        WHILE mini <= DXMONTH(fecha_tope) 
            'Toma su valor por valores empresa
            ind = SAR_IND_DED_IG_2010
            vDia = tostring(DxDay(SAR_FEC_PAGO_IG),0)
            IF mini < 10 then
                mini3 = "0" + TOSTRING(mini,0)
            ELSE
                mini3 = TOSTRING(mini,0)
            ENDIF
            vAnio = tostring(DxYear(SAR_FEC_PAGO_IG),0)  
            vFecha = DxDate(vDia,mini3,vAnio)
            If (vFecha >= SAR_INCAPACIDADES.SCO_DT_START) and (vFecha <= SAR_INCAPACIDADES.SCO_DT_END) then
                Existe_hijo_inc = 1
            Else
                Existe_hijo_inc = 0
            Endif
        'Calculo de la deducción especial según información recopilada del concepto 792 por Decreto 1242/2013.
        	'792 Es el rango obtenido en el que el empleado se ubica según su Máxima remuneración y la zona desfavorable 
        	'Y sus valores posibles para este concepto son:
        	'2: Empleado que tiene entre 15000$ y 25000$ de rem max y zona no desfavorable.
        	'3: Empleado que tiene mas de 15000$ de rem max y zona desfavorable.                        
            IF ((Existe_hijo_inc = 1 or edad < SAR_TOPE_EDAD_FAMILIAR or(edad = SAR_TOPE_EDAD_FAMILIAR AND DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG) and DXMONTH(fec_nac) >= mini))) and (parent = "2" OR parent = "7" OR parent = "8") THEN
                If(SAR_RANGO_REM_IG_2013 = 3)Then
                    precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("98","SAR_VAL_HIJO_IMP",fecha,ind))
                ElseIf(SAR_RANGO_REM_IG_2013 = 2)Then
                    precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("99","SAR_VAL_HIJO_IMP",fecha,ind))
                Else                                        
                    precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_VAL_HIJO_IMP",fecha,ind))	
                EndIf
                importe = importe + precio
            Endif
            If isNull(importe) = M4_TRUE Then
                importe = 0
            Endif
           	mini    = mini + 1
            mini2   = mini
                       
            IF mini < 10 then
                mini2 = "0" + TOSTRING(mini,0)
            ELSE
                mini2 = TOSTRING(mini,0)
            ENDIF
            
            fecha = TOSTRING(DXYEAR(fecha_ini),0) + "/" + mini2 + "/" + "25"
           
        WEND

    ELSE

        fecha_alta_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_ALTA_IMP
        fecha_baja_impuesto = SAR_FAMIL_IMPUESTO.SAR_DT_BAJA_IMP
        fecha_ini           = Max(fecha_alta_impuesto,SAR_FEC_INI_IG)
        MES                 = DXMONTH(fecha_ini)
        IF MES < 10 then
            MES = "0" + TOSTRING(MES,0)
        ELSE
            MES = TOSTRING(MES,0)
        ENDIF
        
        FECHA      = TOSTRING(DXYEAR(fecha_ini),0) + "/" + MES + "/" + "25"
        fecha_ini  = TODATE(FECHA)
        mini       = DXMONTH(fecha_ini)
        fecha_aniv = fec_nac    
             
        control = 0
        fecha_tope = fecha_aniv       
        IF (ISNULL(fecha_baja_impuesto) = FALSE) THEN
            if ( DXYEAR(fecha_baja_impuesto) = DXYEAR(fecha_ini) ) THEN
                fecha_tope = fecha_baja_impuesto
                control = 1 
                IF fecha_baja_impuesto > SAR_FEC_PAGO_IG THEN
                    fecha_tope = SAR_FEC_PAGO_IG
                ENDIF
            else
                fecha_tope = fecha_aniv
                control = 0
            endif             
        ENDIF
             
      IF (parent = "2" OR parent = "7" OR parent = "8") AND (((edad = SAR_TOPE_EDAD_FAMILIAR AND (DXYEAR(fec_nac) + SAR_TOPE_EDAD_FAMILIAR = DXYEAR(SAR_FEC_PAGO_IG) ))) OR (control = 1))  THEN        
  
            WHILE mini <= DXMONTH(fecha_tope) 
                'Toma su valor por valores empresa
                ind = SAR_IND_DED_IG_2010

                'Calculo de la deducción especial según información recopilada del concepto 792 por Decreto 1242/2013.
            	'792 Es el rango obtenido en el que el empleado se ubica según su Máxima remuneración y la zona desfavorable 
            	'Y sus valores posibles para este concepto son:
            	'2: Empleado que tiene entre 15000$ y 25000$ de rem max y zona no desfavorable.
            	'3: Empleado que tiene mas de 15000$ de rem max y zona desfavorable.                        

                If(SAR_RANGO_REM_IG_2013 = 3)Then
                    precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("98","SAR_VAL_HIJO_IMP",fecha,ind))
                ElseIf(SAR_RANGO_REM_IG_2013 = 2)Then
            	  precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO("99","SAR_VAL_HIJO_IMP",fecha,ind))
                Else                                        
                    precio = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_VAL_HIJO_IMP",fecha,ind))
                EndIf
                
                importe = importe + precio
                mini    = mini + 1
                mini2   = mini
                   
                IF mini < 10 then
                    mini2 = "0" + TOSTRING(mini,0)
                ELSE
                    mini2 = TOSTRING(mini,0)
                ENDIF
            
                fecha     = TOSTRING(DXYEAR(fecha_ini),0) + "/" + mini2 + "/" + "25"
                fecha_ini = TODATE(fecha)
            WEND
            
        ENDIF       
    ENDIF
NEXT
  
'Se redondea el importe antes de su devolución
RETURN(Round(importe,2))
