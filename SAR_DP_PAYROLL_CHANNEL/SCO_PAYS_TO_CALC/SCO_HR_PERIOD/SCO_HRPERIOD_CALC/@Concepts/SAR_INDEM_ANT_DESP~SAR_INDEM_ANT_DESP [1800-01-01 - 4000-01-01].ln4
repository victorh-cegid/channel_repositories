IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

IF SAR_ES_BAJA = 0 THEN 
    Return(0)
ENDIF

'Por modificación del empleado
IF SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" Then
    Return(0)
ENDIF

MOTIVO_BAJA = SCO_HR_PERIOD.STD_ID_HRP_END_REASON
ant = SAR_MESES_ANTIG


IF MOTIVO_BAJA <> "9" AND MOTIVO_BAJA <> "10" THEN 
    Return(0)
ENDIF

meses = 3

'Contratos con antig. desde el 09/07/2024 se toma 6 meses o los informados en el concepto SAR_FEC_INDEM
If SAR_FEC_INDEM >= DxDate(9,7,2024) Then meses = SAR_MESES_TOPE_INDEM

'La antigüedad debe ser mayor a 3 meses
IF ant < meses THEN
    Return(0)
ENDIF


Return(SAR_PRE_INDEM_ANTIG)
