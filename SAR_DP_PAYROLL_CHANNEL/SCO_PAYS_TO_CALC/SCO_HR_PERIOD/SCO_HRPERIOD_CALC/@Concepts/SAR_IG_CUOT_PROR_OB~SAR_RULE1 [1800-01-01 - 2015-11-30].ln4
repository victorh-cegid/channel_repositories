If SAR_TP_IMPUT = "99" Then Return(0)

'No se ejecuta en la primera quincena
IF (SAR_TP_IMPUT = "3"  AND SAR_ES_BAJA = 0 ) THEN RETURN (0)


' Cambio Legal SP042 - Impuesto a las Ganancias.
' Se elimina el calculo de la cuota prorrateada en Pagas Extras
If (SAR_TP_IMPUT = "2") Then Return(0)



IF (SCO_DT_ALLOCATION <> SCO_DT_PAYMENT) THEN
    mes = DxMonth(SAR_PAGA_ACTUAL_IMPUT.SAR_FECHA_PAGO_IG)
ELSE   
    mes=SAR_MES_PAGO_IG
ENDIF


dif=0
saldo=0
cuota_ant=0
cuota=0
base=0
meses_quedan=0
valor = 0

IF (mes > 1 And DxMonth(SCO_DT_PAYMENT) = DxMonth(SAR_FEC_PAGO_IG)) Or (mes > 2 And DxMonth(SCO_DT_PAYMENT) <> DxMonth(SAR_FEC_PAGO_IG)) THEN 'and mes >= 6 
    SAR_ACM_ULT_MES.BEGIN()
    saldo = SAR_ACM_ULT_MES.SAR_IG_SALD_PROR_OB
    cuota_ant = SAR_ACM_ULT_MES.SAR_IG_CUOT_PROR_OB
ENDIF

IF saldo < cuota_ant THEN
    cuota_ant = saldo
ENDIF

IF (SAR_ES_BAJA=1 ) Then
    If(SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" ) Then
      dia_baja = DXDAY(SAR_FECHA_BAJA) 
      mes_baja = DXMONTH(SAR_FECHA_BAJA) 
      If mes_baja = 2 Then  
         If (dia_baja < 28 And DaysOfMonth(2) = 28) Then  
           Return(0)
         EndIf  
         Else  
         If (dia_baja < 29 And DaysOfMonth(2) = 29) Then  
           Return(0)
         EndIf  
      EndIf
      If mes_baja = 1 Or mes_baja = 3 Or mes_baja = 5 Or mes_baja = 7 Or mes_baja = 8 Or mes_baja = 10 Or mes_baja = 12 Then  
         If dia_baja < 31 Then  
           Return(0)
         EndIf  
      EndIf
      If mes_baja = 4 Or mes_baja = 6 Or mes_baja = 9 Or mes_baja = 11  Then  
         If dia_baja < 30 Then  
           Return(0)
         EndIf  
      EndIf
   EndIf
EndIf





IF ((SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" ) OR mes = 12 Or mes = 1) THEN 
    If(mes = 1 And DxMonth(SCO_DT_PAYMENT) <> DxMonth(SAR_FEC_PAGO_IG))Then
        valor = SAR_OBRA_SOCIAL_SAC
    Else
        valor = SAR_OBRA_SOCIAL_SAC + SAR_IG_O_SOC_NO_HAB + saldo
    EndIf    
    RETURN(valor)
ENDIF

IF SCO_DT_ALLOCATION <> SCO_DT_PAYMENT THEN
   SAR_PAGA_ACTUAL_IMPUT.BEGIN()
   IF ISNULL(SAR_PAGA_ACTUAL_IMPUT.SAR_OBRA_SOCIAL_SAC) = FALSE THEN
        obra_social_sac = SAR_PAGA_ACTUAL_IMPUT.SAR_OBRA_SOCIAL_SAC
   ELSE 
        obra_social_sac = 0
   ENDIF
   IF ISNULL(SAR_PAGA_ACTUAL_IMPUT.SAR_IG_O_SOC_NO_HAB) = FALSE THEN
        obra_social_no_hab = SAR_PAGA_ACTUAL_IMPUT.SAR_IG_O_SOC_NO_HAB
   ELSE 
        obra_social_no_hab = 0
   ENDIF       
   dif = SAR_OBRA_SOCIAL_SAC + SAR_IG_O_SOC_NO_HAB - obra_social_sac - obra_social_no_hab
   IF dif >= 0 THEN
      IF ISNULL(SAR_PAGA_ACTUAL_IMPUT.SAR_IG_CUOT_PROR_OB) = FALSE THEN
        obra_social_cuot_pror = SAR_PAGA_ACTUAL_IMPUT.SAR_IG_CUOT_PROR_OB
      ELSE 
        obra_social_cuot_pror = 0
      ENDIF  
      aux= obra_social_cuot_pror
      SAR_IG_PRO_AD_OB=dif
      RETURN(aux)
   ELSE 
      base= SAR_OBRA_SOCIAL_SAC + SAR_IG_O_SOC_NO_HAB
   ENDIF 
ELSE 
    SAR_INCRE_PRORRATEOS.BEGIN()
    IF ISNULL(SAR_INCRE_PRORRATEOS.SAR_IG_PRO_AD_OB) = FALSE THEN
        obra_social_pro_ad = SAR_INCRE_PRORRATEOS.SAR_IG_PRO_AD_OB
      ELSE 
        obra_social_pro_ad = 0
    ENDIF  
    base= SAR_OBRA_SOCIAL_SAC + SAR_IG_O_SOC_NO_HAB + obra_social_pro_ad     
ENDIF
meses_quedan = 12 - mes + 1
cuota = base/meses_quedan
IF saldo = 0 THEN
    RETURN(cuota)
ELSE
    valor = cuota + cuota_ant
    RETURN(valor)
ENDIF
