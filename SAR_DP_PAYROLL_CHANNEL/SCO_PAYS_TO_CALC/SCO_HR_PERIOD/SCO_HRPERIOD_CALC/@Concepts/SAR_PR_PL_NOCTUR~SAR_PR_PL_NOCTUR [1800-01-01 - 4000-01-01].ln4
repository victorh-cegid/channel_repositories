IF SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

precio      = 0
aux         = SAR_MIN_PL_NOCTUR
tot_compl   = SAR_TOT_P_COMP_EA

IF SAR_UN_PL_NOCTUR > 0 THEN
    IF SAR_TIPO_SALARIO = "001" THEN
        IF SAR_HORAS_MES <> 0 THEN
            PRECIO_PLUS_NOC = SAR_TOT_P_COMP_EA/SAR_HORAS_MES
        ELSE
            PRECIO_PLUS_NOC = 0
        ENDIF
    ELSEIF SAR_TIPO_SALARIO = "002" THEN
        IF SAR_HS_DIARIAS_PROM = 0 THEN
            Setlog (-1,80,4,205,SCO_ID_HR)
            SCO_ERROR =1
        ELSE
            PRECIO_PLUS_NOC = SAR_TOT_P_COMP_EA/SAR_HS_DIARIAS_PROM
        ENDIF
    ELSEIF SAR_TIPO_SALARIO = "003" THEN
        PRECIO_PLUS_NOC = SAR_TOT_P_COMP_EA
    ENDIF
ENDIF

IF PRECIO_PLUS_NOC > 0 THEN
    IF SAR_TIPO_SALARIO = "002" THEN
        precio = Round((PRECIO_PLUS_NOC / 60 * SAR_MIN_PL_NOCTUR), SAR_NUM_DEC)
    ELSE 
        precio = Round((PRECIO_PLUS_NOC * (SAR_MIN_PL_NOCTUR/60)), SAR_NUM_DEC)
    ENDIF
ENDIF

Return(precio)
