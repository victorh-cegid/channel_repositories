IF SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" or SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

edad = SAR_EDAD
base = SAR_REM_IMPO_JUB + SAR_BASE_ART_JUB
valor = 0

IF edad >= 18 THEN
    porc = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
    valor = base * porc / 100

    'Dec 792 compensacion exenta de aporte
    If SAR_TIPO_SALARIO = "003" Then
        descDec = Percentage(SAR_PORC_JUBILACION,SAR_IMP_DEC792_NRED)
        valor = valor - descDec
    Else
        tope_diario_jub = SAR_TOPE_JUBIL/SAR_DIAS_NORM_COTIZ
        tope_jub_dec792 = tope_diario_jub * (SAR_DIAS_DEC792+SAR_DIAS_MATERN+SAR_LIC_ONCO_DIAS) 'proporcionamos el tope de jubilacion por los dias de decreto 792
        valor = valor - Percentage(SAR_PORC_JUBILACION,Min(SAR_IMP_DEC792_NRED,tope_jub_dec792))
    EndIf

ENDIF

IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF

Return(valor)
