'
'De la tabla de Vacaciones trae el n? de dias correspondientes mas los dias a aumentar
'

id_vac = SAR_V_CONV_ESTR.SAR_RETORNA_VALOR(SAR_ID_CONVENIO)
valor = SAR_DIAS_VACACIONES.SAR_RETORNA_VALOR(SAR_ANIOS_ANTIG_VAC,id_vac,"SAR_DIAS")
valormas = SAR_DIAS_VACACIONES.SAR_RETORNA_VALOR(SAR_ANIOS_ANTIG_VAC,id_vac,"SAR_DIAS_AUMENTAR")
tot = valor + valormas


Return(tot)
