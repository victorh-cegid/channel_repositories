'Dec792 inicio: anula % y contribución sin afectar al resto de diferenciales

'Dependencias:
a = SAR_CONTR_REG_DIF_ART + SAR_CONTR_REG_DIF_SAC + SAR_CONTR_REG_DIF_VAC
If SAR_DIAS_DEC792>0 Then
    'Comprueba que los días dec792 comprenden toda la situacion del empleado en el mes
    inc_mes = SAR_INC_MES_COMPLETO("23")
    if inc_mes = 1 Then SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_PORC_CONT_T_DIF",-1,0)
EndIf
'Fin Dec792

'Contribución Regimen Dif
vContribRegDif = (SAR_TOT_DEV_COTIZ * SAR_PORC_CONT_T_DIF)/ 100

Return Round(vContribRegDif,2)
