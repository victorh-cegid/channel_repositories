FECHA_RECT = NULLVALUE()
'Se realiza la validacion de si se calcula con rectificativa o no

CambioDeLinea = CHR(13) + CHR(10)
DefineInstance("SAV_PARAMS","SAV_PARAMS", 1, 3)
Code = "SAV_PARAMS!SAV_PARAMS.RET_VALUE("
Code = Code + CHR(Double_Quote) + "CHANNEL_DESIGNER" + CHR(Double_Quote) 
Code = Code + "," +CHR(Double_Quote)+ "PAYROLL_PARS" + CHR(Double_Quote)  	
Code = Code  + "," + CHR(Double_Quote)+ "RECT_SICOSS" + CHR(Double_Quote)+ ")" + CambioDeLinea + "iCount = SAV_PARAMS!FINAL_RETURN.Count()" + CambioDeLinea
Code = Code  + "If iCount > 0 Then" + CambioDeLinea + "Return(SAV_PARAMS!FINAL_RETURN[0].APP_VALUE)" + CambioDeLinea + " else " + CambioDeLinea + "return(0) " + CambioDeLinea + "endif" 
RECTIFICA_SICOSS= ClcExecuteLN4JIT(Code) 


IF RECTIFICA_SICOSS = "0" THEN
    FECHA_RECT = SCO_DT_PAYMENT
ELSE
    FECHA_RECT = SCO_DT_ALLOCATION
ENDIF    


return(FECHA_RECT)
