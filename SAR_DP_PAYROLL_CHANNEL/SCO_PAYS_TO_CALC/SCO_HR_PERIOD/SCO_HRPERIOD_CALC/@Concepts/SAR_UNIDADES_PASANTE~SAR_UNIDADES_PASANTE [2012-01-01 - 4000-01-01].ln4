'Creada el 09/11/2011 Fernando Miguel Siri
'
'Calcula la cantidad de días trabajados por un pasante.
' A saber lo siguiente:
'    No se consideran las ausencias.
'    El tope de días es 30.
'    Solo se considerarán la cantidad de días <> 30 en el alta o en la baja. 

If(SAR_ID_MOD_CONTRAT <> "27" And SAR_ID_MOD_CONTRAT <> "10")Then return(0) 'Si no es pasante no se calculan las unidades. 
      

uni = 0 ' variable en la que se retornarán los días trabajados
inicio_tramo = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysStartDate
fin_tramo    = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysEndDate


dias_paga = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC - SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC + 1
IF dias_paga = 0 THEN
    Return(0)
ENDIF

FECHA_INICIO_TRAMO = inicio_tramo
FECHA_FIN_TRAMO = fin_tramo


IF DXDAY(inicio_tramo) > 30 THEN
        FECHA_INICIO_TRAMO = FECHA_INICIO_TRAMO - 1
ENDIF      
IF DXDAY(fin_tramo) > 30 THEN
   DIA = "30"
   MES = DXMONTH(fin_tramo)
   IF MES < 10 THEN
      MES = "0" + TOSTRING(MES,0)
   ELSE
      MES = TOSTRING(MES,0)
   ENDIF
   ANIO = TOSTRING(DXYEAR(fin_tramo),0)
   STR_FECHA = ANIO + "-" + MES + "-" + DIA
   FECHA_FIN_TRAMO = TODATE(STR_FECHA)
ENDIF
IF DXMONTH(fin_tramo) = 2 THEN
   IF DXDAY(fin_tramo) = 28 THEN
     FECHA_FIN_TRAMO = FECHA_FIN_TRAMO + 2
   ELSEIF DXDAY(fin_tramo) = 29 THEN
     FECHA_FIN_TRAMO = FECHA_FIN_TRAMO + 1
   ENDIF
ENDIF
    

dias_tramo = (FECHA_FIN_TRAMO - FECHA_INICIO_TRAMO) + 1

IF dias_tramo > 30 THEN
       dias_tramo = 30
ENDIF

IF SAR_DIAS_ANT_ALTA() > 0 OR SAR_DIAS_POST_BAJA() > 0 THEN ' esta de baja o de alta en el mes
        dias = dias_tramo
        IF SAR_FECHA_ALTA > inicio_tramo THEN
            dias = FECHA_FIN_TRAMO - SAR_FECHA_ALTA + 1
            IF dias < 0 THEN
                dias = 0
            ENDIF
        ELSEIF SAR_FECHA_BAJA < fin_tramo THEN
            dias = SAR_FECHA_BAJA - inicio_tramo + 1
            IF dias < 0 THEN
                dias = 0
            ENDIF
        ENDIF
ELSE
   dias = dias_tramo
ENDIF


IF SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "1" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "3" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "4" OR SAR_HRPERIOD_CALC.SAR_TP_IMPUT = "99" THEN
    Return(MAX(dias,0))
ELSE
    Return(30)
ENDIF

'return(uni)
