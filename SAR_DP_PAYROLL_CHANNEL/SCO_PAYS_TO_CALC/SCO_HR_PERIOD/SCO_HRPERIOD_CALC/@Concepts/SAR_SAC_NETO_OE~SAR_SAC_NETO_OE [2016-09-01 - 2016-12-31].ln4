'Solo se ejecuta si el Indicador de exencion IG y el Indicador de exencion IG Empresa estan activos 
If (SAR_IND_EXEN_IG <> 1) or (SAR_IND_EXEN_IG = 1 and SAR_IND_EXEN_IG_EMPRE <> 1) Then Return(0)

sac_neto_exento = 0

'Control para que no se calcule en caso de cambio de a?o fiscal (diferidos en diciembre)
If DxYear(SAR_FEC_PAGO_IG) = DxYear(SCO_DT_ALLOCATION) Then 
    sac_neto_exento = #SAR_IG_SAC_EXEN_OE - #SAR_IG_JUB_EXEN_OE - #SAR_IG_LEY_EXEN_OE - #SAR_IG_OB_EXEN_OE -#SAR_IG_SIND_EXEN_OE
EndIf

Return(sac_neto_exento)
