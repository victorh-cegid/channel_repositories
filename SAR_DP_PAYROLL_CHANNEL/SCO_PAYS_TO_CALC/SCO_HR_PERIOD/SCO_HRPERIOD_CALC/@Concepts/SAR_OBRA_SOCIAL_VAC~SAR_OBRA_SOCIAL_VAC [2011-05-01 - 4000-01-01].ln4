'dependencias
a = SAR_REMUN_IMPO_OS

If SAR_TP_IMPUT = "77" And SAR_IND_PAGA_ESP_VAC = 0 Then Return(0)

If (SAR_TP_IMPUT = "1" or SAR_TP_IMPUT = "3" or SAR_TP_IMPUT = "4") And SAR_IND_PAGA_ESP_VAC = 1 Then Return(0)

porc = SAR_PORC_OBR_SOCIAL - (SAR_PORC_OBR_SOCIAL * SAR_PP_AP_OB_SOC / 100)
precio = SAR_VAC_IMPO_OS * porc / 100

IF ISNULL(precio) = TRUE THEN
    precio = 0
ENDIF

Return(precio)
