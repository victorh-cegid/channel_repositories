submedhon = SAR_BASE_IMP_SUBDONAC 
aux       = submedhon * SAR_PORC_TOPE_C_MED / 100      'tope cuota med.asistencial 

'Sólo 2023: ante la situacion de 2 periodos fiscales, se están dando casos de error por superar el tope, se incluye truncate para que no lo supere
If DxYear(SAR_FEC_IMPUT_IG) = 2023 Then aux = Truncate(aux,2)

cmajur    = SAR_JUR_CTA_MED_ASI + SAR_TOT_AD_OBRA_SOC 
tcma      = Min(cmajur,aux)             'compara con tope cta.med.asistencial declarada 
tcma      = Max(tcma,0) 
Return(tcma)
