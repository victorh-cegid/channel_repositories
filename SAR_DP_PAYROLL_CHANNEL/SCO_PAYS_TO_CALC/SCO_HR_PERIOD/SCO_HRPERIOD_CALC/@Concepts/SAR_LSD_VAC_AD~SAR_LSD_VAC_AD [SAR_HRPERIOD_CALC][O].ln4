'Este concepto es para exponer en LSD las vacaciones en modalidad plus vacacional AFIP 151000 (cotizacion conjunta)
importe = 0
If SAR_LSD_IND_VAC_AD = 1 Then importe = SAR_LSD_TOT_VAC

'Puede cambiar de adelanto vacacional a plus vacacional, solo hay que considerar la diferencia, no el importe completo
If SCO_DT_PAYMENT <> SCO_DT_ALLOCATION Then 
    importe = 0
    vacAdOrig = SCO_AC_HR_PERIOD_REV_1.SAR_LSD_VAC_AD
    vacTotalOrig = SCO_AC_HR_PERIOD_REV_1.SAR_LSD_TOT_VAC
    difTotal = SAR_LSD_TOT_VAC - vacTotalOrig
    If SAR_LSD_IND_VAC_AD = 1 Then importe = difTotal
    importe = importe + vacAdOrig
EndIf

Return(importe)
