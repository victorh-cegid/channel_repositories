'
'con la línea #716 = 0 se controla si le corresponde cobrar o no asignacion
'por hijo, en el caso de que el valor sea 0 el concepto valdrá 0 y de esta forma se grabará en el acumulado
'la cantidad correcta de prenatales abonados.
'

IF SAR_PR_AS_PRENATAL = 0 OR SAR_FAMILIARES.COUNT() = 0 THEN
   Return(0)
ENDIF

contador = 0
primerreg = 0
ultimoreg = SAR_FAMILIARES.COUNT() - 1

FOR I = primerreg TO ultimoreg
    SAR_FAMILIARES.MOVETO(I)
    
    IF SAR_FAM_A_CARGO.COUNT() > 0 THEN    
        primerreg1 = 0
        ultimoreg1 = SAR_FAM_A_CARGO.COUNT() - 1
        FOR J = primerreg1 TO ultimoreg1
            SAR_FAM_A_CARGO.MOVETO(J)
            tipoasig = SAR_FAM_A_CARGO.SAR_ID_TIPO_ASIG
            f_embzo  = SAR_FAM_A_CARGO.SAR_DT_INICIO_EMBAR
            fec_cert = SAR_FAM_A_CARGO.SAR_DT_PRES_CERT
        NEXT
    ENDIF    
         parent   = SAR_FAMILIARES.STD_ID_ACT_DEP_TYPE
         f_fin    = SAR_FAMILIARES.STD_DT_END     
         pago = 0
     
     
         IF tipoasig = "01" AND parent = "4" AND f_fin >= SAR_FAMILIARES.SAR_DT_ALLOC_END THEN
             IF f_embzo <> 0 AND (f_embzo + 270) > SAR_FAMILIARES.SAR_DT_ALLOC_START THEN
                 IF fec_cert <> 0 AND fec_cert <= SAR_FAMILIARES.SAR_DT_ALLOC_END THEN
                     IF (f_embzo + 90) < SAR_FAMILIARES.SAR_DT_ALLOC_START THEN
                         pago = 1
                     ELSE
                         IF (f_embzo + 90) >= SAR_FAMILIARES.SAR_DT_ALLOC_START AND (f_embzo + 90) <= SAR_FAMILIARES.SAR_DT_ALLOC_END THEN
                             pago = 3
                         ENDIF
                     ENDIF
                 ENDIF
             ENDIF
         ENDIF

         IF pago > 0 THEN
             Return(pago)
         ENDIF  
         
NEXT

Return(pago)
