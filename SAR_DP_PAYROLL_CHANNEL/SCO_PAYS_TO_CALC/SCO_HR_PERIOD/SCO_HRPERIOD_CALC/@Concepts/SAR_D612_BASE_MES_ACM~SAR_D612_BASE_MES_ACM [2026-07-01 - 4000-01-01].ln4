'Carga nodo acum cotiz
SAR_MES_COTIZ_SIND.DESTROY()
SAR_MES_COTIZ_SIND.SCO_DT_START = DxDate(1,1,DxYear(SCO_DT_ALLOCATION)-1)
SAR_MES_COTIZ_SIND.SCO_DT_END = DxDate(31,12,DxYear(SCO_DT_ALLOCATION)+1)
SAR_MES_COTIZ_SIND.LOAD_BLK()
'fin carga nodo acum

valorMes = SAR_D612_TOT_BASE
valorAcm = SAR_MES_COTIZ_SIND[0].SAR_D612_TOT_BASE

Return Round(valorMes + valorAcm,SAR_NUM_DEC)
