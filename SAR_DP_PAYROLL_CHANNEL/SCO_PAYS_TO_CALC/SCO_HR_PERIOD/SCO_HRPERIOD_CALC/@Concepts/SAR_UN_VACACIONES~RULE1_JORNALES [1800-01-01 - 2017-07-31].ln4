IF SAR_TP_IMPUT = "2" OR SAR_TP_IMPUT = "99" THEN 
    Return(0)
ENDIF

'Obtengo la fecha de inicio y fin de cada tramo.

INICIO_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysStartDate
FIN_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA_AUX..SysEndDate

'para que se ejecuten antes de hacer la asignacion y funcione en revision
aux = SAR_DIAS_VACACIONES       'Vacaciones

dias_vac = 0        'dias de descuento vacaciones
dias_lic_vac = 0    'dias licencia vacaciones

REG_AUSENTISMOS = SAR_REAL_TIME_PERIOD.COUNT()
REG_HS_AUSENCIA = 0

'Se busca si existe un registro para esta paga en la tabla Vacaciones a Descontar.
'En caso que exista se elimina.
'--------------------------------------------------------------------------------.  
IF REG_AUSENTISMOS = 0 THEN
    SAR_VAC_DELETE.begin()
    if SAR_VAC_DELETE.COUNT() > 0 Then
        primerreg_vac = 0
        ultimoreg_vac = SAR_VAC_DELETE.COUNT() - 1
        FOR  I = primerreg_vac  TO  ultimoreg_vac 
             SAR_VAC_DELETE.MOVETO(I)
             fec_pago_del = SAR_VAC_DELETE.SCO_DT_PAY
             if fec_pago_del = SCO_DT_PAYMENT Then
                'Se elimina el registro existente.
                '--------------------------------.
                SAR_VAC_DELETE.Deleteregister()
                '--------------------------------.
             endif
        NEXT
    endif
ENDIF

IF REG_AUSENTISMOS = 0 THEN
    IF REG_HS_AUSENCIA = 0 THEN
        Return(0)
    ENDIF
ENDIF

'Ahora contabilizamos las ausencias diarias que se cargan a nivel de period

primerreg = 0
ultimoreg = SAR_REAL_TIME_PERIOD.COUNT() - 1

'Asigno las fechas de inicio y fin de tramo

fec_ini_paga = INICIO_TRAMO
fec_fin_paga = FIN_TRAMO
FOR  J = primerreg  TO  ultimoreg 
    SAR_REAL_TIME_PERIOD.MOVETO(J)
    motivoabs = FORMAT(SAR_REAL_TIME_PERIOD.SCO_ID_INCIDENCE,0)
    fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
    fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END
    t_unid = SAR_REAL_TIME_PERIOD.SCO_ID_TIME_UNIT
    unid = SAR_REAL_TIME_PERIOD.SCO_UNITS
    '
    'Contabilizo la cantidad de dias y si el tipo de salario es Horario, 
    'traspaso las unidades a horas
    '
    IF SAR_TIPO_SALARIO = "003" THEN
        IF SCO_NUM_HOURS_THEO > 0 THEN
            IF fec_fin_abs > fec_fin_paga then
               fec_fin_abs = fec_fin_paga
            ENDIF
            IF fec_ini_abs < fec_ini_paga then
               fec_ini_abs = fec_ini_paga
            ENDIF
        ENDIF
        IF motivoabs = "9" THEN
            dias_vac = dias_vac + SAR_CALC_HORAS_TEORICAS(fec_ini_abs,fec_fin_abs)
        ENDIF
    fec_ini_abs_a = SAR_REAL_TIME_PERIOD.SCO_DT_START        
    ENDIF
NEXT

'
'Contabilizamos las vacaciones
'                             
primerreg = 0
ultimoreg = SAR_VACACIONES.COUNT() - 1
FOR G = primerreg  TO  ultimoreg 
    SAR_VACACIONES.MOVETO(G)
    motivoabs = FORMAT(SAR_VACACIONES.SCO_ID_INCIDENCE,0)
    fec_ini_abs = SAR_VACACIONES.SCO_DT_START
    fec_fin_abs = SAR_VACACIONES.SCO_DT_END

    'Calculo de los dias a pagar de vacaciones
    IF SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC <= fec_ini_abs AND fec_ini_abs <= SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC THEN
        fec_ini_tramo = INICIO_TRAMO
        fec_fin_tramo = FIN_TRAMO
        IF FIN_TRAMO = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC THEN
            fec_fin_tramo = fec_fin_abs
        ENDIF

        IF SAR_HS_DIARIAS_PROM > 0 THEN
            dias_lic_vac = dias_lic_vac + CommonTime(fec_ini_tramo , fec_fin_tramo , fec_ini_abs , fec_fin_abs) * SAR_HS_DIARIAS_PROM 
        ELSEIF SCO_NUM_HOURS_THEO > 0 THEN
        'Variables
            nTotTheoHours = 0
            nTotTheoDays = 0
            nTotTheoSat = 0
            nTotTheoSun = 0
            nTotCalHours = 0
            nTotCalDays = 0
            nTotCalSat = 0
            nTotCalSun = 0
            nExecution = 3 'We execute both, theoretical time and calendars
            DtStart = max(fec_ini_tramo,fec_ini_abs)
            DtEnd = min (fec_fin_tramo,fec_fin_abs)
    
            SCO_THEORETICAL_TIME!SCO_TT_HR_THEOR_TIME.SCO_CALC_THEOR_TIME(SCO_ID_HR, SCO_OR_HR_PERIOD,NullValue(),DtStart,DtEnd,nExecution,nTotTheoHours,nTotCalHours,nTotTheoDays,nTotCalDays,nTotTheoSat,nTotCalSat,nTotTheoSun,nTotCalSun)
            dias_lic_vac = dias_lic_vac + nTotTheoHours
        ENDIF
    ENDIF
NEXT


tipo_paga = SAR_PAYS_TO_CALC.SCO_PAY_TYPE_PAYM
FECHA_FIN_TRAMO = FIN_TRAMO

'Calculo los dias del tramo
dias_tramo = (FECHA_FIN_TRAMO - INICIO_TRAMO) + 1

'Calculo los dias del tramo real
dias_tramo_real = FIN_TRAMO - INICIO_TRAMO + 1


IF dias_vac > 0 And  SAR_TIPO_SALARIO <> "001" THEN 

    'Se busca si existe un registro para esta paga en la tabla Vacaciones a Descontar.
    '--------------------------------------------------------------------------------.  
    SAR_VAC_DELETE.begin()
    if SAR_VAC_DELETE.COUNT() > 0 Then
        primerreg_vac = 0
        ultimoreg_vac = SAR_VAC_DELETE.COUNT() - 1
        FOR  I = primerreg_vac  TO  ultimoreg_vac 
             SAR_VAC_DELETE.MOVETO(I)
             fec_pago_del = SAR_VAC_DELETE.SCO_DT_PAY
             fec_inicio_del = SAR_VAC_DELETE.DT_START_VAC
           
             if fec_pago_del = SCO_DT_PAYMENT and  fec_inicio_del <> fec_ini_abs Then
                'Se elimina el registro existente.
                '--------------------------------.
                SAR_VAC_DELETE.Deleteregister()
                '--------------------------------.
             endif
        NEXT
    Endif
    '--------------------------------------------------------------------------------.
        
    If (FIN_TRAMO = SAR_HR_PERIOD.SCO_DT_ALLOC_END) and (dias_vac > 0) Then
        pos = 0
        fin_inc = 0

        if SAR_VAC_DESC.count() = 0 then 
            SAR_VAC_DESC.SAR_DT_ALLOC_START = fec_ini_abs               
            SAR_VAC_DESC.SCO_ID_INCIDENCIA = "9"               
            SAR_VAC_DESC.LOAD_BLK()
        endif
        If dias_tramo_real < dias_lic_vac Then
            SAR_VAC_DESC.begin()
            'Se verifica si existe el registro con datos de la paga, si no existe inserto el registro.
            IF SAR_VAC_DESC.count()=0 THEN 
                'Se inserta nuevo registro en Vacaciones a Descontar
                SAR_VAC_DESC.Addregister()
                SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
                SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
                SAR_VAC_DESC.SCO_DT_PAY = SCO_DT_PAYMENT
                SAR_VAC_DESC.SCO_DT_ALLOC = SCO_DT_ALLOCATION
                IF SAR_TIPO_SALARIO = "003" THEN
                    SAR_VAC_DESC.SAR_HORAS_TOMADAS = dias_lic_vac
                    SAR_VAC_DESC.SAR_HORAS_DESCONT = dias_vac
                ELSE
                    SAR_VAC_DESC.SAR_DIAS_TOMADOS = dias_lic_vac
                    SAR_VAC_DESC.SAR_DIAS_DESCONT = dias_vac
                ENDIF
                'A continuacion el campo nuevo: la ID de Incidencia = 9                           
                SAR_VAC_DESC.SCO_ID_INCIDENCE = "9"
            ELSE
             'Se actualizan los datos, dado que el registro existe.   
                SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
                SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
                IF SAR_TIPO_SALARIO = "003" THEN
                    SAR_VAC_DESC.SAR_HORAS_TOMADAS = dias_lic_vac
                    SAR_VAC_DESC.SAR_HORAS_DESCONT = dias_vac
                ENDIF
            Endif
        Else
            'Se busca el registro con el inicio de la incidencia.                 
            pos =  SAR_VAC_DESC.FINDREGISTER("DT_START_VAC",fec_ini_abs,equal,0)
            IF POS <> -1 tHEN
                SAR_VAC_DESC.moveto(pos)
                IF SAR_TIPO_SALARIO = "003" THEN
                    dias_tomados = SAR_VAC_DESC.SAR_HORAS_TOMADAS 
                    dias_descontados = SAR_VAC_DESC.SAR_HORAS_DESCONT
                ENDIF
                fec_paga =  SAR_VAC_DESC.SCO_DT_PAY 
                fec_imput =  SAR_VAC_DESC.SCO_DT_ALLOC 
 
                'Se verifica si el fin de la incidencia corresponde a la paga que se esta calculando.
                'En caso afirmativo, fin_inc valdra 1, de lo contrario valdra 0.
                '------------------------------------------------------------------------------------------------------------
                fin_inc = commontime(SAR_HR_PERIOD.SCO_DT_ALLOC_START, SAR_HR_PERIOD.SCO_DT_ALLOC_END,fec_fin_abs,fec_fin_abs)
                '------------------------------------------------------------------------------------------------------------
                'Se verifica que la paga calculada exista en la tabla SAR_VAC_DESC, 
                'para analizar si corresponde insertar un nuevo registro o actualizarlo.
                If (fec_paga <> SCO_DT_PAYMENT)  then
                    'Se inserta nuevo registro en Vacaciones a Descontar 
                    SAR_VAC_DESC.Addregister()
                    SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
                    SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
                    IF SAR_TIPO_SALARIO = "003" THEN
                       SAR_VAC_DESC.SAR_HORAS_TOMADAS = dias_tomados
                    ENDIF                         
                    if fin_inc = 1 then
                        'El fin de la incidencia corresponde al mes de la paga que se esta calculando.
                        'Por lo que se debe modificar dias_vac que es el valor a descontar en la paga actual
                        'de manera que coincida con los dias reales pagos de la incidencia.
                    
                        IF SAR_TIPO_SALARIO = "003" THEN
                             SAR_VAC_DESC.SAR_HORAS_DESCONT = dias_tomados
                        ENDIF
                        dias_vac = dias_tomados - dias_descontados
                    else
                        IF SAR_TIPO_SALARIO = "003" THEN
                            SAR_VAC_DESC.SAR_HORAS_DESCONT = dias_descontados + dias_vac
                        ENDIF                         
                    endif
                    SAR_VAC_DESC.SCO_DT_PAY = SCO_DT_PAYMENT
                    SAR_VAC_DESC.SCO_DT_ALLOC = SCO_DT_ALLOCATION
                    'A continuacion el campo nuevo: la ID de Incidencia = 9  
                    SAR_VAC_DESC.SCO_ID_INCIDENCE = "9"
                Else
                    'Se elimina el registro existente.
                    '--------------------------------.
                    SAR_VAC_DESC.Deleteregister()
                    '--------------------------------.
                    
                    'Se verifica si es revision.
                    if SCO_DT_PAYMENT = SCO_DT_ALLOCATION then
                        'Se obtiene la posicion siguiente.
                        '--------------------------------.
                        SAR_VAC_DESC.getcurrent()
                        SAR_VAC_DESC.moveto(pos + 1)
                        '--------------------------------.
                        If(SAR_VAC_DESC.isEOF() = FALSE)Then
                            IF SAR_TIPO_SALARIO = "003" THEN
                                dias_tomados = SAR_VAC_DESC.SAR_HORAS_TOMADAS  
                                dias_descontados = SAR_VAC_DESC.SAR_HORAS_DESCONT
                            ENDIF                        
                        EndIf
                    else
                        'Se obtiene la posicion.
                        '--------------------------------.
                        SAR_VAC_DESC.getcurrent()
                        SAR_VAC_DESC.moveto(pos + 2)
                        '--------------------------------.
                        If(SAR_VAC_DESC.isEOF() = FALSE)Then
                            IF SAR_TIPO_SALARIO = "003" THEN
                                dias_tomados = SAR_VAC_DESC.SAR_HORAS_TOMADAS  
                                dias_descontados = SAR_VAC_DESC.SAR_HORAS_DESCONT
                            ENDIF                        
                        EndIf   
                    endif    
                    
                    'Se inserta nuevo registro en Vacaciones a Descontar
                    SAR_VAC_DESC.Addregister()
                    SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
                    SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
                    IF SAR_TIPO_SALARIO = "003" THEN
                        SAR_VAC_DESC.SAR_HORAS_TOMADAS = dias_tomados
                    ENDIF                    
                    if fin_inc = 1 then
                        'El fin de la incidencia corresponde al mes de la paga que se esta calculando.
                        'Por lo que se debe modificar dias_vac que es el valor a descontar en la paga actual
                        'de manera que coincida con los dias reales pagos de la incidencia.
                         SAR_VAC_DESC.SAR_DIAS_DESCONT = dias_tomados
                         dias_vac = dias_tomados - dias_descontados                     
                    else
                        IF SAR_TIPO_SALARIO = "003" THEN
                        'Ver si los dias_vac en que unidades llegan
                            SAR_VAC_DESC.SAR_HORAS_DESCONT = dias_descontados + dias_vac
                        ENDIF
                    endif
                    SAR_VAC_DESC.SCO_DT_PAY = SCO_DT_PAYMENT
                    SAR_VAC_DESC.SCO_DT_ALLOC = SCO_DT_ALLOCATION
                    'A continuacion el campo nuevo: la ID de Incidencia = 9  
                    SAR_VAC_DESC.SCO_ID_INCIDENCE = "9"                        
                EndIf
               '---------------------------------------------------------------------------------------
            EndIf
        EndIf
    EndIf
EndIf
'*----------------------------------


'Asigno las cantidades obtenidas al concepto correspondiente
SAR_DIAS_VACACIONES = dias_vac


Return(dias_lic_vac)
