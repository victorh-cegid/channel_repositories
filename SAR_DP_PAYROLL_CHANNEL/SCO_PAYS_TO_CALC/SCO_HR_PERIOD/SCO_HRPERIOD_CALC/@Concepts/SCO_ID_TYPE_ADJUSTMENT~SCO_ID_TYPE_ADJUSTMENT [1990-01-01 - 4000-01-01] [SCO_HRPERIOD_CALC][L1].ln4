SCO_H_TYPE_ADJ.Begin()
If SCO_H_TYPE_ADJ.IsEof()=FALSE then
	TYPE=SCO_H_TYPE_ADJ.SCO_ID_TYPE_ADJUST
ElseIf SCO_HR_PERIOD.SCO_IS_PAL = 0 then
	SetLog(-1,1,101,21,SCO_ID_HR,SCO_OR_HR_PERIOD,SCO_DT_ALLOCATION,SCO_PAYS_TO_CALC.SCO_NM_PAY_FREQUENCY)
	SCO_HR_PERIOD.SCO_ERROR=1
	type="-1"
Else
	type="-1"
endif

RETURN(TYPE)
