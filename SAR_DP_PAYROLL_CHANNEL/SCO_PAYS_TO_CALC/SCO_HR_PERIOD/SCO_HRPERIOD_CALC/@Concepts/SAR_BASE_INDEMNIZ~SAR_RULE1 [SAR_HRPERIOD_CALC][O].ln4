valor = 0

If SAR_ES_BAJA <> 1 Then Return(0)

'Si el cliente quiere mantener criterio anterior por ser mas favorable
'o la baja es anterior al 6/3/2026, aplicamos el calculo anterior
indAplicaRl = SAR_IND_INDEMNIZ_RL26
If SAR_FECHA_BAJA < DxDate(6,3,2026) Then indAplicaRl = 0

If indAplicaRl = 0 Then
    aux = SAR_M_REMUN_INDEM
    base = 0
    valor = 0
    
    If SAR_TIPO_SALARIO = "001" Then
        SAR_ACM_12_INDEM.BEGIN()
        If SAR_ACM_12_INDEM.COUNT() > 0 Then
            base = SAR_ACM_12_INDEM.SAR_TOTAL_P_SAC   
        EndIf
        base = Max(SAR_TOTAL_P_SAC,base)
    Else
        SAR_ACM_12_INDEM.BEGIN()
        If SAR_ACM_12_INDEM.COUNT() > 0 Then
            base = SAR_ACM_12_INDEM.SAR_M_REMUN_INDEM   
        EndIf
        base = Max(SAR_M_REMUN_INDEM,base)
    EndIf
    valor = base
    
'RL 2026, la base indemnizatoria se compone de una parte fija y otra variable
Else
    'Si vale 0 significa que el importe de la base indemnizatoria sera la mejor entre calcularla incluyendo el mes de la baja o sin incluirlo, en ambos casos se calculan por un maximo de 12 meses.
    'Si vale 1 significa que el importe de la base indemnizatoria sera calculado sin incluir el mes de la baja.
    'Si vale 2 significa que el importe de la base indemnizatoria sera calculado incluyendo el mes de la baja.
    'Siempre es maximo 12 meses
    indMesBaja = ToInt(Mid(ToString(SAR_IND_INDEMNIZ_RL26,0),1,1))

    valorSinMesBaja = SAR_INDEM_ANTIG_FIJA + SAR_INDEM_ANTIG_VAR
    valorConMesBaja = SAR_INDEM_ANTIG_FIJA_IMB + SAR_INDEM_ANTIG_VAR_IMB
    
    If indMesBaja = 0 Then
        valor = Max (valorSinMesBaja, valorConMesBaja)
    ElseIf indMesBaja = 1 Then
        valor = valorSinMesBaja
    ElseIf indMesBaja = 2 Then
        valor = valorConMesBaja
    EndIf
EndIf

Return(valor)
