' No se ejecuta en las pagas extras, salvo si en las Pagas Extras de Aguinaldo
If (SAR_TP_IMPUT = "2") AND SAR_IND_AGUINALDO = 0 Then Return(0)

IF SAR_TP_IMPUT = "99" THEN 
    Return(0)
ENDIF

id_Incidencia = "34" 'Horas extras al 100%
horas = 0

'Tramos
INICIO_TRAMO = SAR_TOT_P_COMP_EA_AUX..SysStartDate
FIN_TRAMO = SAR_TOT_P_COMP_EA_AUX..SysEndDate

SAR_HR_ROLE.BEGIN()
WHILE SAR_HR_ROLE.ISEOF() = FALSE

	SAR_REAL_TIME_PER_ROLE.BEGIN()
	IF GetCurrent ( ) = -1 THEN
		SAR_REAL_TIME_PER_ROLE.LOAD_BLK()
	ENDIF	

	'A?adimos filtro RAM al nodo cargado para quedarnos exclusivamente con los registros de horas extras al 100%
	sFilter = "If SCO_ID_INCIDENCE = ARG_SCO_ID_INCIDENCE Then Return(M4_TRUE) Else Return(M4_FALSE)"
	SAR_REAL_TIME_PER_ROLE.ADDFILTER(sFilter, M4_TRUE, "ARG_SCO_ID_INCIDENCE", id_Incidencia)
	
	'Si hay registros de horas extras al 100% los recorremos para obtener las horas
	SAR_REAL_TIME_PER_ROLE.BEGIN()
	WHILE SAR_REAL_TIME_PER_ROLE.ISEOF() = FALSE
	  'fecha de inicio del ausentismo este comprendida en el tramo que se esta procesando.
        IF INICIO_TRAMO <= SAR_REAL_TIME_PER_ROLE.SCO_DT_START AND SAR_REAL_TIME_PER_ROLE.SCO_DT_START <=  FIN_TRAMO THEN 
		horas = horas + SAR_REAL_TIME_PER_ROLE.SCO_UNITS
        ENDIF
	  SAR_REAL_TIME_PER_ROLE.GONEXT()
      WEND
	'Se elimina el filtro RAM aplicado al nodo
	SAR_REAL_TIME_PER_ROLE.REMOVEFILTER()
	SAR_HR_ROLE.GONEXT()
WEND 

'Return las horas extras al 100%
Return(horas)
