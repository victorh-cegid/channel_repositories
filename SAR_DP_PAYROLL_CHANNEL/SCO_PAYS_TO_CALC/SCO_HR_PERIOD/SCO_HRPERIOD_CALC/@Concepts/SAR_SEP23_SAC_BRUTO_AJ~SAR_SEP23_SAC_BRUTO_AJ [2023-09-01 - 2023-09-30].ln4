'Devuelve ajuste 12avas de julio y agosto en paga de septiembre
sac = 0
sac_oe = 0
remun_prom = SAR_PROM_27617_SAC2
If remun_prom <= SAR_TOPE_DEI Then
    sac = SAR_ACM_6_MESES_SUMA[0].SAR_B_SAC_MES_RG3976
    sac_oe = SAR_ACM_6_MESES_SUMA[0].SAR_B_PLUR_SAC_MES
    
    sac_aju_mismo_mes = SAR_ACM_MES_ACTUAL_DIF[0].SAR_SEP23_SAC_BRUTO_AJ
    sac_aju_mismo_mes_oe = SAR_ACM_MES_ACTUAL_DIF[0].SAR_SEP23_SAC_BRUTO_AJ_OE    

    'Varias pagas calculadas en el mes de septiembre, el ajuste se debe hacer una sola vez
    If sac_aju_mismo_mes <> 0 Or sac_aju_mismo_mes_oe <> 0 Then
        sac = 0
        sac_oe = 0
    EndIf
    
    'Si es baja e iba a quedar exento sin este beneficio, no está afectado por el decreto y por tanto no se expone el concepto en el recibo
    esBaja = 0
    If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then esBaja = 1
    If esBaja = 1 Then
        promAnual = SAR_PROM_27617_BONOS
        If promAnual <= 880000 Then
            sac = 0
            sac_oe = 0
        EndIf
    EndIf
    
EndIf
SAR_SEP23_SAC_BRUTO_AJ_OE = Round(sac_oe,SAR_NUM_DEC)
Return Round(sac,SAR_NUM_DEC)
