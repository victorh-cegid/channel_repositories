IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
    tope = SAR_TOPE_JUBIL - SAR_BASE_ART_JUB
    tope = tope / SAR_DIAS_NORM_COTIZ * (SAR_DIAS_NORM_COTIZ - SAR_DIAS_VACACIONES)  
ELSE
    SAR_ACM_ACT_CONTRIB.BEGIN()
    'Resto al tope lo acumulado en el mes
       
    vac_periodo = SAR_ACM_ACT_CONTRIB.SAR_DIAS_VACACIONES + SAR_DIAS_VACACIONES
    
    tope = (SAR_TOPE_JUBIL - SAR_BASE_ART_JUB) / SAR_DIAS_NORM_COTIZ *(SAR_DIAS_NORM_COTIZ - vac_periodo)
    tope = tope -  SAR_ACM_ACT_CONTRIB.SAR_REM_IMPO_JUB
    
        
ENDIF
IF SAR_TP_IMPUT = "2" THEN RETURN(0)

real= SAR_TOT_DEV_COTIZ 
base = Max(real,0)
base = Min(tope,base)

'Horas Extras RG3976
edad = SAR_EDAD
base_extras_trib = SAR_TOT_HS_EX_IG
base_extras_exen = SAR_TOT_HS_EX_EX_IG
valor_trib = 0
valor_exen = 0
IF edad >= 18 THEN
    porc = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA / 100)
    'Si estamos en tope SIPA, hacemos la proporcion para hallar la parte del descuento que corresponde
    If base = tope and real <> 0 Then
        desc_tot_jub = base * (porc/100)
        porc_prop_trib = base_extras_trib/real
        porc_prop_exen = base_extras_exen/real
        valor_trib = desc_tot_jub * porc_prop_trib
        valor_exen = desc_tot_jub * porc_prop_exen
        If SCO_PAY_FREQ_ALLOC = "003" Then
            valor_trib = 0
            valor_exen = 0
        EndIf
    Else
        valor_trib = base_extras_trib * porc / 100
        valor_exen = base_extras_exen * porc / 100
    EndIf
ENDIF

'asignamos los valores de los descuentos tributable y exento.
SAR_JUB_HS_FINDE_TRIB = valor_trib
SAR_JUB_HS_FINDE_EXEN = valor_exen
'Fin horas extras RG3976

RETURN(base)
