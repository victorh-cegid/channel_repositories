'Se filtra la paga extra de vacaciones
If SAR_TP_IMPUT = "77" Then Return(0)

IF SAR_IND_REM9_SIN_TOPE = 1 THEN 'Calculo sin tope
    aux = SAR_ACCIDENTE
    diasart = SAR_DIAS_ART
    base = SAR_PRESTACION_ART
ELSE
    IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
        tope = SAR_TOPE_COTIZ
    ELSE
        SAR_ACM_ACT_CONTRIB.BEGIN()
        'resto al tope lo acumuldo en el mes
        tope = SAR_TOPE_COTIZ - SAR_ACM_ACT_CONTRIB.SAR_BASE_COTIZ_ART
    ENDIF
    
    aux = SAR_ACCIDENTE
    diasart = SAR_DIAS_ART
    
    IF diasart = 0 THEN
        basetop = 0
    ELSE
        basetop = tope / SAR_DIAS_NORM_COTIZ * diasart
    ENDIF
    
    real = SAR_PRESTACION_ART
    
    IF real < basetop THEN
        base = real 
    ELSE
        base = basetop
    ENDIF     
ENDIF

Return(base)
