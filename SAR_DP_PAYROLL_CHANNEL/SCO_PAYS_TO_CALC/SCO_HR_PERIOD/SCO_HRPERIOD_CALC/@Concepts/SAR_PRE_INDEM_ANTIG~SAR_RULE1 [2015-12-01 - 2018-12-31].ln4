If SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON = "017" Then Return(0)

' En caso de que sea una paga extra de vacaciones
If SAR_TP_IMPUT = "77" Then Return(0)

' Se condiciona para que no tome Valor si estamos en presencia de la paga extra de sac de aguinaldo
If SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1 Then Return(0)

precio = SAR_BASE_INDEMNIZ

IF SAR_TOPE_INDEMNIZ > 0 THEN
    precio = Min(SAR_BASE_INDEMNIZ, SAR_TOPE_INDEMNIZ)
ENDIF

precio   = precio * SAR_ANTIG_INDEMNIZ
indemmin = SAR_BASE_INDEMNIZ
precio   = Max(indemmin,precio)

RETURN(precio)
