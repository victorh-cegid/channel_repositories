'dependencias
a = SAR_REMUN_IMPO_OS

IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN Return(0)
If SAR_TP_IMPUT = "77" And SAR_IND_PAGA_ESP_VAC = 0 Then Return(0)
If (SAR_TP_IMPUT = "1" or SAR_TP_IMPUT = "3" or SAR_TP_IMPUT = "4") And SAR_IND_PAGA_ESP_VAC = 1 Then Return(0)

porc    = SAR_PORC_ADIC_O_SOC - (SAR_PORC_ADIC_O_SOC * SAR_PP_AP_OB_SOC / 100)
precio  = SAR_VAC_IMPO_OS * porc / 100
valor   = precio * SAR_FAM_CARGO_OS

IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF

Return(valor)
