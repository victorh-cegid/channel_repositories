'Se obtiene el valor 0 de la base del impuesto por Decreto 1242/2013 

If(SAR_RANGO_REM_IG_2015 = 1)Then
    If (SAR_BASE_IMPUESTO > 0) and (SAR_IG_DEC142_AUX = 0) Then           
        SAR_BENEF_IG_DEC1242_2013 = SAR_BASE_IMPUESTO
        SAR_IG_DEC142_AUX = SAR_BENEF_IG_DEC1242_2013           
        AUX = SAR_BASE_IMPUESTO()   
    Endif
    Return(SAR_BASE_IMPUESTO)
Else   
   Return(SAR_BASE_IMPUESTO)
EndIf
