'dependencias
a = SAR_TOT_REMUN_27617 + SAR_REM_27617_DEI_DEV + SAR_REM_27617_DEI_PERC

orientacion = 3
'Aunque la norma indica que aplica para el devengado, para jornalizados se mantiene la fecha IG por coherencia
'Si se considerase aplicar desde el devengado puede cambiarse fec_aplica por SCO_DT_ALLOCATION, pero generaria un cálculo incoherente:
fec_aplica = SAR_FEC_IMPUT_IG
mes_ini = 1
mes_fin = 12
promedio = 0

SAR_CALCULA_PROM_27617(orientacion,mes_ini,mes_fin,promedio)

Return Round(promedio,SAR_NUM_DEC)
