If SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" Or SAR_TP_IMPUT = "99" Or (SAR_TP_IMPUT = "3" And SAR_ES_BAJA = 0) Then Return(0)
valor_act = SAR_ACM_IG_ANIO_ACT[0].SAR_IMP_RET_IG_ANO_ANT
If valor_act <> 0 Then Return(0)

'Solo vamos a buscar la reliquidacion para la paga anual si estoy en una paga normal. No queremos que se calcule en retro
valor = 0
If SCO_DT_ALLOCATION = SCO_DT_PAYMENT And SAR_MES_IMPO_RET = DxMonth(SAR_FEC_IMPUT_IG) Then
    valor = SAR_ACM_IG_ANIO_ANT[0].SAR_SALD_RET_GAN_ST
EndIf

Return(valor)
