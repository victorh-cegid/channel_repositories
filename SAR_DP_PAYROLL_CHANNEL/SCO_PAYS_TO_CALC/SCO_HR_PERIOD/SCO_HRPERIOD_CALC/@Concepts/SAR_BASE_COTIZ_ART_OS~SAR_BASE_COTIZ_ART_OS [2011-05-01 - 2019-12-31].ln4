IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
    tope = SAR_TOPE_COTIZ
    tope_min = SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO
ELSE
    SAR_ACM_ACT_CONTRIB.BEGIN()
    'resto al tope lo acumuldo en el mes
    tope = SAR_TOPE_COTIZ - SAR_ACM_ACT_CONTRIB.SAR_BASE_COTIZ_ART_OS
    tope_min = (SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO) - SAR_ACM_ACT_CONTRIB.SAR_BASE_COTIZ_ART_OS
ENDIF
'aux = #520
aux = SAR_ACCIDENTE
diasart = SAR_DIAS_ART
IF diasart = 0 THEN
    basetop = 0
ELSE
    basetop = tope / SAR_DIAS_NORM_COTIZ * diasart
ENDIF

real = SAR_PRESTACION_ART

IF real < basetop THEN
    base = real 
ELSE
    base= basetop
ENDIF  

'Comparamos con el minimo imponible solo si la base es >0
basemin = tope_min / SAR_DIAS_NORM_COTIZ * diasart
IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
   If (base > 0)Then  
     base = Max(basemin, base)
   EndIf
Else
   If (base > 0)Then  
     base = Max(basemin, base)
   Else
     base = 0  
   EndIf     
EndIf  


Return(base)
