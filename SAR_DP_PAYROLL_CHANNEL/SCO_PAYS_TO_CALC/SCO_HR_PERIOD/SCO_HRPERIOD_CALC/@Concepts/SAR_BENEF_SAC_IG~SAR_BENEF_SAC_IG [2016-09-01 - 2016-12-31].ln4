If SAR_IND_EXEN_IG <> 1 Then Return(0)

If (SCO_DT_PAYMENT = SCO_DT_ALLOCATION) Then
    If SAR_SAC_NETO = 0 Then Return(0)
EndIf

'No se ejecuta en las pagas extras
'En caso de pagas retroactivas, se obtiene el valor de la paga original
val_paga_original = 0
IF (SCO_DT_PAYMENT <> SCO_DT_ALLOCATION) THEN
        SCO_AC_HR_PERIOD_READ_1.BEGIN()
    ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()- 1
    FOR I = 0 TO ULTIMO_REG 
       SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
       IF SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT = SCO_DT_ALLOCATION AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_DT_ALLOCATION THEN
              val_paga_original = SCO_AC_HR_PERIOD_READ_1.SAR_BENEF_SAC_IG
       ENDIF
    NEXT
    'En casos retroactivos que no sean baja, se retorna el valor de la paga original para que por comportamiento en diferencias resulte calculando 0.
    'Es decir en pagas retroactivas no se calcula el beneficio.
    if SAR_ES_BAJA <> 1 Then
     Return(val_paga_original)
    endif
ENDIF

If (SAR_TP_IMPUT = "2") Then Return(0)

'No se ejecuta en la primera quincena
IF (SAR_TP_IMPUT = "3" AND SAR_ES_BAJA = 0) THEN RETURN (0)

diferencia = 0

IF SAR_IND_EXEN_IG = 1 AND SAR_IND_EXEN_IG_EMPRE = 1 THEN
    
      se_aplico_antes = 0        
	'-------------------------------------------------------------
	'Recorro acumulado de lectura para armar una TI de IG 
	'-------------------------------------------------------------
	SCO_AC_HR_PERIOD_READ_1.BEGIN()
	ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()

	I = ULTIMO_REG - 1 

	WHILE I >= 0 
		SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
			
		IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION THEN    
			se_aplico_antes =  se_aplico_antes + SCO_AC_HR_PERIOD_READ_1.SAR_BENEF_SAC_IG + SCO_AC_HR_PERIOD_READ_1.SAR_BENEF_SAC_IG_P_TOPE
		ENDIF
		I = I - 1
	Wend

     'Alta a partir de Julio, se calcula el beneficio íntegro solo una vez, el primer mes que presenta el beneficio
      IF se_aplico_antes <> 0 AND  DxMonth (SAR_FECHA_ALTA) >= 7 And DxYear(SAR_FECHA_ALTA) = 2016 Then 
           return (0)
      Endif
	
	'Obtenemos la base sin deducción por SAC  
	base = SAR_BASE_IMPUESTO + SAR_SAC_NETO  - SAR_DIF_TOPE_CMA_SAC_IG - SAR_DIF_TOPE_HONO_SAC_IG -SAR_DIF_TOPE_DONAC_SAC_IG

	If (base < 0) Then Return(0)

	'El porcentaje correspondiente a la base sin deducción por SAC:
	val_porc = SAR_IMPUESTO.SAR_RETORNA_PORCENTAJE(base,SAR_FEC_PAGO_IG,ID_CURRENCY)

	'La cuota fija correspondiente a la base sin deducción por SAC:    
	val_cuota_fija = SAR_IMPUESTO.SAR_RETORNA_CUOTA_FIJA(base,SAR_FEC_PAGO_IG,ID_CURRENCY)

	'El valor en tablas correspondiente a la base sin deducción por SAC:    
	val_imp = SAR_IMPUESTO.SAR_RETORNA_VALOR(base,SAR_FEC_PAGO_IG,ID_CURRENCY)

	'El valor del impuesto correspondiente a la base sin deducción por SAC    
	valor_sin_sac = val_cuota_fija + val_porc * (base - val_imp) / 100

	If IsNull(valor_sin_sac) = M4_True Then valor_sin_sac = 0

	'Beneficio - Devolución IG SAC Ley 27.260, Art. 63
	diferencia = SAR_IMPUESTO_TOTAL - valor_sin_sac

      'Restamos lo aplicado en meses anteriores para obtener el beneficio mensual
	diferencia = diferencia - se_aplico_antes

ENDIF

'Paga de Reliquidación
If (SAR_TP_IMPUT = "99") Then
    ' Si ya se ha percibido beneficio no debe volver a percibirse en la reliquidacion IG.
    If se_aplico_antes <> 0 Then
        Return(0)
    EndIf
    SAR_BENEF_FINAL = diferencia
    Return(0)
EndIf

'En caso de bajas retroactivas,se debe aumentar el valor recalculado con el valor de la paga original,
'para que por comportamiento en diferencias resulte calculando el valor de la revisión, que es el valor correcto en baja.    
IF (SCO_DT_PAYMENT <> SCO_DT_ALLOCATION) AND (SAR_ES_BAJA = 1)THEN
     diferencia = diferencia + val_paga_original   
ENDIF

IF diferencia < 0  THEN
    Return(diferencia)
ELSE 
    Return(0) 'En el caso de que el beneficio resulte terminando un valor a retener, no se mostrara como beneficio
ENDIF
