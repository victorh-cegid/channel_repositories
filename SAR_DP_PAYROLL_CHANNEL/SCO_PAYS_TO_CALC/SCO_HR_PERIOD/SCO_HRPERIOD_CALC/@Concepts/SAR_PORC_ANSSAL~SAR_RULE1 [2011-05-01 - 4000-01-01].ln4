'Obtiene el porcentaje que le corresponde de ANSSAL para la obra social y el sueldo
'al tipo de obra social.


IF SAR_SLICE_UNIT..SysSliceNumber > 1 THEN
    base = SAR_REMUN_IMPO_OS..SYSTOTALSLICES(TOTAL_SUM) + SAR_BASE_COTIZ_ART_OS..SYSTOTALSLICES(TOTAL_SUM) + SAR_SAC_IMPO_OS..SYSTOTALSLICES(TOTAL_SUM) + SAR_VAC_IMPO_OS..SYSTOTALSLICES(TOTAL_SUM)
ELSE
IF SCO_PAY_FREQ_ALLOC = "004" THEN 'Frecuencia de pago mensual
    base = SAR_REMUN_IMPO_OS + SAR_BASE_COTIZ_ART_OS + SAR_SAC_IMPO_OS + SAR_VAC_IMPO_OS 
  Else
    If(DXDAY(SCO_DT_PAYMENT) <=15)Then
        base = SAR_REMUN_IMPO_OS + SAR_BASE_COTIZ_ART_OS + SAR_SAC_IMPO_OS + SAR_VAC_IMPO_OS 
    Else
        base = SAR_ACM_ACT_CONTRIB.SAR_REMUN_IMPO_OS + SAR_ACM_ACT_CONTRIB.SAR_BASE_COTIZ_ART_OS + SAR_ACM_ACT_CONTRIB.SAR_SAC_IMPO_OS + SAR_ACM_ACT_CONTRIB.SAR_VAC_IMPO_OS 
    EndIf
  EndIf  
ENDIF


IF SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC <= ToDate("2002-03-21") THEN
    tipo = "2"
ELSE
    tipo = SAR_ID_TIPO_OS 
ENDIF

porc = SAR_ANSSAL.SAR_RETORNA_VALOR(base,tipo,ID_CURRENCY)

RETURN(porc)
