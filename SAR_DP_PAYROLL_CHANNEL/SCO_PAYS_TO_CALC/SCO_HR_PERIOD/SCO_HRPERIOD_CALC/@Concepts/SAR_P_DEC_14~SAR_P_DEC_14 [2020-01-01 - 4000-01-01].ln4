'Decreto 14 2020. Recibe el importe por tabla de valor en este concepto. 
'En esta regla se aplica el coeficiente de jornada y se convierte en precio-hora para jornales
importe = SAR_P_DEC_14
coef = SAR_HRROLE_CALC.SAR_COEF_JORNADA

'Jornales debe convertirse en precio hora
If SAR_TIPO_SALARIO = "003" Then 
    importe = importe/SAR_HORAS_MES
    coef = 1
EndIf

importe = importe * coef

Return Round(importe,SAR_NUM_DEC)
