'Proceso especial, solo se ejecutara una vez en la paga adicional de tipo "99" definida el 30/06/2021, se llama desde SAR_BASE_IMPUESTO
'recorre los meses de enero a junio atendiendo a su pago IG, determina el importe de deduccion de la ley 27617 tanto en tramos 1 y 2
'y los retorna completos para realizar el ajuste del impuesto y consolidar dichas deducciones en el calculo de pagas posteriores.

DED_T1 = 0
DED_T2 = 0
mes_ini = 1
mes_fin = 6
retrib_acum = 0
prom_retrib = 0
retrib_ley = 0
ded_a_acum = 0
ded_b_acum = 0
oe_mes_ant = 0
base_recalc_mes_ult = 0

divisor_prom = 0

ult_reg = SCO_AC_HR_PERIOD_READ_1.Count()
If ult_reg < 0 Then Return(0)

'De enero a junio
For mes = mes_ini To mes_fin
    mes_ini_ig = DxDate(1,mes,2021)
    ult_dia_mes = DaysOfMonth(mes_ini_ig)
    mes_fin_ig = DxDate(ult_dia_mes,mes,2021)
    devengos_mes = 0
    fec_ig_ant = DxDate(1,1,1800)
    base_impuesto_mes = 0
    base_impuesto_aplica = 0
    oe_mes = 0
    oe_acum = 0
    ded_a_mes = 0
    ded_b_mes = 0
    
    'Obtiene el acumulado de lo que se considera retribucion (devengos - sac abonado)
    For acum = 0 To ult_reg - 1
        If SCO_AC_HR_PERIOD_READ_1[acum].SAR_FECHA_PAGO_IG >= mes_ini_ig And SCO_AC_HR_PERIOD_READ_1[acum].SAR_FECHA_PAGO_IG <= mes_fin_ig And SCO_AC_HR_PERIOD_READ_1[acum].SAR_TP_IMPUT<>"88" Then
            devengos_mes = devengos_mes + (SCO_AC_HR_PERIOD_READ_1[acum].SAR_TOTAL_DEVENGOS - SCO_AC_HR_PERIOD_READ_1[acum].SAR_SAC_ABONADO)
            'Obtiene la ultima base de impuesto y los importes de AE y OE calculados en el mes en una paga normal
            If SCO_AC_HR_PERIOD_READ_1[acum].SAR_FECHA_PAGO_IG > fec_ig_ant And SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1[acum].SCO_DT_ALLOCATION Then
                fec_ig_ant = SCO_AC_HR_PERIOD_READ_1[acum].SAR_FECHA_PAGO_IG
                base_impuesto_mes = SCO_AC_HR_PERIOD_READ_1[acum].SAR_BASE_IMPUESTO
                oe_acum = SCO_AC_HR_PERIOD_READ_1[acum].SAR_TOT_REMUN_OE_ACUM
            EndIf
        EndIf
    Next
    'oe mes, lo obtenemos por diferencias entre mes actual y anterior
    If oe_acum>oe_mes_ant Then
        oe_mes = oe_acum - oe_mes_ant
        oe_mes_ant = oe_acum
    EndIf

    'Importe completo del mes a considerar para la ley 27617
    retrib_mes = devengos_mes + oe_mes

    'Importe acumulado para calcular el promedio
    retrib_acum = retrib_acum + retrib_mes

    'Promedio: Se consideran unicamente los meses en los que se percibe algo.
    If retrib_mes > 0 Then divisor_prom = divisor_prom + 1
    If divisor_prom > 0 Then prom_retrib = retrib_acum / divisor_prom

    'El importe a considerar para ver si esta alcanzado y en que tramo sera el menor entre el mas y el promedio
    retrib_ley = Min(retrib_mes,prom_retrib)

    'La base de impuesto sobre la que se aplicara la deduccion no sera la completa del mes, 
    'sino la parte de la base que corresponda al mes actual (restando a la base del impuesto completa acumulada el importe 
    'de la base del impuesto del mes anterior y, en este proceso de ajuste, las deducciones calculadas en meses anteriores)
    base_impuesto_aplica = base_impuesto_mes - (ded_a_acum + ded_b_acum + base_recalc_mes_ult)
    
    'Calcula la deduccion que pertenece al mes de proceso
    vTramo = SAR_DED_ESP_INC.SAR_RETORNA_TRAMO(retrib_ley,mes_ini_ig,ID_CURRENCY)
    If vTramo = 1 And base_impuesto_aplica > 0 Then
        ded_a_mes = base_impuesto_aplica
    ElseIf vTramo = 2 Then
        vValor = SAR_DED_ESP_INC.SAR_RETORNA_VALOR(retrib_ley,mes_ini_ig,ID_CURRENCY)
        ded_b_mes = vValor
    EndIf
    ded_a_acum = ded_a_acum + ded_a_mes
    ded_b_acum = ded_b_acum + ded_b_mes

    'Almacena como queda este mes, tomando el importe obtenido del acumulado inicialmente y restando las deducciones aplicadas, 
    'para poder considerarlo en el mes siguiente
    base_recalc_mes_ult = base_impuesto_mes - (ded_a_acum + ded_b_acum)
Next

'Al final del proceso devolvuelve el total de cada deduccion
DED_T1 = ded_a_acum
DED_T2 = ded_b_acum

Return(0)
