'Recorremos los beneficios y acumulamos en los conceptos correspondientes
 SCO_HRP_BNFT.Begin()
 Suma_costo = 0
 POS=0
 Suma_costo_empresa = 0

SCO_BNFT_VALUES_NO_SLICES.DESTROYBLOCK()
SCO_BNFT_VALUES_NO_SLICES.SCO_DT_START_ALLOC = SCO_HRP_BNFT.SCO_DT_ST_ALLOC_BNFT
SCO_BNFT_VALUES_NO_SLICES.SCO_DT_END_ALLOC = SCO_HRP_BNFT.SCO_DT_END_ALLOC_BNFT
SCO_BNFT_VALUES_SLICES.SCO_DT_SLICE = SCO_DT_SLICE
SCO_BNFT_VALUES_SLICES.SCO_DT_PRORATE = SCO_DT_PRORATE
 
While SCO_HRP_BNFT.IsEOF() = False
    sIdTIEmp = ""
    sIdItemEmp =  ""
    sIdTILeg = ""
    sIdItemLeg = ""
    iOperation = 0
    'Las variables se utilizarán para agrupar los registros que corresponden al mismo concepto del mismo histórico
    sIdPlanEmp = ToString(POS,0) + "EMP" 
    sIdPlanDep = ToString(POS,0) + "DEP"

    SCO_H_BN_EMP_CST.Begin()
    SCO_H_BN_DEP_CST.Begin()
    If SCO_H_BN_EMP_CST.Count() > 0 Or SCO_H_BN_DEP_CST.Count() > 0 Then
        'Dependiendo de si la retención es antes o después de impuestos, cambiarán los conceptos a los que salen los costes y los costes saldrán en positivo o en negativo
        If SCO_HRP_BNFT.SUS_TAX = "A" OR (SCO_HRP_BNFT.SUS_TAX = "I" AND SCO_HRP_BNFT.SUS_TAX_ELCT_D = "A") THEN
            'Si el campo Tax indica que es Post tax
            iOperation = 1 'Sumar
            sIdTIEmp = SCO_HRP_BNFT.SUS_ID_TI
            sIdItemEmp =  SCO_HRP_BNFT.SUS_ID_PAY_ITEM_DED
            sIdTILeg = SCO_HRP_BNFT.SUS_ID_TI
            sIdItemLeg = SCO_HRP_BNFT.SCO_ID_ITEM_DED_COMP
            If IsNull(sIdItemLeg) = M4_TRUE Then    
                'Si no hay valor para el coste empresa, se asigna el concepto donde se totalizan todos los costes empresa
                sIdTILeg = "SCO_HRPERIOD_CALC"
                sIdItemLeg = "SCO_DED_BNFT_LEG_ENT"
            Endif
        Else
            'Si el campo Tax indica que es Pre tax
            IF SCO_HRP_BNFT.SUS_TAX = "P" OR (SCO_HRP_BNFT.SUS_TAX = "I" AND SCO_HRP_BNFT.SUS_TAX_ELCT_D = "P") THEN
                iOperation = 2 'Restar
                sIdTIEmp = SCO_HRP_BNFT.SUS_ID_TI
                sIdItemEmp =  SCO_HRP_BNFT.SUS_ID_ITEM_PRE
                sIdTILeg = SCO_HRP_BNFT.SUS_ID_TI
                sIdItemLeg = SCO_HRP_BNFT.SCO_ID_ITEM_PRE_COMP
                If IsNull(sIdItemLeg) = M4_TRUE Then 
                    sIdTILeg = "SCO_HRPERIOD_CALC"
                    sIdItemLeg = "SCO_DED_BNFT_LEG_ENT"
                Endif
            Endif
        Endif

        'Costes empleado
        While SCO_H_BN_EMP_CST.IsEOF() = M4_False   
            SCO_H_BN_EMP_CST.curExchangeRecord(ID_CURRENCY,M4_FALSE,SCO_DT_ALLOCATION,EX_TYPE)
            'Coste empleado
            cValue = SCO_H_BN_EMP_CST.SUS_PRICE
            'Como fechas, tomamos la intersección entre las fechas del coste y las fechas del cálculo
            dCostStart = Max(SCO_H_BN_EMP_CST.SCO_DT_START,SCO_HR_PERIOD.SCO_DT_START_CALC)
            dCostEnd = Min(SCO_H_BN_EMP_CST.SCO_DT_END,SCO_HR_PERIOD.SCO_DT_END_CALC)
             
            If sIdItemEmp <> "" And IsNull(cValue) = M4_FALSE And cValue <> 0 Then 
                'Si la base de remuneraciones del precio es anual, se divide el precio por 12 para convertirlo a mensual
                IF (SCO_H_BN_EMP_CST.STD_ID_COMP_BASIS = "1" ) THEN cValue = cValue/12
                If iOperation = 2 Then cValue = -cValue  'Restar
                'Crear el registro en el nodo SCO_BNFT_VALUES_NO_SLICES prorrateando el valor si es necesario
                SCO_BNFT_VALUES_NO_SLICES.SCO_CREATE_RECORD(sIdTIEmp, sIdItemEmp, dCostStart, dCostEnd, cValue, sIdPlanEmp)
            Endif

            'Coste empresa
            cValue = SCO_H_BN_EMP_CST.SUS_ER_CONTR
            If sIdItemLeg <> "" And IsNull(cValue) = M4_FALSE And cValue <> 0 Then 
                'Si la base de remuneraciones del precio es anual, se divide el precio por 12 para convertirlo a mensual
                If (SCO_H_BN_EMP_CST.STD_ID_COMP_EC = "1" ) Then cValue = cValue/12
                'El Coste empresa siempre es positivo, no hay que restar
                'Crear el registro en el nodo SCO_BNFT_VALUES_NO_SLICES prorrateando el valor si es necesario
                SCO_BNFT_VALUES_NO_SLICES.SCO_CREATE_RECORD(sIdTILeg, sIdItemLeg, dCostStart, dCostEnd, cValue, sIdPlanEmp)
                'Si el concepto es distinto de SCO_DED_BNFT_LEG_ENT, además añadimos un registro para este concepto, que es donde se 
                'totalizan todos los costes empresa. Al asignarlo al concepto, se multiplicará su valor por 12 para hacerlo anual.  
                If sIdItemLeg <> "SCO_DED_BNFT_LEG_ENT" Then 
                    'Crear el registro en el nodo SCO_BNFT_VALUES_NO_SLICES prorrateando el valor si es necesario
                    SCO_BNFT_VALUES_NO_SLICES.SCO_CREATE_RECORD("SCO_HRPERIOD_CALC", "SCO_DED_BNFT_LEG_ENT", dCostStart, dCostEnd, cValue, sIdPlanEmp)
                Endif
            Endif

            SCO_H_BN_EMP_CST.GONEXT()
        Wend
        
        'Costes beneficiarios
        While SCO_H_BN_DEP_CST.IsEOF() = M4_False   
            SCO_H_BN_DEP_CST.curExchangeRecord(ID_CURRENCY,M4_FALSE,SCO_DT_ALLOCATION,EX_TYPE)
            'Coste empleado
            cValue = SCO_H_BN_DEP_CST.SCO_AMT_DEP_EMP
            'Como fechas, tomamos la intersección entre las fechas del coste y las fechas del cálculo
            dCostStart = Max(SCO_H_BN_DEP_CST.SCO_DT_START,SCO_HR_PERIOD.SCO_DT_START_CALC)
            dCostEnd = Min(SCO_H_BN_DEP_CST.SCO_DT_END,SCO_HR_PERIOD.SCO_DT_END_CALC)
             
            If sIdItemEmp <> "" And IsNull(cValue) = M4_FALSE And cValue <> 0 Then 
                'Si la base de remuneraciones del precio es anual, se divide el precio por 12 para convertirlo a mensual
                IF (SCO_H_BN_DEP_CST.STD_ID_COMP_D_EMP = "1" ) THEN cValue = cValue/12
                If iOperation = 2 Then cValue = -cValue  'Restar
                'Crear el registro en el nodo SCO_BNFT_VALUES_NO_SLICES prorrateando el valor si es necesario
                SCO_BNFT_VALUES_NO_SLICES.SCO_CREATE_RECORD(sIdTIEmp, sIdItemEmp, dCostStart, dCostEnd, cValue, sIdPlanDep)
            Endif

            'Coste empresa
            cValue = SCO_H_BN_DEP_CST.SCO_AMT_DEP_LEG
            If sIdItemLeg <> "" And IsNull(cValue) = M4_FALSE And cValue <> 0 Then 
                'Si la base de remuneraciones del precio es anual, se divide el precio por 12 para convertirlo a mensual
                If (SCO_H_BN_DEP_CST.STD_ID_COMP_D_LEG = "1" ) Then cValue = cValue/12
                'El Coste empresa siempre es positivo, no hay que restar
                'Crear el registro en el nodo SCO_BNFT_VALUES_NO_SLICES prorrateando el valor si es necesario
                SCO_BNFT_VALUES_NO_SLICES.SCO_CREATE_RECORD(sIdTILeg, sIdItemLeg, dCostStart, dCostEnd, cValue, sIdPlanDep)
                'Si el concepto es distinto de SCO_DED_BNFT_LEG_ENT, además añadimos un registro para este concepto, que es donde se 
                'totalizan todos los costes empresa. Al asignarlo al concepto, se multiplicará su valor por 12 para hacerlo anual.  
                If sIdItemLeg <> "SCO_DED_BNFT_LEG_ENT" Then 
                    'Crear el registro en el nodo SCO_BNFT_VALUES_NO_SLICES prorrateando el valor si es necesario
                    SCO_BNFT_VALUES_NO_SLICES.SCO_CREATE_RECORD("SCO_HRPERIOD_CALC", "SCO_DED_BNFT_LEG_ENT", dCostStart, dCostEnd, cValue, sIdPlanDep)
                Endif
            Endif

            SCO_H_BN_DEP_CST.GONEXT()
        Wend
    Endif
    POS=POS + 1 	    
    SCO_HRP_BNFT.MOVETO(POS)
Wend

'Asignamos a los conceptos los valores tramados y sumados
SCO_BNFT_VALUES_NO_SLICES.SCO_SET_CONCEPTS()
