'Se limita para paga normal, primera y segunda quincena.
If SAR_TP_IMPUT <> "1" And SAR_TP_IMPUT <> "3" And SAR_TP_IMPUT <> "4" Then Return(0)
valor = SAR_GASTOS_DEC27

'Se acuerda proporcionar por alta/baja/Ausencias con interrupción/Maternidad
If SAR_TIPO_SALARIO = "001" Then
    dias_gastos_dec = Max(SAR_TIEMPO_EFVO_TR - SAR_DIAS_MATERN - SAR_LIC_ONCO_DIAS,0)
    valor = (SAR_GASTOS_DEC27/SAR_DIAS_NORM_COTIZ)*dias_gastos_dec
EndIf

Return Round(valor,SAR_NUM_DEC)
