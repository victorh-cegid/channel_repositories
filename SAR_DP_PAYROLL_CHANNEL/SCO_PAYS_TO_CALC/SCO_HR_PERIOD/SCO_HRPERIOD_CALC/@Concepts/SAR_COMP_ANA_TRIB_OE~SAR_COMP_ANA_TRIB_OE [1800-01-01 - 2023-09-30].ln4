'Recorre la tabla detalle complementos y aplica un tope por cada concepto SAR_DESCRIPCION diferente que encuentre en el a?o fiscal.
importe = SAR_COMP_ANA_TRIB_OE
If importe = 0 Then return (0)

dif_meses = 0
imp_tot = 0
descripcion = ""
descripcionAnte = ""
gravadoTot = 0
exentoTot = 0
gravado = 0
exento = 0

If SAR_ES_BAJA = 1 and SAR_IG_DICIEMBRE = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then
    mes_paga_efecti = 12
Else
    mes_paga_efecti = DxMonth(SAR_FEC_IMPUT_IG)
EndIf

'Paga especial de reliquidacion septiembre 2023, se leen complementos hasta septiembre (octubre diferidos), no hasta diciembre como en una reliquidacion de diciembre normal
indReliq = SAR_IND_PAGA_RELIQ
If indReliq = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then indReliq = 0

SAR_DET_COMPLEM_SIRADIG.DESTROYBLOCK()
SAR_DET_COMPLEM_SIRADIG.SAR_ID_HR = SCO_ID_HR
SAR_DET_COMPLEM_SIRADIG.SAR_OR_PERIOD = SCO_OR_HR_PERIOD
SAR_DET_COMPLEM_SIRADIG.SAR_YEAR = SAR_ANIO_IMPUT_IG
SAR_DET_COMPLEM_SIRADIG.SAR_DETAIL = "otrosConAnDetalle"

numReg = SAR_DET_COMPLEM_SIRADIG.Count()

For i=0 To numReg-1
    
    If DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_START) <= mes_paga_efecti Then
        descripcion = SAR_DET_COMPLEM_SIRADIG[i].SAR_DESCRIPCION
        
        'Si encontramos un concepto diferente, consolida el exento/gravado del concepto anterior y reinicia el conteo para el nuevo concepto
        If descripcion <> descripcionAnte Then 
            imp_tot = 0
            gravadoTot = gravadoTot + gravado
            exentoTot = exentoTot + exento
        EndIf

        If (mes_paga_efecti <= DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_END))Then
            dif_meses = mes_paga_efecti - DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_START) + 1
            imp_tot = imp_tot + (SAR_DET_COMPLEM_SIRADIG[i].SAR_MONTO * dif_meses)
        Else
            dif_meses = DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_END) - DxMonth(SAR_DET_COMPLEM_SIRADIG[i].SAR_DT_START) + 1 
            imp_tot   = imp_tot + (SAR_DET_COMPLEM_SIRADIG[i].SAR_MONTO * dif_meses)
        EndIf

        'Calcula exento/gravado del concepto en el que nos encontramos
        importe = imp_tot
        topeExento = 0
        If SAR_ID_TERR_LARG_DIST_OE = 1 Then
            topeExento = 4 * SAR_GAN_NO_IMP
        ElseIf SAR_ID_LARGA_DIST_OE = 1 Then
            topeExento = SAR_GAN_NO_IMP
        Else
            topeExento = Percentage(40,SAR_GAN_NO_IMP)
        EndIf
        
        gravado = Max(importe - topeExento, 0)
        exento = importe - gravado
        
        descripcionAnte = descripcion

    EndIf
Next

'Al salir del bucle consolidamos el exento/gravado del ultimo concepto encontrado
gravadoTot = gravadoTot + gravado
exentoTot = exentoTot + exento

gravadoTot = Round(gravadoTot,SAR_NUM_DEC)
exentoTot = Round (exentoTot,SAR_NUM_DEC)

Return(gravadoTot)
