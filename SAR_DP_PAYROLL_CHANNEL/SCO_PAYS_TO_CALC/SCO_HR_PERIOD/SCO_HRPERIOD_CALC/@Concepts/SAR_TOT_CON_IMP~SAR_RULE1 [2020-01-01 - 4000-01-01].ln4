'Importes mensuales: se usa en resumen de impuesto a las ganancias
ban = SAR_TOT_REM_IMP 'Empresa

'Otros empleadores y anteriores empresas: Se incorpora importe completo del periodo fiscal - importe completo de la paga anterior para consider carga tardía
val_otros_empl = SAR_BRUTO_OE - SAR_ACM_PAGA_ANT_IG[0].SAR_BRUTO_OE
val_otros_empl = val_otros_empl + SAR_NO_HAB_OE_ACUM - SAR_ACM_PAGA_ANT_IG_REV[0].SAR_NO_HAB_OE_ACUM
val_otros_empl = val_otros_empl + SAR_MOV_VIA_TRIB_OE - SAR_ACM_PAGA_ANT_IG_REV[0].SAR_MOV_VIA_TRIB_OE
val_otros_empl = val_otros_empl + SAR_MAT_DIC_TRIB_OE - SAR_ACM_PAGA_ANT_IG_REV[0].SAR_MAT_DIC_TRIB_OE
val_otros_empl = val_otros_empl + SAR_PER_ANT_GRAV_OE - SAR_ACM_PAGA_ANT_IG_REV[0].SAR_PER_ANT_GRAV_OE
val_ant_emp    = SAR_BASE_ANT_EMP - SAR_ACM_PAGA_ANT_IG[0].SAR_BASE_ANT_EMP

If SAR_TP_IMPUT = "99" Then ban = 0
valor = ban + val_ant_emp + val_otros_empl
Return(valor)
