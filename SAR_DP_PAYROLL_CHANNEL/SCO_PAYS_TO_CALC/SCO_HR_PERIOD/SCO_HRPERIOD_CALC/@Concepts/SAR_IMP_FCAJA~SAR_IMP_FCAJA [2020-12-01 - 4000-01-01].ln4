' Valor por incidencias
'Se condiciona para que en caso de Paga Extra de Aguinaldo no se calculen las comisiones.
If(SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1) Then Return(0)

IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" OR SAR_TP_IMPUT = "77"  THEN
    Return(0)
ENDIF

valor = SAR_IMP_FCAJA

Return(valor)
