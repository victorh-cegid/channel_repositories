If SAR_TP_IMPUT <> "1" And SAR_TP_IMPUT <> "3" And SAR_TP_IMPUT <> "4" Then Return(0)

'LSD diferencia la exposicion del concepto dependiendo de si se percibe por mes completo o no
importe = SAR_PREST_SUSP_ART_223BIS
If SAR_DIAS_SUSP_ART_223BIS = SAR_DIAS_NORM_SUELD Then
    SAR_ART_233_COMPLET = importe
Else
    SAR_ART_233_NO_COMPLET = importe
EndIf
Return(importe)
