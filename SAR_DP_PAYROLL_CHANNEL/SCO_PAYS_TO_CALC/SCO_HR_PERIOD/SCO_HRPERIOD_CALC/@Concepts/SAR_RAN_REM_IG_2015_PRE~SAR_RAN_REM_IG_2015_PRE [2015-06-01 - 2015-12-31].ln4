/*
Objetivo del concepto
    Encontrar el rango v793 correspondiente a la zona previa al cambio, de existir cambio de zona, en el mes que se detecte. 
    Detalles: 
        2015 
                mes_cambio_zona = mes del cambio de zona que se puede encontrar: 
                1-  De Enero a Abril  => El concepto v792 era correcto y el v793 no existía.
                    Acción:
                    Calcular el supuesto v793 con: 
                    	El concepto v5600 en el mes_cambio_zona.
                    	El concepto v792 en el mes_cambio_zona.
                    	Supuesto v793 = Calculo con estos conceptos.
                    	Dar valor al v794 con el supuesto v793.
                    	
                2-  De Mayo a Septiembre => los conceptos v792 y v793 pueden ser erróneos.
                    Acción:
                    Calcular el supuesto v793 con: 
                    El concepto v792 de Abril (era correcto y sirve como previo si v5600 > 25000).
                    Lazo de Mayo al mes_cambio_zona usar
                         El concepto v5600 en el mes acumulado.
                         El concepto v792 acumulado del mes anterior al mes acumulado  (si el  
                         v5600 es  > 25000 se debe mantener. El primero es el de abril)	
                        Supuesto v793 = Calculo con estos conceptos.
                    Final Lazo de Mayo
                    Dar valor al v794 con el supuesto v793.
                    
                3-  Desde Octubre => los conceptos v792 y v793 son correctos.  
                    Dar valor al v794 con el v793 del acumulado del mes_cambio_zona.
                    
                    Es decir que en lo que va del 2015 se pueden dar cualquiera de las opciones descritas anteriormente. 
                    
        2016 Opción 3.
        
*/

'Iniciamos la lectura del acumulado:
SCO_AC_HR_PERIOD_READ_1.BEGIN()                'Iniciamos el acumulado
CantReg = SCO_AC_HR_PERIOD_READ_1.Count()-1    'Inicializamos el número de registros    

'Determinamos si es una paga diferida para aplicar a la paga 99:
Es_Paga_Diferida = 0
If(CantReg >=0)Then
   If(DxMonth(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) <> DxMonth(SCO_AC_HR_PERIOD_READ_1.SAR_FEC_PAGO_IG))Then
      Es_Paga_Diferida = 1
   EndIf
EndIf

SAR_HR_ROLE.Begin()
Mes_Zona_Previa = -1 'Toma valor en el método: SAR_HR_ROLE.SAR_OBTENER_CAMBIO_ZONA

Zona_actual = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(SCO_DT_PAYMENT)  'Obtenemos la zona vigente de la paga.

If(Es_Paga_Diferida = 1 And SAR_TP_IMPUT = "99")Then
   Fecha_Previa = DateAdd(SCO_DT_PAYMENT, -1, M4_MONTH)   
   Zona_Previa = SAR_HR_ROLE.SAR_OBTENER_CAMBIO_ZONA(Mes_Zona_Previa, Fecha_Previa)'Obtenemos la zona previa a la vigente de la paga.
Else
   Zona_Previa = SAR_HR_ROLE.SAR_OBTENER_CAMBIO_ZONA(Mes_Zona_Previa, SCO_DT_ALLOCATION)'Obtenemos la zona previa a la vigente de la paga.
EndIf   

Zona_Previa = ToString(ToDouble(Zona_Previa), 0)
Rango_Previo          = -1

If(Mes_Zona_Previa = "-1")Then
  'Es posible que se haya hecho un cambio en la zona de trabajo por el que actualmente exista una sola zona.
  'En este caso se debe encontrar en el acumulado del rol, cual era la zona anterior, para poder encontrar
  'el rango que tenia en el mes con esa zona.

EndIf

If(Mes_Zona_Previa <> "-1")Then 'Según vigencia de esta regla. El cambio de zona entre Enero y Abril permite deducir que existe acumulado para el mes encontrado.  
     
    'Encontramos las fechas inicio y fin del mes encontrado para buscar en el acumulado.
    Dias_Mes = DxDaysOfMonth(Mes_Zona_Previa, DxYear(SCO_DT_PAYMENT))
    If(Mes_Zona_Previa < 10)Then
      Mes = "0" + ToString(Mes_Zona_Previa, 0)
    Else  
      Mes = ToString(Mes_Zona_Previa, 0)
    EndIf
    If(Dias_Mes < 10)Then
      Dias_Mes = "0" + ToString(Dias_Mes, 0)
    Else  
      Dias_Mes = ToString(Dias_Mes, 0)
    EndIf
    F_MES_PREV_INI = ToDate(ToString(DxYear(SCO_DT_PAYMENT), 0) + "-" + Mes + "-01")      'Primer día del mes a buscar en el acumulado.
    F_MES_PREV_FIN = ToDate(ToString(DxYear(SCO_DT_PAYMENT), 0) + "-" + Mes + "-" + Dias_Mes) 'Ultimo día del mes a buscar en el acumulado.
    
    If(Mes_Zona_Previa >= 1 And Mes_Zona_Previa <= 4)Then 'La zona recien es distinta a la actual, entre Enero y Abril.    
      'Tomamos el rango del acumulado del mes encontrado.
          If(CantReg >= 0) Then
              ContReg = 0     
              'Buscamos el rango v793 previo                       
              While (ContReg <= CantReg)
                  SCO_AC_HR_PERIOD_READ_1.MoveTo(ContReg)
                  
                  If(DxYear(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) = DxYear(SCO_DT_PAYMENT) And SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT >= F_MES_PREV_INI And SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT <= F_MES_PREV_FIN And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1") Then
                          Rango_Previo     = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM)
                          Mejor_Rem_Previa = SCO_AC_HR_PERIOD_READ_1.SAR_MAYOR_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM)
                  EndIf
                  ContReg = ContReg + 1
              Wend    
          EndIf      
          
          'Calculamos el rango del concepto v793 de haber existido entre Enero y Abril:
          If(Rango_Previo = 1)Then
             RANGO = Rango_Previo
             Return(RANGO)
        
          ElseIf(Rango_Previo = 2) Then
              
              If(Mejor_Rem_Previa <= 15000 )Then 'Rango 1 
                 RANGO = 1
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 15000 And Mejor_Rem_Previa <= 18000)Then 'Rango 2 recalculado a 20 
                 RANGO = 20
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 18000 And Mejor_Rem_Previa <= 21000)Then 'Rango 2 recalculado a 21 
                 RANGO = 21
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 21000 And Mejor_Rem_Previa <= 22000)Then 'Rango 2 recalculado a 22 
                 RANGO = 22
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 22000 And Mejor_Rem_Previa <= 23000)Then 'Rango 2 recalculado a 23 
                 RANGO = 23   
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 23000 And Mejor_Rem_Previa <= 24000)Then 'Rango 2 recalculado a 24 
                 RANGO = 24  
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 24000 And Mejor_Rem_Previa <= 25000)Then 'Rango 2 recalculado a 25 
                 RANGO = 25     
              ElseIf(Zona_Previa <> "1"  And Mejor_Rem_Previa > 25000 ) Then 'Rango 2
                 RANGO = 2
              Endif
              
          ElseIf (Rango_Previo = 0) Then   
              
              If(Mejor_Rem_Previa <= 15000 )Then 'Rango 1 
                 RANGO = 1
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 15000 And Mejor_Rem_Previa <= 18000)Then 'Rango 2 recalculado a 20 
                 RANGO = 20
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 18000 And Mejor_Rem_Previa <= 21000)Then 'Rango 2 recalculado a 21 
                 RANGO = 21
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 21000 And Mejor_Rem_Previa <= 22000)Then 'Rango 2 recalculado a 22 
                 RANGO = 22
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 22000 And Mejor_Rem_Previa <= 23000)Then 'Rango 2 recalculado a 23 
                 RANGO = 23   
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 23000 And Mejor_Rem_Previa <= 24000)Then 'Rango 2 recalculado a 24 
                 RANGO = 24  
              ElseIf(Zona_Previa <> "1" And Mejor_Rem_Previa > 24000 And Mejor_Rem_Previa <= 25000)Then 'Rango 2 recalculado a 25 
                 RANGO = 25     
              ElseIf(Zona_Previa <> "1"  And Mejor_Rem_Previa > 25000 ) Then 'Rango 0
                 RANGO = 0
              Endif
          
          ElseIf (Rango_Previo = 3) Then   
              
              If(Zona_Previa = "0" And Mejor_Rem_Previa <= 15000 )Then 'Rango 1 
                 RANGO = 1                                                        
              ElseIf(Zona_Previa <> "0" And Mejor_Rem_Previa > 15000 And Mejor_Rem_Previa <= 18000)Then 'Rango 3 recalculado a 30 
                 RANGO = 30
              ElseIf(Zona_Previa <> "0" And Mejor_Rem_Previa > 18000 And Mejor_Rem_Previa <= 21000)Then 'Rango 3 recalculado a 31 
                 RANGO = 31
              ElseIf(Zona_Previa <> "0" And Mejor_Rem_Previa > 21000 And Mejor_Rem_Previa <= 22000)Then 'Rango 3 recalculado a 32 
                 RANGO = 32
              ElseIf(Zona_Previa <> "0" And Mejor_Rem_Previa > 22000 And Mejor_Rem_Previa <= 23000)Then 'Rango 3 recalculado a 33 
                 RANGO = 33   
              ElseIf(Zona_Previa <> "0" And Mejor_Rem_Previa > 23000 And Mejor_Rem_Previa <= 24000)Then 'Rango 3 recalculado a 34 
                 RANGO = 34  
              ElseIf(Zona_Previa <> "0" And Mejor_Rem_Previa > 24000 And Mejor_Rem_Previa <= 25000)Then 'Rango 3 recalculado a 35 
                 RANGO = 35 
              ElseIf(Zona_Previa <> "0" And Mejor_Rem_Previa > 25000 )Then 'Rango 3
                 RANGO = 3
              EndIf
          EndIf
          
          Rango_Previo = RANGO
          
    ElseIf(Mes_Zona_Previa >= 5 And Mes_Zona_Previa <= 10)Then 'La zona recien es distinta a la actual, entre Mayo y Septiembre.
      
        'Tomamos el rango del acumulado del mes encontrado este mes sará: 
        '                     1)     Abril.
        '                     2)     Mayo / Agosto: Se toma el mas proximo Abril, ya que son altas posteriores.
        'Para ello debemos leer desde atras hacia adelante para, en todo caso, intentar leer primero abril de estar acumulado.
        If(CantReg >= 0) Then
    
            Mes = 4
            Mes_Acu = -1
    
            Dias_Mes_1 = DxDaysOfMonth(Mes, DxYear(SCO_DT_PAYMENT))
            If(Dias_Mes_1 < 10)Then
              Dias_Mes_1 = "0" + ToString(Dias_Mes_1, 0)
            Else  
              Dias_Mes_1 = ToString(Dias_Mes_1, 0)
            EndIf
            F_MES_PREV_INI_1 = ToDate(ToString(DxYear(SCO_DT_PAYMENT), 0) + "-" + ToString(Mes_Zona_Previa, 0) + "-1")        'Primer día del mes a buscar en el acumulado.
            F_MES_PREV_FIN_1 = ToDate(ToString(DxYear(SCO_DT_PAYMENT), 0) + "-" + ToString(Mes_Zona_Previa, 0) + "-" + Dias_Mes_1) 'Ultimo día del mes a buscar en el acumulado.    
            ContReg = CantReg                   
            'Buscamos el rango v793 previo                       
            While (ContReg >= 0 And Mes <> Mes_Zona_Previa)
                SCO_AC_HR_PERIOD_READ_1.MoveTo(ContReg)
                'Procedemos solo en Abril, de existir, y hasta Agosto como maximo. 
                If(DxMonth(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) >= 4 And DxYear(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) = DxYear(SCO_DT_PAYMENT) And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1") Then                        
    
                     Mes  = DxMonth(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT)   
                     Anio = DxYear(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT)
                     Fecha_De_Busqueda = DxDate(DxDaysOfMonth(Mes, DxYear(SCO_DT_PAYMENT)), Mes, DxYear(SCO_DT_PAYMENT))
                     
                     If(Mes = DxMonth(SAR_FECHA_ALTA) And Anio = DxYear(SAR_FECHA_ALTA))Then
                        Rango_Del_Alta = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
                     EndIf   
                     
                     If(Mes = 4)Then
                        Rango_Previo     = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM)'Tomamos el rango de abril. 
                        Rango_Abril      = Rango_Previo
                        Mejor_Remu_Acu_Abril = SCO_AC_HR_PERIOD_READ_1.SAR_MAYOR_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM)
                     ElseIf(Mes >= 5 And Mes <= 10)Then
                        'Tomamos la remuneracion del Mes. Debemos calcular el rango v792 y v793:
                        'Si existio el mes de abril usaremos ademas el Rango_Previo si el v5600 de ese mes es > $25000
                          Mejor_Rem_Mes = SCO_AC_HR_PERIOD_READ_1.SAR_MAYOR_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM)                       
                          
                          Zona_Mes = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(Fecha_De_Busqueda)  'Obtenemos la zona vigente de la paga.
                          Zona_Mes = ToString(ToDouble(Zona_Mes), 0)
    
                          'Primero se calcula el v792 que hubiera tenido en el mes.
                          If(Mejor_Rem_Mes <= 15000 )Then 'Rango 1
                             Rango = 1
                          ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 15000 And Mejor_Rem_Mes <= 25000)Then 'Rango 2
                             Rango = 2
                          ElseIf(Zona_Mes <> "0" And Mejor_Rem_Mes > 15000)Then 'Rango 3
                             Rango = 3
                          ElseIf(Mejor_Rem_Mes > 25000 )Then 'Se procede de acuerdo a la zona. 
                              If(Zona_Mes = "0")Then
                                    If(SAR_FECHA_ALTA < DxDate(1, 9, 2013))Then 
                                         Rem_Ajuste = Mejor_Remu_Acu_Abril 'La mejor remuneración de abril    
                                         If(Mejor_Remu_Acu_Abril <= 15000)Then
                                              Rango_Ajuste = 1
                                         ElseIf(Mejor_Remu_Acu_Abril > 15000 And Mejor_Remu_Acu_Abril <= 25000)Then
                                              Rango_Ajuste = 2 
                                         Else   
                                              Rango_Ajuste = 0 
                                           EndIf  
                                    ElseIf((SAR_FECHA_ALTA >= DxDate(1, 9, 2013) And Rango_Abril = 2) Or (SAR_FECHA_ALTA >= DxDate(1, 5, 2015) And Rango_Del_Alta = 2))Then
                                          Rango_Ajuste = 2 
                                          Rango = Rango_Ajuste
                                          Ajuste_Por_Alta = 1
                                    Else       
                                          Rango_Ajuste = 0 
                                    EndIf
                              Else 'Tener en cuenta la posibilidad de ser rango 1.
                                 Rango = 3
                              EndIf
                          EndIf
    
                          Rango_Previo = Rango
                           'Calculamos el rango del concepto v793 que debio haber existido en el mes:
                           If(Rango_Previo = 1)Then
                               RANGO = Rango_Previo                            
                           ElseIf(Rango_Previo = 2) Then
                                
                                If(Mejor_Rem_Mes <= 15000 )Then 'Rango 1 
                                   RANGO = 1
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 15000 And Mejor_Rem_Mes <= 18000)Then 'Rango 2 recalculado a 20 
                                   RANGO = 20
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 18000 And Mejor_Rem_Mes <= 21000)Then 'Rango 2 recalculado a 21 
                                   RANGO = 21
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 21000 And Mejor_Rem_Mes <= 22000)Then 'Rango 2 recalculado a 22 
                                   RANGO = 22
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 22000 And Mejor_Rem_Mes <= 23000)Then 'Rango 2 recalculado a 23 
                                   RANGO = 23   
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 23000 And Mejor_Rem_Mes <= 24000)Then 'Rango 2 recalculado a 24 
                                   RANGO = 24  
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 24000 And Mejor_Rem_Mes <= 25000)Then 'Rango 2 recalculado a 25 
                                   RANGO = 25     
                                ElseIf(Zona_Mes <> "1"  And Mejor_Rem_Mes > 25000 ) Then 'Rango 2
                                   RANGO = 2
                                Endif
                                
                           ElseIf (Rango_Previo = 0) Then   
                                
                                If(Mejor_Rem_Previa <= 15000 )Then 'Rango 1 
                                   RANGO = 1
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 15000 And Mejor_Rem_Mes <= 18000)Then 'Rango 2 recalculado a 20 
                                   RANGO = 20
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 18000 And Mejor_Rem_Mes <= 21000)Then 'Rango 2 recalculado a 21 
                                   RANGO = 21
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 21000 And Mejor_Rem_Mes <= 22000)Then 'Rango 2 recalculado a 22 
                                   RANGO = 22
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 22000 And Mejor_Rem_Mes <= 23000)Then 'Rango 2 recalculado a 23 
                                   RANGO = 23   
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 23000 And Mejor_Rem_Mes <= 24000)Then 'Rango 2 recalculado a 24 
                                   RANGO = 24  
                                ElseIf(Zona_Mes <> "1" And Mejor_Rem_Mes > 24000 And Mejor_Rem_Mes <= 25000)Then 'Rango 2 recalculado a 25 
                                   RANGO = 25     
                                ElseIf(Zona_Mes <> "1"  And Mejor_Rem_Mes > 25000 ) Then 'Rango 0
                                   RANGO = 0
                                Endif
                            
                           ElseIf (Rango_Previo = 3) Then   
                                
                                If(Zona_Mes = "1" And Mejor_Rem_Mes <= 15000 )Then 'Rango 1 
                                   RANGO = 1                                                        
                                ElseIf(Zona_Mes <> "0" And Mejor_Rem_Mes > 15000 And Mejor_Rem_Mes <= 18000)Then 'Rango 3 recalculado a 30 
                                   RANGO = 30
                                ElseIf(Zona_Mes <> "0" And Mejor_Rem_Mes > 18000 And Mejor_Rem_Mes <= 21000)Then 'Rango 3 recalculado a 31 
                                   RANGO = 31
                                ElseIf(Zona_Mes <> "0" And Mejor_Rem_Mes > 21000 And Mejor_Rem_Mes <= 22000)Then 'Rango 3 recalculado a 32 
                                   RANGO = 32
                                ElseIf(Zona_Mes <> "0" And Mejor_Rem_Mes > 22000 And Mejor_Rem_Mes <= 23000)Then 'Rango 3 recalculado a 33 
                                   RANGO = 33   
                                ElseIf(Zona_Mes <> "0" And Mejor_Rem_Mes > 23000 And Mejor_Rem_Mes <= 24000)Then 'Rango 3 recalculado a 34 
                                   RANGO = 34  
                                ElseIf(Zona_Mes <> "0" And Mejor_Rem_Mes > 24000 And Mejor_Rem_Mes <= 25000)Then 'Rango 3 recalculado a 35 
                                   RANGO = 35 
                                ElseIf(Zona_Mes <> "0" And Mejor_Rem_Mes > 25000 )Then 'Rango 3
                                   RANGO = 3
                                EndIf
                           EndIf
                           Rango_Previo = Rango                       
                          EndIf                         
                EndIf                  
               
                ContReg = ContReg - 1
            Wend    
        EndIf      
    
    ElseIf(CantReg >= 0) Then
            ContReg = 0     
            'Buscamos el rango v793 Previo                       
            While (ContReg <= CantReg)
                SCO_AC_HR_PERIOD_READ_1.MoveTo(ContReg)

                If(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT >= F_MES_PREV_INI And SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT <= F_MES_PREV_FIN And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1") Then
                    Rango_Previo  = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2015..sysTotalSlices(M4_TOTAL_SUM) 
                EndIf
                ContReg = ContReg + 1
            Wend    
    EndIf

Else
  Rango_Previo = -1    
EndIf

Return(Rango_Previo)
