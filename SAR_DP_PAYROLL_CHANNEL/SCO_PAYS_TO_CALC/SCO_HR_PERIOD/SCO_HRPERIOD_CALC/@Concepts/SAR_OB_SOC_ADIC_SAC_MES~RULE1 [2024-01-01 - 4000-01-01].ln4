If SAR_TP_IMPUT = "88" Then Return(0)
sac_anio_ant = SAR_IND_SAC_ANIO_ANT

'Control retroactividad años anteriores: se ajusta siempre para que entre directamente al impuesto en la siguiente paga normal
If sac_anio_ant = 1 Then 
    mes_orig = SAR_AC_SAC_REV[0].SAR_OB_SOC_ADIC_SAC_MES
    sac_dif = SAR_OB_SOC_ADIC_SAC - SAR_AC_SAC_REV[0].SAR_OB_SOC_ADIC_SAC
    valor = mes_orig + sac_dif
    If SAR_TFUEG_IND = 1 Then valor = mes_orig
    Return(valor)
EndIf

If SAR_IND_PAGA_RELIQ = 1 Or (SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") Or SAR_IND_AJUSTE_SAC = 1 Then
    'En baja o reliquidación retornamos la diferencia entre el descuento del pago y el que se ha ido descontando mes a mes
    tot_desc_sac_pago = SAR_ACM_IG_ANIO_IMPUT[0].SAR_OB_SOC_ADIC_SAC + SAR_OB_SOC_ADIC_SAC

    'Tierra de fuego a descontar
    tot_adic_sac_tfuego = SAR_ACM_IG_ANIO_IMPUT[0].SAR_TFUEG_ADOS_SAC + SAR_TFUEG_ADOS_SAC
    tot_desc_sac_pago = tot_desc_sac_pago - tot_adic_sac_tfuego

    tot_desc_sac_mes = SAR_ACM_IG_ANIO_IMPUT[0].SAR_OB_SOC_ADIC_SAC_MES
    valor = tot_desc_sac_pago - tot_desc_sac_mes
    
    'Para evitar diferencias en reliquidación por redondeos
    If abs(valor) <= SAR_TOLERANCIA_DEC Then valor = 0
    
    Return (valor)
EndIf

base = SAR_B_SAC_MES_RG3976

If SCO_PAY_FREQ_PAYM = "004" Then 'Tope mensual de cotización para el SAC porrateado
    Tope = SAR_TOPE_COTIZ_IMPUT / 12
Else 
    Tope = SAR_TOPE_COTIZ_IMPUT / 24 'Tope quincenal de cotización para el SAC porrateado
EndIf

BaseTopada = Min(Base, Tope)

porc = SAR_PORC_ADIC_O_SOC - (SAR_PORC_ADIC_O_SOC * SAR_PP_AP_OB_SOC/100)
precio = BaseTopada * porc / 100
valor = precio * SAR_FAM_CARGO_OS
If IsNull(valor) = TRUE Then
    valor = 0
EndIf
Return(valor)
