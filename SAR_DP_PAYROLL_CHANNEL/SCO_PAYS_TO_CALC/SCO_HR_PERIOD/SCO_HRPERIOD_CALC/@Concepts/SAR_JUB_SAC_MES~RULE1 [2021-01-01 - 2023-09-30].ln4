'Dependencias
a = SAR_CALC_SAC_27617

If SAR_TP_IMPUT = "88" Then Return (0)

edad  = SAR_EDAD
valor = 0

sac_anio_ant = SAR_IND_SAC_ANIO_ANT

'Control retroactividad a?os anteriores: se ajusta siempre para que entre directamente al impuesto en la siguiente paga normal
If sac_anio_ant = 1 Then 
    mes_orig = SAR_AC_SAC_REV[0].SAR_JUB_SAC_MES
    sac_dif = SAR_JUBILACION_SAC - SAR_AC_SAC_REV[0].SAR_JUBILACION_SAC
    valor = mes_orig + sac_dif
    Return(valor)
EndIf

indReliq = SAR_IND_PAGA_RELIQ
If indReliq = 1 And SCO_DT_ALLOCATION = DxDate(30,9,2023) Then indReliq = 0

If indReliq = 1 Or SAR_ES_BAJA = 1 Or SAR_IND_AJUSTE_SAC = 1 Then 
    'En baja o reliquidacion retornamos la diferencia entre el descuento del pago y el que se ha ido descontando mes a mes
    tot_jub_sac_pago = SAR_ACM_IG_ANIO_IMPUT[0].SAR_SAC_IG_JUB + SAR_SAC_IG_JUB
    tot_jub_sac_mes = SAR_ACM_IG_ANIO_IMPUT[0].SAR_JUB_SAC_MES
    tot_jub_sac_RG561 = SAR_ACM_IG_ANIO_IMPUT[0].SAR_FINAN_APO_JUB_SAC_DIF + SAR_FINAN_APO_JUB_SAC_DIF      // Decreto 561 articulo 4
    
    valor = tot_jub_sac_pago - tot_jub_sac_mes
    valor = valor + tot_jub_sac_RG561                                                                       // Sumamos la parte del Decreto 561 articulo 4	

    'Para evitar diferencias en reliquidacion por redondeos
    If abs(valor) <= SAR_TOLERANCIA_DEC Then valor = 0

    Return (valor)
Else
    base = SAR_B_SAC_MES_RG3976
EndIf


If SCO_PAY_FREQ_PAYM = "004" Then 'Tope mensual de cotizacion para el SAC porrateado
    Tope = SAR_TOPE_COTIZ / 12
Else 
    Tope = SAR_TOPE_COTIZ / 24 'Tope quincenal de cotizacion para el SAC porrateado
EndIf

BaseTopada = Min(Base, Tope)

If edad >= 18 THEN
    porc = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION * SAR_PP_AP_JUBILA/100)
    valor = BaseTopada * porc / 100
EndIf

If IsNull(valor) = TRUE THEN
    valor = 0
EndIf

Return(valor)
