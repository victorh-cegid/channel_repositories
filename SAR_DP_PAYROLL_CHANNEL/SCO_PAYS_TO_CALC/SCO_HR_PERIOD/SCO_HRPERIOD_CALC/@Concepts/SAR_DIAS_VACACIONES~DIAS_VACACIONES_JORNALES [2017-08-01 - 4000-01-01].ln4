'Excluimos del calculo los tipos de paga: Extra(2), Anticipo de Vacaciones(88), Reliquidación impuesto(99).
If (SAR_TP_IMPUT = "2" And SAR_IND_AGUINALDO = 1) Or SAR_TP_IMPUT = "88" Or SAR_TP_IMPUT = "99" Then Return(0)

'Evaluamos si se está ejecutando una Paga Especial de Licencia por Vacaciones. En este tipo de paga se liquidan las vacaciones y no se descuentan.
If SAR_TP_IMPUT = "77" Then Return(0)

'1.- Asignamos los valores iniciales a las variables de cálculo que van a intervenir en la definición de los periodos vacacionales que vamos a gestionar. 
fec_ini_paga  = SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC                 'Fecha de inicio de la paga procesada
fec_fin_paga  = SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC                   'Fecha de fin de la paga procesada

'Tenemos que tener en cuenta la posibilidad de que exista un tramado en el cálculo de nómina. Realizamos todos los cálculos en el primer tramo.
num_tramos = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA..SysSliceNumber

If num_tramos > 1 Then
    ini_prim_tramo = GetStartDate()         'Fecha de incio del primer tramo del cálculo

    fecha_ini_tram = GetRunningStartDate()  'Fecha de incio del tramo en ejecución

'Permitimos trabajar con tramos
'Sólo continuamos con el cálculo si nos encontramos en el primer tramo.
'    If ini_prim_tramo <> fecha_ini_tram Then Return(0)
EndIf

'Para delimitar el tramo a considerar en el cálculo del empleado debemos de tener en cuenta su situación (Altas y/o Bajas en el mes).
fec_ini_tramo  = Max(SAR_FECHA_ALTA,fec_ini_paga)                   'Fecha de inicio del periodo del empleado en la paga
fec_fin_tramo  = Min(SAR_FECHA_BAJA,fec_fin_paga)                   'Fecha de inicio del periodo del empleado en la paga
dias_tot_tramo = DateDiff(fec_ini_tramo,fec_fin_tramo,M4_DAY) + 1   'Total días en el tramo analizado para empleado

dias_lic_no_desc = SAR_DIAS_LIC_NO_RETRIB..SysTotalslices(M4_TOTAL_SUM)     'Total días en el mes con Licencia no retribuida

If SCO_NUM_HOURS_THEO > 0 Then
    'Variables para el cálculo del Tiempo Teórico según la definición del módulo de Gestión del Tiempo.
    dias_tot_tramo = SAR_CALC_HORAS_TEORICAS(fec_ini_tramo,fec_fin_tramo)
ElseIf SAR_HS_DIARIAS_PROM > 0 Then
    'Se recogen las horas de todas las vacaciones
    'horas_lic_vac = horas_lic_vac + CommonTime(fec_ini_tramo,fec_fin_tramo,fec_ini_vac,fec_fin_vac) * SAR_HS_DIARIAS_PROM 
    dias_tot_tramo = dias_tot_tramo * SAR_HS_DIARIAS_PROM
EndIf    

dias_disp_desc = dias_tot_tramo - dias_lic_no_desc                  'Total días disponibles para descontar vacaciones

dias_desc_vac_ant = 0                                               'Total días pendientes de descuento de pagas anteriores
dias_desc_vac_act = 0                                               'Total días pendientes de descuento de la paga actual
dias_vac_ant_desc = 0                                               'Total días descontados pendientes de pagas anteriores
dias_tot_desc_vac = 0                                               'Total días Descuento Licencia por Vacaciones en la paga procesada


'2.- Comprobamos si existen descuentos pendientes de aplicar procedentes de periodos vacacionales anteriores al mes calculado. 
If SAR_ACM_ULT_PAGO_IMPUT.Count() > 0 Then
    SAR_ACM_ULT_PAGO_IMPUT.Begin()
    
    dias_desc_vac_ant = SAR_ACM_ULT_PAGO_IMPUT[0].SAR_EXC_DIAS_VAC

    If dias_desc_vac_ant > 0 Then
'Existen días de vacaciones pendientes de descontar. Comprobamos si se pueden descontar en el mes que estamos procesando.
        If SAR_ES_BAJA = 0 Then
            If dias_disp_desc >= dias_desc_vac_ant Then
            'Contabilizo el descuento de los días pendientes de pagas anteriores.
                dias_tot_desc_vac = dias_tot_desc_vac + dias_desc_vac_ant
            
            'Almaceno el valor de los días pendientes descontados en la paga actual.
                dias_vac_ant_desc = dias_desc_vac_ant
               
            'Actualizo el saldo de la variable que contiene los días disponibles.
                dias_disp_desc = dias_disp_desc - dias_desc_vac_ant

            'Actualizo el saldo de la variable que contiene los días pendientes de descontar.
                dias_desc_vac_ant = 0
            Else
            'Saldo el máximo número de días pendientes posibles, en función del número de días disponibles.
                dias_tot_desc_vac = dias_tot_desc_vac + dias_disp_desc
            
            'Almaceno el valor de las unidades, precio e importe de los días pendientes descontados en la paga actual.
                dias_vac_ant_desc = dias_disp_desc
            
            'Actualizo el saldo de la variable que contiene los días pendientes de descontar.
                dias_desc_vac_ant = dias_desc_vac_ant - dias_disp_desc
                
            'Actualizo el saldo de la variable que contiene los días disponibles -> Hemos agotado el número de días disponibles.  
                dias_disp_desc = 0
            EndIf
        Else
        'Si el empleado es baja en el mes no debemos limitar el tope de días disponibles para descontar ya que no van a poder descontarse a futuro.
            dias_tot_desc_vac = dias_tot_desc_vac + dias_desc_vac_ant

        'Almaceno el valor de los días pendientes descontados en la paga actual.
            dias_vac_ant_desc = dias_desc_vac_ant
        
        'Actualizo el saldo de la variable que contiene los días pendientes de descontar. 
            dias_desc_vac_ant = 0
        EndIf
    EndIf
Else
'No existen registros de cálculos anteriores, por lo tanto no tenemos ningún días pendiente de descontar.     
    dias_desc_vac_ant = 0

'Almaceno el valor de las unidades, precio e importe de los días pendientes descontados en la paga actual.
    dias_vac_ant_desc = dias_desc_vac_ant
EndIf


'3.- Comprobamos si existe algún periodo vacacional que comience en el mes de cálculo y deba ser descontado. 
num_reg_vac = SAR_VACACIONES.Count()

'Si no obtengo días de Licencia por vacaciones a descontar no opero con el saldo de días disponibles a descontar y continuo con la cantidad calculada.
If num_reg_vac > 0 Then
    primerreg = 0
    ultimoreg = SAR_VACACIONES.Count() - 1

    For i = primerreg To ultimoreg 
        SAR_VACACIONES.MoveTo(i)
    
        fec_ini_vac = SAR_VACACIONES.SCO_DT_START
        fec_fin_vac = SAR_VACACIONES.SCO_DT_END
        
        If SAR_HS_DIARIAS_PROM > 0 Then
            'Cálculo el total de días del periodo vacacional procesado que comienza en el mes de cálculo.
            dias_tot_vac_act = DateDiff(fec_ini_vac,fec_fin_vac,M4_DAY) + 1
            'Calculo de los días a descontar del periodo vacacional procesado que comienza en el mes de cálculo.
            dias_desc_vac_act = CommonTime(fec_ini_tramo,fec_fin_tramo,fec_ini_vac,fec_fin_vac)
            dias_tot_vac_act = dias_tot_vac_act * SAR_HS_DIARIAS_PROM
            dias_desc_vac_act = dias_desc_vac_act * SAR_HS_DIARIAS_PROM
        ElseIf SCO_NUM_HOURS_THEO > 0 Then
            'Variables para el cálculo del Tiempo Teórico según la definición del módulo de Gestión del Tiempo.
            dias_tot_vac_act = SAR_CALC_HORAS_TEORICAS(fec_ini_vac,fec_fin_vac + 1)
            fec_ini_desc_vac_act = Max(fec_ini_tramo,fec_ini_vac)
            fec_fin_desc_vac_act = Min(fec_fin_tramo,fec_fin_vac)
            dias_desc_vac_act = SAR_CALC_HORAS_TEORICAS(fec_ini_desc_vac_act,fec_fin_desc_vac_act + 1)
        EndIf    


        'Verifico si puedo actualizar el saldo de días disponibles a descontar en el mes.
        If SAR_ES_BAJA = 0 Then
            If dias_disp_desc >= dias_desc_vac_act Then
            'Contabilizo el descuento de los días de la paga actual.
                dias_tot_desc_vac = dias_tot_desc_vac + dias_desc_vac_act
                
            'Actualizo el saldo de la variable que contiene los días disponibles.
                dias_disp_desc = dias_disp_desc - dias_desc_vac_act
            
            'Actualizo el saldo de la variable que contiene los días pendientes de descontar.
                dias_desc_vac_ant = (dias_tot_vac_act - dias_desc_vac_act)
                
            'Actualizo el saldo de la variable que contiene los días actuales a descontar.
                dias_desc_vac_act = 0
            Else
            'Saldo el máximo número de días pendientes posibles, en función del número de días disponibles.
                dias_tot_desc_vac = dias_tot_desc_vac + dias_disp_desc
                           
            'Actualizo el saldo de la variable que contiene los días pendientes de descontar.
                dias_desc_vac_ant = dias_desc_vac_ant + (dias_desc_vac_act - dias_disp_desc) + (dias_tot_vac_act - dias_desc_vac_act)
                
            'Actualizo el saldo de la variable que contiene los días disponibles. Hemos agotado el número de días disponibles.
                dias_disp_desc = 0
            EndIf
        Else
        'Si el empleado es baja en el mes no debemos limitar el tope de días disponibles para descontar ya que no van a poder descontarse a futuro.
            dias_tot_desc_vac = dias_tot_desc_vac + dias_tot_vac_act
        
        'Actualizo el valor de la variable que contiene los días pendientes de descontar. 
            dias_desc_vac_ant = 0
        EndIf
    Next
EndIf


'4.- Actualizo el valor de los conceptos que acumulan los datos para el descuento de vacaciones.
SAR_EXC_DIAS_VAC      = dias_desc_vac_ant      'Total días pendientes de descuento de pagas anteriores
SAR_EXC_DIAS_VAC_DESC = dias_vac_ant_desc      'Total días pendientes de descuento descontados en paga actual

Return(dias_tot_desc_vac)
