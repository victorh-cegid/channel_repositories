'De acuerdo al artículo 3° el decreto 491/04 desde el 01/10/05 no hay topes para 
'el cálculo de la base imponible de las contribuciones.

base = SAR_PAGA_EXTRA_1 + SAR_PAGA_EXTRA_2
base_min_impo = (SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO)*(SAR_U_PAGA_EX_1+SAR_U_PAGA_EX_2)/2

IF SAR_ES_BAJA = 1 THEN
    base = SAR_EGRESO_PAGA_1 + SAR_EGRESO_PAGA_2
    base_min_impo = (SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO)*(SAR_U_EGRESO_PAGA_1+SAR_U_EGRESO_PAGA_2)/2
ENDIF

If(base > 0)Then
  base = Max(base, base_min_impo)
EndIf

RETURN(base)
