'Por Resolucion 3770/2015 se agregaron nuevos rangos para evaluar las deducciones en el impuesto a las ganancias.
'Este concepto lo mantendremos como historia de la reglamentacion anterior.
'A partir del mes de mayo 2015, traera el rango definido en el mes de abril.


'Recuperamos el valor del 792 del mes anterior        
    'Recorro el acumulado para obtener el v792 del mes anterior al que estoy liquidando.
    '----------------------------------------------------------------------------------------------
    ANIO_ACT = DXYEAR(SAR_FEC_PAGO_IG)
    MES_ACT  = DXMONTH(SAR_FEC_PAGO_IG)
    
    if SAR_ES_BAJA = 1 Then
        ANIO_ACT = DXYEAR(SCO_DT_PAYMENT)
        MES_ACT  = DXMONTH(SCO_DT_PAYMENT)
    endif
    
    If(MES_ACT = 1)Then
        MES_ANT = 12   
        ANIO_ANT = ANIO_ACT - 1
    Else   
        MES_ANT = MES_ACT - 1 
        ANIO_ANT = ANIO_ACT  
    EndIf
    
    DIAS_MES_ANT     = DaysOfMonth(MES_ANT)
    DIAS_MES_ANT_STR = ToString(DIAS_MES_ANT, 0)
    
    If(MES_ANT < 10)Then
        MES_ANT_STR = "0" + ToString(MES_ANT, 0)
    Else
        MES_ANT_STR = ToString(MES_ANT, 0)
    EndIf
    
    ANIO_ANT_STR  = Tostring(ANIO_ANT, 0)
    
    F_MES_ANT_INI = ToDate(ANIO_ANT_STR + "-" + MES_ANT_STR + "-" + "01")
    F_MES_ANT_FIN = ToDate(ANIO_ANT_STR + "-" + MES_ANT_STR + "-" + DIAS_MES_ANT_STR)  

    
    'Iniciamos la lectura del acumulado:
    SCO_AC_HR_PERIOD_READ_1.BEGIN()                 'Iniciamos el acumulado
    CantReg = SCO_AC_HR_PERIOD_READ_1.Count()-1    'Inicializamos el numero de registros
    
    If(CantReg >= 0) Then
      ContReg = 0                                     'Lleva el numero leido de registros 
      V792_ant  = -1
      While (ContReg <= CantReg)
         SCO_AC_HR_PERIOD_READ_1.MoveTo(ContReg)
         If(SCO_AC_HR_PERIOD_READ_1.SAR_FEC_PAGO_IG >= F_MES_ANT_INI And SCO_AC_HR_PERIOD_READ_1.SAR_FEC_PAGO_IG <= F_MES_ANT_FIN And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND (SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1" or SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "3" or SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "4")) Then
             V792_ant  = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM) 
         EndIf
         ContReg = ContReg + 1
      Wend    
    EndIf
     '-------------------------------------------------------------------------------

IF (CantReg  >= 0) THEN
    'Si tiene registros en el acumulado, debe retornar el v792 del mes anterior.
     RANGO = V792_ant
     
Else
    'Si no tiene acumulado, significa que es un alta nueva y debe armarse el v792
     
        'Se calcula el rango correspondiente al empleado.
        SAR_HR_ROLE.begin()
        SAR_HRROLE_CALC.begin()
        IND_DES = SAR_HRROLE_CALC.SAR_INDIC_REDUC_ZON_DES 'Indicador de zona desfavorable
        MAX_REM = SAR_MAYOR_REM_IG_2013   'Maxima remuneracion
        RANGO   = 0       'Rango a retornar: 0, 1, 2, 3
        

        If(MAX_REM <= 15000 )Then 'Rango 1
           RANGO = 1
        ElseIf(IND_DES <> 1 And MAX_REM > 15000 And MAX_REM <= 25000)Then 'Rango 2
           RANGO = 2
        ElseIf(IND_DES = 1 And MAX_REM > 15000)Then 'Rango 3
           RANGO = 3
        ElseIf(MAX_REM > 25000 )Then 'Rango 0
           RANGO = 0
        EndIf
        
ENDIF


Return(RANGO)
