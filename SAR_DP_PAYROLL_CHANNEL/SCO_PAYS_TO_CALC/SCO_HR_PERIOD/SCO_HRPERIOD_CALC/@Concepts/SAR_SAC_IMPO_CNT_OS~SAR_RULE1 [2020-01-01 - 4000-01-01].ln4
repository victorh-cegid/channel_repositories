'De acuerdo al artículo 3° el decreto 491/04 desde el 01/10/05 no hay topes para 
'el cálculo de la base imponible de las contribuciones.
Sac         = SAR_TOT_SAC_COTIZ + SAR_TOT_SAC_NO_REMUN
Tope_minimo = (SAR_CANT_B_MIN_AP_Y_CNT_OS * SAR_TOPE_B_MIN_IMPO)*(SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2 + SAR_U_PAGA_AJ_EX_1 + SAR_U_PAGA_AJ_EX_2 + SAR_U_EGRESO_PAGA_1 + SAR_U_EGRESO_PAGA_2)/2

/*Se calcula la base de acuerdo a los topes maximo y minimo*/
Base_Total = 0
Base       = 0

SAR_SAC_AJUSTE_CONTRIB.Begin()
If(SAR_SAC_AJUSTE_CONTRIB.Count() > 0)Then
   Base_Total       = SAR_SAC_AJUSTE_CONTRIB.SAR_SAC_IMPO_CNT_OS 'Contiene la suma de las bases anteriormente aplicadas.
   Sac_Total_Previo = SAR_SAC_AJUSTE_CONTRIB.SAR_TOT_SAC_COTIZ + SAR_SAC_AJUSTE_CONTRIB.SAR_TOT_SAC_NO_REMUN 'Contiene la suma de los SACs anteriormente liquidados.
EndIf   

Sac_Del_Mes = Sac_Total_Previo + Sac 'Contiene el total actual del SAC con paga actual incluida.
If SAR_COEF_JORNADA_PER <> 0 Then Sac_Del_Mes = Sac_Del_Mes / SAR_COEF_JORNADA_PER

If(Sac_Del_Mes < Tope_Minimo)Then         'Si No llegamos al tope minimo.....
   If(Base_Total = Tope_Minimo)Then       '   Si Existe una base con valor del minimo.....
     Base        = 0                      '     La base será 0. No se realiza descuento de O.S.
   Else                                   '   Si No.....
     Base = Tope_Minimo                   '     La base será el valor del minimo.      
   EndIf                                  '
Else                                      'Si No.... 
  Base = Sac_Del_Mes - Base_Total         '   La base será la diferencia entre  el SAC del mes y el total de la base.  
EndIf

RETURN(Base)
