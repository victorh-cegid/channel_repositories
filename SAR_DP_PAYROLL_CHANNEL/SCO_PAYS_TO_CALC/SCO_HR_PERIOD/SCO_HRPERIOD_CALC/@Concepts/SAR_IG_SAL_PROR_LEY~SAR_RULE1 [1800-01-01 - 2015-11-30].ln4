'No se ejecuta en la primera quincena
IF SAR_TP_IMPUT = "3" THEN RETURN (0)

'Por modificación del empleado se agregó: SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017"
IF ((SAR_MES_PAGO_IG=12 and SCO_DT_ALLOCATION = SCO_DT_PAYMENT) OR (SAR_ES_BAJA=1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017")) THEN RETURN(0)

dif=0
aux= SAR_LEY_19032_SAC+ SAR_IG_19032_NO_HAB

IF SCO_DT_ALLOCATION <> SCO_DT_PAYMENT THEN
   SAR_PAGA_ACTUAL_IMPUT.BEGIN()
   SAR_ACM_ULT_MES.BEGIN() 
   dif = SAR_LEY_19032_SAC + SAR_IG_19032_NO_HAB - SAR_PAGA_ACTUAL_IMPUT.SAR_LEY_19032_SAC - SAR_PAGA_ACTUAL_IMPUT.SAR_IG_19032_NO_HAB
   IF dif > 0 THEN
      aux = SAR_PAGA_ACTUAL_IMPUT.SAR_LEY_19032_SAC + SAR_PAGA_ACTUAL_IMPUT.SAR_IG_19032_NO_HAB
   ENDIF
   valor = aux - SAR_IG_CUO_PROR_LEY + SAR_ACM_ULT_MES.SAR_IG_SAL_PROR_LEY
    IF valor < 0 THEN
        valor = 0
    ENDIF
ELSE
   SAR_ACM_ULT_MES.BEGIN()
   SAR_INCRE_PRORRATEOS.BEGIN()
   valor = aux - SAR_IG_CUO_PROR_LEY + SAR_ACM_ULT_MES.SAR_IG_SAL_PROR_LEY + SAR_INCRE_PRORRATEOS.SAR_IG_PRO_A_LEY
ENDIF
RETURN(valor)
