IF SAR_TP_IMPUT = "77" OR SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

valor = SAR_PR_ASI_1347  * SAR_UN_ASI_1347

'Cálculo de los días a pagar
'
dias = SAR_DIAS_NORM_SUELD - SAR_DIAS_POST_BAJA - SAR_DIAS_HUELGA - SAR_LIC_S_GOC_SUELD  - SAR_R_PTO_ACC - SAR_R_PTO_ENF - SAR_R_PTO_SIN - SAR_DIAS_EXCEDENCIA - SAR_DIAS_SUS_DISCI  - SAR_DIAS_AUSENCIA 'Se descuentan los días impagos

IF dias < 0 THEN 
    Return(0)
ENDIF

IF SAR_DIAS_NORM_SUELD > 0 THEN
    valor = valor * dias / SAR_DIAS_NORM_SUELD   'Proporcionamos el importe a pagar de acuerdo a los dias pagos.
ELSE
    valor = 0
ENDIF

Return(valor)
