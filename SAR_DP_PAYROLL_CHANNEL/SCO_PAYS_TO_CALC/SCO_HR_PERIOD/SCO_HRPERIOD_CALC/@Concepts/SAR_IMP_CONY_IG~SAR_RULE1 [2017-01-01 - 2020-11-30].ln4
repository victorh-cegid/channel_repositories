'Inicializo variables
ano_pago_act = DxYear(SAR_FEC_IMPUT_IG)         'Año fecha imput IG cálculo actual
mes_pago_act = DxMonth(SAR_FEC_IMPUT_IG)        'Mes fecha imput IG cálculo actual
dia_pago_act = DaysOfMonth(SAR_FEC_IMPUT_IG) 	'Día fecha imput IG cálculo actual
indZonaPat = SAR_IND_ZONA_PAT                   'Indicador zona patagónica
indDeduc = SAR_IND_DED_IG_2010                  'Indicador deducción 2010
meses = 0

'Control, baja retroactiva debe calcularse respecto a la fecha de pago IG
If SAR_ES_BAJA = 1 Then
    ano_pago_act        = DxYear(SAR_FEC_PAGO_IG)      'Año fecha cálculo actual
    mes_pago_act        = DxMonth(SAR_FEC_PAGO_IG)     'Mes fecha cálculo actual
    dia_pago_act        = DaysOfMonth(SAR_FEC_PAGO_IG) 'Día fecha cálculo actual
EndIf

'Cargo el nodo de Familiares para Impuesto
SAR_FAMIL_IMPUESTO.DESTROYBLOCK()

SAR_FAMIL_IMPUESTO.SAR_FEC_INI_IG = DxDate("01", "01", ano_pago_act)
SAR_FAMIL_IMPUESTO.SAR_FEC_FIN_IG = DxDate("31", "12", ano_pago_act)

SAR_FAMIL_IMPUESTO.Load_Blk()

num_reg = SAR_FAMIL_IMPUESTO.Count()

If num_reg = 0 Then Return(0)

'Calculamos el precio mensual de los conceptos de Deducción partiendo del valor acumulado anual del mes de Diciembre, que figura por valores Empresa
If indZonaPat = 1 Then
    valorMensual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_VAL_CONY_IMP_REDUC",DxDate(dia_pago_act,mes_pago_act,ano_pago_act),indDeduc))
Else
    valorMensual = ToDouble(SAR_VAL_EMPRESA_IG.SAR_RET_VALOR_CONCEPTO(SCO_ID_LEG_ENT,"SAR_VAL_CONY_IMP",DxDate(dia_pago_act,mes_pago_act,ano_pago_act),indDeduc))
EndIf

If IsNull(valorMensual) = True Then valorMensual = 0

'Familiares activos a procesar
For i = 0 To num_reg - 1 
    SAR_FAMIL_IMPUESTO.MoveTo(i)
    parent = SAR_FAMIL_IMPUESTO.STD_ID_ACT_DEP_TYPE
    'Vamos a considerar el tipo de parentesco: Conyuge.	
    If parent = "1" Then
        'Inicializamos las variables para considerar el periodo fiscal.
        fec_alta_imp = SAR_FAMIL_IMPUESTO.SAR_DT_ALTA_IMP
'        fec_baja_imp = SAR_FAMIL_IMPUESTO.SAR_DT_BAJA_IMP
        fec_baja_imp = Min(SAR_FAMIL_IMPUESTO.SAR_DT_BAJA_IMP,SAR_FAMIL_IMPUESTO.DT_END)
        'Si no se ha informado fecha de baja en el impuesto asignamos el tope del año fiscal
        If IsNull(fec_baja_imp) = M4_TRUE Then fec_baja_imp = DxDate("31", "12", ano_pago_act)
        'Fecha inicio y fin a procesar, en enero un empleado no diferido serán 01/01/añoIG y 31/01/añoIG, un empleado diferido serán 01/01/añoIG y 28/02/añoIG
        fec_mes_ini = DxDate("01","01",ano_pago_act)
        fec_mes_fin = DxDate(dia_pago_act,mes_pago_act,ano_pago_act)
        'Si es baja y está activo el indicador de calcular el impuesto a diciembre, llevamos la fecha de fin a procesar a 31/12/IgImput actual        
        If SAR_IG_DICIEMBRE = 1 and SAR_ES_BAJA = 1 Then fec_mes_fin = DxDate("31", "12", ano_pago_act)
        'Topamos fechas de proceso y de impuesto del familiar
        fec_mes_ini = max(fec_alta_imp,fec_mes_ini)
        fec_mes_fin = min(fec_baja_imp,fec_mes_fin)
        'Para contar correctamente el numero de meses completos, llevamos la fecha de inicio al primer día del mes y la fecha fin al último día del mes
        fec_mes_ini = DxDate ("01",DxMonth(fec_mes_ini),DxYear(fec_mes_ini))
        fec_mes_fin = DxDate (DaysOfMonth(fec_mes_fin),DxMonth(fec_mes_fin),DxYear(fec_mes_fin))
        If fec_mes_fin>=fec_mes_ini Then meses = meses + DateDiff (fec_mes_ini,fec_mes_fin+1,M4_MONTH)
    EndIf
Next

importe = meses * valorMensual

Return(Round(importe,2))
