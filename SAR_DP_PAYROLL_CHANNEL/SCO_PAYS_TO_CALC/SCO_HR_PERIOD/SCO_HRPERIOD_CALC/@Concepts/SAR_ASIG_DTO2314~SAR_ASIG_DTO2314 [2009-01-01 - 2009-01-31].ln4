'El valor se ingresara por Tablas de Valor empresa
'El valor se corresponde con la Asignacion no remunerativa unica, de caracter alimentario de $200
'para todos los trabajadores cuyo haber mensual neto por todo concepto excluyendo asignaciones familiares
'no exceda de $1240.- al 31/12/2008. 

If (SCO_H_HR_PAY_FREQ.SCO_ID_PAY_FREQUENCY = "003") and (#SAR_TP_IMPUT = "3") then Return(0)  'Para empleados bimensuales/jornales solo se abona en la 2da quincena.

Asig = #SAR_ASIG_DTO2314

Sal_min = #SAR_SALARIO_MINIMO
Imp_devengos = 0
Imp_aportes = 0
Imp_asig_fam = 0
Imp_c_sindic =  0
Asig_jornal = 0
Imp_SAC_neto = 0
Imp_SAC = 0
Imp_Jub_SAC = 0
Imp_Ley_SAC = 0
Imp_O_Soc_SAC = 0
Imp_Adic_O_Soc_SAC = 0
   
If (SCO_H_HR_PAY_FREQ.SCO_ID_PAY_FREQUENCY = "003") AND (#SAR_TP_IMPUT = "4") Then    'Bimensuales
    SCO_AC_HR_PERIOD_READ_1.BEGIN()
    ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()- 1                
    FOR I = 0 TO ULTIMO_REG 
        SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
        
        if dxmonth(SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION) = 12 and dxyear(SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION) = 2008 Then
            Imp_devengos = Imp_devengos + SCO_AC_HR_PERIOD_READ_1.SAR_TOTAL_DEVENGOS
            Imp_aportes = Imp_aportes + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_APORTES
            Imp_asig_fam =  Imp_asig_fam + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_ASIG_FAM
            Imp_c_sindic = Imp_c_sindic + SCO_AC_HR_PERIOD_READ_1.SAR_C_SINDIC_VOL + SCO_AC_HR_PERIOD_READ_1.SAR_C_SINDICAL_SAC + SCO_AC_HR_PERIOD_READ_1.SAR_C_SINDICAL_VAC            
            
            Imp_SAC = Imp_SAC + SCO_AC_HR_PERIOD_READ_1.SAR_PAGA_EXTRA_2 + SCO_AC_HR_PERIOD_READ_1.SAR_PAGA_EXTRA_1
            Imp_Jub_SAC = Imp_Jub_SAC + SCO_AC_HR_PERIOD_READ_1.SAR_JUBILACION_SAC
            Imp_Ley_SAC = Imp_Ley_SAC + SCO_AC_HR_PERIOD_READ_1.SAR_LEY_19032_SAC
            Imp_O_Soc_SAC = Imp_O_Soc_SAC + SCO_AC_HR_PERIOD_READ_1.SAR_OBRA_SOCIAL_SAC
            Imp_Adic_O_Soc_SAC = Imp_Adic_O_Soc_SAC + SCO_AC_HR_PERIOD_READ_1.SAR_OB_SOC_ADIC_SAC
        endif

    NEXT 
    Imp_SAC_neto = Imp_SAC - Imp_Jub_SAC - Imp_Ley_SAC - Imp_O_Soc_SAC - Imp_Adic_O_Soc_SAC
   
    Imp_neto =  Imp_devengos - Imp_aportes - Imp_c_sindic - Imp_asig_fam   -  Imp_SAC_neto
 
         
ELSE   'Mensuales
    SAR_ACM_DEV_MES_ANT.begin()
    Imp_devengos = SAR_ACM_DEV_MES_ANT.#SAR_TOTAL_DEVENGOS 
    Imp_aportes = SAR_ACM_DEV_MES_ANT.#SAR_TOT_APORTES 
    Imp_asig_fam =  SAR_ACM_DEV_MES_ANT.#SAR_TOT_ASIG_FAM 
    Imp_c_sindic = SAR_ACM_DEV_MES_ANT.#SAR_C_SINDIC_VOL + SAR_ACM_DEV_MES_ANT.#SAR_C_SINDICAL_SAC  + SAR_ACM_DEV_MES_ANT.#SAR_C_SINDICAL_VAC 
    
    Imp_SAC = SAR_ACM_DEV_MES_ANT.#SAR_PAGA_EXTRA_1 + SAR_ACM_DEV_MES_ANT.#SAR_PAGA_EXTRA_2
    Imp_Jub_SAC = SAR_ACM_DEV_MES_ANT.#SAR_JUBILACION_SAC
    Imp_Ley_SAC = SAR_ACM_DEV_MES_ANT.#SAR_LEY_19032_SAC
    Imp_O_Soc_SAC = SAR_ACM_DEV_MES_ANT.#SAR_OBRA_SOCIAL_SAC
    Imp_Adic_O_Soc_SAC = SAR_ACM_DEV_MES_ANT.#SAR_OB_SOC_ADIC_SAC
    
    Imp_SAC_neto = Imp_SAC - Imp_Jub_SAC - Imp_Ley_SAC - Imp_O_Soc_SAC - Imp_Adic_O_Soc_SAC
        
    Imp_neto =  Imp_devengos - Imp_aportes - Imp_c_sindic - Imp_asig_fam -  Imp_SAC_neto
    
ENDIF

If Imp_neto <= Sal_min Then

    If #SAR_COEF_JORNADA_PER <> 1 Then   'Para empleados con Jornada Reducida, se proporcionaliza el valor de la Asignacion.
        Asig_jornal = Asig * #SAR_COEF_JORNADA_PER
        Return(Asig_jornal)
    else
        Return(Asig)
    endif
    
Else
    Return(0)
Endif
