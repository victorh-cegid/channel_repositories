'Este concepto recibe por parametro una id incidencia y retorna 1 si dicha incidencia es la situacion completa del mes (no solo de la paga)
'no contempla carga consecutiva de una misma incidencia.

'Asigna las fechas de inicio y fin del mes
fec_ini_mes = Max(DxDate("01",DxMonth(SCO_DT_ALLOCATION),DxYear(SCO_DT_ALLOCATION)),SAR_HR_PERIOD.STD_DT_START)
fec_fin_mes = Min(DxDate(DaysOfMonth(SCO_DT_ALLOCATION),DxMonth(SCO_DT_ALLOCATION),DxYear(SCO_DT_ALLOCATION)),SAR_HR_PERIOD.STD_DT_END)

'Comprueba si la incidencia comprende todo el mes
For i = 0 To SAR_REAL_TIME_PERIOD.COUNT() - 1
    SAR_REAL_TIME_PERIOD.MoveTo(i)
    fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START
    fec_fin_abs = SAR_REAL_TIME_PERIOD.SCO_DT_END
    motivoabs = SAR_REAL_TIME_PERIOD.SCO_ID_INCIDENCE
    If motivoabs = ARG_INC And fec_ini_abs <= fec_ini_mes And fec_fin_abs >= fec_fin_mes Then Return (1)
Next

Return(0)
