IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

IF (SAR_U_PAGA_EX_1 + SAR_U_PAGA_EX_2 + SAR_U_EGRESO_PAGA_1 + SAR_U_EGRESO_PAGA_2) = 0 THEN 
    Return(0)
ENDIF
edad = SAR_EDAD
valor = 0
fec = "2007-05-28"
IF edad >= 18 THEN
   'Modificaciones Decreto 313/07
 'Validamos que el alta sea posterior al 28/05/2007 y que sea nuevo aportante al Sistema de Jubilaciones
     IF SAR_FECHA_ALTA >= todate(Fec) and SAR_IND_NUE_AP = 1 then
         porc = 11
         valor =(SAR_IMP_JUBI) * porc / 100
      else 
         porc = SAR_PORC_JUBILACION - (SAR_PORC_JUBILACION*SAR_PP_AP_JUBILA/100)
         valor = SAR_IMP_JUBI * porc / 100
      endif
ENDIF
IF ISNULL(valor) = TRUE THEN
    valor = 0
ENDIF
Return(valor)
