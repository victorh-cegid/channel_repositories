'La primer línea calcula la base imponible para Obra Social según la RG 953/01 de la AFIP
'La segunda línea le pasa como parámetro dicho valor a un nodo que devuelve el % asociado 
'al tipo de obra social.
'La última realiza el cálculo

base = SAR_REMUN_IMPO_CNT + SAR_BASE_CO_ART_CNT + SAR_SAC_IMPO_CNT + SAR_VAC_IMPO_CNT 

baseos = SAR_OBRA_SOCIAL + SAR_ADIC_OB_SOCIAL + SAR_LEY_23660_PAT + SAR_PAT_23660_ART + SAR_ANSSAL_PAT
basesac = SAR_OBRA_SOCIAL_SAC + SAR_OB_SOC_ADIC_SAC + SAR_SAC_23660_PAT + SAR_ANSSAL_PAT_SAC
basevac = SAR_OB_SOC_ADIC_VAC + SAR_OBRA_SOCIAL_VAC + SAR_VAC_23660_PAT + SAR_ANSSAL_PAT_VAC

IF SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC <= ToDate("2002-03-21") THEN
  tipo = "2"
ELSE
  tipo = SAR_ID_TIPO_OS 
ENDIF

porc = SAR_ANSSAL.SAR_RETORNA_VALOR(base,tipo,ID_CURRENCY)


valor = (baseos+basesac+ basevac)* porc / 100

RETURN(valor)
