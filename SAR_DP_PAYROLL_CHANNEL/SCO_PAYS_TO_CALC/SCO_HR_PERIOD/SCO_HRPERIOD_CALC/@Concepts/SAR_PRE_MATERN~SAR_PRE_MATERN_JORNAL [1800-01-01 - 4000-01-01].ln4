IF SAR_TP_IMPUT = "2" OR SAR_TP_IMPUT = "99" THEN Return(0)

'Variables
id_Incidencia       = "3" 'Maternidad
Sueldo_fijo         = 0
Suma_variables      = 0
Promedio_variable   = 0

'Tramos
INICIO_TRAMO = SAR_TOT_P_COMP_EA_AUX..SysStartDate
FIN_TRAMO    = SAR_TOT_P_COMP_EA_AUX..SysEndDate

'Cargamos el nodo de incidencias del periodo, en caso de que no este ya cargado.
IF SAR_REAL_TIME_PERIOD.COUNT()= 0 THEN
SAR_REAL_TIME_PERIOD.LOAD_BLK()
ENDIF

'A?adimos filtro RAM al nodo cargado para quedarnos exclusivamente con los registros de Maternidad
sFilter = "If SCO_ID_INCIDENCE = ARG_SCO_ID_INCIDENCE Then Return(M4_TRUE) Else Return(M4_FALSE)"
SAR_REAL_TIME_PERIOD.ADDFILTER(sFilter, M4_TRUE, "ARG_SCO_ID_INCIDENCE", id_Incidencia)

'Si hay registros de Maternidad los recorremos para obtener la fecha de inicio
SAR_REAL_TIME_PERIOD.BEGIN()

WHILE SAR_REAL_TIME_PERIOD.ISEOF() = FALSE
fec_ini_abs = SAR_REAL_TIME_PERIOD.SCO_DT_START 	'fecha de inicio de la maternidad
SAR_REAL_TIME_PERIOD.GONEXT()
WEND

'Se elimina el filtro RAM aplicado al nodo
SAR_REAL_TIME_PERIOD.REMOVEFILTER()

If IsNull (fec_ini_abs)= M4_FALSE Then

	mes_ini_abs = DxMonth (fec_ini_abs)						'mes de inicio de la maternidad
	year_ini_abs = DxYear (fec_ini_abs)						'a?o de inicio de la maternidad
	inicio_mes_abs = DxDate (01, mes_ini_abs, year_ini_abs)	'inicio del mes de comienzo de la maternidad

        If(SAR_HR_PERIOD.STD_ID_HRP_START_REASON <> "005") Then
            fec_alta = SAR_FECHA_ALTA
        Else
            fec_alta = SAR_FECHA_ALTA_PER_ANT
        EndIf  

	fec_ini_calc = DateAdd(inicio_mes_abs,-3,M4_MONTH)		'fecha de inicio para el calculo de promedio variable, 3 meses atras del inicio del mes de la incapacidad
	fec_ini_calc = Max(fec_alta,fec_ini_calc)   			'si el empleado ha trabajado menos de 3 meses hasta inicio de incapacidad, la fecha de calculo para el promedio de variables es su fecha de alta

	'Recorremos el acumulado del empleado y recuperamos los variables de los 3 meses anteriores
	SCO_AC_HR_PERIOD_READ_1.BEGIN()
	ULTIMO_REG_AC = SCO_AC_HR_PERIOD_READ_1.COUNT() - 1

	IF ULTIMO_REG_AC > 0 THEN
		FOR I = 0 TO ULTIMO_REG_AC
			SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
			
			DT_PAG = SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION	'fecha de la paga del acumulado
			TP_PAG = SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC	'tipo de la paga
			
			IF  DT_PAG >= fec_ini_calc AND DT_PAG <= inicio_mes_abs AND TP_PAG = "4" THEN 'Pagas comprendidas entre la fecha de inicio a considerar para promedio variable y el inicio del mes de la maternidad y que son de tipo 2? quincena 
				Suma_variables = Suma_variables + SCO_AC_HR_PERIOD_READ_1.SAR_TOT_PROMEDIOS
			ENDIF
		NEXT
	ENDIF	

	Sueldo_fijo = SAR_TOT_P_COMP_EA
	Num_meses = Months(fec_ini_calc,inicio_mes_abs)	 'Num. meses para el calculo del promedio

	If Num_meses > 0 Then
		Promedio_variable = Suma_variables/Num_meses
		Promedio_variable = Promedio_variable/SAR_HORAS_MES	'Precio hora
	Endif
Endif

Valor_precio = Round(Sueldo_fijo + Promedio_variable, 2)

Return (Valor_precio)
