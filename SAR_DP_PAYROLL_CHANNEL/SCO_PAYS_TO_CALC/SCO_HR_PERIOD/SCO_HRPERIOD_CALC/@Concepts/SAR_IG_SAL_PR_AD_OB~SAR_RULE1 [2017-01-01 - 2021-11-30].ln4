'RG 3976. Se cierra esta norma a 31/12/2017. Se mantiene durante 2017 por si existiesen prorrateos pendientes del SAC del año 2016.

'Por modificación del empleado se agregó: SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017"
IF ((SAR_MES_PAGO_IG=12 and SCO_DT_ALLOCATION = SCO_DT_PAYMENT) OR (SAR_ES_BAJA=1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017")) THEN RETURN(0)

'No tomará valor en la paga normal de Junio si no existe ajuste:
If (SAR_TP_IMPUT = "1" And DxMonth(SCO_DT_PAYMENT) = 6 And SAR_PAGA_EXTRA_AJ_1 = 0 And SAR_IND_AGUINALDO = 0) Then
  Return(0)
EndIf

'No se ejecuta en la primera quincena
IF SAR_TP_IMPUT = "3" THEN RETURN (0)

aux_1q = 0
dif = 0

'Modificación RG3976.
base_mes_actual = 0

'Se agrega el valor de la Ti, para obtener el valor de la 1era quincena
If SAR_TP_IMPUT = "4" AND SAR_IND_AGUINALDO = 0 And SAR_PAGA_AJ_EXTRA_SAC = 0 Then 
    aux_1q = 0
EndIf  

aux = base_mes_actual + SAR_IG_AD_OS_NO_HAB + aux_1q

IF SCO_DT_ALLOCATION <> SCO_DT_PAYMENT THEN
   SAR_ACM_ULT_MES.BEGIN()
   SAR_PAGA_ACTUAL_IMPUT.BEGIN()
   SAR_INCRE_PRORRATEOS.BEGIN()
   dif = base_mes_actual + SAR_IG_AD_OS_NO_HAB - SAR_PAGA_ACTUAL_IMPUT.SAR_OB_SOC_ADIC_SAC - SAR_PAGA_ACTUAL_IMPUT.SAR_IG_AD_OS_NO_HAB
   IF dif > 0 THEN
      aux = SAR_PAGA_ACTUAL_IMPUT.SAR_OB_SOC_ADIC_SAC + SAR_PAGA_ACTUAL_IMPUT.SAR_IG_AD_OS_NO_HAB
   ENDIF
   valor= aux - SAR_IG_CUO_PR_AD_OB + SAR_ACM_ULT_MES.SAR_IG_SAL_PR_AD_OB
   IF valor < 0 THEN
        valor = 0
   ENDIF    
ELSE
    SAR_ACM_ULT_MES.BEGIN()
    IF ISNULL(SAR_ACM_ULT_MES.SAR_IG_SAL_PR_AD_OB) = FALSE THEN
        ig_saldo_pror_ad_ob = SAR_ACM_ULT_MES.SAR_IG_SAL_PR_AD_OB
    ELSE
        ig_saldo_pror_ad_ob = 0
    ENDIF
    SAR_INCRE_PRORRATEOS.BEGIN()
    IF ISNULL(SAR_INCRE_PRORRATEOS.SAR_IG_PRO_ADI_O) = FALSE THEN
        incre_ig_saldo_pror_ad_ob = SAR_INCRE_PRORRATEOS.SAR_IG_PRO_ADI_O
    ELSE
        incre_ig_saldo_pror_ad_ob = 0
    ENDIF
    
    valor= aux - SAR_IG_CUO_PR_AD_OB + ig_saldo_pror_ad_ob + incre_ig_saldo_pror_ad_ob
    
    If valor < SAR_IG_CUO_PR_AD_OB AND valor > 0 Then
        valor = SAR_IG_CUO_PR_AD_OB
    EndIf
ENDIF
RETURN(valor)
