If SAR_TP_IMPUT = "88" Then
    Return(0)
EndIf

edad = SAR_EDAD
porc = 0

If edad >= 18 Then porc = SAR_PORC_LEY_19032 - (SAR_PORC_LEY_19032 * SAR_PP_AP_INSSJP/100)

'En baja o reliquidación retornamos la diferencia entre el descuento del pago y el que se ha ido descontando mes a mes
If SAR_IND_PAGA_RELIQ = 1 Or SAR_ES_BAJA = 1 Or SAR_IND_AJU_SAC_OE = 1 Then 
    tot_desc_sac_pago = SAR_JUR_SAC * porc / 100
    tot_desc_sac_mes = SAR_ACM_IG_ANIO_IMPUT[0].SAR_LEY_19032_SAC_OE
    valor = tot_desc_sac_pago - tot_desc_sac_mes
    
    'Para evitar diferencias en reliquidación por redondeos
    If abs(valor) <= SAR_TOLERANCIA_DEC Then valor = 0
    
    Return (valor)
EndIf

base = SAR_B_PLUR_SAC_MES

valor = base * porc / 100

If IsNull(valor) = TRUE Then
    valor = 0
EndIf

Return(valor)
