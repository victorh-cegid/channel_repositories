'Importe SAC para reportes IG. Se resta importe de SAC imputado a años anteriores
If SAR_TP_IMPUT <> "99" And SAR_ES_BAJA = 0 And SAR_IND_AJUSTE_SAC = 0 Then Return(0) 
cuota_acum = SAR_ACM_IG_ANIO_IMPUT[0].SAR_PAGA_EXTRA_2 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_PAGA_EXTRA_AJ_2 + SAR_ACM_IG_ANIO_IMPUT[0].SAR_EGRESO_PAGA_2
cuota_act = SAR_PAGA_EXTRA_2 + SAR_PAGA_EXTRA_AJ_2 + SAR_EGRESO_PAGA_2
cuota_anio_ant = SAR_SAC_2_ANIO_ANT

'Tierra de fuego se quita la parte exenta
tfuegExen = SAR_ACM_IG_ANIO_IMPUT[0].SAR_TFUEG_EXT2_EXEN + SAR_TFUEG_EXT2_EXEN

Return Round(cuota_acum + cuota_act - cuota_anio_ant - tfuegExen,SAR_NUM_DEC)
