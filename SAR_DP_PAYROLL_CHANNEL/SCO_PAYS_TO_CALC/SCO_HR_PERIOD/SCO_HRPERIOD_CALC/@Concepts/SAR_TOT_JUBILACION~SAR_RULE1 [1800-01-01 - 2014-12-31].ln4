ban = SAR_TOT_M_JUB
val_otros_empl = SAR_JUBILACION_OE  'el 5118 (SAR_JUBILACION_OE) por empresa de retencion de ganancias
val_ant_emp = SAR_JUB_ANT_EMP     'el 5016 (SAR_JUB_ANT_EMP) por Anterior empresa de retencion de ganancias
sar_acum_jub_oe = 0
sar_acum_jub_ant_emp = 0

IF SAR_TP_IMPUT = "99" THEN
    ban = 0
    'val_otros_empl = 0
ENDIF

'Recorro el acumulado del empleado y sumarizo los valores para armar las TI.
SCO_AC_HR_PERIOD_READ_1.BEGIN()
ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()

I = ULTIMO_REG - 1 

WHILE I >= 0 
    SCO_AC_HR_PERIOD_READ_1.MOVETO(I)
       
    ' Armo los datos para SAR_ACM_IMPUESTO
    IF SAR_FEC_INI_IG <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SAR_FEC_PAGO_IG > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT = SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION THEN 
        sar_acum_jub_oe      = sar_acum_jub_oe + SCO_AC_HR_PERIOD_READ_1.SAR_JUBILACION_OE
        sar_acum_jub_ant_emp      = sar_acum_jub_ant_emp + SCO_AC_HR_PERIOD_READ_1.SAR_JUB_ANT_EMP
    ENDIF
    I = I - 1
Wend

val_otros_empl = val_otros_empl - sar_acum_jub_oe
val_ant_emp = val_ant_emp - sar_acum_jub_ant_emp

valor = ban + val_ant_emp + val_otros_empl  

RETURN(valor)
