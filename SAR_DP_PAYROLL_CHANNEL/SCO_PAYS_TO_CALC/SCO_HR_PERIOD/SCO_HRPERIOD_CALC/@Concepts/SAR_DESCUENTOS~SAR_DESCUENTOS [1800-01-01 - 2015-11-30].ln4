IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF


'Realizamos unos controles previos a la realización del descuento

SAR_H_DESCUENTOS.BEGIN()

'Si la moneda no es principal ...

IF SCO_IND_MAIN_CURR <> 1 THEN 
    Return(0) 
ENDIF

DESCUENTO = 0
EMBARGO = 0
VALOR = 0
EMB_CUO_ALIM = 0

Total_dev_1ra_quinc = 0
SAC_1ra_quinc = 0
IF SCO_H_HR_PAY_FREQ.SCO_ID_PAY_FREQUENCY = "003" THEN 
    SAR_ACM_PAG_QUIN_1RA.begin()
    if SAR_ACM_PAG_QUIN_1RA.count() > 0 AND SAR_TP_IMPUT = "4" Then
        Total_dev_1ra_quinc = SAR_ACM_PAG_QUIN_1RA.SAR_TOTAL_DEVENGOS
        SAC_1ra_quinc = SAR_ACM_PAG_QUIN_1RA.SAR_PAGA_EXTRA_1 + SAR_ACM_PAG_QUIN_1RA.SAR_PAGA_EXTRA_2
    else
        Total_dev_1ra_quinc = 0
        SAC_1ra_quinc = 0
    endif
ENDIF

primerreg = 0 
ultimoreg = SAR_H_DESCUENTOS.COUNT() - 1 
cont = 0 
tot_dev = SAR_TOTAL_DEVENGOS..SysTotalslices(M4_TOTAL_SUM)


FOR  I = primerreg  TO  ultimoreg 
    SAR_H_DESCUENTOS.MOVETO(I) 
    'Prevalece sobre los anticipos
    Liq_Sin_Ant = SAR_TOTAL_DEVENGOS..SysTotalslices(M4_TOTAL_SUM) - SAR_TOT_RETEN_DESC..SysTotalslices(M4_TOTAL_SUM) - DESCUENTO
    IF Liq_Sin_Ant <= 0 THEN 
       Return(0)
    ENDIF

    ARG_0 = SCO_ID_HR    
    ARG_1 = SCO_OR_HR_PERIOD    
    ARG_2 = SCO_PAYS_TO_CALC.SCO_DT_START_PAYM
    ARG_3 = SCO_DT_ALLOCATION    
    ARG_4 = SCO_PAYS_TO_CALC.SCO_DT_END_PAYM    
    ARG_5 = SAR_TP_IMPUT
    ARG_6 = SCO_PAYS_TO_CALC.SCO_PAY_FREQ_PAYM    
    ARG_7 = Liq_Sin_Ant

    IF IsNull(SAR_H_DESCUENTOS.SAR_ID_DMD_COMPONENT) = TRUE THEN 
       ARG_8 = 0 
    ELSE 
        IF SCO_H_HR_PAY_FREQ.SCO_ID_PAY_FREQUENCY = "003" THEN 
            ARG_8 = GetValue (SAR_H_DESCUENTOS.SAR_ID_NODE,SAR_H_DESCUENTOS.SAR_ID_DMD_COMPONENT,0)
            ARG_8 = ARG_8 + Total_dev_1ra_quinc
        ELSE
            ARG_8 = GetValue (SAR_H_DESCUENTOS.SAR_ID_NODE,SAR_H_DESCUENTOS.SAR_ID_DMD_COMPONENT,0) 
        ENDIF
    ENDIF 

    ARG_9 = ID_CURRENCY    
    ARG_10 = SAR_ES_BAJA
    ARG_11 = SAR_ANULAR_DESCUENTO
    ARG_DESC = 0
    ARG_RETJUD = 0
    porc = SAR_H_DESCUENTOS.SAR_PORCENTAJE
    
    // Control de grabación para simulaciones, si se ejecuta la nomina simulada la tabla de descuentos no se modifica.  
    ARG_GRABA = 0
    If SAR_PAYS_TO_CALC.SCO_SAVEYTD=1 And SAR_PAYS_TO_CALC.SCO_PAY_SIMUL = 0 Then
        ARG_GRABA = SAR_PAYS_TO_CALC.SCO_SAVEYTD 
    EndIf   
        

    ARG_12 = SAR_H_DESCUENTOS.SAR_OR_DESCUENTO
    If SAR_H_DESCUENTOS.SAR_PORCENTAJE <> 0 Then 
        ARG_13 = 0          'Es Porcentaje del líquido 
    Else 
        If SAR_H_DESCUENTOS.SAR_FACTOR <> 0 Then 
           ARG_13= 2          'Es factor variable 
        else 
           ARG_13 = 1          'Es Cantidad fija 
        endif   
    EndIf 
        
    'Agregado de control con Salario minimo     
    ARG_14 = SAR_SALARIO_MINIMO
    ARG_15 = 0


    'Agregado de control con el Valor del SAC
    IF SAR_H_DESCUENTOS.SAR_ID_DESCUENTO = "3" Then
        'Se agrega la variable SAC_1ra_quinc para el caso que el SAC sea pago en la primera quincena.
        'Se agregan los conceptos de Ajuste de SAC
        SAC = SAR_PAGA_EXTRA_1 + SAR_PAGA_EXTRA_2 + SAC_1ra_quinc + SAR_EGRESO_PAGA_1 + SAR_EGRESO_PAGA_2
        if SAC > 0 Then
            ARG_15 = SAC
        else
            ARG_15 = 0
        endif  
        IF SCO_H_HR_PAY_FREQ.SCO_ID_PAY_FREQUENCY = "003" THEN 
           IF SAR_TP_IMPUT = "3"  AND SAR_ES_BAJA = 0 Then   'Los embargos judiciales solo se calculan en la segunda quincena. Teniendo en cuenta todo lo devengado en el mes.
                ARG_7 = 0
                ARG_8 = 0
                ARG_15 = 0
           ENDIF
        ENDIF      
    EndIf

    aux = DESCUENTOS!SAR_MT_H_DESCUENTOS.SAR_CALC_DESCUENTO(ARG_0,ARG_1,ARG_2,ARG_3,ARG_4,ARG_5,ARG_6,ARG_7,ARG_8,ARG_9,ARG_10,ARG_11,ARG_DESC,ARG_RETJUD,ARG_GRABA,ARG_12,ARG_13,ARG_14,ARG_15)

    EMBARGO      =  SAR_UN_DESCUENTOS * ARG_RETJUD + EMBARGO
    
    ' Validación para discriminar el Embargo cuota alimentaria.
    If SAR_H_DESCUENTOS.SAR_ID_DESCUENTO = "4" Then
        
        EMB_CUO_ALIM =  SAR_UN_DESCUENTOS * ARG_DESC + EMB_CUO_ALIM 
    
    Else
        
        VALOR =  SAR_UN_DESCUENTOS * ARG_DESC + VALOR
        
    EndIf
    
    DESCUENTO    = EMBARGO + VALOR 
NEXT

SAR_RET_JUDICIAL = EMBARGO
SAR_EMB_CUO_ALIM = EMB_CUO_ALIM

Return(valor)
