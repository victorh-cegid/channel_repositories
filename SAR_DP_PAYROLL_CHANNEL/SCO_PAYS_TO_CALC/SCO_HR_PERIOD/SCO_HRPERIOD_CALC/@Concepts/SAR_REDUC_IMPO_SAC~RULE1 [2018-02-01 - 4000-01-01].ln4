'Para generar dependencias
a = SAR_REDUC_IMPO
coef = SAR_COEF_JORNADA_PER
importeSac = SAR_REDUC_IMPO_SAC / 2
coefJornada = 1

'Parte proporcional para jornales que se rijan por el modelo de semana
If SAR_TIPO_SALARIO = "003" Or coef <> 1 Then 
    coefJornada = 0
    horasPaga = 0
    
    If DxMonth(SCO_DT_ALLOCATION) < 7 Then
        FecIni = DxDate("01","01",DxYear(SCO_DT_ALLOCATION))
        FecFin = DxDate("30","06",DxYear(SCO_DT_ALLOCATION))
    Else
        FecIni = DxDate("01","07",DxYear(SCO_DT_ALLOCATION))
        FecFin = DxDate("31","12",DxYear(SCO_DT_ALLOCATION))
    EndIf
    
    'Control altas o bajas
    FecIni = Max(FecIni,SAR_HR_PERIOD.STD_DT_START)
    FecFin = Min(FecFin,SAR_HR_PERIOD.STD_DT_END)
    Meses = (Date30Ex(FecFin+1) - Date30Ex(FecIni))/30
    horasTotales = SAR_HORAS_MES * Meses
    
    horasPaga = SAR_CALC_HORAS_TEORICAS (FecIni,FecFin)

    'Si en la paga hay horas informadas, se calcula el total en base a las horas promedio informadas, 
    'en cualquier otra situación se toma el calendario de referencia
    If SAR_CANT_HS_TRABAJADAS > 0 Then horasPaga = 180 * SAR_HS_DIARIAS_PROM

    If horasTotales > 0 Then coefJornada = horasPaga / horasTotales
EndIf

importeSac = importeSac * coefJornada

Return Round(importeSac,2)
