IF SAR_TP_IMPUT = "88" OR SAR_TP_IMPUT = "99" THEN
    Return(0)
ENDIF

'No debe tomar el valor en Pagas Extra.
If (SAR_TP_IMPUT = "2") Then
    Return(0)    
EndIf

sac   = SAR_PAGA_EXTRA_1 + SAR_PAGA_EXTRA_2 + SAR_EGRESO_PAGA_1 + SAR_EGRESO_PAGA_2
valor = 0	 
aux   = SAR_PR_AGUINALDO
aux   = SAR_UNIDADES_PROV_SAC

if sac <> 0 then 
    valor= sac  
else 
    valor= round(SAR_PR_AGUINALDO * SAR_UNIDADES_PROV_SAC,2)
endif  

return(valor)
