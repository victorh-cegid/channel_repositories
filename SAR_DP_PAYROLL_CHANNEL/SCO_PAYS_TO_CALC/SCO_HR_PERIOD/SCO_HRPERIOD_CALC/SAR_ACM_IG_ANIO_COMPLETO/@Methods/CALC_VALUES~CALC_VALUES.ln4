iFilter = SCOPE_REGISTER + TYPE_PROPERTY
iItemCount = GetNodeNumberOfItems(GetThisNodeId(), iFilter)
If iItemCount <> 0 Then
   dt_alloc = SCO_DT_ALLOCATION 
   dt_pay = SCO_DT_PAYMENT 
    YTDSearchFiltered("",ID_NODE_AC_READ,SCO_DT_START,SCO_DT_END,dt_alloc,dt_pay,PAY_FRECUENCY,PAY_TYPE,SEARCH_TYPE,REV_BEHAVIOUR,SEL_PAYS,TOT_OPERATION , "SAR_FEC_PAGO_IG", SAR_HRPERIOD_CALC.SAR_FEC_INI_FILTRO_IG, GREATER_OR_EQUAL, "SAR_FECHA_IMPUTACION", SAR_HRPERIOD_CALC.SAR_FECHA_IMPUTACION, SMALLER, "SAR_FEC_PAGO_IG", SAR_HRPERIOD_CALC.SAR_FEC_PAGO_IG, SMALLER_OR_EQUAL)

   MoveTo (0) 
EndIf 
Return(1)
