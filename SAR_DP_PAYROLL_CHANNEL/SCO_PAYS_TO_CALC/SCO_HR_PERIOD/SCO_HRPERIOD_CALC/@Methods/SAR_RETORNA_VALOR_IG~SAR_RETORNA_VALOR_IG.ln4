val_otras_imp = 0
val_hijo_imp = 0
val_cony_imp = 0
tope_seg_vida = 0
tope_gast_sep = 0
tope_ser_dom = 0
tope_seg_ret = 0
ded_especial = 0
gan_no_imp = 0

SAR_EMPRESA_VALUES.DESTROYBLOCK()
SAR_EMPRESA_VALUES.SAR_EMPRESA = ARG_EMPRESA
SAR_EMPRESA_VALUES.SAR_FECHA_IG = ARG_FECHA_IG
SAR_EMPRESA_VALUES.LOAD_BLK()

If SAR_EMPRESA_VALUES.count() > 0 Then
        SAR_EMPRESA_VALUES.BEGIN()
        ULTIMO_REG = SAR_EMPRESA_VALUES.COUNT()- 1
        FOR I = 0 TO ULTIMO_REG 
           SAR_EMPRESA_VALUES.MOVETO(I)
              
           if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_VAL_OTRAS_IMP" Then
                val_otras_imp = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
           
            if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_VAL_HIJO_IMP" Then
                val_hijo_imp = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
           
           if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_VAL_CONY_IMP" Then
                val_cony_imp = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
           
          if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_TOPE_SEG_VIDA" Then
                tope_seg_vida = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
           
          if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_TOPE_GAST_SEP" Then
                tope_gast_sep = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
           
           if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_TOPE_SER_DOM" Then
                tope_ser_dom = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
           
           if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_TOPE_SEG_RET" Then
                tope_seg_ret = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
           
           if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_DED_ESPECIAL" Then
                ded_especial = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
           
            if SAR_EMPRESA_VALUES.ID_DMD_COMPONENT = "SAR_GAN_NO_IMP" Then
                gan_no_imp = SAR_EMPRESA_VALUES.SCO_VALUE
           endif
        NEXT    
EndIf

'SAR_VAL_HIJO_IMP = val_hijo_imp
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_VAL_HIJO_IMP",-1,val_hijo_imp)

'SAR_VAL_CONY_IMP = val_cony_imp
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_VAL_CONY_IMP",-1,val_cony_imp)

'SAR_TOPE_SEG_VIDA = tope_seg_vida
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_TOPE_SEG_VIDA",-1,tope_seg_vida)

'SAR_TOPE_GAST_SEP = tope_gast_sep
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_TOPE_GAST_SEP",-1,tope_gast_sep)

'SAR_TOPE_SER_DOM = tope_ser_dom
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_TOPE_SER_DOM",-1,tope_ser_dom)

'SAR_TOPE_SEG_RET = tope_seg_ret
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_TOPE_SEG_RET",-1,tope_seg_ret)

'SAR_DED_ESPECIAL = ded_especial
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_DED_ESPECIAL",-1,ded_especial)

'SAR_GAN_NO_IMP = gan_no_imp
SetValuePriority(0,"SCO_HRPERIOD_CALC","SAR_GAN_NO_IMP",-1,gan_no_imp)


return(val_otras_imp)
