no_hab_exen_oe = 0
sac_1_exen_oe = 0
sac_2_exen_oe = 0
per_ant_no_grav_oe = 0
remun_piso = 0
/* SiRADIG versión 1.16*/
bono_prod_oe = 0
bono_prod_oe_mes = 0
fallo_caja_oe = 0
fallo_caja_oe_mes = 0
similar_nat_oe = 0
similar_nat_oe_mes = 0
ley_27549_oe = 0
art57_ley19101_oe = 0
gastos_dec27_oe = 0	
imp_mov_oe = 0
imp_ana_oe = 0
id_trans_dist = 0
id_trans_terr = 0

'Reliquidación en 2023, se leen complementos desde septiembre (octubre diferidos) hasta diciembre
indReliq = SAR_IND_PAGA_RELIQ
If indReliq = 1 And DxYear(SAR_FEC_IMPUT_IG) = 2023 Then indReliq = 0

If SAR_ES_BAJA = 1 and SAR_IG_DICIEMBRE = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" Then
    mes_paga_efecti = 12
Else
    mes_paga_efecti = DxMonth(SAR_FEC_IMPUT_IG)
    If (SAR_IND_PAGA_RELIQ = 1) Then
        AUX = SAR_RANGO_REM_IG_2013() 'Llamamos a la ejecucion del concepto necesario para obtener el rango de la remuneracion por decreto 1242 / 2013.
    EndIf  
EndIf

SAR_H_COMPLEM_GCIAS.BEGIN() 

If SAR_H_COMPLEM_GCIAS.count() > 0 Then
    ULTIMO_REG = SAR_H_COMPLEM_GCIAS.COUNT()- 1
    FOR I = 0 TO ULTIMO_REG 
        SAR_H_COMPLEM_GCIAS.MOVETO(I)
        If IsNull(SAR_H_COMPLEM_GCIAS.SAR_ID_ENTIDAD)= M4_FALSE then
             entidad = SAR_H_COMPLEM_GCIAS.SAR_ID_ENTIDAD
        endif
        
        'Si es necesario se realiza la conversión de monedas:
        vRecordCurrency  = SAR_H_COMPLEM_GCIAS.SAR_ID_CURRENCY
        vPayrollCurrency = SAR_HRPERIOD_CALC.ID_CURRENCY
        
        if vRecordCurrency <> vPayrollCurrency then
            SAR_H_COMPLEM_GCIAS.CUREXCHANGERECORD(vPayrollCurrency ,m4_false)
        EndIf

        anio_paga = Dxyear(SAR_FEC_IMPUT_IG)

        IF DxYear(SAR_H_COMPLEM_GCIAS.SAR_DT_START) = anio_paga THEN
        
        
            'Variable imput_act valdra 1 cuando nos encontremos en un registro que corresponda al mes de imputacion que se esta procesando
            imput_act = 0
            If SAR_H_COMPLEM_GCIAS.SAR_DT_START <= SAR_PAYS_TO_CALC.SCO_DT_END_ALLOC And SAR_H_COMPLEM_GCIAS.SAR_DT_END >= SAR_PAYS_TO_CALC.SCO_DT_START_ALLOC Then imput_act = 1
        
            'Variable imput_ig valdra 1 cuando nos encontremos en un registro que corresponda al mes de imputacion IG que se esta procesando
            imput_ig = 0
            inicioImput = DxDate(1,DxMonth(SAR_FEC_IMPUT_IG),DxYear(SAR_FEC_IMPUT_IG))
            finImput = DxDate(DaysOfMonth(SAR_FEC_IMPUT_IG),DxMonth(SAR_FEC_IMPUT_IG),DxYear(SAR_FEC_IMPUT_IG))
            If SAR_H_COMPLEM_GCIAS.SAR_DT_START <= inicioImput And SAR_H_COMPLEM_GCIAS.SAR_DT_END >= finImput Then imput_ig = 1

            '--Importe de remuneraciones para piso IG ley 27617: Se toman unicamente las coincidentes con el mes que se procesa
            If imput_ig = 1 And (entidad = "01" Or entidad = "13") then 
                If SAR_H_COMPLEM_GCIAS.SAR_BRUTO <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_BRUTO) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_BRUTO
                Endif
                If SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC
                Endif
                If SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT
                Endif                
                If SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE
                Endif 
                If SAR_H_COMPLEM_GCIAS.SAR_IMP_OTROS_CONCEPT_ANA_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_OTROS_CONCEPT_ANA_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_IMP_OTROS_CONCEPT_ANA_OE
                Endif 
                If SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE
                Endif      
                If SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE
                Endif  
                If SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV
                Endif  
/* SiRADIG versión 1.16*/
                If SAR_H_COMPLEM_GCIAS.SAR_IMP_BONOS_PROD_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_BONOS_PROD_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_IMP_BONOS_PROD_OE
                    bono_prod_oe_mes = bono_prod_oe_mes + SAR_H_COMPLEM_GCIAS.SAR_IMP_BONOS_PROD_OE
                    SAR_IMP_BONOS_OE_MES = bono_prod_oe_mes    'OE - Bono por productividad mes
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_IMP_FCAJA_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_FCAJA_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_IMP_FCAJA_OE
                    fallo_caja_oe_mes = fallo_caja_oe_mes + SAR_H_COMPLEM_GCIAS.SAR_IMP_FCAJA_OE
                    SAR_IMP_FCAJAS_OE_MES = fallo_caja_oe_mes    'OE - fallos de caja OE mes
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE
                    similar_nat_oe_mes = similar_nat_oe_mes + SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE
                    SAR_IMP_SIMILAR_NAT_OE_MES = similar_nat_oe_mes    'OE - fallos de caja OE mes
                Endif   
                If SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE
                Endif      
                If SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE
                Endif  
                If SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE) = M4_False Then
                    remun_piso = remun_piso + SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE
                Endif                
            EndIf

'--------------------------------------------------------------------------------------------------------------------
'                             Entidades con valores mensuales 
'--------------------------------------------------------------------------------------------------------------------

            'Decreto 473/23 reglamentacion AFIP, inicia periodo fiscal en octubre
            mes_corte = 1
            iniComp = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START)
            mesesImp = mes_paga_efecti
            If DxYear(SAR_FEC_IMPUT_IG) = 2023 And mes_paga_efecti >= 10 Then
                iniComp = Max(iniComp,10)
                mes_corte = 10
                mes_imp_ig = SAR_DIFERIDO_SEPT_2023[0].SAR_MES_IMPUT_IG

                'Situacion especial, diferidos devengado septiembre con impuesto octubre, quedan en paga de septiembre
                If mes_imp_ig = 10 Then
                    If mes_paga_efecti = 10 Then 
                        Return(0)
                    Else
                        iniComp = Max(iniComp,11)
                        mes_corte = 11
                    EndIf
                EndIf
                mesesImp = mes_paga_efecti - mes_corte + 1
            EndIf

            IF (SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA = "1" AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti /*Or indReliq = 1*/)) THEN

                If entidad = "01" Then      '--Anteriores Empresas--
                    If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then
                        If (indReliq = 1) Then
                            dif_meses_01 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1

                            if SAR_H_COMPLEM_GCIAS.SAR_JUBILACION <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_JUBILACION) = M4_False Then
                                  imp_jub_01 = imp_jub_01 + (SAR_H_COMPLEM_GCIAS.SAR_JUBILACION * dif_meses_01)
                            endif
                            
                            if SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_LEY_19032) = M4_False Then
                                imp_ley_01 = imp_ley_01 + (SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 * dif_meses_01)
                            endif
    
                            if SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL) = M4_False Then
                                imp_o_soc_01 = imp_o_soc_01 + (SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL * dif_meses_01)
                            endif
        
                            if SAR_H_COMPLEM_GCIAS.SAR_RETENCION <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_RETENCION) = M4_False Then
                                imp_ret_01 = imp_ret_01 + (SAR_H_COMPLEM_GCIAS.SAR_RETENCION * dif_meses_01)
                            endif
    
                            if SAR_H_COMPLEM_GCIAS.SAR_BRUTO <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_BRUTO) = M4_False Then
                                imp_bruto_01 = imp_bruto_01 + (SAR_H_COMPLEM_GCIAS.SAR_BRUTO * dif_meses_01)
                            endif
    
                            if SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL) = M4_False Then
                                imp_c_sind_01 = imp_c_sind_01 + (SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL * dif_meses_01)
                            endif
                        
                            if SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC) = M4_False Then
                                imp_o_deducc_01 = imp_o_deducc_01 + (SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC * dif_meses_01)
                            endif
    
                            if SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA) = M4_False Then
                                imp_seg_v_01 = imp_seg_v_01 + (SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA * dif_meses_01)
                            endif
    
                            if SAR_H_COMPLEM_GCIAS.SAR_SEGURO_SEPELIO <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SEGURO_SEPELIO) = M4_False Then
                                imp_seg_sep_01 = imp_seg_sep_01 + (SAR_H_COMPLEM_GCIAS.SAR_SEGURO_SEPELIO * dif_meses_01)
                            endif   
                           

                            

                                                     
                        Else
                            ' Defino la cantidad de meses a procesar
                            If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                dif_meses_01 = mes_paga_efecti - iniComp + 1                                    
                            Else 'Caso en el que el complemento haya terminado antes debemos quedarnos con el calculo completo a su fin.
                                dif_meses_01 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - iniComp + 1                                    
                            EndIf 
                        
                            
                            ' SAR_JUBILACION
                            if SAR_H_COMPLEM_GCIAS.SAR_JUBILACION <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_JUBILACION) = M4_False Then
                                imp_jub_01 = imp_jub_01 + (SAR_H_COMPLEM_GCIAS.SAR_JUBILACION * dif_meses_01)
                            endif
    
    
                            'SAR_LEY_19032
                            If SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_LEY_19032) = M4_False Then
                                imp_ley_01 = imp_ley_01 + (SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 * dif_meses_01)
                            endif
    
    
                            'SAR_OBRA_SOCIAL
                            If SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL) = M4_False Then
                                imp_o_soc_01 = imp_o_soc_01 + (SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL * dif_meses_01)
                            endif
    
    
                            'SAR_RETENCION
                            If SAR_H_COMPLEM_GCIAS.SAR_RETENCION <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_RETENCION) = M4_False Then
                                imp_ret_01 = imp_ret_01 + (SAR_H_COMPLEM_GCIAS.SAR_RETENCION * dif_meses_01)
                            endif
        
        
                            'SAR_BRUTO
                            If SAR_H_COMPLEM_GCIAS.SAR_BRUTO <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_BRUTO) = M4_False Then
                                imp_bruto_01 = imp_bruto_01 + (SAR_H_COMPLEM_GCIAS.SAR_BRUTO * dif_meses_01)
                            endif
                            
                            
                            'SAR_CUOTA_SINDICAL
                            If SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL) = M4_False Then
                                imp_c_sind_01 = imp_c_sind_01 + (SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL * dif_meses_01)
                            endif
                            
                            
                            'SAR_OTRAS_DEDUC
                            If SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC) = M4_False Then
                                imp_o_deducc_01 = imp_o_deducc_01 + (SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC * dif_meses_01)                                
                            endif
    
    
                            'SAR_SEGURO_VIDA
                            If SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA) = M4_False Then                             
