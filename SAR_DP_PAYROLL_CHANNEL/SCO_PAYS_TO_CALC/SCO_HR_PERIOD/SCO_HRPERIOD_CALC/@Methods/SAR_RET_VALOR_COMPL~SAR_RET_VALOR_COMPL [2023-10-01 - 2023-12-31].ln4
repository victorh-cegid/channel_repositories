                                imp_tot_33   = imp_tot_33 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_33)
                            EndIf
                        Endif
                    Endif
                    frec_33 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                'fin entidad 33  
                
                ElseIf entidad = "34" then '--Alquiler de Inmuebles destinados a casa habitación (Propietarios)--        
                    If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then
                        If(indReliq = 1)Then
                            dif_meses_34 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                            imp_tot_34   = imp_tot_34 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_34)                                                                
                        Else
                            If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                dif_meses_34 = mes_paga_efecti - iniComp + 1
                                imp_tot_34   = imp_tot_34 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_34)
                            Else
