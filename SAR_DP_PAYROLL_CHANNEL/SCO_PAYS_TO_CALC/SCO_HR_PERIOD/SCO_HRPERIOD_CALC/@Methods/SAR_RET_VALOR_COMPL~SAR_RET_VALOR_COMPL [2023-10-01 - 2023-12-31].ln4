                'fin entidad 62     				
				
                ElseIf entidad = "20" then '--Resolucion General (AFIP) 3819/2015'--        
                    If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti Or (SAR_TP_IMPUT = "99") ) Then
                        If(SAR_TP_IMPUT = "99")Then
                            dif_meses_20 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                            imp_tot_20   = imp_tot_20 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_20)                                                                
                        Else
                            If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                dif_meses_20 = mes_paga_efecti - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                imp_tot_20   = imp_tot_20 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_20)
                            Else
                                dif_meses_20 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1 
                                imp_tot_20   = imp_tot_20 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_20)
                            EndIf
                        Endif
                    Endif
                    frec_20 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                'fin entidad 20                  
                
                ElseIf entidad = "32" then '--Gastos educativos--        
                    If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then
                        If(indReliq = 1)Then
                            dif_meses_32 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                            imp_tot_32   = imp_tot_32 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_32)                                                                
                        Else
                            If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                dif_meses_32 = mes_paga_efecti - iniComp + 1
                                imp_tot_32   = imp_tot_32 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_32)
                            Else
                                dif_meses_32 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - iniComp + 1 
                                imp_tot_32   = imp_tot_32 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_32)
                            EndIf
                        Endif
                    Endif
                    frec_32 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                'fin entidad 32                   

                ElseIf entidad = "33" then '--Alquiler de Inmuebles destinados a casa habitación (Inquilinos)--        
                    If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then
                        If(indReliq = 1)Then
                            dif_meses_33 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                            imp_tot_33   = imp_tot_33 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_33)                                                                
                        Else
