                    endif
                    frec_09 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                                                
                ElseIf entidad = "11" then '--Debitos y creditos bancarios--        
                    IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti Or (SAR_TP_IMPUT = "99") ) THEN
                        If(SAR_TP_IMPUT = "99")Then
                            dif_meses_11 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                            imp_tot_11   = imp_tot_11 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_11)                                                                
                        Else
                            If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                dif_meses_11 = mes_paga_efecti - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                imp_tot_11   = imp_tot_11 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_11) 
                            Else
                                dif_meses_11 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1 
                                imp_tot_11   = imp_tot_11 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL  * dif_meses_11)
                            EndIf
                        endif
                    endif                        
                    frec_11 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                                                
                ElseIf entidad = "12" then '--Servicio Domestico--        
                        If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then
                            If(indReliq = 1)Then
                                dif_meses_12 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                imp_tot_12   = imp_tot_12 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_12)                                                                
                            Else
                                If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                    dif_meses_12 = mes_paga_efecti - iniComp + 1
                                    imp_tot_12   = imp_tot_12 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_12)
                                Else
                                    dif_meses_12 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - iniComp + 1 
                                    imp_tot_12   = imp_tot_12 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_12)
                                EndIf
                            endif
                        endif
                        frec_12 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                                                   
                ElseIf entidad = "13"  then '- Ingresos otros empleadores  --        

                    If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then
                        ' Procesamos los cada tipo de importe:
                        ' Deducciones:
                        If(indReliq = 1)Then
                            dif_meses_13 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                            
                            'Meses para primera y segunda paga sac, separados
                            sac_jun_mes_ini = Max(1,DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START))
                            sac_jun_mes_fin = Min(6,DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))+1
                            sac_jun_meses = Max(0,sac_jun_mes_fin - sac_jun_mes_ini)
                            sac_dic_meses = Max(0,dif_meses_13 - sac_jun_meses)
                            
                            
                            If (SAR_H_COMPLEM_GCIAS.SAR_JUBILACION > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_JUBILACION) = M4_False) Then
                               jubilacion_oe = jubilacion_oe + (SAR_H_COMPLEM_GCIAS.SAR_JUBILACION * dif_meses_13)
                            EndIf
                            
                            If (SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_LEY_19032) = M4_False ) Then   
                               ley_19032_oe = ley_19032_oe + (SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 * dif_meses_13)
                            EndIf 
                              
                            If (SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL) = M4_False ) Then
                               obra_social_oe = obra_social_oe + (SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL * dif_meses_13)
                            EndIf
                            
                            If (SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL) = M4_False ) Then   
                               cuota_sindical_oe = cuota_sindical_oe + (SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL * dif_meses_13)
                            EndIf 
'se agregan los nuevos valores de los campos de "Importe Exento / no Alcanzado" y "Salario Anual Complementario"
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC) = M4_False ) Then
                               vImpoteExentoNoAlcanzado = vImpoteExentoNoAlcanzado + (SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC * dif_meses_13)
                            EndIf 
                            If (SAR_H_COMPLEM_GCIAS.SAR_SAC > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SAC) = M4_False ) Then   
                               vSAComplementario = vSAComplementario + (SAR_H_COMPLEM_GCIAS.SAR_SAC * dif_meses_13)
                               jur_sac_jun = jur_sac_jun + (SAR_H_COMPLEM_GCIAS.SAR_SAC * sac_jun_meses)
                               jur_sac_dic = jur_sac_dic + (SAR_H_COMPLEM_GCIAS.SAR_SAC * sac_dic_meses)
                            EndIf                             
                            ' Haberes
                            If (SAR_H_COMPLEM_GCIAS.SAR_BRUTO > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_BRUTO) = M4_False ) Then
                               bruto_oe = bruto_oe + (SAR_H_COMPLEM_GCIAS.SAR_BRUTO * dif_meses_13)
                            EndIf                                
                            ' Retencion
                            If (SAR_H_COMPLEM_GCIAS.SAR_RETENCION <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_RETENCION) = M4_False ) Then
                               retencion_oe = retencion_oe + (SAR_H_COMPLEM_GCIAS.SAR_RETENCION * dif_meses_13)
                            EndIf
                            'Horas extra exentas oe
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT) = M4_False) Then
                                hs_ex_exen_oe = hs_ex_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT * dif_meses_13)
                            EndIf 
                            'Retribuciones no habituales OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE) = M4_False ) Then
                                no_hab_oe = no_hab_oe + (SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE * dif_meses_13)
                            EndIf
                            'Viáticos remuneración OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE) = M4_False ) Then
                                mov_via_trib_oe = mov_via_trib_oe + (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE * dif_meses_13)
                            EndIf
                            'Movilidad remuneración OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE) = M4_False ) Then
                                imp_mov_oe = imp_mov_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE * dif_meses_13)
                            EndIf
                            'Analogos remuneración OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_OTROS_CONCEPT_ANA_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_OTROS_CONCEPT_ANA_OE) = M4_False ) Then
                                imp_ana_oe = imp_ana_oe + (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE * dif_meses_13)
                            EndIf                            
                            'ID Transporte de larga distancia OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_TRANSP_LARGA_DIST_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_TRANSP_LARGA_DIST_OE) = M4_False ) Then
                                id_trans_dist = 1
                            EndIf
                            'ID Transporte terrestre de larga distancia OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_TRANSP_TERR_LARG_DIST_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_TRANSP_TERR_LARG_DIST_OE) = M4_False ) Then
                                id_trans_terr = 1
                            EndIf
                            'Material didáctico docente gravada OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE) = M4_False ) Then
                                mat_dic_trib_oe = mat_dic_trib_oe + (SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE * dif_meses_13)
                            EndIf
                            'Movilidad y viáticos remuneración exenta OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE) = M4_False ) Then
                                mov_via_exen_oe = mov_via_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE * dif_meses_13)
                            EndIf
                            'Material didáctico docente exento OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE) = M4_False ) Then
                                mat_dic_exen_oe = mat_dic_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE * dif_meses_13)
                            EndIf
                            'OE - Ajustes Per. Ant. - Remuneraciones Gravadas
                            If (SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE) = M4_False ) Then
                                per_ant_grav_oe = per_ant_grav_oe + (SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE * dif_meses_13)
                            EndIf
                            'OE - Ajustes Per. Ant. - Remun Exentas/No alcanzadas
                            If (SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE) = M4_False ) Then
                                per_ant_no_grav_oe = per_ant_no_grav_oe + (SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE * dif_meses_13)
                            EndIf
                            'OE - Retrib. No habituales Exentas / No alcanzadas
                            If (SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE) = M4_False ) Then
                                no_hab_exen_oe = no_hab_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE * dif_meses_13)
                            EndIf
                            'OE - SAC Primera Cuota Exentas / No alcanzadas
                            If (SAR_H_COMPLEM_GCIAS.SAR_SAC_1_EXEN_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SAC_1_EXEN_OE) = M4_False ) Then
                                sac_1_exen_oe = sac_1_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_SAC_1_EXEN_OE * dif_meses_13)
                            EndIf
                            'OE - SAC Segunda Cuota Exentas / No alcanzadas
                            If (SAR_H_COMPLEM_GCIAS.SAR_SAC_2_EXEN_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SAC_2_EXEN_OE) = M4_False ) Then
                                sac_2_exen_oe = sac_2_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_SAC_2_EXEN_OE * dif_meses_13)
                            EndIf                                                                                                                

                            'Horas extra tributables oe
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV) = M4_False) Then
                                hs_ex_trib_tot_oe = hs_ex_trib_tot_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV * dif_meses_13)
                            EndIf 
/* SiRADIG versión 1.16*/
                            'OE - Bono por productividad
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_BONOS_PROD_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_BONOS_PROD_OE) = M4_False ) Then
                                bono_prod_oe = bono_prod_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_BONOS_PROD_OE * dif_meses_13)
                            EndIf
                            'OE - Fallos de Caja
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_FCAJA_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_FCAJA_OE) = M4_False ) Then
                                fallo_caja_oe = fallo_caja_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_FCAJA_OE * dif_meses_13)
                            EndIf
                            'OE - Conceptos similar Naturaleza
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE) = M4_False ) Then
                                similar_nat_oe = similar_nat_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE * dif_meses_13)
                            EndIf
                            'OE - Remuneración exenta Ley 27549
                            If (SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE) = M4_False ) Then
                                ley_27549_oe = ley_27549_oe + (SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE * dif_meses_13)
                            EndIf
                            'OE - Supl particular a.57 Ley 19101
                            If (SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE) = M4_False ) Then
                                art57_ley19101_oe = art57_ley19101_oe + (SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE * dif_meses_13)
                            EndIf
                            'OE - Comp. gastos art.10 Dec.27/21
                            If (SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE) = M4_False ) Then
                                gastos_dec27_oe = gastos_dec27_oe + (SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE * dif_meses_13)
                            EndIf
                        Else                        
                            ' Defino la cantidad de meses a procesar
                            If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                dif_meses_13 = mes_paga_efecti - iniComp + 1
                                sac_jun_mes_fin = Min(6,mes_paga_efecti)+1                                    
                            Else
                                dif_meses_13 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - iniComp + 1 
                                sac_jun_mes_fin = Min(6,DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))+1                                   
                            EndIf 
                            'Meses para primera y segunda paga sac, separados
                            sac_jun_mes_ini = Max(1,DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START))
                            sac_jun_meses = Max(0,sac_jun_mes_fin - sac_jun_mes_ini)
                            sac_dic_meses = Max(0,dif_meses_13 - sac_jun_meses)
                            If (SAR_H_COMPLEM_GCIAS.SAR_JUBILACION > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_JUBILACION) = M4_False ) Then
                                jubilacion_oe = jubilacion_oe + (SAR_H_COMPLEM_GCIAS.SAR_JUBILACION * dif_meses_13)
                            EndIf
                            
                            If (SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_LEY_19032) = M4_False ) Then   
                                ley_19032_oe = ley_19032_oe + (SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 * dif_meses_13)
                            EndIf   
                            
                            If (SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL) = M4_False ) Then
                                obra_social_oe = obra_social_oe + (SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL * dif_meses_13)
                            EndIf
                            
                            If (SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL) = M4_False ) Then   
                                cuota_sindical_oe = cuota_sindical_oe + (SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL * dif_meses_13)
                            EndIf  
'se agregan los nuevos valores de los campos de "Importe Exento / no Alcanzado" y "Sueldo Anual Complementario"
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC) = M4_False ) Then
                               vImpoteExentoNoAlcanzado = vImpoteExentoNoAlcanzado + (SAR_H_COMPLEM_GCIAS.SAR_IMP_EXE_NO_ALC * dif_meses_13)
                            EndIf 
                            If (SAR_H_COMPLEM_GCIAS.SAR_SAC > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SAC) = M4_False ) Then   
                               vSAComplementario = vSAComplementario + (SAR_H_COMPLEM_GCIAS.SAR_SAC * dif_meses_13)
                               jur_sac_jun = jur_sac_jun + (SAR_H_COMPLEM_GCIAS.SAR_SAC * sac_jun_meses)
                               jur_sac_dic = jur_sac_dic + (SAR_H_COMPLEM_GCIAS.SAR_SAC * sac_dic_meses)
                               If imput_ig = 1 Then jur_sac_oe_mes = jur_sac_oe_mes + (SAR_H_COMPLEM_GCIAS.SAR_SAC)
                               EndIf
                            'Horas extra tributables oe
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV) = M4_False) Then
                                hs_ex_trib_tot_oe = hs_ex_trib_tot_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_GRAV * dif_meses_13)
                            EndIf  
                            'Horas extra exentas oe
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT) = M4_False) Then
                                hs_ex_exen_oe = hs_ex_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_HS_EXTRAS_EXENT * dif_meses_13)
                            EndIf                             
                            ' Haberes
                            If (SAR_H_COMPLEM_GCIAS.SAR_BRUTO > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_BRUTO) = M4_False) Then
                                bruto_oe = bruto_oe + (SAR_H_COMPLEM_GCIAS.SAR_BRUTO * dif_meses_13)
				        If imput_ig = 1 Then bruto_oe_sac = bruto_oe_sac + (SAR_H_COMPLEM_GCIAS.SAR_BRUTO)
                            EndIf    
                            ' Retención
                            If (SAR_H_COMPLEM_GCIAS.SAR_RETENCION <> 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_RETENCION) = M4_False ) Then
                               retencion_oe = retencion_oe + (SAR_H_COMPLEM_GCIAS.SAR_RETENCION * dif_meses_13)
                            EndIf                                
                            'Retribuciones no habituales OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE) = M4_False ) Then
                                no_hab_oe = no_hab_oe + (SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_OE * dif_meses_13)
                            EndIf
                            'Viáticos remuneración OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE) = M4_False ) Then
                                mov_via_trib_oe = mov_via_trib_oe + (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_TRIB_OE * dif_meses_13)
                            EndIf
                            'Movilidad remuneración OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE) = M4_False ) Then
                                imp_mov_oe = imp_mov_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_MOVILIDAD_OE * dif_meses_13)
                            EndIf
                            'Analogos remuneración OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_OTROS_CONCEPT_ANA_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_OTROS_CONCEPT_ANA_OE) = M4_False ) Then
                                imp_ana_oe = imp_ana_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_OTROS_CONCEPT_ANA_OE * dif_meses_13)
                            EndIf                            
                            'ID Transporte de larga distancia OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_TRANSP_LARGA_DIST_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_TRANSP_LARGA_DIST_OE) = M4_False ) Then
                                id_trans_dist = 1
                            EndIf
                            'ID Transporte terrestre de larga distancia OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_TRANSP_TERR_LARG_DIST_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_TRANSP_TERR_LARG_DIST_OE) = M4_False ) Then
                                id_trans_terr = 1
                            EndIf                                                        
                            'Material didáctico docente gravada OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE) = M4_False ) Then
                                mat_dic_trib_oe = mat_dic_trib_oe + (SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_TRIB_OE * dif_meses_13)
                            EndIf
                            'Movilidad y viáticos remuneración exenta OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE) = M4_False ) Then
                                mov_via_exen_oe = mov_via_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_MOV_VIA_EXEN_OE * dif_meses_13)
                            EndIf
                            'Material didáctico docente exento OE
                            If (SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE) = M4_False ) Then
                                mat_dic_exen_oe = mat_dic_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_MAT_DIC_EXEN_OE * dif_meses_13)
                            EndIf
                            'OE - Ajustes Per. Ant. - Remuneraciones Gravadas
                            If (SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE) = M4_False ) Then
                                per_ant_grav_oe = per_ant_grav_oe + (SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_GRAV_OE * dif_meses_13)
                            EndIf
                            'OE - Ajustes Per. Ant. - Remun Exentas/No alcanzadas
                            If (SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE) = M4_False ) Then
                                per_ant_no_grav_oe = per_ant_no_grav_oe + (SAR_H_COMPLEM_GCIAS.SAR_PER_ANT_NO_GRAV_OE * dif_meses_13)
                            EndIf
                            'OE - Retrib. No habituales Exentas / No alcanzadas
                            If (SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE) = M4_False ) Then
                                no_hab_exen_oe = no_hab_exen_oe + (SAR_H_COMPLEM_GCIAS.SAR_NO_HAB_EXEN_OE * dif_meses_13)
                            EndIf
