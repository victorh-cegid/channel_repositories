        ElseIf SAR_IND_VIAJANTE = 2 Then 'Deducción transporte larga distancia
            SAR_DED_TRANS = imp_tot_17
        ElseIf SAR_IND_VIAJANTE = 3 Then 'Deducción transporte carga larga distancia
