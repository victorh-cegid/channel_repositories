                            If (SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE) = M4_False ) Then
                                similar_nat_oe = similar_nat_oe + (SAR_H_COMPLEM_GCIAS.SAR_IMP_SIMILAR_NAT_OE * dif_meses_13)
                            EndIf
                            'OE - Remuneración exenta Ley 27549
                            If (SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE) = M4_False ) Then
                                ley_27549_oe = ley_27549_oe + (SAR_H_COMPLEM_GCIAS.SAR_LEY_27549_OE * dif_meses_13)
                            EndIf
                            'OE - Supl particular a.57 Ley 19101
                            If (SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE) = M4_False ) Then
                                art57_ley19101_oe = art57_ley19101_oe + (SAR_H_COMPLEM_GCIAS.SAR_SUPL_LEY_19101_OE * dif_meses_13)
                            EndIf
                            'OE - Comp. gastos art.10 Dec.27/21
                            If (SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE > 0 And IsNull(SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE) = M4_False ) Then
                                gastos_dec27_oe = gastos_dec27_oe + (SAR_H_COMPLEM_GCIAS.SAR_GASTOS_DEC27_OE * dif_meses_13)
                            EndIf                            
                        Endif
                    EndIf  

                    elseif entidad = "14" then '--ganancias reciprocas--                    
                        If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then                          
                            If(indReliq = 1)Then
                                    dif_meses_14 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    imp_tot_14 = imp_tot_14 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_14                                                               
                            Else 
                               If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                 dif_meses_14 = mes_paga_efecti - iniComp + 1
                                 imp_tot_14 = imp_tot_14 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_14)
                               Else
                                 dif_meses_14 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - iniComp + 1   
                                 imp_tot_14 = imp_tot_14 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL  * dif_meses_14   
                               EndIf
                            EndIf ' paga 99
                         EndIf' comienza antes del mes a liquidar
                'fin entidad 14
                Elseif entidad = "15" then '--Pago a cuenta - Compras en el exterior--        
                    IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti Or (SAR_TP_IMPUT = "99") ) THEN
                        If(SAR_TP_IMPUT = "99")Then
                            dif_meses_15 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                            imp_tot_15   = imp_tot_15 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_15)                                                                
                        Else
                            If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                dif_meses_15 = mes_paga_efecti - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                imp_tot_15   = imp_tot_15 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_15) 
                            Else
                                dif_meses_15 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1 
                                imp_tot_15   = imp_tot_15 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_15)
                            EndIf                             
                        EndIf                                
                    endif
                    frec_15 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                elseif entidad = "16" then '--vehiculos corredores y viajantes de comercio--                    
                        If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then                          
                            If(indReliq = 1)Then
                                    dif_meses_16 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    imp_tot_16 = imp_tot_16 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_16                                                               
                            Else 
                               If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                 dif_meses_16 = mes_paga_efecti - iniComp + 1
                                 imp_tot_16 = imp_tot_16 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_16
                               Else
                                 dif_meses_16 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - iniComp + 1   
                                 imp_tot_16 = imp_tot_16 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL  * dif_meses_16   
                               EndIf
                            EndIf ' paga 99
                         EndIf' comienza antes del mes a liquidar
                'fin entidad 16       
                elseif entidad = "17" then '--movilidad corredores y viajantes de comercio--                    
                        If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then                                                
                            If(indReliq = 1)Then
                                    dif_meses_17 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    imp_tot_17 = imp_tot_17 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_17                                                               
                            Else 
                               If (mes_paga_efecti <= DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END))Then
                                 dif_meses_17 = mes_paga_efecti - iniComp + 1
                                 imp_tot_17 = imp_tot_17 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_17
                               Else
                                 dif_meses_17 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - iniComp + 1   
                                 imp_tot_17 = imp_tot_17 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL  * dif_meses_17   
                               EndIf
                            EndIf ' paga 99
                         EndIf' comienza antes del mes a liquidar
                'fin entidad 17      
                elseif entidad = "18" then '--movilidad corredores y viajantes de comercio--                    
                        If (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti And DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_corte) Or indReliq = 1 Then                                                 
                            If(indReliq = 1)Then
                                    dif_meses_18 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    imp_tot_18 = imp_tot_18 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_18                                                               
                            Else 
