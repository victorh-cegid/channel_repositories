                                imp_tot_34   = imp_tot_34 + (SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_34)
                            EndIf
                        Endif
                    Endif
                    frec_34 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                'fin entidad 34                  
                
                EndIf
