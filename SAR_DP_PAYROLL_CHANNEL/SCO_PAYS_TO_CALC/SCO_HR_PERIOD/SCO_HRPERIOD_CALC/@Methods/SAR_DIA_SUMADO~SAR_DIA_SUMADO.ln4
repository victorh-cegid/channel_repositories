DIAS_SUMADOS = SAR_P_DIAS_SUMADOS
FECHA = TOSTRING(DXYEAR(ARG_FECHA),0) + TOSTRING(DXMONTH(ARG_FECHA),0) + TOSTRING(DXDAY(ARG_FECHA),0)
LONGITUD = LENGTH(DIAS_SUMADOS)
WHILE LONGITUD > 0 
    DIA = MID(DIAS_SUMADOS,0,8)
    IF DIA = FECHA THEN
        RETURN(TRUE)
    ENDIF
    DIAS_SUMADOS = MID(DIAS_SUMADOS,8,LONGITUD-8)
    LONGITUD = LONGITUD - 8
WEND

RETURN(0)
