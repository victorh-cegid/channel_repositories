'Busca el primer rango del empleado en el a?o fiscal. Es utilizado para los empleados que estan en zona 
'comun o pasaron a zona comun y possen mejor remuneracion > $25000.
'     Segun:   
' 1- El alta es anterior o igual al inicio del a?o fiscal: Se toma el inicio del a?o fiscal.
' 2- El alta es posterior al inicio del a?o fiscal: Se toma el alta del empleado.    
'
'NOTA: Se destaca la situacion en que el empleado posee v5600 > $25000 y por ello se invoco este metodo
'      por lo tanto iniciamos con valor 0.   

Fecha_Inicio_Fiscal = SAR_FEC_INI_IG
Fecha_Del_alta      = SAR_FECHA_ALTA
Fecha_De_Busqueda   = Max(SAR_FEC_INI_IG, SAR_FECHA_ALTA) 

Fecha_Ini_Busqueda = DxDate(1, DxMonth(Fecha_De_Busqueda), DxYear(Fecha_De_Busqueda))
Fecha_Fin_Busqueda = DxDate(DxDaysOfMonth(Fecha_De_Busqueda, DxYear(Fecha_De_Busqueda)), DxMonth(Fecha_De_Busqueda), DxYear(Fecha_De_Busqueda))

Anio_Recalculo = 2015 

SCO_AC_HR_PERIOD_READ_1.BEGIN() 'Iniciamos el acumulado.

Reg_Acu     = SCO_AC_HR_PERIOD_READ_1.Count() - 1 'Inicializamos el numero de registros.   
Rango       = 0  'Si se encuentra el rango se retorna el correspondiente al mes sino se retorna 0.
Buscar_Zona = 1   'Cuando se encuentra el rango correspondiente esta variable sera -1.

If(Reg_Acu >= 0)Then     
     Contador = 0 
     While(Contador <= Reg_Acu And Buscar_Zona = 1) 
         SCO_AC_HR_PERIOD_READ_1.MoveTo(Contador)          
         If(SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION >= Fecha_Ini_Busqueda And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION <= Fecha_Fin_Busqueda And SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION = SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT AND SCO_AC_HR_PERIOD_READ_1.SCO_PAY_TYPE_ALLOC = "1") Then
            Fecha_Mes_Actual = SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION 'Mes en la paga acumulada inicia en la ultima paga.
            Mes_Actual       = DxMonth(Fecha_Mes_Actual)
            Zona_actual      = SAR_HR_ROLE.SAR_OBTENER_LUGAR_ZONA(Fecha_Mes_Actual)  'Obtenemos la zona vigente de la paga acumulada.
            Zona_actual      = ToString(ToDouble(Zona_actual), 0) 
            Mejor_Rem_Mes    = SCO_AC_HR_PERIOD_READ_1.SAR_MAYOR_REM_IG_2013..sysTotalSlices(M4_TOTAL_SUM)                       
            If(Mes_Actual < 5 Or Mes_Actual > 8 Or DxYear(SCO_AC_HR_PERIOD_READ_1.SCO_DT_ALLOCATION) > Anio_Recalculo)Then           
                     Rango  = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2015..sysTotalSlices(M4_TOTAL_SUM)  
                     If(Zona_actual = "1")Then 'La zona del inicio del a?o fiscal y del alta es desfavorable entonces el rango retornado sera 0
                       Rango = 0
                     EndIf 
            ElseIf(Mejor_Rem_Mes <= 15000 )Then 'Rango 1
                        Rango = 1
            ElseIf(Zona_actual = "0"  And Mejor_Rem_Mes > 15000 And Mejor_Rem_Mes <= 25000)Then 'Rango 2
                       Rango = 2
            ElseIf(Mejor_Rem_Mes > 25000)Then 'Rango 0
                       Rango = 0
            EndIf
            Buscar_Zona = -1
         EndIf  
         Contador = Contador + 1           
     Wend   
EndIf 
Return(Rango)
