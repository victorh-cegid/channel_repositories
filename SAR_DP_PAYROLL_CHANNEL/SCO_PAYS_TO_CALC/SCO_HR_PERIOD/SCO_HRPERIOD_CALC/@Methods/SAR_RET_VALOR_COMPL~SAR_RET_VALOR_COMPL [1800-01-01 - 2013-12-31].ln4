                            ''imp_tot_13 = imp_tot_13 / 12 * mes
                        'endif
                        'frec_13 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA

                    endif                
                ENDIF        
            ENDIF
        NEXT    
ENDIF           
  
    
'---Leer el acumulado, para los casos de las entidades con frecuencia mensual.
       
mes_1 = AddMonths(SAR_FEC_PAGO_IG,-1)
mes = DxMonth(mes_1)
anio = DxYear(SAR_FEC_PAGO_IG)


IF SAR_TP_IMPUT = "99" Then
    param1 =  DxDate(1,12,anio)
Else
    param1 = DxDate(1,mes,anio)
endif
param2 = SAR_FEC_PAGO_IG
   
IF SAR_TP_IMPUT = "99" Then 'Procesa exclusivamente rango 1 y
  If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then 'Procesa exclusivamente rango 1 y 
      mes_paga_efecti = DxMonth(fec_1)
  EndIf  
EndIf  

IF imp_tot_02 > 0 AND frec_02 = "2"  THEN
        imp_tot_02 = imp_tot_02 / 12 * mes_paga_efecti
ENDIF    
IF imp_tot_03 > 0 AND frec_03 = "2"  THEN
        imp_tot_03 = imp_tot_03 / 12 * mes_paga_efecti
ENDIF
IF imp_tot_05 > 0 AND frec_05 = "2"  THEN
        imp_tot_05 = imp_tot_05 / 12 * mes_paga_efecti
ENDIF
IF imp_tot_06 > 0 AND frec_06 = "2"  THEN
