jubilacion_oe = 0
ley_19032_oe = 0
obra_social_oe = 0
cuota_sindical_oe = 0
bruto_oe = 0


'-------------------
'dif_meses_no_trabajados es una variable que contiene los meses desde la fecha de baja hasta Diciembre
'Se usa para el caso de obtener el monto de deducciones mensuales de un empleado desde la fecha de baja
'hasta Diciembre
 dif_meses_no_trabajados = 0  
 If(SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" )Then
    If(DXYEAR(SAR_FECHA_BAJA) = DXYEAR(SAR_FEC_PAGO_IG))Then
      dif_meses_no_trabajados = 12 - DXMONTH(SAR_FECHA_BAJA)  
    EndIf   
 EndIf   
'-------------------
  
mes_paga_efecti = SAR_MES_PAGO_IG
If (SAR_TP_IMPUT = "99") Then
    'Se obtiene el valor del concepto necesario para tener el rango de la remuneración por decreto 1242 / 2013.
    SCO_AC_HR_PERIOD_READ_1.BEGIN()
    ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()- 1
    FOR j = 0 TO ULTIMO_REG 
        SCO_AC_HR_PERIOD_READ_1.MOVETO(j)
        IF (DxMonth(SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG) = mes_paga_efecti) THEN        
            RANGO_REM_IG_2013 = SCO_AC_HR_PERIOD_READ_1.SAR_RANGO_REM_IG_2013
        Endif
    Next

    fec_1=SAR_FEC_PAGO_IG
    fec_2=SAR_FEC_FIN_IG_DEC        
    if (SAR_IG_DEC142_AUX = 0) and (RANGO_REM_IG_2013 = 1)Then 
        fec_1 = fec_2
    endif 
EndIf  

Load_blk()

SAR_H_COMPLEM_GCIAS.BEGIN() 

If SAR_H_COMPLEM_GCIAS.count() > 0 Then
        ULTIMO_REG = SAR_H_COMPLEM_GCIAS.COUNT()- 1
        FOR I = 0 TO ULTIMO_REG 
            SAR_H_COMPLEM_GCIAS.MOVETO(I)
            If IsNull(SAR_H_COMPLEM_GCIAS.SAR_ID_ENTIDAD)= M4_FALSE then
                 entidad = SAR_H_COMPLEM_GCIAS.SAR_ID_ENTIDAD
            endif
           
            'Si es necesario se realiza la conversión de monedas:
            vRecordCurrency = SAR_H_COMPLEM_GCIAS.SAR_ID_CURRENCY
            vPayrollCurrency = SAR_HRPERIOD_CALC.ID_CURRENCY
            
		if vRecordCurrency <> vPayrollCurrency then
			SAR_H_COMPLEM_GCIAS.CUREXCHANGERECORD(vPayrollCurrency ,m4_false)
		EndIf

            
            IF DxYear(SAR_H_COMPLEM_GCIAS.SAR_DT_START) = Dxyear(SAR_FEC_PAGO_IG) THEN
        
'--------------------------------------------------------------------------------------------------------------------
'                             Entidades con valores mensuales 
'--------------------------------------------------------------------------------------------------------------------

                IF (SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA = "1" AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti /*Or SAR_TP_IMPUT = "99"*/)) THEN

                    If entidad = "01" then '--Anteriores Empresas--
                      IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti)  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti) And (SAR_TP_IMPUT = "99" Or SAR_TP_IMPUT = "1"))THEN

                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada.
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then                            
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_01 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_01 = Max(dif_meses_01, 0)
                                    else
                                        dif_meses_01 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif
                                Else
                                    dif_meses_01 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf
                                '---------------------------------------------------------------------------------------------------------------
                                
                                if SAR_H_COMPLEM_GCIAS.SAR_JUBILACION <> 0 Then
                                    imp_jub_01 = imp_jub_01 + SAR_H_COMPLEM_GCIAS.SAR_JUBILACION * dif_meses_01
                                endif
                              
                                if SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 <> 0 Then
                                    imp_ley_01 = imp_ley_01 + SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 * dif_meses_01
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL <> 0 Then
                                    imp_o_soc_01 = imp_o_soc_01 + SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL * dif_meses_01
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_RETENCION <> 0 Then
                                    imp_ret_01 = imp_ret_01 + SAR_H_COMPLEM_GCIAS.SAR_RETENCION * dif_meses_01
                                endif
    
                                if SAR_H_COMPLEM_GCIAS.SAR_BRUTO <> 0 Then
                                    imp_bruto_01 = imp_bruto_01 + SAR_H_COMPLEM_GCIAS.SAR_BRUTO * dif_meses_01
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL <> 0 Then
                                    imp_c_sind_01 = imp_c_sind_01 + SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL * dif_meses_01
                                endif
                        
                                if SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC <> 0 Then
                                    imp_o_deducc_01 = imp_o_deducc_01 + SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC * dif_meses_01
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA <> 0 Then
                                    imp_seg_v_01 = imp_seg_v_01 + SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA * dif_meses_01
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_SEGURO_SEPELIO <> 0 Then
                                    imp_seg_sep_01 = imp_seg_sep_01 + SAR_H_COMPLEM_GCIAS.SAR_SEGURO_SEPELIO * dif_meses_01
                                endif                            
                            Else
                                if SAR_H_COMPLEM_GCIAS.SAR_JUBILACION <> 0 Then
                                    imp_jub_01 = imp_jub_01 + SAR_H_COMPLEM_GCIAS.SAR_JUBILACION
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 <> 0 Then
                                    imp_ley_01 = imp_ley_01 + SAR_H_COMPLEM_GCIAS.SAR_LEY_19032
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL <> 0 Then
                                    imp_o_soc_01 = imp_o_soc_01 + SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_RETENCION <> 0 Then
                                    imp_ret_01 = imp_ret_01 + SAR_H_COMPLEM_GCIAS.SAR_RETENCION
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_BRUTO <> 0 Then
                                    imp_bruto_01 = imp_bruto_01 + SAR_H_COMPLEM_GCIAS.SAR_BRUTO
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL <> 0 Then
                                    imp_c_sind_01 = imp_c_sind_01 + SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL
                                endif
                        
                                if SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC <> 0 Then
                                    imp_o_deducc_01 = imp_o_deducc_01 + SAR_H_COMPLEM_GCIAS.SAR_OTRAS_DEDUC
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA <> 0 Then
                                    imp_seg_v_01 = imp_seg_v_01 + SAR_H_COMPLEM_GCIAS.SAR_SEGURO_VIDA
                                endif
        
                                if SAR_H_COMPLEM_GCIAS.SAR_SEGURO_SEPELIO <> 0 Then
                                    imp_seg_sep_01 = imp_seg_sep_01 + SAR_H_COMPLEM_GCIAS.SAR_SEGURO_SEPELIO
                                endif
                            EndIf
                      EndIf
                      
                    elseif entidad = "02" then '--Cuota medico asistencial--                    
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                           
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada.
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then                            
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then  
                                        dif_meses_02 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_02 = Max(dif_meses_02, 0)
                                    Else
                                        dif_meses_02 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    EndIf                                        
                                else
                                    dif_meses_02 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                endif
                                imp_tot_02 = imp_tot_02 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_02
                                '---------------------------------------------------------------------------------------------------------------                                                                   
                            Else
                                imp_tot_02 = imp_tot_02 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL                            
                            EndIf                                                        
                        EndIf
                        frec_02 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                        
                    elseif entidad = "03" then '--Seguro de vida particular --
        
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada.
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013= 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_03 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_03 = Max(dif_meses_03,0)
                                    else
                                        dif_meses_03 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif
                                Else
                                    dif_meses_03 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf
                                imp_tot_03 = imp_tot_03 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_03  
                                '---------------------------------------------------------------------------------------------------------------                                                             
                            Else
                                imp_tot_03 = imp_tot_03 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL
                            EndIf
                        endif
                        frec_03 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                        
                    elseif entidad = "05" then '--Gastos de sepelio --
        
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada.
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_05 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_05 = Max(dif_meses_05, 0)
                                    else
                                        dif_meses_05 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif        
                                Else
                                    dif_meses_05 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf
                                imp_tot_05 = imp_tot_05 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_05
                                '---------------------------------------------------------------------------------------------------------------                                                               
                            Else
                                imp_tot_05 = imp_tot_05 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL
                            EndIf
                        endif
                        frec_05 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
        
                    elseif entidad = "06" then '--Donaciones--
        
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada. 
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_06 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_06 = Max(dif_meses_06, 0)
                                    else
                                        dif_meses_06 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif
                                Else
                                    dif_meses_06 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf
                                imp_tot_06 = imp_tot_06 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_06   
                                '---------------------------------------------------------------------------------------------------------------                                                            
                            Else
                                imp_tot_06 = imp_tot_06 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL
                            EndIf
                        endif
                        frec_06 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
       
                    elseif entidad = "07" then '--Honorarios Médicos--
                                                  
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti) AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti)  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti) THEN
                           If(SAR_TP_IMPUT = "99")Then
                               'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada. 
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_07 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_07 = Max(dif_meses_07, 0)
                                    else
                                        dif_meses_07 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif
                                Else
                                    dif_meses_07 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf                               
                                imp_tot_07 = imp_tot_07 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_07 
                                '---------------------------------------------------------------------------------------------------------------                                                            
                            Else
                                imp_tot_07 = imp_tot_07 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL
                            EndIf
                        endif
                        frec_07 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA

                    elseif entidad = "08" then '--Otras deducciones-- 
        
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada. 
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_08 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_08 = Max(dif_meses_08, 0)
                                    else
                                        dif_meses_08 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif                                
                                Else
                                    dif_meses_08 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf
                                imp_tot_08 = imp_tot_08 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_08
                                '---------------------------------------------------------------------------------------------------------------                                                                
                            Else
                              imp_tot_08 = imp_tot_08 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL
                            EndIf
                        endif
                        frec_08 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
        
                    elseif entidad = "09" then '--Intereses Hipotecarios-- 
        
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                            If(SAR_TP_IMPUT = "99")Then 
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada. 
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------                           
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                      if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                          dif_meses_09 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                          dif_meses_09 = Max(dif_meses_09, 0)
                                      else
                                          dif_meses_09 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                      endif
                                Else
                                    dif_meses_09 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf
                                imp_tot_09 = imp_tot_09 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_09
                                '---------------------------------------------------------------------------------------------------------------                                                             
                            Else
                              imp_tot_09 = imp_tot_09 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL
                            EndIf
                        endif
                        frec_09 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
        
                    elseif entidad = "11" then '--Debitos y creditos bancarios--
        
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada. 
                                'Para los empleados de Rango 1
                                '--------------------------------------------------------------------------------------------------------------- 
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_11 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_11 = Max(dif_meses_11, 0)
                                    else
                                        dif_meses_11 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1 
                                    endif
                                else
                                    dif_meses_11 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1                                    
                                endif 
                                imp_tot_11 = imp_tot_11 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_11 
                                '---------------------------------------------------------------------------------------------------------------                                                                
                            Else
                                imp_tot_11 = imp_tot_11 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL
                            endif
                        endif
                        frec_11 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
        
                    elseif entidad = "12" then '--Servicio Domestico--
        
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada. 
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_12 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_12 = Max(dif_meses_12, 0)
                                    else
                                        dif_meses_12 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif
                                Else
                                    dif_meses_12 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf
                                imp_tot_12 = imp_tot_12 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_12 
                                '---------------------------------------------------------------------------------------------------------------                                                               
                            Else
                                imp_tot_12 = imp_tot_12 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL
                            endif
                        endif
                        frec_12 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA        
                          
                    elseif entidad = "13"  then '- Ingresos otros empleadores  --        
                        IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti  Or (SAR_TP_IMPUT = "99" and DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti)) ) THEN
                         ' Procesamos cada tipo de importe:
                          ' Deducciones:
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada. 
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_13 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_13 = Max(dif_meses_13, 0)
                                    else
                                        dif_meses_13 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif
                                Else
                                    dif_meses_13 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                EndIf
                                '---------------------------------------------------------------------------------------------------------------
                                  
                                If(SAR_H_COMPLEM_GCIAS.SAR_JUBILACION > 0) Then
                                   jubilacion_oe = jubilacion_oe + SAR_H_COMPLEM_GCIAS.SAR_JUBILACION * dif_meses_13
                                EndIf
                                If(SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 > 0) Then   
                                   ley_19032_oe = ley_19032_oe + SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 * dif_meses_13
                                EndIf   
                                If(SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL > 0) Then
                                   obra_social_oe = obra_social_oe + SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL * dif_meses_13
                                EndIf
                                If(SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL > 0) Then   
                                   cuota_sindical_oe = cuota_sindical_oe + SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL * dif_meses_13
                                EndIf   
                                ' Haberes
                                If(SAR_H_COMPLEM_GCIAS.SAR_BRUTO > 0) Then
                                   bruto_oe = bruto_oe + SAR_H_COMPLEM_GCIAS.SAR_BRUTO * dif_meses_13
                                EndIf                                
                            Else
                              If(SAR_H_COMPLEM_GCIAS.SAR_JUBILACION > 0) Then
                                 jubilacion_oe = jubilacion_oe + SAR_H_COMPLEM_GCIAS.SAR_JUBILACION
                              EndIf
                              If(SAR_H_COMPLEM_GCIAS.SAR_LEY_19032 > 0) Then   
                                 ley_19032_oe = ley_19032_oe + SAR_H_COMPLEM_GCIAS.SAR_LEY_19032
                              EndIf   
                              If(SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL > 0) Then
                                 obra_social_oe = obra_social_oe + SAR_H_COMPLEM_GCIAS.SAR_OBRA_SOCIAL
                              EndIf
                              If(SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL > 0) Then   
                                 cuota_sindical_oe = cuota_sindical_oe + SAR_H_COMPLEM_GCIAS.SAR_CUOTA_SINDICAL
                              EndIf   
                              ' Haberes
                              If(SAR_H_COMPLEM_GCIAS.SAR_BRUTO > 0) Then
                                 bruto_oe = bruto_oe + SAR_H_COMPLEM_GCIAS.SAR_BRUTO
                              EndIf                                
                            endif
                          EndIf  
                            'frec_13 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                            
                    elseif entidad = "15" then '--Pago a cuenta - Compras en el exterior--
                         IF (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) <= mes_paga_efecti AND (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) >= mes_paga_efecti)  Or (SAR_TP_IMPUT = "99") ) THEN
                           
                            If(SAR_TP_IMPUT = "99")Then
                                'Para la paga de Reliquidacion, obtengo la cantidad de meses en las que se tiene que aplicar esa deduccion segun como este registrada. 
                                'Para los empleados de Rango 1
                                '---------------------------------------------------------------------------------------------------------------
                                If(RANGO_REM_IG_2013 = 1 and fec_1 <> SAR_FEC_PAGO_IG)Then
                                    if (DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END)>= DxMonth(fec_1)) Then
                                        dif_meses_15 = DxMonth(fec_1) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                        dif_meses_15 = Max(dif_meses_15,0)
                                    else
                                        dif_meses_15 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1
                                    endif
                                else
                                    dif_meses_15 = DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_END) - DxMonth(SAR_H_COMPLEM_GCIAS.SAR_DT_START) + 1                                
                                endif                                                                                            
                                imp_tot_15 = imp_tot_15 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL * dif_meses_15
                                '---------------------------------------------------------------------------------------------------------------
                            Else
                              imp_tot_15 = imp_tot_15 + SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL                              
                            EndIf   
                                                         
                         endif
                         frec_15 = SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA
                    endif
'------------------------------------------------------------------------------------------------------------------------
'                               Entidades con valores anuales 
'------------------------------------------------------------------------------------------------------------------------
    
                ELSEIF SAR_H_COMPLEM_GCIAS.SAR_FREC_CARGA = "2" THEN
                mes = mes_paga_efecti
                
                    if entidad = "02" then '--Cuota medico asistencial--
                    
                        if SAR_H_COMPLEM_GCIAS.SAR_IMPORTE_TOTAL > 0 Then
