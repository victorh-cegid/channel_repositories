        imp_tot_08 = imp_tot_08 / 12 * mes_paga_efecti            
ENDIF
IF imp_tot_09 > 0 AND frec_09 = "2"  THEN
        imp_tot_09 = imp_tot_09 / 12 * mes_paga_efecti           
ENDIF
IF imp_tot_11 > 0 AND frec_11 = "2"  THEN
        imp_tot_11 = imp_tot_11 / 12 * mes_paga_efecti           
ENDIF
IF imp_tot_12 > 0 AND frec_12 = "2"  THEN
        imp_tot_12 = imp_tot_12 / 12 * mes_paga_efecti            
ENDIF
    
IF mes_paga_efecti = 1 THEN
    IF imp_tot_02 > 0 AND frec_02 = "1" THEN
        imp_02 = imp_tot_02
    ENDIF    
    IF imp_tot_03 > 0 AND frec_03 = "1" THEN
        imp_03 = imp_tot_03
    ENDIF
    IF imp_tot_05 > 0 AND frec_05 = "1" THEN
        imp_05 = imp_tot_05
    ENDIF
    IF imp_tot_06 > 0 AND frec_06 = "1" THEN
        imp_06 = imp_tot_06            
    ENDIF
    IF imp_tot_07 > 0 AND frec_07 = "1" THEN
        imp_07 = imp_tot_07            
    ENDIF
    IF imp_tot_09 > 0 AND frec_09 = "1" THEN
        imp_09 = imp_tot_09            
    ENDIF
    IF imp_tot_11 > 0 AND frec_11 = "1" THEN
        imp_11 = imp_tot_11            
    ENDIF
    IF imp_tot_12 > 0 AND frec_12 = "1" THEN
        imp_12 = imp_tot_12            
    ENDIF
    'IF imp_tot_13 > 0 AND frec_13 = "1" THEN
        'imp_13 = imp_tot_13            
    'ENDIF
    IF imp_tot_15 > 0 AND frec_15 = "1" THEN
        imp_15 = imp_tot_15            
    ENDIF
ELSE    
    SCO_AC_HR_PERIOD_READ_1.BEGIN()
    ULTIMO_REG = SCO_AC_HR_PERIOD_READ_1.COUNT()- 1
    FOR j = 0 TO ULTIMO_REG 
        SCO_AC_HR_PERIOD_READ_1.MOVETO(j)
        IF (param1 <= SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG AND param2 > SCO_AC_HR_PERIOD_READ_1.SAR_FECHA_PAGO_IG and SAR_TP_IMPUT <> "99") Or (SAR_IG_DICIEMBRE = 1 and (SAR_FECHA_BAJA <> M4_PLUS_INF) And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017") THEN        
            IF frec_02 = "1" THEN
                imp_02 = imp_tot_02 + SCO_AC_HR_PERIOD_READ_1.SAR_IG_CMASIS_REMUN
                acu_cmasis_remun = SCO_AC_HR_PERIOD_READ_1.SAR_IG_CMASIS_REMUN
            ENDIF    
            IF frec_03 = "1" THEN
                imp_03 = imp_tot_03 + SCO_AC_HR_PERIOD_READ_1.SAR_IG_SEGURO_REMUN
            ENDIF
            IF frec_05 = "1" THEN
                imp_05 = imp_tot_05 + SCO_AC_HR_PERIOD_READ_1.SAR_IG_SEPELIO_REM
            ENDIF
            IF frec_06 = "1" THEN
                imp_06 = imp_tot_06 + SCO_AC_HR_PERIOD_READ_1.SAR_IG_DONAC_REMUN
                acu_donremun_remun = SCO_AC_HR_PERIOD_READ_1.SAR_IG_DONAC_REMUN
            ENDIF
            IF frec_07 = "1" THEN
                imp_07 = imp_tot_07 + SCO_AC_HR_PERIOD_READ_1.SAR_HONORAR_MEDICOS
                acu_honor_med = SCO_AC_HR_PERIOD_READ_1.SAR_HONORAR_MEDICOS
            ENDIF
            IF frec_09 = "1" THEN
                imp_09 = imp_tot_09 + SCO_AC_HR_PERIOD_READ_1.SAR_IMP_D_IN_HIP
                acu_imp_d_in_hip = SCO_AC_HR_PERIOD_READ_1.SAR_IMP_D_IN_HIP
            ENDIF
            IF frec_11 = "1" THEN
               If(SCO_AC_HR_PERIOD_READ_1.SCO_PAY_FREQ_ALLOC = "003")Then
                 If(DXMONTH(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) < DXMONTH(SCO_DT_PAYMENT) And sume_11 = 0)Then
                         imp_11 = imp_tot_11 + SCO_AC_HR_PERIOD_READ_1.SAR_DEBITO_BANCARIO
                         acu_pago_cuent_ext = SCO_AC_HR_PERIOD_READ_1.SAR_DEBITO_BANCARIO
                         sume_11 = 1
                 ElseIf(DXMONTH(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) = DXMONTH(SCO_DT_PAYMENT) And sume_11 = 0)Then
                     If(imp_11 = 0)Then
                         imp_11 = imp_tot_11 
                         acu_debito_bancario = SCO_AC_HR_PERIOD_READ_1.SAR_DEBITO_BANCARIO
                         sume_11 = 1
                     EndIf    
                 EndIf        
               Else
                imp_11 = imp_tot_11 + SCO_AC_HR_PERIOD_READ_1.SAR_DEBITO_BANCARIO
                acu_debito_bancario = SCO_AC_HR_PERIOD_READ_1.SAR_DEBITO_BANCARIO
               EndIf 
            ENDIF
            IF frec_12 = "1" THEN
                imp_12 = imp_tot_12 + SCO_AC_HR_PERIOD_READ_1.SAR_SERV_DOMEST
                acu_serv_domest = SCO_AC_HR_PERIOD_READ_1.SAR_SERV_DOMEST
            ENDIF
            'IF frec_13 = "1" THEN
                'imp_13 = imp_tot_13 + SCO_AC_HR_PERIOD_READ_1.SAR_AP_CAP_SOC_FDO_R
                'acu_ap_cap_soc_fdo_r = SCO_AC_HR_PERIOD_READ_1.SAR_AP_CAP_SOC_FDO_R
            'ENDIF
            IF frec_15 = "1" THEN
               If(SCO_AC_HR_PERIOD_READ_1.SCO_PAY_FREQ_ALLOC = "003")Then
                 If(DXMONTH(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) < DXMONTH(SCO_DT_PAYMENT) And sume_15 = 0)Then
                         imp_15 = imp_tot_15 + SCO_AC_HR_PERIOD_READ_1.SAR_PAG_CUENT_EXT
                         acu_pago_cuent_ext = SCO_AC_HR_PERIOD_READ_1.SAR_PAG_CUENT_EXT
                         sume_15 = 1
                 ElseIf(DXMONTH(SCO_AC_HR_PERIOD_READ_1.SCO_DT_PAYMENT) = DXMONTH(SCO_DT_PAYMENT) And sume_15 = 0)Then
                     If(imp_15 = 0)Then
                         imp_15 = imp_tot_15 
                         acu_pago_cuent_ext = SCO_AC_HR_PERIOD_READ_1.SAR_PAG_CUENT_EXT
                         sume_15 = 1
                     EndIf    
                 EndIf        
               Else
                 imp_15 = imp_tot_15 + SCO_AC_HR_PERIOD_READ_1.SAR_PAG_CUENT_EXT
                 acu_pago_cuent_ext = SCO_AC_HR_PERIOD_READ_1.SAR_PAG_CUENT_EXT
               EndIf
            ENDIF
        ENDIF
    NEXT

    
    IF (imp_02 = 0 AND imp_tot_02 > 0) AND frec_02 = "1" THEN
        imp_02 = imp_tot_02
    ENDIF
    IF (imp_03 = 0 AND imp_tot_03 > 0) AND frec_03 = "1" THEN
        imp_03 = imp_tot_03
    ENDIF
    IF (imp_05 = 0 AND imp_tot_05 > 0) AND frec_05 = "1" THEN
        imp_05 = imp_tot_05
    ENDIF
    IF (imp_06 = 0 AND imp_tot_06 > 0) AND frec_06 = "1" THEN
        imp_06 = imp_tot_06
    ENDIF
    IF (imp_07 = 0 AND imp_tot_07 > 0) AND frec_07 = "1" THEN
        imp_07 = imp_tot_07
    ENDIF
    IF (imp_09 = 0 AND imp_tot_09 > 0) AND frec_09 = "1" THEN
        imp_09 = imp_tot_09
    ENDIF
    IF (imp_11 = 0 AND imp_tot_11 > 0) AND frec_11 = "1" THEN
        imp_11 = imp_tot_11
    ENDIF
    IF (imp_12 = 0 AND imp_tot_12 > 0) AND frec_12 = "1" THEN
        imp_12 = imp_tot_12
    ENDIF
    

    IF (imp_15 = 0 AND imp_tot_15 > 0) AND frec_15 = "1" THEN
        imp_15 = imp_tot_15
    ENDIF
ENDIF

     
