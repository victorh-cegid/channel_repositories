'Aplica un filtro al acumulado, sobre el Id o el Ordinal del periodo, o ambos.
'Esto es debido a que para la modificacion del empleado se debio quitar
'el conector padre - hijo del campo SCO_OR_HR_PERIOD.

sWriteObj = GetNodeWriteObjectId("SCO_AUX_AC_HRPERIOD") 
SCO_AC_HR_PERIOD_READ_1.SCO_PROCESS_CURR=SAR_HRPERIOD_CALC.ID_CURRENCY

if  SAR_HRPERIOD_CALC.SCO_BEHAV_CURR="01" then
	SCO_AC_HR_PERIOD_READ_1.SysSentence="FROM &" + sWriteObj + " A WHERE A.SCO_IND_MAIN_CURR=1 "
else
	SCO_AC_HR_PERIOD_READ_1.SysSentence="FROM &" + sWriteObj + " A WHERE A.ID_CURRENCY=@SCO_PROCESS_CURR "
endif


If SAR_HR_PERIOD.STD_ID_HRP_START_REASON <> "005" And SAR_NO_APLICA_ORDINAL = 0 Then 'Carga normal por ID y Ordinal
       SCO_AC_HR_PERIOD_READ_1.SysSentence=SCO_AC_HR_PERIOD_READ_1.SysSentence + " AND (( ( A.SCO_DT_ALLOCATION >= @SCO_DT_START And A.SCO_DT_ALLOCATION <= @SCO_DT_END ) Or ( A.SCO_DT_PAYMENT >= @SCO_DT_START And A.SCO_DT_PAYMENT <= @SCO_DT_END ) ))"
       SCO_SYSPARAM = ToString(SAR_HRPERIOD_CALC.SCO_DT_PAYMENT) + "|" + ToString(SAR_HRPERIOD_CALC.SCO_DT_ALLOCATION) + "|" + ToString(SAR_HRPERIOD_CALC.SCO_DT_PAYMENT)
       SCO_AC_HR_PERIOD_READ_1.SysSentence=SCO_AC_HR_PERIOD_READ_1.SysSentence + " and A.SCO_DT_PAYMENT <= ?(4,0,0) and NOT(A.SCO_DT_ALLOCATION = ?(4,0,0) AND A.SCO_DT_PAYMENT = ?(4,0,0))"
       SCO_AC_HR_PERIOD_READ_1.SysSentence=SCO_AC_HR_PERIOD_READ_1.SysSentence + " And A.SCO_ID_HR = '" + SCO_HR_PERIOD.STD_ID_HR + "' And A.SCO_OR_HR_PERIOD = " +  ToString(SCO_HR_PERIOD.STD_OR_HR_PERIOD, 0) + " "
ElseIf SAR_HR_PERIOD.STD_ID_HRP_START_REASON = "005" Or SAR_NO_APLICA_ORDINAL = 1 Then 'Carga especial solo Id
       SCO_AC_HR_PERIOD_READ_1.SysSentence=SCO_AC_HR_PERIOD_READ_1.SysSentence + " AND (( ( A.SCO_DT_ALLOCATION >= @SCO_DT_START And A.SCO_DT_ALLOCATION <= @SCO_DT_END ) Or ( A.SCO_DT_PAYMENT >= @SCO_DT_START And A.SCO_DT_PAYMENT <= @SCO_DT_END ) ))"
       SCO_SYSPARAM = ToString(SAR_HRPERIOD_CALC.SCO_DT_PAYMENT) + "|" + ToString(SAR_HRPERIOD_CALC.SCO_DT_ALLOCATION) + "|" + ToString(SAR_HRPERIOD_CALC.SCO_DT_PAYMENT)
       SCO_AC_HR_PERIOD_READ_1.SysSentence=SCO_AC_HR_PERIOD_READ_1.SysSentence + " and A.SCO_DT_PAYMENT <= ?(4,0,0) and NOT(A.SCO_DT_ALLOCATION = ?(4,0,0) AND A.SCO_DT_PAYMENT = ?(4,0,0))"
       SCO_AC_HR_PERIOD_READ_1.SysSentence=SCO_AC_HR_PERIOD_READ_1.SysSentence + " And A.SCO_ID_HR = '" + SCO_HR_PERIOD.STD_ID_HR + "' And A.SCO_OR_HR_PERIOD <= " +  ToString(SCO_HR_PERIOD.STD_OR_HR_PERIOD, 0) + " "
EndIf   

Return(0)
