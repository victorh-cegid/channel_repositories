sWriteObj = GetNodeWriteObjectId("SCO_AUX_AC_HRPERIOD") 

SCO_AC_HR_PERIOD_READ.SCO_PROCESS_CURR=SCO_HRPERIOD_CALC.ID_CURRENCY
if  SCO_HRPERIOD_CALC.SCO_BEHAV_CURR="01" then
	SCO_AC_HR_PERIOD_READ.SysSentence="FROM &" + sWriteObj + " A WHERE A.SCO_IND_MAIN_CURR=1 AND (( ( A.SCO_DT_ALLOCATION >= @SCO_DT_START And A.SCO_DT_ALLOCATION <= @SCO_DT_END ) Or ( A.SCO_DT_PAYMENT >= @SCO_DT_START And A.SCO_DT_PAYMENT <= @SCO_DT_END ) ))"
else
	SCO_AC_HR_PERIOD_READ.SysSentence="FROM &" + sWriteObj + " A WHERE A.ID_CURRENCY=@SCO_PROCESS_CURR AND (( ( A.SCO_DT_ALLOCATION >= @SCO_DT_START And A.SCO_DT_ALLOCATION <= @SCO_DT_END ) Or ( A.SCO_DT_PAYMENT >= @SCO_DT_START And A.SCO_DT_PAYMENT <= @SCO_DT_END ) ))"
endif

//Esto se añade porque la función YTDSearch no está filtrando por fecha de pago.
//No puede hacerlo porque la misma función se utiliza para la nómina y para las
//plantillas de acumulado y estas pueden leer valores a futuro. 
//Por lo tanto es mejor que la carga se haga lo más filtrada posible.

SCO_SYSPARAM = ToString(SCO_HRPERIOD_CALC.SCO_DT_PAYMENT) + "|" + ToString(SCO_HRPERIOD_CALC.SCO_DT_ALLOCATION) + "|" + ToString(SCO_HRPERIOD_CALC.SCO_DT_PAYMENT)

SCO_AC_HR_PERIOD_READ.SysSentence=SCO_AC_HR_PERIOD_READ.SysSentence + " and A.SCO_DT_PAYMENT <= ?(4,0,0) and NOT(A.SCO_DT_ALLOCATION = ?(4,0,0) AND A.SCO_DT_PAYMENT = ?(4,0,0))"

RETURN(0)
