iFilter = SCOPE_REGISTER + TYPE_PROPERTY
iItemCount = GetNodeNumberOfItems(GetThisNodeId(), iFilter)
If iItemCount <> 0 Then
   dt_alloc = SCO_DT_ALLOCATION 
   dt_pay = SCO_DT_PAYMENT 
    YTDSearchFiltered("",ID_NODE_AC_READ,SCO_DT_START,SCO_DT_END,dt_alloc,dt_pay,PAY_FRECUENCY,PAY_TYPE,SEARCH_TYPE,REV_BEHAVIOUR,SEL_PAYS,TOT_OPERATION , "SAR_FECHA_PAGO", SAR_HRPERIOD_CALC.SAR_FECHA_PAGO, SMALLER_OR_EQUAL, "SAR_ALLOC_MES", SAR_HRPERIOD_CALC.SAR_ALLOC_MES, EQUAL, "SAR_ALLOC_ANIO", SAR_HRPERIOD_CALC.SAR_ALLOC_ANIO, EQUAL, "SAR_FECHA_IMPUTACION", SAR_HRPERIOD_CALC.SAR_FECHA_IMPUTACION, DISTINCT)

   MoveTo (0) 
EndIf 
Return(1)
