iFilter = SCOPE_REGISTER + TYPE_PROPERTY
iItemCount = GetNodeNumberOfItems(GetThisNodeId(), iFilter)
If iItemCount <> 0 Then
   dt_alloc = SCO_DT_ALLOCATION 
   dt_pay = SCO_DT_PAYMENT 
    YTDSearchFiltered("",ID_NODE_AC_READ,SCO_DT_START,SCO_DT_END,dt_alloc,dt_pay,PAY_FRECUENCY,PAY_TYPE,SEARCH_TYPE,REV_BEHAVIOUR,SEL_PAYS,TOT_OPERATION , "SAR_ANIO_IMPUT_IG", SAR_HRPERIOD_CALC.SAR_ANIO_IMPUT_IG, EQUAL )

   MoveTo (0) 
EndIf 
Return(1)
