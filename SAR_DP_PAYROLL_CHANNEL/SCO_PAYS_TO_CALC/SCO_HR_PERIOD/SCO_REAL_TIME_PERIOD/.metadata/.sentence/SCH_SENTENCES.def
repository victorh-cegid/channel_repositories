# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_REAL_TIME_PERIOD | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I IS NULL Or #I >= ? ) And #I = '1' |  | SELECT @SAR_CK_INTERRUP = B.SAR_CK_INTERRUP, @SCO_CK_PAID = B.SCO_CK_PAID FROM &SCO_REAL_TIME_PRD A, SCO_INCIDENCE B WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_INCIDENCE = B.SCO_ID_INCIDENCE(+) AND (A.SCO_DT_START <= @SAR_DT_ALLOC_END And ( A.SCO_DT_END IS NULL Or A.SCO_DT_END >= @SAR_DT_ALLOC_START ) And A.SCO_CK_IN_PAYROLL = '1') ORDER BY B.SCO_ID_INC_GROUP ASC
