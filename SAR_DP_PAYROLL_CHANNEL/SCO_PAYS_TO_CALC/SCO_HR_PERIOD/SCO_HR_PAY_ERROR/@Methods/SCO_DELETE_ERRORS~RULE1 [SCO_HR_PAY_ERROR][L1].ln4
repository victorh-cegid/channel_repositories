SCO_SQL_ERRORS="DELETE SCO_HR_PAY_ERROR A WHERE A.SCO_ID_HR=@SCO_ID_HR AND A.SCO_OR_HR_PERIOD=@SCO_OR_HR_PERIOD AND A.SCO_DT_PAYMENT=@SCO_PROC_DT_PAYMENT AND A.SCO_DT_ALLOCATION=@SCO_PROC_DT_ALLOCATION AND A.SCO_PAY_FREQ_PAYM=@SCO_PAY_FREQ_PAYM AND A.SCO_PAY_FREQ_ALLOC=@SCO_PAY_FREQ_ALLOC AND A.ID_ORGANIZATION = @ID_ORGANIZATION"

RETURN(0)
