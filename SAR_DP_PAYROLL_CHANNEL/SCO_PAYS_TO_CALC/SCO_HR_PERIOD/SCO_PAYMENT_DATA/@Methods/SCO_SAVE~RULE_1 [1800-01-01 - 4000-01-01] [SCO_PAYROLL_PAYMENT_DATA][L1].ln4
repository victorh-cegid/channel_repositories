Begin()
While ISEOF()<> TRUE
	IF SCO_HR_PERIOD.SCO_ERROR=1 THEN

		If SCO_OPERATION<>"I" AND SCO_PAYMENT_ORDER.COUNT()>0 THEN


			SCO_PAYMENT_ORDER.BEGIN()
			SCO_PAYMENT_ORDER.SCO_AMT_PAYORDPRIM=0

			//Sólo se graban los pagos si se ha chequeado en el lanzador
			If SCO_HT_PAYS.SCO_GEN_PAYMENTS = 1 Then
				SCO_PAYMENT_ORDER.Update_blk()
			EndIf

		endif
	else
		If SCO_OPERATION="U" Then
			//Sólo se graban los pagos si se ha chequeado en el lanzador
			If SCO_HT_PAYS.SCO_GEN_PAYMENTS = 1 Then
				SCO_PAYMENT_ORDER.Update_blk()
			EndIf
		Else
			//Sólo se graban los pagos si se ha chequeado en el lanzador
			If SCO_HT_PAYS.SCO_GEN_PAYMENTS = 1 Then
				SCO_PAYMENT_ORDER.Insert_blk()
			EndIf
		EndIf
	endif
	GONEXT()
WEnd
Return(1)
