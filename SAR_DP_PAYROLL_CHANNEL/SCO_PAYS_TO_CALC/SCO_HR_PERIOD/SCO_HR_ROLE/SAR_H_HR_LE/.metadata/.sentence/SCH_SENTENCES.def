# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_HR_LE | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @DT_START = A.DT_START, @DT_END = A.DT_END, @SCO_ID_LEG_ENT = A.SCO_ID_LEG_ENT FROM &SCO_H_HR_LEGAL_ENTITY A WHERE (A.DT_START <= @SAR_DT_ALLOC_END And A.DT_END >= @SAR_DT_ALLOC_START)
