sWriteObj = GetNodeWriteObjectId("SCO_AUX_AC_HRROLE") 

//Los datos del nodo de cálculo se asignan a una variable porque puede que los tramos del 
//nodo de cálculo y los tramos del nodo de revisión sean diferentes 
//(debido a las altas/bajas retroactivas). Las variables no tienen tramos.
Currency = SCO_HRROLE_CALC.ID_CURRENCY
BehavCurr = SCO_HRROLE_CALC.SCO_BEHAV_CURR

//Para que en el nodo de revisión se acceda a datos de fuera del intervalo de fechas del
//cálculo, tenemos que setear las fechas máximas. Es para las bajas/altas retroactivas.
//Como las fechas definitivas las tenemos despues de la carga, por ahora ponemos las fechas
//de la paga.

dStartAlloc=SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC
dEndAlloc=SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC
SetStartDate(dStartAlloc)
SetEndDate(dEndAlloc)

SCO_AC_HR_ROLE_REV.SCO_PROCESS_CURR=Currency
if  BehavCurr="01" then
	SCO_AC_HR_ROLE_REV.SysSentence="FROM &" + sWriteObj + " A WHERE A.SCO_IND_MAIN_CURR=1"
else
	SCO_AC_HR_ROLE_REV.SysSentence="FROM &" + sWriteObj + " A WHERE A.ID_CURRENCY=@SCO_PROCESS_CURR"
endif
RETURN(0)
