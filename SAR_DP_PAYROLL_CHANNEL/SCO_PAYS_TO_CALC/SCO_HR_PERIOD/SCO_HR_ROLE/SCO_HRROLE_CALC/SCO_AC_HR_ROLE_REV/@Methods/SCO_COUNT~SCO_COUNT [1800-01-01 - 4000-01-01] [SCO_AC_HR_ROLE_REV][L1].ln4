//Se lee este dato antes de empezar a tener tramos distintos en la ejecución del nodo de 
//revisión que en el cálculo.
iNumDecimals = SCO_HRPERIOD_CALC.SCO_CURR_EXCH_PRICES
Numreg=Count()

If Numreg > 0 Then
	//Lo ordeno para que la mínima fecha de inicio me aparezca en el primer registro y así no tener
	//que hacer otra select sobre el acumulado
	sort(1) 
	Begin() 
	dStartRetro = SCO_HR_ROLE.SCO_DT_START_CALC_ROLE_RETRO(SCO_DT_START_SLICE)

	//Lo ordeno para que la máxima fecha de fin me aparezca en el primer registro y así no tener
	//que hacer otra select sobre el acumulado
	sort(2) 
	Begin() 
	dEndRetro =SCO_HR_ROLE.SCO_DT_END_CALC_ROLE_RETRO(SCO_DT_END_SLICE)

	//Para que en el nodo de revisión se acceda a datos de fuera del intervalo de fechas del
	//cálculo, tenemos que setear las fechas máximas. Es para las bajas/altas retroactivas.
	SetStartDate(dStartRetro)
	SetEndDate(dEndRetro)
Else
	//Paso la fecha máxima en la fecha de inicio porque así cualquier otra será menor y el
	//concepto cogerá la de cálculo. Lo mismo con la fecha de fin.
	SCO_HR_ROLE.SCO_DT_START_CALC_ROLE_RETRO(PLUS_INF)
	SCO_HR_ROLE.SCO_DT_END_CALC_ROLE_RETRO(MINUS_INF)
EndIf

SCO_NUM_REG=Numreg
If  Numreg>0 then
	for i=0 to Numreg-1
		moveto(i)
		
            if SCO_PROCESS_CURR<>ID_CURRENCY then
		
                If SCO_PROCESS_CURR = "EUR" THEN
                    SCO_EURO_ROUND(iNumDecimals)
                    //If we are in this case, we are working with a different number of decimals than the one of the currency.
                    //If we want to mantein this information. We set the number of decimals from this moment to the end of the calculation.
                    //Se hace este cambio en el period y en el rol porque no sabemos a priori cual se ejecuta primero. 
                    Code="Return("+GetChannelId()+"!SETPROPERTY("+CHR(DOUBLE_QUOTE)+"CURRENCY_PRECISION"+CHR(DOUBLE_QUOTE)+"," + ToString(iNumDecimals) + "))"
                    clcExecuteLN4JIT (Code)             
                Else 	
                    CUREXCHANGERECORDROUNDED(SCO_PROCESS_CURR,0)
                EndIf
                                
		endif
	next
	end()

	X=UNFLATTEN("SCO_DT_PAYMENT")
	X=JOINSLICES()    
else
	AddRegister()   
Endif


moveto(0)

Return(0)
