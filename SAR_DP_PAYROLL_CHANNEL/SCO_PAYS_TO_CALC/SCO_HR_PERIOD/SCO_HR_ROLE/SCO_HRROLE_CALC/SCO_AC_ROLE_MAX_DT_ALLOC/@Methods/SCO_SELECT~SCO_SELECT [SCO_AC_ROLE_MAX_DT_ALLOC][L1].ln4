SCO_AC_ROLE_MAX_DT_ALLOC.SCO_PROCESS_CURR=SCO_HRROLE_CALC.ID_CURRENCY
if  SCO_HRROLE_CALC.SCO_BEHAV_CURR="01" then
	SCO_AC_ROLE_MAX_DT_ALLOC.SysSentence="FROM &SCO_AC_HR_ROLE A WHERE A.SCO_IND_MAIN_CURR=1"
else
	SCO_AC_ROLE_MAX_DT_ALLOC.SysSentence="FROM &SCO_AC_HR_ROLE A WHERE A.ID_CURRENCY=@SCO_PROCESS_CURR"
endif
RETURN(0)
