SAR_H_HR_JOB.LOAD_BLK()
IF SAR_H_HR_JOB.COUNT() > 0 THEN
    SAR_H_HR_JOB.BEGIN()
    valor = SAR_H_HR_JOB.SCO_ID_JOB_CODE
ELSE
    SAR_H_HR_POSITION.LOAD_BLK()
    IF SAR_H_HR_POSITION.COUNT() > 0 THEN
        SAR_H_HR_POSITION.BEGIN()
        valor = SAR_H_HR_POSITION.SCO_ID_POSITION
    ELSE
        valor = NULLVALUE()
    ENDIF
ENDIF
RETURN(valor)
