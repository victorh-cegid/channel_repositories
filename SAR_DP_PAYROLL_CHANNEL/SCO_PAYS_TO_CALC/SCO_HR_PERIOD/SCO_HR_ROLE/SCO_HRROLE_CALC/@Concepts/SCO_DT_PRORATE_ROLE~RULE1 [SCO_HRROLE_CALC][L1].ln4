DtAllocEnd = SCO_HR_PERIOD.SCO_DT_ALLOC_END

'The period has  a mensual salary type
If (SCO_HRPERIOD_CALC.SCO_ID_SALARY_TYPE = "1" AND SCO_HR_ROLE.SCO_DT_END >= SCO_HR_PERIOD.SCO_DT_ALLOC_END AND SCO_HR_ROLE.SCO_DT_START <= SCO_HR_PERIOD.SCO_DT_ALLOC_START) Then
	DtProrate = DxDate (30, DxMonth (DtAllocEnd), DxYear(DtAllocEnd))

Else 'It is a daily salary type
	DtProrate = SCO_DT_SLICE_ROLE

EndIf

Return(DtProrate)
