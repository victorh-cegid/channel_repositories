'Si se cargaron las horas por Rol se le dan prioridad, sino se trabaja con las horas por Period
IF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "003" THEN    'tipo salario horario
   IF SCO_NUM_HOURS_THEO_ROLE > 0 THEN
       aux = SCO_NUM_HOURS_THEO_ROLE
   ENDIF 
ENDIF

IF aux > 0 THEN
    valor = aux
ELSE
    valor = SAR_HR_ROLE.SAR_P_DIAS_TRABAJADOS
ENDIF
RETURN(valor)
