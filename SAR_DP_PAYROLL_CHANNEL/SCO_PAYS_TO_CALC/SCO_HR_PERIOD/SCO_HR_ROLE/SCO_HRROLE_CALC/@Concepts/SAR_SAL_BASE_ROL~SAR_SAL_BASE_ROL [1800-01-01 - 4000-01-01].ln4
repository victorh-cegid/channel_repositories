IF SAR_P_SAL_BASE = 0 OR SAR_HR_ROLE.SAR_P_DIAS_PAGA = 0 THEN 
    Return(0)
ENDIF

IF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "001" THEN
    IF SAR_HR_ROLE.SAR_P_DIAS_PAGA = 0 THEN
        valor = 0
    ELSE
        valor = (SAR_P_SAL_BASE*SAR_U_CONC_FIJOS_ROL) / SAR_HR_ROLE.SAR_P_DIAS_PAGA
    ENDIF
ELSE
    valor = (SAR_P_SAL_BASE*SAR_U_CONC_FIJOS_ROL)
ENDIF
Return(valor)
