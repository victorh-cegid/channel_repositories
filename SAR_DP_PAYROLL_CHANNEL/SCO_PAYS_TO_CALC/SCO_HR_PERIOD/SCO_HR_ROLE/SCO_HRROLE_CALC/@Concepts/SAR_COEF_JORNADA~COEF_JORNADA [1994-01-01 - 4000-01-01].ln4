'Este concepto devolvera el coeficiente de Jornada Reducida, en caso de no ser Jornada Reducida el concepto retornara 1.

coef = 0
Num_hor_trab_x_mes = 0
Num_hor_tiempo_teor = 0

If SAR_IND_JORN_RED_ROL = 0 Then            'El #1000674 es el Indicativo de Jornada Reducida.
    Return(1)
Else
   Num_hor_tiempo_teor = SAR_HRPERIOD_CALC.SCO_NUM_HOURS_THEO
   Num_hor_trab_x_mes = SAR_HRPERIOD_CALC.SAR_HORAS_MES
   
   If Num_hor_tiempo_teor= 0 Then
   'Datos incorrectos.\n \nDebe introducir datos en %0:s. Esto sucedio calculando el periodo %1:n del empleado %2:s en la nomina %3:s de pago %4:d e imputacion %5:d
        SetLog (-1,1,80,1,"El Empleado no tiene datos para la semana teorica del historico de Tiempo Teorico")
        'SCO_ERROR = 1
        'Return(-1)
   EndIf
   
   if Num_hor_trab_x_mes = 0 Then
   'Datos incorrectos.\n \nDebe introducir datos en %0:s. Esto sucedio calculando el periodo %1:n del empleado %2:s en la nomina %3:s de pago %4:d e imputacion %5:d
        SetLog (-1,1,80,2,"El Empleado no tiene datos para el N? de horas de trabajo al mes, ver datos de concepto #620")
        'SCO_ERROR = 1
        'Return(-1)
   EndIf
 
   If  Num_hor_trab_x_mes <> 0 Then
       coef =  Num_hor_tiempo_teor/Num_hor_trab_x_mes
   Endif
   
   Return(coef)
   
EndIf

