sIDConcept = CONCEPT
sIDNode   = GetThisNodeID()
nAmt = 0

SCO_BACK_PAY_ROLE.Begin()
nPosition = SCO_BACK_PAY_ROLE.Findregister("ID_TI",sIDNode,EQUAL,"ID_ITEM",sIDConcept,EQUAL)
If nPosition = -1 Then
	Return(nAmt)
Else
	SCO_BACK_PAY_ROLE.Moveto(nPosition)
	Do
		If sIDNode = SCO_BACK_PAY_ROLE.ID_TI Then
			If sIDConcept = SCO_BACK_PAY_ROLE.ID_ITEM Then
				If SCO_BACK_PAY_ROLE.ID_CURRENCY = ID_CURRENCY Then 
					nAmt = nAmt + SCO_BACK_PAY_ROLE.SCO_DIF_VALUE
				Else
					nConver = EXCHANGE_RATES!CURRENCY.curGetExchange(SCO_BACK_PAY_ROLE.ID_CURRENCY, ID_CURRENCY,SCO_BACK_PAY_ROLE.SCO_DT_EXCHANGE, SCO_BACK_PAY_ROLE.EX_TYPE,SCO_BACK_PAY_ROLE.SCO_DIF_VALUE)
					nAmt = nAmt + nConver
				EndIf
			ElseIf sIDConcept < SCO_BACK_PAY_ROLE.ID_ITEM Then
				Return(nAmt)
			EndIf
		ElseIf sIDNode < SCO_BACK_PAY_ROLE.ID_TI Then
			Return (nAmt)
		EndIf
		SCO_BACK_PAY_ROLE.GONEXT()
	Until SCO_BACK_PAY_ROLE.IsEOF() = TRUE
EndIf
Return(nAmt)
