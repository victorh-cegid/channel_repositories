SCO_LIMITED_DATE = DateAdd(SCO_HRROLE_CALC.SCO_DT_PAYMENT,-3,M4_MONTH)
'sSysSentence = "FROM &SCO_AC_HR_ROLE A WHERE A.SCO_DT_PAYMENT >= @SCO_LIMITED_DATE"
'sSysSentence = "FROM &SLA_AC_HR_ROLE A WHERE A.SCO_DT_PAYMENT >= @SCO_LIMITED_DATE"
'sSysSentence = "FROM &CLA_AC_HR_ROLE A WHERE A.SCO_DT_PAYMENT >= @SCO_LIMITED_DATE"
sSysSentence = "FROM &SAR_AC_HR_ROLE A WHERE A.SCO_DT_PAYMENT >= @SCO_LIMITED_DATE"

Return(sSysSentence)
