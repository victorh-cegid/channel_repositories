curr=getcurrent()
Numreg=Count()              

If  Numreg>0 then
	for i=0 to Numreg-1
		moveto(i)
                if SCO_PROCESS_CURR<>ID_CURRENCY then
		
                If SCO_PROCESS_CURR = "EUR" tHEN
                    X = SCO_EURO_ROUND()            
                Else 	
                    X = CUREXCHANGERECORDROUNDED(SCO_PROCESS_CURR,0)
                EndIf
                
		endif
	next
Endif

moveto(curr)

RETURN(X)
