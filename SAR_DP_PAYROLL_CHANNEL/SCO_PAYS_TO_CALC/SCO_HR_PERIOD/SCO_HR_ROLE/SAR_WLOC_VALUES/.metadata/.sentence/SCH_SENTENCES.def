# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_WLOC_VALUES | 0 | 0 | 1 |  | 80 |  |  | #I = #I |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_DT_START = A.SCO_DT_START, @SCO_VALUE = C.SCO_VALUE, @ID_M4_TYPE = C.ID_M4_TYPE, @SCO_ID_CURRENCY = C.SCO_ID_CURRENCY, @SCO_DT_EXCHANGE = C.SCO_DT_EXCHANGE, @EX_TYPE = C.EX_TYPE, @SCO_OR_HR_ROLE = A.SCO_OR_HR_ROLE, @SCO_ID_WORK_LOCATION = A.SCO_ID_WORK_LOCATION, @ID_DMD_COMPONENT = C.ID_DMD_COMPONENT FROM &SCO_H_HR_WLOCATION A, STD_WORK_LOCATION B, SCO_WC_VALUES C WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_WORK_LOCATION = B.STD_ID_WORK_LOCATION(+) AND C.ID_ORGANIZATION(+) = B.ID_ORGANIZATION AND C.SCO_ID_WORK_CENTER(+) = B.STD_ID_WORK_LOCATION AND (A.SCO_ID_WORK_LOCATION = C.SCO_ID_WORK_CENTER)
