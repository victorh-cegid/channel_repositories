# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_ORG_VALUES | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? And #I = 'DMD_TA' |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @ID_DMD = A.ID_DMD, @DT_START = A.DT_START, @ID_DMD_COMPONENT = A.ID_DMD_COMPONENT, @DT_COR_START = A.DT_COR_START, @DT_COR_END = A.DT_COR_END, @DT_END = A.DT_END, @SCO_VALUE = A.SCO_VALUE, @ID_M4_TYPE = A.ID_M4_TYPE, @SCO_ID_CURRENCY = A.SCO_ID_CURRENCY, @SCO_DT_EXCHANGE = A.SCO_DT_EXCHANGE, @EX_TYPE = A.EX_TYPE, @SCO_ID_REASON_CHANGE = A.SCO_ID_REASON_CHANGE, @ID_PRIORITY = A.ID_PRIORITY FROM &SCO_ORG_VALUES A WHERE (A.DT_START <= @SAR_DT_ALLOC_END And A.DT_END >= @SAR_DT_ALLOC_START And A.ID_DMD = 'DMD_TA')
