# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_HR_C_COSTO | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? ) Or ( #I IS NULL ) |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_ROLE = A.SCO_OR_HR_ROLE, @SSP_ID_CENT_COSTO = A.SSP_ID_CENT_COSTO FROM &SAR_H_HR_C_COSTO A WHERE (A.DT_START <= @SAR_FECHA_FILTRO And ( A.DT_END >= @SAR_FECHA_FILTRO ) Or ( A.DT_END IS NULL ))
