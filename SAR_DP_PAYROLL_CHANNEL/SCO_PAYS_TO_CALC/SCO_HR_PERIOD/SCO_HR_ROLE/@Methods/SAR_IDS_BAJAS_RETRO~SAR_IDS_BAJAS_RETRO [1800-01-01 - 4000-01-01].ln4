// Para las bajas retroactivas
// Debe ejecutarse al finalizar el calculo de las diferencias y antes de pasar los valores al nodo aux
// Debe ejecutarse sin tramos

// Hace dos cosas:
// 1.- Rellena el valor de los elementos marcados como "Valor de la revision"
// con el valor de la paga original en el tramo en el que el empleado no existe

dFecFinCalc = SCO_DT_END_CALC_ROLE 
dFecFinRetro = SCO_DT_END_CALC_ROLE_RETRO

sIdItemDif = "" ' Item de la TI de diferencias
sIdItemAc = ""  ' Item de la TI de acumulado: SAR_IDS_RETRO

'Control retroactivas
'Situacion especial: Control para cambios de ROL sin cambio de PERIODO retroactivos, y sin dias de alta en dicho ROL en el recalculo.
'Este cambio permite que se suba correctamente al periodo el coeficiente del ROL actual y se pueda calcular la diferencia respecto a lo acumulado en paga normal
SAR_IDS_RETRO_ROLE.Load_blk()
SAR_RETRO_H_ROL.DESTROY()
SAR_RETRO_H_ROL.SAR_ID_HR = SCO_ID_HR
SAR_RETRO_H_ROL.SAR_OR_HR_PERIOD = SCO_OR_HR_PERIOD
SAR_RETRO_H_ROL.SAR_OR_HR_ROLE = SCO_OR_HR_ROLE
SAR_RETRO_H_ROL.SAR_FECHA_PAGO = SAR_PAYS_TO_CALC.SCO_DT_PAYMENT
SAR_RETRO_H_ROL.SAR_FECHA_IMPUT = SAR_PAYS_TO_CALC.SCO_DT_ALLOCATION
SAR_RETRO_H_ROL.Load_blk()
If SAR_RETRO_H_ROL.Count()>0 Then
    'Si el rol finalizo antes de la fecha de calculo actual, significa que estamos calculando un rol que ha sido baja
    'posteriormente al calculo de la paga normal, en ese caso recogemos el coeficiente del nuevo rol, que se calculo antes.
    If SAR_RETRO_H_ROL.SCO_DT_END < SCO_DT_ALLOC_START and dFecFinCalc >= dFecFinRetro Then

        'Conceptos que necesitamos guardar en ROL NO vigente con el importe del ROL vigente
        SAR_HRROLE_CALC.SAR_COEF_JORNADA = SAR_AUX_JORN

        'Para recibo e informes: Conceptos que necesitamos que graben en retroactiva del ROL NO vigente el valor original de dicho ROL
        SetValue("SCO_DIF_HRROLE_CALC_1","SCO_ID_WORK_CENTER",-1,SAR_RETRO_H_ROL.SCO_ID_WORK_CENTER)
        SetValue("SCO_DIF_HRROLE_CALC_1","SCO_ID_WORK_UNIT",-1,SAR_RETRO_H_ROL.SCO_ID_WORK_UNIT)
        SetValue("SCO_DIF_HRROLE_CALC_1","SAR_ID_CENTRO_TRAB",-1,SAR_RETRO_H_ROL.STD_ID_WORK_LOCATION)
        SetValue("SCO_DIF_HRROLE_CALC_1","SCO_ID_JOB_CODE",-1,SAR_RETRO_H_ROL.STD_ID_JOB_CODE)
        SetValue("SCO_DIF_HRROLE_CALC_1","SSP_ID_CENT_COSTO",-1,SAR_RETRO_H_ROL.SSP_ID_CENT_COSTO)        
        SetValue("SCO_DIF_HRROLE_CALC_1","SAR_ID_ACTIVIDAD",-1,SAR_RETRO_H_ROL.SAR_ID_ACTIVIDAD)
    Else
        SAR_AUX_JORN = SAR_HRROLE_CALC.SAR_COEF_JORNADA
    EndIf
Else
    SAR_AUX_JORN = SAR_HRROLE_CALC.SAR_COEF_JORNADA
EndIf
'Fin Control retroactivas

If dFecFinCalc < dFecFinRetro Then          ' Hay algun tramo donde el empleado no existe

// 1.-     
    
    SAR_IDS_RETRO_ROLE.Begin()

    sIdItemDif = "SSP_ID_CENT_COSTO"
    sIdItemAc = "SSP_ID_CENT_COSTO"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_ID_ACTIVIDAD"
    sIdItemAc = "SAR_ID_ACTIVIDAD"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_ID_CENTRO_TRAB"
    sIdItemAc = "SAR_ID_CENTRO_TRAB"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SCO_ID_JOB_CODE"
    sIdItemAc = "SCO_ID_JOB_CODE"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

EndIf
