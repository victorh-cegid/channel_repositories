'Carga de roles cerrados que deberian ser tenidos en cuenta para el calculo de la retroactividad
'Solo la lanzamos si estamos en revision, el nodo solo se ha cargado una vez para este period (SCO_LOAD_AGAIN = 1),
'y ademas ha encontrado algun registro (como minimo debe haber un main role)
If SCO_PAYS_TO_CALC.SCO_REVISION = 0 or SCO_LOAD_AGAIN = 0 then 
    SCO_LOAD_AGAIN = 1
    return(0)
Else
    SCO_LOAD_AGAIN = 0 
    SCO_HR_PERIOD.SCO_SQL_CLOSED_ROLES = ""
    sSysSentence = "SELECT @SCO_DT_START = #MIN(SCO_DT_START_SLICE), @SCO_DT_END = #MAX(SCO_DT_END_SLICE), @SCO_ID_HR = SCO_ID_HR, @SCO_MAIN_ROLE = '0', @SCO_IS_CLOSED_RETRO = 1, @SCO_OR_HR_PERIOD = #MAX(SCO_OR_HR_PERIOD), @SCO_OR_HR_ROLE = SCO_OR_HR_ROLE FROM &SCO_AC_HR_ROLE WHERE SCO_DT_ALLOCATION = @SCO_DT_ALLOCATION AND SCO_DT_PAYMENT = @SCO_DT_ALLOCATION AND SCO_PAY_FREQ_ALLOC = @SCO_PAY_FREQ_ALLOC AND ID_ORGANIZATION = @ID_ORGANIZATION AND SCO_ID_HR = '" + getValue("SCO_HR_PERIOD","STD_ID_HR",-1) +"' AND SCO_OR_HR_PERIOD = " + ToString(getValue("SCO_HR_PERIOD","STD_OR_HR_PERIOD",-1),0) 
    End()
    iPos = Getcurrent()
    If iPos <> -1 then     'Estamos en el caso de roles cerrados, no en la baja retroactiva del period
        'Primero revisamos los sRoles actuales, para cargar solo los que se han cerrado
        sRoles = " ("
        Begin()
        While IsEOF() = M4_FALSE
            sRoles = sRoles + ToString(SCO_OR_HR_ROLE,0) + ","
            GONEXT()
        Wend
        'al terminar, hay una coma de mas. La eliminamos y cerramos el parentesis
        sRoles = Mid(sRoles, 0, Length(sRoles)-1) + ") "
        
        'Cargamos los roles con fechas de inicio y fin las de la paga para que el SCO_CALCHRP ejecute correctamente el SCO_CALCROLE
        sSysSentence = sSysSentence + " AND ((SCO_DT_PAY_CLOSED_ROLES = @SCO_DT_PAYMENT AND SCO_PAY_FREQ_CLOSED_ROLES = @SCO_PAY_FREQ_PAYM) OR (SCO_DT_PAY_CLOSED_ROLES IS NULL AND SCO_PAY_FREQ_CLOSED_ROLES IS NULL)) "
        sSysSentence = sSysSentence + " AND SCO_OR_HR_ROLE NOT IN " + sRoles 
    endif    
    sSysSentence = sSysSentence + " GROUP BY SCO_ID_HR, SCO_OR_HR_ROLE"


    SCO_LOAD_CLOSED_ROLES_SYSS = sSysSentence
    Load_Blk()
    'Dejamos la syssentence vacia para que no afecte a la carga del siguiente period
    SCO_LOAD_CLOSED_ROLES_SYSS = ""

    'Para roles cerrados buscamos los nuevos roles que hemos cargado para marcar sus acumulados como pagados
    if iPos <> -1 and iPos <> count()-1 then 'Estamos en el caso de roles cerrados y ha cargado algun role mas
        moveTo(iPos+1)
        sClosedRoles = " ("
        While IsEOF() = M4_FALSE
            sClosedRoles = sClosedRoles + ToString(SCO_OR_HR_ROLE,0) + ","
            GONEXT()
        wend
        'al terminar, hay una coma de mas. La eliminamos y cerramos el parentesis
        sClosedRoles = Mid(sClosedRoles , 0, Length(sClosedRoles )-1) + ") "

        Begin()
        sWriteObj = GetNodeWriteObjectId("SCO_AUX_AC_HRROLE") 
        SCO_HR_PERIOD.SCO_SQL_CLOSED_ROLES = "UPDATE " + sWriteObj + " A SET A.SCO_DT_PAY_CLOSED_ROLES = @SCO_DT_PAYMENT, A.SCO_PAY_FREQ_CLOSED_ROLES = @SCO_PAY_FREQ_PAYM WHERE A.SCO_ID_HR=@STD_ID_HR AND A.SCO_OR_HR_ROLE IN "+ sClosedRoles +" AND A.SCO_DT_PAYMENT=@SCO_DT_ALLOCATION AND A.SCO_DT_ALLOCATION=@SCO_DT_ALLOCATION AND A.SCO_PAY_FREQ_ALLOC=@SCO_PAY_FREQ_ALLOC AND A.SCO_PAY_FREQ_PAYM=@SCO_PAY_FREQ_ALLOC AND A.ID_ORGANIZATION = @ID_ORGANIZATION"

    endif    
endif
