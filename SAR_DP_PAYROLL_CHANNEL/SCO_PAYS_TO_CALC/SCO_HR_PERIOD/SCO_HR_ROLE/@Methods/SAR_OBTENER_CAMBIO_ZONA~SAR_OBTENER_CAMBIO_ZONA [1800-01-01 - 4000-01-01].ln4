'El presente método pretende: 
      'Encontrar la existencia de un cambio de zona en lo que va del año fiscal y en caso de encontrarlo:
             '1- Obtiene el mes en la zona anterior.
             '   Se calcula para esto el SAR_ARG_MES_PREVIO
             '2- Obtiene la zona previa al cambio.
             '   Retornado por el método
      'Importante: en pagas diferidas se debe conciderar la posibilidad de leer el mes de diciembre del año anterior.
If(SAR_LUGAR_TRABA_ZONA_DES.count() = 0)Then
    SAR_HR_ROLE.begin()
EndIf

             
Zona_Previa     = -1
Mes_Zona_Previa = -1
Cambio          = -1
Mes             = DxMonth(SAR_ARG_FECHA_DESDE) 
ID_DMD          = "SAR_INDIC_REDUC_ZON_DES_1"

SAR_LUGAR_TRABA_ZONA_DES.begin()
IntCantRegLugTrab = SAR_LUGAR_TRABA_ZONA_DES.count()
If IntCantRegLugTrab > 0 Then      

   While(Mes >= 1 And Cambio = -1)
 
        Anio_Rec = DxYear(SCO_DT_PAYMENT)
        Dias_Rec = DxDaysOfMonth(Mes, Anio_Rec)
        Fecha_Lugar = DxDate(Dias_Rec, Mes, Anio_Rec) 
        
        SAR_LUGAR_TRABA_ZONA_DES.begin()
         vPos = SAR_LUGAR_TRABA_ZONA_DES.FindRegister("SCO_DT_START",Fecha_Lugar,M4_SMALLER_OR_EQUAL,"SCO_DT_END",Fecha_Lugar,M4_GREATER_OR_EQUAL)
        If vPos <> -1 Then                  
            SAR_LUGAR_TRABA_ZONA_DES.MOVETO(vPos)
            vId_Lug_Trab = SAR_LUGAR_TRABA_ZONA_DES.SCO_ID_WORK_LOCATION
            vFec         = SAR_LUGAR_TRABA_ZONA_DES.SCO_DT_START       
            vPosVal      = SAR_WLOC_VALUES.FindRegister("SCO_ID_WORK_LOCATION", vId_Lug_Trab, M4_EQUAL, "ID_DMD_COMPONENT", ID_DMD, M4_EQUAL, "SCO_DT_START",vFec,M4_EQUAL)
            If vPosVal <> -1 Then
                 SAR_WLOC_VALUES.MOVETO(vPosVal)
                 vIND_DES = SAR_WLOC_VALUES.SCO_VALUE
            Else
                 vIND_DES = 0
            Endif   
            If(Zona_Previa <> vIND_DES)Then 'Son distintas las zonas:
               If(Zona_Previa <> -1)Then
                  SAR_ARG_MES_PREVIO = Mes 'Mes de la zona anterior
                  Cambio = 1
               EndIf
               Zona_Previa = vIND_DES  'Toma valor la primera vez.
            EndIf   
         EndIf
         Mes = Mes -1

   Wend
EndIf   

If(SAR_ARG_MES_PREVIO = -1)Then

EndIf
Return(Zona_Previa)
