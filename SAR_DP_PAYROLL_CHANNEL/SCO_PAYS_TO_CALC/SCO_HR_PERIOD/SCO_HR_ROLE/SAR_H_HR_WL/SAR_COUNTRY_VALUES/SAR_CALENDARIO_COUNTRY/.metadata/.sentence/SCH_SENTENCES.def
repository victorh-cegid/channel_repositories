# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_CALENDARIO_COUNTRY | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? And #I <= ? And #I >= ? |  | SELECT @SCO_ID_CALENDAR = A.SCO_ID_CALENDAR, @SCO_ID_DAY_CALENDAR = A.SCO_ID_DAY_CALENDAR, @DT_START = A.DT_START, @DT_END = A.DT_END, @SCO_NM_DAY_CALENDAR = C.SCO_NM_DAY_CALENDAR, @DT_START_1 = C.DT_START, @DT_END_1 = C.DT_END, @ID_ORGANIZATION = A.ID_ORGANIZATION FROM &SCO_CALEN_INVOLVED A, SCO_DAY_CALENDAR C WHERE A.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND A.SCO_ID_DAY_CALENDAR = C.SCO_ID_DAY_CALENDAR(+) AND (A.DT_START <= @SAR_DT_ALLOC_END And A.DT_START >= @SAR_DT_ALLOC_START And C.DT_START <= @SAR_DT_ALLOC_END And C.DT_START >= @SAR_DT_ALLOC_START)
