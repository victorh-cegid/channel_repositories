# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_HR_WL | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_ROLE = A.SCO_OR_HR_ROLE, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @SCO_ID_WORK_LOCATION = A.SCO_ID_WORK_LOCATION, @STD_ID_COUNTRY = D.STD_ID_COUNTRY FROM &SCO_H_HR_WLOCATION A, STD_WORK_LOCATION B, SCO_H_WLOCATION_ADDRESS C, STD_COUNTRY D WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_WORK_LOCATION = B.STD_ID_WORK_LOCATION(+) AND C.ID_ORGANIZATION(+) = B.ID_ORGANIZATION AND C.STD_ID_WORK_LOCATION(+) = B.STD_ID_WORK_LOCATION AND C.ID_ORGANIZATION = D.ID_ORGANIZATION(+) AND C.STD_ID_COUNTRY = D.STD_ID_COUNTRY(+) AND (A.SCO_DT_START <= @SAR_DT_ALLOC_END And A.SCO_DT_END >= @SAR_DT_ALLOC_START)
