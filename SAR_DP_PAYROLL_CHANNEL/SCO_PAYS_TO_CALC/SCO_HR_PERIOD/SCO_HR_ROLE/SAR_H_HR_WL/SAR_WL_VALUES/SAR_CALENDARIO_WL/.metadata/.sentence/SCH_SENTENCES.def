# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_CALENDARIO_WL | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? And #I <= ? And #I >= ? |  | SELECT @SCO_ID_CALENDAR = A.SCO_ID_CALENDAR, @SCO_ID_DAY_CALENDAR = A.SCO_ID_DAY_CALENDAR, @DT_START = A.DT_START, @DT_END = A.DT_END, @SCO_COMMENT = A.SCO_COMMENT, @SCO_NM_DAY_CALENDAR = B.SCO_NM_DAY_CALENDAR, @DT_START_1 = B.DT_START, @DT_END_1 = B.DT_END FROM &SCO_CALEN_INVOLVED A, SCO_DAY_CALENDAR B WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_DAY_CALENDAR = B.SCO_ID_DAY_CALENDAR(+) AND (A.DT_START <= @SAR_DT_ALLOC_END And A.DT_START >= @SAR_DT_ALLOC_START And B.DT_START <= @SAR_DT_ALLOC_END And B.DT_START >= @SAR_DT_ALLOC_START)
