'
'Busco el precio del sueldo que tiene el empleado a la fecha recibida por argumento.
'Leo dicho precio desde el tramo correspondiente al concepto 1002 si esta cargado a nivel
'de period, sino lo leo del tramo correspondiente al concepto 1000002 (nivel de rol)
'La formula del precio se calcula segun el concepto recibido por parametro
'

SALARIO = 0
PROMEDIO = SAR_HRPERIOD_CALC.SAR_PRO_VAR_ULT_6

IF ISNULL(PROMEDIO) = TRUE THEN
    PROMEDIO = 0
ENDIF


NUM_TRAMOS_SUELDO_PERIOD = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA..SysSliceNumber


'Si estamos trabajando sin tramos, el num de tramos deber ser 1
If GetSliceMode() = FALSE Then
    NUM_TRAMOS_SUELDO_PERIOD = 1
Endif
FOR I = 0 TO NUM_TRAMOS_SUELDO_PERIOD - 1
    INICIO_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I]..SysStartDate
    FIN_TRAMO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I]..SysEndDate
    VAL_PER = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA..sysTotalSlices(M4_TOTAL_FIRST)

    IF ARG_FECHA >= INICIO_TRAMO AND ARG_FECHA <= FIN_TRAMO THEN
        IF ARG_CONCEPTO = "NONE" OR  ARG_CONCEPTO = "#4110" OR ARG_CONCEPTO = "#4120" THEN         
                IF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "001" THEN         
                    IF SAR_HRPERIOD_CALC.SAR_DIAS_NORM_SUELD <> 0 THEN
                        SALARIO = (SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I] + PROMEDIO)/SAR_HRPERIOD_CALC.SAR_DIAS_NORM_SUELD                       
                    ELSE
                        SALARIO = 0
                    ENDIF
                ELSE
                    SALARIO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I] + (PROMEDIO/SAR_HRPERIOD_CALC.SAR_HORAS_MES)
                ENDIF
                IF ARG_CONCEPTO = "#4120" THEN
                    '-------------------------------------------------------.
                    aux = DxDate(06,11,2009)
                    '--------------------------------------------------------.
                    
                    IF INICIO_TRAMO >= aux THEN      
                        SALARIO = SALARIO + Round((SALARIO/12),2)
                    ENDIF
    
                ENDIF
        ELSEIF ARG_CONCEPTO = "#4108" OR ARG_CONCEPTO = "#4160" OR ARG_CONCEPTO = "#4170" OR ARG_CONCEPTO = "#4180" OR ARG_CONCEPTO = "#4190" OR ARG_CONCEPTO = "#4193" OR ARG_CONCEPTO = "#4195" OR ARG_CONCEPTO = "#4723" OR ARG_CONCEPTO = "#4171" THEN
            IF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "001" THEN
                IF SAR_HRPERIOD_CALC.SAR_DIAS_NORM_SUELD <> 0 THEN
                    SALARIO = (SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I])/SAR_HRPERIOD_CALC.SAR_DIAS_NORM_SUELD                
                ELSE
                    SALARIO = 0
                ENDIF
            ELSE
                SALARIO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I]
            ENDIF
        ELSEIF ARG_CONCEPTO = "#4060" OR ARG_CONCEPTO = "#4070" OR ARG_CONCEPTO = "#4080" OR ARG_CONCEPTO = "#4090" OR ARG_CONCEPTO = "#4100" OR ARG_CONCEPTO = "#3553" THEN

            IF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "001" THEN
                SALARIO = (SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I] + PROMEDIO)/25
            ELSEIF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "002" THEN
                SALARIO = ((SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I] + PROMEDIO) * 30) / 25    'Se lleva a valor mensual para aplicarle el recargo correspondiente de vacaciones y licencias especiales.
            ELSEIF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "003" THEN    
                SALARIO = Round(VAL_PER + (PROMEDIO/SAR_HRPERIOD_CALC.SAR_HORAS_MES),2)
            ENDIF
        ELSEIF ARG_CONCEPTO = "#4433" OR ARG_CONCEPTO = "#4423" OR ARG_CONCEPTO = "#4437" OR ARG_CONCEPTO = "#4257" OR ARG_CONCEPTO = "#4263" OR ARG_CONCEPTO = "#4463" OR ARG_CONCEPTO = "#4473"  THEN 'Licencias Horarias y Horas extras
            IF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "001" THEN
                IF SAR_HRPERIOD_CALC.SAR_HORAS_MES <> 0 THEN
                    SALARIO = (SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I])/SAR_HRPERIOD_CALC.SAR_HORAS_MES
                ELSE
                    SALARIO = 0
                ENDIF
            ELSEIF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "002" THEN
                IF SAR_HRPERIOD_CALC.SAR_HS_DIARIAS_PROM = 0 THEN
                    Setlog (-1,80,4,205,SCO_ID_HR)
                    SCO_ERROR =1
                ELSE
                    SALARIO = (SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I])/SAR_HRPERIOD_CALC.SAR_HS_DIARIAS_PROM
                ENDIF
            ELSEIF SAR_HRPERIOD_CALC.SAR_TIPO_SALARIO = "003" THEN
                SALARIO = SAR_HRPERIOD_CALC.SAR_TOT_P_COMP_EA[I]
            ENDIF
        ENDIF
    ENDIF
NEXT

Return(SALARIO)
