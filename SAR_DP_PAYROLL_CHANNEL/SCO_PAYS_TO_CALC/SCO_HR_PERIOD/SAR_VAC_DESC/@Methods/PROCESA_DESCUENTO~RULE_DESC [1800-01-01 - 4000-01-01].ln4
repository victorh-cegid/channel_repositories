' Argumentos:FEC_INI_ABS_ARG, FEC_FIN_ABS_ARG, SCO_DT_PAYMENT_ARG, INCIDENCIA_ARG, 
'            SCO_DT_ALLOCATION_ARG, TIPO_SALARIO, DIAS_CALC, INI_TRAMO, FIN_TRAMO
         

     'Inicializaciones
     SCO_DT_PAYMENT    = SCO_DT_PAYMENT_ARG
     SCO_DT_ALLOCATION = SCO_DT_ALLOCATION_ARG
     fec_ini_abs       = FEC_INI_ABS_ARG
     fec_fin_abs       = FEC_FIN_ABS_ARG
     Mes_Paga          = DXMONTH(SCO_DT_PAYMENT)
     Insertar          = 0
     Aus_A_Desc        = 0      

     'Por sentencia:
     'Fecha de inicio-------------------------------------------------------------------------     
     Mes_Fecha_S  = DXMONTH(fec_ini_abs) 
     Anio_Fecha_S = DXYEAR(fec_ini_abs)
     Dia_FEcha_S  = DXDAY(fec_ini_abs)

     IF Mes_Fecha_S < 10 THEN
             Mes_Fecha_S = "0" + TOSTRING(Mes_Fecha_S,0)
     ELSE
             Mes_Fecha_S = TOSTRING(Mes_Fecha_S,0)
     ENDIF
     IF Dia_Fecha_S < 10 THEN
             Dia_Fecha_S = "0" + TOSTRING(Dia_Fecha_S,0)
     ELSE
             Dia_Fecha_S = TOSTRING(Dia_Fecha_S,0)
     ENDIF
     Anio_Fecha_S = ToString(Anio_Fecha_S, 0) 
     fecha_de_abs = Anio_Fecha_S + "-" + Mes_Fecha_S + "-" + Dia_Fecha_S 
     '-------------------------------------------------------------------------

     'Fecha de fin-------------------------------------------------------------------------     
     Mes_Fecha_F  = DXMONTH(fec_fin_abs) 
     Anio_Fecha_F = DXYEAR(fec_fin_abs)
     Dia_FEcha_F  = DXDAY(fec_fin_abs)

     IF Mes_Fecha_F < 10 THEN
             Mes_Fecha_F = "0" + TOSTRING(Mes_Fecha_F,0)
     ELSE
             Mes_Fecha_F = TOSTRING(Mes_Fecha_F,0)
     ENDIF
     IF Dia_Fecha_F < 10 THEN
             Dia_Fecha_F = "0" + TOSTRING(Dia_Fecha_F,0)
     ELSE
             Dia_Fecha_F = TOSTRING(Dia_Fecha_F,0)
     ENDIF
     Anio_Fecha_F = ToString(Anio_Fecha_F, 0) 
     fecha_fin_de_abs = Anio_Fecha_F + "-" + Mes_Fecha_F + "-" + Dia_Fecha_F 
     '-------------------------------------------------------------------------

    'Calculo inicial sobre el mes de paga
     dias_del_mes = DaysOfMonth(SCO_DT_PAYMENT)

     If(TIPO_SALARIO_ARG = "003")Then
       If(HORAS_TEORICAS_ARG > 0)Then
          dias_calc_arg = dias_calc_arg / HORAS_TEORICAS_ARG
       Else   
          dias_calc_arg = dias_calc_arg / HORAS_PROMEDIADAS_ARG
       EndIf
     EndIf     
     'Los dias ya se calcularon 
     If(dias_calc_arg <> 0)Then
       If(INCIDENCIA_ARG = "9")Then
        'Según la incidencia debemos intentar sumar a dias_calc_arg algún posible desfasaje del mes anterior        
         SYS_SENTENCE_A = ""
         SAR_VAC_DESC.DESTROYBLOCK()
         SAR_VAC_DESC.SYS_SENTENCE_A =  "SELECT @SCO_ID_HR = A.SCO_ID_HR, @DT_START_VAC = A.DT_START_VAC, @DT_END_VAC = A.DT_END_VAC, @SCO_DT_PAY = A.SCO_DT_PAY, @SCO_DT_ALLOC = A.SCO_DT_ALLOC, @SAR_DIAS_TOMADOS = A.SAR_DIAS_TOMADOS, @SAR_DIAS_DESCONT = A.SAR_DIAS_DESCONT, @SCO_ID_INCIDENCE  = A.SCO_ID_INCIDENCE  FROM &SAR_VAC_DESC A Where(A.SCO_ID_HR= '"+ SCO_ID_HR + "' And A.SCO_ID_INCIDENCE = '"+ INCIDENCIA_ARG + "' And A.DT_START_VAC = #DATE('" + fecha_de_abs + "') " + "' And A.DT_END_VAC = #DATE('" + fecha_fin_de_abs + "'))  "  
         SAR_VAC_DESC.LOAD_BLK()
         SAR_VAC_DESC.MoveTo(0)  

         If (SAR_VAC_DESC.Count() = 0) Then
                Insertar = 1 
         Else 
            Pos =  SAR_VAC_DESC.FINDREGISTER("SCO_DT_ALLOC", SCO_DT_ALLOCATION_ARG, equal, "DT_START_VAC", fec_ini_abs, equal,0)                                   
            IF Pos = -1  Then 'Tomo informacion de la paga anterior
                exced_a_desc_anterior   =  SAR_VAC_DESC.SAR_DIAS_DESCONT  
                Aus_A_Desc              =  Aus_A_Desc + exced_a_desc_anterior 'se mantiene igual si en el mes anterior no hubo desplazamiento
                Insertar = 1                 
            Else 'Ya existe registro de descuento para la paga actual:  
               dias_calc_arg = 0
               SAR_VAC_DESC.MoveTo(Pos) 
               If(SAR_VAC_DESC.Count() > 1)Then
                  'Buscar cada registro correspondiente a la misma fecha de imputación
                  'En este caso no usamos el dias_calc_arg porque lo generamos desde la base
                   While(SAR_VAC_DESC.IsEOF() = FALSE)
                       If(SAR_VAC_DESC.SCO_DT_ALLOC = SCO_DT_ALLOCATION_ARG)Then
                            dias_calc_arg = dias_calc_arg + SAR_VAC_DESC.SAR_DIAS_TOMADOS
                       EndIf      
                       Pos = Pos + 1
                       SAR_VAC_DESC.MoveTo(Pos) 
                   Wend
                Else   
                   dias_calc_arg = SAR_VAC_DESC.SAR_DIAS_TOMADOS
                EndIf 
            EndIf
         EndIf              
         'Calculamos según tipo de paga (mensual o bimensual) la función commondtime ya ajustó los dias de incidencia en dias_calc_arg
         If(DXDAY(INICIO_TRAMO_ARG) = 16)Then 'Bimensual 2da Quincena
               If(dias_calc_arg > 15)Then
                  dias_calc_arg = 15
                  Aus_A_Desc = 1
                  Insertar = 1                 
               EndIf
         ElseIf(DXDAY(INICIO_TRAMO_ARG) = 1)And(DXDAY(FIN_TRAMO_ARG) > 15)Then'Mensual      
               If(dias_calc_arg  + Aus_A_Desc > 30)Then
                  dias_calc_arg = 30
                  Aus_A_Desc = 1
                  Insertar = 1                 
               Else   
                  dias_calc_arg = dias_calc_arg + Aus_A_Desc
               EndIf               
         EndIf
         If(Insertar = 1)Then
            'SAR_VAC_DESC.Addregister()
            'SAR_VAC_DESC.DT_START_VAC = fec_ini_abs
            'SAR_VAC_DESC.DT_END_VAC = fec_fin_abs
            'SAR_VAC_DESC.SAR_DIAS_TOMADOS = dias_calc_arg
            'SAR_VAC_DESC.SAR_DIAS_DESCONT = Aus_A_Desc
            'SAR_VAC_DESC.SCO_DT_PAY = SCO_DT_PAYMENT
            'SAR_VAC_DESC.SCO_DT_ALLOC = SCO_DT_ALLOCATION
            'SAR_VAC_DESC.SCO_ID_INCIDENCE = INCIDENCIA_ARG 
            'SAR_VAC_DESC.Persist_Tree()                  
         EndIf       
       EndIf
       If(INCIDENCIA_ARG = "6")Then       
         If(DXDAY(INICIO_TRAMO_ARG) = 16)Then 'Bimensual 2da Quincena
               If(dias_calc_arg > 15)Then
                  dias_calc_arg = 15
                  Aus_A_Desc = 1
               EndIf
         ElseIf(DXDAY(INICIO_TRAMO_ARG) = 1)And(DXDAY(FIN_TRAMO_ARG) > 15)Then'Mensual      
               If(dias_calc_arg > 30)Then
                  dias_calc_arg = 30
                  Aus_A_Desc = 1
               ElseIf(DXMONTH(fec_ini_abs) = Mes_Paga)Then
                  If(dias_del_mes = 31)Then
                     dias_calc_arg = dias_calc_arg - 1
                  EndIf
               EndIf               
         EndIf
       EndIf
     EndIf  

  If(TIPO_SALARIO_ARG = "003")Then
    If(HORAS_TEORICAS_ARG > 0)Then
       dias_calc_arg = dias_calc_arg * HORAS_TEORICAS_ARG
    Else   
       dias_calc_arg = dias_calc_arg * HORAS_PROMEDIADAS_ARG
    EndIf
  EndIf     
     
return(dias_calc_arg)
