/*
   Este método se encarga de obtener los días de ausencia acumulados de pagas anteriores desde la tabla
   SAR_VAC_DESC.
   Estos días son sobrantes no aplicados a sus pagas por exceder el límite de día a pagar.
   Ejemplo: Mes de Octubre incluído en excedencia son 31 días reales, por lo tanto acumulamos
            1 día para noviembre y descontamos 30 en Octubre. 
*/

     dias_exced_despla  = 0
     SCO_DT_PAYMENT = SCO_DT_PAYMENT_ARG
     Mes_Excedido = DXMONTH(SCO_DT_PAYMENT) 
     Anio = DXYEAR(SCO_DT_PAYMENT)
     If(Mes_Excedido = 1)Then
         Mes_Excedido = 12
         Anio = Anio - 1
     Else   
         Mes_Excedido = Mes_Excedido - 1
     EndIf   
     IF Mes_Excedido < 10 THEN
             Mes_Excedido = "0" + TOSTRING(Mes_Excedido,0)
     ELSE
             Mes_Excedido = TOSTRING(Mes_Excedido,0)
     ENDIF
     'Dia_Excedido = DXDAY(SCO_DT_PAYMENT)
     Dia_Excedido = DXDAY(SCO_DT_PAYMENT)
     If(Dia_Excedido >= 30 And Mes_Excedido = "02")Then
        Dia_Excedido = 28 'Ver si Febrero tiene 28 o 28 esto dse modificó provisorio
     EndIf   
     IF Dia_Excedido < 10 THEN
             Dia_Excedido = "0" + TOSTRING(Dia_Excedido,0)
     ELSE
             Dia_Excedido = TOSTRING(Dia_Excedido,0)
     ENDIF
     Anio = ToString(Anio, 0)
     Fecha_Paga_Anterior = Anio + "-" + Mes_Excedido + "-" + Dia_Excedido

     SAR_VAC_DESC.DESTROYBLOCK()
     SAR_VAC_DESC.SYS_SENTENCE_A =  "SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @DT_START_VAC = A.DT_START_VAC, @DT_END_VAC = A.DT_END_VAC, @SCO_DT_PAY = A.SCO_DT_PAY, @SCO_DT_ALLOC = A.SCO_DT_ALLOC, @SAR_DIAS_TOMADOS = A.SAR_DIAS_TOMADOS, @SAR_DIAS_DESCONT = A.SAR_DIAS_DESCONT, @SCO_ID_INCIDENCE  = A.SCO_ID_INCIDENCE  FROM &SAR_VAC_DESC A Where(A.SCO_ID_HR= '"+ SCO_ID_HR + "' And A.SCO_ID_INCIDENCE = '"+ INCIDENCIA_ARG + "' And A.SCO_DT_PAY = #DATE('" + Fecha_Paga_Anterior + "')) "  
     SAR_VAC_DESC.LOAD_BLK()
     If (SAR_VAC_DESC.Count() > 0) Then'Tomamos la información del ultimo descuento
       If(DXMONTH(SAR_VAC_DESC.DT_END_VAC) = DXMONTH(SAR_VAC_DESC.SCO_DT_PAY))Then'Averiguamos si el mes anterior debe o no ser usado 
         dias_mes_paga_ant  =  DaysOfMonth(SAR_VAC_DESC.SCO_DT_PAY)  
         dias_mes_fin_exced = DXDAY(ToDate(SAR_VAC_DESC.DT_END_VAC))
         mes_paga_anterior = DXMONTH(SAR_VAC_DESC.SCO_DT_PAY)
         If(dias_mes_paga_ant < dias_mes_fin_exced + SAR_VAC_DESC.SAR_DIAS_DESCONT) Or (dias_mes_paga_ant = dias_mes_fin_exced  + SAR_VAC_DESC.SAR_DIAS_DESCONT And mes_paga_anterior = 31) Then'Averiguamos si el mes anterior debe o no ser usado 
             '--------- 
             dias_exced_despla  = SAR_VAC_DESC.SAR_DIAS_DESCONT
             '---------
         EndIf
       EndIf
     EndIf     
     'Reiniciamos el filtro por defecto
     SAR_VAC_DESC.SYS_SENTENCE_A =  ""
     SAR_VAC_DESC.LOAD_BLK()
     
  If(TIPO_SALARIO_ARG = "003")Then
    If(HORAS_TEORICAS_ARG > 0)Then
       dias_exced_despla = dias_exced_despla * HORAS_TEORICAS_ARG
    Else   
       dias_exced_despla = dias_exced_despla * HORAS_PROMEDIADAS_ARG
    EndIf
  EndIf     
     
Return(dias_exced_despla)
