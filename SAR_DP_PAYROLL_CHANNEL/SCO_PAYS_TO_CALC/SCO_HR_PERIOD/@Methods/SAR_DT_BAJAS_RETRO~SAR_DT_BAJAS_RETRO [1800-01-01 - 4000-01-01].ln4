//argumentos y ctes
dFecFinCalc = SCO_DT_END_CALC 
dFecFinRetro = SCO_DT_END_CALC_RETRO
sNodeDif = "SCO_DIF_HRPERIOD_CALC"
sTiDif = "SCO_DIF_HRPERIOD_CALC_1"
sNodeAc = "SAR_IDS_RETRO"
sIdItemDif = ARG_ID_ITEM_DIF

nNumTramos = ChannelAttribGetValue("",sNodeDif,sIdItemDif, "SysSliceNumber" )
For i = 0 to (nNumTramos-1)
    code = "Return("+ sTiDif+ "." +sIdItemDif+ "[" +Format(ToString(i),0)+ "]..SysStartDate )"
    dFecIniTramo = clcExecuteLN4JIT(code)

    If dFecIniTramo > dFecFinCalc Then 'tramo donde el empleado no existe
        IF i = 0 Then Return(1)
        vValor = GetValue(sNodeDif,sIdItemDif,-1,i-1)
        SetValue(sNodeDif,sIdItemDif,-1,i,vValor)
    EndIf
Next

Return(1)
