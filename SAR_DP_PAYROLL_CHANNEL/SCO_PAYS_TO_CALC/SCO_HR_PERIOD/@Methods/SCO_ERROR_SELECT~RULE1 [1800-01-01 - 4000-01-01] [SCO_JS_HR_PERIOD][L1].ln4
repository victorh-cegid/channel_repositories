SYSSENTENCE_ERROR = "FROM &STD_HR_PERIOD A WHERE EXISTS (SELECT SCO_ID_HR, SCO_OR_HR_PERIOD FROM SCO_HR_PAY_ERROR B WHERE A.STD_ID_HR = B.SCO_ID_HR AND A.STD_OR_HR_PERIOD = B.SCO_OR_HR_PERIOD AND B.SCO_DT_ALLOCATION = @SCO_DT_ALLOCATION AND B.SCO_DT_PAYMENT = @SCO_DT_PAYMENT AND B.SCO_PAY_FREQ_PAYM = @SCO_PAY_FREQ_PAYM)"
