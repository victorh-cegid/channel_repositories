'El metodo asigna los tramos que tienen valor nulo al ejecutar la retroactividad de una baja 

'Argumentos y constantes
sNodeDif = "SCO_DIF_HRPERIOD_CALC"  'Nodo de diferencias
sTiDif = ARG_ID_TI_DIF              'Estructura de nodo de diferencias
sIdItemDif = ARG_ID_ITEM_DIF        'Elemento del nodo de diferencias
sNodeAc = ARG_ID_NODE_AC            'Nodo de acumulado
sIdItemAc = ARG_ID_ITEM_AC          'Elemento del nodo de acumulado
 
'Recorremos los tramos
nNumTramos = ChannelAttribGetValue("",sNodeDif,sIdItemDif, "SysSliceNumber" )
For i = 0 to (nNumTramos-1)
    code = "Return("+ sTiDif+ "." +sIdItemDif+ "[" +Format(ToString(i),0)+ "]..SysStartDate )"
    dFecIniTramo = clcExecuteLN4JIT(code)

    'Comprobamos si en el tramo el empleado es baja, o estamos en el caso de baja retroactiva
    If dFecIniTramo > SCO_DT_END_CALC or SCO_RETRO_TERM = STD_ID_HR Then 
        'Leemos el valor del nodo de acumulado, y lo asignamos en el tramo con prioridad maxima
        vValor = GetValue(sNodeAc,sIdItemAc,-1)
        SetValuePriority(0,sNodeDif,sIdItemDif,-1,i,vValor)

    EndIf
Next
 
Return(1)
