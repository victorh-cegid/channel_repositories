'The pourpose of this method is to get all posible errors and evitar the stop of
'the payroll process.

'Variables
DtAllocation = SCO_DT_ALLOCATION
NmFrequency  = SCO_PAYS_TO_CALC.SCO_NM_PAY_FREQUENCY

FI=SCO_DT_START_CALC
FF=SCO_DT_END_CALC
SetStartDate(FI)
SetEndDate(FF)

SCO_CALCHRP_CURRENCY()

//Antes de grabar miro si se ha producido algún error que no esté controlado.
SCO_HR_PAY_ERROR.SCO_FIND_ERROR()    

//Tanto si ha dado error el empleado como si no, borro los registros. Esto es porque en 
//caso de recálculos, se deben borrar los registros anteriores (damos por bueno el último 
//cálculo aunque haya sido erroneo). Sólo insertaré los datos si se cumplen ciertas condiciones.
Output=SCO_SAVE_AC()

If Output=M4_ERROR Then
	SetLog(-1,1,101,15,STD_ID_HR,STD_OR_HR_PERIOD,DtAllocation,NmFrequency)
	SCO_ERROR=1
	SCO_HR_PAY_ERROR.SCO_SET_SCO_ERROR_PERIOD()
	Return(-1)
ELSEIF Output=1 then
	//Seteamos las fechas porque se asignan propiedades que van a nivel de paga y por lo
	//tanto deben llevar las fechas de la paga.
	FI=SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC
	FF=SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC
	SetStartDate(FI)
	SetEndDate(FF)
	SCO_PAYS_TO_CALC.SCO_CALC_EMPLOYEE = SCO_PAYS_TO_CALC.SCO_CALC_EMPLOYEE+1
ElseIf SCO_ERROR = 1 Then
	Return(-1)
Else
	//Seteamos las fechas porque se asignan propiedades que van a nivel de paga y por lo
	//tanto deben llevar las fechas de la paga.
	FI=SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC
	FF=SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC
	SetStartDate(FI)
	SetEndDate(FF)
endif

SCO_PAYS_TO_CALC.SCO_NUM_CALC_EMP = SCO_PAYS_TO_CALC.SCO_NUM_CALC_EMP + 1

If SCO_PAYS_TO_CALC.SCO_CALC_EMPLOYEE = 1 then
	SCO_PAYS_TO_CALC.SCO_UPDATE_RUN_PAYS()
Endif
