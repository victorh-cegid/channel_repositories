// Para las bajas retroactivas
// Debe ejecutarse al finalizar el calculo de las diferencias y antes de pasar los valores al nodo aux
// Debe ejecutarse sin tramos

// Hace dos cosas:
// 1.- Rellena el valor de los elementos marcados como "Valor de la revision"
// con el valor de la paga original en el tramo en el que el empleado no existe

dFecFinCalc = SCO_DT_END_CALC 
dFecFinRetro = SCO_DT_END_CALC_RETRO

sIdItemDif = "" ' Item de la TI de diferencias
sIdItemAc = ""  ' Item de la TI de acumulado: SAR_IDS_RETRO

If dFecFinCalc < dFecFinRetro Then          ' Hay algun tramo donde el empleado no existe


// 1.-     
    
    SAR_IDS_RETRO.Begin()

    sIdItemDif = "SAR_ID_CATEGORIA"
    sIdItemAc = "SAR_ID_CATEGORIA"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_ID_CONVENIO"
    sIdItemAc = "SAR_ID_CONVENIO"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SCO_ID_LEG_ENT"
    sIdItemAc = "SCO_ID_LEG_ENT"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_ID_OBRA_SOCIAL"
    sIdItemAc = "SAR_ID_OBRA_SOCIAL"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_ID_SINDICATO"
    sIdItemAc = "SAR_ID_SINDICATO"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_ID_ZONA_SUB"
    sIdItemAc = "SAR_ID_ZONA_SUB"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_ID_EMPRESA"
    sIdItemAc = "SAR_ID_EMPRESA"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_TIPO_SALARIO"
    sIdItemAc = "SAR_TIPO_SALARIO"      
    SAR_IDS_GENERAL(sIdItemDif ,sIdItemAc)

    sIdItemDif = "SAR_FECHA_BASE"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_FEC_SICORE_IG"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_FEC_PAGO_IG"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_FECHA_ALTA"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_FECHA_BAJA"
    SAR_DT_BAJAS_RETRO(sIdItemDif)
    
    sIdItemDif = "SAR_FEC_FIN_IG_DEC"
    SAR_DT_BAJAS_RETRO(sIdItemDif)
    
    sIdItemDif = "SAR_FECHA_SICOSS"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_FEC_IMPUT_IG"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_FEC_INI_FILTRO_IG"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_FECHA_IMPUTACION"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_FEC_INDEM"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_ANIO_IMPUT_IG"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_ANIO_PAY_IG"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_MES_PAGO_IG"
    SAR_DT_BAJAS_RETRO(sIdItemDif)

    sIdItemDif = "SAR_ID_FONDO_PENS"
    SAR_DT_BAJAS_RETRO(sIdItemDif)
    
EndIf
