'variables
DtAllocation = SCO_DT_ALLOCATION
NmFrequency  = SCO_PAYS_TO_CALC.SCO_NM_PAY_FREQUENCY

num_reg=SCO_H_HR_PAY_FREQ.Count()

If num_reg=0 then
	SetLog(-1,1,101,9,STD_ID_HR,STD_OR_HR_PERIOD,DtAllocation,NmFrequency)
	SCO_ERROR=1
	return(-1)
Elseif num_reg=1 then
      SCO_H_HR_PAY_FREQ.Begin()
      Freq_Control = SCO_PAY_FREQ_CONTROL()  
	If Freq_Control = 1 Then
     		SetLog(0,1,101,8,STD_ID_HR,STD_OR_HR_PERIOD,DtAllocation,NmFrequency)
		Return(0)
	Else
		Return(1)
	EndIf
Else
	SetLog(-1,1,101,9,STD_ID_HR,STD_OR_HR_PERIOD,DtAllocation,NmFrequency)
	SCO_ERROR=1
	return(-1)
Endif
