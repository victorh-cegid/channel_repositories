'Variables
DtAllocation = SCO_DT_ALLOCATION
NmFrequency  = SCO_PAYS_TO_CALC.SCO_NM_PAY_FREQUENCY

//variable que indica si ha habido errores en pagas anteriores para el empleado
bExistError = FALSE

GONEXT()

IF ISEOF()=TRUE  then
	Do
		Output=SCO_PAYS_TO_CALC.SCO_PAY_END()
		If output=M4_ERROR Then
			SCO_PAYS_TO_CALC.SCO_ERROR=1
			SCO_PAYS_TO_CALC.SCO_NUM_PAYS_ERROR = SCO_PAYS_TO_CALC.SCO_NUM_PAYS_ERROR + 1
			SetLog(-1,1,101,7,DtAllocation,NmFrequency)
			SCO_PAYS_TO_CALC.End()
			SCO_PAYS_TO_CALC.GONEXT()
			SCO_PAYS_TO_CALC.SCO_CALC_END()
			Return(-1)
		EndIf

		SCO_PAYS_TO_CALC.SCO_NUM_PAYS_CALC = SCO_PAYS_TO_CALC.SCO_ACTUAL_PAY + 1

		IsNotEof=SCO_PAYS_TO_CALC.GONEXT()

		current=SCO_PAYS_TO_CALC.GETCURRENT()

		If (current=SCO_PAYS_TO_CALC.SCO_NUM_PAYS Or IsNotEOF = False) Then
	
			SCO_PAYS_TO_CALC.SCO_CALC_END()
			SCO_PAYS_TO_CALC.END()
			SCO_PAYS_TO_CALC.GONEXT()
			Return(1)
		Endif

		//Pongo aqui esta variables porque nos estamos moviendo por el nodo de pagas 
		//y van cambiando los valores
		DtAllocation = SCO_DT_ALLOCATION
		NmFrequency  = SCO_PAYS_TO_CALC.SCO_NM_PAY_FREQUENCY

		pay = SCO_PAYS_TO_CALC.SCO_ACTUAL_PAY

		FI=SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC
		FF=SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC
		SetStartDate(FI)
		SetEndDate(FF)

		SetRunDate(SCO_DT_ALLOCATION)

		SCO_PAYS_TO_CALC.SCO_ACTUAL_PAY = pay + 1

		If SCO_PAYS_TO_CALC.SCO_AUTO_REV=1 Then
			Output=SCO_PAYS_TO_CALC.SCO_CALCREV_PAY()
			If Output=M4_ERROR Then
				SCO_PAYS_TO_CALC.End()
				SCO_PAYS_TO_CALC.GONEXT()
				SCO_PAYS_TO_CALC.SCO_CALC_END()
				Return(-1)
			EndIf
		EndIf

		Output=SCO_PAYS_TO_CALC.SCO_PAYINIT()
		If Output=M4_ERROR then
			SCO_PAYS_TO_CALC.SCO_ERROR=1
			SCO_PAYS_TO_CALC.SCO_NUM_PAYS_ERROR = SCO_PAYS_TO_CALC.SCO_NUM_PAYS_ERROR + 1
			SetLog(-1,1,101,2,DtAllocation,NmFrequency)
			SCO_PAYS_TO_CALC.End()
			SCO_PAYS_TO_CALC.GONEXT()
			SCO_PAYS_TO_CALC.SCO_CALC_END()
			Return(-1)
		Endif
		Exist=Begin()
	UNTIL Exist=TRUE
Endif

SCO_HR_PAY_ERROR.SCO_SET_ERROR_POSITION()

//Antes de calcular se comprueba que no tiene errores anteriores que impedirian continuar el calculo.
If SCO_HR_PAY_ERROR.Count()<>0 Then

	//No se va a calcular el periodo %0:n del empleado %1:s en la nomina %2:s de pago %3:d
	//e imputacion %4:d porque hay errores en nominas anteriores. 
	//Debe solucionar esas nominas erroneas antes de ejecutar esta nomina.
           
	SetLog (-1,1,101,46,STD_OR_HR_PERIOD,STD_ID_HR,NmFrequency,SCO_DT_PAYMENT,DtAllocation)
	SCO_HR_PERIOD.SCO_ERROR = 1
	bExistError = TRUE

EndIf

If bExistError<>TRUE AND SCO_PAYS_TO_CALC.SCO_AUTO_REV = 1 then
	Output=SCO_CALCREV_PERIOD()

	If Output=M4_ERROR Then
		SetLog(-1,1,101,6,STD_ID_HR,STD_OR_HR_PERIOD,DtAllocation,NmFrequency)
		Output=SCO_PAYS_TO_CALC.SCO_PAYINIT()
		If Output=M4_ERROR then
			SCO_PAYS_TO_CALC.SCO_ERROR=1
			SetLog(-1,1,101,2,DtAllocation,NmFrequency)
			SCO_PAYS_TO_CALC.End()
			SCO_PAYS_TO_CALC.GONEXT()
			SCO_PAYS_TO_CALC.SCO_CALC_END()
			Return(-1)
		Endif

	ElseIf Output=1 then
		Output=SCO_PAYS_TO_CALC.SCO_PAYINIT()
		If Output=M4_ERROR then
			SCO_PAYS_TO_CALC.SCO_ERROR=1
			SetLog(-1,1,101,2,DtAllocation,NmFrequency)
			SCO_PAYS_TO_CALC.End()
			SCO_PAYS_TO_CALC.GONEXT()
			SCO_PAYS_TO_CALC.SCO_CALC_END()
			Return(-1)
		Endif
	Endif

endif

If bExistError<>TRUE AND Output<>M4_ERROR Then
    'OutputCalc=SCO_CALCHRP_CURRENCY()
    OutputCalc=SCO_CONTROL_ERRORS()
EndIf

OutputError = SCO_HR_PAY_ERROR.SCO_MANAGE_ERRORS(OutputCalc,Output)

If OutputError = M4_ERROR Then
    Return(M4_ERROR)
EndIf

Return(0)
