SCO_SQL_APP_ROLE="DELETE SCO_APPLY_ROLE A WHERE A.SCO_ID_HR=@STD_ID_HR AND A.SCO_OR_HR_PERIOD=@STD_OR_HR_PERIOD AND A.SCO_DT_PAYMENT=@SCO_DT_PAYMENT AND A.SCO_DT_ALLOCATION=@SCO_DT_ALLOCATION AND A.SCO_PAY_FREQ_ALLOC=@SCO_PAY_FREQ_ALLOC AND A.SCO_PAY_FREQ_PAYM=@SCO_PAY_FREQ_PAYM AND A.ID_ORGANIZATION = @ID_ORGANIZATION"

RETURN(0)
