'Variables
DtAllocation = SCO_DT_ALLOCATION
NmFrequency  = SCO_PAYS_TO_CALC.SCO_NM_PAY_FREQUENCY

'''''''''''''''FI=SCO_DT_START_CALC
'''''''''''''''FF=SCO_DT_END_CALC
'''''''''''''''SetStartDate(FI)
'''''''''''''''SetEndDate(FF)

Output = 1 
If SCO_RETRO_TERM <> STD_ID_HR then
    Output=SCO_CALC_FREQ_HRP()
Endif

If Output=0 Then

		//Seteamos las fechas porque se asignan propiedades que van a nivel de paga y por lo
		//tanto deben llevar las fechas de la paga.
		FI=SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC
		FF=SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC
		SetStartDate(FI)
		SetEndDate(FF)

	Return(0)
Else
	//En caso de que no haya dado error el cálculo de la frecuencia, continuo el cálculo
	If SCO_ERROR <> 1 Then
		SCO_AUX_AC_HRPERIOD.DestroyBlock()
		SCO_AUX_AC_HRROLE.DestroyBlock()

		SCO_DT_FILTER_BASE()  
      	SCO_DT_FILTER_PAYM_DATA()

            If SCO_RETRO_TERM <> STD_ID_HR then

                SCO_APPLYVAL_PERIOD!SCO_INTERMEDIATE_NODE_PERIOD.DESTROYBLOCK()
                SCO_APPLYVAL_PERIOD!SCO_INTERMEDIATE_NODE_PERIOD.SETDATES(GetStartDate(),GetEndDate(),SCO_DT_FILTER_BASE)
                SCO_APPLYVAL_PERIOD!SCO_INTERMEDIATE_NODE_PERIOD.SCO_SETAPPLYVALUE_I(STD_ID_HR,STD_OR_HR_PERIOD,STD_DT_END)
                SCO_APPLYVAL_PERIOD!SCO_INTERMEDIATE_NODE_PERIOD.APPLY()
         
                SCO_HRPERIOD_CALC.COPYREGISTER("SCO_APPLYVAL_PERIOD","SCO_INTERMEDIATE_NODE_PERIOD",-1,SCOPE_BLOCK+TYPE_PROPERTY,SCOPE_BLOCK+TYPE_CONCEPT)

                SCO_H_HR_CURRENCY.Begin()
                SCO_H_HR_LEGAL_ENTITY.BEGIN()
                leg_ent=SCO_H_HR_LEGAL_ENTITY.SCO_ID_LEG_ENT

            Else    'Para baja retroactiva no necesitamos el aplicavalor, y las monedas las sacamos del acumulado

                SCO_H_HR_CURRENCY.SCO_SYSS_PARAM = STD_ID_HR + "|" + ToString(STD_OR_HR_PERIOD) + "|" + ToString(SCO_DT_ALLOCATION) + "|" + ToString(SCO_DT_ALLOCATION) + "|" + SCO_PAY_FREQ_ALLOC + "|" + SCO_PAY_FREQ_ALLOC
                SCO_H_HR_CURRENCY.SCO_SYSSENTENCE = "SELECT @ID_CURRENCY = A.ID_CURRENCY, @SCO_BEHAV_CURR = '01', @SCO_IND_MAIN_CURR = A.SCO_IND_MAIN_CURR, @SCO_ID_HR = #MAX(A.SCO_ID_HR), @SCO_OR_HR_PERIOD = #MAX(A.SCO_OR_HR_PERIOD), @SCO_DT_END = #MAX(A.SCO_DT_PAY_END), @SCO_DT_START = #MAX(A.SCO_DT_PAY_START), @EX_TYPE = #MAX(A.EX_TYPE), @ID_ORGANIZATION = #MAX(A.ID_ORGANIZATION) FROM &SCO_AC_HR_PERIOD A WHERE A.SCO_ID_HR = ?(2,9,0) AND A.SCO_OR_HR_PERIOD = ?(6,2,0) AND A.SCO_DT_PAYMENT = ?(4,0,0) AND A.SCO_DT_ALLOCATION = ?(4,0,0) AND A.SCO_PAY_FREQ_ALLOC = ?(2,3,0) AND A.SCO_PAY_FREQ_PAYM = ?(2,3,0) GROUP BY A.ID_CURRENCY, A.SCO_IND_MAIN_CURR ORDER BY A.SCO_IND_MAIN_CURR DESC"
                SCO_H_HR_CURRENCY.Load_Blk()
                SCO_H_HR_CURRENCY.Begin()

            Endif


		If SCO_H_HR_CURRENCY.IsEOF()=1 then

			X=SCO_LEGAL_ENTITY.FindRegister("STD_ID_LEG_ENT",leg_ent,1)

			If X=M4_ERROR then 
				SCO_ERROR=1
				SetLog(-1,1,101,10,Leg_ent,STD_ID_HR,STD_OR_HR_PERIOD,DtAllocation,NmFrequency)
			Else
				SCO_LEGAL_ENTITY.Moveto(X)
				SCO_H_LE_CURRENCY.Begin()
				If SCO_H_LE_CURRENCY.IsEOF()=1 then
					SetLog(-1,1,101,11,leg_ent,DtAllocation,NmFrequency,STD_OR_HR_PERIOD,STD_ID_HR)
					SCO_ERROR=1
				Else
					Main=SCO_H_LE_CURRENCY.SCO_IND_MAIN_CURR

					If Main=0 Then

						SetLog(-1,1,101,12,leg_ent,DtAllocation,NmFrequency,STD_OR_HR_PERIOD,STD_ID_HR)
						SCO_ERROR=1
					ElseIf SCO_H_LE_CURRENCY.Count()>1 Then
						Main1=SCO_H_LE_CURRENCY[1].SCO_IND_MAIN_CURR
						If  Main=Main1 Then

							SetLog(-1,1,101,12,leg_ent,DtAllocation,NmFrequency,STD_OR_HR_PERIOD,STD_ID_HR)
							SCO_ERROR=1
						EndIf
					EndIf

					If SCO_ERROR <> 1 Then

						Output=SCO_HR_ROLE.SCO_INITROLE()

						If Output=M4_ERROR Then
							SCO_ERROR=1
						Else
							Do
								Output=SCO_CALCHRP(SCO_H_LE_CURRENCY.ID_CURRENCY,SCO_H_LE_CURRENCY.SCO_IND_MAIN_CURR,SCO_H_LE_CURRENCY.SCO_BEHAV_CURR,SCO_H_LE_CURRENCY.EX_TYPE)
								If Output=M4_ERROR Then
                                                     SetLog(-1,1,101,13,STD_ID_HR,STD_OR_HR_PERIOD,SCO_H_LE_CURRENCY.ID_CURRENCY,DtAllocation,NmFrequency)
								EndIf
								SCO_H_LE_CURRENCY.GONEXT()

							Until SCO_H_LE_CURRENCY.IsEOF() = 1 or SCO_ERROR = 1
						EndIf         
					EndIf

				Endif
			EndIf
		Else
			Main=SCO_H_HR_CURRENCY.SCO_IND_MAIN_CURR

			If Main=0 Then
				SetLog(-1,1,101,14,STD_ID_HR,STD_OR_HR_PERIOD,DtAllocation,NmFrequency)
				SCO_ERROR=1
			ElseIf SCO_H_HR_CURRENCY.Count()>1 Then
				Main1=SCO_H_HR_CURRENCY[1].SCO_IND_MAIN_CURR
				If  Main=Main1 Then
					SetLog(-1,1,101,14,STD_ID_HR,STD_OR_HR_PERIOD,DtAllocation,NmFrequency)
					SCO_ERROR=1
				EndIf
			EndIf

			If SCO_ERROR <> 1 Then
				Output=SCO_HR_ROLE.SCO_INITROLE() 

				If Output=M4_ERROR Then
					SCO_ERROR=1
				Else
					Do
						Output=SCO_CALCHRP(SCO_H_HR_CURRENCY.ID_CURRENCY,SCO_H_HR_CURRENCY.SCO_IND_MAIN_CURR,SCO_H_HR_CURRENCY.SCO_BEHAV_CURR,SCO_H_HR_CURRENCY.EX_TYPE)
						If Output=M4_ERROR Then
                                          SetLog(-1,1,101,13,STD_ID_HR,STD_OR_HR_PERIOD,SCO_H_HR_CURRENCY.ID_CURRENCY,DtAllocation,NmFrequency)
						EndIf

						SCO_H_HR_CURRENCY.GONEXT()
					Until SCO_H_HR_CURRENCY.IsEOF() = 1 or SCO_ERROR = 1
				EndIf
			EndIf
		Endif
	EndIf
EndIf

Return(0)
