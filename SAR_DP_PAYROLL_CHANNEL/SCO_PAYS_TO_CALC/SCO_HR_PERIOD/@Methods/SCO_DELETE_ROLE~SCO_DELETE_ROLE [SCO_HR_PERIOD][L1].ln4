'We have to calculate the write object of the innherited channel .

sWriteObj = GetNodeWriteObjectId("SCO_AUX_AC_HRROLE") 


SCO_SQL_ROLE="DELETE " + sWriteObj + " A WHERE A.SCO_ID_HR=@STD_ID_HR AND A.SCO_OR_HR_PERIOD=@STD_OR_HR_PERIOD AND A.SCO_DT_PAYMENT=@SCO_DT_PAYMENT AND A.SCO_DT_ALLOCATION=@SCO_DT_ALLOCATION AND A.SCO_PAY_FREQ_ALLOC=@SCO_PAY_FREQ_ALLOC AND A.SCO_PAY_FREQ_PAYM=@SCO_PAY_FREQ_PAYM AND A.ID_ORGANIZATION = @ID_ORGANIZATION"

RETURN(0)
