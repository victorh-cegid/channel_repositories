'This method does the calculation for the automatic revision of a HR in Period

'If it has Payment After Leaving 
If SCO_IS_PAL=1 Then
    Return(0)
Endif


actual_pay      = SCO_PAYS_TO_CALC.SCO_ACTUAL_PAY
dt_start        = SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC
dt_close_proc   = SCO_PAYS_TO_CALC.SCO_DT_CLOSE_PROC
dt_work         = SCO_PAYS_TO_CALC.SCO_DT_ALLOCATION
dt_start_period = STD_DT_START

current         = Getcurrent()

SCO_RUN_PAYS_REV.DestroyBlock()

SCO_DT_FILTER_REV_AC.Begin()

' When a TI with a SELECT MAX() doesn`t find any record insert a record with null values
'so in this case the condition isn`t   if ISEOF() 
If IsNULL(SCO_DT_FILTER_REV_AC.SCO_DT_FILTER)=1 THEN
	dt_filter=MINUS_INF
else
	dt_filter=SCO_DT_FILTER_REV_AC.SCO_DT_FILTER

endif

'Bug 0179811. SJR.*********************
'Se buscaran las modificaciones desde que se ha grabado la nomina por ultima vez y la fecha de fin de pago
If SCO_PAYS_TO_CALC.SCO_MNG_LOCKED_PAYS <> "0" Then
    dt_close_proc = SCO_PAYS_TO_CALC.SCO_DT_END_PAYM + 1
    If IsNull(SCO_DT_FILTER_REV_AC.DT_LAST_UPDATE) = M4_TRUE Then
        dt_filter = M4_MINUS_INF
    Else
        nYear = 0
        nMonth = 0
        nDay = 0
        DateToNumbers(SCO_DT_FILTER_REV_AC.DT_LAST_UPDATE,nYear,nMonth,nDay)
        dt_last_update = NumbersToDate(nYear,nMonth,nDay)
        dt_filter=Min(dt_last_update,SCO_DT_FILTER_REV_AC.SCO_DT_END_PAYM + 1)
    EndIf
EndIf
'*************************************

X=SCO_AUTO_REV_DATE!SCO_INTERMEDIATE_NODE.DESTROYBLOCK()

dt_rev=SCO_AUTO_REV_DATE!SCO_INTERMEDIATE_NODE.SCO_CALC_REV_DATE(STD_ID_HR,STD_OR_HR_PERIOD,dt_start,dt_filter,dt_close_proc,dt_start_period,dt_start,dt_work)

if dt_rev>SCO_PAYS_TO_CALC.SCO_DT_REV_PAY then
	return(0)
endif

If dt_rev < STD_DT_START Then
	dt_rev = STD_DT_START
EndIf

SCO_PAYS_TO_CALC.SCO_DT_FILTER=dt_filter
SCO_PAYS_TO_CALC.SCO_DT_REV=dt_rev

SCO_RUN_PAYS_REV.Load_blk()

num_pays=SCO_RUN_PAYS_REV.Count()

IF num_pays=0 then
	return(0)
ELSE

	FI_NORMAL=SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC
	FF_NORMAL=SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC
	FA_NORMAL=SCO_PAYS_TO_CALC.SCO_DT_ALLOCATION

	for I=0 to num_pays-1
		SCO_RUN_PAYS_REV.Moveto(I)
		arg1=SCO_PAYS_TO_CALC.SCO_DT_PAYMENT
		arg2=SCO_PAYS_TO_CALC.SCO_PAY_FREQ_PAYM
		arg3=SCO_PAYS_TO_CALC.SCO_PAY_TYPE_PAYM
		arg4=SCO_PAYS_TO_CALC.SCO_DT_START_PAYM
		arg5=SCO_PAYS_TO_CALC.SCO_DT_END_PAYM
		arg6=SCO_PAYS_TO_CALC.SCO_DAYS_NUM_PAYM
		arg7=SCO_PAYS_TO_CALC.SCO_DT_TRANSFER
		arg8=SCO_PAYS_TO_CALC.SCO_DT_CLOSE_PROC

		arg9=SCO_RUN_PAYS_REV.SCO_DT_ALLOCATION
		arg10=SCO_RUN_PAYS_REV.SCO_ID_PAY_FREQ_ALL
		arg11=SCO_RUN_PAYS_REV.SCO_ID_PAY_TYPE
		arg12=SCO_RUN_PAYS_REV.SCO_DT_START
		arg13=SCO_RUN_PAYS_REV.SCO_DT_END
		arg14=SCO_RUN_PAYS_REV.SCO_DAYS_NUMBER

		arg15=SCO_PAYS_TO_CALC.SCO_NM_PAY_FREQUENCY

		arg16=SCO_PAYS_TO_CALC.SCO_SAVEYTD

		arg17=STD_ID_HR
		arg18=STD_OR_HR_PERIOD

		FI=ARG12
		FF=ARG13
		SetStartDate(FI)
		SetEndDate(FF)
		SetRunDate(arg9)

		Output=SCO_PAYS_TO_CALC.SCO_CALC_PAYROLL_HRP(arg1,arg2,arg3,arg4,arg5,arg6,arg7,arg8,arg9,arg10,arg11,arg12,arg13,arg14,arg15,arg16,arg17,arg18)
		If Output=M4_ERROR then
			SetStartDate(FI_NORMAL)
			SetEndDate(FF_NORMAL)
			SetRunDate(FA_NORMAL)

			SCO_PAYS_TO_CALC.Moveto(actual_pay)
			moveto(current)
			Return(-1)
		EndIf

		SetStartDate(FI_NORMAL)
		SetEndDate(FF_NORMAL)
		SetRunDate(FA_NORMAL)

		SCO_PAYS_TO_CALC.Moveto(actual_pay)
		moveto(current)
	next

	Return(1)

ENDIF
