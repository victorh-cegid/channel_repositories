'Este método filtra por fechas los registros del histórico que se deben cargar 
'Si el periodo tiene pago después de la baja, los registros se filtran por fecha de imputación
'En cualquier otro caso, se filtran por la fecha SCO_DT_FILTER_BASE

If SCO_HR_PERIOD.SCO_IS_PAL = 1 Then
    SCO_FILTER_DATES_PAL_PARAM = ToString(SCO_HR_PERIOD.STD_DT_END,0) + "|" + ToString(SCO_HR_PERIOD.STD_DT_END,0)
Else
    SCO_FILTER_DATES_PAL_PARAM = ToString(SCO_HR_PERIOD.SCO_DT_FILTER_BASE,0) + "|" + ToString(SCO_HR_PERIOD.SCO_DT_FILTER_BASE,0)
Endif

filter = "FROM &SCO_H_HR_LEGAL_ENTITY A WHERE A.DT_END >= ?(4,0,0) AND A.DT_START <= ?(4,0,0)"

Return(filter)
