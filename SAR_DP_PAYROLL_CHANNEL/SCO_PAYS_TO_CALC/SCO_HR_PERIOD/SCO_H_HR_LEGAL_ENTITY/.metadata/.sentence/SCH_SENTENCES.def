# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_HR_LEGAL_ENTITY | 0 | 0 | 1 |  | 80 |  |  | #I = #I And #I = #I |  | SELECT @STD_N_LEG_ENT = B.STD_N_LEG_ENT FROM &SCO_H_HR_LEGAL_ENTITY A, STD_LEG_ENT B WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_LEG_ENT = B.STD_ID_LEG_ENT(+) AND (A.ID_ORGANIZATION = B.ID_ORGANIZATION And A.SCO_ID_LEG_ENT = B.STD_ID_LEG_ENT)
