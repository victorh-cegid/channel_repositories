# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_PROVEEDOR | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @DT_START = A.DT_START, @DT_END = A.DT_END, @STD_ID_HRM_VENDOR = A.STD_ID_HRM_VENDOR, @SAR_GASTO_ADM = A.SAR_GASTO_ADM FROM &SAR_H_PROVEEDOR A WHERE (A.DT_START <= @SAR_FECHA_FILTRO And ( A.DT_END >= @SAR_FECHA_FILTRO Or A.DT_END IS NULL ))
