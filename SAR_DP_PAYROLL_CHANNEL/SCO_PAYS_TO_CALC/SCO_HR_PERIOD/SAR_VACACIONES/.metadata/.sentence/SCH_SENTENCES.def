# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_VACACIONES | 0 | 0 | 1 |  | 80 |  |  | #I = '9' And #I <= ? And #I >= ? |  | SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @SCO_ID_INCIDENCE = A.SCO_ID_INCIDENCE, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @ID_ORGANIZATION = A.ID_ORGANIZATION FROM &SCO_REAL_TIME_PRD A WHERE (A.SCO_ID_INCIDENCE = '9' And A.SCO_DT_START <= @SAR_DT_ALLOC_END And A.SCO_DT_START >= @SAR_DT_ALLOC_START)
