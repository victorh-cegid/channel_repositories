# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_HABITUALES | 0 | 0 | 1 |  | 80 |  |  | #I >= ? |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SAR_ID_SYNONYM = A.SAR_ID_SYNONYM, @SAR_ID_DMD_COMPONENT = A.SAR_ID_DMD_COMPONENT, @SAR_ID_DMD = A.SAR_ID_DMD, @SAR_DT_PAGA_NORMAL = A.SAR_DT_PAGA_NORMAL, @SAR_ID_NODE = A.SAR_ID_NODE, @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @SAR_DT_VIGENCIA = A.SAR_DT_VIGENCIA, @SAR_DT_VIGEN_IMPUT = A.SAR_DT_VIGEN_IMPUT, @SAR_CANT_DE_OCURR = A.SAR_CANT_DE_OCURR, @SAR_PROCESADO = A.SAR_PROCESADO FROM &SAR_HABITUALES A WHERE (A.SAR_DT_VIGENCIA >= @SAR_P_PROCESO) ORDER BY A.STD_ID_HR ASC, A.SAR_DT_VIGENCIA ASC, A.SAR_DT_VIGEN_IMPUT ASC
