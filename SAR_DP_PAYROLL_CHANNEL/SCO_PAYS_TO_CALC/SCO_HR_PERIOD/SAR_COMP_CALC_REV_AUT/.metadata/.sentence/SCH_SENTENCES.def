# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_COMP_CALC_REV_AUT | 0 |  | 1 |  | 10 |  |  |  \n #I = #I  \n  And  \n  #I = ? \n  |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_DT_ALLOCATION = A.SCO_DT_ALLOCATION, @ID_CURRENCY = A.ID_CURRENCY, @SCO_DT_EXCHANGE = A.SCO_DT_EXCHANGE, @EX_TYPE = A.EX_TYPE, @SCO_DT_START_SLICE = A.SCO_DT_START_SLICE, @SCO_DT_PAYMENT = A.SCO_DT_PAYMENT, @SCO_PAY_FREQ_ALLOC = A.SCO_PAY_FREQ_ALLOC, @SCO_PAY_FREQ_PAYM = A.SCO_PAY_FREQ_PAYM, @ID_ORGANIZATION = A.ID_ORGANIZATION FROM &SCO_AC_HR_PERIOD A WHERE ((   A.SCO_DT_ALLOCATION = A.SCO_DT_PAYMENT   And   A.SCO_DT_ALLOCATION = @PAR_DT_ALLOCATION  )) 
