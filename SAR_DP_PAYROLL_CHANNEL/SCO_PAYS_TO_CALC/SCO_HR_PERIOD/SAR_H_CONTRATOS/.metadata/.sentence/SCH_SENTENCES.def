# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_CONTRATOS | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SAR_UNITS_PRU = B.SAR_UNITS_PRU, @SAR_ID_TIME_UNIT_PRU = B.SAR_ID_TIME_UNIT_PRU, @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @DT_START = A.DT_START, @DT_END = A.DT_END, @SAR_DT_END_PRUEBA = A.SAR_DT_END_PRUEBA FROM &SAR_H_CONTRATO A, SAR_X_CONTRATO B WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SAR_ID_CONTRATO = B.SAR_ID_CONTRATO(+) AND (A.DT_START <= @SAR_FECHA_FILTRO And ( A.DT_END >= @SAR_FECHA_FILTRO Or A.DT_END IS NULL ))
