# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_TIPO_SALARIO | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @ID_ORGANIZATION = A.ID_ORGANIZATION, @DT_START = A.DT_START, @DT_END = A.DT_END, @SAR_ID_TP_SALARIO = A.SAR_ID_TP_SALARIO FROM &SAR_H_HR_TP_SAL A WHERE (A.DT_START <= @SAR_FECHA_FILTRO And ( A.DT_END >= @SAR_FECHA_FILTRO Or A.DT_END IS NULL ))
