# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_PY_PROP_BASE_IMP | 0 | 0 | 1 |  | 80 |  |  | ( #I >= #F ( '2013-08-01' ) And #I <= #F ( '2013-08-31' ) And #I IN ( '1','4' ) ) |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_DT_ALLOCATION = A.SCO_DT_ALLOCATION, @SCO_DT_PAYMENT = A.SCO_DT_PAYMENT, @SCO_PAY_TYPE_PAYM = A.SCO_PAY_TYPE_PAYM, @SAR_BASE_IMPUESTO = A.SAR_BASE_IMPUESTO, @ID_CURRENCY = A.ID_CURRENCY, @SCO_DT_EXCHANGE = A.SCO_DT_EXCHANGE, @EX_TYPE = A.EX_TYPE, @SAR_IMPUESTO_TOTAL = A.SAR_IMPUESTO_TOTAL FROM &SAR_AC_HR_PERIOD A WHERE (( A.SCO_DT_PAYMENT >= #DATE ('2013-08-01' ) And A.SCO_DT_PAYMENT <= #DATE ('2013-08-31' ) And A.SCO_PAY_TYPE_PAYM IN ( '1','4' ) ))
