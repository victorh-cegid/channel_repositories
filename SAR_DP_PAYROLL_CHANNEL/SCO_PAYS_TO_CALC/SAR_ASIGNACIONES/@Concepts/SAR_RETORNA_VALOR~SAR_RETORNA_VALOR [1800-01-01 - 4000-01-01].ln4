BEGIN()
WHILE ISEOF() = FALSE
    IF ID_CURRENCY <> ARG_ID_CURRENCY THEN  
       DESDE = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_DT_DESDE)
       HASTA = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_DT_HASTA)
       VALOR = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_VALOR)
    ELSE
       DESDE = SAR_DT_DESDE
       HASTA = SAR_DT_HASTA
       VALOR = SAR_VALOR
    ENDIF

    IF STD_ID_ACT_DEP_TYPE = ARG_DEPENDENCIA AND SAR_ID_ZONA_SUB = ARG_ZONA_SUB AND TODOUBLE(DESDE) <= TODOUBLE(ARG_REMUN_FAM) AND TODOUBLE(HASTA) >= TODOUBLE(ARG_REMUN_FAM) THEN
       Return(VALOR)
    ENDIF
    GONEXT()
WEND
Return(0)
