# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_ASIGNACIONES | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @SAR_ID_ZONA_SUB = A.SAR_ID_ZONA_SUB, @SAR_DT_DESDE = A.SAR_DT_DESDE, @SAR_DT_HASTA = A.SAR_DT_HASTA, @STD_ID_ACT_DEP_TYPE = A.STD_ID_ACT_DEP_TYPE, @SAR_DT_START = A.SAR_DT_START, @SAR_DT_END = A.SAR_DT_END, @SAR_VALOR = A.SAR_VALOR, @ID_CURRENCY = A.ID_CURRENCY, @EX_TYPE = A.EX_TYPE FROM &SAR_HIST_ZONAS A WHERE (A.SAR_DT_START <= @SAR_DT_ALLOCATION And ( A.SAR_DT_END >= @SAR_DT_ALLOCATION Or A.SAR_DT_END IS NULL ))
