BEGIN()
WHILE ISEOF() = FALSE
    IF ID_CURRENCY <> ARG_ID_CURRENCY THEN  
       DESDE = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,ARG_FECHA,EX_TYPE,SAR_DT_DESDE)
       HASTA = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,ARG_FECHA,EX_TYPE,SAR_DT_HASTA)
    ELSE
       DESDE = SAR_DT_DESDE
       HASTA = SAR_DT_HASTA
    ENDIF
    IF SAR_DT_START <= ARG_FECHA AND SAR_DT_END >= ARG_FECHA THEN
        IF TOINT(DESDE) <= TOINT(ARG_BASE) AND TOINT(HASTA) >= TOINT(ARG_BASE) THEN
             Return(SAR_PORCENTAJE)
        ENDIF
    ENDIF
GONEXT()
WEND
Return(0)
