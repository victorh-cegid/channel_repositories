# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_DED_ESP_INC | 0 | 0 | 1 |  | 80 |  |  | \n #I <= ?  \n  And  \n  #I >= ? \n |  | SELECT @DT_START = A.DT_START, @SAR_HASTA = A.SAR_HASTA, @ID_CURRENCY = A.ID_CURRENCY, @EX_TYPE = A.EX_TYPE, @CUR_DATE = A.CUR_DATE, @DT_END = A.DT_END, @SAR_IMPORTE = A.SAR_IMPORTE, @SAR_TRAMO = A.SAR_TRAMO, @SAR_COMMENT = A.SAR_COMMENT FROM &SAR_DED_ESP_INC A WHERE (\n A.DT_START <= @PROP_FECHA  \n  And  \n  A.DT_END >= @PROP_FECHA \n) ORDER BY A.SAR_TRAMO ASC, A.SAR_HASTA ASC
