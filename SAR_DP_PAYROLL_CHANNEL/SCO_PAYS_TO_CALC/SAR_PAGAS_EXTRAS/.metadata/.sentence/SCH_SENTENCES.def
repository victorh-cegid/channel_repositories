# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_PAGAS_EXTRAS | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) And #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SAR_ID_CONVENIO = A.SAR_ID_CONVENIO, @SAR_ID_PAGA_EXTRA = A.SAR_ID_PAGA_EXTRA, @SCO_ID_PAY_FREQUENCY = A.SCO_ID_PAY_FREQUENCY, @DT_START = A.DT_START, @DT_END = A.DT_END, @SAR_MES = A.SAR_MES, @SAR_DIA = A.SAR_DIA, @SAR_ORDEN = A.SAR_ORDEN, @SAR_DIA_INI_DEV = E.SAR_DIA_INI_DEV, @SAR_MES_INI_DEV = E.SAR_MES_INI_DEV, @SAR_A_ATRAS_IDV = E.SAR_A_ATRAS_IDV, @SAR_DIA_FIN_DEV = E.SAR_DIA_FIN_DEV, @SAR_MES_FIN_DEV = E.SAR_MES_FIN_DEV, @SAR_A_ATRAS_FDV = E.SAR_A_ATRAS_FDV, @SAR_PORCENTAJE = E.SAR_PORCENTAJE FROM &SAR_CONV_PAGAS_EXT A, SAR_PAGAS_EXTRAS D, SAR_DEF_PAGAS_EXT E WHERE A.ID_ORGANIZATION = D.ID_ORGANIZATION(+) AND A.SAR_ID_PAGA_EXTRA = D.SAR_ID_PAGA_EXTRA(+) AND E.ID_ORGANIZATION(+) = D.ID_ORGANIZATION AND E.SAR_ID_PAGA_EXTRA(+) = D.SAR_ID_PAGA_EXTRA AND (A.DT_START <= @SAR_DT_ALLOCATION And ( A.DT_END >= @SAR_DT_ALLOCATION Or A.DT_END IS NULL ) And E.DT_START <= @SAR_DT_ALLOCATION And ( E.DT_END >= @SAR_DT_ALLOCATION Or E.DT_END IS NULL ))
