BEGIN()
WHILE ISEOF() = FALSE
    IF ID_CURRENCY <> ARG_ID_CURRENCY THEN  
       DESDE = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOC_END,EX_TYPE,SAR_DT_DESDE)
       HASTA = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOC_END,EX_TYPE,SAR_DT_HASTA)
    ELSE
       DESDE = SAR_DT_DESDE
       HASTA = SAR_DT_HASTA
    ENDIF   
    IF SAR_ID_TIPO_ANSSAL = ARG_TIPO AND TOINT(DESDE) <= TOINT(ARG_BASE) AND TOINT(HASTA) >= TOINT(ARG_BASE) THEN
        Return(SAR_VALOR)
    ENDIF
    GONEXT()
WEND
Return(0)
