# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_ANSSAL | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @SAR_DT_DESDE = A.SAR_DT_DESDE, @SAR_DT_HASTA = A.SAR_DT_HASTA, @SAR_ID_TIPO_ANSSAL = A.SAR_ID_TIPO_ANSSAL, @DT_START = A.DT_START, @DT_END = A.DT_END, @SAR_VALOR = A.SAR_VALOR, @ID_CURRENCY = A.ID_CURRENCY, @EX_TYPE = A.EX_TYPE FROM &SAR_HIST_ANSSAL A WHERE (A.DT_START <= @SAR_DT_ALLOC_END And ( A.DT_END >= @SAR_DT_ALLOC_END Or A.DT_END IS NULL ))
