for I=0 to SCO_NUM_PAYS-1
	Moveto(I) 

	FI=SCO_DT_START_ALLOC
	FF=SCO_DT_END_ALLOC
	SetStartDate(FI)
	SetEndDate(FF)
	SetRunDate(SCO_DT_ALLOCATION)

	SCO_ACTUAL_PAY = I

	if SCO_AUTO_REV = 1 then
		Output=SCO_CALCREV_PAY()
		If Output=M4_ERROR Then
			Return(-1)

		EndIf
	endif

	Output=SCO_CALCPAY()
	If Output=M4_ERROR Then
		Return(-1)
	EndIf

	SCO_NUM_PAYS_CALC = SCO_ACTUAL_PAY + 1

next
End()
GONEXT()

Return (0)
