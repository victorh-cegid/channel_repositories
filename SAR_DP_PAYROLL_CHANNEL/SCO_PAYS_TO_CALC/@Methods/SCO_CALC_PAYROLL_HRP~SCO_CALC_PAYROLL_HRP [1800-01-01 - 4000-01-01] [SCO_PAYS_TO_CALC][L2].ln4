x=FindRegister("SCO_DT_ALLOCATION",dt_alloc,1,"SCO_DT_PAYMENT",dt_pay,1,"SCO_PAY_FREQ_ALLOC",id_pay_freq_alloc,1,"SCO_PAY_FREQ_PAYM",id_pay_freq_paym,1)
if x=-1 then

	AddRegister()
	Code = "Return("+GetChannelId()+"!GETPROPERTY("+CHR(DOUBLE_QUOTE)+"ID_ORGANIZATION"+CHR(DOUBLE_QUOTE)+"))"
	ID_ORGANIZATION = clcExecuteLN4JIT (Code)
	SCO_DT_PAYMENT=dt_pay
	SCO_PAY_FREQ_PAYM=id_pay_freq_paym
	SCO_PAY_TYPE_PAYM=id_pay_type_paym
	SCO_DT_START_PAYM=dt_start_paym
	SCO_DT_END_PAYM=dt_end_paym
	SCO_DAYS_NUM_PAYM=days_number_paym
	SCO_DT_TRANSFER=dt_transfer
	SCO_DT_CLOSE_PROC=dt_close_proc

	SCO_DT_ALLOCATION=dt_alloc
	SCO_PAY_FREQ_ALLOC=id_pay_freq_alloc
	SCO_PAY_TYPE_ALLOC=id_pay_type_alloc
	SCO_DT_START_ALLOC=dt_start_alloc
	SCO_DT_END_ALLOC=dt_end_alloc
	SCO_DAYS_NUM_ALLOC=days_number_alloc
	SCO_NM_PAY_FREQUENCY=nm_pay_frequency

	IF SCO_AUTO_REV=0 then
		SCO_SAVEYTD=saveYTD
	endif

	SCO_NUM_HR_PERIOD=1
else
	moveto(x)
	
endif

SCO_HR_PERIOD.SYSSENTENCE="FROM &STD_HR_PERIOD A WHERE A.STD_ID_HR='" + id_hr +  "' AND A.STD_OR_HR_PERIOD=" + tostring(or_hr)
SCO_HR_PERIOD.LOAD_BLK()
SCO_HR_PERIOD.BEGIN()
If SCO_HR_PERIOD.IsEOF()=1 Then
	SetLog(0,1,101,19,id_hr,or_hr,dt_alloc,nm_pay_frequency)
	RETURN(0)
EndIf

If SCO_AUTO_REV<>1 then
	Output=SCO_CALCINIT()
	If Output=M4_ERROR Then
		Return(-1)
	endif

	//Miro el número de errores que tengo antes de empezar el cálculo.
	SCO_HR_PAY_ERROR.SCO_SET_ERROR_POSITION()

	//Antes de calcular se comprueba que no tiene errores anteriores que impedirían continuar el cálculo.
	If SCO_HR_PAY_ERROR.Count()<>0 Then

            //No se va a calcular el periodo %0:n del empleado %1:s en la nómina %2:s de pago %3:d
            //e imputación %4:d porque hay errores en nóminas anteriores. 
            //Debe solucionar esas nóminas erroneas antes de ejecutar esta nómina.
            
		SetLog (-1,1,101,46,tostring(or_hr),id_hr,nm_pay_frequency,dt_pay,dt_alloc)
		SCO_HR_PERIOD.SCO_ERROR = 1
		bExistError = TRUE

	EndIf

endif
Output=SCO_PAYINIT()
If Output=M4_ERROR Then
	SetLog(-1,1,101,2,dt_alloc,nm_pay_frequency)
	SCO_HR_PERIOD.SCO_ERROR=1
	Return(-1)
Else
	'Output=SCO_HR_PERIOD.SCO_CALCHRP_CURRENCY()
        Output=SCO_HR_PERIOD.SCO_CONTROL_ERRORS()
        
	If SCO_AUTO_REV<>1 then
		Output = SCO_HR_PAY_ERROR.SCO_MANAGE_ERRORS(Output)
	Endif

	If Output=M4_ERROR Then
		SCO_HR_PERIOD.SCO_ERROR=1
		Return(-1)
	Else
		Output=SCO_PAY_END()
		If Output=M4_ERROR Then
			SetLog(-1,1,101,7,dt_alloc,nm_pay_frequency)
			SCO_HR_PERIOD.SCO_ERROR=1
			Return(-1)
		EndIf
		if SCO_AUTO_REV<>1 then
			SCO_CALC_END()
		endif
	Endif
Endif
if SCO_AUTO_REV=1 then
	SCO_HR_PERIOD.DESTROYBLOCK()
endif
return(0)
