// We order the pays in order to made easier the searchings
Sort(2)
Begin()
If IsEOF() = True Then
	Return(0)
Else
	//Actualizo la check del lanzador que me indica si el calculo es solo para empleado erroneos o no.
	If IsNull(SCO_JS_HR_PERIOD.SYSSENTENCE_ERROR) = FALSE Then
		SCO_JS_HT_PAYS.SCO_EXE_ERROR_EMP = 1
	Else
		SCO_JS_HT_PAYS.SCO_EXE_ERROR_EMP = 0
	EndIf

	SCO_JS_HT_PAYS.Begin()
	If SCO_JS_HT_PAYS.IsEOF()= True Then
// There aren't open pays defined
		SetLog(1,1,101,44)
		Return(0)
	EndIf
	numpays = Count() -1
	Do

// We search for the right ID_ORGANIZATION
		If SCO_JS_HT_PAYS.ID_ORGANIZATION <> ID_ORGANIZATION Then
			SCO_JS_HT_PAYS.GoNext()
		Else

// We execute this part for every different payment date we found
			old_org=ID_ORGANIZATION
			new_org=ID_ORGANIZATION
			continuepay = True
			While (SCO_JS_HT_PAYS.IsEOF() <> True And continuepay = True And old_org = new_org)
	// We search for the pay selected in the node SCO_HT_PAYS2 in order to check it.
				If  (SCO_DT_PAYMENT > SCO_JS_HT_PAYS.SCO_DT_ACCRUED Or (SCO_DT_PAYMENT = SCO_JS_HT_PAYS.SCO_DT_ACCRUED And SCO_PAY_FREQ_PAYM<> SCO_JS_HT_PAYS.SCO_ID_PAY_FREQUENCY)) Then
	// We don't find the pay
					SCO_JS_HT_PAYS.GoNext()
				ElseIf (SCO_DT_PAYMENT = SCO_JS_HT_PAYS.SCO_DT_ACCRUED And SCO_PAY_FREQ_PAYM= SCO_JS_HT_PAYS.SCO_ID_PAY_FREQUENCY) Then
	// We have found the pay so we have to break the loop 
	// and we have to work with this pay
					continuepay = False
	// We check the normal pay
					SCO_JS_HT_PAYS.SCO_SEL_PAY = 1
	// We check the pay filter
					If IsNull(SCO_JS_HR_PERIOD.SCO_ID_FILTER) = False Then
						SCO_JS_PAYS_FILTERS.Begin()
						PosFilter = SCO_JS_PAYS_FILTERS.FindRegister("SCO_ID_PAYFTR",SCO_JS_HR_PERIOD.SCO_ID_FILTER,Equal)
						If PosFilter <> -1 Then
							SCO_JS_PAYS_FILTERS.MoveTo(PosFilter)
							SCO_JS_PAYS_FILTERS.SCO_SEL_FILTER = 1
						Else
							SetLog(1,1,101,43,SCO_JS_HR_PERIOD.SCO_ID_FILTER)
						EndIf
					EndIf
	// We are in the normal pay, we have to found its first revision
					If SCO_DT_PAYMENT = SCO_DT_ALLOCATION Then
						GoNext()
					EndIf
					If (SCO_JS_HT_PAYS.SCO_EXE_MODE = 2 Or SCO_JS_HT_PAYS.SCO_EXE_MODE = 3) Then
	// We are in an option of revision
	// We are in a revision pay, we have to search it in the revision node
						SCO_HT_PAYS_REV.Begin()
						i = GetCurrent()
	// With this option, we only have to found the oldest pay selected (for the same payment date).
						While i < numpays
							If SCO_JS_PAYS_TO_CALC[i].SCO_DT_PAYMENT = SCO_JS_PAYS_TO_CALC[I+1].SCO_DT_PAYMENT and SCO_JS_PAYS_TO_CALC[I].SCO_PAY_FREQ_PAYM = SCO_JS_PAYS_TO_CALC[i+1].SCO_PAY_FREQ_PAYM and SCO_JS_PAYS_TO_CALC[I].ID_ORGANIZATION = SCO_JS_PAYS_TO_CALC[i+1].ID_ORGANIZATION Then
								GoNext()
								i = i + 1
							Else
								i =  numpays
							EndIf
					WEnd
	// We have to check the pay in the revision node
						continuepayrev = True
						While SCO_HT_PAYS_REV.IsEOF() <> True And continuepayrev = True
							If (SCO_DT_ALLOCATION < SCO_HT_PAYS_REV.SCO_DT_ACCRUED) Then
	// We don't found the revision pay
								SCO_HT_PAYS_REV.GoNext()
							ElseIf (SCO_DT_ALLOCATION = SCO_HT_PAYS_REV.SCO_DT_ACCRUED) Then
	// We have found the revision pay so we have to break the loop
								continuepayrev = False
	// We select the revision pay
								SCO_HT_PAYS_REV.SCO_SEL_PAY = 1
							Else
	// The revision pay doesn't exists, so we have to break the loop
								SetLog(1,1,101,42,SCO_NM_PAY_FREQUENCY,SCO_DT_ALLOCATION)
								continuepayrev = False
							EndIf
						WEnd
	// We have to continue with the next payment date
						GoNext()
					ElseIf (SCO_JS_HT_PAYS.SCO_EXE_MODE = 4 Or SCO_JS_HT_PAYS.SCO_EXE_MODE = 5) Then
	// We are in other option of revision
	// We are in the revision pay
						SCO_HT_PAYS_REV.Begin()
						i = GetCurrent()
						continuepayrev = True
						While i <= numpays And continuepayrev = True
	// We execute this for each different allocation date for the same payment date
							continuerev = True
							While (SCO_HT_PAYS_REV.IsEOF() <> True And continuerev = True)
								If (SCO_DT_ALLOCATION < SCO_HT_PAYS_REV.SCO_DT_ACCRUED) Then
	// We don't found the revision pay
									SCO_HT_PAYS_REV.GoNext()
								ElseIf (SCO_DT_ALLOCATION = SCO_HT_PAYS_REV.SCO_DT_ACCRUED) Then
	// We have found the revision pay, so we have to break the loop
									continuerev = False
	// we chech the revision pay
									SCO_HT_PAYS_REV.SCO_SEL_PAY = 1
									SCO_HT_PAYS_REV.GoNext()
								Else
	// The revision pay that we are looking for doesn't exist, so we have to break the loop
									SetLog(1,1,101,42,SCO_NM_PAY_FREQUENCY,SCO_DT_ALLOCATION)
									continuerev = False
								EndIf
							WEnd
							If i < numpays Then
								If SCO_JS_PAYS_TO_CALC[i].SCO_DT_PAYMENT <> SCO_JS_PAYS_TO_CALC[I+1].SCO_DT_PAYMENT or SCO_JS_PAYS_TO_CALC[I].SCO_PAY_FREQ_PAYM <> SCO_JS_PAYS_TO_CALC[i+1].SCO_PAY_FREQ_PAYM or SCO_JS_PAYS_TO_CALC[I].ID_ORGANIZATION <> SCO_JS_PAYS_TO_CALC[i+1].ID_ORGANIZATION Then
	// If the next pay has different payment date, we have to break the loop
									continuepayrev = False
								EndIf
							EndIf
							i = i + 1
							GoNext()
						WEnd
					EndIf
				Else
	// The pay doesn't exists, so we have to break the loop
					SetLog(1,1,101,41,SCO_NM_PAY_FREQUENCY,SCO_DT_PAYMENT)
					continuepay = False
					GoNext()
				EndIf
				If IsEOF()= False Then
					new_org=ID_ORGANIZATION
				Endif
			WEnd
			If SCO_JS_HT_PAYS.IsEOF() <> True Then
				// We have to continue with the next pay with different payment date
				SCO_JS_HT_PAYS.GoNext()
			Else
				// There arent pays to process
				Return(0)
			EndIf
		Endif  
	Until IsEOF() = True
// We order the pays as we need to execute the payroll
	Sort(1)
EndIf
Return(0)
