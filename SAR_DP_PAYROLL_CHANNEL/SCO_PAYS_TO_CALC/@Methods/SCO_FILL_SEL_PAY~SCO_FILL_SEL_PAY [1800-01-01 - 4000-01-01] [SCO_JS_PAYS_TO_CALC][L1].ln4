If SCO_JS_HT_PAYS.SME_IND_CLC_SDI = 1 Then     ' Cálculo del SDI
    Call("","SME_FILL_SEL_PAY_SDI")
    Return(0)
EndIf


DestroyBlock()

SetStartDate(MINUS_INF)
SetEndDate(PLUS_INF)

SCO_JS_HT_PAYS.Begin()
if SCO_JS_HT_PAYS.IsEOF()=1 then
	SetLog(-1,1,101,3)
	Return(-1)
else

	If SCO_JS_HT_PAYS.SCO_EXE_ERROR_EMP = 1 Then
		SCO_JS_HR_PERIOD.SCO_ERROR_SELECT()
	Else
		SCO_JS_HR_PERIOD.SYSSENTENCE_ERROR = NullValue()
	EndIf

	Do
		if SCO_JS_HT_PAYS.SCO_SEL_PAY=1 then

			selpay = 0 
			IF SCO_JS_HT_PAYS.SCO_EXE_MODE<>2 and SCO_JS_HT_PAYS.SCO_EXE_MODE<>4 then
				AddRegister()
				SCO_DT_PAYMENT = SCO_JS_HT_PAYS.SCO_DT_ACCRUED
				SCO_DT_ALLOCATION = SCO_JS_HT_PAYS.SCO_DT_ACCRUED
				SCO_PAY_FREQ_ALLOC = SCO_JS_HT_PAYS.SCO_ID_PAY_FREQUENCY
				SCO_PAY_TYPE_ALLOC = SCO_JS_HT_PAYS.SCO_ID_PAY_TYPE
				SCO_PAY_FREQ_PAYM = SCO_JS_HT_PAYS.SCO_ID_PAY_FREQUENCY
				SCO_PAY_TYPE_PAYM = SCO_JS_HT_PAYS.SCO_ID_PAY_TYPE
				SCO_DT_START_ALLOC = SCO_JS_HT_PAYS.SCO_DT_START
				SCO_DT_END_ALLOC = SCO_JS_HT_PAYS.SCO_DT_END
				SCO_DT_START_PAYM = SCO_JS_HT_PAYS.SCO_DT_START
				SCO_DT_END_PAYM = SCO_JS_HT_PAYS.SCO_DT_END
				SCO_DAYS_NUM_ALLOC = SCO_JS_HT_PAYS.SCO_DAYS_NUMBER
				SCO_DAYS_NUM_PAYM = SCO_JS_HT_PAYS.SCO_DAYS_NUMBER
				SCO_DT_TRANSFER = SCO_JS_HT_PAYS.SCO_DT_XMIT_DAY
				SCO_DT_CLOSE_PROC=SCO_JS_HT_PAYS.SCO_DT_CUTOFF
				SCO_NM_PAY_FREQUENCY = SCO_JS_HT_PAYS.SCO_NM_PAY_FREQUENCY
                        ID_ORGANIZATION = SCO_JS_HT_PAYS.ID_ORGANIZATION
                        
				SCO_JS_PAYS_FILTERS.SCO_SELECT_FILTER()

			endif

			IF (SCO_JS_HT_PAYS.SCO_EXE_MODE=2 OR SCO_JS_HT_PAYS.SCO_EXE_MODE=3 OR SCO_JS_HT_PAYS.SCO_EXE_MODE=4 OR SCO_JS_HT_PAYS.SCO_EXE_MODE=5) then
				SCO_HT_PAYS_REV.Begin()
				if SCO_HT_PAYS_REV.IsEOF()=1 then
					SetLog(-1,1,101,4)
					Return(-1)
				else 
				
					Do

						if (SCO_HT_PAYS_REV.SCO_SEL_PAY=1 AND (SCO_JS_HT_PAYS.SCO_EXE_MODE=2 OR SCO_JS_HT_PAYS.SCO_EXE_MODE=3))then

							DO	

								selpay = 1
								AddRegister()
								SCO_DT_PAYMENT = SCO_JS_HT_PAYS.SCO_DT_ACCRUED 
								SCO_DT_ALLOCATION = SCO_HT_PAYS_REV.SCO_DT_ACCRUED
								SCO_PAY_FREQ_ALLOC = SCO_HT_PAYS_REV.SCO_ID_PAY_FREQUENCY
								SCO_PAY_TYPE_ALLOC = SCO_HT_PAYS_REV.SCO_ID_PAY_TYPE
								SCO_PAY_FREQ_PAYM = SCO_JS_HT_PAYS.SCO_ID_PAY_FREQUENCY
								SCO_PAY_TYPE_PAYM = SCO_JS_HT_PAYS.SCO_ID_PAY_TYPE
								SCO_DT_START_ALLOC = SCO_HT_PAYS_REV.SCO_DT_START
								SCO_DT_END_ALLOC = SCO_HT_PAYS_REV.SCO_DT_END
								SCO_DT_START_PAYM = SCO_JS_HT_PAYS.SCO_DT_START
								SCO_DT_END_PAYM = SCO_JS_HT_PAYS.SCO_DT_END
								SCO_DAYS_NUM_ALLOC = SCO_HT_PAYS_REV.SCO_DAYS_NUMBER
								SCO_DAYS_NUM_PAYM = SCO_JS_HT_PAYS.SCO_DAYS_NUMBER
								SCO_DT_TRANSFER = SCO_JS_HT_PAYS.SCO_DT_XMIT_DAY
								SCO_DT_CLOSE_PROC=SCO_JS_HT_PAYS.SCO_DT_CUTOFF
								SCO_NM_PAY_FREQUENCY = SCO_JS_HT_PAYS.SCO_NM_PAY_FREQUENCY
                                                ID_ORGANIZATION = SCO_JS_HT_PAYS.ID_ORGANIZATION
                          
								SCO_JS_PAYS_FILTERS.SCO_SELECT_FILTER()

								SCO_HT_PAYS_REV.GOPREVIOUS()

							UNTIL  SCO_HT_PAYS_REV.ISEOF()=1

						Elseif SCO_HT_PAYS_REV.SCO_SEL_PAY=1 Then

							selpay = 1
							AddRegister()
							SCO_DT_PAYMENT = SCO_JS_HT_PAYS.SCO_DT_ACCRUED 
							SCO_DT_ALLOCATION = SCO_HT_PAYS_REV.SCO_DT_ACCRUED
							SCO_PAY_FREQ_ALLOC = SCO_HT_PAYS_REV.SCO_ID_PAY_FREQUENCY
							SCO_PAY_TYPE_ALLOC = SCO_HT_PAYS_REV.SCO_ID_PAY_TYPE
							SCO_PAY_FREQ_PAYM = SCO_JS_HT_PAYS.SCO_ID_PAY_FREQUENCY
							SCO_PAY_TYPE_PAYM = SCO_JS_HT_PAYS.SCO_ID_PAY_TYPE
							SCO_DT_START_ALLOC = SCO_HT_PAYS_REV.SCO_DT_START
							SCO_DT_END_ALLOC = SCO_HT_PAYS_REV.SCO_DT_END
							SCO_DT_START_PAYM = SCO_JS_HT_PAYS.SCO_DT_START
							SCO_DT_END_PAYM = SCO_JS_HT_PAYS.SCO_DT_END
							SCO_DAYS_NUM_ALLOC = SCO_HT_PAYS_REV.SCO_DAYS_NUMBER
							SCO_DAYS_NUM_PAYM = SCO_JS_HT_PAYS.SCO_DAYS_NUMBER
							SCO_DT_TRANSFER = SCO_JS_HT_PAYS.SCO_DT_XMIT_DAY
							SCO_DT_CLOSE_PROC=SCO_JS_HT_PAYS.SCO_DT_CUTOFF
							SCO_NM_PAY_FREQUENCY = SCO_JS_HT_PAYS.SCO_NM_PAY_FREQUENCY
                                          ID_ORGANIZATION = SCO_JS_HT_PAYS.ID_ORGANIZATION
                                            
							SCO_JS_PAYS_FILTERS.SCO_SELECT_FILTER()

						Endif
						SCO_HT_PAYS_REV.GONEXT()

					Until SCO_HT_PAYS_REV.IsEOF()=1
					If selpay = 0 Then
						Return(M4_ERROR)
					EndIf

				Endif
			Endif
		Endif
		SCO_JS_HT_PAYS.GONEXT()

	Until SCO_JS_HT_PAYS.IsEOF()=1

endif
X=Sort(1) 

return(0)
