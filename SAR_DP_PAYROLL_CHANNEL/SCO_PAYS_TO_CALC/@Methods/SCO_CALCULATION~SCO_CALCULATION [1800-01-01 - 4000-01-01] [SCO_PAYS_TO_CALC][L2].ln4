SetStartDate(MINUS_INF)
SetEndDate(PLUS_INF)

SCO_SAVEYTD      = SCO_HT_PAYS.SCO_SAVEYTD
SCO_STEP_BY_STEP = SCO_HT_PAYS.SCO_STEP_BY_STEP

SCO_AUX_AC_HRPERIOD.DestroyBlock()
SCO_AUX_AC_HRROLE.DestroyBlock()

SCO_NUM_PAYS = Count()

Output=SCO_CALCINIT()

If Output=M4_ERROR then
	End()
	GONEXT()
	SCO_CALC_END()
	Return(-1)
endif

if SCO_STEP_BY_STEP = 1 then
	SCO_PAYS_TO_CALC.Begin()

	SCO_ACTUAL_PAY=0

	IF SCO_AUTO_REV=1 then
		Output=SCO_CALCREV_PAY()
		If Output=M4_ERROR then
			End()
			GONEXT()
			SCO_CALC_END()
			Return(-1)
		endif

	endif

	FI=SCO_DT_START_ALLOC
	FF=SCO_DT_END_ALLOC
	SetStartDate(FI)
	SetEndDate(FF)

	SetRunDate(SCO_DT_ALLOCATION)

	Output=SCO_PAYS_TO_CALC.SCO_PAYINIT()
	If Output=M4_ERROR then
		SetLog(-1,1,101,2,SCO_DT_ALLOCATION,SCO_NM_PAY_FREQUENCY)
		End()
		GONEXT()
		SCO_CALC_END()
		Return(-1)
	endif

	SCO_HR_PERIOD.SCO_CALC_FIRST()

else

	Output=SCO_CALCALLPAYS()  
	If Output=M4_ERROR then
		End()
		GONEXT()
		SCO_CALC_END()
		Return(-1)
	endif

	SCO_CALC_END()
endif

return(0)
