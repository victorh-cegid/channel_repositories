SetStartDate(MINUS_INF)
SetEndDate(PLUS_INF)

SCO_AUX_AC_HRPERIOD.SCO_FLAG_LOAD = 1 
SCO_AUX_AC_HRROLE.SCO_FLAG_LOAD = 1 

SCO_NUM_PAYS = Count()
If SCO_NUM_PAYS = 0 Then return(0)

Output=SCO_CALCINIT()

If Output=M4_ERROR Then
	SCO_CALC_END()
	Return(-1)
EndIf

Output=SCO_CALCALLPAYS()
If Output=M4_ERROR Then
	SCO_CALC_END()
	Return(-1)
EndIf
  
SCO_CALC_END()

return(0)
