'Number of periods calculation
If SCO_HT_PAYS.SCO_FROM_JS <> 1 Then
    SCO_HR_PERIOD_COUNT.Begin()
    'SCO_NUM_HR_PERIOD=SCO_HR_PERIOD_COUNT.SCO_NUM_HR_PERIOD
Endif
    
FI=SCO_DT_START_ALLOC
FF=SCO_DT_END_ALLOC
SetStartDate(FI)
SetEndDate(FF)
SetRunDate(SCO_DT_ALLOCATION)

slice=SCO_PAYS_TO_CALC.SCO_SLICE_MODE

'Don´t put this line if you need to calculate a back pay
SCO_APPLYVAL_PERIOD!PERIODS.DESTROYBLOCK()

SCO_APPLYVAL_PERIOD!SCO_INTERMEDIATE_NODE_PERIOD.SETPERIOD(SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC,SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC,SCO_PAYS_TO_CALC.SCO_DT_ALLOCATION,slice)     
SCO_APPLYVAL_PERIOD!SCO_INTERMEDIATE_NODE_PERIOD.SCO_SETDATES_COR(SCO_PAYS_TO_CALC.SCO_DT_END_PAYM)
SCO_APPLYVAL_PERIOD!SCO_INTERMEDIATE_NODE_PERIOD.SCO_SET_PK_PAY(SCO_DT_ALLOCATION,SCO_DT_PAYMENT,SCO_PAY_FREQ_ALLOC,SCO_PAY_FREQ_PAYM)

'Don´t put this line if you need to calculate a back pay
SCO_APPLYVAL2_I!PERIODS.DESTROYBLOCK()

SCO_APPLYVAL2_I!SCO_APPLYVAL2.SETPERIODS(SCO_PAYS_TO_CALC.SCO_DT_START_ALLOC,SCO_PAYS_TO_CALC.SCO_DT_END_ALLOC,SCO_PAYS_TO_CALC.SCO_DT_ALLOCATION,slice)     
SCO_APPLYVAL2_I!SCO_APPLYVAL2.SCO_SETDATES_COR(SCO_PAYS_TO_CALC.SCO_DT_END_PAYM)
SCO_APPLYVAL2_I!SCO_APPLYVAL2.SCO_SET_PK_PAY(SCO_DT_ALLOCATION,SCO_DT_PAYMENT,SCO_PAY_FREQ_ALLOC,SCO_PAY_FREQ_PAYM)
      
'With this code, the load of the node SCO_REL_WUNIT is made only once in a pay
if (SCO_AUTO_REV=1 AND SCO_DT_ALLOCATION = SCO_DT_PAYMENT) then
    SCO_AUTO_REV_DATE!PERIODS.DESTROYBLOCK()
    'We set start date=M4_MINUS_INF, end date=start date of the pay, work date=dt_allocation
    'We work with Slice Mode ON
    dStart = M4_MINUS_INF
    dEnd = SCO_DT_START_ALLOC
    dWork = SCO_DT_ALLOCATION
    iSliceOn = 1
    SCO_AUTO_REV_DATE!SCO_INTERMEDIATE_NODE.SETPERIOD(dStart,dEnd,dWork,iSliceOn)
endif
    
SWP_NODES_AC_READ.SCO_PREPARE_AC_TI()
	
ExecuteGroup("1")
//El texto del error es responsabilidad del concepto en el que se produce
If SCO_ERROR..SysTotalSlices(M4_TOTAL_MAX) = 1 Then
    Return(-1)
EndIf
    
     
SCO_AUX_AC_HRPERIOD.CopyRegister("","SCO_PAYS_TO_CALC",-1,SCOPE_REGISTER,SCOPE_NODE+TYPE_FIELD+TYPE_PROPERTY)
SCO_AUX_AC_HRROLE.CopyRegister("","SCO_PAYS_TO_CALC",-1,SCOPE_REGISTER,SCOPE_NODE+TYPE_FIELD)

Return(0)
