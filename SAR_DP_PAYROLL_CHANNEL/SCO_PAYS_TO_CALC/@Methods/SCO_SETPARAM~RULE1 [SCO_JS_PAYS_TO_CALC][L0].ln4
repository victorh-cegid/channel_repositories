NUM_ITEMS = 23

DLM_ITEM = ";"
// Se utiliza el separador ## en vez de # porque en los filtros con fechas se utiliza
// este caracter y puede provocar fallos.
DLM_REG = "##"      //Separador de pagas de la misma sociedad
dlm_desc = "@@"     //Separador del nombre de la sociedad
dlm_exe = "$$"      //marca de tipo de calculo (normal, retroactivo ...)
dlm_soc = "||"      //marca de fin de datos de una sociedad

// Fixed values
SCO_JS_HT_PAYS.SCO_FROM_JS = 1
SCO_SAVEYTD = 1
SCO_STEP_BY_STEP = 0

ind_sdi = 0

exebrk = StrIn(PARAM,dlm_exe)
str = Mid(PARAM,exebrk + 2,Length(PARAM) - exebrk - 1)  //Toda la cadena desde el primer $$

socbrk = StrIn(str,dlm_soc)
If socbrk = -1 Then
    str_exe = str
Else    
    str_exe = Mid(str,0,socbrk)
EndIf

regbrk = StrIn(str,dlm_reg)
str1 = Mid(str_exe,0,regbrk)

itembrk = StrIn(str1,dlm_item)

While (exebrk <> -1)
    itembrk = StrIn(str1,dlm_item)
    Soc = Mid(str1,0,itembrk)
    str1 = Mid(str1,itembrk + 1,Length(str1) - itembrk)

    itemBrk = StrIn(str1,DLM_ITEM)

    If (itemBrk = 0) Then   // null item (only fisrt time)
        var = NullValue()
    Else
        var = Mid (str1,0,itemBrk)
    EndIf

    SCO_JS_HT_PAYS.SCO_GEN_PAYMENTS = ToInt(var)

    str1 = Mid(str1,itemBrk + 1,Length(str1) - 1)

    itemBrk = StrIn(str1,DLM_ITEM)

    If (itemBrk = 0) Then   // null item (only fisrt time)
        var = NullValue()
    Else
        var = Mid(str1,0,itemBrk)
    EndIf

    SCO_JS_HR_PERIOD.SYSSENTENCE_ERROR = var

    str1 = Mid(str1,itemBrk + 1,Length(str1) - 1)

'Open pays load        
    SCO_JS_HT_PAYS.Begin()

    While(regBrk <> -1)
        AddRegister()
        ID_ORGANIZATION = Soc
        sCountry = ""
        For i = 1 To NUM_ITEMS
            itemBrk = StrIn(str1,DLM_ITEM)
            If (itemBrk = 0) Then   // null item (only fisrt time)
                var = NullValue()
            Else
                var = Mid(str1,0,itemBrk)
            EndIf
            str1 = Mid(str1,itemBrk + 1,Length(str1) - 1)

            If (i = 1) Then
                SCO_DAYS_NUM_PAYM = ToInt(var)
            ElseIf (i = 2) Then
                SCO_DAYS_NUM_ALLOC = ToInt(var)
            ElseIf (i = 3) Then
                SCO_DT_ALLOCATION = ToDate(var)
            ElseIf (i = 4) Then
                SCO_DT_END_ALLOC = ToDate(var)
            ElseIf (i = 5) Then
                SCO_DT_END_PAYM = ToDate(var)
            ElseIf (i = 6) Then
                SCO_DT_PAYMENT = ToDate(var)
            ElseIf (i = 7) Then
                SCO_DT_START_ALLOC = ToDate(var)
            ElseIf (i = 8) Then
                SCO_DT_START_PAYM = ToDate(var)
            ElseIf (i = 9) Then
                SCO_DT_TRANSFER = ToDate(var)
            ElseIf (i = 10) Then
                SCO_PAY_FREQ_ALLOC = var
            ElseIf (i = 11) Then
                SCO_PAY_FREQ_PAYM = var
            ElseIf (i = 12) Then
                SCO_PAY_TYPE_ALLOC = var
            ElseIf (i = 13) Then
                SCO_PAY_TYPE_PAYM = var
            ElseIf (i = 14) Then
                SCO_NM_PAY_FREQUENCY = var
            ElseIf (i = 15) Then
                SCO_NUM_HR_PERIOD = ToInt (var)
            ElseIf (i = 16) Then
                SCO_AUTO_REV = ToInt (var)
            ElseIf (i = 17 )Then
                SCO_DT_CLOSE_PROC = ToDate(var)
            ElseIf (i = 18 )Then
                SCO_JS_HR_PERIOD.Dyn_Filter = var
            ElseIf (i = 19 )Then
                SCO_JS_HR_PERIOD.SCO_ID_FILTER = var
            ElseIf (i = 20 )Then
                SCO_JS_HR_PERIOD.SCO_FILTER_SQL = var
            ElseIf (i = 21 )Then
                SCO_JS_HR_PERIOD.SCO_NM_FILTER = var
            ElseIf (i = 22) Then
                sCountry = var
            ElseIf (i = 23) And sCountry = "MX" Then   ' Estandar Mejicana
                SetValue("SCO_JS_HT_PAYS","SME_IND_CLC_SDI",-1,var)
                ind_sdi = ToInt(var)
            EndIf
        Next
        str_exe = Mid(str_exe,regbrk + 2,Length(str_exe) - regbrk - 1)
        regbrk = StrIn(str_exe,dlm_reg)
        str1 = Mid(str_exe,0,regbrk)

        // En el calulo SDI de la nomina mexicana no se valida que la paga este abierta por fecha de pago
        // En el resto de los casos se valida que la paga este abierta por fecha de pago
        If ind_sdi = 0 Then 'Si no es calulo SDI de la nomina mexicana
            'We check that the payment pay is open, if it isn't, it won't be calculated. 
            If SCO_JS_HT_PAYS.Count() = 0 Then SCO_JS_HT_PAYS.Load_Blk()    'This load is needed for the edition of the parameter in JS
            iOpenPayPos = SCO_JS_HT_PAYS.FindRegister("SCO_DT_ACCRUED",SCO_DT_PAYMENT,M4_EQUAL,"SCO_ID_PAY_FREQUENCY",SCO_PAY_FREQ_PAYM,M4_EQUAL)
            If iOpenPayPos = -1 Then '
                Setlog(1,1,101,68,SCO_NM_PAY_FREQUENCY,SCO_DT_PAYMENT)
                DestroyRegister()
            EndIf
        EndIf
    WEnd
    exebrk = StrIn(str,dlm_exe)
    str = Mid(str,exebrk + 2,Length(str) - (exebrk + 1))
    socbrk = StrIn(str,dlm_soc)
    If socbrk = -1 Then
        str_exe = str
    Else    
        str_exe = Mid(str,0,socbrk)
    EndIf
    regbrk = StrIn(str_exe,dlm_reg)
    str1 = Mid(str_exe,0,regbrk)
WEnd

Return(0)
