//Se busca el valor del parámetro
sValue = ""
sIdT3 = "SAV_PARAMS"

OpenChannelEx("SAV_PARAMS","SAV_PARAMS",M4_INSTANCE_GLOBAL_SHARED,M4_OPEN_MODE_LOAD,NullValue(),M4_ORGANIZATION_L2_TYPE_ANY,M4_CSTYPE_BOTH)

If IsNull(SCO_MNG_LOCKED_PAYS) = M4_TRUE Then
    
    ChannelCall("CONFIGURATION","SCO_PAYROLL","SCO_MNG_LOCKED_PAYS",sIdT3,"SAV_PARAMS","RET_VALUE")
    iCount = ChannelCall(sIdT3, "FINAL_RETURN","Count")
    
    if iCount > 0 Then
        sValue = GetChannelValue(sIdT3,"FINAL_RETURN","APP_VALUE",0)
    endif
    
    CLOSECHANNEL(sIdT3)
Else
    sValue = SCO_MNG_LOCKED_PAYS
EndIf

SCO_MNG_LOCKED_PAYS = sValue
