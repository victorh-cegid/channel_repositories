SetSliceMode(SCO_SLICE_MODE)
Output3=0

Output1=SCO_APPLYVAL_PERIOD!SCO_INTERMEDIATE_NODE_PERIOD.INITAPPLYVALUE("DMD1","DMD_GROUP2")
Output2=SCO_APPLYVAL2_I!SCO_APPLYVAL2.INITAPPLYVALUE("DMD1","DMD_GROUP1")

IF SCO_AUTO_REV=1 THEN
	Output3=SCO_AUTO_REV_DATE!SCO_INTERMEDIATE_NODE.INITAPPLYVALUE("DMD_REV","GROUP1")
ENDIF

If (Output1=M4_ERROR OR Output2=M4_ERROR OR Output3=M4_ERROR) Then
	SetLog(-1,1,101,5)
	Return(-1)
Endif

SCO_HT_RUN_PAYS.SCO_DELETE_RUN_PAY()
SCO_HR_PERIOD.SCO_DELETE_PERIOD()         
SCO_HR_PERIOD.SCO_DELETE_ROLE()    
SCO_HR_PERIOD.SCO_DELETE_APP_PERIOD() 
SCO_HR_PERIOD.SCO_DELETE_APP_ROLE()
SCO_HR_PAY_ERROR.SCO_DELETE_ERRORS()

'Aqui se mira sl parametro de aplicacion para saber que tipo de flujo se esta manejando
SCO_LP_MNG_LOCKED_PAYS()

RETURN(0)
