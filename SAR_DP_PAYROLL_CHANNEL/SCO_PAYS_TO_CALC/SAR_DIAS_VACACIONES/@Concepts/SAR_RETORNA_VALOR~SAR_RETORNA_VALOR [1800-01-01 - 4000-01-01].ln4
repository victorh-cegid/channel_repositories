BEGIN()
WHILE ISEOF() = FALSE
    IF SAR_ID_VACACIONES = ARG_ID_VACACIONES AND TOINT(SAR_DESDE) <= TOINT(ARG_DIAS) AND TOINT(SAR_HASTA) >= TOINT(ARG_DIAS) THEN
        IF ARG_CAMPO = "SAR_DIAS_AUMENTAR" THEN
                IF ISNULL(SAR_DIAS_AUMENTAR)= TRUE THEN
                    SAR_DIAS_AUMENTAR = 0 
                ENDIF   
                Return(SAR_DIAS_AUMENTAR)
        ELSEIF ARG_CAMPO = "SAR_DIAS" THEN
                IF ISNULL(SAR_DIAS)= TRUE THEN
                    SAR_DIAS = 0 
                ENDIF
                Return(SAR_DIAS)
        ENDIF
    ENDIF
    GONEXT()
WEND
Return(0)
