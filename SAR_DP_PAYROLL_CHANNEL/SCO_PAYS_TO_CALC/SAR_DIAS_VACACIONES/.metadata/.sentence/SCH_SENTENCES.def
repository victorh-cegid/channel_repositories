# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_DIAS_VACACIONES | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And ( #I >= ? Or #I IS NULL ) |  | SELECT @SAR_ID_VACACIONES = A.SAR_ID_VACACIONES, @SAR_DESDE = A.SAR_DESDE, @SAR_HASTA = A.SAR_HASTA, @SAR_DT_START = A.SAR_DT_START, @SAR_DT_END = A.SAR_DT_END, @SAR_DIAS = A.SAR_DIAS, @SAR_DIAS_AUMENTAR = A.SAR_DIAS_AUMENTAR, @ID_ORGANIZATION = A.ID_ORGANIZATION FROM &SAR_H_VACACIONES A WHERE (A.SAR_DT_START <= @SAR_DT_ALLOCATION And ( A.SAR_DT_END >= @SAR_DT_ALLOCATION Or A.SAR_DT_END IS NULL ))
