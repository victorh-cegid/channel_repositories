# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_IMPUESTO_CF | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SAR_DT_DESDE = A.SAR_DT_DESDE, @ID_CURRENCY = A.ID_CURRENCY, @CUR_DATE = A.CUR_DATE, @EX_TYPE = A.EX_TYPE, @SAR_DT_HASTA = A.SAR_DT_HASTA, @SAR_DT_START = A.SAR_DT_START, @SAR_DT_END = A.SAR_DT_END, @SAR_CUOTA_FIJA = A.SAR_CUOTA_FIJA, @SAR_PORCENTAJE = A.SAR_PORCENTAJE FROM &SAR_IMPUESTOS A WHERE (A.SAR_DT_START <= @PROP_FECHA And A.SAR_DT_END >= @PROP_FECHA) ORDER BY A.SAR_DT_DESDE ASC
