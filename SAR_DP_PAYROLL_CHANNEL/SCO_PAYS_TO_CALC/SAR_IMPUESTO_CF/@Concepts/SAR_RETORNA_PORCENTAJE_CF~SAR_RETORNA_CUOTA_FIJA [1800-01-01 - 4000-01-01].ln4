vPorcentaje = 0
vMarca      = 0

PROP_FECHA = ARG_DESDE

Begin()
If Count() > 0 Then
    IF ID_CURRENCY <> ARG_ID_CURRENCY THEN  
       DESDE      = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_DT_DESDE)
       HASTA      = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_DT_HASTA)
       CUOTA_FIJA = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_CUOTA_FIJA)
    ELSE
       DESDE      = SAR_DT_DESDE
       HASTA      = SAR_DT_HASTA
       CUOTA_FIJA = SAR_CUOTA_FIJA
    ENDIF
       
    
    If SAR_DT_START <= ARG_DESDE AND ARG_DESDE <= SAR_DT_END Then            

        vPos = Findregister("SAR_CUOTA_FIJA",ToInt(ARG_BASE),M4_GREATER)
        
        If vPos <> -1 Then
            If vpos > 0 And (vpos < Count())Then
                MoveTo(vPos-1)
            Else
                MoveTo(vPos)
            EndIf
        Else    
            If ARG_BASE > 0 And Count() > 1 Then
                MoveTo(Count()-1)
                vPorcentaje = Min(SAR_PORCENTAJE,ToInt(ARG_BASE))
            EndIf
        EndIf
        vPorcentaje = SAR_PORCENTAJE        
    ENDIF    
    
EndIf

Return(vPorcentaje)
