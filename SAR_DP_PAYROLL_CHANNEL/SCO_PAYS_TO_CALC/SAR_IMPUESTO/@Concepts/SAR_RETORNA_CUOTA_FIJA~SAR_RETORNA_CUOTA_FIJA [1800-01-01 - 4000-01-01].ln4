'Desde 2024, se ha separado la tabla de impuesto de diciembre de la paga normal respecto a la de reliquidación, tienen importes diferentes:
tablaReliq = 0
indReliq = SAR_HRPERIOD_CALC.SAR_IND_PAGA_RELIQ
If DxYear(SAR_HRPERIOD_CALC.SAR_FEC_PAGO_IG) > 2023 And DxMonth(ARG_DESDE) = 12 And (indReliq = 1 Or (SAR_HRPERIOD_CALC.SAR_ES_BAJA = 1 And SAR_HR_PERIOD.STD_ID_HRP_END_REASON <> "017" And SAR_HRPERIOD_CALC.SAR_IG_DICIEMBRE = 1)) Then tablaReliq = 1

BEGIN()
WHILE ISEOF() = FALSE
    IF ID_CURRENCY <> ARG_ID_CURRENCY THEN  
       DESDE = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_DT_DESDE)
       HASTA = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_DT_HASTA)
       CUOTA_FIJA = EXCHANGE_RATES!CURRENCY.curGetExchange(ID_CURRENCY,ARG_ID_CURRENCY,SAR_DT_ALLOCATION,EX_TYPE,SAR_CUOTA_FIJA)
    ELSE
       DESDE = SAR_DT_DESDE
       HASTA = SAR_DT_HASTA
       CUOTA_FIJA = SAR_CUOTA_FIJA
    ENDIF
    IF SAR_DT_ALLOCATION >= DxDate(1,10,2023) THEN 
        IF SAR_HRPERIOD_CALC.SAR_CEDU_IND_IMPUESTO = 0 THEN 
            'Impuesto de 4categ
            If tablaReliq = 0 Then
                IF SAR_DT_START <= ARG_DESDE AND ARG_DESDE <= SAR_DT_END AND DESDE <= ARG_BASE AND HASTA >= ARG_BASE AND SAR_SOLAP = 1 THEN 
                     Return(CUOTA_FIJA)
                ENDIF
            Else
            'Lee tabla de reliquidación
                IF SAR_DT_START <= ARG_DESDE AND ARG_DESDE <= SAR_DT_END AND DESDE <= ARG_BASE AND HASTA >= ARG_BASE AND SAR_SOLAP = 99 THEN 
                     Return(CUOTA_FIJA)
                ENDIF
            EndIf            
        ELSE
            'Impuesto cedular
            IF SAR_DT_START <= ARG_DESDE AND ARG_DESDE <= SAR_DT_END AND DESDE <= ARG_BASE AND HASTA >= ARG_BASE AND SAR_SOLAP = 2 THEN 
                 Return(CUOTA_FIJA)
            ENDIF
        ENDIF
    ELSE
        IF SAR_DT_START <= ARG_DESDE AND ARG_DESDE <= SAR_DT_END AND DESDE <= ARG_BASE AND HASTA >= ARG_BASE AND SAR_SOLAP = 0 THEN 
             Return(CUOTA_FIJA)
        ENDIF
    ENDIF
    GONEXT()
WEND
Return(0)
