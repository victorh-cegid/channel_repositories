# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_VAL_FAMILIAR_IG | 0 | 0 | 1 |  | 80 |  |  | #I = 'SAR_VAL_CONY_IMP' Or #I = 'SAR_VAL_HIJO_IMP' Or #I = 'SAR_VAL_OTRAS_IMP' |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @STD_ID_LEG_ENT = A.STD_ID_LEG_ENT, @ID_DMD = A.ID_DMD, @ID_DMD_COMPONENT = A.ID_DMD_COMPONENT, @DT_START = A.DT_START, @DT_COR_START = A.DT_COR_START, @DT_END = A.DT_END, @DT_COR_END = A.DT_COR_END, @SCO_VALUE = A.SCO_VALUE, @ID_M4_TYPE = A.ID_M4_TYPE, @SCO_ID_CURRENCY = A.SCO_ID_CURRENCY, @SCO_DT_EXCHANGE = A.SCO_DT_EXCHANGE, @EX_TYPE = A.EX_TYPE, @SCO_ID_REASON_CHANGE = A.SCO_ID_REASON_CHANGE, @ID_PRIORITY = A.ID_PRIORITY FROM &SCO_LEG_ENT_VALUES A WHERE (A.ID_DMD_COMPONENT = 'SAR_VAL_CONY_IMP' Or A.ID_DMD_COMPONENT = 'SAR_VAL_HIJO_IMP' Or A.ID_DMD_COMPONENT = 'SAR_VAL_OTRAS_IMP') ORDER BY A.STD_ID_LEG_ENT ASC, A.ID_DMD_COMPONENT ASC
