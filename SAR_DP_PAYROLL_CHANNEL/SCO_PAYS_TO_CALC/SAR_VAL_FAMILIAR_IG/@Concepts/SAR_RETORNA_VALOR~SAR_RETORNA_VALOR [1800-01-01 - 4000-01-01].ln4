'Se modificó por mail 11/10/2007 - Bug 0133840 - Validar.
BEGIN()
WHILE ISEOF() = FALSE
    IF STD_ID_LEG_ENT = ARG_EMPRESA AND DT_COR_START <= ARG_FECHA AND DT_COR_END >= ARG_FECHA THEN
        IF ID_DMD_COMPONENT = ARG_CONCEPTO THEN
            Return(SCO_VALUE)
        ENDIF
    ENDIF
    GONEXT()
WEND
Return(0)
