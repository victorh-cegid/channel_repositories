# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SCO_DT_FILTER_TI | 0 | 0 | 1 |  | 10 |  |  |  |  | SELECT @SCO_ID_PAY_FREQ_ACC = #MAX(A.SCO_ID_PAY_FREQ_ACC), @ID_ORGANIZATION = #MAX(A.ID_ORGANIZATION), @SCO_ID_PAY_FREQ_ALL = #MAX(A.SCO_ID_PAY_FREQ_ALL), @SCO_DT_FILTER = #MAX(C.SCO_DT_CUTOFF) FROM &SCO_HT_RUN_PAYS A, SCO_HT_PAYS C WHERE A.ID_ORGANIZATION = C.ID_ORGANIZATION AND A.SCO_DT_ACCRUED = C.SCO_DT_ACCRUED AND A.SCO_ID_PAY_FREQ_ACC = C.SCO_ID_PAY_FREQUENCY
