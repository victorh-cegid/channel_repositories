# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_PROXIMA_PAGA | 0 | 0 | 1 |  | 80 |  |  | #I <> '2' And #I <> '88' And #I <> '99' And #I = '02' |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_DT_ACCRUED = A.SCO_DT_ACCRUED, @SCO_ID_PAY_FREQUENCY = A.SCO_ID_PAY_FREQUENCY, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @SCO_ID_PAY_TYPE = A.SCO_ID_PAY_TYPE, @SCO_ID_PAY_STATUS = A.SCO_ID_PAY_STATUS FROM &SCO_HT_PAYS A WHERE (A.SCO_ID_PAY_TYPE <> '2' And A.SCO_ID_PAY_TYPE <> '88' And A.SCO_ID_PAY_TYPE <> '99' And A.SCO_ID_PAY_STATUS = '02') ORDER BY A.SCO_DT_ACCRUED ASC, A.SCO_ID_PAY_FREQUENCY ASC
