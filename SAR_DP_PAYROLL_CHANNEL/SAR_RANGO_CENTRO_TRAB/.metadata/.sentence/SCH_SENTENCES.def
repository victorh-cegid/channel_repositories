# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_RANGO_CENTRO_TRAB | 0 | 0 | 1 |  | 80 |  |  | #I = $ ID_ORGANIZATION And #I = ? And #I <= #I And #I >= #I And #I <= ? And #I >= ? And #I = 'SAR_INDIC_REDUC_ZON_DES_1' And #I = '1.00000000' |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @DT_START = B.DT_START, @DT_END = B.DT_END, @SCO_ID_WORK_LOCATION = A.SCO_ID_WORK_LOCATION FROM &SCO_H_HR_WLOCATION A, SCO_WC_VALUES B WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_WORK_LOCATION = B.SCO_ID_WORK_CENTER(+) AND (A.ID_ORGANIZATION = $ID_ORGANIZATION And A.SCO_ID_HR = @SAR_ID_HR And B.DT_START <= A.SCO_DT_END And B.DT_END >= A.SCO_DT_START And A.SCO_DT_START <= @SAR_FEC_FIN And A.SCO_DT_END >= @SAR_FEC_INI And B.ID_DMD_COMPONENT = 'SAR_INDIC_REDUC_ZON_DES_1' And B.SCO_VALUE = '1.00000000') ORDER BY B.DT_START ASC
