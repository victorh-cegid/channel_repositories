'QBF_APPLY_FILTER

'Operator Codes
OPR_DEFAULT = 1

OPR_STR_START = 1
OPR_STR_END = 2
OPR_STR_CONTAIN = 3
OPR_STR_IS = 4
OPR_STR_ISNOT = 5
OPR_STR_NOT_START = 6
OPR_STR_NOT_END = 7
OPR_STR_NOT_CONTAIN = 8
OPR_STR_AFTER = 9
OPR_STR_BEFORE = 10
OPR_STR_ISANYOF = 11
OPR_STR_NOT_ISANYOF = 12

OPR_NUM_IS = 1
OPR_NUM_ISNOT = 2
OPR_NUM_GREATER_EQUAL = 3
OPR_NUM_LESS_EQUAL = 4
OPR_NUM_GREATER = 5
OPR_NUM_LESS = 6

OPR_DATE_IS = 1
OPR_DATE_ISNOT = 2
OPR_DATE_AFTER_IS = 3
OPR_DATE_BEFORE_IS = 4
OPR_DATE_AFTER = 5
OPR_DATE_BEFORE = 6

'M4 Types
M4_CHAR = 1
M4_VARCHAR = 2
M4_DATE = 4
M4_TIMESTAMP = 5
M4_NUMBER = 6
M4_VARIANT  = 7
M4_MINI_VARIANT = 9
M4_CURRENCY = 8
M4_TIMESPAN = 17

'Item Internal Types
M4_SYS_SENTENCE = 20
M4_SYS_PARAM = 33
M4_OPERATOR_ITEM = 70

Me = GetThisNodeId()
iFilter = SCOPE_BLOCK + TYPE_PROPERTY

PVT_GET_FROM() 
PVT_GET_WHERE()
sSQL = PVT_GET_FROM + PVT_GET_WHERE

sLN4 = ""
sParamLine = ""
sValLine = ""
sLogicOper = " AND "
sIdReadObject = ""

iItemCount = GetNodeNumberOfItems(Me, iFilter)

iNumArgs = GetArgumentNumber()

If iNumArgs > 0 Then
  lValue = ToInt(GetArgument(1))
  If lValue = 1 Then
    sLogicOper = " OR "
  EndIf
EndIf


DefineInstance("SCH_SESSION","SCH_SESSION",0,1)

iMatchCase = clcExecuteLn4JIT("return(SCH_SESSION!ROOT_SESSION.QBF_MATCH_CASE)")


For x = 0 to iItemCount - 1

    sItem = GetNodeItemId(Me, x, iFilter)

    iInternal = GetNodeItemInternalType(Me, sItem)

    'If this is not an operator then continue
    If iInternal <> M4_OPERATOR_ITEM Then

        bFound = FALSE

        'Lets see if this one has an Operator Item
        For y = 0 to iItemCount - 1
            sSecItem = GetNodeItemId(Me, y, iFilter)

            'Now Get the Associated Item
            sAssocItem = ChannelAttribGetValue("", Me, sSecItem, ATT_SYS_AUX_ITEM_ID)

            If sAssocItem = sItem Then
                bFound = TRUE
                y = iItemCount - 1
            EndIf
        Next 

        'If we found it
        If bFound = TRUE Then

            'Get the Operator Value
            iOper = GetValue(Me, sSecItem, -1)

            'If Its Null then set to Default
            If IsNull(iOper) = TRUE Then
                iOper = OPR_DEFAULT
            EndIf

        Else
        'Set Default Operator
            iOper = OPR_DEFAULT
        EndIf

        'Init Oper Vars
        sOper1 = ""
        sOper2 = ""
        sOper3 = ""

'        'BF 0128329
'        'Alias does not exist in the sentence (inheritance)
'        sAlias = GetNodeItemReadObjectAlias(Me, sItem)
'
'        If StrIn(PVT_GET_FROM, sAlias) = M4_ERROR Then
'            If length(sIdReadObject) = 0 Then
'                sIdReadObject = GetNodeReadObjectId(Getthisnodeid())
'            EndIf
'            
'            sSql = Replace(sSql,sAlias, sIdReadObject)
'            
'            sAlias = sIdReadObject
'        EndIf
'        'BF 0128329
        
        'Now Continue with the Aux Item
        vValue = GetValue(Me, sItem, -1)
        If IsNull(vValue) <> TRUE Then

            sAlias = GetNodeItemReadObjectAlias(Me, sItem)
            sField = GetNodeItemReadFieldId(Me, sItem)
                        
            iM4Type = GetNodeItemM4Type(Me,sItem)
            sValue = ToString(vValue)

            vScale = GetNodeItemScale(Me, sItem)
            If IsNull(vScale) = TRUE Then
                vScale = 0
            EndIf

            'Set Param Add Flag to Default
            bAddParam = TRUE

            If iM4Type = M4_CHAR Or iM4Type = M4_VARCHAR Or iM4Type = M4_VARIANT Then

                'Select Operator
                If iOper = OPR_STR_START Then
                    sOper1 = " LIKE " 
                    sOper2 = "%"

                ElseIf iOper = OPR_STR_END Then
                    sOper1 = " LIKE " 
                    sOper2 = ""
                    sOper3 = "%"

                ElseIf iOper = OPR_STR_CONTAIN Then
                    sOper1 = " LIKE " 
                    sOper2 = "%"
                    sOper3 = "%"

                ElseIf iOper = OPR_STR_IS Then 
                    sOper1 = " = " 

                ElseIf iOper = OPR_STR_ISNOT Then
                    sOper1 = " <> " 

                ElseIf iOper = OPR_STR_NOT_START Then
                    sOper1 = " NOT LIKE " 
                    sOper2 = "%"

                ElseIf iOper = OPR_STR_NOT_END Then
                    sOper1 = " NOT LIKE " 
                    sOper2 = ""
                    sOper3 = "%"

                ElseIf iOper = OPR_STR_NOT_CONTAIN Then
                    sOper1 = " NOT LIKE " 
                    sOper2 = "%"
                    sOper3 = "%"

                ElseIf iOper = OPR_STR_AFTER Then
                    sOper1 = " > " 

                ElseIf iOper = OPR_STR_BEFORE Then
                    sOper1 = " < "
                     
                ElseIf iOper = OPR_STR_ISANYOF Or iOper = OPR_STR_NOT_ISANYOF Then
                    bAddParam = M4_FALSE
                    If iOper = OPR_STR_ISANYOF Then
                        sOper1 = " IN "
                    Else
                        sOper1 = " NOT IN "
                    EndIf
                    
                    bIsPk = GetNodeItemData(GetThisNodeID(), sItem, M4_ITEM_IS_PK)
                    
                    // si estamos copiando valores de excel, en el inlines, la coma la sutituimos 
                    // por este caracter no imprimible, y ahora aqui le damos la vuelta.
                    // lo hacemos igual en la Query.
                    // Bug 316166
                    sValue = Replace(sValue,"?" , ",") 
                    
              
                    If bIsPk = M4_FALSE AND iMatchCase = 0 Then
                        sParam = "#UCASE(" + sAlias + "." + sField + ")" + sOper1 + "(" + ConvertCase(sValue, M4_UPPERCASE) + ")"
                    Else
                        sParam = sAlias + "." + sField + sOper1 + "(" + sValue + ")"
                    EndIf
                    
                    If sParamLine <> "" then
                        sParamLine = sParamLine + sLogicOper
                    EndIf
                    sParamLine = sParamLine + sParam                      
                                    
                EndIf

            ElseIf iM4Type = M4_TIMESTAMP Or iM4Type = M4_DATE Then
                
                'Get Initial Oper ... Could Modify if a TimeStamp and No Hour passed
                If iOper = OPR_DATE_IS Then
                    sOper1 = " = " 

                ElseIf iOper = OPR_DATE_ISNOT Then
                    sOper1 = " <> " 

                ElseIf iOper = OPR_DATE_AFTER_IS Then
                    sOper1 = " >= " 

                ElseIf iOper = OPR_DATE_BEFORE_IS Then
                    sOper1 = " <= " 

                ElseIf iOper = OPR_DATE_AFTER Then
                    sOper1 = " > " 

                ElseIf iOper = OPR_DATE_BEFORE Then
                    sOper1 = " < " 
                EndIf

                'If a TimeStamp need to check if Passed Hour etc
                If iM4Type = M4_TIMESTAMP Then
                
                    dValue = ToDate(vValue)

                    'Init Reference Variables
                    iYear = 0
                    iMonth = 0
                    iDay = 0
                    iHour = 0
                    iMins = 0
                    iSecs = 0

                    iReturn = DateToAllNumbers(dValue, iYear, iMonth, iDay, iHour, iMins, iSecs)

                    If iHour = 0 And iMins = 0 And iSecs = 0 Then

                        'Prep Start & End Date Variables
                        'Start Date 
                        dSDate = dValue
                        'End Date
                        dEDate = NumbersToDate(iYear, iMonth, iDay, 23, 59, 59)

                        'If Is Equal,Not Equal,  Greater Than or LessThen/Equal _... Have to do some mods
                        If iOper = OPR_DATE_IS Or iOper = OPR_DATE_ISNOT Then
                            'Field => DatePart & 00:00:00 And Field <= DatePart & 23:59:59
                            'Or
                            'Field < DatePart & 00:00:00 Or Field >= DatePart & 23:59:59

                            'Set Flag to not do Param Add 
                            bAddParam = FALSE

                            If sValLine <> "" then
                                sValLine = sValLine + "|"
                            EndIf

                            sValLine = sValLine + ToString(dSDate) + "|" + ToString(dEDate)

                            'Now Set Opers
                            If iOPER = OPR_DATE_IS Then
                                sOper1 = " >= "
                                sOper2 = " AND "
                                sOper3 = " <= " 

                            Else
                                sOper1 = " < " 
                                sOper2 = " OR "
                                sOper3 = " > "
                            EndIf

                            'Param Line
                            sParam = "(" + sAlias + "." + sField + sOper1 + "?(" + ToString(iM4Type,0) + ", 0, 0)"
                            sParam = sParam + sOper2 + sAlias + "." + sField + sOper3 + "?(" + ToString(iM4Type,0) + ", 0, 0))"

                            If sParamLine <> "" then
                                sParamLine = sParamLine + sLogicOper
                            EndIf
                            sParamLine = sParamLine + sParam                            
                            
                        ElseIf iOper = OPR_DATE_AFTER Or iOper = OPR_DATE_BEFORE_IS Then
                             'Field >/<= DatePart & 23:59:59
                             sValue = ToString(dEDate)

                        EndIf

                    EndIf
                EndIf

            ElseIf iM4Type = M4_NUMBER Or iM4Type = M4_MINI_VARIANT Or iM4Type = M4_CURRENCY Or iM4Type = M4_TIMESPAN Then

                'Get Oper
                If iOper = OPR_NUM_IS Then
                    sOper1 = " = " 

                ElseIf iOper = OPR_NUM_ISNOT Then
                    sOper1 = " <> " 

                ElseIf iOper = OPR_NUM_GREATER_EQUAL Then
                    sOper1 = " >= " 

                ElseIf iOper = OPR_NUM_LESS_EQUAL Then
                    sOper1 = " <= " 

                ElseIf iOper = OPR_NUM_GREATER Then
                    sOper1 = " > " 

                ElseIf iOper = OPR_NUM_LESS Then
                    sOper1 = " < " 
                EndIf

                'Redo the ToString to preserve the number as is
                sValue = ToString(vValue, vScale)

            EndIf


            If bAddParam = TRUE Then
                If sValLine <> "" then
                    sValLine = sValLine + "|"
                EndIf
                sValLine = sValLine + sOper3 + sValue  + sOper2

                'Temp
                bIsPk = GetNodeItemData(GetThisNodeID(), sItem, M4_ITEM_IS_PK)
          
                if (bIsPk = M4_FALSE AND iMatchCase = 0 and (iM4Type = M4_CHAR Or iM4Type = M4_VARCHAR Or iM4Type = M4_VARIANT)) Then
                    sParam = "#UCASE(" + sAlias + "." + sField + ")" + sOper1 + "#UCASE(" + "?(" + ToString(iM4Type,0) + ", " 
                    sParam = sParam + ToString(GetNodeItemPrecision(Me, sItem)) + ", " + ToString(vScale,0) + ")" + ")" 

                Else
                    sParam = sAlias + "." + sField + sOper1 + "?(" + ToString(iM4Type,0) + ", " 
                    sParam = sParam + ToString(GetNodeItemPrecision(Me, sItem)) + ", " + ToString(vScale,0) + ")"
                Endif
                
                
                If sParamLine <> "" then
                    sParamLine = sParamLine + sLogicOper
                EndIf
                sParamLine = sParamLine + sParam

            EndIf
        EndIf
    EndIf
Next

If sParamLine = "" Then
     sSQL = ""
     sValLine = ""
     sReturn = ""
Else
     sSQL = sSQL + "(" + sParamLine + ")"
     sReturn = ""
EndIf

iFilter = SCOPE_NODE + TYPE_PROPERTY
iItemCount = GetNodeNumberOfItems(Me, iFilter)
iFound = 0
For x = 0 To iItemCount - 1
    iInternalType = GetNodeItemInternalType(Me, x, iFilter)
    sItem = GetNodeItemId(Me, x, iFilter)
    If iInternalType = M4_SYS_SENTENCE Then
         iReturn = SetValue(Me, sItem, -1,sSQL)
         iFound = iFound + 1
    ElseIf iInternalType = M4_SYS_PARAM Then
         iReturn = SetValue(Me, sItem, -1,sValLine)
         iFound = iFound + 1
    EndIf
    If iFound = 2 Then 
         x = iItemCount + 1
    EndIf
Next

RETURN sReturn
