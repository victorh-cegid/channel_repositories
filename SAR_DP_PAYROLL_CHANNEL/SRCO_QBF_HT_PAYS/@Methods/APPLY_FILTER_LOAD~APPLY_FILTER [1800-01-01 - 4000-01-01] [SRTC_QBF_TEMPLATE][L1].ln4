'QBF_APPLY_FILTER AND LOAD

'Operator Codes
OPR_DEFAULT = 1

OPR_STR_START = 1
OPR_STR_END = 2
OPR_STR_CONTAIN = 3
OPR_STR_IS = 4
OPR_STR_ISNOT = 5
OPR_STR_NOT_START = 6
OPR_STR_NOT_END = 7
OPR_STR_NOT_CONTAIN = 8
OPR_STR_AFTER = 9
OPR_STR_BEFORE = 10

OPR_NUM_IS = 1
OPR_NUM_ISNOT = 2
OPR_NUM_GREATER_EQUAL = 3
OPR_NUM_LESS_EQUAL = 4
OPR_NUM_GREATER = 5
OPR_NUM_LESS = 6

OPR_DATE_IS = 1
OPR_DATE_ISNOT = 2
OPR_DATE_AFTER_IS = 3
OPR_DATE_BEFORE_IS = 4
OPR_DATE_AFTER = 5
OPR_DATE_BEFORE = 6

'M4 Types
M4_CHAR = 1
M4_VARCHAR = 2
M4_DATE = 4
M4_TIMESTAMP = 5
M4_NUMBER = 6
M4_VARIANT  = 7
M4_MINI_VARIANT = 9
M4_CURRENCY = 8
M4_TIMESPAN = 17

'Item Internal Types
M4_SYS_SENTENCE = 20
M4_SYS_PARAM = 33
M4_OPERATOR_ITEM = 70

Me = GetThisNodeId()



trNodeID = TR_NODEID
searchValue = SEARCH_VALUE
  
//1. Clean tr data node
CALL("DestroyBlock()", trNodeID, "EXECUTELN4JIT")

iFilter = SCOPE_BLOCK + TYPE_PROPERTY
iItemCount = GetNodeNumberOfItems(Me, iFilter)


//2. Prepare filter items
For x = 0 to iItemCount - 1

    sItem = GetNodeItemId(Me, x, iFilter)

    iInternal = GetNodeItemInternalType(Me, sItem)

    'If this is not an operator then continue
    If iInternal <> M4_OPERATOR_ITEM Then

        bFound = FALSE

        'Lets see if this one has an Operator Item
        For y = 0 to iItemCount - 1
            sSecItem = GetNodeItemId(Me, y, iFilter)

            'Now Get the Associated Item
            sAssocItem = ChannelAttribGetValue("", Me, sSecItem, ATT_SYS_AUX_ITEM_ID)

            If sAssocItem = sItem Then
                bFound = TRUE
                y = iItemCount - 1
            EndIf
        Next 

        'If we found it
        If bFound = TRUE Then

            iM4Type = GetNodeItemM4Type(Me,sItem)
        
            if (iM4Type = M4_VARCHAR or iM4Type = M4_CHAR) THEN//solo busca en los tipo cadena variable
                SetValue(Me, sSecItem, -1, OPR_STR_CONTAIN) 
                SetValue(Me, sItem, -1, searchValue )
            ENDIF

        EndIf
    EndIf
Next

//Call apply filter with OR join condition Argument = 1
APPLY_FILTER(1)

//Load tr data node
iReturn = CALL(trNodeID, "LOAD_BLK")

RETURN iReturn
