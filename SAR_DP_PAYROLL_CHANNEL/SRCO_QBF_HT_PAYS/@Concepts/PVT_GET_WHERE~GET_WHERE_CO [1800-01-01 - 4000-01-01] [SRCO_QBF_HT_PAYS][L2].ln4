sAux = PVT_GET_WHERE
sAux = sAux + "SCO_HT_PAYS.ID_ORGANIZATION = SCO_PAY_FREQUENCY_NUM.ID_ORGANIZATION(+) AND SCO_HT_PAYS.SCO_ID_PAY_FREQUENCY = SCO_PAY_FREQUENCY_NUM.SCO_ID_PAY_FREQUENCY(+) AND SCO_HT_PAYS.SCO_NUM_PAY_MONTH = SCO_PAY_FREQUENCY_NUM.SCO_NUM_PAY_MONTH(+) AND SCO_PAY_FREQUENCY_NUM.ID_ORGANIZATION = SCO_X_PAY_FREQUENCY.ID_ORGANIZATION(+) AND SCO_PAY_FREQUENCY_NUM.SCO_ID_PAY_FREQUENCY = SCO_X_PAY_FREQUENCY.SCO_ID_PAY_FREQUENCY(+) AND "
sAux = sAux + "SCO_HT_PAYS.ID_ORGANIZATION = SCO_X_PAY_TYPE.ID_ORGANIZATION(+) AND SCO_HT_PAYS.SCO_ID_PAY_TYPE = SCO_X_PAY_TYPE.SCO_ID_PAY_TYPE(+) AND "

Return(sAux)
