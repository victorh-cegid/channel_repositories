SCO_EXE_MODE = FLAG_MENU
if FLAG_MENU=1 then
	SCO_PAYS_TO_CALC.SCO_AUTO_REV=1
endif

If IsNull(FLAG_JS)<>1 Then
    SCO_FROM_JS = FLAG_JS
EndIf

'To avoid the load of the Auxiliary Node structures we set a Flag
SCO_AUX_AC_HRPERIOD.SCO_FLAG_LOAD = 1
SCO_AUX_AC_HRROLE.SCO_FLAG_LOAD = 1

SCO_SET_ORGANIZATION()

RETURN (0)
