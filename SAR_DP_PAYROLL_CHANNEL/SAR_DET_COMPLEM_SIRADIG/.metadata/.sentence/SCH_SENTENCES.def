# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_DET_COMPLEM_SIRADIG | 0 | 0 | 1 |  | 80 |  |  | #I = $ ID_ORGANIZATION And #I = ? And #I = ? And #I = ? And #I = ? |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @SAR_ID_ENTIDAD = A.SAR_ID_ENTIDAD, @SAR_DESCRIPCION = A.SAR_DESCRIPCION, @SAR_DT_START = A.SAR_DT_START, @SAR_DT_END = A.SAR_DT_END, @SAR_DETALLE = A.SAR_DETALLE, @SAR_ANIO = A.SAR_ANIO, @SAR_MONTO = A.SAR_MONTO, @ID_CURRENCY = A.ID_CURRENCY, @CUR_DATE = A.CUR_DATE, @EX_TYPE = A.EX_TYPE FROM &SAR_DET_COMPLEM_SIRADIG A WHERE (A.ID_ORGANIZATION = $ID_ORGANIZATION And A.STD_ID_HR = @SAR_ID_HR And A.STD_OR_HR_PERIOD = @SAR_OR_PERIOD And A.SAR_ANIO = @SAR_YEAR And A.SAR_DETALLE = @SAR_DETAIL) ORDER BY A.SAR_DESCRIPCION ASC
