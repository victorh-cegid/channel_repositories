# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_FECHAS_PAGA_IG | 0 | 0 | 1 |  | 80 |  |  | #I = $ ID_ORGANIZATION And #I = ? And #I = ? And #I = ? |  | SELECT @SAR_FECHA_PAGO = A.SAR_FECHA_PAGO FROM &SAR_FECHAS_PAGA A WHERE (A.ID_ORGANIZATION = $ID_ORGANIZATION And A.STD_ID_LEG_ENT = @SAR_EMPRESA And A.SCO_DT_ACCRUED = @SAR_FECHA_CARGA And A.SCO_ID_PAY_FREQUENCY = @SAR_FREQ_PAYM)
