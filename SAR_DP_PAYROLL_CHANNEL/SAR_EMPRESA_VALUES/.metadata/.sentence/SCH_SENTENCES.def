# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_EMPRESA_VALUES | 0 | 0 | 1 |  | 80 |  |  | #I = ? And ( #I >= ? ) And ( #I <= ? ) |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @STD_ID_LEG_ENT = A.STD_ID_LEG_ENT, @ID_DMD = A.ID_DMD, @ID_DMD_COMPONENT = A.ID_DMD_COMPONENT, @DT_START = A.DT_START, @DT_COR_START = A.DT_COR_START, @DT_END = A.DT_END, @DT_COR_END = A.DT_COR_END, @SCO_VALUE = A.SCO_VALUE, @ID_M4_TYPE = A.ID_M4_TYPE, @SCO_ID_CURRENCY = A.SCO_ID_CURRENCY, @SCO_DT_EXCHANGE = A.SCO_DT_EXCHANGE, @EX_TYPE = A.EX_TYPE FROM &SCO_LEG_ENT_VALUES A WHERE (A.STD_ID_LEG_ENT = @SAR_EMPRESA And ( A.DT_END >= @SAR_FECHA_IG ) And ( A.DT_START <= @SAR_FECHA_IG )) ORDER BY A.DT_START DESC, A.DT_COR_START ASC
