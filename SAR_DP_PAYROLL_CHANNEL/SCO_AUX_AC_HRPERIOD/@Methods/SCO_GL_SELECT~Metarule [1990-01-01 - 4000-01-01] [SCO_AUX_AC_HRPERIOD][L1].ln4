//Este Syssentence es necesario porque al ser la sentencia dinámica, la única forma de 
//poner un filtro es de esta forma, calculando el objeto de lectura

IDNode = GetThisNodeID()

sYTDLogicObject = GetNodeReadObjectId(IDNode)

SYSSENTENCE = "FROM &" + sYTDLogicObject + " A WHERE (A.SCO_IND_MAIN_CURR = 1)"
Return(0)
