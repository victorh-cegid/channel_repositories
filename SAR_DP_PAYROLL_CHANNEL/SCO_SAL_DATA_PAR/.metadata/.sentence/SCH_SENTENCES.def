# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SCO_SAL_DATA_PAR | 0 | 0 | 1 |  | 10 |  |  |  |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_ID_FIELD_PERCE = A.SCO_ID_FIELD_PERCE, @SCO_ID_FIELD = A.SCO_ID_FIELD, @SCO_ID_NODE = A.SCO_ID_NODE, @SCO_ID_ITEM = A.SCO_ID_ITEM FROM &SCO_SAL_DATA_PAR A ORDER BY A.SCO_ID_NODE ASC, A.SCO_ID_ITEM ASC
