# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_TOTAL_VALUES | 1 | 0 | 1 |  | 80 |  |  | #I = ? And ? >= #I And ? >= #I And ? <= #I And ? <= #I And #I = ? And ( #I = 'SAR_HRPERIOD_CALC' Or #I = 'CAR_HRPERIOD_CALC' Or #I = ? ) |  | SELECT DISTINCT @ID_ITEM_USED = A.ID_ITEM_USED, @IS_SUM = A.IS_SUM FROM &SCH_TOTAL_REF A WHERE (( A.ID_ITEM = @SAR_ID_TOTAL And @SAR_FEC_VIGENCIA >= A.DT_START And @SAR_FEC_VIGENCIA >= A.DT_START_USED And @SAR_FEC_VIGENCIA <= A.DT_END And @SAR_FEC_VIGENCIA <= A.DT_END_USED And A.ID_TI = @SAR_ID_NODO And ( A.ID_TOTAL_REF_TI = 'SAR_HRPERIOD_CALC' Or A.ID_TOTAL_REF_TI = 'CAR_HRPERIOD_CALC' Or A.ID_TOTAL_REF_TI = @SAR_ID_NODO_CLI ))) ORDER BY A.ID_ITEM_USED ASC, A.IS_SUM ASC 
