'With this method we get the context organization

If SCO_FROM_JS = 0 then
	//Cogemos la sociedad del contexto.
	Code = "Return("+GetChannelId()+"!GETPROPERTY("+CHR(DOUBLE_QUOTE)+"ID_ORGANIZATION"+CHR(DOUBLE_QUOTE)+"))"
	Org = clcExecuteLN4JIT (Code)
ElseIf SCO_MONO <> 0 Then
	//Cogemos la sociedad del parametro.
	If SCO_JS_PAYS_TO_CALC.IsEOF() <> TRUE Then
		Org = SCO_JS_PAYS_TO_CALC.ID_ORGANIZATION
	EndIf
EndIf

Return(Org)
