Begin()
ind_sdi = 0

If SCO_JS_HT_PAYS.SCO_ID_PAY_FREQUENCY = "000" Then
    If GetValue("SCO_HT_PAYS","SCO_P_COUNTRY", -1) = "MX" Then ind_sdi = GetValue("SCO_JS_HT_PAYS","SME_IND_CLC_SDI",-1)
EndIf

If ind_sdi = 1 Then     ' Estandar Mejicana
// Se realiza desde este M4O porque se necesita aplicar el filtro tambien cuando se planifica el calculo del SDI
    Call("","SME_FILTRO_SDI")
Else
    While IsEOF() <> 1
        If SCO_SEL_FILTER = 1 Then
            SCO_JS_HR_PERIOD.SCO_ID_FILTER = SCO_ID_PAYFTR
            SCO_JS_HR_PERIOD.SCO_FILTER_SQL = SCO_FTR_SQL
            SCO_JS_HR_PERIOD.SCO_NM_FILTER = SCO_NM_FTR
            Return(0)
        EndIf
        GoNext()
    Wend
EndIf

Return(0)
