// Filtro para el cálculo del SDI de la nómina Mejicana
// Se monta en éste M4O porque debe tenerse en cuenta también cuando se planifique el cálculo del SDI
// La tabla SCO_H_REG_MOV_SDI contiene a todos los empleados a los que se les deba calcular el SDI
While IsEOF() <> 1
    If SCO_SEL_FILTER = 1 Then
        SCO_JS_HR_PERIOD.SCO_ID_FILTER = SCO_ID_PAYFTR + " + SDI"
        SCO_JS_HR_PERIOD.SCO_FILTER_SQL = SCO_FTR_SQL        
        SCO_JS_HR_PERIOD.SCO_NM_FILTER = SCO_NM_FTR + " + Cálculo del SDI"
        Return(1)
    EndIf
    GoNext()
Wend

Begin()
SCO_SEL_FILTER = 0
SCO_JS_HR_PERIOD.SCO_ID_FILTER = "SDI"
SCO_JS_HR_PERIOD.SCO_FILTER_SQL = ""
SCO_JS_HR_PERIOD.SCO_NM_FILTER = "Cálculo del SDI"

Return(1)
