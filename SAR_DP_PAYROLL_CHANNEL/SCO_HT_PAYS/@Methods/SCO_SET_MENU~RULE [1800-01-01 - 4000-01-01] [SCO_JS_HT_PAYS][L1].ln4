SCO_EXE_MODE = FLAG_MENU
If FLAG_MENU = 1 Then
    SCO_JS_PAYS_TO_CALC.SCO_AUTO_REV = 1
EndIf

If IsNull(FLAG_JS)<>1 Then
    SCO_FROM_JS = FLAG_JS
EndIf

SCO_SET_ORGANIZATION()

sCountry = ""   :   sdi = 0
SAV_PARAMS!SAV_PARAMS.RET_VALUE("THINCLIENT","PORTAL_PARAM","STANDAR")
If SAV_PARAMS!FINAL_RETURN.IsEof() = M4_FALSE Then sCountry = SAV_PARAMS!FINAL_RETURN.APP_VALUE
If sCountry = "MX" Then sdi = 1
SME_IND_CLC_SDI = 0

// ******** Estándar Mejicana ************************
// Para que se tengan en cuenta las nuevas opciones del lanzador, en caso de planificar
// el proceso del cálculo de nómina, las opciones deben codificarse en éste Meta4Object
If FLAG_MENU = 7 And sdi = 1 Then       ' Cálculo del SDI
    SetValue("SCO_HT_PAYS","SCO_P_COUNTRY",-1,sCountry)
    SCO_EXE_MODE = 0                    ' Cálculo normal
    SME_IND_CLC_SDI = 1                 ' Indicador de cálculo del SDI
EndIf

SCO_SET_FILTER_PAY_TYPE(FLAG_MENU)

Return(0)
