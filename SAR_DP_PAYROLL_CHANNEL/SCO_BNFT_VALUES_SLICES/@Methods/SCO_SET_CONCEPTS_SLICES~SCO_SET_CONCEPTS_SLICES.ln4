'Copia cada registro del nodo SCO_BNFT_VALUES (que ya estan filtrados por SCO_ID_TI y SCO_ID_ITEM) y despues de copiarlo lo elimina
dStartDate = GetStartDate()
dEndDate = GetEndDate()

While SCO_BNFT_VALUES_NO_SLICES.IsEOF() = M4_FALSE
    Addregister()
    COPYREGISTER("","SCO_BNFT_VALUES_NO_SLICES")
    SCO_BNFT_VALUES_NO_SLICES.DESTROYREGISTER()
    SCO_BNFT_VALUES_NO_SLICES.Begin()
    'Despues de dejar el concepto tramado, hay que ejecutar un concepto que lo lea directamente (para que se ejecute una vez 
    'por tramo) y que luego se asigne al concepto con el setvalue
Wend

'Como ya estan copiados todos los registros correspondientes al concepto, creamos los tramos y asignamos el valor al concepto entre
'las fechas que tienen valor
dStartRecords = SCO_DT_START..SysTotalItems(M4_TOTAL_MIN)
dEndRecords = SCO_DT_END..SysTotalItems(M4_TOTAL_MAX)
SetStartDate(dStartRecords)
SetEndDate(dEndRecords)

Begin()
sIdTI = SCO_ID_TI
sIdItem = SCO_ID_ITEM
Unflatten("SCO_ID_BNFT_EMP_DEP")
Joinslices()
SCO_CONCEPT(sIdTI,sIdItem)

SetStartDate(dStartDate)
SetEndDate(dEndDate)

DESTROYBLOCK()
