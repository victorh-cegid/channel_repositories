# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_REG02_WUNIT | 0 | 0 | 1 |  | 80 |  |  | #I = '1' |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = C.SCO_OR_HR_PERIOD, @SCO_OR_HR_ROLE = A.SCO_OR_HR_ROLE, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @STD_N_WORK_UNIT = B.STD_N_WORK_UNIT FROM &SCO_H_HR_WUNIT A, STD_WORK_UNIT B, SCO_HR_ROLE C WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_WORK_UNIT = B.STD_ID_WORK_UNIT(+) AND A.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND A.SCO_ID_HR = C.SCO_ID_HR(+) AND A.SCO_OR_HR_ROLE = C.SCO_OR_HR_ROLE(+) AND (C.SCO_MAIN_ROLE = '1') ORDER BY A.SCO_DT_START DESC
