# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GEN_REG_04_SUMA_HRS_JORN | 0 | 0 | 1 |  | 80 |  |  |  \n (  \n	  #I = '3'  \n	  Or  \n	  #I = '4'  \n  )  \n  And  \n  #I <= ?  \n  And  \n  (  \n	  (  \n		  ? = '1'  \n		  And  \n		  #F ( #I ) = ?  \n		  And  \n		  #F ( #I ) = ?  \n	  )  \n	  Or  \n	  (  \n		  ? = '0'  \n		  And  \n		  (  \n			  (  \n				  ? = '0'  \n				  And  \n				  #F ( #I ) = #F ( ? )  \n				  And  \n				  #F ( #I ) = #F ( ? )  \n			  )  \n			  Or  \n			  (  \n				  ? = '1'  \n				  And  \n				  #F ( #I ) = #F ( ? )  \n				  And  \n				  #F ( #I ) = #F ( ? )  \n			  )  \n		  )  \n	  )  \n  ) \n  |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_DT_ALLOCATION = #MAX(A.SCO_DT_ALLOCATION), @SCO_DT_PAYMENT = #MAX(A.SCO_DT_PAYMENT), @SCO_ID_LEG_ENT = A.SCO_ID_LEG_ENT, @SAR_TOT_HRS_TRAB_SIJP = #SUM(A.SAR_TOT_HRS_TRAB_SIJP), @SAR_LSD_IND_PAGO = #MAX(A.SAR_LSD_IND_PAGO), @SAR_LSD_FECHA = #MAX(A.SAR_LSD_FECHA) FROM &SAR_AC_HR_PERIOD A, SCO_HT_PAYS B WHERE A.SCO_DT_ALLOCATION = B.SCO_DT_ACCRUED(+) AND A.SCO_PAY_FREQ_ALLOC = B.SCO_ID_PAY_FREQUENCY(+) AND ((   (  	 B.SCO_ID_PAY_TYPE = '3'  	 Or  	 B.SCO_ID_PAY_TYPE = '4'   )   And   A.SCO_DT_PAYMENT <= @SAR_P_FEC_PAGO   And   (  	 (  		 @SAR_P_CHECK = '1'  		 And  		 #YEAR_DATE ( A.SCO_DT_ALLOCATION ) = @SAR_P_ANIO_RECTIF  		 And  		 #MONTH_DATE ( A.SCO_DT_ALLOCATION ) = @SAR_P_MES_RECTIF  	 )  	 Or  	 (  		 @SAR_P_CHECK = '0'  		 And  		 (  			 (  				 @SAR_P_CHECK_RETRO = '0'  				 And  				 #YEAR_DATE ( A.SAR_LSD_FECHA ) = #YEAR_DATE ( @SAR_P_FEC_PAGO )  				 And  				 #MONTH_DATE ( A.SAR_LSD_FECHA ) = #MONTH_DATE ( @SAR_P_FEC_PAGO )  			 )  			 Or  			 (  				 @SAR_P_CHECK_RETRO = '1'  				 And  				 #YEAR_DATE ( A.SCO_DT_ALLOCATION ) = #YEAR_DATE ( @SAR_P_FEC_IMP_RETRO )  				 And  				 #MONTH_DATE ( A.SCO_DT_ALLOCATION ) = #MONTH_DATE ( @SAR_P_FEC_IMP_RETRO )  			 )  		 )  	 )   )  )) GROUP BY A.SCO_ID_HR, A.SCO_OR_HR_PERIOD, A.SCO_ID_LEG_ENT 
