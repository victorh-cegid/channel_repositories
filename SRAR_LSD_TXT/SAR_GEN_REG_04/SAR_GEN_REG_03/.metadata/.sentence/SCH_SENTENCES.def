# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GEN_REG_03 | 0 | 0 | 1 |  | 80 |  |  |  \n #I = ?  \n  And  \n  ? = '0'  \n  And  \n  ? = #I  \n  And  \n  #I = ?  \n  And  \n  (  \n	  (  \n		  ? = '0'  \n		  And  \n		  #I = #I  \n		  And  \n		  #I = #I  \n	  )  \n	  Or  \n	  (  \n		  ? = '1'  \n		  And  \n		  ? = #I  \n		  And  \n		  ? = #I  \n	  )  \n  ) \n  |  | SELECT @SCO_ID_HR = #MAX(A.SCO_ID_HR), @SCO_DT_ALLOCATION = A.SCO_DT_ALLOCATION, @SCO_DT_PAYMENT = #MAX(A.SCO_DT_PAYMENT), @SAR_TIPO_SALARIO = #MAX(A.SAR_TIPO_SALARIO), @SCO_PAY_FREQ_PAYM = #MAX(A.SCO_PAY_FREQ_PAYM), @SCO_OR_HR_PERIOD = #SUM(A.SCO_OR_HR_PERIOD), @STD_SS_NUMBER = C.STD_SS_NUMBER, @SAR_CUIL = C.SAR_CUIL, @SCO_DT_PAY_START = #MAX(A.SCO_DT_PAY_START), @SAR_TOT_DEV_COTIZ = #SUM(A.SAR_TOT_DEV_COTIZ), @ID_CURRENCY = #MAX(A.ID_CURRENCY), @SCO_DT_EXCHANGE = #MAX(A.SCO_DT_EXCHANGE), @EX_TYPE = #MAX(A.EX_TYPE), @SAR_TOT_SAC_COTIZ = #SUM(A.SAR_TOT_SAC_COTIZ), @SAR_LSD_FECHA = #MAX(A.SAR_LSD_FECHA), @SAR_LSD_IND_PAGO = #MAX(A.SAR_LSD_IND_PAGO) FROM &SAR_AC_HR_PERIOD A, STD_HR_PERIOD B, STD_PERSON C WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_HR = B.STD_ID_HR(+) AND A.SCO_OR_HR_PERIOD = B.STD_OR_HR_PERIOD(+) AND B.STD_ID_HR = C.STD_ID_PERSON(+) AND ((   A.SCO_ID_LEG_ENT = @SAR_P_REG3_LEG_ENT   And   @SAR_P_CHECK = '0'   And   @SAR_P_FREQ_PAGO = A.SCO_PAY_FREQ_PAYM   And   A.SCO_DT_PAYMENT = @SAR_P_FEC_PAGO   And   (  	 (  		 @SAR_P_CHECK_RETRO = '0'  		 And  		 A.SAR_LSD_FECHA = A.SCO_DT_PAYMENT  		 And  		 A.SCO_PAY_FREQ_ALLOC = A.SCO_PAY_FREQ_PAYM  	 )  	 Or  	 (  		 @SAR_P_CHECK_RETRO = '1'  		 And  		 @SAR_P_FEC_IMP_RETRO = A.SCO_DT_ALLOCATION  		 And  		 @SAR_P_FREQ_IMPUT = A.SCO_PAY_FREQ_ALLOC  	 )   )  )) GROUP BY C.SAR_CUIL, C.STD_SS_NUMBER, A.SCO_DT_PAYMENT, A.SCO_DT_ALLOCATION ORDER BY C.SAR_CUIL ASC, C.STD_SS_NUMBER ASC, #MAX(A.SCO_DT_PAYMENT) DESC, A.SCO_DT_ALLOCATION DESC 
