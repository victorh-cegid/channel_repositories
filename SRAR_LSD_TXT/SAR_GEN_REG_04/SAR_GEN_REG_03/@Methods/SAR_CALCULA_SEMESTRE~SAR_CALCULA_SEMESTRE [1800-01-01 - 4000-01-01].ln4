'metodo encargado de calcular los dias del 1er y 2do semestre
vMes = dxMonth(SCO_DT_ALLOCATION)
vAnio = DxYear(SCO_DT_ALLOCATION)
SAR_P_DIAS_SEM = 0 

if vMes < 7 then
    'se calcula el 1er semestre.
    vMesIni  = DxDate(ToInt("01"),ToInt("01"),vAnio)
    vMesFin  = DxDate(ToInt("30"),ToInt("06"),vAnio)
    vDiasSem = DateDiff(vMesIni,vMesFin,m4_day)
ELSE
    'se calcula el 2do semestre.
    vMesIni  = DxDate(ToInt("01"),ToInt("07"),vAnio)
    vMesFin  = DxDate(ToInt("31"),ToInt("12"),vAnio)
    vDiasSem = DateDiff(vMesIni,vMesFin,m4_day)
ENDIF

SAR_P_DIAS_SEM = vDiasSem
