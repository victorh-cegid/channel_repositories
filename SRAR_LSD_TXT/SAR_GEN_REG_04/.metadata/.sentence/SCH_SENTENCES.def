# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GEN_REG_04 | 0 | 0 | 1 |  | 80 |  |  | \n #I = ?  \n  And  \n  (  \n	  (  \n		  ? = '1'  \n		  And  \n		  #F ( #I ) = ?  \n		  And  \n		  #F ( #I ) = ?  \n		  And  \n		  #I <= ?  \n	  )  \n	  Or  \n	  (  \n		  ? = '0'  \n		  And  \n		  #I = ?  \n		  And  \n		  (  \n			  (  \n				  ? = '0'  \n				  And  \n				  #I = #I  \n				  And  \n				  #I = ?  \n			  )  \n			  Or  \n			  (  \n				  ? = '1'  \n				  And  \n				  #I = ?  \n				  And  \n				  #I = ?  \n			  )  \n		  )  \n	  )  \n  )  \n  And  \n  ? = #I  \n  And  \n  #I <> '99' \n |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SAR_CUIL = #MAX(H.SAR_CUIL), @SAR_LSD_DIAS_MES_REPORTE = #MAX(A.SAR_LSD_DIAS_MES_REPORTE), @SAR_CUIL_1 = #MAX(H.SAR_CUIL), @SAR_FECHA_BAJA = #MAX(A.SAR_FECHA_BAJA), @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @STD_SS_NUMBER_1 = #MAX(H.STD_SS_NUMBER), @SCO_ID_LEG_ENT = #MAX(A.SCO_ID_LEG_ENT), @STD_SS_NUMBER = #MAX(H.STD_SS_NUMBER), @SCO_DT_ALLOCATION = #MAX(A.SCO_DT_ALLOCATION), @SAR_FECHA_ALTA = #MAX(A.SAR_FECHA_ALTA), @SCO_DT_PAYMENT = #MAX(A.SCO_DT_PAYMENT), @SAR_LSD_FECHA = #MAX(A.SAR_LSD_FECHA), @SAR_LSD_IND_PAGO = #MAX(A.SAR_LSD_IND_PAGO) FROM &SAR_AC_HR_PERIOD A, STD_HR_PERIOD F, STD_HR G, STD_PERSON H WHERE A.ID_ORGANIZATION = F.ID_ORGANIZATION(+) AND A.SCO_ID_HR = F.STD_ID_HR(+) AND A.SCO_OR_HR_PERIOD = F.STD_OR_HR_PERIOD(+) AND F.ID_ORGANIZATION = G.ID_ORGANIZATION(+) AND F.STD_ID_HR = G.STD_ID_HR(+) AND G.ID_ORGANIZATION = H.ID_ORGANIZATION(+) AND G.STD_ID_HR = H.STD_ID_PERSON(+) AND (\n A.SCO_ID_LEG_ENT = @SAR_P_REG4_LEG_ENT  \n  And  \n  (  \n	  (  \n		  @SAR_P_CHECK = '1'  \n		  And  \n		  #YEAR_DATE (A.SCO_DT_ALLOCATION ) = @SAR_P_ANIO_RECTIF  \n		  And  \n		  #MONTH_DATE (A.SCO_DT_ALLOCATION ) = @SAR_P_MES_RECTIF  \n		  And  \n		  A.SCO_DT_PAYMENT <= @SAR_P_FEC_PAGO  \n	  )  \n	  Or  \n	  (  \n		  @SAR_P_CHECK = '0'  \n		  And  \n		  A.SCO_DT_PAYMENT = @SAR_P_FEC_PAGO  \n		  And  \n		  (  \n			  (  \n				  @SAR_P_CHECK_RETRO = '0'  \n				  And  \n				  A.SCO_DT_ALLOCATION = A.SCO_DT_PAYMENT  \n				  And  \n				  A.SCO_PAY_FREQ_ALLOC = @SAR_P_FREQ_PAGO  \n			  )  \n			  Or  \n			  (  \n				  @SAR_P_CHECK_RETRO = '1'  \n				  And  \n				  A.SCO_DT_ALLOCATION = @SAR_P_FEC_IMP_RETRO  \n				  And  \n				  A.SCO_PAY_FREQ_ALLOC = @SAR_P_FREQ_IMPUT  \n			  )  \n		  )  \n	  )  \n  )  \n  And  \n  @SAR_P_FREQ_PAGO = A.SCO_PAY_FREQ_PAYM  \n  And  \n  A.SCO_PAY_TYPE_PAYM <> '99' \n) GROUP BY H.SAR_CUIL, H.STD_SS_NUMBER, A.SCO_ID_HR, A.SCO_OR_HR_PERIOD ORDER BY H.SAR_CUIL ASC, H.STD_SS_NUMBER ASC, A.SCO_ID_HR ASC, A.SCO_OR_HR_PERIOD ASC
