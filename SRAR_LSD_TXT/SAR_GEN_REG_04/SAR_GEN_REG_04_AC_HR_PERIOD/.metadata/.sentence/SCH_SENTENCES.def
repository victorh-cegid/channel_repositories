# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GEN_REG_04_AC_HR_PERIOD | 0 | 0 | 1 |  | 80 |  |  |  \n #I = ?  \n  And  \n  (  \n	  (  \n		  ? = '1'  \n		  And  \n		  #F ( #I ) = ?  \n		  And  \n		  #F ( #I ) = ?  \n		  And  \n		  #I <= ?  \n	  )  \n	  Or  \n	  (  \n		  ? = '0'  \n		  And  \n		  #I <= ?  \n		  And  \n		  (  \n			  (  \n				  ? = '1'  \n				  And  \n				  #I <> ?  \n				  And  \n				  #F ( #I ) = #F ( ? )  \n				  And  \n				  #F ( #I ) = #F ( ? )  \n			  )  \n			  Or  \n			  (  \n				  ? = '0'  \n				  And  \n				  #F ( #I ) = #F ( ? )  \n				  And  \n				  #F ( #I ) = #F ( ? )  \n			  )  \n		  )  \n	  )  \n  )  \n  And  \n  #I <> '99' \n  |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @STD_SS_NUMBER = H.STD_SS_NUMBER, @SAR_FECHA_BAJA = #MAX(A.SAR_FECHA_BAJA), @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_ID_LEG_ENT = A.SCO_ID_LEG_ENT, @ID_CURRENCY = #MAX(A.ID_CURRENCY), @SCO_DT_EXCHANGE = #MAX(A.SCO_DT_EXCHANGE), @EX_TYPE = #MAX(A.EX_TYPE), @SAR_TOT_AP_OBRA_SOC_SIJP = #SUM(A.SAR_TOT_AP_OBRA_SOC_SIJP), @SAR_ADIC_OB_SOCIAL_IMP = #MAX(A.SAR_ADIC_OB_SOCIAL_IMP), @SAR_MATER_SUAF = #SUM(A.SAR_MATER_SUAF), @SAR_TOTAL_DEVENGOS = #SUM(A.SAR_TOT_DEVENGO), @SAR_TOT_REM_IMP1_SIJP = #SUM(A.SAR_TOT_REM_IMP1_SIJP), @SAR_TOT_REM_IMP2_SIJP = #SUM(A.SAR_TOT_REM_IMP2_SIJP), @SAR_TOT_HRS_TRAB_SIJP = #SUM(A.SAR_TOT_HRS_TRAB_SIJP), @SAR_TOT_REM_IMP5_SIJP = #SUM(A.SAR_TOT_REM_IMP5_SIJP), @SAR_IMP_DEC792 = #SUM(A.SAR_IMP_DEC792), @SAR_TOT_IMP1_SIJP_AUX_1 = #SUM(A.SAR_TOT_IMP1_SIJP_AUX_1), @SAR_REMUN_IMPO_ART = #SUM(A.SAR_REMUN_IMPO_ART), @SAR_IMP_DEC792_NRED = #SUM(A.SAR_IMP_DEC792_NRED), @SAR_BASE_DIF_APO_OS = #SUM(A.SAR_BASE_DIF_APO_OS), @SAR_BASE_DIF_CONTR_OS = #SUM(A.SAR_BASE_DIF_CONTR_OS), @SAR_PRE_ENFER = #MAX(A.SAR_PRE_ENFER), @SAR_ASIGNACION_ESTIMULO = #SUM(A.SAR_ASIGNACION_ESTIMULO), @SAR_TOT_REDUC_IMPO = #SUM(A.SAR_TOT_REDUC_IMPO), @SAR_TOT_REM_SICOSS = #SUM(A.SAR_TOT_REM_SICOSS), @SAR_LIC_ONCO_IMP = #SUM(A.SAR_LIC_ONCO_IMP), @SAR_LSD_IND_PAGO = #MAX(A.SAR_LSD_IND_PAGO), @SAR_TOT_REM_DEC_SIJP = #SUM(A.SAR_TOT_REM_DEC_SIJP), @SAR_LSD_FECHA = #MAX(A.SAR_LSD_FECHA), @SAR_IND_ADH_SUAF = #MAX(A.SAR_IND_ADH_SUAF) FROM &SAR_AC_HR_PERIOD A, STD_HR_PERIOD F, STD_HR G, STD_PERSON H WHERE A.ID_ORGANIZATION = F.ID_ORGANIZATION(+) AND A.SCO_ID_HR = F.STD_ID_HR(+) AND A.SCO_OR_HR_PERIOD = F.STD_OR_HR_PERIOD(+) AND F.ID_ORGANIZATION = G.ID_ORGANIZATION(+) AND F.STD_ID_HR = G.STD_ID_HR(+) AND G.ID_ORGANIZATION = H.ID_ORGANIZATION(+) AND G.STD_ID_HR = H.STD_ID_PERSON(+) AND ((   A.SCO_ID_LEG_ENT = @SAR_P_REG4_LEG_ENT   And   (  	 (  		 @SAR_P_CHECK = '1'  		 And  		 #YEAR_DATE ( A.SCO_DT_ALLOCATION ) = @SAR_P_ANIO_RECTIF  		 And  		 #MONTH_DATE ( A.SCO_DT_ALLOCATION ) = @SAR_P_MES_RECTIF  		 And  		 A.SCO_DT_PAYMENT <= @SAR_P_FEC_PAGO  	 )  	 Or  	 (  		 @SAR_P_CHECK = '0'  		 And  		 A.SCO_DT_PAYMENT <= @SAR_P_FEC_PAGO  		 And  		 (  			 (  				 @SAR_P_CHECK_RETRO = '1'  				 And  				 A.SCO_DT_ALLOCATION <> @SAR_P_FEC_PAGO  				 And  				 #YEAR_DATE ( A.SCO_DT_ALLOCATION ) = #YEAR_DATE ( @SAR_P_FEC_IMP_RETRO )  				 And  				 #MONTH_DATE ( A.SCO_DT_ALLOCATION ) = #MONTH_DATE ( @SAR_P_FEC_IMP_RETRO )  			 )  			 Or  			 (  				 @SAR_P_CHECK_RETRO = '0'  				 And  				 #YEAR_DATE ( A.SAR_LSD_FECHA ) = #YEAR_DATE ( @SAR_P_FEC_PAGO )  				 And  				 #MONTH_DATE ( A.SAR_LSD_FECHA ) = #MONTH_DATE ( @SAR_P_FEC_PAGO )  			 )  		 )  	 )   )   And   A.SCO_PAY_TYPE_PAYM <> '99'  )) GROUP BY A.SCO_ID_LEG_ENT, A.SCO_ID_HR, A.SCO_OR_HR_PERIOD, H.STD_SS_NUMBER ORDER BY H.STD_SS_NUMBER ASC 
