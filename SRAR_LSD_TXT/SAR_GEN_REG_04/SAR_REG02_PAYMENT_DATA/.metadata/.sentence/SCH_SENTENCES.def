# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_REG02_PAYMENT_DATA | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_ID_PAYM_TYPE = A.SCO_ID_PAYM_TYPE, @SCO_ID_ORIGIN_TYPE = A.SCO_ID_ORIGIN_TYPE, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @SUK_EMPLOYEE_REFNO = B.SUK_EMPLOYEE_REFNO FROM &SCO_PAYMENT_DATA A, SCO_PERSON_BANK B WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_PERSON = B.SCO_ID_PERSON(+) AND A.SCO_OR_ACCOUNT = B.SCO_OR_ACCOUNT(+) AND (A.SCO_DT_START <= @SAR_P_FIN And A.SCO_DT_END >= @SAR_P_INICIO)
