# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GEN_REG4_H_ACTIVIDAD | 0 | 0 | 1 |  | 80 |  |  | ( #I <= ? And #I >= ? ) |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_ROLE = A.SCO_OR_HR_ROLE, @DT_START = A.DT_START, @DT_END = A.DT_END, @SAR_ID_ACTIVIDAD = A.SAR_ID_ACTIVIDAD, @SCO_ID_REASON_CHANGE = A.SCO_ID_REASON_CHANGE FROM &SAR_H_HR_ACTIV A WHERE (( A.DT_START <= @SAR_P_DT_FIN And A.DT_END >= @SAR_P_DT_INICIO )) ORDER BY A.DT_END DESC
