# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GEN_REG4_WLOC | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_ROLE = A.SCO_OR_HR_ROLE, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @SCO_ID_WORK_LOCATION = A.SCO_ID_WORK_LOCATION, @SAR_ID_ZONA_DGI = B.SAR_ID_ZONA_DGI FROM &SCO_H_HR_WLOCATION A, STD_WORK_LOCATION B WHERE A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.SCO_ID_WORK_LOCATION = B.STD_ID_WORK_LOCATION(+) AND (A.SCO_DT_START <= @SAR_P_DT_FIN And A.SCO_DT_END >= @SAR_P_DT_INICIO) ORDER BY A.SCO_DT_END DESC
