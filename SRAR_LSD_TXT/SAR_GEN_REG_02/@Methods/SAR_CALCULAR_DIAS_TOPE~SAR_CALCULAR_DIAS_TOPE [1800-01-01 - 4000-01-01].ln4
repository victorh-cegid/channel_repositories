/****************************************************************************************
'        ID: SAR_CALCULAR_DIAS_TOPE
'        Nombre: Calula cant. de dias para proporcionar tope
'        Fecha: 09/10/2015
'        Autor: emmanueln
'        Descripcion:  en este metodo se realiza el calculo de dias topes
'*****************************************************************************************/

InicioPaga = SAR_P_INICIO
MMInicPaga = DxMonth ( InicioPaga )
AAInicPaga = DxYear  ( InicioPaga )

'calculo la cantidad de dias en el mes de la generacion del archivo, tope de 30 dias, para calcular normalizado
vDiasMesActual = Min(DaysOfMonth(SAR_P_INICIO), 30)

PrimerDiaP = DxDate (              1 , MMInicPaga , AAInicPaga )          // primer dia del mes de liquidacion
UltimoDiaP = DxDate ( vDiasMesActual , MMInicPaga , AAInicPaga )          // ultimo dia del mes de liquidacion

'calcular los dias si el empleado esta dado de alta en el mes de la generacion del archivo
vDias = CommonTime( Date30Ex(PrimerDiaP) , Date30Ex(UltimoDiaP) , Date30Ex(SAR_FECHA_ALTA) , Date30Ex(SAR_FECHA_BAJA))

If vDias >= vDiasMesActual Then
    vDiasTope = 0
Else
'    vDiasTope = vDias
    vDiasTope = SAR_TOT_DIAS_TRAB_SIJP
    If vDiasTope = 0 Then
        vDiasTope = vDias
    EndIf
EndIf

'Devuelvo el valor de los dias para el tope, en caso de que sea igual a la cantidad del mes devuelve 0 (cero)
Return(vDiasTope)
