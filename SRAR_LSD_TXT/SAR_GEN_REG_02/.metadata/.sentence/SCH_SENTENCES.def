# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GEN_REG_02 | 0 | 0 | 1 |  | 80 |  |  | #I = ? And ? = '0' And ? = #I And ? = #I And ( ( ? = '0' And #I = #I And #I = #I ) Or ( ? = '1' And #I = ? And ? = #I ) ) |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @ID_ORGANIZATION = #MAX(A.ID_ORGANIZATION), @SCO_DT_PAYMENT = #MAX(A.SCO_DT_PAYMENT), @SAR_FECHA_ALTA = #MAX(A.SAR_FECHA_ALTA), @SAR_FECHA_BAJA = #MAX(A.SAR_FECHA_BAJA), @SAR_TOT_DIAS_TRAB_SIJP = #SUM(A.SAR_TOT_DIAS_TRAB_SIJP), @ID_CURRENCY = #MAX(A.ID_CURRENCY), @SCO_DT_EXCHANGE = #MAX(A.SCO_DT_EXCHANGE), @EX_TYPE = #MAX(A.EX_TYPE), @SAR_LSD_IND_PAGO = #MAX(A.SAR_LSD_IND_PAGO), @SAR_LSD_FECHA = #MAX(A.SAR_LSD_FECHA) FROM &SAR_AC_HR_PERIOD A, STD_HR_PERIOD C, STD_HR F, STD_PERSON G WHERE A.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND A.SCO_ID_HR = C.STD_ID_HR(+) AND A.SCO_OR_HR_PERIOD = C.STD_OR_HR_PERIOD(+) AND C.ID_ORGANIZATION = F.ID_ORGANIZATION(+) AND C.STD_ID_HR = F.STD_ID_HR(+) AND F.ID_ORGANIZATION = G.ID_ORGANIZATION(+) AND F.STD_ID_HR = G.STD_ID_PERSON(+) AND (A.SCO_ID_LEG_ENT = @SAR_P_REG2_LEG_ENT And @SAR_P_CHECK = '0' And @SAR_P_FEC_PAGO = A.SCO_DT_PAYMENT And @SAR_P_FREQ_PAGO = A.SCO_PAY_FREQ_PAYM And ( ( @SAR_P_CHECK_RETRO = '0' And A.SCO_DT_PAYMENT = A.SCO_DT_ALLOCATION And A.SCO_PAY_FREQ_ALLOC = A.SCO_PAY_FREQ_PAYM ) Or ( @SAR_P_CHECK_RETRO = '1' And A.SCO_PAY_FREQ_ALLOC = @SAR_P_FREQ_IMPUT And @SAR_P_FEC_IMP_RETRO = A.SCO_DT_ALLOCATION ) )) GROUP BY G.SAR_CUIL, G.STD_SS_NUMBER, A.SCO_ID_HR, A.SCO_OR_HR_PERIOD ORDER BY G.SAR_CUIL ASC, G.STD_SS_NUMBER ASC, A.SCO_ID_HR ASC, A.SCO_OR_HR_PERIOD ASC
