/****************************************************************************************
        ID: SAR_GENERA_REG_05
        Nombre: Genera registro 05 para Libro Sueldo Digital
        Fecha: 29/09/2015
        Autor: emmanueln
        Descripcion:  en este metodo se realiza la obtencion de los datos de la empresa, 
                        segun lo solicitado para el armado del archivo
*****************************************************************************************/
'Inicio el nodo principal
begin()


vCompleto = " " 'variable con la que se completan los caracteres en caso de que los valores no completen los lugares asignados por el layout
vmargen = "I" 'D=derecha y I=izquierda

IF COUNT() > 0   THEN
    'inicio los nodos que voy a utilizar
   
    WHILE ISEOF() = M4_FALSE 'mientras tengo datos recorro el la tabla de Emp Eventuales
        SAR_INICIAR_NODOS()
        
        IF SAR_REG_05_STD_PERIOD.COUNT() > 0 THEN
            SAR_TXT_GENERADOR.SAR_NVA_LINEA()
            
            
        '1.- Identificacion del tipo de registro
            'campo 01: valor fijo "05" long: 2 posicion txt: 1 a 2 (alfanumerico)
            vID_Tipo_reg = "05"
            
            SAR_TXT_GENERADOR.SAR_AGREGAR_TEXTO(vID_Tipo_reg,2,vCompleto,vmargen)
            
            
        '2.- CUIL del trabajador
            'campo 02: STD_SS_NUMBER o SAR_CUIL long: 11 posicion txt: 3 a 13 (alfanumerico)
            IF ISNULL(SAR_REG_05_STD_PERIOD.SAR_CUIL)= M4_TRUE THEN
                vEmpleado = SAR_REG_05_STD_PERIOD.STD_SS_NUMBER
            ELSE
                vEmpleado = SAR_REG_05_STD_PERIOD.SAR_CUIL
            ENDIF            
            vEmpleado = replace(vEmpleado,"-","") 'en caso de que haya "-" (guiones) se los borra para que el numero quede limpio
            vEmpleado = replace(vEmpleado,".","") 'en caso de que haya "." (puntos) se los borra para que el numero quede limpio
                    
            SAR_TXT_GENERADOR.SAR_AGREGAR_TEXTO(vEmpleado,11,vCompleto,vmargen)
            
            
        '3.- Categoria profesional
            'campo 03: SAR_ID_CATEGORIA  long: 6 posicion txt: 14 a 19 (alfanumerico)
            vCatProf = SAR_REG_05_STD_PERIOD.SAR_ID_CATEGORIA
    
            SAR_TXT_GENERADOR.SAR_AGREGAR_TEXTO(vCatProf,6,vCompleto,vmargen)
        
        
        '4.- Puesto desempe?ado
            'campo 04: SCO_ID_JOB_CODE long: 4 posicion txt: 20 a 23 (alfanumerico)
            vPuestoDesemp = SAR_REG_05_STD_PERIOD.SCO_ID_JOB_CODE
            
            SAR_TXT_GENERADOR.SAR_AGREGAR_TEXTO(vPuestoDesemp,4,vCompleto,vmargen)
            
            
        '5.- Fecha de ingreso
            'campo 05:  long: 8 posicion txt: 24 a 31 (alfanumerico)
            vDiaFecIni = tostring(dxDay (SAR_REG_05_STD_PERIOD.STD_DT_START),0)
            vMesFecIni =  tostring(dxMonth (SAR_REG_05_STD_PERIOD.STD_DT_START),0)
            vAnioFecIni = tostring(DxYear (SAR_REG_05_STD_PERIOD.STD_DT_START),0)
        
            IF Length(vDiaFecIni) < 2 THEN
               vDiaFecIni= "0" + vDiaFecIni
            ENDIF
            IF Length(vMesFecIni) < 2 THEN
               vMesFecIni= "0" + vMesFecIni
            ENDIF  
            vfechaFecIni = vAnioFecIni + vMesFecIni + vDiaFecIni    
            
            SAR_TXT_GENERADOR.SAR_AGREGAR_TEXTO(vfechaFecIni,8,vCompleto,vmargen)
            
            
        '6.- Fecha de egreso
            'campo 06:  long: 8 posicion txt: 32 a 39 (alfanumerico)
            vFechaEgreso = SAR_REG_05_STD_PERIOD.STD_DT_END
            IF vFechaEgreso <= SAR_P_FIN THEN
                vDiaFecFin = tostring(dxDay (vFechaEgreso),0)
                vMesFecFin =  tostring(dxMonth (vFechaEgreso),0)
                vAnioFecFin = tostring(DxYear (vFechaEgreso),0)
                
                IF Length(vDiaFecFin) < 2 THEN
                   vDiaFecFin= "0" + vDiaFecFin
                ENDIF
                IF Length(vMesFecFin) < 2 THEN
                   vMesFecFin= "0" + vMesFecFin
                ENDIF
                vfechaFecFin = vAnioFecFin + vMesFecFin + vDiaFecFin
            ELSE
                vfechaFecFin = " "
            
            ENDIF
                       
            SAR_TXT_GENERADOR.SAR_AGREGAR_TEXTO(vfechaFecFin,8,vCompleto,vmargen)
            
            
        '7.- Remuneracion
            'campo 07: SAR_SUELDO long: 15 posicion txt: 40 a 54 (alfanumerico)
            vRemuneracion = tostring(SAR_GEN_REG_5_AC_EMP_AGEN_ART.SAR_SUELDO,2)
            vRemuneracion = replace(vRemuneracion,".","") 'en caso de que haya "." (puntos) se los elimina de la cadena para que el formato del layout sea correcto    
            vRemuneracion = replace(vRemuneracion,",","") 'en caso de que haya "." (puntos) se los elimina de la cadena para que el formato del layout sea correcto
            
            SAR_TXT_GENERADOR.SAR_AGREGAR_TEXTO(vRemuneracion,15,vCompleto,vmargen)
            
            
        '8.- CUIT del empleador
            'campo 08: STD_NID_ENT long: 11 posicion txt: 55 a 65 (alfanumerico)
            vCuilEmpleador = SAR_REG_05_STD_PERIOD.SCO_ID_LEGAL
        
            vCuilEmpleador = replace(vCuilEmpleador,"-","") 'en caso de que haya "-" (guiones) se los borra para que el numero quede limpio
        
            SAR_TXT_GENERADOR.SAR_AGREGAR_TEXTO(vCuilEmpleador,11,vCompleto,vmargen)
            
            
            SAR_TXT_GENERADOR.SAR_FIN_LINEA()
        ENDIF
    GONEXT()
    WEND
ENDIF
