# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_GEN_REG_5_AC_EMP_AGEN_ART | 0 | 0 | 1 |  | 80 |  |  | #I = ? And ( ( ? = '1' And #F ( #I ) = ? And #F ( #I ) = ? And #I <= ? ) Or ( ? = '0' And #I <= ? And #F ( #I ) = #F ( ? ) And #F ( #I ) = #F ( ? ) ) ) And #I <= ? And #I >= ? |  | SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @SAR_SUELDO = #SUM(A.SAR_SUELDO), @SAR_CANT_DAY_TRAB = #MAX(A.SAR_CANT_DAY_TRAB), @SAR_CANT_HS_TRAB = #MAX(A.SAR_CANT_HS_TRAB), @SAR_BASE_REMUNERACION_ART9 = #SUM(A.SAR_BASE_REMUNERACION_ART9) FROM &SAR_AC_HR_EMP_AGEN_ART A, SCO_H_HR_LEGAL_ENTITY B, STD_HR_PERIOD C WHERE A.STD_ID_HR = B.SCO_ID_HR(+) AND A.STD_ID_LEG_ENT = B.SCO_ID_LEG_ENT(+) AND A.STD_OR_HR_PERIOD = B.SCO_OR_HR_PERIOD(+) AND B.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND B.SCO_ID_HR = C.STD_ID_HR(+) AND B.SCO_OR_HR_PERIOD = C.STD_OR_HR_PERIOD(+) AND (A.STD_ID_LEG_ENT = @SAR_P_REG5_LEG_ENT And ( ( @SAR_P_CHECK = '1' And #YEAR_DATE (A.SAR_FECHA_IMPUTACION ) = @SAR_P_ANIO_RECTIF And #MONTH_DATE (A.SAR_FECHA_IMPUTACION ) = @SAR_P_MES_RECTIF And A.SAR_FEC_PAGO <= @SAR_P_FEC_PAGO ) Or ( @SAR_P_CHECK = '0' And A.SAR_FEC_PAGO <= @SAR_P_FEC_PAGO And #YEAR_DATE (A.SAR_FECHA_IMPUTACION ) = #YEAR_DATE (@SAR_P_FEC_PAGO ) And #MONTH_DATE (A.SAR_FECHA_IMPUTACION ) = #MONTH_DATE (@SAR_P_FEC_PAGO ) ) ) And C.STD_DT_START <= @SAR_P_FIN And C.STD_DT_END >= @SAR_P_INICIO) GROUP BY A.STD_ID_LEG_ENT, A.STD_ID_HR, A.STD_OR_HR_PERIOD ORDER BY A.STD_ID_HR ASC
