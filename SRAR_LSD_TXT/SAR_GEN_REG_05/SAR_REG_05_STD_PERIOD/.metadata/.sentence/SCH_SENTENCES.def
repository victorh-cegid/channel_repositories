# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_REG_05_STD_PERIOD | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? And #I <= ? And #I >= ? And #I (+) = '1' And #I (+) <= ? And #I (+) >= ? And #I (+) <= ? And #I (+) >= ? And #I (+) <= ? And #I (+) >= ? |  | SELECT @STD_ID_HR = A.STD_ID_HR, @SCO_ID_JOB_CODE = J.SCO_ID_JOB_CODE, @SAR_ID_ACTIVIDAD = K.SAR_ID_ACTIVIDAD, @SAR_ID_ZONA_DGI = M.SAR_ID_ZONA_DGI, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @STD_DT_START = A.STD_DT_START, @STD_DT_END = A.STD_DT_END, @SAR_CUIL = C.SAR_CUIL, @SCO_ID_LEGAL = E.SCO_ID_LEGAL, @SAR_ID_COD_SINIES = G.SAR_ID_COD_SINIES, @SAR_ID_COD_COND = G.SAR_ID_COD_COND, @SAR_ID_SIT_REVISTA = G.SAR_ID_SIT_REVISTA, @SAR_ID_MOD_CONTRAT = G.SAR_ID_MOD_CONTRAT, @SCO_DT_START = G.SCO_DT_START, @SCO_DT_END = G.SCO_DT_END, @SAR_ID_CATEGORIA = H.SAR_ID_CATEGORIA, @STD_SS_NUMBER = C.STD_SS_NUMBER FROM &STD_HR_PERIOD A, STD_HR B, STD_PERSON C, SAR_H_EXTERNAL_ORG D, STD_EXTERNAL_ORGANIZATION E, SCO_H_EMPLOYEE_TYPE G, SAR_H_CATEGORIA H, STD_WORK_LOCATION M, SCO_H_HR_WLOCATION L, SAR_H_HR_ACTIV K, SCO_H_HR_JOB J, SCO_HR_ROLE I WHERE D.ID_ORGANIZATION(+) = A.ID_ORGANIZATION AND D.STD_ID_HR(+) = A.STD_ID_HR AND D.STD_OR_HR_PERIOD(+) = A.STD_OR_HR_PERIOD AND G.ID_ORGANIZATION(+) = A.ID_ORGANIZATION AND G.SCO_ID_HR(+) = A.STD_ID_HR AND G.SCO_OR_HR_PERIOD(+) = A.STD_OR_HR_PERIOD AND H.ID_ORGANIZATION(+) = A.ID_ORGANIZATION AND H.STD_ID_HR(+) = A.STD_ID_HR AND H.STD_OR_HR_PERIOD(+) = A.STD_OR_HR_PERIOD AND I.ID_ORGANIZATION(+) = A.ID_ORGANIZATION AND I.SCO_ID_HR(+) = A.STD_ID_HR AND I.SCO_OR_HR_PERIOD(+) = A.STD_OR_HR_PERIOD AND A.ID_ORGANIZATION = B.ID_ORGANIZATION(+) AND A.STD_ID_HR = B.STD_ID_HR(+) AND B.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND B.STD_ID_HR = C.STD_ID_PERSON(+) AND D.ID_ORGANIZATION = E.ID_ORGANIZATION(+) AND D.STD_ID_EXTERNAL_ORG = E.STD_ID_EXTERNAL_ORG(+) AND L.ID_ORGANIZATION = M.ID_ORGANIZATION(+) AND L.SCO_ID_WORK_LOCATION = M.STD_ID_WORK_LOCATION(+) AND J.ID_ORGANIZATION(+) = I.ID_ORGANIZATION AND J.SCO_ID_HR(+) = I.SCO_ID_HR AND J.SCO_OR_HR_ROLE(+) = I.SCO_OR_HR_ROLE AND K.ID_ORGANIZATION(+) = I.ID_ORGANIZATION AND K.SCO_ID_HR(+) = I.SCO_ID_HR AND K.SCO_OR_HR_ROLE(+) = I.SCO_OR_HR_ROLE AND L.ID_ORGANIZATION(+) = I.ID_ORGANIZATION AND L.SCO_ID_HR(+) = I.SCO_ID_HR AND L.SCO_OR_HR_ROLE(+) = I.SCO_OR_HR_ROLE AND (G.SCO_DT_START <= @SAR_P_FIN And G.SCO_DT_END >= @SAR_P_INICIO And D.SAR_DT_START <= @SAR_P_FIN And D.SAR_DT_END >= @SAR_P_INICIO And I.SCO_MAIN_ROLE (+) = '1' And K.DT_START (+) <= @SAR_P_FIN And K.DT_END (+) >= @SAR_P_INICIO And M.STD_DT_START (+) <= @SAR_P_FIN And M.STD_DT_END (+) >= @SAR_P_INICIO And J.SCO_DT_START (+) <= @SAR_P_FIN And J.SCO_DT_END (+) >= @SAR_P_INICIO) ORDER BY A.STD_DT_END ASC
