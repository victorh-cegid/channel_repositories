/*****************************************************************************************
    METODO PUBLICO                                                              11/04/2016  
    NO MODIFICAR NI SOBRESCRIBIR!                                          Autor: VICTORMG
    
    Devuelve el valor del campo SLA_VALOR

    IMPORTANTE:
    Antes de utilizar este metodo es imprescindible haber ejecutado el metodo SLA_CARGAR_CONFIGURACION.
    
    Argumentos de entrada:
        KEY_ARG:    Cadena variable. Recibira el identificador del parametro correspondiente con el 
                    valor perteneciente a la columna SLA_ID_PARAMETRO de la tabla SLA_CONFIGURA_PROCESOS.
        
    Conversiones:
        -En caso de ser una ruta, comprueba que este debidamente cerrada y que no posea caracteres incorrectos, CC: devuelve ruta por defecto CVM-tempdir. 
         Ademas se comprueba la existencia de una ruta parametrizable en el regmeta4.xml, delimitada por "?" y separada por ":", en caso de hallarla
         se sustituye por el valor asociado y se continua con las comprobaciones (que incluye posibles valores dinamicos)
         Se comprueba la existencia de valores dinamicos dentro de la ruta, delimitados por "*" y separado por ":", en caso de encontrarlos, se sustuyen por
         el valor correspondiente.
        -En caso de ser un numero se encarga de convertirlo adecuadamente.
        -En caso de ser una fecha se encarga de convertirla al formato Fecha.
****************************************************************************************/

BEGIN()
vEncontrado = M4_FALSE
WHILE IsEof() = M4_FALSE AND vEncontrado = M4_FALSE
    IF SLA_ID_PARAMETRO <> PARA_ARG THEN
        GONEXT()
    ELSE
        vEncontrado = M4_TRUE
    ENDIF
WEND

IF vEncontrado = M4_FALSE THEN
    Return( nullvalue() )
ENDIF

POS = 0
POS_FIN = 0
SEPARADOR = 0
DetectadoError = M4_FALSE
'Comprobamos si es una ruta analizando:
'    -Los tres primeros caracteres -> "X:\"
'       OR
'    -Los cinco primeros caracteres -> "PATH?"
IF ( MID(SLA_VALOR,0,5) = "PATH?" ) OR ( Ascii(mid(SLA_VALOR, 0, 1)) >= 65 AND Ascii(mid(SLA_VALOR, 0, 1)) <= 90 AND ( MID(SLA_VALOR, 1,2) = ":\" OR MID(SLA_VALOR, 1,2) = ":/" ) ) THEN    'Aqui ya sabemos que es una ruta, ahora, si es necesario, la procesamos.
    
    'Se comprueba si estamos ante un path parametrizable y se sustituye. CC se omite.
    'Dicha parametrizacion hace regerencia al archivo Regmeta4.xml o regedit de windows y debe ir delimitada por Path?elemento:atributo?\rutarelativa
    IF MID(SLA_VALOR,4,1) = "?" THEN
        POS = 4
        SEPARADOR = IndexOf(SLA_VALOR, ":",POS+1)
        POS_FIN = IndexOf(SLA_VALOR, "?",POS+1)
        IF POS_FIN = -1 OR SEPARADOR = -1 THEN
            DetectadoError = M4_TRUE
        ELSE
            elemento = ".\"+MID(SLA_VALOR, POS+1, SEPARADOR - (POS +1) )
            atributo = MID(SLA_VALOR, SEPARADOR+1, POS_FIN - (SEPARADOR+1) )
    			
    	      'Guardamos el valor en una variable temporal
    		TMP_VALOR = GetRegistryValue(elemento,atributo) 
    		'Se comprueba que la ruta termine cerrando con barra invertida. CC se a?ade.
    		IF MID(TMP_VALOR, LENGTH(TMP_VALOR) -1, 1) <> "\" THEN
    			TMP_VALOR = TMP_VALOR + "\" 
    		ENDIF
    			
            IF LENGTH( SLA_VALOR ) > POS_FIN+1 THEN 'Si hay mas path aparte del parametro, deberemos concatenarlo                
                TMP_VALOR = TMP_VALOR +MID(SLA_VALOR, POS_FIN+1, LENGTH( SLA_VALOR ) - (POS_FIN+1) )
                IF mid(TMP_VALOR, LENGTH(TMP_VALOR)-1, 1) <> "\" THEN
    			TMP_VALOR = TMP_VALOR + "\" 
         	    ENDIF
    		ENDIF
    		SLA_VALOR = TMP_VALOR
        ENDIF'IF POS_FIN = -1 OR SEPARADOR = -1 THEN
    ENDIF 'IF MID(SLA_VALOR,4,1) = "?" THEN

    'Se comprueba si existen valores dinamicos y se sustituyen. CC se omite.
    POS = 0
    POS = IndexOf(SLA_VALOR, "*",0)
    WHILE POS <> 0 AND POS <> -1 AND DetectadoError = M4_FALSE
        'Ha encontrado alguna apertura.
        SEPARADOR = IndexOf(SLA_VALOR, ":",POS+1)
        POS_FIN = IndexOf(SLA_VALOR, "*",POS+1)
        IF POS_FIN = -1 OR SEPARADOR = -1 THEN
            DetectadoError = M4_TRUE
        ELSE
            D_NODO = MID(SLA_VALOR, POS+1, SEPARADOR - ( POS+1) ) 
            D_CAMPO = MID(SLA_VALOR, SEPARADOR+1, POS_FIN - (SEPARADOR+1) )
            PARAM = ToString( getValue(D_NODO, D_CAMPO, -1) )
            SLA_VALOR = Replace(SLA_VALOR, "*"+D_NODO+":"+D_CAMPO+"*",PARAM)    'Se sustituye todo el valor dinamico por el texto que procesa.
            POS = IndexOf(SLA_VALOR, "*",0) 'Se busca por si hubiera mas parametros dinamicos.
        ENDIF   'IF POS_FIN = -1 OR SEPARADOR = -1 THEN
    WEND 'WHILE POS <> 0 AND POS <> -1

    'Comprobamos que la cadena no contenga los caracteres prohibidos en un path, a saber: / : * ? " < > |
    POS = 3
    WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE)
        caracter = mid(SLA_VALOR, POS, 1)
        IF Ascii(caracter)=47 OR Ascii(caracter)=58 OR Ascii(caracter)=42 OR Ascii(caracter)=63 OR Ascii(caracter)=34 OR Ascii(caracter)=60 OR Ascii(caracter)=62 OR Ascii(caracter)=124  THEN
            DetectadoError = M4_TRUE
        ELSE
            POS = POS +1
        ENDIF
    WEND 'WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE)
    
    VALOR_PATH = ""
    IF DetectadoError = M4_TRUE THEN
        VALOR_PATH = GetRegistryValue("CVM","tempdir") 
    ELSE
        VALOR_PATH = SLA_VALOR
    ENDIF
    'Analizamos de nuevo que el final de la ruta termine con barra inversa, salvo que tenga extension y por tanto sea un archivo
    IF mid(VALOR_PATH, LENGTH(VALOR_PATH)-1, 1) <> "\" AND mid(VALOR_PATH, LENGTH(VALOR_PATH)-4, 1) <> "." THEN
        VALOR_PATH = VALOR_PATH + "\" 
    ENDIF
    Return( VALOR_PATH ) 'Devolvemos el valor final, sea la ruta correcta o la por defecto.
ENDIF '( (Ascii(mid(SLA_VALOR, 0, 1)) >= 65 AND Ascii(mid(SLA_VALOR, 0, 1)) <= 90).......
'Punto de fuga, en caso de ruta.

'Comprobamos si es una fecha (solo dias) 01/01/1800    
IF LENGTH(SLA_VALOR) = 10 THEN
    'DD/MM/AAAA
    IF Ascii(mid(SLA_VALOR, 2, 1)) = 47 AND Ascii(mid(SLA_VALOR, 5, 1)) = 47 THEN
        'Se comprueba que efectivamente el resto de caracteres son numeros.
        POS = 0
        DetectadoError = M4_FALSE
        WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE )
            caracter = mid(SLA_VALOR, POS, 1)
            IF Ascii(caracter) >= 48 AND Ascii(caracter) <= 57 OR Ascii(caracter) = 47 THEN
                POS = POS +1
            ELSE
                DetectadoError = M4_TRUE
            ENDIF
            
            IF DetectadoError = M4_FALSE THEN
                Return( ToDate ( chr(34)+mid(SLA_VALOR, 6, 4)+"/"+mid(SLA_VALOR, 3, 2)+"/"+mid(SLA_VALOR, 0, 2)+chr(34) ) )
            ENDIF
        WEND 'WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE)
    ENDIF 'Ascii(mid(SLA_VALOR, 2, 1)) = 47 AND Ascii(mid(SLA_VALOR, 2, 1)) = 47
    
    'AAAA/MM/DD
    IF Ascii(mid(SLA_VALOR, 4, 1)) = 47 AND Ascii(mid(SLA_VALOR, 7, 1)) = 47 THEN
        'Se comprueba que efectivamente el resto de caracteres son numeros.
        POS = 0
        DetectadoError = M4_FALSE
        WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE )
            caracter = mid(SLA_VALOR, POS, 1)
            IF Ascii(caracter) >= 48 AND Ascii(caracter) <= 57 OR Ascii(caracter) = 47 THEN
                POS = POS +1
            ELSE
                DetectadoError = M4_TRUE
            ENDIF            
            IF DetectadoError = M4_FALSE THEN
                Return( ToDate ( chr(34)+mid(SLA_VALOR, 0, 4)+"/"+mid(SLA_VALOR, 5, 2)+"/"+mid(SLA_VALOR, 8, 2)+chr(34) ) )
            ENDIF
        WEND 'WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE)
    ENDIF 'Ascii(mid(SLA_VALOR, 2, 1)) = 47 AND Ascii(mid(SLA_VALOR, 2, 1)) = 47
ENDIF 'LENGTH(SLA_VALOR) = 10
    
'Comprobamos si es una fecha (dias y horas) 01/01/1800 12:00:00
IF LENGTH(SLA_VALOR) = 19 THEN
    'DD/MM/AAAA HH:MM:SS
    IF Ascii(mid(SLA_VALOR, 2, 1)) = 47 AND Ascii(mid(SLA_VALOR, 5, 1)) = 47 AND Ascii(mid(SLA_VALOR, 13, 1)) = 58 AND Ascii(mid(SLA_VALOR, 16, 1)) = 58 AND Ascii(mid(SLA_VALOR, 10, 1)) = 32 THEN
        'Se comprueba que efectivamente el resto de caracteres son numeros.
        POS = 0
        DetectadoError = M4_FALSE
        WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE )
            caracter = mid(SLA_VALOR, POS, 1)
            IF Ascii(caracter) >= 48 AND Ascii(caracter) <= 57 OR Ascii(caracter) = 47 OR Ascii(caracter) = 58 OR Ascii(caracter) = 32 THEN
                POS = POS +1
            ELSE
                DetectadoError = M4_TRUE
            ENDIF
            IF DetectadoError = M4_FALSE THEN
                Return( ToDate ( chr(34)+mid(SLA_VALOR, 6, 4)+"/"+mid(SLA_VALOR, 3, 2)+"/"+mid(SLA_VALOR, 0, 2)+" "+mid(SLA_VALOR, 11, 2)+":"+mid(SLA_VALOR, 14, 2)+":"+mid(SLA_VALOR, 17, 2)+chr(34) ) )
            ENDIF
        WEND 'WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE)
    ENDIF 'Ascii(mid(SLA_VALOR, 2, 1)) = 47 AND Ascii(mid(SLA_VALOR, 2, 1)) = 47
ENDIF 'LENGTH(SLA_VALOR) = 19  
'Punto de fuga, en caso de fecha.

'Comprobamos si es un numero, con decimales o sin ellos.
POS = 0
Puntos = 0
PosPunto = -1
WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE)
    caracter = mid(SLA_VALOR, POS, 1)
    IF Ascii(caracter) >= 48 AND Ascii(caracter) <= 57 THEN
        POS = POS +1
    ELSEIF Ascii(caracter) = 46 OR Ascii(caracter) = 44 THEN
        Puntos = Puntos +1
        POS = POS +1
        IF Puntos > 1 THEN DetectadoError = M4_TRUE
    ELSE
        DetectadoError = M4_TRUE
    ENDIF
WEND 'WHILE (POS < LENGTH(SLA_VALOR) AND DetectadoError = M4_FALSE)
IF DetectadoError = M4_FALSE THEN
    IF Puntos = 1 THEN 'Devolvemos con decimales
        Return( ToDouble(SLA_VALOR) )
    ELSE    'Devolvemos sin decimales
        Return( ToInt(SLA_VALOR) )
    ENDIF
ENDIF
'Punto de fuga, en caso de un numero.

'Caso general, devolvemos la cadena
Return ( SLA_VALOR )
