/*********************************************************************
   ID: SAR_SET_CAR_INI_LINEA
   Nombre: Caracter inicial
   Fecha: 17/09/2015
   Autor: emmanueln
   Argumentos: ARG_CAR_INI_LINEA
   Descripcion: el argumento tiene como funcion insertar un valor (hasta 3 caracteres) en la linea del txt)
*********************************************************************/

IF ARG_CAR_INI_LINEA <> NULLVALUE() THEN
    P_CARACTER_INI = ARG_CAR_INI_LINEA
ELSE
    P_CARACTER_INI = ""
ENDIF
