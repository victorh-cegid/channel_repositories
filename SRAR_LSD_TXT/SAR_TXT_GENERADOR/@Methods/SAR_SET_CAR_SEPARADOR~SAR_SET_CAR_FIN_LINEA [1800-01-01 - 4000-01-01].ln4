/*********************************************************************
   ID: SAR_SET_CAR_SEPARADOR
   Nombre: Caracter final
   Fecha: 17/09/2015
   Autor: emmanueln
   Argumentos: ARG_CAR_SEPARADOR
   Descripcion: el argumento tiene como funcion insertar un valor (hasta 3 caracteres) en la linea del txt)
*********************************************************************/

IF ARG_CAR_SEPARADOR <> NULLVALUE() THEN
    P_CARACTER_SEP = ARG_CAR_SEPARADOR
ELSE
    P_CARACTER_SEP = ""
ENDIF
