/*********************************************************************
   ID: SAR_SET_N_ARCHIVO
   Nombre: Caracter final
   Fecha: 17/09/2015
   Autor: emmanueln
   Argumentos: ARG_N_ARCHIVO
   Descripcion: el argumento tiene como funcion insertar un valor (hasta 255 caracteres) en la linea del txt)
*********************************************************************/

IF ARG_N_ARCHIVO <> NULLVALUE() THEN
    P_N_ARCHIVO = ARG_N_ARCHIVO
ENDIF
