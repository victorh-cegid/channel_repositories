/*********************************************************************
   ID: SAR_SET_CAR_FIN_LINEA
   Nombre: Caracter final
   Fecha: 17/09/2015
   Autor: emmanueln
   Argumentos: ARG_CAR_FIN_LINEA
   Descripcion: el argumento tiene como funcion insertar un valor (hasta 3 caracteres) en la linea del txt)
*********************************************************************/

IF ARG_CAR_FIN_LINEA <> NULLVALUE() THEN
    P_CARACTER_FIN = ARG_CAR_FIN_LINEA
ELSE
    P_CARACTER_FIN = ""
ENDIF
