/**************************************************************************
   ID: SAR_IGUALA_PROPIEDADES
   Nombre: IGUALA PROPIEDADES PARA UTILIZAR FILTROS EN TODOS LOS REGISTROS
   Fecha: 29/09/2015
   Autor: emmanueln
   Descripcion:  Este metodo tiene la funcion de igualar todas las 
                propiedades de los nodos de los REGISTROS para asi poder
                utilizar filtros al momento de generarlos
**************************************************************************/
vReg = 0
vFiltroAC_EMP_AG = ""
vFiltroAC_PERIOD = ""

// Envio normal debemos extraer los datos a informar vigentes a la fecha de pago
If SAR_P_CHECK = "0" Then
    
    // Si se genera fichero para una paga retroactiva siempre es por fecha de imputacion, se busca para las fechas de inico y fin que sirven de filtro
    If SAR_P_CHECK_RETRO = "1" Then
        vReg = FindRegister("SCO_DT_ACCRUED",SAR_P_FEC_IMP_RETRO, M4_EQUAL, vReg)
    Else
        vReg = FindRegister("SCO_DT_ACCRUED",SAR_P_FEC_PAGO, M4_EQUAL, vReg)
    EndIf
    
    SAR_P_INICIO = SAR_LSD_TXT[vReg].SCO_DT_START
    SAR_P_FIN = SAR_LSD_TXT[vReg].SCO_DT_END    
// Rectificativa debemos extraer los datos a informar vigentes para el a?o y mes indicados   
ElseIf SAR_P_CHECK = "1" Then
    SAR_P_INICIO = DxDate (                            1 , SAR_P_MES_RECTIF , SAR_P_ANIO_RECTIF )   ' Primer dia del mes a rectificar
    SAR_P_FIN    = DxDate ( DaysOfMonth ( SAR_P_INICIO ) , SAR_P_MES_RECTIF , SAR_P_ANIO_RECTIF )   ' ultimo dia del mes a rectificar
EndIf
   
SAR_GEN_REG_01.SAR_P_REG1_LEG_ENT   = SAR_P_LEG_ENT
SAR_GEN_REG_01.SAR_P_FEC_IMP_RECT   = SAR_P_FEC_IMP_RECT

SAR_GEN_REG_02.SAR_P_REG2_LEG_ENT   = SAR_P_LEG_ENT
SAR_GEN_REG_02.SAR_P_INICIO         = SAR_P_INICIO
SAR_GEN_REG_02.SAR_P_FIN            = SAR_P_FIN
SAR_GEN_REG_02.SAR_P_FEC_PAGO       = SAR_P_FEC_PAGO
SAR_GEN_REG_02.SAR_P_CHECK          = SAR_P_CHECK
SAR_GEN_REG_02.SAR_P_FEC_IMP_RECT   = SAR_P_FEC_IMP_RECT
SAR_GEN_REG_02.SAR_P_FREQ_PAGO      = SAR_P_FREQ_PAGO
SAR_GEN_REG_02.SAR_P_CHECK_RETRO    = SAR_P_CHECK_RETRO
SAR_GEN_REG_02.SAR_P_FEC_IMP_RETRO  = SAR_P_FEC_IMP_RETRO
SAR_GEN_REG_02.SAR_P_FREQ_IMPUT     = SAR_P_FREQ_IMPUT
SAR_GEN_REG_02.SAR_P_ANIO_RECTIF    = SAR_P_ANIO_RECTIF
SAR_GEN_REG_02.SAR_P_MES_RECTIF     = SAR_P_MES_RECTIF

SAR_GEN_REG_04.SAR_P_REG4_LEG_ENT   = SAR_P_LEG_ENT
SAR_GEN_REG_04.SAR_P_INICIO         = SAR_P_INICIO
SAR_GEN_REG_04.SAR_P_FIN            = SAR_P_FIN
SAR_GEN_REG_04.SAR_P_CHECK          = SAR_P_CHECK
SAR_GEN_REG_04.SAR_P_FEC_PAGO       = SAR_P_FEC_PAGO
SAR_GEN_REG_04.SAR_P_FEC_IMP_RECT   = SAR_P_FEC_IMP_RECT
SAR_GEN_REG_04.SAR_P_FREQ_PAGO      = SAR_P_FREQ_PAGO
SAR_GEN_REG_04.SAR_P_CHECK_RETRO    = SAR_P_CHECK_RETRO
SAR_GEN_REG_04.SAR_P_FEC_IMP_RETRO  = SAR_P_FEC_IMP_RETRO
SAR_GEN_REG_04.SAR_P_FREQ_IMPUT     = SAR_P_FREQ_IMPUT
SAR_GEN_REG_04.SAR_P_ANIO_RECTIF    = SAR_P_ANIO_RECTIF
SAR_GEN_REG_04.SAR_P_MES_RECTIF     = SAR_P_MES_RECTIF

SAR_GEN_REG_05.SAR_P_REG5_LEG_ENT   = SAR_P_LEG_ENT
SAR_GEN_REG_05.SAR_P_INICIO         = SAR_P_INICIO
SAR_GEN_REG_05.SAR_P_FIN            = SAR_P_FIN
SAR_GEN_REG_05.SAR_P_CHECK          = SAR_P_CHECK
SAR_GEN_REG_05.SAR_P_FEC_PAGO       = SAR_P_FEC_PAGO
SAR_GEN_REG_05.SAR_P_FEC_IMP_RECT   = SAR_P_FEC_IMP_RECT
SAR_GEN_REG_05.SAR_P_CHECK_RETRO    = SAR_P_CHECK_RETRO
SAR_GEN_REG_05.SAR_P_FEC_IMP_RETRO  = SAR_P_FEC_IMP_RETRO
SAR_GEN_REG_05.SAR_P_ANIO_RECTIF    = SAR_P_ANIO_RECTIF
SAR_GEN_REG_05.SAR_P_MES_RECTIF     = SAR_P_MES_RECTIF

/***    Carga SysSentences de los nodos SAR_GEN_REG_02, SAR_GEN_REG_04 y SAR_GEN_REG_05 ***/
SAR_CARGA_SYSSENTENCE()
