/**************************************************************************
   ID: SAR_CARGA_SYSSENTENCE
   Nombre: Carga de SysSentence de los nodos 02 04 y 05
   Fecha: 31/07/2019
   Autor: emmanueln
   Descripcion:  Este metodo tiene la funcion de cargar la SysSentence de
                los nodos SAR_GEN_REG_02, SAR_GEN_REG_04 y SAR_GEN_REG_05
                con el Filtro dinamico seleccionado en la presentacion.
**************************************************************************/
'inicializo variables
vFiltro = ""
vFiltroAC_PERIOD = ""
vFiltroAC_EMP_AG = ""
vSyJ = "0" //Libro de Sueldos y Jornales
vRE = "1"  //Rectificativas

'Edito el filtro dinamico seleccionado
vFiltro = SAR_FILT_DYNAMIC_LSDIG.SAR_P_DYN_FILTER

IF vFiltro <> "***" Then
    vFiltro = REPLACE (vFiltro,"&","")
    vFiltro = REPLACE (vFiltro,"STD_HR_PERIOD A","STD_HR_PERIOD LSDIG")
    vFiltro = REPLACE (vFiltro,"A.","LSDIG.")    

    vFiltroAC_PERIOD =  " AND EXISTS (SELECT 1 "+vFiltro+" AND A.SCO_ID_HR = LSDIG.STD_ID_HR AND A.SCO_OR_HR_PERIOD = LSDIG.STD_OR_HR_PERIOD) "
    vFiltroAC_EMP_AG = " AND EXISTS (SELECT 1 "+vFiltro+" AND A.STD_ID_HR = LSDIG.STD_ID_HR AND A.STD_OR_HR_PERIOD = LSDIG.STD_OR_HR_PERIOD) "
endif

//a continuacion se envian los valores a los parametros:
//Orden secuencial y definicion:
//    ?(5,0,0) fechas
//    ?(2,9,0) cadena de 9 caracteres
//    ?(6,2,0) Numero de 2 enteros

IF SAR_P_CHECK = vSyJ THEN 
        /****  SAR_GEN_REG_02  ****/
        SYSSENTENCE_REG02 = "SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @ID_ORGANIZATION = #MAX(A.ID_ORGANIZATION), @SCO_DT_PAYMENT = #MAX(A.SCO_DT_PAYMENT), @SAR_FECHA_ALTA = #MAX(A.SAR_FECHA_ALTA), @SAR_FECHA_BAJA = #MAX(A.SAR_FECHA_BAJA), @SAR_TOT_DIAS_TRAB_SIJP = #SUM(A.SAR_TOT_DIAS_TRAB_SIJP), @ID_CURRENCY = #MAX(A.ID_CURRENCY), @SCO_DT_EXCHANGE = #MAX(A.SCO_DT_EXCHANGE), @EX_TYPE = #MAX(A.EX_TYPE) "
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + "FROM &SAR_AC_HR_PERIOD A, STD_HR_PERIOD C, STD_HR F, STD_PERSON G "
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + "WHERE A.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND A.SCO_ID_HR = C.STD_ID_HR(+) AND A.SCO_OR_HR_PERIOD = C.STD_OR_HR_PERIOD(+) AND C.ID_ORGANIZATION = F.ID_ORGANIZATION(+) AND C.STD_ID_HR = F.STD_ID_HR(+) AND F.ID_ORGANIZATION = G.ID_ORGANIZATION(+) "
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + "AND F.STD_ID_HR = G.STD_ID_PERSON(+) " 
                                                
        //FILTRADO POR EMPRESA 
        SYS_PARAM_REG02 = tostring(SAR_GEN_REG_02.SAR_P_REG2_LEG_ENT)
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + " And ( A.SCO_ID_LEG_ENT =  ?(2,9,0)) "
               
        //FILTRADO POR FECHA PAGO 
        SYS_PARAM_REG02 = SYS_PARAM_REG02 +"|"+tostring(SAR_GEN_REG_02.SAR_P_FEC_PAGO)
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + " And ( A.SCO_DT_PAYMENT = ?(5,0,0)) "
        
        //FILTRADO POR FRECUENCIA DE PAGO
        SYS_PARAM_REG02 = SYS_PARAM_REG02 +"|"+tostring(SAR_GEN_REG_02.SAR_P_FREQ_PAGO)
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + " And ( A.SCO_PAY_FREQ_PAYM =  ?(2,9,0)) "
        
        //FILTRADO PAGA REROACTIVA
'''        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + " And ( ( @SAR_P_CHECK_RETRO = '0' And A.SCO_DT_PAYMENT = A.SCO_DT_ALLOCATION And A.SCO_PAY_FREQ_ALLOC = A.SCO_PAY_FREQ_PAYM ) Or "
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + " And ( ( @SAR_P_CHECK_RETRO = '0' And A.SAR_LSD_FECHA =A.SCO_DT_PAYMENT And A.SCO_PAY_FREQ_ALLOC = A.SCO_PAY_FREQ_PAYM ) Or "
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + "       ( @SAR_P_CHECK_RETRO = '1' And A.SCO_PAY_FREQ_ALLOC = @SAR_P_FREQ_IMPUT And @SAR_P_FEC_IMP_RETRO = A.SCO_DT_ALLOCATION ) ) "        
                
        'agrego el filtro dinamico a utilizar
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + vFiltroAC_PERIOD
        
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + "GROUP BY G.SAR_CUIL, G.STD_SS_NUMBER, A.SCO_ID_HR, A.SCO_OR_HR_PERIOD "
        SYSSENTENCE_REG02 = SYSSENTENCE_REG02 + "ORDER BY G.SAR_CUIL ASC, G.STD_SS_NUMBER ASC, A.SCO_ID_HR ASC, A.SCO_OR_HR_PERIOD ASC"

'paso la SysSentence a los nodos respectivos.
    SAR_GEN_REG_02.SAR_P_DYN_FILTER = SYSSENTENCE_REG02
    SAR_GEN_REG_02.SYS_PARAM = SYS_PARAM_REG02
ENDIF

/****  SAR_GEN_REG_04  ****/
SYS_PARAM =""
SYSSENTENCE_REG04 = "SELECT @SCO_ID_HR = A.SCO_ID_HR, @SAR_LSD_DIAS_MES_REPORTE = #SUM(A.SAR_LSD_DIAS_MES_REPORTE), @SAR_FECHA_BAJA = #MAX(A.SAR_FECHA_BAJA), @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_ID_LEG_ENT = #MAX(A.SCO_ID_LEG_ENT), "
SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "@SCO_DT_ALLOCATION = #MAX(A.SCO_DT_ALLOCATION), @SAR_FECHA_ALTA = #MAX(A.SAR_FECHA_ALTA), @SCO_DT_PAYMENT = #MAX(A.SCO_DT_PAYMENT) "
SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "FROM &SAR_AC_HR_PERIOD A, STD_HR_PERIOD F, STD_HR G, STD_PERSON H "
SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "WHERE A.ID_ORGANIZATION = F.ID_ORGANIZATION(+) AND A.SCO_ID_HR = F.STD_ID_HR(+) AND A.SCO_OR_HR_PERIOD = F.STD_OR_HR_PERIOD(+) "
SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "AND F.ID_ORGANIZATION = G.ID_ORGANIZATION(+) AND F.STD_ID_HR = G.STD_ID_HR(+) "
SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "AND G.ID_ORGANIZATION = H.ID_ORGANIZATION(+) AND G.STD_ID_HR = H.STD_ID_PERSON(+) "
                                        
//FILTRADO POR EMPRESA
SYS_PARAM_REG04 = tostring(SAR_GEN_REG_04.SAR_P_REG4_LEG_ENT)

If SAR_P_CHECK = vRE Then
    'para las rectificativas si elegimos una paga que no sea de tipo anticipo no la tenemos en cuenta en la carga
    If SAR_P_ID_PAY_TYPE <> "88" Then
        SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "And A.SCO_ID_LEG_ENT = ?(2,9,0) And A.SCO_PAY_TYPE_PAYM <> '99' And A.SCO_PAY_TYPE_PAYM <> '88' "
    Else
        SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "And A.SCO_ID_LEG_ENT = ?(2,9,0) And A.SCO_PAY_TYPE_PAYM <> '99' "
    EndIf
Else
    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "And A.SCO_ID_LEG_ENT = ?(2,9,0) And A.SCO_PAY_TYPE_PAYM <> '99' "
EndIf

//FILTRADO POR CHECK 
IF SAR_P_CHECK <> vSyJ THEN

    //FILTRADO POR MES Y A?O DE IMPUTACION
    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "And (#YEAR_DATE(A.SCO_DT_ALLOCATION)= @SAR_P_ANIO_RECTIF "
    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "And  #MONTH_DATE(A.SCO_DT_ALLOCATION)= @SAR_P_MES_RECTIF "
    
    //FILTRADO HASTA LA FECHA PAGO SELECCIONADA
    SYS_PARAM_REG04   = SYS_PARAM_REG04   + "|" + tostring(SAR_GEN_REG_04.SAR_P_FEC_PAGO)
    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "And A.SCO_DT_PAYMENT <= ?(5,0,0) ) "    
ELSE
    //FILTRADO POR FECHA PAGO 
    SYS_PARAM_REG04 = SYS_PARAM_REG04 +"|"+tostring(SAR_GEN_REG_04.SAR_P_FEC_PAGO)
    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "And (A.SCO_DT_PAYMENT = ?(5,0,0) "
  
    //FILTRADO PAGA REROACTIVA
'''    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + " And ( ( @SAR_P_CHECK_RETRO = '0' And A.SCO_DT_ALLOCATION = A.SCO_DT_PAYMENT     And A.SCO_PAY_FREQ_ALLOC = @SAR_P_FREQ_PAGO ) Or "
    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + " And ( ( @SAR_P_CHECK_RETRO = '0' And A.SAR_LSD_FECHA=A.SCO_DT_PAYMENT And A.SCO_PAY_FREQ_ALLOC = @SAR_P_FREQ_PAGO ) Or " 
    
    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "       ( @SAR_P_CHECK_RETRO = '1' And A.SCO_DT_ALLOCATION = @SAR_P_FEC_IMP_RETRO And A.SCO_PAY_FREQ_ALLOC = @SAR_P_FREQ_IMPUT ) ) )"
ENDIF
  
//FILTRADO POR FRECUENCIA DE PAGO
SYS_PARAM_REG04 = SYS_PARAM_REG04 +"|"+tostring(SAR_GEN_REG_04.SAR_P_FREQ_PAGO)
SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "And (A.SCO_PAY_FREQ_PAYM = ?(2,9,0)) " 

If vFiltroAC_PERIOD <> nullvalue() And vFiltroAC_PERIOD <> "" Then
    'agrego el filtro dinamico a utilizar
    SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + vFiltroAC_PERIOD
EndIf

SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "GROUP BY H.SAR_CUIL, H.STD_SS_NUMBER, A.SCO_ID_HR, A.SCO_OR_HR_PERIOD "
SYSSENTENCE_REG04 = SYSSENTENCE_REG04 + "ORDER BY H.SAR_CUIL ASC, H.STD_SS_NUMBER ASC, A.SCO_ID_HR ASC, A.SCO_OR_HR_PERIOD ASC"

'paso la SysSentence a los nodos respectivos.
SAR_GEN_REG_04.SAR_P_DYN_FILTER = SYSSENTENCE_REG04
SAR_GEN_REG_04.SYS_PARAM = SYS_PARAM_REG04


/****  SAR_GEN_REG_05  ****/
SYSSENTENCE_REG05 = "SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @STD_ID_LEG_ENT = #MAX(D.STD_ID_LEG_ENT), @SFR_REG_LEGENT = #MAX(D.SFR_REG_LEGENT), @SFR_ID_ACTIV_SECTOR = #MAX(D.SFR_ID_ACTIV_SECTOR)"
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + ", @DT_START = #MAX(B.DT_START), @DT_END = #MAX(B.DT_END) "
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "FROM &SAR_AC_HR_EMP_AGEN_ART A, SCO_H_HR_LEGAL_ENTITY B, STD_HR_PERIOD C, STD_LEG_ENT D, STD_HR E, STD_PERSON F "
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "WHERE A.STD_ID_HR = B.SCO_ID_HR(+) AND A.STD_ID_LEG_ENT = B.SCO_ID_LEG_ENT(+) AND A.STD_OR_HR_PERIOD = B.SCO_OR_HR_PERIOD(+) AND B.ID_ORGANIZATION = C.ID_ORGANIZATION(+) "
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "AND B.SCO_ID_HR = C.STD_ID_HR(+) AND B.SCO_OR_HR_PERIOD = C.STD_OR_HR_PERIOD(+) AND B.ID_ORGANIZATION = D.ID_ORGANIZATION(+) AND B.SCO_ID_LEG_ENT = D.STD_ID_LEG_ENT(+) "
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "AND C.ID_ORGANIZATION = E.ID_ORGANIZATION(+) AND C.STD_ID_HR = E.STD_ID_HR(+) AND E.ID_ORGANIZATION = F.ID_ORGANIZATION(+) AND E.STD_ID_HR = F.STD_ID_PERSON(+) "

//FILTRADO POR EMPRESA  
SYS_PARAM_REG05 = tostring(SAR_GEN_REG_5_AC_EMP_AGEN_ART.SAR_P_REG5_LEG_ENT)
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And ( A.STD_ID_LEG_ENT =  ?(2,9,0) " 

IF SAR_P_CHECK <> vSyJ THEN
    //FILTRADO POR MES Y A?O DE IMPUTACION
    SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "And #YEAR_DATE(A.SAR_FECHA_IMPUTACION)= @SAR_P_ANIO_RECTIF "
    SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "And #MONTH_DATE(A.SAR_FECHA_IMPUTACION)= @SAR_P_MES_RECTIF "
    
    //FILTRADO HASTA LA FECHA PAGO SELECCIONADA
    SYS_PARAM_REG05   = SYS_PARAM_REG05   + "|" + tostring(SAR_GEN_REG_05.SAR_P_FEC_PAGO)
    SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "And A.SAR_FEC_PAGO <= ?(5,0,0) "      
ELSE
    //FILTRADO POR FECHA DE PAGO
    SYS_PARAM_REG05 = SYS_PARAM_REG05 +"|"+tostring(SAR_GEN_REG_05.SAR_P_FEC_PAGO)
    SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And     A.SAR_FEC_PAGO =  ?(5,0,0) " 
    SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And ( ( @SAR_P_CHECK_RETRO = '0' And A.SAR_FECHA_IMPUTACION = A.SAR_FEC_PAGO ) Or " 'comprobar en que afceta el LSD       
    SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "       ( @SAR_P_CHECK_RETRO = '1' And A.SAR_FECHA_IMPUTACION = @SAR_P_FEC_IMP_RETRO ) ) "
ENDIF

// FILTRADO POR FECHA DE INICIO
SYS_PARAM_REG05 = SYS_PARAM_REG05 +"|"+tostring(SAR_GEN_REG_05.SAR_P_FIN) 
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And  C.STD_DT_START <=  ?(5,0,0) "  

//FILTRADO POR FECHA FIN
SYS_PARAM_REG05 = SYS_PARAM_REG05 +"|"+tostring(SAR_GEN_REG_05.SAR_P_INICIO) 
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And  C.STD_DT_END >=  ?(5,0,0) "  

// FILTRADO POR FECHA DE INICIO
SYS_PARAM_REG05 = SYS_PARAM_REG05 +"|"+tostring(SAR_GEN_REG_05.SAR_P_FIN) 
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And  B.DT_START <=  ?(5,0,0) "  

//FILTRADO POR FECHA FIN
SYS_PARAM_REG05 = SYS_PARAM_REG05 +"|"+tostring(SAR_GEN_REG_05.SAR_P_INICIO) 
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And  B.DT_END >=  ?(5,0,0) "  

// FILTRADO POR FECHA DE INICIO
SYS_PARAM_REG05 = SYS_PARAM_REG05 +"|"+tostring(SAR_GEN_REG_05.SAR_P_FIN) 
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And D.STD_DT_START <=  ?(5,0,0) "  

//FILTRADO POR FECHA FIN
SYS_PARAM_REG05 = SYS_PARAM_REG05 +"|"+tostring(SAR_GEN_REG_05.SAR_P_INICIO) 
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + " And D.STD_DT_END >=  ?(5,0,0)) "  

'agrego el filtro dinamico a utilizar
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + vFiltroAC_EMP_AG

SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "GROUP BY F.SAR_CUIL, F.STD_SS_NUMBER, A.STD_ID_HR, A.STD_OR_HR_PERIOD "
SYSSENTENCE_REG05 = SYSSENTENCE_REG05 + "ORDER BY F.SAR_CUIL ASC, F.STD_SS_NUMBER ASC, A.STD_ID_HR ASC, A.STD_OR_HR_PERIOD ASC"

'paso la SysSentence a los nodos respectivos.
SAR_GEN_REG_05.SAR_P_DYN_FILTER = SYSSENTENCE_REG05
SAR_GEN_REG_05.SYS_PARAM = SYS_PARAM_REG05
