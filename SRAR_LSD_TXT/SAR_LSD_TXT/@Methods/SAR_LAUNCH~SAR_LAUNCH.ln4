/*********************************************************************
   ID: SAR_LAUNCH
   Nombre: Inicia el proceso de planificacion del Libro Sueldo Digital
   Fecha: 29/11/2017
   Autor: emmanueln
   Descripcion: realiza la obtencion de los valores que se parametrizan 
                para la ejecucion de la planificacion SAR_PARAM_LAUNCH
*********************************************************************/

/*Preparo los argumentos necesarios para la planificacion*/
sSAR_P_CHECK = tostring(SAR_P_CHECK,0)

'busco y utilizo la ruta parametrizada en "Configuracion de procesos LATAM"
SRAR_CONFI_PROCESS_LSDIG.SLA_CARGAR_CONFIGURACION("SRAR_LSDIGITAL_TXT")
SAR_P_PATH = SRAR_CONFI_PROCESS_LSDIG.SLA_GET_VALOR("SRAR_LSDIG_LIQ_DDJJ")

sSAR_P_FEC_PAGO = SAR_FECHA_CADENA(SAR_P_FEC_PAGO)

sSAR_P_FEC_IMP_RECT = "        "     // 8 espacios como valor por defecto
If IsNull(SAR_P_FEC_RUBRICA) = M4_FALSE Then
    sSAR_P_FEC_IMP_RECT = SAR_FECHA_CADENA(SAR_P_FEC_IMP_RECT)
EndIf

sSAR_P_FEC_RUBRICA = "        "     // 8 espacios como valor por defecto
If IsNull(SAR_P_FEC_RUBRICA) = M4_FALSE Then
    sSAR_P_FEC_RUBRICA = SAR_FECHA_CADENA(SAR_P_FEC_IMP_RECT)
EndIf

IF SAR_P_SEPARADOR = 0 OR ISNULL (SAR_P_SEPARADOR) = M4_TRUE THEN
    sSAR_P_SEPARADOR = "0"
ELSE
    sSAR_P_SEPARADOR = "1"
ENDIF

IF ISNULL(SAR_FILT_DYNAMIC_LSDIG.SAR_P_DYN_FILTER) = M4_TRUE or SAR_FILT_DYNAMIC_LSDIG.SAR_P_DYN_FILTER = "" then 
    vFiltro = "***"
ELSE
    vFiltro = SAR_FILT_DYNAMIC_LSDIG.SAR_P_DYN_FILTER
ENDIF

' Nuevas propiedades a informar desde la presentacion
Retroactiva = SAR_P_CHECK_RETRO
Fec_ImpRetr = "        "                                    // 8 espacios como valor por defecto
Freq_Imputa = "   "                                         // 3 espacios como valor por defecto
AA_Rectific = "    "                                        // 4 espacios como valor por defecto
MM_Rectific = "  "                                          // 2 espacios como valor por defecto
NumLiqRetro = nullvalue()

If IsNull(SAR_P_FEC_IMP_RETRO) = M4_FALSE Then
    Fec_ImpRetr = SAR_FECHA_CADENA(SAR_P_FEC_IMP_RETRO)
EndIf
If IsNull(SAR_P_FREQ_IMPUT) = M4_FALSE Then
    Freq_Imputa = SAR_P_FREQ_IMPUT
EndIf
If IsNull(SAR_P_ANIO_RECTIF) = M4_FALSE Then
    AA_Rectific = ToString(SAR_P_ANIO_RECTIF, 0)
EndIf
If IsNull(SAR_P_MES_RECTIF) = M4_FALSE Then
    MM_Rectific = ToString(SAR_P_MES_RECTIF, 0)
EndIf

If IsNull(SAR_P_NUM_LIQ_RETRO) = M4_FALSE Then
    NumLiqRetro = ToString(SAR_P_NUM_LIQ_RETRO, 0)
ELSE
    NumLiqRetro = ""
EndIf

'Arguments
sSXMLFILE           = chr(Double_quote) + SAR_P_PATH + chr(Double_quote)
sSAR_P_LEG_ENT      = chr(Double_quote) + SAR_P_LEG_ENT + chr(Double_quote)
sSAR_P_FEC_PAGO     = chr(Double_quote) + sSAR_P_FEC_PAGO + chr(Double_quote)
sSAR_P_CHECK        = chr(Double_quote) + sSAR_P_CHECK + chr(Double_quote)
sSAR_P_SEPARADOR    = chr(Double_quote) + sSAR_P_SEPARADOR + chr(Double_quote)
sSAR_PLANIFICADO    = chr(Double_quote) + "1" + chr(Double_quote)
sSAR_P_FEC_IMP_RECT = chr(Double_quote) + sSAR_P_FEC_IMP_RECT + chr(Double_quote)
sSAR_P_FEC_RUBRICA  = chr(Double_quote) + sSAR_P_FEC_RUBRICA + chr(Double_quote)
sSAR_P_FREQ_PAGO    = chr(Double_quote) + SAR_P_FREQ_PAGO + chr(Double_quote)
sSAR_P_DYN_FILTER   = chr(Double_quote) + vFiltro + chr(Double_quote)

'Nuevos argumentos
Retroactiva = chr(Double_quote) + Retroactiva + chr(Double_quote)
Fec_ImpRetr = chr(Double_quote) + Fec_ImpRetr + chr(Double_quote)
Freq_Imputa = chr(Double_quote) + Freq_Imputa + chr(Double_quote)
AA_Rectific = chr(Double_quote) + AA_Rectific + chr(Double_quote)
MM_Rectific = chr(Double_quote) + MM_Rectific + chr(Double_quote)

sSAR_P_NUM_LIQ_RETRO = chr(Double_quote) + NumLiqRetro + chr(Double_quote)

'Ejecucion planificada           
'Definimos la Tarea del Job Scheduler que vamos a ejecutar
ID_TASK = "SRAR_EXPORT_LSD_JS"

'Formateamos los parametros
ID_PARAM_1  = "ARG_SXMLFILE"
VAL_PARAM_1 = sSXMLFILE

ID_PARAM_2  = "ARG_SAR_P_LEG_ENT"
VAL_PARAM_2 = sSAR_P_LEG_ENT

ID_PARAM_3  = "ARG_SAR_P_FEC_PAGO"
VAL_PARAM_3 = sSAR_P_FEC_PAGO

ID_PARAM_4  = "ARG_SAR_P_CHECK"
VAL_PARAM_4 = sSAR_P_CHECK

ID_PARAM_5  = "ARG_SAR_P_SEPARADOR"
VAL_PARAM_5 = sSAR_P_SEPARADOR

ID_PARAM_6  = "ARG_LAUCH"
VAL_PARAM_6 = sSAR_PLANIFICADO

ID_PARAM_7  = "ARG_SAR_P_FEC_IMP_RECT"
VAL_PARAM_7 = sSAR_P_FEC_IMP_RECT

ID_PARAM_8  = "ARG_SAR_P_FEC_RUBRICA"
VAL_PARAM_8 = sSAR_P_FEC_RUBRICA

ID_PARAM_9  = "ARG_SAR_P_FREQ_PAGO"
VAL_PARAM_9 = sSAR_P_FREQ_PAGO

ID_PARAM_10  = "ARG_SAR_P_DYN_FILTER"
VAL_PARAM_10 = sSAR_P_DYN_FILTER
' --------------------------------------------
ID_PARAM_11  = "ARG_SAR_P_CHECK_RETRO"
VAL_PARAM_11 = Retroactiva

ID_PARAM_12  = "ARG_SAR_P_FEC_IMP_RETRO"
VAL_PARAM_12 = Fec_ImpRetr

ID_PARAM_13  = "ARG_SAR_P_FREQ_IMPUT"
VAL_PARAM_13 = Freq_Imputa

ID_PARAM_14  = "ARG_SAR_P_ANIO_RECTIF"
VAL_PARAM_14 = AA_Rectific

ID_PARAM_15  = "ARG_SAR_P_MES_RECTIF"
VAL_PARAM_15 = MM_Rectific

ID_PARAM_16  = "ARG_SAR_P_NUM_LIQ_RETRO"
VAL_PARAM_16 = sSAR_P_NUM_LIQ_RETRO

vBoxList = "{?" + ID_TASK + "?," + ID_PARAM_1 + ",?" + VAL_PARAM_1 + "?," + ID_PARAM_2 + ",?" + VAL_PARAM_2 + "?," + ID_PARAM_3 + ",?" + VAL_PARAM_3 
vBoxList = vBoxList + "?," + ID_PARAM_4 + ",?" + VAL_PARAM_4 + "?," + ID_PARAM_5 + ",?" + VAL_PARAM_5 + "?," + ID_PARAM_6 + ",?" + VAL_PARAM_6
vBoxList = vBoxList + "?," + ID_PARAM_7 + ",?" + VAL_PARAM_7 + "?," + ID_PARAM_8 + ",?" + VAL_PARAM_8 + "?," + ID_PARAM_9 + ",?" + VAL_PARAM_9 + "?," + ID_PARAM_10 + ",?" + VAL_PARAM_10 
vBoxList = vBoxList + "?," + ID_PARAM_11 + ",?" + VAL_PARAM_11 + "?," + ID_PARAM_12 + ",?" + VAL_PARAM_12 + "?," + ID_PARAM_13 + ",?" + VAL_PARAM_13
''vBoxList = vBoxList + "?," + ID_PARAM_14 + ",?" + VAL_PARAM_14 + "?," + ID_PARAM_15 + ",?" + VAL_PARAM_15 + "?}"
vBoxList = vBoxList + "?," + ID_PARAM_14 + ",?" + VAL_PARAM_14 + "?," + ID_PARAM_15 + ",?" + VAL_PARAM_15 + "?," + ID_PARAM_16 + ",?" + VAL_PARAM_16 + "?}"


BOXLIST = vBoxList
BOXNAME = GetNodeItemData("SAR_LSD_TXT","SAR_P_PLANIFICADO",M4_ITEM_NAME)
