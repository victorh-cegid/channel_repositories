sARG_SAR_P_FEC_PAGO     = ToDate(ARG_SAR_P_FEC_PAGO)
sARG_SAR_P_FEC_IMP_RECT = ToDate(ARG_SAR_P_FEC_IMP_RECT)

IF ARG_SAR_P_SEPARADOR = "0" THEN
    sARG_SAR_P_SEPARADOR = 0
ELSE
    sARG_SAR_P_SEPARADOR = 1
ENDIF

SAR_P_LEG_ENT                           = ARG_SAR_P_LEG_ENT
SAR_P_FEC_PAGO                          = sARG_SAR_P_FEC_PAGO
SAR_P_PATH                              = ARG_SXMLFILE
SAR_P_CHECK                             = ARG_SAR_P_CHECK
SAR_P_SEPARADOR                         = sARG_SAR_P_SEPARADOR
PROP_LAUCH                              = ARG_LAUCH
SAR_P_FEC_IMP_RECT                      = sARG_SAR_P_FEC_IMP_RECT
SAR_REG02_FEC_RUBRICA                   = ARG_SAR_P_FEC_RUBRICA
SAR_P_FREQ_PAGO                         = ARG_SAR_P_FREQ_PAGO
SAR_FILT_DYNAMIC_LSDIG.SAR_P_DYN_FILTER = ARG_SAR_P_DYN_FILTER

SAR_P_CHECK_RETRO                       = ARG_SAR_P_CHECK_RETRO
SAR_P_FEC_IMP_RETRO                     = ToDate(ARG_SAR_P_FEC_IMP_RETRO)
SAR_P_FREQ_IMPUT                        = ARG_SAR_P_FREQ_IMPUT
SAR_P_ANIO_RECTIF                       = ToInt(ARG_SAR_P_ANIO_RECTIF)
SAR_P_MES_RECTIF                        = ToInt(ARG_SAR_P_MES_RECTIF)

SAR_P_NUM_LIQ_RETRO                     = ToInt(ARG_SAR_P_NUM_LIQ_RETRO)

SAR_INICIAR_PROCESO()
