/******************************************************************************
   ID: SAR_INICIAR_PROCESO
   Nombre: Inicia el proceso para la generacion del Libro Sueldo Digital
   Fecha: 29/09/2015
   Autor: emmanueln
   Descripcion: Este metodo tiene la funcion de ir ejecutando los tipos
                de registros en orden para la generacion del archivo 
                de LSD en formato txt, utilizando el nodo SAR_TXT_GENERADOR
*******************************************************************************/

SAR_VALIDA_DATOS()
'copio a todos los Registros los datos ingresados en el filtro de la presentacion
SAR_IGUALA_PROPIEDADES()

vSyJ = "0" //Libro de Sueldos y Jornales
vRE = "1"  //Rectificativas

IF SAR_P_SEPARADOR = 0 or ISNULL (SAR_P_SEPARADOR) = M4_TRUE THEN
    vCheck_separador = ""
ELSE
    vCheck_separador = ";"
ENDIF
    
'aqui se le da valores a los argumentos de ser necesario
SAR_TXT_GENERADOR.SAR_SET_CAR_INI_LINEA("") 'caracter inicial de la linea
SAR_TXT_GENERADOR.SAR_SET_CAR_FIN_LINEA("") 'caracter final de la linea
SAR_TXT_GENERADOR.SAR_SET_CAR_SEPARADOR(vCheck_separador) 'caracter separador de los datos

vPreparo_path = SAR_P_PATH
if mid(vPreparo_path,length(vPreparo_path)-1,1) <> "\" then
    SAR_P_PATH = vPreparo_path + "\"
endif

SAR_TXT_GENERADOR.SAR_SET_PATH(SAR_P_PATH)

If SAR_P_CHECK = vSyJ Then
    vmonth = tostring(dxmonth(SAR_P_INICIO),0)
    vyear = tostring(dxyear(SAR_P_INICIO),0)
Else
    vmonth = ToString(SAR_P_MES_RECTIF,0)
    vyear  = ToString(SAR_P_ANIO_RECTIF,0)
EndIf
IF Length(vmonth) < 2 THEN vmonth= "0" + vmonth

vToDate = vyear+vmonth
IF ISNULL (SAR_P_NUM_LIQ_RETRO) = M4_TRUE THEN
    NumLiqu = ToString(SAR_NUM_LIQUIDACION,0)
ELSE
    NumLiqu = ToString(SAR_P_NUM_LIQ_RETRO,0)
ENDIF



'Verifico que si se quiere generar el archivo para empleados Retroactivos, el nombre del archivo sea "RE" y no lleva numero de liquidacion
IF SAR_P_CHECK = vSyJ THEN
    v_nombre_archivo = "LibroSueldosDigital"    + "-" + SAR_P_LEG_ENT + "-" + vToDate + "-" + NumLiqu + ".txt"    
ELSE
    v_nombre_archivo = "LibroSueldosDigital_RE" + "-" + SAR_P_LEG_ENT + "-" + vToDate +                 ".txt"
ENDIF

SAR_TXT_GENERADOR.SAR_SET_N_ARCHIVO(v_nombre_archivo)

'inicializo el nodo libre del Registro 01
SAR_GEN_REG_01.load_blk()
SAR_GEN_REG_01.begin()

'se realiza la carga de los nodos que imprimiran informacion del registro 04 para que el registro 01 pueda contar la cantidad de datos que habra en el REG04
SAR_GEN_REG_04.load_prg()
SAR_GEN_REG_05.load_blk()

If SAR_GEN_REG_04.Count() = 0 And SAR_GEN_REG_05.Count() = 0 Then
    setlog (M4_error,2,80,268) 'No existen datos para generar correctamente el archivo de "Interfaz de liquidacion y DDJJ".
    EndVMTransaction(M4_Rollback)
EndIf

'Inicio la generacion del TXT con la primera linea del registro 
SAR_GEN_REG_01.SAR_GENERA_REG_01()

'Verifico que solo se ejecuten la generacion de los registros REG_02 y REG_03 solo cuando son SyJ
'inicio la carga de los nodos y me posiciono
If SAR_P_CHECK = vSyJ Then
'inicio los nodos de los Registros tipo 02
    //SAR_GEN_REG_02.load_blk()      
    //SAR_GEN_REG_02.SAR_GENERA_REG_02()
    
'Ejecuto el metodo para generar los registros de tipo 02 y 03    
    SAR_GEN_REG_04.SAR_GENERA_REG_02()
EndIf

'inicializo el nodo  libre del Registro 04
SAR_GEN_REG_04.begin()
'solo se traera datos si existen empleados en el acumulado
SAR_GEN_REG_04.SAR_GENERA_REG_04()

'inicializo el nodo libre de los Empleados de servicios eventuales 
SAR_GEN_REG_05.begin()

'solo se traera datos si existen empleados de Eventuales de Agencia
SAR_GEN_REG_05.SAR_GENERA_REG_04_EMP_AGEN()                               // Registro 04

IF SAR_P_CHECK = vSyJ THEN SAR_GEN_REG_05.SAR_GENERA_REG_05()              // Registro 05, solo para SyJ, nunca Rectificativas

SAR_TXT_GENERADOR.SAR_GRABAR_TXT()
setlog (M4_SUCCESS,1,80,10) 'Se ha generado el archivo correctamente
