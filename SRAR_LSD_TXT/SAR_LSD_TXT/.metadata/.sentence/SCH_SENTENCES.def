# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_LSD_TXT | 0 | 0 | 1 |  | 80 |  |  | #I = ? And ( ( #I = ? And #I = ? ) Or ( ? = #I And ? = #I ) ) |  | SELECT @SCO_DT_ACCRUED = A.SCO_DT_ACCRUED, @SCO_ID_PAY_FREQUENCY = A.SCO_ID_PAY_FREQUENCY, @SCO_DT_START = A.SCO_DT_START, @SCO_NM_PAY = A.SCO_NM_PAY, @SCO_DT_END = A.SCO_DT_END, @SAR_NUM_LIQUIDACION = C.SAR_NUM_LIQUIDACION, @SCO_ID_PAY_TYPE = A.SCO_ID_PAY_TYPE, @SAR_FECHA_PAGO = C.SAR_FECHA_PAGO FROM &SCO_HT_PAYS A, SAR_FECHAS_PAGA C WHERE C.ID_ORGANIZATION(+) = A.ID_ORGANIZATION AND C.SCO_DT_ACCRUED(+) = A.SCO_DT_ACCRUED AND C.SCO_ID_PAY_FREQUENCY(+) = A.SCO_ID_PAY_FREQUENCY AND (( C.STD_ID_LEG_ENT = @SAR_P_LEG_ENT And ( ( A.SCO_DT_ACCRUED = @SAR_P_FEC_PAGO And A.SCO_ID_PAY_FREQUENCY = @SAR_P_FREQ_PAGO ) Or ( @SAR_P_FEC_IMP_RETRO = A.SCO_DT_ACCRUED And @SAR_P_FREQ_IMPUT = A.SCO_ID_PAY_FREQUENCY ) ))) ORDER BY A.SCO_DT_ACCRUED DESC 
