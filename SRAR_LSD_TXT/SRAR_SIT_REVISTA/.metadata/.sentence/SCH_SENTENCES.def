# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SRAR_SIT_REVISTA | 0 | 0 | 1 |  | 80 |  |  | ? <= #I And ? >= #I And ? = #I And ? = #I |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_DT_START = A.SCO_DT_START, @SCO_DT_END = A.SCO_DT_END, @SCO_ID_EMPLOYEE_TYPE = A.SCO_ID_EMPLOYEE_TYPE, @SAR_ID_MOD_CONTRAT = A.SAR_ID_MOD_CONTRAT, @SAR_ID_COD_SINIES = A.SAR_ID_COD_SINIES, @SAR_ID_COD_COND = A.SAR_ID_COD_COND, @SAR_ACC_CHECK = A.SAR_ACC_CHECK, @SAR_ID_SIT_REVISTA = A.SAR_ID_SIT_REVISTA, @SCO_ID_REASON_CHANGE = A.SCO_ID_REASON_CHANGE, @SCO_COMENT = A.SCO_COMENT, @SCO_COMMENT = A.SCO_COMMENT FROM &SCO_H_EMPLOYEE_TYPE A WHERE (@SRAR_FEC_INI <= A.SCO_DT_END And @SRAR_FEC_FIN >= A.SCO_DT_START And @SRAR_ID_HR = A.SCO_ID_HR And @SRAR_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD) ORDER BY A.SCO_DT_START ASC
