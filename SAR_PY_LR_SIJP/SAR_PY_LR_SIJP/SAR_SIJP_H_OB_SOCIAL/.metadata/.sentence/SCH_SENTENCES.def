# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_SIJP_H_OB_SOCIAL | 0 | 0 | 1 |  | 80 |  |  | ( #I <= ? And #I >= ? ) |  | SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @DT_START = A.DT_START, @DT_END = A.DT_END, @SAR_ID_OBRA_SOCIAL = A.SAR_ID_OBRA_SOCIAL, @SAR_NRO_AFILIADO = A.SAR_NRO_AFILIADO FROM &SAR_H_OBRA_SOC A WHERE (( A.DT_START <= @SAR_P_DT_FIN And A.DT_END >= @SAR_P_DT_INICIO ))
