# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_SIJP_H_AUSENTISMOS | 0 | 0 | 1 |  | 80 |  |  | #I <= ? And #I >= ? And #I IS NOT NULL |  | SELECT @STD_ID_HR = A.STD_ID_HR, @STD_OR_HR_PERIOD = A.STD_OR_HR_PERIOD, @SCO_ID_INCIDENCE = A.SCO_ID_INCIDENCE, @SCO_DT_START = A.SCO_DT_START, @SCO_OR_PART_TIME = A.SCO_OR_PART_TIME, @SCO_DT_END = A.SCO_DT_END, @SAR_ID_SIT_REVISTA = A.SAR_ID_SIT_REVISTA, @SAR_ID_TP_SIT_REV = A.SAR_ID_TP_SIT_REV FROM &SAR_VW_AUSEN_ACC A WHERE (A.SCO_DT_START <= @SAR_P_DT_FIN And A.SCO_DT_END >= @SAR_P_DT_INICIO And A.SAR_ID_SIT_REVISTA IS NOT NULL) ORDER BY A.SCO_DT_END ASC
