# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_IND_SEG_VIDA | 0 | 0 | 1 |  | 80 |  |  | #I >= ? And #I <= ? And #I = ? And #I <> '88' |  | SELECT @SAR_IND_SEG_VIDA = A.SAR_IND_SEG_VIDA, @SCO_DT_ALLOCATION = A.SCO_DT_ALLOCATION, @SAR_FECHA_SICOSS = A.SAR_FECHA_SICOSS, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_ID_HR = A.SCO_ID_HR, @SCO_DT_PAYMENT = A.SCO_DT_PAYMENT, @SAR_ID_EMPRESA = A.STD_ID_LEG_ENT, @SCO_DT_END_SLICE = A.SCO_DT_END_SLICE, @SCO_DT_START_SLICE = A.SCO_DT_START_SLICE FROM &SAR_AC_HR_PERIOD A WHERE (A.SAR_FECHA_SICOSS >= @SAR_P_DT_INICIO And A.SAR_FECHA_SICOSS <= @SAR_P_DT_FIN And A.STD_ID_LEG_ENT = @SAR_P_ID_EMPRESA And A.SCO_PAY_TYPE_PAYM <> '88') ORDER BY A.SCO_DT_END_SLICE DESC
