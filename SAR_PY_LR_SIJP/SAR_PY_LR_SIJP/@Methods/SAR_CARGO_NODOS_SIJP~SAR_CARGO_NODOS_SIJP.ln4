/****************************************************************************************
        ID: SAR_CARGO_NODOS_SIJP
        Nombre: Cargo Nodos SiCOSS
        Fecha: 27/03/2018
        Autor: emmanueln
        Descripcion:  Metodo encargado de la carga de los nodos a utilizar en la generacion
                    de datos de empleados
*****************************************************************************************/

vFechaInicio    = SAR_P_DT_INICIO
vFechaFin       = SAR_P_DT_FIN  

/*  Indicador de seguro de Vida   */
If SAR_IND_SEG_VIDA.ISEOF()= M4_TRUE Then SAR_IND_SEG_VIDA.LOAD_BLK()
SAR_IND_SEG_VIDA.BEGIN()                          

/*Datos convenio*/
If SAR_SIJP_CONVENIO.ISEOF()= M4_TRUE Then SAR_SIJP_CONVENIO.LOAD_BLK()
SAR_SIJP_CONVENIO.END()

/*Datos Ausentismos*/
If SAR_SIJP_H_AUSENTISMOS.ISEOF()= M4_TRUE Then SAR_SIJP_H_AUSENTISMOS.LOAD_BLK()
SAR_SIJP_H_AUSENTISMOS.BEGIN()

/*  Hist. tipo empleado */
If SAR_SIJP_H_EMP_TYPE.ISEOF()= M4_TRUE Then SAR_SIJP_H_EMP_TYPE.LOAD_BLK()
SAR_SIJP_H_EMP_TYPE.END()

/*  Hist. Obra social   */
If SAR_SIJP_H_OB_SOCIAL.ISEOF()= M4_TRUE Then SAR_SIJP_H_OB_SOCIAL.LOAD_BLK()
SAR_SIJP_H_OB_SOCIAL.BEGIN()

/*  Datos Rol   */
If SAR_SIJP_HR_ROLE.ISEOF()= M4_TRUE Then
    if SAR_FECHA_BAJA <> M4_PLUS_INF AND SAR_FECHA_BAJA < vFechaInicio THEN 
        SAR_SIJP_HR_ROLE.SAR_P_DT_INICIO_AC = SAR_FECHA_BAJA
        SAR_SIJP_HR_ROLE.SAR_P_DT_FIN_AC    = SAR_FECHA_BAJA
    Else
        SAR_SIJP_HR_ROLE.SAR_P_DT_INICIO_AC = vFechaInicio
        SAR_SIJP_HR_ROLE.SAR_P_DT_FIN_AC    = vFechaFin 
    Endif
    SAR_SIJP_HR_ROLE.LOAD_PRG()
EndIf
    
/*  Lugar de trabajo    */
IF SAR_SIJP_H_WLOC.ISEOF()= M4_TRUE Then SAR_SIJP_H_WLOC.load_PRG()
SAR_SIJP_H_WLOC.BEGIN()

/*  Datos lugar de trabajo  */
'IF SAR_SIJP_H_WLOC.COUNT() > 0  THEN
If SAR_SIJP_H_WLOC.iseof()= M4_FALSE Then 'por css 2621019
    IF SAR_SIJP_ZONA_DGI.ISEOF()= M4_TRUE Then SAR_SIJP_ZONA_DGI.LOAD_BLK()
    SAR_SIJP_ZONA_DGI.BEGIN()
ENDIF

/*  Datos acum. Rol  */
IF SAR_SIJP_AC_HR_ROLE.ISEOF()= M4_TRUE Then SAR_SIJP_AC_HR_ROLE.LOAD_BLK()
SAR_SIJP_AC_HR_ROLE.BEGIN()

/*  Hist. Actividad */
IF SAR_SIJP_H_ACTIVIDAD.ISEOF()= M4_TRUE Then SAR_SIJP_H_ACTIVIDAD.LOAD_BLK()
SAR_SIJP_H_ACTIVIDAD.BEGIN() 

/*  Datos empresa   */
If SAR_SIJP_LEGENT.ISEOF()= M4_TRUE Then SAR_SIJP_LEGENT.LOAD_BLK()
SAR_SIJP_LEGENT.BEGIN()

/*  Datos persona   */
If SAR_SIJP_PERSON.ISEOF()= M4_TRUE Then SAR_SIJP_PERSON.LOAD_BLK()
SAR_SIJP_PERSON.BEGIN()
