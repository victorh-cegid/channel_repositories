'Zoom
iArgCount = GetArgumentNumber() 
iCount = 0
iPosit = -1
bAdd = FALSE

sJit = "Return " + GetChannelId() + "!GetProperty(" + CHR(34) + "ID_ORGANIZATION_TYPE" + CHR(34) + ")"
iChType = clcExecuteLN4JIT(sJit)

While bAdd = FALSE And iCount < iArgCount
     iCount = iCount + 1
     vValue = GetArgument(iCount)
     If IsNull(vValue) = TRUE Then
           bAdd = TRUE
     EndIf
Wend
     
If bAdd = FALSE Then
     If iChType < 2 Then
        iPosit = FindRegister("STD_ID_HR", ARG_STD_ID_HR, EQUAL, "STD_OR_HR_PERIOD", ARG_STD_OR_HR_PERIOD, EQUAL)
     Else
         iPosit = FindRegister("STD_ID_HR", ARG_STD_ID_HR, EQUAL, "STD_OR_HR_PERIOD", ARG_STD_OR_HR_PERIOD, EQUAL)
     EndIf

     If iPosit < 0 Then
         iReturn = PVT_LOOK_UP("STD_ID_HR", ARG_STD_ID_HR, "STD_OR_HR_PERIOD", ARG_STD_OR_HR_PERIOD  , 0, "PVT_APPLY_ZOOM", GetArgument(1), "", "", "", "")
         If iChType < 2 Then
            iPosit = FindRegister("STD_ID_HR", ARG_STD_ID_HR, EQUAL, "STD_OR_HR_PERIOD", ARG_STD_OR_HR_PERIOD, EQUAL)
         Else
            iPosit = FindRegister("STD_ID_HR", ARG_STD_ID_HR, EQUAL, "STD_OR_HR_PERIOD", ARG_STD_OR_HR_PERIOD, EQUAL)
         EndIf
     EndIf
EndIf

If iPosit < 0 Then
     AddRegister()
    If iChType < 2 Then
        STD_ID_HR= ARG_STD_ID_HR
STD_OR_HR_PERIOD= ARG_STD_OR_HR_PERIOD

    Else
        STD_ID_HR= ARG_STD_ID_HR
STD_OR_HR_PERIOD= ARG_STD_OR_HR_PERIOD

    EndIf
Else
     iDummy = MoveTo(iPosit)
EndIf
RETURN iPosit
