'argumentos
'Se utiliza la ruta parametrizada desde "Configuracion de procesos LATAM"
SAR_CONFI_PROCESS_SIJP.SLA_CARGAR_CONFIGURACION("SAR_PY_LR_SIJP")
vPath_file = SAR_CONFI_PROCESS_SIJP.SLA_GET_VALOR("SAR_PARAM_PATH")
vName_File = SAR_CONFI_PROCESS_SIJP.SLA_GET_VALOR("SAR_PARAM_NAME")

/***  Si el nombre del archivo no tiene asignado el formato texto .txt, le agrego la extension al archivo  ***/
IF MID(vName_File,LENGTH(vName_File) -1,4) <> ".txt" THEN 
    vName_File = vName_File + ".txt"
ENDIF

sARG_SXMLFILE           = chr(Double_quote) + vPath_file + chr(Double_quote)
sSAR_P_ID_EMPRESA       =  chr(Double_quote) + SAR_P_ID_EMPRESA + chr(Double_quote)
sSAR_P_DT_INICIO        = chr(Double_quote) + tostring(SAR_P_DT_INICIO,0) + chr(Double_quote)
sSAR_P_DT_FIN           = chr(Double_quote) + tostring(SAR_P_DT_FIN,0) + chr(Double_quote)
sARG_ZIP_FILE           = chr(Double_quote) + vName_File + chr(Double_quote)
sARG_DYN_FILTER          = chr(Double_quote) + tostring(SAR_P_DYN_FILTER,0) + chr(Double_quote)

'Definimos la Tarea del Job Scheduler que vamos a ejecutar
ID_TASK = "SRAR_EXPORT_SICOSS_JS"

ID_PARAM_1  = "ARG_SXMLFILE"
VAL_PARAM_1 = sARG_SXMLFILE

ID_PARAM_2  = "ARG_SAR_P_ID_EMPRESA"
VAL_PARAM_2 = sSAR_P_ID_EMPRESA

ID_PARAM_3  = "ARG_SAR_P_DT_INICIO"
VAL_PARAM_3 = sSAR_P_DT_INICIO

ID_PARAM_4  = "ARG_SAR_P_DT_FIN"
VAL_PARAM_4 = sSAR_P_DT_FIN            

ID_PARAM_5  = "ARG_ZIP_FILE"
VAL_PARAM_5 = sARG_ZIP_FILE

ID_PARAM_6  = "ARG_DYN_FILTER"
VAL_PARAM_6 = sARG_DYN_FILTER



vBoxList = "{?" + ID_TASK + "?," + ID_PARAM_1 + ",?" + VAL_PARAM_1 + "?," + ID_PARAM_2 + ",?" + VAL_PARAM_2 + "?," + ID_PARAM_3 + ",?" + VAL_PARAM_3 
vBoxList = vBoxList + "?," + ID_PARAM_4 + ",?" + VAL_PARAM_4 + "?," + ID_PARAM_5 + ",?" + VAL_PARAM_5 + "?," + ID_PARAM_6 + ",?" + VAL_PARAM_6 + "?}"
               
BOXLIST = vBoxList
BOXNAME = GetNodeItemData("SAR_PY_LR_SIJP","SAR_P_PLANIFICACION",M4_ITEM_NAME)                      

Return (M4_TRUE)
