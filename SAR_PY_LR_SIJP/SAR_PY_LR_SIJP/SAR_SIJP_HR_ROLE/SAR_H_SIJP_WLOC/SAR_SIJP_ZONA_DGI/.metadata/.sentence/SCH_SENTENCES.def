# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_SIJP_ZONA_DGI | 0 | 0 | 1 |  | 80 |  |  |  |  | SELECT @SAR_ID_ZONA_DGI = A.SAR_ID_ZONA_DGI, @SAR_NM_ZONA_DGI = A.SAR_NM_ZONA_DGI, @STD_ID_COUNTRY = A.STD_ID_COUNTRY, @STD_ID_GEO_DIV = A.STD_ID_GEO_DIV, @STD_ID_SUB_GEO_DIV = A.STD_ID_SUB_GEO_DIV, @STD_N_SUB_GEO_DIV = D.STD_N_SUB_GEO_DIV, @STD_N_GEO_DIV = E.STD_N_GEO_DIV FROM &SAR_ZONAS_DGI A, STD_SUB_GEO_DIV D, STD_GEO_DIV E WHERE A.STD_ID_COUNTRY = D.STD_ID_COUNTRY(+) AND A.STD_ID_GEO_DIV = D.STD_ID_GEO_DIV(+) AND A.STD_ID_SUB_GEO_DIV = D.STD_ID_SUB_GEO_DIV(+) AND D.ID_ORGANIZATION = E.ID_ORGANIZATION(+) AND D.STD_ID_COUNTRY = E.STD_ID_COUNTRY(+) AND D.STD_ID_GEO_DIV = E.STD_ID_GEO_DIV(+) ORDER BY A.SAR_DT_END DESC
