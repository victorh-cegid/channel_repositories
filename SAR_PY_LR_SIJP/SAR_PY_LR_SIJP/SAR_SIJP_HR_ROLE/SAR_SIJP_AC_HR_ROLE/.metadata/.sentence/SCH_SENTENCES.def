# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_SIJP_AC_HR_ROLE | 0 | 0 | 1 |  | 80 |  |  | #I >= ? And #I <= ? |  | SELECT @ID_ORGANIZATION = A.ID_ORGANIZATION, @SCO_DT_ALLOCATION = A.SCO_DT_ALLOCATION, @SCO_DT_PAYMENT = A.SCO_DT_PAYMENT, @SCO_ID_HR = A.SCO_ID_HR, @SCO_OR_HR_ROLE = A.SCO_OR_HR_ROLE, @SAR_ID_CENTRO_TRAB = A.STD_ID_WORK_LOCATION FROM &SAR_AC_HR_ROLE A WHERE (A.SCO_DT_ALLOCATION >= @SAR_P_DT_INICIO And A.SCO_DT_ALLOCATION <= @SAR_P_DT_FIN)
