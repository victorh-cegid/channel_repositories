'****************************************************************************************
'  este metodo genera el archivo plano, conectado despues del metodo SAR_M_ARMAR_DATOS
'****************************************************************************************
If Count() > 0 then
   Begin()
vPathNombre = SAR_PY_LR_SIJP.SAR_P_PATH
vPathNombreLog = SAR_PY_LR_SIJP.SAR_P_PATH_LOG
Destroyfile(vPathNombre)
Destroyfile(vPathNombreLog)

   
   While IsEof() = FALSE
       concatfile(vPathNombre, SAR_P_LINEA)
       If (SAR_P_LOG_LINEA <> "" AND SAR_P_LOG_LINEA <> nullvalue()) Then
            concatfile(vPathNombreLog, SAR_P_LOG_EMP)
            concatfile(vPathNombreLog, SAR_P_LOG_LINEA)
       EndIf
       
       GoNext()
   Wend
   setlog(1,80,4,102)
   return(0)
Endif
