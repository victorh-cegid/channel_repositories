# ID_SENTENCE | IS_DISTINCT | MAX_NUM_COL | ID_SENT_TYPE | ID_GROUP_OBJECTS | OWNER_FLAG | OWNERSHIP | USABILITY | FILTER | FILTER_GROUP | APISQL
SAR_H_EMP_TYPE_AGENCIA | 0 | 0 | 1 |  | 80 |  |  | ( ( ? <= #I And ? >= #I ) Or ( ? <= #I And ? >= #I ) Or ( ? <= #I And ? >= #I ) Or ( ? > #I And ? < #I ) Or ( #I IS NULL And #I <= ? ) And ( ( #I = 'AC' ) Or ( #I = 'BA' ) ) ) |  | SELECT @SCO_ID_HR = A.SCO_ID_HR, @SCO_DT_END = A.SCO_DT_END, @SCO_OR_HR_PERIOD = A.SCO_OR_HR_PERIOD, @SCO_ID_EMPLOYEE_TYPE = A.SCO_ID_EMPLOYEE_TYPE, @SCO_ID_REASON_CHANGE = A.SCO_ID_REASON_CHANGE, @SAR_ID_MOD_CONTRAT = A.SAR_ID_MOD_CONTRAT, @SAR_ID_COD_SINIES = A.SAR_ID_COD_SINIES, @SAR_ID_COD_COND = A.SAR_ID_COD_COND, @SAR_ID_SIT_REVISTA = A.SAR_ID_SIT_REVISTA, @SCO_DT_START = A.SCO_DT_START FROM &SCO_H_EMPLOYEE_TYPE A, SAR_X_SIT_REVIS C WHERE A.ID_ORGANIZATION = C.ID_ORGANIZATION(+) AND A.SAR_ID_SIT_REVISTA = C.SAR_ID_SIT_REVISTA(+) AND (( ( @SAR_P_DT_INICIO <= A.SCO_DT_START And @SAR_P_DT_FIN >= A.SCO_DT_END ) Or ( @SAR_P_DT_INICIO <= A.SCO_DT_START And @SAR_P_DT_FIN >= A.SCO_DT_START ) Or ( @SAR_P_DT_INICIO <= A.SCO_DT_END And @SAR_P_DT_FIN >= A.SCO_DT_END ) Or ( @SAR_P_DT_INICIO > A.SCO_DT_START And @SAR_P_DT_FIN < A.SCO_DT_END ) Or ( A.SCO_DT_END IS NULL And A.SCO_DT_START <= @SAR_P_DT_FIN ) And ( ( C.SAR_ID_TP_SIT_REV = 'AC' ) Or ( C.SAR_ID_TP_SIT_REV = 'BA' ) ) ))
