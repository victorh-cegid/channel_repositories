parents:
  - ID_PARENT_OBJECT: SCO_H_HR_LEGAL_ENTITY
    DELETE_CASCADE: false
    on:
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: SCO_OR_HR_PERIOD
      - ID_FIELD: STD_ID_LEG_ENT
        ID_PARENT_FIELD: SCO_ID_LEG_ENT
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
  - ID_PARENT_OBJECT: SAR_H_EXTERNAL_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: STD_ID_EXTERNAL_ORG
        ID_PARENT_FIELD: STD_ID_EXTERNAL_ORG
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
