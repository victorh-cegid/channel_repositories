  - ID_PARENT_OBJECT: SCO_X_MAIN_CURR
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_IND_MAIN_CURR
        ID_PARENT_FIELD: SCO_IND_MAIN_CURR
  - ID_PARENT_OBJECT: SCO_X_BEHAV_CURR
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_BEHAV_CURR
        ID_PARENT_FIELD: SCO_BEHAV_CURR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_LU_EX_TYPE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: EX_TYPE
