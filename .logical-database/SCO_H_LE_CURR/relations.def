  - ID_PARENT_OBJECT: SCO_X_PROCESS_TP
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_ID_PROCESS_TP
        ID_PARENT_FIELD: SCO_ID_PROCESS_TP
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
