parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCO_COMPANY_BANK
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_COMP_BANK
        ID_PARENT_FIELD: SCO_ID_COMP_BANK
  - ID_PARENT_OBJECT: SCO_PAY_TRANSMIS
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_ID_PAY_TRANSMI
        ID_PARENT_FIELD: SCO_ID_PAY_TRANSMI
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCO_PAYMEN_ORDER
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_PAY_FREQ_ALLOC
        ID_PARENT_FIELD: SCO_PAY_FREQ_ALLOC
      - ID_FIELD: SCO_ID_ORIGIN_TYPE
        ID_PARENT_FIELD: SCO_ID_ORIGIN_TYPE
      - ID_FIELD: SCO_DT_ALLOCATION
        ID_PARENT_FIELD: SCO_DT_ALLOCATION
      - ID_FIELD: SCO_PAY_FREQ_PAYM
        ID_PARENT_FIELD: SCO_PAY_FREQ_PAYM
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_DT_PAYMENT
        ID_PARENT_FIELD: SCO_DT_PAYMENT
      - ID_FIELD: SCO_OR_HR_PERIOD
        ID_PARENT_FIELD: SCO_OR_HR_PERIOD
      - ID_FIELD: SCO_OR_PAYMENTDATA
        ID_PARENT_FIELD: SCO_OR_PAYMENTDATA
  - ID_PARENT_OBJECT: SCO_PAYMENT_TYPE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_PAYM_TYPE
        ID_PARENT_FIELD: SCO_ID_PAYM_TYPE
