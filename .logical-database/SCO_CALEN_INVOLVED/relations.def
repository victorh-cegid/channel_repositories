parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG_MONO
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCO_DAY_CALENDAR
    DELETE_CASCADE: true
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_DAY_CALENDAR
        ID_PARENT_FIELD: SCO_ID_DAY_CALENDAR
  - ID_PARENT_OBJECT: SCO_CALENDAR
    DELETE_CASCADE: true
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_CALENDAR
        ID_PARENT_FIELD: SCO_ID_CALENDAR
