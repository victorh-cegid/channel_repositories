  - ID_PARENT_OBJECT: SCH_LU_EX_TYPE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: EX_TYPE
        ID_PARENT_FIELD: EX_TYPE
  - ID_PARENT_OBJECT: SCH_CURRENCY
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_CURRENCY
        ID_PARENT_FIELD: ID_CURRENCY
