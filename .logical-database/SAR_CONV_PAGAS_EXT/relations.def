parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCO_X_PAY_FREQUENCY
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_ID_PAY_FREQUENCY
        ID_PARENT_FIELD: SCO_ID_PAY_FREQUENCY
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SAR_PAGAS_EXTRAS
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_ID_PAGA_EXTRA
        ID_PARENT_FIELD: SAR_ID_PAGA_EXTRA
  - ID_PARENT_OBJECT: SAR_X_CONVENIO
    DELETE_CASCADE: true
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_ID_CONVENIO
        ID_PARENT_FIELD: SAR_ID_CONVENIO
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
