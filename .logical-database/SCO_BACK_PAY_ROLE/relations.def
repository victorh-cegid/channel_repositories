parents:
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_LU_EX_TYPE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: EX_TYPE
        ID_PARENT_FIELD: EX_TYPE
  - ID_PARENT_OBJECT: SCH_CURRENCY
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_CURRENCY
        ID_PARENT_FIELD: ID_CURRENCY
  - ID_PARENT_OBJECT: SCO_HR_ROLE
    DELETE_CASCADE: true
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
      - ID_FIELD: SCO_OR_HR_ROLE
        ID_PARENT_FIELD: SCO_OR_HR_ROLE
  - ID_PARENT_OBJECT: SCO_HT_PAYS
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_DT_ALLOCATION
        ID_PARENT_FIELD: SCO_DT_ACCRUED
      - ID_FIELD: SCO_PAY_FREQ_PAYM
        ID_PARENT_FIELD: SCO_ID_PAY_FREQUENCY
      - ID_FIELD: SCO_PAY_FREQ_ALLOC
        ID_PARENT_FIELD: SCO_ID_PAY_FREQUENCY
      - ID_FIELD: SCO_DT_PAYMENT
        ID_PARENT_FIELD: SCO_DT_ACCRUED
  - ID_PARENT_OBJECT: SCH_CONCEPTS
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ITEM
        ID_PARENT_FIELD: ID_ITEM
      - ID_FIELD: ID_TI
        ID_PARENT_FIELD: ID_TI
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
