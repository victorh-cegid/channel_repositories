parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG_MONO
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_CONCEPTS
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ITEM
        ID_PARENT_FIELD: ID_ITEM
      - ID_FIELD: ID_TI
        ID_PARENT_FIELD: ID_TI
children:
  - ID_OBJECT: SCO_PAYMENT_DATA
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_ID_PAY_FORMULA
        ID_PARENT_FIELD: SCO_ID_PAY_FORMULA
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
