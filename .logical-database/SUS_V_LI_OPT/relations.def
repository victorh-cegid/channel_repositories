parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_LU_EX_TYPE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_EX_TYPE
        ID_PARENT_FIELD: EX_TYPE
  - ID_PARENT_OBJECT: SCH_CURRENCY
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_ID_CURRENCY
        ID_PARENT_FIELD: ID_CURRENCY
  - ID_PARENT_OBJECT: SUS_PLAN_OPTION
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SUS_ID_OPTION
        ID_PARENT_FIELD: SUS_ID_OPTION
      - ID_FIELD: SUS_ID_PLAN
        ID_PARENT_FIELD: SUS_ID_PLAN
  - ID_PARENT_OBJECT: SUS_X_ROUND_RULES
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SUS_ID_ROUND_RULE2
        ID_PARENT_FIELD: SUS_ID_ROUND_RULE
      - ID_FIELD: SUS_ID_ROUND_RULE1
        ID_PARENT_FIELD: SUS_ID_ROUND_RULE
