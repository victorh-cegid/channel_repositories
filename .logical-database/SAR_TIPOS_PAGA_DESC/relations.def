parents:
  - ID_PARENT_OBJECT: SCO_X_PAY_TYPE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_ID_PAY_TYPE
        ID_PARENT_FIELD: SCO_ID_PAY_TYPE
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SAR_H_DESCUENTOS
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SAR_OR_DESCUENTO
        ID_PARENT_FIELD: SAR_OR_DESCUENTO
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
children:
  - ID_OBJECT: SAR_BASE_DESC
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SAR_OR_DESCUENTO
        ID_PARENT_FIELD: SAR_OR_DESCUENTO
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_PAY_TYPE
        ID_PARENT_FIELD: SCO_ID_PAY_TYPE
