parents:
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
children:
  - ID_OBJECT: SAR_HABITUALES
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SAR_ID_NODE
        ID_PARENT_FIELD: SAR_ID_NODE
      - ID_FIELD: SAR_ID_DMD_COMPONENT
        ID_PARENT_FIELD: SAR_ID_DMD_COMPONENT
      - ID_FIELD: SAR_ID_SYNONYM
        ID_PARENT_FIELD: SAR_ID_SYNONYM
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_ID_DMD
        ID_PARENT_FIELD: SAR_ID_DMD
