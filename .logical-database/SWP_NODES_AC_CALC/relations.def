    on:
      - ID_FIELD: ID_T3_PAYROLL
        ID_PARENT_FIELD: ID_T3_PAYROLL
      - ID_FIELD: ID_NODE_AC_READ
        ID_PARENT_FIELD: ID_NODE_AC_READ
children:
  - ID_OBJECT: SWP_NODES_FILTER_AC_CALC
    DELETE_CASCADE: true
    on:
      - ID_FIELD: ID_T3_PAYROLL
        ID_PARENT_FIELD: ID_T3_PAYROLL
      - ID_FIELD: ID_NODE_AC_READ
        ID_PARENT_FIELD: ID_NODE_AC_READ
      - ID_FIELD: ID_NODE_AC_CALC
        ID_PARENT_FIELD: ID_NODE_AC_CALC
