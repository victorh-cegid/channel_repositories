parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG_MONO
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SAR_X_TIPOS_ASIG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_ID_TIPO_ASIG
        ID_PARENT_FIELD: SAR_ID_TIPO_ASIG
  - ID_PARENT_OBJECT: SAR_X_OCUPACION
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_ID_OCUPACION
        ID_PARENT_FIELD: SAR_ID_OCUPACION
  - ID_PARENT_OBJECT: STD_FAMILY
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: STD_OR_DEP_NB
        ID_PARENT_FIELD: STD_OR_DEP_NB
