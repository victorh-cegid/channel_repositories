        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: STD_FAMILY
    DELETE_CASCADE: 0
    'on':
      - ID_FIELD: STD_OR_DEP_NB
        ID_PARENT_FIELD: STD_OR_DEP_NB
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
