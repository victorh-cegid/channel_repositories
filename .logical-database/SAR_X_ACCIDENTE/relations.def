parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_CURRENCY
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SAR_ID_CURRENCY
        ID_PARENT_FIELD: ID_CURRENCY
  - ID_PARENT_OBJECT: SCH_LU_EX_TYPE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SAR_EX_TYPE
        ID_PARENT_FIELD: EX_TYPE
  - ID_PARENT_OBJECT: SCO_RK_ACC_INV
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SCO_DT_ACC
        ID_PARENT_FIELD: SCO_DT_ACC
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
  - ID_PARENT_OBJECT: STD_HR_PERIOD
    DELETE_CASCADE: true
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
children:
  - ID_OBJECT: SAR_H_RECAIDAS
    DELETE_CASCADE: true
    on:
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
      - ID_FIELD: SAR_ID_ORDINAL
        ID_PARENT_FIELD: SAR_ID_ORDINAL
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
  - ID_OBJECT: SAR_PRE_ACC_ART
    DELETE_CASCADE: true
    on:
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_ID_ORDINAL
        ID_PARENT_FIELD: SAR_ID_ORDINAL
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
