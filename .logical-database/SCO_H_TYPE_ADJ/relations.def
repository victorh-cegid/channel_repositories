parents:
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: STD_HR_PERIOD
    DELETE_CASCADE: true
    on:
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
  - ID_PARENT_OBJECT: SCO_X_TYPE_ADJ
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_TYPE_ADJUST
        ID_PARENT_FIELD: SCO_ID_TYPE_ADJUST
  - ID_PARENT_OBJECT: SCO_X_REASON_FOR_CHANGE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_ID_REASON_CHANGE
        ID_PARENT_FIELD: SCO_ID_REASON_CHANGE
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
