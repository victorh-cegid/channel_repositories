parents:
  - ID_PARENT_OBJECT: SCO_HR_ROLE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
      - ID_FIELD: SCO_OR_HR_ROLE
        ID_PARENT_FIELD: SCO_OR_HR_ROLE
  - ID_PARENT_OBJECT: SCO_X_TIME_UNIT
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_TIME_UNIT
        ID_PARENT_FIELD: SCO_ID_TIME_UNIT
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCO_INCID_PAYPER
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_INP_PAYPERIOD
        ID_PARENT_FIELD: SCO_ID_INP_PAYPERIOD
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCO_INCIDENCE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_INCIDENCE
        ID_PARENT_FIELD: SCO_ID_INCIDENCE
children:
  - ID_OBJECT: SAR_INTERRUP_ROL
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SCO_ID_INCIDENCE
        ID_PARENT_FIELD: SCO_ID_INCIDENCE
      - ID_FIELD: SCO_DT_START
        ID_PARENT_FIELD: SCO_DT_START
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
      - ID_FIELD: SCO_OR_PART_TIME
        ID_PARENT_FIELD: SCO_OR_PART_TIME
      - ID_FIELD: SCO_OR_HR_ROLE
        ID_PARENT_FIELD: SCO_OR_HR_ROLE
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
