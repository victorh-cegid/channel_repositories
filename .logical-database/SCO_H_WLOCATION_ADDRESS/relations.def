        ID_PARENT_FIELD: STD_ID_WORK_LOCATION
  - ID_PARENT_OBJECT: STD_SUB_GEO_DIV
    DELETE_CASCADE: false
    on:
      - ID_FIELD: STD_ID_GEO_DIV
        ID_PARENT_FIELD: STD_ID_GEO_DIV
      - ID_FIELD: STD_ID_COUNTRY
        ID_PARENT_FIELD: STD_ID_COUNTRY
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_ID_SUB_GEO_DIV
        ID_PARENT_FIELD: STD_ID_SUB_GEO_DIV
  - ID_PARENT_OBJECT: STD_GEO_PLACE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_ID_GEO_DIV
        ID_PARENT_FIELD: STD_ID_GEO_DIV
