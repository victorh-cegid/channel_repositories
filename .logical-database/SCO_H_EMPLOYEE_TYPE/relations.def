parents:
  - ID_PARENT_OBJECT: SAR_X_MOD_CONTR
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_ID_MOD_CONTRAT
        ID_PARENT_FIELD: SAR_ID_MOD_CONTRAT
  - ID_PARENT_OBJECT: SAR_X_COD_CONDIC
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_ID_COD_COND
        ID_PARENT_FIELD: SAR_ID_COD_COND
  - ID_PARENT_OBJECT: SCO_X_EMPLOYEE_TYPE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_EMPLOYEE_TYPE
        ID_PARENT_FIELD: SCO_ID_EMPLOYEE_TYPE
  - ID_PARENT_OBJECT: SAR_X_SIT_REVIS
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SAR_ID_SIT_REVISTA
        ID_PARENT_FIELD: SAR_ID_SIT_REVISTA
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
