  - ID_PARENT_OBJECT: STD_HR_PERIOD
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SCO_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
  - ID_PARENT_OBJECT: SAR_X_COD_SINIES
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SAR_ID_COD_SINIES
