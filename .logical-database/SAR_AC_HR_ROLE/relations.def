parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCO_HT_RUN_PAYS
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_PAY_FREQ_PAYM
        ID_PARENT_FIELD: SCO_ID_PAY_FREQ_ACC
      - ID_FIELD: SCO_DT_PAYMENT
        ID_PARENT_FIELD: SCO_DT_ACCRUED
      - ID_FIELD: SCO_PAY_FREQ_ALLOC
        ID_PARENT_FIELD: SCO_ID_PAY_FREQ_ALL
      - ID_FIELD: SCO_DT_ALLOCATION
        ID_PARENT_FIELD: SCO_DT_ALLOCATION
  - ID_PARENT_OBJECT: SCO_AC_HR_ROLE
    DELETE_CASCADE: true
    on:
      - ID_FIELD: ID_CURRENCY
        ID_PARENT_FIELD: ID_CURRENCY
      - ID_FIELD: SCO_OR_HR_ROLE
        ID_PARENT_FIELD: SCO_OR_HR_ROLE
      - ID_FIELD: SCO_PAY_FREQ_ALLOC
        ID_PARENT_FIELD: SCO_PAY_FREQ_ALLOC
      - ID_FIELD: SCO_DT_START_SLICE
        ID_PARENT_FIELD: SCO_DT_START_SLICE
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_DT_PAYMENT
        ID_PARENT_FIELD: SCO_DT_PAYMENT
      - ID_FIELD: SCO_DT_ALLOCATION
        ID_PARENT_FIELD: SCO_DT_ALLOCATION
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
      - ID_FIELD: SCO_PAY_FREQ_PAYM
        ID_PARENT_FIELD: SCO_PAY_FREQ_PAYM
  - ID_PARENT_OBJECT: SCO_HR_ROLE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_OR_HR_ROLE
        ID_PARENT_FIELD: SCO_OR_HR_ROLE
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
  - ID_PARENT_OBJECT: SCH_CURRENCY
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_CURRENCY
        ID_PARENT_FIELD: ID_CURRENCY
  - ID_PARENT_OBJECT: SSP_CENTR_COSTO
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SSP_ID_CENT_COSTO
        ID_PARENT_FIELD: SSP_ID_CENT_COSTO
  - ID_PARENT_OBJECT: STD_JOB
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_ID_JOB_CODE
        ID_PARENT_FIELD: STD_ID_JOB_CODE
  - ID_PARENT_OBJECT: STD_WORK_LOCATION
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: STD_ID_WORK_LOCATION
        ID_PARENT_FIELD: STD_ID_WORK_LOCATION
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
children:
  - ID_OBJECT: CAR_AC_HR_ROLE
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SCO_PAY_FREQ_ALLOC
        ID_PARENT_FIELD: SCO_PAY_FREQ_ALLOC
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_DT_PAYMENT
        ID_PARENT_FIELD: SCO_DT_PAYMENT
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
      - ID_FIELD: SCO_PAY_FREQ_PAYM
        ID_PARENT_FIELD: SCO_PAY_FREQ_PAYM
      - ID_FIELD: SCO_DT_ALLOCATION
        ID_PARENT_FIELD: SCO_DT_ALLOCATION
      - ID_FIELD: SCO_OR_HR_ROLE
        ID_PARENT_FIELD: SCO_OR_HR_ROLE
      - ID_FIELD: SCO_DT_START_SLICE
        ID_PARENT_FIELD: SCO_DT_START_SLICE
      - ID_FIELD: ID_CURRENCY
        ID_PARENT_FIELD: ID_CURRENCY
