parents:
  - ID_PARENT_OBJECT: STD_DISABILITIES
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_DISABILITY
        ID_PARENT_FIELD: STD_ID_DISABILITY
  - ID_PARENT_OBJECT: SYS_SUB_ORG_MONO
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: STD_HR
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: STD_LU_DISABILITY_GRADE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: SCO_ID_DISABILITY_GRADE
        ID_PARENT_FIELD: STD_ID_DISABILITY_GRADE
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SFR_X_CAT_COTOREP
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SFR_CAT_COTOREP
        ID_PARENT_FIELD: SFR_ID_CAT_COTOREP
children:
  - ID_OBJECT: SCO_HR_SPECIAL_NEEDS
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
      - ID_FIELD: SCO_ID_DISABILITY
        ID_PARENT_FIELD: SCO_ID_DISABILITY
