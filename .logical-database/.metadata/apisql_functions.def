functions:
  - ID_FUNCTION: ABS
    NAME_ESP: Valor absoluto
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: ABS(#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
  - ID_FUNCTION: ADD_DAYS
    NAME_ESP: A?adir dias
    ID_M4_TYPE: DATE
    PREC: 0
    FUNCTION_HEADER: DATEADD(DAY, #P1, #P2)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
      - ARGUMENT_POS: 2
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: ADD_MONTHS
    NAME_ESP: A?adir meses
    ID_M4_TYPE: DATE
    PREC: 0
    FUNCTION_HEADER: DATEADD(MONTH, #P2, #P1)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
      - ARGUMENT_POS: 2
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
  - ID_FUNCTION: ANYOS
    NAME_ESP: A?os transcurridos
    ID_M4_TYPE: NUMBER
    PREC: 4
    FUNCTION_HEADER: (FLOOR(((DATEDIFF(DD,#P,(GETDATE())))/365)))
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: AVG
    NAME_ESP: Media
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: AVG(#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
  - ID_FUNCTION: CASE_ACCENT_INSENSITIVE
    NAME_ESP: Compara valores / Insensibilidad mayus. / acentos
    ID_M4_TYPE: STRING
    PREC: 400
    FUNCTION_HEADER: #P = #P COLLATE LATIN1_GENERAL_CI_AI
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 2
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: CEILING
    NAME_ESP: Redondeo superior
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: CEILING(#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
  - ID_FUNCTION: CHR
    NAME_ESP: Caracter
    ID_M4_TYPE: STRING
    PREC: 1
    FUNCTION_HEADER: CHAR(#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
  - ID_FUNCTION: CONCAT
    NAME_ESP: Concatenar dos cadenas
    ID_M4_TYPE: STRING
    PREC: 254
    FUNCTION_HEADER: (#P+#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 2
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: CONCAT_GENERIC
    NAME_ESP: Concatenar
    ID_M4_TYPE: STRING
    PREC: 254
    FUNCTION_HEADER: (ISNULL(#P1,'')) + (ISNULL(#P2,'') ) + (ISNULL(#P3,'')) + (ISNULL(#P4,'')) + ( ISNULL(#P5,''))
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 2
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 3
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 4
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 5
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: COND_VALUE
    NAME_ESP: Valor condicional
    ID_M4_TYPE: STRING
    PREC: 254
    FUNCTION_HEADER: CASE WHEN (#P1 IS NULL) THEN (#P2) ELSE (#P3) END
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: COND
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 2
        N_ARGUMENT: VAL1
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 3
        N_ARGUMENT: VAL2
        ID_M4_TYPE: STRING
  - ID_FUNCTION: COUNT
    NAME_ESP: Cuenta
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: COUNT (#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: COUNT_DISTINCT
    NAME_ESP: Cuenta distinta
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: COUNT (DISTINCT #P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: DATALENGTH
    NAME_ESP: TAMA?O
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: DATALENGTH(#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATA
        ID_M4_TYPE: BINARY_STRING
  - ID_FUNCTION: DATE
    NAME_ESP: Fecha
    ID_M4_TYPE: DATE
    PREC: 0
    FUNCTION_HEADER: CONVERT(DATETIME,#P,120)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: DATE_DAY_WEEK
    NAME_ESP: Fecha de dia semana
    ID_M4_TYPE: DATE
    PREC: 0
    FUNCTION_HEADER: DATEADD(DAY,(#P1 - DATEPART(DW,#P2)) , #P2)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
      - ARGUMENT_POS: 2
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: DATE_DIFF
    NAME_ESP: Diferencia de fechas
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: DATEDIFF(DD,#P2,#P1)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
      - ARGUMENT_POS: 2
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: DAY_MONTH
    NAME_ESP: Dia del mes
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: REPLICATE('0',2-LEN(CONVERT(VARCHAR,DATEPART(DD,#P1))))+CONVERT(VARCHAR,DATEPART(DD,#P1))
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: DAY_WEEK
    NAME_ESP: Dia de la semana
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: CONVERT(VARCHAR,DATEPART(DW,#P))
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: DAY_YEAR
    NAME_ESP: Dia del a?o
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: REPLICATE('0',3-LEN(CONVERT(VARCHAR,DATEPART(DY,#P1))))+CONVERT(VARCHAR,DATEPART(DY,#P1))
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: DECODE
    NAME_ESP: Decodificar
    ID_M4_TYPE: STRING
    PREC: 254
    FUNCTION_HEADER: CASE (#P1) WHEN (#P2) THEN (#P3) WHEN (#P4) THEN (#P5) END
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 2
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 3
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 4
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 5
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: DECODE_ELSE
    NAME_ESP: Decodificar si
    ID_M4_TYPE: STRING
    PREC: 254
    FUNCTION_HEADER: CASE (#P1) WHEN (#P2) THEN (#P3) WHEN (#P4) THEN (#P5) ELSE (#P6) END
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 2
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 3
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 4
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 5
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
      - ARGUMENT_POS: 6
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: EXP
    NAME_ESP: Exponencial
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: EXP(#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
  - ID_FUNCTION: FLOOR
    NAME_ESP: Redondeo inferior
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: FLOOR(#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
  - ID_FUNCTION: FORMAT_DATE
    NAME_ESP: Formato YYYY-MM
    ID_M4_TYPE: STRING
    PREC: 20
    FUNCTION_HEADER: (CONVERT(VARCHAR(7), #P1, 120))
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: FORMAT_DATE_DD.MM.YYYY
    NAME_ESP: Formato DD.MM.YYYY
    ID_M4_TYPE: STRING
    PREC: 20
    FUNCTION_HEADER: CONVERT(VARCHAR(10), #P1, 104)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: FECHA
        ID_M4_TYPE: DATE
  - ID_FUNCTION: FORMAT_DATE_DDMMYYYY
    NAME_ESP: Formato DDMMYYYY
    ID_M4_TYPE: STRING
    PREC: 20
    FUNCTION_HEADER: REPLACE(CONVERT(VARCHAR(10), #P1, 103), '/', '')
