      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: TODAY
    NAME_ESP: Hoy
    ID_M4_TYPE: DATE
    PREC: 0
    FUNCTION_HEADER: GETDATE()
  - ID_FUNCTION: TO_CHAR
    NAME_ESP: Convertir a cadena
    ID_M4_TYPE: STRING
    PREC: 254
    FUNCTION_HEADER: CONVERT(VARCHAR(2000),#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: NUMBER
        ID_M4_TYPE: NUMBER
  - ID_FUNCTION: TO_DATE
    NAME_ESP: Convertir a fecha
    ID_M4_TYPE: DATE
    PREC: 0
    FUNCTION_HEADER: CONVERT(DATETIME,#P,120)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: TO_NUMBER
    NAME_ESP: Convertir a numero
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: CONVERT(FLOAT,#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: UCASE
    NAME_ESP: Convertir a mayusculas
    ID_M4_TYPE: STRING
    PREC: 254
    FUNCTION_HEADER: UPPER(#P)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: VARCHAR
        ID_M4_TYPE: STRING
  - ID_FUNCTION: WEEK
    NAME_ESP: Semana
    ID_M4_TYPE: NUMBER
    PREC: 18
    FUNCTION_HEADER: REPLICATE(0,2-LEN(( CEILING( CAST( DATEPART( DY, CONVERT( DATETIME, #P1, 120)) AS DECIMAL)/ 7)))) + CAST(CEILING( CAST( DATEPART( DY, CONVERT( DATETIME, #P1, 120)) AS DECIMAL)/ 7) AS CHAR(2))
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
  - ID_FUNCTION: YEAR_DATE
    NAME_ESP: A?o de la fecha
