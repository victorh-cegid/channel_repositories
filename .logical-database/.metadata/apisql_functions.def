      - ARGUMENT_POS: 3
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
      - ARGUMENT_POS: 4
        N_ARGUMENT: DATE
        ID_M4_TYPE: DATE
      - ARGUMENT_POS: 5
