    NAME_ESP: For Json
    ID_M4_TYPE: STRING
    PREC: 4000
    FUNCTION_HEADER: [#P~,#P~]
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: EXPRESSION
        ID_M4_TYPE: VARIANT
  - ID_FUNCTION: GREATEST
    NAME_ESP: Mayor de
    ID_M4_TYPE: VARIANT
