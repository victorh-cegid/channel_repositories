      - ARGUMENT_POS: 1
        N_ARGUMENT: FECHA
        ID_M4_TYPE: DATE
  - ID_FUNCTION: FORMAT_DATE_YYYY.MM.DD
    NAME_ESP: Formato YYYY.MM.DD
    ID_M4_TYPE: STRING
    PREC: 20
    FUNCTION_HEADER: CONVERT(VARCHAR(10), #P1, 102)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: Fecha
        ID_M4_TYPE: DATE
  - ID_FUNCTION: FORMAT_DATE_YYYYMMDD
    NAME_ESP: Formato YYYYMMDD
    ID_M4_TYPE: STRING
    PREC: 20
    FUNCTION_HEADER: CONVERT(VARCHAR(8), #P1, 112)
    arguments:
      - ARGUMENT_POS: 1
        N_ARGUMENT: FECHA
        ID_M4_TYPE: DATE
