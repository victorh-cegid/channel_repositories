parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SAR_H_RECAIDAS
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SAR_ID_ORDINAL
        ID_PARENT_FIELD: SAR_ID_ORDINAL
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SAR_DT_START
        ID_PARENT_FIELD: SAR_DT_START
      - ID_FIELD: STD_ID_HR
        ID_PARENT_FIELD: STD_ID_HR
      - ID_FIELD: STD_OR_HR_PERIOD
        ID_PARENT_FIELD: STD_OR_HR_PERIOD
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
