parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCH_ORGANIZATION_LEVEL
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_PARENT_OBJECT: SCO_HR_ROLE
    DELETE_CASCADE: true
    on:
      - ID_FIELD: SCO_ID_HR
        ID_PARENT_FIELD: SCO_ID_HR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_OR_HR_ROLE
        ID_PARENT_FIELD: SCO_OR_HR_ROLE
  - ID_PARENT_OBJECT: STD_WORK_LOCATION
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_WORK_LOCATION
        ID_PARENT_FIELD: STD_ID_WORK_LOCATION
  - ID_PARENT_OBJECT: SCO_X_REASON_FOR_CHANGE
    DELETE_CASCADE: false
    on:
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_REASON_CHANGE
        ID_PARENT_FIELD: SCO_ID_REASON_CHANGE
