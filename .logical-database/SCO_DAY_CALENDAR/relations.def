parents:
  - ID_PARENT_OBJECT: SYS_SUB_ORG_MONO
    DELETE_CASCADE: 0
    'on':
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
children:
  - ID_OBJECT: SCO_DAYCALEN_DEF
    DELETE_CASCADE: 1
    'on':
      - ID_FIELD: SCO_ID_DAY_CALENDAR
        ID_PARENT_FIELD: SCO_ID_DAY_CALENDAR
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
  - ID_OBJECT: SCO_CALEN_INVOLVED
    DELETE_CASCADE: 1
    'on':
      - ID_FIELD: ID_ORGANIZATION
        ID_PARENT_FIELD: ID_ORGANIZATION
      - ID_FIELD: SCO_ID_DAY_CALENDAR
        ID_PARENT_FIELD: SCO_ID_DAY_CALENDAR
